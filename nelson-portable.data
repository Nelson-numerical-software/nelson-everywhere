% LICENCE_BLOCK_END
%=============================================================================
function addRequired(obj, name, validator)
  narginchk(2, 3);
  if nargin < 3
    validator = [];
  end
  if ~(isempty(validator) || isa(validator, 'function_handle'))
    error('Nelson:inputParser:validatorAFunctionHandleEmpty4', 'Validator must be a function handle or empty.');
  end
  inputParser.addSchema(obj, 'required', name, [], validator);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
classdef inputParser < handle
  properties (Dependent)
    FunctionName
    CaseSensitive
    KeepUnmatched
    PartialMatching
    StructExpand
    Parameters
    Results
    Unmatched
    UsingDefaults
  end

  properties (Hidden)
    FunctionNameValue = ''
    CaseSensitiveValue = false
    KeepUnmatchedValue = false
    PartialMatchingValue = true
    StructExpandValue = true
    Schema = struct('Name', {}, 'Type', {}, 'Default', {}, 'Validator', {})
    ResultsValue = struct()
    UnmatchedValue = struct()
    UsingDefaultsValue = {}
  end

  methods
    function obj = inputParser()
      nargoutchk(0, 1);
    end

    function value = get.FunctionName(obj)
      value = obj.FunctionNameValue;
    end

    function set.FunctionName(obj, value)
      obj.FunctionNameValue = inputParser.textScalar(value, 'FunctionName');
    end

    function value = get.CaseSensitive(obj)
      value = obj.CaseSensitiveValue;
    end

    function set.CaseSensitive(obj, value)
      obj.CaseSensitiveValue = inputParser.logicalScalar(value, 'CaseSensitive');
    end

    function value = get.KeepUnmatched(obj)
      value = obj.KeepUnmatchedValue;
    end

    function set.KeepUnmatched(obj, value)
      obj.KeepUnmatchedValue = inputParser.logicalScalar(value, 'KeepUnmatched');
    end

    function value = get.PartialMatching(obj)
      value = obj.PartialMatchingValue;
    end

    function set.PartialMatching(obj, value)
      obj.PartialMatchingValue = inputParser.logicalScalar(value, 'PartialMatching');
    end

    function value = get.StructExpand(obj)
      value = obj.StructExpandValue;
    end

    function set.StructExpand(obj, value)
      obj.StructExpandValue = inputParser.logicalScalar(value, 'StructExpand');
    end

    function value = get.Parameters(obj)
      value = {};
      for k = 1:numel(obj.Schema)
        value{end + 1} = obj.Schema(k).Name;
      end
    end

    function value = get.Results(obj)
      value = obj.ResultsValue;
    end

    function value = get.Unmatched(obj)
      value = obj.UnmatchedValue;
    end

    function value = get.UsingDefaults(obj)
      value = obj.UsingDefaultsValue;
    end

    addRequired(obj, name, validator)
    addOptional(obj, name, defaultValue, validator)
    addParameter(obj, name, defaultValue, validator)
    addParamValue(obj, name, defaultValue, validator)
    parse(obj, varargin)
  end

  methods (Static, Hidden)
    function value = textScalar(value, name)
      if isstring(value) && isscalar(value)
        value = char(value);
      end
      if ~(ischar(value) && isrow(value))
        error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', name);
      end
    end

    function value = logicalScalar(value, name)
      if ~(islogical(value) || isnumeric(value)) || ~isscalar(value)
        error('Nelson:validators:mustBeLogicalScalar', '%s must be a logical scalar.', name);
      end
      value = logical(value);
    end

    function addSchema(obj, kind, name, defaultValue, validator)
      name = inputParser.textScalar(name, 'Argument name');
      if ~isvarname(name)
        error('Nelson:validators:inputParserInvalidName', 'Argument name must be a valid identifier.');
      end
      if ~isempty(inputParser.findSchema(obj, name, false))
        error('Nelson:validators:inputParserDuplicateName', 'Input names must be unique.');
      end
      item.Name = name;
      item.Type = kind;
      item.Default = defaultValue;
      item.Validator = validator;
      obj.Schema(end + 1) = item;
    end

    function index = findSchema(obj, name, parametersOnly)
      index = [];
      for k = 1:numel(obj.Schema)
        if parametersOnly && ~strcmp(obj.Schema(k).Type, 'parameter')
          continue
        end
        if inputParser.nameEquals(obj, obj.Schema(k).Name, name)
          index = k;
          return
        end
      end
    end

    function [index, ambiguous] = resolveParameter(obj, name)
      index = [];
      ambiguous = false;
      exact = [];
      partial = [];
      for k = 1:numel(obj.Schema)
        if ~strcmp(obj.Schema(k).Type, 'parameter')
          continue
        end
        if inputParser.nameEquals(obj, obj.Schema(k).Name, name)
          exact = k;
          break
        elseif obj.PartialMatchingValue && inputParser.nameStartsWith(obj, obj.Schema(k).Name, name)
          partial(end + 1) = k;
        end
      end
      if ~isempty(exact)
        index = exact;
      elseif numel(partial) == 1
        index = partial(1);
      elseif numel(partial) > 1
        ambiguous = true;
      end
    end

    function tf = nameEquals(obj, a, b)
      if obj.CaseSensitiveValue
        tf = strcmp(a, b);
      else
        tf = strcmpi(a, b);
      end
    end

    function tf = nameStartsWith(obj, candidate, prefix)
      if length(prefix) > length(candidate)
        tf = false;
        return
      end
      if obj.CaseSensitiveValue
        tf = strcmp(candidate(1:length(prefix)), prefix);
      else
        tf = strcmpi(candidate(1:length(prefix)), prefix);
      end
    end

    function tf = isTextScalar(value)
      tf = (ischar(value) && isrow(value)) || (isstring(value) && isscalar(value));
    end

    function validateValue(item, value)
      if isempty(item.Validator)
        return
      end
      try
        try
          result = feval(item.Validator, value);
        catch ex
          if strcmp(ex.identifier, 'Nelson:tooManyOutputs') || strcmp(ex.identifier, 'Nelson:nargoutchk:tooManyOutputs')
            feval(item.Validator, value);
            result = true;
          else
            rethrow(ex);
          end
        end
        if ~isempty(result) && islogical(result) && isscalar(result) && ~result
          error('Nelson:inputParser:validationFunctionReturnedFalse2', 'Validation function returned false.');
        end
      catch ex
        error('Nelson:validators:inputParserInvalidValue', 'The value of ''%s'' is invalid. %s', item.Name, ex.message);
      end
    end

    function tf = optionalAccepts(item, value)
      try
        inputParser.validateValue(item, value);
        tf = true;
      catch
        tf = false;
      end
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function parse(obj, varargin)
  narginchk(1, Inf);
  args = varargin;
  if obj.StructExpandValue
    args = localExpandStruct(args);
  end
  required = localSchemaOfType(obj, 'required');
  optional = localSchemaOfType(obj, 'optional');
  parameters = localSchemaOfType(obj, 'parameter');
  results = struct();
  usingDefaults = {};
  unmatched = struct();
  pos = 1;

  for k = required
    if pos > numel(args)
      localError(obj, 'notEnoughInputs', _('Not enough input arguments.'));
    end
    item = obj.Schema(k);
    inputParser.validateValue(item, args{pos});
    results.(item.Name) = args{pos};
    pos = pos + 1;
  end

  for k = optional
    item = obj.Schema(k);
    if pos <= numel(args) && ~localIsParameterStart(obj, args{pos})
      if inputParser.optionalAccepts(item, args{pos})
        results.(item.Name) = args{pos};
        pos = pos + 1;
      else
        results.(item.Name) = item.Default;
        usingDefaults{end + 1} = item.Name;
      end
    else
      results.(item.Name) = item.Default;
      usingDefaults{end + 1} = item.Name;
    end
  end

  for k = parameters
    item = obj.Schema(k);
    results.(item.Name) = item.Default;
    usingDefaults{end + 1} = item.Name;
  end

  while pos <= numel(args)
    if ~inputParser.isTextScalar(args{pos})
      localError(obj, 'invalidParameterName', 'Parameter name must be text.');
    end
    if pos == numel(args)
      localError(obj, 'nameValueNotPaired', _('Name-value arguments must be paired.'));
    end
    rawName = inputParser.textScalar(args{pos}, 'Parameter name');
    value = args{pos + 1};
    [index, ambiguous] = inputParser.resolveParameter(obj, rawName);
    if ambiguous && obj.KeepUnmatchedValue
      unmatched.(rawName) = value;
    elseif ambiguous
      localError(obj, 'ambiguousParameterName', 'Ambiguous parameter name.');
    elseif isempty(index)
      if obj.KeepUnmatchedValue
        unmatched.(rawName) = value;
      else
        localError(obj, 'unrecognizedParameterName', 'Unrecognized parameter name.');
      end
    else
      item = obj.Schema(index);
      inputParser.validateValue(item, value);
      results.(item.Name) = value;
      usingDefaults = localRemoveDefault(usingDefaults, item.Name);
    end
    pos = pos + 2;
  end

  obj.ResultsValue = results;
  obj.UnmatchedValue = unmatched;
  obj.UsingDefaultsValue = usingDefaults(:)';
end
%=============================================================================
function args = localExpandStruct(args)
  if numel(args) == 1 && isstruct(args{1}) && isscalar(args{1})
    st = args{1};
    names = fieldnames(st);
    expanded = {};
    for k = 1:numel(names)
      expanded{end + 1} = names{k};
      expanded{end + 1} = st.(names{k});
    end
    args = expanded;
  end
end
%=============================================================================
function indices = localSchemaOfType(obj, kind)
  indices = [];
  for k = 1:numel(obj.Schema)
    if strcmp(obj.Schema(k).Type, kind)
      indices(end + 1) = k;
    end
  end
end
%=============================================================================
function tf = localIsParameterStart(obj, value)
  tf = false;
  if ~inputParser.isTextScalar(value)
    return
  end
  name = inputParser.textScalar(value, 'Parameter name');
  [index, ambiguous] = inputParser.resolveParameter(obj, name);
  tf = ambiguous || ~isempty(index);
end
%=============================================================================
function names = localRemoveDefault(names, name)
  keep = true(1, numel(names));
  for k = 1:numel(names)
    if strcmp(names{k}, name)
      keep(k) = false;
    end
  end
  names = names(keep);
end
%=============================================================================
function prefix = localFunctionPrefix(obj)
  if isempty(obj.FunctionNameValue)
    prefix = '';
  else
    prefix = [obj.FunctionNameValue, ': '];
  end
end
%=============================================================================
function localError(obj, reason, msg)
  error(['Nelson:validators:inputParser:', reason], [localFunctionPrefix(obj), msg]);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function tf = __mustBeSorted__(A, dim, direction, missingPlacement, comparisonMethod)
  % Sorted check of mustBeSorted for the inputs without a native path:
  % complex, sparse, string, cell array of character vectors, 'abs'
  % comparison and objects (delegated to their issorted method).
  % dim == 0 selects the first non-singleton dimension.
  if ~(isnumeric(A) || islogical(A) || ischar(A) || isstring(A) || iscellstr(A))
    tf = localObjectIsSorted(A, dim, direction);
    return
  end
  sz = size(A);
  if dim == 0
    dim = find(sz ~= 1, 1);
    if isempty(dim)
      dim = 1;
    end
  end
  if isempty(A) || dim > numel(sz) || sz(dim) <= 1
    tf = true;
    return
  end
  isNumericInput = isnumeric(A) || islogical(A) || ischar(A);
  isComplexInput = isNumericInput && ~isreal(A);
  useAbs = isNumericInput && (strcmp(comparisonMethod, 'abs') || (strcmp(comparisonMethod, 'auto') && isComplexInput));
  useKeys = useAbs || isComplexInput;
  if iscell(A)
    A = string(A);
  end
  if issparse(A)
    A = full(A);
  end
  n = sz(dim);
  X = reshape(permute(A, [dim, 1:dim - 1, dim + 1:numel(sz)]), n, []);
  P = X(1:n - 1, :);
  Q = X(2:n, :);
  missingP = ismissing(P);
  missingQ = ismissing(Q);
  [before, same] = localCompare(P, Q, useKeys, useAbs);
  after = ~before & ~same;
  strict = strncmp(direction, 'strict', 6);
  order = strrep(direction, 'strict', '');
  tf = false;
  if ~strcmp(order, 'descend')
    tf = localInOrder(before, same, missingP, missingQ, strict, ~strcmp(missingPlacement, 'first'));
  end
  if ~tf && ~strcmp(order, 'ascend')
    tf = localInOrder(after, same, missingP, missingQ, strict, strcmp(missingPlacement, 'last'));
  end
end
%=============================================================================
function [before, same] = localCompare(P, Q, useKeys, useAbs)
  % before: P comes strictly before Q in ascending order.
  if ~useKeys
    before = P < Q;
    same = P == Q;
    return
  end
  if useAbs
    if ~isfloat(P)
      P = double(P);
      Q = double(Q);
    end
    keyP = abs(P);
    keyQ = abs(Q);
    tieP = angle(P);
    tieQ = angle(Q);
  else
    keyP = real(P);
    keyQ = real(Q);
    tieP = imag(P);
    tieQ = imag(Q);
  end
  sameKey = keyP == keyQ;
  before = keyP < keyQ | (sameKey & tieP < tieQ);
  same = sameKey & tieP == tieQ;
end
%=============================================================================
function ok = localInOrder(before, same, missingP, missingQ, strict, missingLast)
  if strict
    ok = ~any(missingP(:)) && ~any(missingQ(:)) && all(before(:));
  elseif missingLast
    ok = all(missingQ(:) | (~missingP(:) & (before(:) | same(:))));
  else
    ok = all(missingP(:) | (~missingQ(:) & (before(:) | same(:))));
  end
end
%=============================================================================
function tf = localObjectIsSorted(A, dim, direction)
  if dim == 0 && strcmp(direction, 'ascend')
    tf = issorted(A);
  elseif dim == 0
    tf = issorted(A, direction);
  else
    tf = issorted(A, dim, direction);
  end
  tf = logical(tf);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function __validateattributes__(A, classes, attributes, varargin)
  narginchk(3, 6);
  nargoutchk(0, 0);
  [funcName, varName, argIndex] = localParseContext(varargin{:});
  classes = localTextList(classes, 'classes');
  attributes = localAttributeList(attributes);
  localCheckClasses(A, classes, funcName, varName, argIndex);
  k = 1;
  while k <= numel(attributes)
    name = lower(localAttributeName(attributes{k}));
    switch name
      case {'size', 'numel', 'ncols', 'nrows', 'ndims', '>', '>=', '<', '<='}
        if k == numel(attributes)
          error('Nelson:validators:invalidAttribute', 'Attribute requires a value: %s', name);
        end
        localCheckValuedAttribute(A, name, attributes{k + 1}, funcName, varName, argIndex);
        k = k + 2;
      otherwise
        localCheckAttribute(A, name, funcName, varName, argIndex);
        k = k + 1;
    end
  end
end
%=============================================================================
function [funcName, varName, argIndex] = localParseContext(varargin)
  funcName = '';
  varName = '';
  argIndex = [];
  if nargin == 0
    return
  elseif nargin == 1
    if isnumeric(varargin{1})
      argIndex = localPositiveInteger(varargin{1}, 'argIndex');
    else
      funcName = localTextScalar(varargin{1}, 'funcName');
    end
  elseif nargin == 2
    funcName = localTextScalar(varargin{1}, 'funcName');
    varName = localTextScalar(varargin{2}, 'varName');
  elseif nargin == 3
    funcName = localTextScalar(varargin{1}, 'funcName');
    varName = localTextScalar(varargin{2}, 'varName');
    argIndex = localPositiveInteger(varargin{3}, 'argIndex');
  else
    error('Nelson:tooManyInputs', 'Too many input arguments.');
  end
end
%=============================================================================
function value = localTextScalar(value, name)
  if isstring(value) && isscalar(value)
    value = char(value);
  end
  if ~(ischar(value) && isrow(value))
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', name);
  end
end
%=============================================================================
function values = localTextList(values, name)
  if isstring(values)
    values = cellstr(values);
  end
  if ischar(values)
    values = cellstr(values);
  end
  if ~iscellstr(values)
    error('Nelson:validators:mustBeTextArray', '%s must be a string array or cell array of character vectors.', name);
  end
  values = values(:)';
end
%=============================================================================
function attributes = localAttributeList(attributes)
  if isstring(attributes)
    attributes = cellstr(attributes);
  elseif ischar(attributes)
    attributes = cellstr(attributes);
  end
  if ~iscell(attributes)
    error('Nelson:__validateattributes__:attributesACellArrayString2', 'Attributes must be a cell array or string array.');
  end
  attributes = attributes(:)';
end
%=============================================================================
function name = localAttributeName(value)
  if isstring(value) && isscalar(value)
    value = char(value);
  end
  if ~(ischar(value) && isrow(value))
    error('Nelson:__validateattributes__:attributeNameText2', 'Attribute name must be text.');
  end
  name = value;
end
%=============================================================================
function value = localPositiveInteger(value, name)
  if ~(isnumeric(value) && isscalar(value) && isfinite(value) && value >= 1 && fix(value) == value)
    error('Nelson:validators:mustBePositiveInteger', '%s must be a positive integer.', name);
  end
  value = double(value);
end
%=============================================================================
function localCheckClasses(A, classes, funcName, varName, argIndex)
  ok = false;
  for k = 1:numel(classes)
    cls = classes{k};
    if strcmpi(cls, 'numeric')
      ok = isnumeric(A);
    elseif strcmpi(cls, 'integer')
      ok = isinteger(A);
    elseif strcmpi(cls, 'float')
      ok = isa(A, 'double') || isa(A, 'single');
    else
      ok = isa(A, cls);
    end
    if ok
      return
    end
  end
  if isempty(funcName)
    error('Nelson:validators:invalidType', ...
      '%s must be one of the following types: %s. Instead its type was %s.', ...
      localSubject(varName, argIndex), localJoin(classes), class(A));
  end
  error(['Nelson:', funcName, ':invalidType'], ...
    '%s must be one of the following types: %s. Instead its type was %s.', ...
    localSubject(varName, argIndex), localJoin(classes), class(A));
end
%=============================================================================
function localCheckValuedAttribute(A, name, value, funcName, varName, argIndex)
  switch name
    case 'size'
      expected = double(value(:)');
      actual = size(A);
      if numel(actual) < numel(expected)
        actual(numel(actual) + 1:numel(expected)) = 1;
      end
      ok = numel(actual) == numel(expected);
      if ok
        for k = 1:numel(expected)
          if ~isnan(expected(k)) && actual(k) ~= expected(k)
            ok = false;
          end
        end
      end
      if ~(ok)
        if isempty(funcName)
          error('Nelson:incorrectSize', '%s must be of the requested size.', localSubject(varName, argIndex));
        end
        error(['Nelson:', funcName, ':incorrectSize'], '%s must be of the requested size.', localSubject(varName, argIndex));
      end
    case 'numel'
      if ~(numel(A) == value)
        if isempty(funcName)
          error('Nelson:incorrectNumel', '%s must have the requested number of elements.', localSubject(varName, argIndex));
        end
        error(['Nelson:', funcName, ':incorrectNumel'], '%s must have the requested number of elements.', localSubject(varName, argIndex));
      end
    case 'ncols'
      if ~(size(A, 2) == value)
        if isempty(funcName)
          error('Nelson:incorrectNumcols', '%s must have the requested number of columns.', localSubject(varName, argIndex));
        end
        error(['Nelson:', funcName, ':incorrectNumcols'], '%s must have the requested number of columns.', localSubject(varName, argIndex));
      end
    case 'nrows'
      if ~(size(A, 1) == value)
        if isempty(funcName)
          error('Nelson:incorrectNumrows', '%s must have the requested number of rows.', localSubject(varName, argIndex));
        end
        error(['Nelson:', funcName, ':incorrectNumrows'], '%s must have the requested number of rows.', localSubject(varName, argIndex));
      end
    case 'ndims'
      if ~(ndims(A) == value)
        if isempty(funcName)
          error('Nelson:incorrectNumdims', '%s must have the requested number of dimensions.', localSubject(varName, argIndex));
        end
        error(['Nelson:', funcName, ':incorrectNumdims'], '%s must have the requested number of dimensions.', localSubject(varName, argIndex));
      end
    case {'>', '>=', '<', '<='}
      localCheckComparison(A, name, value, funcName, varName, argIndex);
  end
end
%=============================================================================
function localCheckAttribute(A, name, funcName, varName, argIndex)
  subject = localSubject(varName, argIndex);
  switch name
    case '2d'
      if ~(ndims(A) == 2)
        if isempty(funcName)
          error('Nelson:expected2D', '%s must be 2-D.', subject);
        end
        error(['Nelson:', funcName, ':expected2D'], '%s must be 2-D.', subject);
      end
    case '3d'
      if ~(ndims(A) <= 3)
        if isempty(funcName)
          error('Nelson:expected3D', '%s must be 3-D or less.', subject);
        end
        error(['Nelson:', funcName, ':expected3D'], '%s must be 3-D or less.', subject);
      end
    case 'column'
      if ~(iscolumn(A))
        if isempty(funcName)
          error('Nelson:expectedColumn', '%s must be a column vector.', subject);
        end
        error(['Nelson:', funcName, ':expectedColumn'], '%s must be a column vector.', subject);
      end
    case 'row'
      if ~(isrow(A))
        if isempty(funcName)
          error('Nelson:expectedRow', '%s must be a row vector.', subject);
        end
        error(['Nelson:', funcName, ':expectedRow'], '%s must be a row vector.', subject);
      end
    case 'scalar'
      if ~(isscalar(A))
        if isempty(funcName)
          error('Nelson:expectedScalar', '%s must be a scalar.', subject);
        end
        error(['Nelson:', funcName, ':expectedScalar'], '%s must be a scalar.', subject);
      end
    case 'scalartext'
      if ~(localIsTextScalar(A))
        if isempty(funcName)
          error('Nelson:expectedScalartext', '%s must be scalar text.', subject);
        end
        error(['Nelson:', funcName, ':expectedScalartext'], '%s must be scalar text.', subject);
      end
    case 'vector'
      if ~(isvector(A))
        if isempty(funcName)
          error('Nelson:expectedVector', '%s must be a vector.', subject);
        end
        error(['Nelson:', funcName, ':expectedVector'], '%s must be a vector.', subject);
      end
    case 'square'
      if ~(ismatrix(A) && size(A, 1) == size(A, 2))
        if isempty(funcName)
          error('Nelson:expectedSquare', '%s must be square.', subject);
        end
        error(['Nelson:', funcName, ':expectedSquare'], '%s must be square.', subject);
      end
    case 'diag'
      if ~(isdiag(A))
        if isempty(funcName)
          error('Nelson:expectedDiag', '%s must be diagonal.', subject);
        end
        error(['Nelson:', funcName, ':expectedDiag'], '%s must be diagonal.', subject);
      end
    case 'nonempty'
      if ~(~isempty(A))
        if isempty(funcName)
          error('Nelson:expectedNonempty', '%s must be nonempty.', subject);
        end
        error(['Nelson:', funcName, ':expectedNonempty'], '%s must be nonempty.', subject);
      end
    case 'nonsparse'
      if ~(~issparse(A))
        if isempty(funcName)
          error('Nelson:expectedNonsparse', '%s must be nonsparse.', subject);
        end
        error(['Nelson:', funcName, ':expectedNonsparse'], '%s must be nonsparse.', subject);
      end
    case 'finite'
      if ~(all(isfinite(A(:))))
        if isempty(funcName)
          error('Nelson:expectedFinite', '%s must be finite.', subject);
        end
        error(['Nelson:', funcName, ':expectedFinite'], '%s must be finite.', subject);
      end
    case 'nonnan'
      if ~(~any(isnan(A(:))))
        if isempty(funcName)
          error('Nelson:expectedNonNaN', '%s must not be NaN.', subject);
        end
        error(['Nelson:', funcName, ':expectedNonNaN'], '%s must not be NaN.', subject);
      end
    case 'binary'
      if ~(localIsRealNumericOrLogical(A) && all(A(:) == 0 | A(:) == 1))
        if isempty(funcName)
          error('Nelson:expectedBinary', '%s must be binary.', subject);
        end
        error(['Nelson:', funcName, ':expectedBinary'], '%s must be binary.', subject);
      end
    case 'even'
      if ~(localIsIntegerValued(A) && all(rem(double(A(:)), 2) == 0))
        if isempty(funcName)
          error('Nelson:expectedEven', '%s must be even.', subject);
        end
        error(['Nelson:', funcName, ':expectedEven'], '%s must be even.', subject);
      end
    case 'odd'
      if ~(localIsIntegerValued(A) && all(rem(double(A(:)), 2) ~= 0))
        if isempty(funcName)
          error('Nelson:expectedOdd', '%s must be odd.', subject);
        end
        error(['Nelson:', funcName, ':expectedOdd'], '%s must be odd.', subject);
      end
    case 'integer'
      if ~(localIsIntegerValued(A))
        if isempty(funcName)
          error('Nelson:expectedInteger', '%s must be an integer.', subject);
        end
        error(['Nelson:', funcName, ':expectedInteger'], '%s must be an integer.', subject);
      end
    case 'real'
      if ~(isreal(A))
        if isempty(funcName)
          error('Nelson:expectedReal', '%s must be real.', subject);
        end
        error(['Nelson:', funcName, ':expectedReal'], '%s must be real.', subject);
      end
    case 'nonnegative'
      if ~(localIsRealNumericOrLogical(A) && all(A(:) >= 0))
        if isempty(funcName)
          error('Nelson:expectedNonnegative', '%s must be nonnegative.', subject);
        end
        error(['Nelson:', funcName, ':expectedNonnegative'], '%s must be nonnegative.', subject);
      end
    case 'nonpositive'
      if ~(localIsRealNumericOrLogical(A) && all(A(:) <= 0))
        if isempty(funcName)
          error('Nelson:expectedNonpositive', '%s must be nonpositive.', subject);
        end
        error(['Nelson:', funcName, ':expectedNonpositive'], '%s must be nonpositive.', subject);
      end
    case 'negative'
      if ~(localIsRealNumericOrLogical(A) && all(A(:) < 0))
        if isempty(funcName)
          error('Nelson:expectedNegative', '%s must be negative.', subject);
        end
        error(['Nelson:', funcName, ':expectedNegative'], '%s must be negative.', subject);
      end
    case 'nonzero'
      if ~(localIsRealNumericOrLogical(A) && ~any(A(:) == 0))
        if isempty(funcName)
          error('Nelson:expectedNonZero', '%s must be nonzero.', subject);
        end
        error(['Nelson:', funcName, ':expectedNonZero'], '%s must be nonzero.', subject);
      end
    case 'positive'
      if ~(localIsRealNumericOrLogical(A) && all(A(:) > 0))
        if isempty(funcName)
          error('Nelson:expectedPositive', '%s must be positive.', subject);
        end
        error(['Nelson:', funcName, ':expectedPositive'], '%s must be positive.', subject);
      end
    case {'decreasing', 'increasing', 'nondecreasing', 'nonincreasing'}
      localCheckMonotonic(A, name, funcName, varName, argIndex);
    otherwise
      error('Nelson:validators:unknownAttribute', 'Unknown attribute: %s', name);
  end
end
%=============================================================================
function localCheckComparison(A, op, value, funcName, varName, argIndex)
  ok = localIsRealNumericOrLogical(A);
  if ok
    switch op
      case '>'
        ok = all(A(:) > value);
      case '>='
        ok = all(A(:) >= value);
      case '<'
        ok = all(A(:) < value);
      case '<='
        ok = all(A(:) <= value);
    end
  end
  if ~(ok)
    subject = localSubject(varName, argIndex);
    switch op
      case '>'
        if isempty(funcName)
          error('Nelson:notGreater', '%s must satisfy the requested range.', subject);
        end
        error(['Nelson:', funcName, ':notGreater'], '%s must satisfy the requested range.', subject);
      case '>='
        if isempty(funcName)
          error('Nelson:notGreaterEqual', '%s must satisfy the requested range.', subject);
        end
        error(['Nelson:', funcName, ':notGreaterEqual'], '%s must satisfy the requested range.', subject);
      case '<'
        if isempty(funcName)
          error('Nelson:notLess', '%s must satisfy the requested range.', subject);
        end
        error(['Nelson:', funcName, ':notLess'], '%s must satisfy the requested range.', subject);
      otherwise
        if isempty(funcName)
          error('Nelson:notLessEqual', '%s must satisfy the requested range.', subject);
        end
        error(['Nelson:', funcName, ':notLessEqual'], '%s must satisfy the requested range.', subject);
    end
  end
end
%=============================================================================
function localCheckMonotonic(A, name, funcName, varName, argIndex)
  ok = localIsRealNumericOrLogical(A) && ~any(isnan(A(:)));
  if ok && size(A, 1) > 1
    D = diff(A, 1, 1);
    switch name
      case 'decreasing'
        ok = all(D(:) < 0);
      case 'increasing'
        ok = all(D(:) > 0);
      case 'nondecreasing'
        ok = all(D(:) >= 0);
      case 'nonincreasing'
        ok = all(D(:) <= 0);
    end
  end
  if ~ok
    subject = localSubject(varName, argIndex);
    switch name
      case 'decreasing'
        if isempty(funcName)
          error('Nelson:expectedDecreasing', '%s must satisfy the requested monotonicity.', subject);
        end
        error(['Nelson:', funcName, ':expectedDecreasing'], '%s must satisfy the requested monotonicity.', subject);
      case 'increasing'
        if isempty(funcName)
          error('Nelson:expectedIncreasing', '%s must satisfy the requested monotonicity.', subject);
        end
        error(['Nelson:', funcName, ':expectedIncreasing'], '%s must satisfy the requested monotonicity.', subject);
      case 'nondecreasing'
        if isempty(funcName)
          error('Nelson:expectedNondecreasing', '%s must satisfy the requested monotonicity.', subject);
        end
        error(['Nelson:', funcName, ':expectedNondecreasing'], '%s must satisfy the requested monotonicity.', subject);
      otherwise
        if isempty(funcName)
          error('Nelson:expectedNonincreasing', '%s must satisfy the requested monotonicity.', subject);
        end
        error(['Nelson:', funcName, ':expectedNonincreasing'], '%s must satisfy the requested monotonicity.', subject);
    end
  end
end
%=============================================================================
function tf = localIsTextScalar(A)
  tf = (ischar(A) && isrow(A)) || (isstring(A) && isscalar(A));
end
%=============================================================================
function tf = localIsRealNumericOrLogical(A)
  tf = (isnumeric(A) || islogical(A)) && isreal(A);
end
%=============================================================================
function tf = localIsIntegerValued(A)
  tf = localIsRealNumericOrLogical(A) && all(isfinite(A(:))) && all(fix(double(A(:))) == double(A(:)));
end
%=============================================================================
function msg = localSubject(varName, argIndex)
  if ~isempty(argIndex) && ~isempty(varName)
    msg = sprintf('input number %d (%s)', argIndex, varName);
  elseif ~isempty(argIndex)
    msg = sprintf('input number %d', argIndex);
  elseif ~isempty(varName)
    msg = sprintf('input %s', varName);
  else
    msg = 'input';
  end
end
%=============================================================================
function txt = localJoin(values)
  txt = '';
  for k = 1:numel(values)
    if k > 1
      txt = [txt, ', '];
    end
    txt = [txt, values{k}];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function matched = __validatestring__(str, validStrings, varargin)
  narginchk(2, 5);
  nargoutchk(0, 1);
  [funcName, varName, argIndex] = localParseContext(varargin{:});
  strValue = localTextScalar(str, 'str');
  validWasString = isstring(validStrings);
  choices = localTextList(validStrings, 'validStrings');
  if isempty(choices)
    localError(funcName, 'unrecognizedStringChoice', ...
      localExpectedMessage(choices, strValue, varName, argIndex));
  end
  lowerInput = lower(strValue);
  exact = [];
  for k = 1:numel(choices)
    if strcmp(lowerInput, lower(choices{k}))
      exact = k;
      break
    end
  end
  if ~isempty(exact)
    matched = localReturnValue(choices{exact}, validWasString);
    return
  end
  matches = [];
  for k = 1:numel(choices)
    candidate = lower(choices{k});
    if length(lowerInput) <= length(candidate) && strcmp(lowerInput, candidate(1:length(lowerInput)))
      matches(end + 1) = k;
    end
  end
  if isempty(matches)
    localError(funcName, 'unrecognizedStringChoice', ...
      localExpectedMessage(choices, strValue, varName, argIndex));
  end
  if numel(matches) > 1
    if ~localSubstringChain(choices(matches))
      localError(funcName, 'ambiguousStringChoice', ...
        localAmbiguousMessage(choices(matches), strValue, varName, argIndex));
    end
    lengths = zeros(1, numel(matches));
    for k = 1:numel(matches)
      lengths(k) = length(choices{matches(k)});
    end
    [~, pos] = min(lengths);
    matches = matches(pos);
  end
  matched = localReturnValue(choices{matches(1)}, validWasString);
end
%=============================================================================
function [funcName, varName, argIndex] = localParseContext(varargin)
  funcName = '';
  varName = '';
  argIndex = [];
  if nargin == 0
    return
  elseif nargin == 1
    if isnumeric(varargin{1})
      argIndex = localPositiveInteger(varargin{1}, 'argIdx');
    else
      funcName = localTextScalar(varargin{1}, 'funcName');
    end
  elseif nargin == 2
    funcName = localTextScalar(varargin{1}, 'funcName');
    varName = localTextScalar(varargin{2}, 'varName');
  elseif nargin == 3
    funcName = localTextScalar(varargin{1}, 'funcName');
    varName = localTextScalar(varargin{2}, 'varName');
    argIndex = localPositiveInteger(varargin{3}, 'argIdx');
  else
    error('Nelson:tooManyInputs', 'Too many input arguments.');
  end
end
%=============================================================================
function value = localTextScalar(value, name)
  if isstring(value) && isscalar(value)
    value = char(value);
  end
  if ~(ischar(value) && isrow(value))
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', name);
  end
end
%=============================================================================
function values = localTextList(values, name)
  if isstring(values)
    values = cellstr(values);
  end
  if ischar(values)
    values = cellstr(values);
  end
  if ~iscellstr(values)
    error('Nelson:validators:mustBeTextArray', '%s must be a string array or cell array of character vectors.', name);
  end
  values = values(:)';
end
%=============================================================================
function value = localPositiveInteger(value, name)
  if ~(isnumeric(value) && isscalar(value) && isfinite(value) && value >= 1 && fix(value) == value)
    error('Nelson:validators:mustBePositiveInteger', '%s must be a positive integer.', name);
  end
  value = double(value);
end
%=============================================================================
function matched = localReturnValue(value, validWasString)
  if validWasString
    matched = string(value);
  else
    matched = value;
  end
end
%=============================================================================
function tf = localSubstringChain(values)
  tf = true;
  for i = 1:numel(values)
    for j = 1:numel(values)
      if i ~= j
        a = lower(values{i});
        b = lower(values{j});
        shorter = a;
        longer = b;
        if length(a) > length(b)
          shorter = b;
          longer = a;
        end
        if length(shorter) > length(longer) || ~strcmp(shorter, longer(1:length(shorter)))
          tf = false;
          return
        end
      end
    end
  end
end
%=============================================================================
function msg = localExpectedMessage(choices, inputValue, varName, argIndex)
  msg = localPrefix(varName, argIndex);
  msg = [msg, 'to match one of these values:', newline(), newline(), localChoices(choices), ...
    newline(), newline(), 'The input', ', ''', inputValue, ''', ', ...
    'did not match any of the valid values.'];
end
%=============================================================================
function msg = localAmbiguousMessage(choices, inputValue, varName, argIndex)
  msg = localPrefix(varName, argIndex);
  msg = [msg, 'to match one of these values:', newline(), newline(), localChoices(choices), ...
    newline(), newline(), 'The input', ', ''', inputValue, ''', ', ...
    'matched more than one valid value.'];
end
%=============================================================================
function msg = localPrefix(varName, argIndex)
  if ~isempty(argIndex) && ~isempty(varName)
    msg = sprintf('Expected input number %d, %s,', argIndex, varName);
  elseif ~isempty(argIndex)
    msg = sprintf('Expected input number %d', argIndex);
  elseif ~isempty(varName)
    msg = sprintf('Expected input %s', varName);
  else
    msg = 'Expected input';
  end
  msg = [msg, ' '];
end
%=============================================================================
function txt = localChoices(choices)
  txt = '';
  for k = 1:numel(choices)
    if k > 1
      txt = [txt, ', '];
    end
    txt = [txt, '''', choices{k}, ''''];
  end
end
%=============================================================================
function localError(funcName, reason, msg)
  id = ['Nelson:validators:', reason];
  if ~isempty(funcName)
    id = ['Nelson:', funcName, ':', reason];
  end
  error(id, msg);
end
