% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function tf = optimFminuncIsLBFGS(opts)
  value = opts.HessianApproximation;
  if iscell(value)
    tf = strcmpi(char(value{1}), 'lbfgs');
  elseif ischar(value) || isstring(value)
    tf = strcmpi(char(value), 'lbfgs');
  else
    tf = false;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function m = optimFminuncLBFGSMemory(opts)
  value = opts.HessianApproximation;
  if iscell(value) && numel(value) >= 2
    m = max(1, round(double(value{2})));
  else
    m = 10;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function z = optimFminuncLBFGSMultiply(memory, g)
  q = g(:);
  alpha = zeros(numel(memory), 1);
  for k = numel(memory):-1:1
    alpha(k) = memory{k}.rho * (memory{k}.s' * q);
    q = q - alpha(k) * memory{k}.y;
  end
  z = scaleInitial(memory, q);
  for k = 1:numel(memory)
    beta = memory{k}.rho * (memory{k}.y' * z);
    z = z + memory{k}.s * (alpha(k) - beta);
  end
end
%=============================================================================
function z = scaleInitial(memory, q)
  if isempty(memory)
    z = q;
    return
  end
  last = memory{end};
  gamma = (last.s' * last.y) / max(last.y' * last.y, eps);
  z = gamma * q;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function memory = optimFminuncLBFGSUpdate(memory, s, y, maxMemory)
  entry.s = s;
  entry.y = y;
  entry.rho = 1 / max(y' * s, eps);
  memory{end + 1} = entry;
  while numel(memory) > maxMemory
    memory(1) = [];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function output = optimFminuncOutput(iter, funcCount, state, algorithm, message, stepSize)
  output.iterations = iter;
  output.funcCount = funcCount;
  output.stepsize = stepSize;
  output.algorithm = algorithm;
  output.firstorderopt = norm(state.grad, Inf);
  output.message = message;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function data = optimFminuncPrepare(fun, x0, opts)
  if isempty(x0)
    error('Nelson:validators:mustBeNonempty', '%s must be nonempty.', 'Initial point');
  end
  if ~isnumeric(x0) || ~isreal(x0)
    error('Nelson:optimization:invalidInitialPoint', '%s must be a real numeric array.', 'Initial point');
  end
  if ~(isa(fun, 'function_handle') || ischar(fun) || isstring(fun))
    error('Nelson:optimization:invalidObjective', 'Objective must be a function handle or a function name.');
  end
  algorithm = lower(char(opts.Algorithm));
  if strcmp(algorithm, 'default')
    algorithm = 'quasi-newton';
  end
  if ~any(strcmp(algorithm, {'quasi-newton', 'trust-region'}))
    error('Nelson:optim:invalidOptionValue', 'Invalid value for "%s".', 'Algorithm');
  end
  validateTextChoice(opts.Display, {'off', 'none', 'final', 'final-detailed', 'notify', ...
    'notify-detailed', 'iter', 'iter-detailed'}, sprintf(_('Invalid value for "%s".'), 'Display'));
  validateTextChoice(opts.Diagnostics, {'on', 'off'}, sprintf(_('Invalid value for "%s".'), 'Diagnostics'));
  validateTextChoice(opts.FiniteDifferenceType, {'forward', 'central'}, sprintf(_('Invalid value for "%s".'), 'FiniteDifferenceType'));
  if strcmp(algorithm, 'trust-region') && ~hasGradient(opts)
    algorithm = 'quasi-newton';
  end
  data.fun = fun;
  data.x0 = double(x0(:));
  data.xShape = size(x0);
  data.algorithm = algorithm;
end
%=============================================================================
function tf = hasGradient(opts)
  tf = opts.SpecifyObjectiveGradient || strcmpi(opts.GradObj, 'on');
end
%=============================================================================
function validateTextChoice(value, choices, message)
  value = lower(char(value));
  if ~any(strcmp(value, choices))
    error('Nelson:optimization:invalidValue', message);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [fun, x0, options] = optimFminuncProblem(problem)
  if ~isfield(problem, 'objective') || ~isfield(problem, 'x0')
    error('Nelson:optimization:problemMissingObjective', 'Problem structure must contain %s fields.', 'objective and x0');
  end
  if ~isfield(problem, 'solver') || ~isfield(problem, 'options')
    error('Nelson:optimization:invalidProblemStructure', 'Problem structure must contain %s fields.', 'solver and options');
  end
  if ~strcmpi(char(problem.solver), 'fminunc')
    error('Nelson:optimization:invalidProblemSolver', 'Problem solver must be %s.', 'fminunc');
  end
  fun = problem.objective;
  x0 = problem.x0;
  options = problem.options;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function result = optimFminuncQuasiNewton(data, opts)
  x = data.x0; H = eye(length(x)); memory = {};
  [state, funcCount] = optimFminuncState(data.fun, x, opts);
  optimFminuncDisplay(opts, 'header', [], '');
  if optimOutputStop(opts.OutputFcn, x, optimFminuncValues(state, 0, funcCount, 0), 'init')
    result = finish(data, opts, x, state, H, -1, 0, funcCount, _('Stopped by output function.'), 0);
    return
  end
  exitflag = 0; message = _('Maximum number of iterations or function evaluations reached.'); stepSize = 0;
  for iter = 1:opts.MaxIter
    if state.f <= opts.ObjectiveLimit
      exitflag = -3; message = _('Objective limit reached.'); break
    end
    if norm(state.grad, Inf) <= opts.OptimalityTolerance
      exitflag = 1; message = _('Local minimum found.'); break
    end
    direction = searchDirection(H, state.grad, memory, opts);
    [trial, trialState, accepted, stepSize, count] = lineSearch(data, opts, x, state, direction);
    funcCount = funcCount + count;
    if ~accepted
      exitflag = 0; message = 'Line search failed to find a lower objective value.'; break
    end
    s = trial - x; y = trialState.grad - state.grad;
    [H, memory] = updateHessian(H, memory, s, y, opts);
    if abs(state.f - trialState.f) <= opts.FunctionTolerance
      x = trial; state = trialState; exitflag = 3; message = _('Function tolerance reached.'); break
    end
    x = trial; state = trialState;
    current = optimFminuncValues(state, iter, funcCount, stepSize);
    optimFminuncDisplay(opts, 'iter', current, '');
    if optimOutputStop(opts.OutputFcn, x, current, 'iter')
      exitflag = -1; message = _('Stopped by output function.'); break
    end
    if stepSize <= opts.StepTolerance
      exitflag = 2; message = _('Step size tolerance reached.'); break
    end
    if funcCount >= opts.MaxFunEvals
      break
    end
  end
  result = finish(data, opts, x, state, H, exitflag, iter, funcCount, message, stepSize);
end
%=============================================================================
function d = searchDirection(H, g, memory, opts)
  if optimFminuncIsLBFGS(opts)
    d = -optimFminuncLBFGSMultiply(memory, g);
  elseif optionEquals(opts.HessianApproximation, 'steepdesc') || optionEquals(opts.HessUpdate, 'steepdesc')
    d = -g;
  else
    d = -optimFminuncSafeSolve(H, g);
  end
  if any(~isfinite(d)) || norm(d) == 0, d = -g; end
end
%=============================================================================
function [trial, trialState, accepted, stepSize, count] = lineSearch(data, opts, x, state, direction)
  alpha = 1; accepted = false; trial = x; trialState = state; count = 0; stepSize = 0;
  slope = state.grad' * direction;
  if slope >= 0, direction = -state.grad; slope = -state.grad' * state.grad; end
  for k = 1:30
    candidate = x + alpha * direction;
    [candidateState, added] = optimFminuncState(data.fun, candidate, opts);
    count = count + added;
    if candidateState.f <= state.f + 1e-4 * alpha * slope
      trial = candidate; trialState = candidateState; stepSize = norm(alpha * direction, Inf);
      accepted = true; return
    end
    alpha = alpha / 2;
  end
end
%=============================================================================
function [H, memory] = updateHessian(H, memory, s, y, opts)
  if s' * y <= 1e-12 * max(1, norm(s) * norm(y)), return; end
  if optimFminuncIsLBFGS(opts)
    memory = optimFminuncLBFGSUpdate(memory, s, y, optimFminuncLBFGSMemory(opts)); return
  end
  if optionEquals(opts.HessUpdate, 'dfp') || optionEquals(opts.HessianApproximation, 'dfp')
    H = dfpUpdate(H, s, y);
  elseif ~optionEquals(opts.HessianApproximation, 'steepdesc')
    H = bfgsUpdate(H, s, y);
  end
  H = (H + H') / 2;
end
%=============================================================================
function tf = optionEquals(value, expected)
  tf = false;
  if iscell(value)
    if isempty(value), return; end
    value = value{1};
  end
  if ischar(value) || isstring(value)
    tf = strcmpi(char(value), expected);
  end
end
%=============================================================================
function H = bfgsUpdate(H, s, y)
  Hs = H * s;
  H = H - (Hs * Hs') / max(s' * Hs, eps) + (y * y') / max(s' * y, eps);
end
%=============================================================================
function H = dfpUpdate(H, s, y)
  Hy = H * y;
  H = H + (s * s') / max(s' * y, eps) - (Hy * Hy') / max(y' * Hy, eps);
end
%=============================================================================
function result = finish(data, opts, x, state, H, exitflag, iter, funcCount, message, stepSize)
  output = optimFminuncOutput(iter, funcCount, state, data.algorithm, optimFminuncExitMessage(exitflag, message), stepSize);
  optimFminuncDisplay(opts, 'final', [], output.message);
  optimOutputStop(opts.OutputFcn, x, optimFminuncValues(state, iter, funcCount, stepSize), 'done');
  result.x = x; result.fval = state.f; result.exitflag = exitflag;
  result.output = output; result.grad = state.grad; result.hessian = H;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function x = optimFminuncSafeSolve(A, b)
  try
    x = A \ b;
    if all(isfinite(x))
      return
    end
  catch
  end
  x = pinv(A) * b;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [state, count] = optimFminuncState(fun, x, opts)
  if useHessianOutput(opts)
    [state.f, state.grad, state.hessian] = optimCall(fun, x);
    state.f = scalarValue(state.f, opts);
    state.grad = double(state.grad(:));
    state.hessian = double(state.hessian);
    count = 1;
    return
  end
  if useGradient(opts)
    [state.f, state.grad] = optimCall(fun, x);
    state.f = scalarValue(state.f, opts);
    state.grad = double(state.grad(:));
    state.hessian = [];
    count = 1;
    return
  end
  state.f = scalarValue(optimCall(fun, x), opts);
  state.grad = finiteGradient(fun, x, state.f, opts);
  state.hessian = [];
  count = 1 + finiteCount(x, opts);
end
%=============================================================================
function tf = useGradient(opts)
  tf = opts.SpecifyObjectiveGradient || strcmpi(opts.GradObj, 'on');
end
%=============================================================================
function tf = useHessianOutput(opts)
  tf = useGradient(opts) && (ischar(opts.HessianFcn) || isstring(opts.HessianFcn)) ...
    && strcmpi(char(opts.HessianFcn), 'objective');
end
%=============================================================================
function f = scalarValue(value, opts)
  value = optimCheckFunValue(value, opts);
  if ~isnumeric(value) || ~isscalar(value)
    error('Nelson:optimization:invalidObjectiveScalar', '%s must return a numeric scalar.', 'Objective function');
  end
  f = double(value);
end
%=============================================================================
function g = finiteGradient(fun, x, f0, opts)
  step = finiteStep(x, opts);
  g = zeros(length(x), 1);
  useCentral = strcmpi(opts.FiniteDifferenceType, 'central');
  for k = 1:length(x)
    if useCentral
      xp = x; xm = x;
      xp(k) = xp(k) + step(k); xm(k) = xm(k) - step(k);
      fp = scalarValue(optimCall(fun, xp), opts);
      fm = scalarValue(optimCall(fun, xm), opts);
      g(k) = (fp - fm) / (2 * step(k));
    else
      xp = x; xp(k) = xp(k) + step(k);
      fp = scalarValue(optimCall(fun, xp), opts);
      g(k) = (fp - f0) / step(k);
    end
  end
end
%=============================================================================
function count = finiteCount(x, opts)
  if strcmpi(opts.FiniteDifferenceType, 'central')
    count = 2 * length(x);
  else
    count = length(x);
  end
end
%=============================================================================
function step = finiteStep(x, opts)
  scale = finiteScale(x, opts);
  if isempty(opts.FiniteDifferenceStepSize)
    if strcmpi(opts.FiniteDifferenceType, 'central')
      base = eps ^ (1 / 3);
    else
      base = sqrt(eps);
    end
    step = base * scale;
  elseif isscalar(opts.FiniteDifferenceStepSize)
    step = double(opts.FiniteDifferenceStepSize) * scale;
  else
    step = double(opts.FiniteDifferenceStepSize(:)) .* scale;
  end
  step(step == 0) = sqrt(eps);
end
%=============================================================================
function scale = finiteScale(x, opts)
  scale = abs(x(:));
  t = typicalX(opts, length(scale));
  t = t(:);
  mask = scale < t;
  scale(mask) = t(mask);
end
%=============================================================================
function t = typicalX(opts, n)
  if isempty(opts.TypicalX)
    t = ones(n, 1);
  elseif isscalar(opts.TypicalX)
    t = double(opts.TypicalX) * ones(n, 1);
  else
    t = double(opts.TypicalX(:));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function result = optimFminuncTrustRegion(data, opts)
  x = data.x0; radius = max(1, norm(x, Inf));
  [state, funcCount] = optimFminuncState(data.fun, x, opts);
  H = hessianMatrix(state, length(x));
  optimFminuncDisplay(opts, 'header', [], '');
  if optimOutputStop(opts.OutputFcn, x, optimFminuncValues(state, 0, funcCount, 0), 'init')
    result = finish(data, opts, x, state, H, -1, 0, funcCount, _('Stopped by output function.'), 0);
    return
  end
  exitflag = 0; message = _('Maximum number of iterations or function evaluations reached.'); stepSize = 0;
  for iter = 1:opts.MaxIter
    if norm(state.grad, Inf) <= opts.OptimalityTolerance
      exitflag = 1; message = _('Local minimum found.'); break
    end
    step = trustStep(H, state.grad, radius, opts);
    if norm(step, Inf) <= opts.StepTolerance
      exitflag = 2; message = _('Step size tolerance reached.'); break
    end
    [trialState, count] = optimFminuncState(data.fun, x + step, opts);
    funcCount = funcCount + count;
    predicted = -state.grad' * step - 0.5 * step' * H * step;
    ratio = (state.f - trialState.f) / max(predicted, eps);
    if ratio > 0
      s = step; y = trialState.grad - state.grad;
      x = x + step; state = trialState;
      H = hessianOrBFGS(state, H, s, y);
    end
    radius = updateRadius(radius, step, ratio);
    stepSize = norm(step, Inf);
    current = optimFminuncValues(state, iter, funcCount, stepSize);
    optimFminuncDisplay(opts, 'iter', current, '');
    if optimOutputStop(opts.OutputFcn, x, current, 'iter')
      exitflag = -1; message = _('Stopped by output function.'); break
    end
    if abs(predicted) <= opts.FunctionTolerance
      exitflag = 3; message = _('Function tolerance reached.'); break
    end
    if funcCount >= opts.MaxFunEvals, break; end
  end
  result = finish(data, opts, x, state, H, exitflag, iter, funcCount, message, stepSize);
  result = fallbackQuasiNewton(result, data, opts);
end
%=============================================================================
function result = fallbackQuasiNewton(result, data, opts)
  if result.exitflag > 0
    return
  end
  quiet = opts;
  quiet.Display = 'off';
  quiet.OutputFcn = [];
  candidate = optimFminuncQuasiNewton(data, quiet);
  candidate.output.algorithm = 'trust-region';
  if candidate.exitflag > 0 || candidate.fval < result.fval
    result = candidate;
  end
end
%=============================================================================
function step = trustStep(H, g, radius, opts)
  if strcmpi(opts.SubproblemAlgorithm, 'factorization') || isinf(opts.PrecondBandWidth)
    step = -optimFminuncSafeSolve(H + 1e-8 * eye(length(g)), g);
    if norm(step) > radius, step = step * (radius / norm(step)); end
  else
    step = truncatedCG(H, g, radius, opts);
  end
end
%=============================================================================
function p = truncatedCG(H, g, radius, opts)
  maxIter = pcgIterations(opts, length(g)); p = zeros(length(g), 1); r = -g; d = r;
  tol = max(optionTolPCG(opts) * norm(g), eps);
  for k = 1:maxIter
    Hd = hessProduct(H, d, opts);
    dHd = d' * Hd;
    if dHd <= eps, p = boundaryStep(p, d, radius); return; end
    alpha = (r' * r) / dHd; candidate = p + alpha * d;
    if norm(candidate) >= radius, p = boundaryStep(p, d, radius); return; end
    old = r' * r; p = candidate; r = r - alpha * Hd;
    if norm(r) <= tol, return; end
    d = r + (r' * r / max(old, eps)) * d;
  end
end
%=============================================================================
function Hd = hessProduct(H, d, opts)
  if ~isempty(opts.HessianMultiplyFcn)
    Hd = opts.HessianMultiplyFcn(H, d);
  elseif ~isempty(opts.HessMult)
    Hd = opts.HessMult(H, d);
  else
    Hd = H * d;
  end
  Hd = double(Hd(:));
end
%=============================================================================
function p = boundaryStep(p, d, radius)
  a = d' * d; b = 2 * (p' * d); c = p' * p - radius ^ 2;
  tau = (-b + sqrt(max(0, b ^ 2 - 4 * a * c))) / max(2 * a, eps);
  p = p + tau * d;
end
%=============================================================================
function n = pcgIterations(opts, vars)
  if isempty(opts.MaxPCGIter), n = max(1, floor(vars / 2)); else, n = opts.MaxPCGIter; end
end
%=============================================================================
function tol = optionTolPCG(opts)
  if isfield(opts, 'TolPCG') && ~isempty(opts.TolPCG), tol = opts.TolPCG; else, tol = 0.1; end
end
%=============================================================================
function H = hessianMatrix(state, n)
  if ~isempty(state.hessian), H = double(state.hessian); else, H = eye(n); end
  if ~isequal(size(H), [n, n]), H = eye(n); end
  H = (H + H') / 2;
end
%=============================================================================
function H = hessianOrBFGS(state, H, s, y)
  if ~isempty(state.hessian), H = hessianMatrix(state, length(s)); return; end
  if s' * y > 1e-12 * max(1, norm(s) * norm(y))
    Hs = H * s; H = H - (Hs * Hs') / max(s' * Hs, eps) + (y * y') / max(s' * y, eps);
  end
  H = (H + H') / 2;
end
%=============================================================================
function radius = updateRadius(radius, step, ratio)
  if ratio < 0.25, radius = radius / 4;
  elseif ratio > 0.75 && norm(step) > 0.8 * radius, radius = min(2 * radius, 1e4);
  end
end
%=============================================================================
function result = finish(data, opts, x, state, H, exitflag, iter, funcCount, message, stepSize)
  msg = optimFminuncExitMessage(exitflag, message);
  output = optimFminuncOutput(iter, funcCount, state, data.algorithm, msg, stepSize);
  optimFminuncDisplay(opts, 'final', [], output.message);
  optimOutputStop(opts.OutputFcn, x, optimFminuncValues(state, iter, funcCount, stepSize), 'done');
  result.x = x; result.fval = state.f; result.exitflag = exitflag;
  result.output = output; result.grad = state.grad; result.hessian = H;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function values = optimFminuncValues(state, iter, funcCount, stepSize)
  values = struct();
  values.fval = state.f;
  values.iteration = iter;
  values.funccount = funcCount;
  values.stepsize = stepSize;
  values.firstorderopt = norm(state.grad, Inf);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function result = optimFsolveDogleg(fun, x0, opts, ctx)
  % Powell dogleg trust-region engine for square nonlinear systems (fsolve).
  x = double(x0(:));
  [funcCount, initialResidual] = initialEvaluation(ctx);
  [J, r, added] = optimFiniteDiffJacobian(fun, x, opts, initialResidual);
  funcCount = funcCount + added;
  resnorm = r' * r;
  g = J' * r;
  radius = max(1, norm(x));
  iterations = 0;
  stepNorm = 0;
  stop = struct('kind', 'maxiter', 'value', ctx.maxIter, 'tolerance', ctx.maxIter);
  optimLsqDisplay(opts, 'header', 'dogleg', []);
  values = iterValues(0, funcCount, resnorm, norm(g, Inf), radius, 0);
  optimLsqDisplay(opts, 'iter', 'dogleg', values);
  if optimOutputStop(opts.OutputFcn, x, values, 'init')
    stop = struct('kind', 'outputfcn', 'value', 0, 'tolerance', 0);
    result = makeResult(x, r, resnorm, J, stop, iterations, funcCount, stepNorm, norm(g, Inf));
    optimOutputStop(opts.OutputFcn, x, values, 'done');
    return
  end
  for iter = 1:ctx.maxIter
    if resnorm <= opts.FunctionTolerance
      stop = struct('kind', 'optimality', 'value', resnorm, ...
        'tolerance', opts.FunctionTolerance);
      break
    end
    % Stationary point of the squared residual that is not a root: the
    % gradient vanishes while the residual stays large.
    if norm(g, Inf) <= max(opts.OptimalityTolerance, sqrt(eps)) * max(1, norm(r))
      stop = struct('kind', 'stationary', 'value', norm(g, Inf), ...
        'tolerance', opts.OptimalityTolerance);
      break
    end
    newtonStep = safeSolve(J, -r);
    if norm(newtonStep) <= opts.StepTolerance * (sqrt(eps) + norm(x))
      stop = struct('kind', 'direction', 'value', norm(newtonStep), ...
        'tolerance', opts.StepTolerance);
      break
    end
    step = doglegStep(newtonStep, g, J, radius);
    trial = x + step;
    trialResidual = evaluateResidual(fun, trial);
    funcCount = funcCount + 1;
    trialResnorm = trialResidual' * trialResidual;
    predicted = resnorm - predictedResnorm(r, J, step);
    actual = resnorm - trialResnorm;
    if ~isfinite(trialResnorm)
      ratio = -1;
    else
      ratio = actual / max(predicted, eps);
    end
    if ratio > 1e-4
      stepNorm = norm(step);
      previousResnorm = resnorm;
      x = trial;
      [J, r, added] = optimFiniteDiffJacobian(fun, x, opts, trialResidual);
      funcCount = funcCount + added;
      resnorm = r' * r;
      g = J' * r;
      iterations = iterations + 1;
      values = iterValues(iterations, funcCount, resnorm, norm(g, Inf), radius, stepNorm);
      optimLsqDisplay(opts, 'iter', 'dogleg', values);
      if optimOutputStop(opts.OutputFcn, x, values, 'iter')
        stop = struct('kind', 'outputfcn', 'value', 0, 'tolerance', 0);
        break
      end
      if stepNorm <= opts.StepTolerance * (sqrt(eps) + norm(x))
        stop = struct('kind', 'step', 'value', stepNorm, ...
          'tolerance', opts.StepTolerance);
        break
      end
      if abs(previousResnorm - resnorm) <= opts.FunctionTolerance * max(resnorm, eps)
        stop = struct('kind', 'funchange', ...
          'value', abs(previousResnorm - resnorm) / max(resnorm, eps), ...
          'tolerance', opts.FunctionTolerance);
        break
      end
    end
    if ratio < 0.25
      radius = 0.25 * norm(step);
    elseif ratio > 0.75 && norm(step) >= 0.9 * radius
      radius = min(2 * radius, 1e16);
    end
    if radius <= eps * (1 + norm(x))
      stop = struct('kind', 'regularization', 'value', radius, ...
        'tolerance', eps * (1 + norm(x)));
      break
    end
    if funcCount >= ctx.maxFunEvals
      stop = struct('kind', 'maxfeval', 'value', funcCount, ...
        'tolerance', ctx.maxFunEvals);
      break
    end
  end
  if strcmp(stop.kind, 'maxiter') && resnorm <= opts.FunctionTolerance
    stop = struct('kind', 'optimality', 'value', resnorm, ...
      'tolerance', opts.FunctionTolerance);
  end
  result = makeResult(x, r, resnorm, J, stop, iterations, funcCount, stepNorm, norm(g, Inf));
  optimOutputStop(opts.OutputFcn, x, ...
    iterValues(iterations, funcCount, resnorm, norm(g, Inf), radius, stepNorm), 'done');
end
%=============================================================================
function [funcCount, initialResidual] = initialEvaluation(ctx)
  funcCount = 0;
  initialResidual = [];
  if isfield(ctx, 'initialResidual') && ~isempty(ctx.initialResidual)
    initialResidual = ctx.initialResidual;
    funcCount = 1;
  end
end
%=============================================================================
function step = doglegStep(newtonStep, g, J, radius)
  if norm(newtonStep) <= radius
    step = newtonStep;
    return
  end
  Jg = J * g;
  cauchyScale = (g' * g) / max(Jg' * Jg, eps);
  cauchyStep = -cauchyScale * g;
  normCauchy = norm(cauchyStep);
  if normCauchy >= radius
    step = -(radius / max(norm(g), eps)) * g;
    return
  end
  % Walk from the Cauchy point towards the Newton point until the radius.
  difference = newtonStep - cauchyStep;
  a = difference' * difference;
  b = 2 * (cauchyStep' * difference);
  c = (cauchyStep' * cauchyStep) - radius ^ 2;
  discriminant = max(b ^ 2 - 4 * a * c, 0);
  tau = (-b + sqrt(discriminant)) / max(2 * a, eps);
  tau = min(max(tau, 0), 1);
  step = cauchyStep + tau * difference;
end
%=============================================================================
function value = predictedResnorm(r, J, step)
  predicted = r + J * step;
  value = predicted' * predicted;
end
%=============================================================================
function residual = evaluateResidual(fun, x)
  residual = double(optimCall(fun, x));
  residual = residual(:);
end
%=============================================================================
function step = safeSolve(A, b)
  useDirect = false;
  if size(A, 1) == size(A, 2)
    useDirect = rcond(A) > eps;
  end
  if useDirect
    step = A \ b;
    if all(isfinite(step))
      return
    end
  end
  step = pinv(A) * b;
end
%=============================================================================
function values = iterValues(iteration, funcCount, resnorm, firstorderopt, radius, stepSize)
  values = struct();
  values.iteration = iteration;
  values.funccount = funcCount;
  values.fval = resnorm;
  values.resnorm = resnorm;
  values.firstorderopt = firstorderopt;
  values.radius = radius;
  values.stepsize = stepSize;
end
%=============================================================================
function result = makeResult(x, residual, resnorm, J, stop, iterations, funcCount, stepNorm, firstorderopt)
  result.x = x;
  result.residual = residual;
  result.resnorm = resnorm;
  result.J = J;
  result.stop = stop;
  result.iterations = iterations;
  result.funcCount = funcCount;
  result.stepsize = stepNorm;
  result.firstorderopt = firstorderopt;
  result.damping = [];
  result.cgiterations = [];
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function optimLsqDisplay(opts, phase, style, values)
  % Iteration and final display for the least-squares solvers
  % (lsqnonlin, fsolve). style: 'trr', 'lm' or 'dogleg'.
  if isNoDisplay(opts)
    return
  end
  switch phase
    case 'header'
      if ~isIterDisplay(opts)
        return
      end
      disp(' ');
      switch style
        case 'lm'
          disp('                                        First-order                     Norm of ');
          disp(' Iteration  Func-count      Resnorm      optimality       Lambda           step');
        case 'dogleg'
          disp('                                         Norm of      First-order   Trust-region');
          disp(' Iteration  Func-count     ||f(x)||^2        step       optimality       radius');
        otherwise
          disp('                                            Norm of      First-order ');
          disp(' Iteration  Func-count      Resnorm            step       optimality');
      end
    case 'iter'
      if ~isIterDisplay(opts)
        return
      end
      disp(iterLine(style, values));
    case 'final'
      show = isFinalDisplay(opts) || isIterDisplay(opts) || ...
        (isNotifyDisplay(opts) && values.exitflag <= 0);
      if ~show
        return
      end
      if isIterDisplay(opts)
        disp(' ');
      end
      if isDetailedDisplay(opts)
        disp(values.messageDetailed);
      else
        disp(values.message);
      end
  end
end
%=============================================================================
function line = iterLine(style, values)
  switch style
    case 'lm'
      line = sprintf('%6d %11d %16.6g %15.6g %12.6g', values.iteration, ...
        values.funccount, values.resnorm, values.firstorderopt, values.lambda);
      if values.iteration > 0
        line = [line, sprintf(' %14.6g', values.stepsize)];
      end
    case 'dogleg'
      line = sprintf('%6d %11d %15.6g', values.iteration, values.funccount, ...
        values.resnorm);
      if values.iteration > 0
        line = [line, sprintf(' %11.6g', values.stepsize)];
      else
        line = [line, repmat(' ', 1, 12)];
      end
      line = [line, sprintf(' %16.6g %12.6g', values.firstorderopt, values.radius)];
    otherwise
      line = sprintf('%6d %11d %17.6g', values.iteration, values.funccount, ...
        values.resnorm);
      if values.iteration > 0
        line = [line, sprintf(' %15.6g', values.stepsize)];
      else
        line = [line, repmat(' ', 1, 16)];
      end
      line = [line, sprintf(' %16.6g', values.firstorderopt)];
  end
end
%=============================================================================
function tf = isIterDisplay(opts)
  tf = strcmpi(opts.Display, 'iter') || strcmpi(opts.Display, 'iter-detailed');
end
%=============================================================================
function tf = isFinalDisplay(opts)
  tf = strcmpi(opts.Display, 'final') || strcmpi(opts.Display, 'final-detailed');
end
%=============================================================================
function tf = isNotifyDisplay(opts)
  tf = strcmpi(opts.Display, 'notify') || strcmpi(opts.Display, 'notify-detailed');
end
%=============================================================================
function tf = isNoDisplay(opts)
  tf = strcmpi(opts.Display, 'off') || strcmpi(opts.Display, 'none');
end
%=============================================================================
function tf = isDetailedDisplay(opts)
  display = lower(opts.Display);
  tf = length(display) > 9 && strcmp(display(end - 8:end), '-detailed');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [message, messageDetailed] = optimLsqExitMessage(solverName, kind, info, opts)
  % Builds the reference-compatible exit messages of the least-squares
  % solvers. kind identifies the stopping reason, info carries the measured
  % value and the tolerance it was compared against.
  if strcmp(solverName, 'fsolve')
    [message, detail] = fsolveMessage(kind, info, opts);
  else
    [message, detail] = lsqnonlinMessage(solverName, kind, info, opts);
  end
  if isempty(detail)
    messageDetailed = message;
  else
    messageDetailed = sprintf('%s\n\n<stopping criteria details>\n\n%s', message, detail);
  end
end
%=============================================================================
function [message, detail] = lsqnonlinMessage(solverName, kind, info, opts)
  detail = '';
  switch kind
    case 'optimality'
      message = sprintf(_('Local minimum found.\n\nOptimization completed because the size of the gradient is less than\nthe value of the optimality tolerance.'));
      detail = sprintf(_('Optimization completed: The first-order optimality measure, %e,\nis less than options.OptimalityTolerance = %e.'), info.value, info.tolerance);
    case 'optimality-relative'
      message = sprintf(_('Local minimum found.\n\nOptimization completed because the size of the gradient is less than\n1e-4 times the value of the function tolerance.'));
      detail = sprintf(_('Optimization completed: The relative first-order optimality measure, %e,\nis less than 1e-4*options.FunctionTolerance = %e.'), info.value, info.tolerance);
    case 'step'
      message = sprintf(_('Local minimum possible.\n\n%s stopped because the size of the current step is less than\nthe value of the step size tolerance.'), solverName);
      detail = sprintf(_('Optimization stopped because the norm of the current step, %e,\nis less than options.StepTolerance = %e.'), info.value, info.tolerance);
    case 'funchange'
      message = sprintf(_('Local minimum possible.\n\n%s stopped because the final change in the sum of squares relative to\nits initial value is less than the value of the function tolerance.'), solverName);
      detail = sprintf(_('Optimization stopped because the relative sum of squares (r) is changing\nby less than options.FunctionTolerance = %e.'), info.tolerance);
    case 'direction'
      message = sprintf(_('Local minimum possible.\n\n%s stopped because the magnitude of the search direction is less than\nthe value of the step size tolerance.'), solverName);
      detail = sprintf(_('Optimization stopped because the norm of the search direction, %e,\nis less than options.StepTolerance = %e.'), info.value, info.tolerance);
    case 'maxiter'
      message = sprintf(_('Solver stopped prematurely.\n\n%s stopped because it exceeded the iteration limit,\noptions.MaxIterations = %e.'), solverName, info.tolerance);
    case 'maxfeval'
      message = sprintf(_('Solver stopped prematurely.\n\n%s stopped because it exceeded the function evaluation limit,\noptions.MaxFunctionEvaluations = %e.'), solverName, info.tolerance);
    case 'outputfcn'
      message = sprintf(_('Solver stopped by an output function or plot function.'));
    case 'infeasible'
      message = sprintf(_('Exiting due to infeasibility: at least one lower bound exceeds the corresponding upper bound.'));
    case 'regularization'
      message = sprintf(_('No further progress possible.\n\n%s stopped because the regularization parameter of the Levenberg-Marquardt\nalgorithm became too large.'), solverName);
    otherwise
      message = sprintf(_('Solver stopped prematurely.'));
  end
end
%=============================================================================
function [message, detail] = fsolveMessage(kind, info, opts)
  detail = '';
  solverName = 'fsolve';
  switch kind
    case 'optimality'
      message = sprintf(_('Equation solved.\n\n%s completed because the vector of function values is near zero\nas measured by the value of the function tolerance, and\nthe problem appears regular as measured by the gradient.'), solverName);
      detail = sprintf(_('Equation solved: The sum of squared function values, r = %e,\nis less than options.FunctionTolerance = %e.'), info.value, info.tolerance);
    case 'step'
      message = sprintf(_('Equation solved, inaccuracy possible.\n\n%s stopped because the size of the current step is less than the value of\nthe step size tolerance and the vector of function values is near zero\nas measured by the value of the function tolerance.'), solverName);
      detail = sprintf(_('Optimization stopped because the norm of the current step, %e,\nis less than options.StepTolerance = %e.'), info.value, info.tolerance);
    case 'funchange'
      message = sprintf(_('Equation solved, inaccuracy possible.\n\n%s stopped because the change in the sum of squared function values is less\nthan the value of the function tolerance and the vector of function values\nis near zero as measured by the value of the function tolerance.'), solverName);
      detail = sprintf(_('Optimization stopped because the relative sum of squares (r) is changing\nby less than options.FunctionTolerance = %e.'), info.tolerance);
    case 'direction'
      message = sprintf(_('Equation solved, inaccuracy possible.\n\n%s stopped because the magnitude of the search direction is less than the\nvalue of the step size tolerance and the vector of function values is near\nzero as measured by the value of the function tolerance.'), solverName);
      detail = sprintf(_('Optimization stopped because the norm of the search direction, %e,\nis less than options.StepTolerance = %e.'), info.value, info.tolerance);
    case 'notsolved'
      message = sprintf(_('No solution found.\n\n%s stopped because the last step was ineffective and the vector of function\nvalues is not near zero as measured by the value of the function tolerance.'), solverName);
    case 'regularization'
      message = sprintf(_('No solution found.\n\n%s stopped because the trust region radius or the regularization parameter\nbecame too small, and the vector of function values is not near zero\nas measured by the value of the function tolerance.'), solverName);
    case 'maxiter'
      message = sprintf(_('Solver stopped prematurely.\n\n%s stopped because it exceeded the iteration limit,\noptions.MaxIterations = %e.'), solverName, info.tolerance);
    case 'maxfeval'
      message = sprintf(_('Solver stopped prematurely.\n\n%s stopped because it exceeded the function evaluation limit,\noptions.MaxFunctionEvaluations = %e.'), solverName, info.tolerance);
    case 'outputfcn'
      message = sprintf(_('Solver stopped by an output function or plot function.'));
    otherwise
      message = sprintf(_('Solver stopped prematurely.'));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
