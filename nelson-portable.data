asserts.isequal(nargin('fft'), 3);
asserts.isequal(nargout('fft'), 1);
%=============================================================================
x = [1 2 1];
y = fft(x);
REF = [4.0000 + 0.0000i, -0.5000 - 0.8660i, -0.5000 + 0.8660i];
asserts.isapprox(y, REF, 1e-4);
%=============================================================================
N = 640;
n = 4;
t = 2 * pi * (0:1:N - 1) * inv(N);
s = cos(n * t);
S = fft(cos(n * t));
REF = zeros(size(t, 1), size(t, 2));
REF(n + 1) = N * inv(2);
REF(N - n + 1) = N * inv(2);
asserts.isapprox(real(S), real(REF), 4 * N * eps());
%=============================================================================
n = [0:29];
x = cos(2 * pi * n * inv(10));
N1 = 8;
X = fft(x, N1);
REF = [-1.1180 + 0.0000i, 3.0882 - 2.3972i, 0.6910 - 0.4271i, 0.5298 - 0.1611i, 0.5000 + 0.0000i, 0.5298 + 0.1611i, 0.6910 + 0.4271i, 3.0882 + 2.3972i];
asserts.isapprox(X, REF, 1e-4)
%=============================================================================
X = fft(eye(2), [], 1);
REF = [1, 1; 1, -1];
asserts.isequal(X, REF);
%=============================================================================
X = fft(eye(2), 2, 1);
REF = [1, 1; 1, -1];
asserts.isequal(X, REF);
%=============================================================================
X = fft(eye(2, 3), [], 1);
REF = [1, 1, 0; 1, -1, 0];
asserts.isequal(X, REF);
%=============================================================================
X = fft(eye(2), [], 2);
REF = [1, 1; 1, -1];
asserts.isapprox(X, REF, 1e-5);
%=============================================================================
X = fft(3);
asserts.isequal(X, 3);
%=============================================================================
fft(3, [], 1)
asserts.isequal(X, 3);
%=============================================================================
fft(3, [], 3)
asserts.isequal(X, 3);
%=============================================================================
asserts.isequal(fft([]), []);
%=============================================================================
Y = fft(ones(3, 3), 3, 1);
REF = [3 3 3; 0 0 0; 0 0 0];
asserts.isequal(Y, REF);
%=============================================================================
Y = fft(ones(3, 2), 3, 1);
REF = [3, 3; 0, 0; 0, 0];
asserts.isequal(Y, REF);
%=============================================================================
asserts.isequal(fft([1 0 0 0]), [1 1 1 1]);
asserts.isequal(size(fft(zeros(0, 3))), [0 3]);
