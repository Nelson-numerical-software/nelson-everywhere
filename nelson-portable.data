asserts.isequal(nargin('abcdchk'), -1);
asserts.isequal(nargout('abcdchk'), -1);
%=============================================================================
[msg, A] = abcdchk(ones(3, 3));
A_REF = ones(3, 3);
MSG_REF.message = '';
MSG_REF.identifier = '';
MSG_REF = MSG_REF(zeros(0, 1));
asserts.isequal(A, A_REF);
asserts.isequal(msg, MSG_REF);
