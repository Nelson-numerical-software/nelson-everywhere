%=============================================================================
function pair = signalTakePair(values, section)
  first = 2 * section - 1;
  last = min(2 * section, length(values));
  if first > length(values)
    pair = [];
  else
    pair = values(first:last);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
