function option = getOption(param)
  supported_options = {'all', 'all_tests', 'unitary_tests', 'nonreg_tests', 'benchs'};
  option = [];
  if ischar(param)
    if strcmp(param, 'minimal_tests')
      option = 'unitary_tests';
    else
      found_option = any(contains(supported_options, param));
      if found_option
        option = param;
      end
    end
  end
end
