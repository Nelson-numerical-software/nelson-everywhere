%=============================================================================
function tf = isequal(obj, varargin)
  tf = true;
  for k = 1:length(varargin)
    if ~isa(varargin{k}, 'eventtable')
      tf = false;
      return
    end
    if ~localIsequalEventtable(obj, varargin{k})
      tf = false;
      return
    end
  end
end
%=============================================================================
function tf = localIsequalEventtable(left, right)
  leftStruct = struct(left);
  rightStruct = struct(right);
  leftNames = leftStruct.Properties.VariableNames;
  rightNames = rightStruct.Properties.VariableNames;
  if ~isequalto(leftNames, rightNames)
    tf = false;
    return
  end
  if ~isequalto(leftStruct.Properties, rightStruct.Properties)
    tf = false;
    return
  end
  for k = 1:length(leftNames)
    name = leftNames{k};
    if ~isequalto(leftStruct.data.(name), rightStruct.data.(name))
      tf = false;
      return
    end
  end
  tf = true;
end
