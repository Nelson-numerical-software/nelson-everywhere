  pc = '';
  if withMPI
    pc = ['mpiexec -n 2 '];
  end
end
﻿%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function test_suite = process_files_to_test(...
    test_files_list, classname, module_name, nbWorkers, runtimeOptions, stoponfail)
  test_suite = create_test_suite();
  test_suite.name = module_name;
  nbTests = length(test_files_list);
  if nbTests == 0
    fprintf(stdout, ['  ', _('No tests available.'), newline]);
  end
  display_preparation_message('prepare', nbTests, nbWorkers);
  preparationBegin = time();
  %#ok<NLS0004>
  [parallel_tests, sequential_tests, benchmark_tests] = partition_test_files(...
    test_files_list, classname, runtimeOptions, _('Preparing tests')); %#ok<NLS0004>
  tests_manager_trace('run', ['partition files=', int2str(nbTests), ...
    ' parallel=', int2str(length(parallel_tests)), ...
    ' sequential=', int2str(length(sequential_tests)), ...
    ' bench=', int2str(length(benchmark_tests)), ...
    ' elapsed=', sprintf('%.3fs', time() - preparationBegin)]);
  executionBegin = time();
  test_cases = process_partitioned_test_cases(...
    parallel_tests, sequential_tests, benchmark_tests, ...
    nbWorkers, runtimeOptions, stoponfail); %#ok<NLS0004>
  executionTime = time() - executionBegin;
  tests_manager_trace('run', ['execution elapsed=', sprintf('%.3fs', executionTime)]);
  test_suite = fill_test_suite_from_cases(test_suite, test_cases, executionTime);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function testCases = process_partitioned_test_cases(...
    parallelTests, sequentialTests, benchmarkTests, ...
    nbWorkers, runtimeOptions, stoponfail)
  total = length(parallelTests) + length(sequentialTests) + length(benchmarkTests);
  [parallelTests, parallelBugTests] = split_bug_test_cases(parallelTests);
  [sequentialTests, sequentialBugTests] = split_bug_test_cases(sequentialTests);
  % Announce the whole run once, before any batch executes. The tests are
  % executed in successive parallel/sequential/benchmark batches; printing this
  % banner per batch would make it appear in the middle of the results (after
  % the first batch already completed), which reads as a desynchronized display.
  display_preparation_message('run', total, nbWorkers);
  phaseBegin = time();
  parallel = process_test_cases(...
    parallelTests, nbWorkers, total, 1, stoponfail, runtimeOptions);
  tests_manager_trace('run', ['parallel elapsed=', ...
    sprintf('%.3fs', time() - phaseBegin)]);
  sequential = [];
  parallelBugs = [];
  sequentialBugs = [];
  benchmark = [];
  if ~(stoponfail && has_failed_cases(parallel))
    phaseBegin = time();
    sequential = process_test_cases(...
      sequentialTests, 1, total, length(parallel) + 1, stoponfail, runtimeOptions);
    tests_manager_trace('run', ['sequential elapsed=', ...
      sprintf('%.3fs', time() - phaseBegin)]);
  end
  if ~(stoponfail && has_failed_cases([parallel; sequential]))
    phaseBegin = time();
    parallelBugs = process_test_cases(...
      parallelBugTests, nbWorkers, total, length(parallel) + length(sequential) + 1, ...
      stoponfail, runtimeOptions);
    tests_manager_trace('run', ['parallel bugs elapsed=', ...
      sprintf('%.3fs', time() - phaseBegin)]);
  end
  if ~(stoponfail && has_failed_cases([parallel; sequential; parallelBugs]))
    phaseBegin = time();
    sequentialBugs = process_test_cases(...
      sequentialBugTests, 1, total, length(parallel) + length(sequential) ...
      + length(parallelBugs) + 1, stoponfail, runtimeOptions);
    tests_manager_trace('run', ['sequential bugs elapsed=', ...
      sprintf('%.3fs', time() - phaseBegin)]);
  end
  if ~(stoponfail && has_failed_cases([parallel; sequential; parallelBugs; sequentialBugs]))
    phaseBegin = time();
    benchmark = process_test_cases(benchmarkTests, ...
      benchmark_worker_count(nbWorkers), total, ...
      length(parallel) + length(sequential) + length(parallelBugs) ...
      + length(sequentialBugs) + 1, stoponfail, runtimeOptions);
    tests_manager_trace('run', ['bench elapsed=', ...
      sprintf('%.3fs', time() - phaseBegin)]);
  end
  phaseBegin = time();
  [parallel, sequential] = align_test_case_fields(parallel, sequential);
  [parallel, parallelBugs] = align_test_case_fields(parallel, parallelBugs);
  [parallel, sequentialBugs] = align_test_case_fields(parallel, sequentialBugs);
  [parallel, benchmark] = align_test_case_fields(parallel, benchmark);
  [sequential, parallelBugs] = align_test_case_fields(sequential, parallelBugs);
  [sequential, sequentialBugs] = align_test_case_fields(sequential, sequentialBugs);
  [sequential, benchmark] = align_test_case_fields(sequential, benchmark);
  [parallelBugs, sequentialBugs] = align_test_case_fields(parallelBugs, sequentialBugs);
  [parallelBugs, benchmark] = align_test_case_fields(parallelBugs, benchmark);
  [sequentialBugs, benchmark] = align_test_case_fields(sequentialBugs, benchmark);
  testCases = sort_test_cases_by_order([parallel; sequential; parallelBugs; ...
    sequentialBugs; benchmark]);
  tests_manager_trace('run', ['merge elapsed=', sprintf('%.3fs', time() - phaseBegin)]);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function test_cases_updated = process_test_cases(...
    test_cases, nbWorkers, nbTotalTests, initialIndex, stoponfail, runtimeOptions)
  if isempty(test_cases)
    test_cases_updated = [];
    return
  end
  annotatedCases = annotate_worker_pool_eligibility(test_cases);
  if use_inline_unittest_runner()
    abortedCode = launcher_aborted_code();
    fmtStart = test_start_format(nbTotalTests);
    test_cases_updated = process_test_cases_batched(...
      annotatedCases, 1, abortedCode, initialIndex, nbTotalTests, fmtStart, stoponfail);
    return
  end
  test_cases_updated = process_test_cases_progressive(...
    annotatedCases, nbWorkers, initialIndex, nbTotalTests, stoponfail);
end
%=============================================================================
﻿%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function test_cases_updated = process_test_cases_batched(...
    test_cases, nbWorkers, abortedCode, indexTest, nbTotalTests, fmtStart, stoponfail)
  accumulator = [];
  test_cases_updated = [];
  nbTests = length(test_cases);
  for testIndex = 1:length(test_cases)
    accumulator = [accumulator; test_cases(testIndex)];
    if length(accumulator) == nbWorkers || testIndex == nbTests
      accumulator = run_test_batch(accumulator, abortedCode, nbWorkers);
      displayArgs = {test_cases_updated, accumulator, indexTest, nbTotalTests, fmtStart};
      [test_cases_updated, indexTest] = display_test_batch(displayArgs{:}); %#ok<NLS0004>
      if stoponfail && has_failed_cases(accumulator)
        break
      end
      accumulator = [];
    end
  end
  test_cases_updated = remove_test_case_runtime_fields(test_cases_updated);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function test_suite = process_test_cases_directory(...
    tests_dir, option, classname, module_name, nbWorkers, runtimeOptions, stoponfail)
  if isdir(tests_dir)
    test_files_list = test_run_get_files_list_by_option(tests_dir, option);
    test_suite = process_files_to_test(...
      test_files_list, classname, module_name, nbWorkers, runtimeOptions, stoponfail);
  else
    fprintf(stdout, ['  ', _('No directory tests available.'), newline]);
    test_suite = create_test_suite();
  end
end
