function out = eraseBetween(str, start, stop, varargin)
  narginchk(3, 5);
  nargoutchk(0, 1);
  replacement = '';
  out = replaceBetween(str, start, stop, replacement, varargin{:});
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
