%=============================================================================
function [fig, previousDrawLater] = polarBeginDrawLater(ax)
  fig = [];
  previousDrawLater = '';
  try
    fig = ancestor(ax, 'figure');
  catch
    fig = [];
  end
  if ~isempty(fig) && isgraphics(fig, 'figure')
    previousDrawLater = fig.DrawLater;
    if strcmp(previousDrawLater, 'off')
      fig.DrawLater = 'on';
    end
  end
end
