% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
options = ddeset('RelTol', 1e-5, 'AbsTol', 1e-7);
asserts.istrue(isstruct(options));
asserts.isequal(options.RelTol, 1e-5);
asserts.isequal(options.AbsTol, 1e-7);
asserts.checkerror('ddeset(''RelTol'')', _('Name-value arguments expected.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
residual = @(t, y, yp) yp + y;
[y0, yp0, resnrm] = decic(residual, 0, 1, 1, 0, 0);
asserts.isequal(y0, 1);
asserts.istrue(abs(yp0 + 1) < 1e-8);
asserts.istrue(resnrm < 1e-8);
[t, y] = ode15i(residual, [0 0.5], y0, yp0);
asserts.istrue(abs(y(length(y)) - exp(-0.5)) < 1e-3);
[tfull, yfull] = ode15i(residual, [0 1], y0, yp0);
asserts.istrue(abs(tfull(2) - 0.025) < 0.01);
asserts.istrue(abs(tfull(3) - 0.05) < 0.015);
asserts.istrue(abs(tfull(4) - 0.10) < 0.02);
asserts.istrue(abs(yfull(length(yfull)) - exp(-1)) < 1e-3);

residual2 = @(t, y, yp)[yp(1) + y(1); y(2) - 2];
[yc, ypc] = decic(residual2, 0, [1; 0], [1; 0], [0; 0], [0; 1]);
asserts.istrue(norm(residual2(0, yc, ypc), inf) < 1e-8);
asserts.isequal(yc(1), 1);
asserts.isequal(ypc(2), 0);

asserts.checkerror('decic(@(t,y,yp) yp + y, 0, 1, 1, 0, 1)', ...
  _('At least one initial component must be free.'));
asserts.checkerror('decic(1, 0, 1, 1, 0, 0)', sprintf(_('%s must be a function handle.'), 'Value'));
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
sol = ode45(@(t, y) - y, [0 1], 1, odeset('MaxStep', 0.1));
[y, yp] = deval(sol, 0.25);
asserts.istrue(abs(y - exp(-0.25)) < 5e-3);
asserts.istrue(abs(yp + y) < 5e-2);
asserts.checkerror('deval(sol, 2)', _('Evaluation points must lie inside the solution interval.'));
%=============================================================================
% swapped argument order deval(x, sol)
ySwapped = deval(0.25, sol);
asserts.istrue(abs(ySwapped - y) < 1e-12);
%=============================================================================
% component selection deval(sol, x, idx)
systemSol = ode45(@(t, y)[y(2); -y(1)], [0 10], [1; 0]);
full = deval(systemSol, 1.5);
second = deval(systemSol, 1.5, 2);
asserts.istrue(abs(second - full(2)) < 1e-12);
firstSwapped = deval(1.5, systemSol, 1);
asserts.istrue(abs(firstSwapped - full(1)) < 1e-12);
asserts.checkerror('deval(systemSol, 1.5, 3)', sprintf(_('%s indices are invalid.'), 'Component'));
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
problem = ode('ODEFcn', @(t, y) - y, 'InitialValue', 1, 'Solver', 'ode45');
asserts.isequal(problem.SelectedSolver, 'ode45');
result = solve(problem, 0, 1);
asserts.istrue(isa(result, 'nelson.ode.ODEResults'));
asserts.istrue(abs(result.Solution(1, size(result.Solution, 2)) - exp(-1)) < 5e-4);
asserts.istrue(abs(deval(result, 0.5) - exp(-0.5)) < 5e-3);
asserts.checkerror('ode(''InitialTime'', [0 1])', sprintf(_('%s must be a finite scalar.'), 'InitialTime'));
