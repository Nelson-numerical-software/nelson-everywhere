%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('pca'), -2);
asserts.isequal(nargout('pca'), 6);
%=============================================================================
X = [1 2; 3 4; 5 8; 7 11];
[coeff, score, latent, tsquared, explained, mu] = pca(X);
asserts.isapprox(coeff, [0.538200080736440 0.842817105364675; ...
  0.842817105364675 -0.538200080736440], 1e-12);
asserts.isapprox(score, [-5.196572940009188 -0.241100972964155; ...
  -2.434538567806959 0.368133076292315; 2.013130015124621 -0.099033035924095; ...
  5.617981492691527 -0.027999067404065], 1e-12);
asserts.isapprox(latent, [22.848585622998481; 0.068081043668182], 1e-12);
asserts.isapprox(tsquared, [2.035714285714277; 2.25; 0.321428571428572; ...
  1.392857142857145], 1e-12);
asserts.isapprox(explained, [99.702919082175200; 0.297080917824795], 1e-12);
asserts.isequal(mu, [4 6.25]);
%=============================================================================
[coeff, score, latent, tsquared, explained, mu] = pca(X, 'NumComponents', 1);
asserts.isapprox(coeff, [0.538200080736440; 0.842817105364675], 1e-12);
asserts.isequal(size(score), [4 1]);
asserts.isapprox(score, [-5.196572940009188; -2.434538567806959; ...
  2.013130015124621; 5.617981492691527], 1e-12);
asserts.isapprox(latent, 22.848585622998481, 1e-12);
asserts.isequal(size(tsquared), [4 1]);
asserts.isapprox(tsquared, [1.181883673957228; 0.259402403979601; ...
  0.177371699266863; 1.381342222796309], 1e-12);
asserts.isequal(explained, 100);
asserts.isequal(mu, [4 6.25]);
%=============================================================================
[coeff, score, latent, tsquared, explained, mu] = pca([X; NaN 1]);
asserts.isapprox(coeff, [0.538200080736440 0.842817105364675; ...
  0.842817105364675 -0.538200080736440], 1e-12);
asserts.istrue(all(isnan(score(5, :))));
asserts.istrue(isnan(tsquared(5)));
asserts.isapprox(latent, [22.848585622998481; 0.068081043668182], 1e-12);
asserts.isapprox(explained, [99.702919082175200; 0.297080917824795], 1e-12);
asserts.isequal(mu, [4 6.25]);
%=============================================================================
[coeff, ~, latent] = pca(X, 'Centered', false);
asserts.isapprox(coeff, [0.538851601250530 0.842400707401021; ...
  0.842400707401021 -0.538851601250530], 1e-12);
asserts.isapprox(latent, [72.198925832933696; 0.051074167066319], 1e-12);
%=============================================================================
[coeff, ~, latent, tsquared, explained] = pca([1 2 3; 4 5 6], 'Economy', false);
asserts.isapprox(coeff(:, 1), [1; 1; 1] / sqrt(3), 1e-12);
asserts.isapprox(coeff' * coeff, eye(3), 1e-12);
asserts.isapprox(latent, [13.500000000000004; 0; 0], 1e-12);
asserts.isapprox(tsquared, [0.5; 0.5], 1e-12);
asserts.isapprox(explained, [100; 0; 0], 1e-12);
%=============================================================================
[coeff, ~, latent] = pca(X, 'Weights', [1 2 3 4]);
asserts.isapprox(coeff, [0.526795342179064 0.849992157292315; ...
  0.849992157292315 -0.526795342179064], 1e-12);
asserts.isapprox(latent, [19.101994192959829; 0.044672473706846], 1e-12);
%=============================================================================
[coeff, ~, latent] = pca(X, 'VariableWeights', 'variance');
asserts.isapprox(coeff, [0.842075358320684 0.842075358320684; ...
  0.539359889970594 -0.539359889970594], 1e-12);
asserts.isapprox(latent, [1.992794553591540; 0.007205446408460], 1e-12);
%=============================================================================
asserts.checkerror('pca()', _('Not enough input arguments.'));
asserts.checkerror('pca({1})', sprintf(_('%s must be a real numeric matrix.'), 'X'));
asserts.checkerror('pca([1 2], ''NumComponents'', 3)', _('NumComponents must be an integer scalar between 0 and the number of variables.'));
asserts.checkerror('pca([1 NaN], ''Rows'', ''all'')', _('Raw data contains NaN while Rows is all.'));
asserts.checkerror('pca([1 2], ''Algorithm'', ''als'')', sprintf(_('Unsupported %s.'), 'algorithm'));
asserts.checkerror('pca([1 2], ''Bad'', 1)', _('Unknown option.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--WEIGHT 2-->
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('pcacov'), 1);
asserts.isequal(nargout('pcacov'), 3);
%=============================================================================
V = [4 2; 2 3];
[coeff, latent, explained] = pcacov(V);
asserts.isapprox(coeff, [0.788205438016109 -0.615412209402636; ...
  0.615412209402636 0.788205438016109], 1e-12);
asserts.isapprox(coeff' * coeff, eye(2), 1e-12);
asserts.isapprox(latent, [5.561552812808831; 1.438447187191170], 1e-12);
asserts.isapprox(explained, [79.450754468697568; 20.549245531302425], 1e-12);
asserts.isapprox(sum(explained), 100, 1e-12);
%=============================================================================
[coeff, latent, explained] = pcacov(single(V));
asserts.isequal(class(coeff), 'single');
asserts.isequal(class(latent), 'single');
asserts.isequal(class(explained), 'single');
asserts.isapprox(double(coeff), [0.788205438016109 -0.615412209402636; ...
  0.615412209402636 0.788205438016109], 1e-6);
%=============================================================================
[coeff, latent, explained] = pcacov(zeros(2));
asserts.isequal(coeff, eye(2));
asserts.isequal(latent, [0; 0]);
asserts.isequal(explained, [0; 0]);
%=============================================================================
[coeff, latent, explained] = pcacov([]);
asserts.isequal(size(coeff), [0 0]);
asserts.isequal(size(latent), [0 1]);
asserts.isequal(size(explained), [0 1]);
%=============================================================================
asserts.checkerror('pcacov()', _('Not enough input arguments.'));
asserts.checkerror('pcacov({1})', sprintf(_('%s must be a real numeric matrix.'), 'V'));
asserts.checkerror('pcacov([1 2 3])', sprintf(_('%s must be a square matrix.'), 'V'));
asserts.checkerror('pcacov([1 2; 3 4])', sprintf(_('%s must be symmetric.'), 'V'));
asserts.checkerror('pcacov([1 0; 0 -1])', _('V must be positive semidefinite.'));
asserts.checkerror('pcacov([1 NaN; NaN 1])', sprintf(_('%s must contain finite values.'), 'V'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('pcares'), 2);
asserts.isequal(nargout('pcares'), 2);
%=============================================================================
X = [1 2; 3 4; 5 8; 7 11];
[residuals, reconstructed] = pcares(X, 1);
asserts.isapprox(residuals, [-0.203204024134255 0.129760563114943; ...
  0.310268853749682 -0.198129251382277; -0.083466736673022 0.053299587929923; ...
  -0.023598092942406 0.015069100337410], 1e-12);
asserts.isapprox(reconstructed, [1.203204024134255 1.870239436885057; ...
  2.689731146250318 4.198129251382277; 5.083466736673022 7.946700412070077; ...
  7.023598092942406 10.984930899662590], 1e-12);
asserts.isapprox(X - reconstructed, residuals, 1e-12);
%=============================================================================
[residuals, reconstructed] = pcares(X, 0);
asserts.isequal(reconstructed, [4 6.25; 4 6.25; 4 6.25; 4 6.25]);
asserts.isequal(residuals, [-3 -4.25; -1 -2.25; 1 1.75; 3 4.75]);
%=============================================================================
[residuals, reconstructed] = pcares(X, 2);
asserts.istrue(max(abs(residuals(:))) < 1e-12);
asserts.isapprox(reconstructed, X, 1e-12);
%=============================================================================
[residuals, reconstructed] = pcares(single(X), 1);
asserts.isequal(class(residuals), 'single');
asserts.isequal(class(reconstructed), 'single');
asserts.isapprox(double(residuals), [-0.203204024134255 0.129760563114943; ...
  0.310268853749682 -0.198129251382277; -0.083466736673022 0.053299587929923; ...
  -0.023598092942406 0.015069100337410], 1e-6);
%=============================================================================
asserts.checkerror('pcares()', _('Not enough input arguments.'));
asserts.checkerror('pcares({1}, 1)', sprintf(_('%s must be a real numeric matrix.'), 'X'));
asserts.checkerror('pcares([1 NaN], 1)', _('X must not contain NaN values.'));
asserts.checkerror('pcares([1 2], 3)', _('NumComponents must be an integer scalar between 0 and the number of variables.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('pdist'), 3);
asserts.isequal(nargout('pdist'), 1);
%=============================================================================
X = [0 0; 1 0; 0 2];
D = pdist(X);
asserts.isapprox(D, [1 2 sqrt(5)], 1e-12);
%=============================================================================
asserts.isequal(pdist(X, 'cityblock'), [1 2 3]);
asserts.isequal(pdist(X, 'squaredeuclidean'), [1 4 5]);
asserts.isequal(pdist(X, 'sqeuclidean'), [1 4 5]);
asserts.isequal(pdist(X, 'chebychev'), [1 2 2]);
%=============================================================================
X = [1 0; 0 1; 1 1];
asserts.isapprox(pdist(X, 'cosine'), [1 1 - 1 / sqrt(2) 1 - 1 / sqrt(2)], 1e-12);
asserts.isapprox(pdist(X, 'hamming'), [1 0.5 0.5], 1e-12);
asserts.isapprox(pdist(X, 'jaccard'), [1 0.5 0.5], 1e-12);
%=============================================================================
X = [1 2 3; 2 4 6; 3 2 1];
asserts.isapprox(pdist(X, 'correlation'), [0 2 2], 1e-12);
asserts.isapprox(pdist(X, 'spearman'), [0 2 2], 1e-12);
X = [1 1 2 3; 1 2 2 4; 4 3 3 1];
asserts.isapprox(pdist(X, 'spearman'), [0.166666666666667 1.83333333333333 2], 1e-12);
%=============================================================================
X = [0 0; 1 1; 2 0];
asserts.isapprox(pdist(X, 'minkowski', 1.5), [1.587401051 2 1.587401051], 1e-9);
X = [-2 1; 0 -3; 4 5];
asserts.isapprox(pdist(X, 'minkowski', 3), [4.16016764610381 6.54213262037718 8.32033529220762], 1e-12);
%=============================================================================
X = [0 0; 2 0; 2 4];
asserts.isapprox(pdist(X, 'seuclidean'), [1.73205080756888 2.44948974278318 1.73205080756888], 1e-12);
asserts.isapprox(pdist(X, 'seuclidean', [2 4]), [1 1.41421356237310 1], 1e-12);
asserts.isapprox(pdist(X, 'mahalanobis', eye(2)), [2 sqrt(20) 4], 1e-12);
X = [0 1; 2 4; 3 8];
asserts.isapprox(pdist(X, 'seuclidean'), [1.56333471912302 2.79823441300328 1.31372323031479], 1e-12);
X = [1 2; 3 5; -1 4];
asserts.isapprox(pdist(X, 'mahalanobis', [2 0.4; 0.4 3]), [2.07727429415344 1.99313891631417 2.83084768755526], 1e-12);
%=============================================================================
asserts.isequal(pdist(zeros(1, 3)), zeros(1, 0));
asserts.isequal(pdist(zeros(0, 3)), zeros(1, 0));
asserts.isequal(pdist(zeros(3, 0)), [0 0 0]);
D = pdist(zeros(3, 0), 'hamming');
asserts.istrue(all(isnan(D)));
asserts.isequal(pdist(zeros(3, 0), 'jaccard'), [0 0 0]);
%=============================================================================
X = [NaN 0; 0 0; 1 1];
D = pdist(X, 'euclidean');
asserts.istrue(all(isnan(D(1:2))));
asserts.isapprox(D(3), sqrt(2), 1e-12);
D = pdist(X, 'chebychev');
asserts.istrue(all(isnan(D(1:2))));
asserts.isequal(D(3), 1);
D = pdist(X, 'hamming');
asserts.istrue(all(isnan(D(1:2))));
asserts.isequal(D(3), 1);
D = pdist(X, 'jaccard');
asserts.istrue(all(isnan(D(1:2))));
asserts.isequal(D(3), 1);
%=============================================================================
asserts.checkerror('pdist()', _('Not enough input arguments.'));
asserts.checkerror('pdist(ones(2, 2, 2))', sprintf(_('%s must be a real numeric matrix.'), 'X'));
asserts.checkerror('pdist({1})', sprintf(_('%s must be a real numeric matrix.'), 'X'));
asserts.checkerror('pdist([1], 1)', sprintf(_('%s must be a character vector or string scalar.'), 'Distance'));
asserts.checkerror('pdist([1], ''unknown'')', sprintf(_('Invalid %s value.'), 'Distance'));
asserts.checkerror('pdist([1], ''s'')', sprintf(_('Ambiguous %s value.'), 'Distance'));
asserts.checkerror('pdist([1 2; 3 4], ''minkowski'', 0)', sprintf(_('%s must be positive.'), 'Distance parameter'));
asserts.checkerror('pdist([1 2; 3 4], ''euclidean'', 2)', _('Distance parameter is not supported for this metric.'));
asserts.checkerror('pdist([1 2; 3 4], ''seuclidean'', [1 2 3])', sprintf(_('%s must be a vector.'), 'Distance parameter'));
asserts.checkerror('pdist([1 2; 3 4], ''mahalanobis'', eye(3))', sprintf(_('%s must have compatible size.'), 'Distance parameter'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('pdist2'), -1);
asserts.isequal(nargout('pdist2'), 2);
%=============================================================================
X = [0 0; 1 0];
Y = [0 0; 0 2];
D = pdist2(X, Y);
asserts.isapprox(D, [0 2; 1 sqrt(5)], 1e-12);
[D, I] = pdist2(X, Y, 'euclidean', 'Smallest', 1);
asserts.isapprox(D, [0 2], 1e-12);
asserts.isequal(I, [1 1]);
[D, I] = pdist2(X, Y, 'euclidean', 'Largest', 1);
asserts.isapprox(D, [1 sqrt(5)], 1e-12);
asserts.isequal(I, [2 2]);
%=============================================================================
asserts.isequal(pdist2(X, Y, 'cityblock'), [0 2; 1 3]);
asserts.isequal(pdist2(X, Y, 'chebychev'), [0 2; 1 2]);
asserts.isequal(pdist2(X, Y, 'chebyshev'), [0 2; 1 2]);
asserts.isequal(pdist2(X, Y, 'squaredeuclidean'), [0 4; 1 5]);
asserts.isequal(pdist2(X, Y, 'sqeuclidean'), [0 4; 1 5]);
asserts.isapprox(pdist2(X, Y, 'fasteuclidean'), [0 2; 1 sqrt(5)], 1e-12);
%=============================================================================
asserts.isequal(pdist2([0 0; 2 0], Y, 'cityblock'), [0 2; 2 4]);
%=============================================================================
X = [1 0; 0 1];
Y = [1 0; 1 1];
asserts.isapprox(pdist2(X, Y, 'cosine'), [0 1 - 1 / sqrt(2); 1 1 - 1 / sqrt(2)], 1e-12);
asserts.isapprox(pdist2(X, Y, 'hamming'), [0 0.5; 1 0.5], 1e-12);
asserts.isapprox(pdist2(X, Y, 'jaccard'), [0 0.5; 1 0.5], 1e-12);
%=============================================================================
X = [1 2 3; 1 3 5];
Y = [2 4 6; 3 2 1];
D = pdist2(X, Y, 'correlation');
asserts.isequal(size(D), [2 2]);
asserts.isapprox(D, [0 2; 0 2], 1e-10);
D = pdist2(X, Y, 'spearman');
asserts.isapprox(D, [0 2; 0 2], 1e-10);
%=============================================================================
X = [0 0; 2 0; 0 2];
Y = [1 1; 2 2];
asserts.isapprox(pdist2(X, Y, 'minkowski', 1), [2 4; 2 2; 2 2], 1e-12);
asserts.isapprox(pdist2(X, Y, 'seuclidean', [1 2]), [sqrt(1.25) sqrt(5); sqrt(1.25) 1; sqrt(1.25) 2], 1e-12);
asserts.isapprox(pdist2(X, Y, 'fastseuclidean', [1 2]), [sqrt(1.25) sqrt(5); sqrt(1.25) 1; sqrt(1.25) 2], 1e-12);
asserts.isapprox(pdist2(X, Y, 'mahalanobis', eye(2)), [sqrt(2) sqrt(8); sqrt(2) 2; sqrt(2) 2], 1e-12);
[D, I] = pdist2(X, Y, 'sqeuclidean', 'Smallest', 2);
asserts.isequal(D, [2 4; 2 4]);
asserts.isequal(I, [1 2; 2 3]);
[D, I] = pdist2(X, Y, 'sqeuclidean', 'Largest', 2);
asserts.isequal(D, [2 8; 2 4]);
asserts.isequal(I, [1 1; 2 2]);
%=============================================================================
f = @(row, A) abs(A(:, 1) - row(1)) + abs(A(:, 2) - row(2));
asserts.isequal(pdist2([0 0; 2 0], [1 1; 2 2], f), [2 4; 2 2]);
%=============================================================================
D = pdist2([NaN 0; 0 0], [0 0; 1 1], 'hamming');
asserts.istrue(all(isnan(D(1, :))));
asserts.isapprox(D(2, :), [0 1], 1e-12);
%=============================================================================
asserts.checkerror('pdist2()', _('Not enough input arguments.'));
asserts.checkerror('pdist2([1 2], [1; 2])', sprintf(_('X and Y must have %s.'), 'the same number of columns'));
asserts.checkerror('pdist2({1}, [1])', _('X and Y must be numeric matrices.'));
asserts.checkerror('pdist2([1], [1], 1)', sprintf(_('%s must be a character vector or string scalar.'), 'Distance'));
asserts.checkerror('pdist2([1], [1], ''unknown'')', sprintf(_('Invalid %s value.'), 'Distance'));
asserts.checkerror('pdist2([1], [1], ''s'')', sprintf(_('Ambiguous %s value.'), 'Distance'));
asserts.checkerror('[D, I] = pdist2([1], [1])', _('Smallest or Largest must be specified to return indices.'));
asserts.checkerror('pdist2([1], [1], ''euclidean'', 2)', _('Distance parameter is not supported for this metric.'));
asserts.checkerror('pdist2([1], [1], ''minkowski'', 0)', sprintf(_('%s must be positive.'), 'Distance parameter'));
asserts.checkerror('pdist2([1], [1], ''Smallest'')', _('Name-value arguments must be paired.'));
asserts.checkerror('pdist2([1], [1], ''Smallest'', 1, ''Largest'', 1)', _('Smallest and Largest cannot both be specified.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('poisscdf'), 3);
asserts.isequal(nargout('poisscdf'), 1);
%=============================================================================
x = [0 1 2 5 10];
lambda = [0.5 1 2 4 8];
R = poisscdf(x, lambda);
REF = [0.606530659712633 0.735758882342885 0.676676416183063 ...
       0.785130387030405 0.815885792558547];
asserts.isapprox(R, REF, 1e-12);
%=============================================================================
R = poisscdf(x, lambda, 'upper');
REF = [0.393469340287367 0.264241117657115 0.323323583816937 ...
       0.214869612969595 0.184114207441453];
asserts.isapprox(R, REF, 1e-12);
%=============================================================================
R = poisscdf([1.5 -1 Inf], 2);
asserts.isapprox(R(1:2), [0.406005849709838 0], 1e-12);
asserts.isequal(R(3), 1);
%=============================================================================
R = poisscdf([0 1], 0);
asserts.isequal(R, [1 1]);
%=============================================================================
R = poisscdf(single(x), single(lambda));
asserts.isequal(class(R), 'single');
asserts.isapprox(R, single([0.606530659712633 0.735758882342885 0.676676416183063 ...
                           0.785130387030405 0.815885792558547]), 1e-6);
%=============================================================================
R = poisscdf([NaN 1 1], [2 -1 NaN]);
asserts.istrue(all(isnan(R)));
%=============================================================================
R = poisscdf([], []);
asserts.isequal(size(R), [0 0]);
%=============================================================================
asserts.checkerror('poisscdf(ones(2), ones(3))', _('Size mismatch on input arguments'));
asserts.checkerror('poisscdf(1, 2, ''bad'')', sprintf(_('Invalid %s distribution option.'), 'Poisson'));
asserts.checkerror('poisscdf({1}, 2)', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('poisscdf(1, {2})', _('LAMBDA must be a nonnegative numeric array.'));
%=============================================================================
asserts.isapprox(poisscdf(2, 3), exp(-3) * (1 + 3 + 9 / 2), 1e-12);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--WEIGHT 2-->
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('poissfit'), 2);
asserts.isequal(nargout('poissfit'), 2);
%=============================================================================
x = [0 1 2 3 5 8];
[LAMBDA, LAMBDACI] = poissfit(x);
asserts.isapprox(LAMBDA, 3.166666666666667, 1e-12);
asserts.isapprox(LAMBDACI, [1.906540194061123; 4.945142261931039], 1e-12);
%=============================================================================
[LAMBDA, LAMBDACI] = poissfit(x, 0.01);
asserts.isapprox(LAMBDA, 3.166666666666667, 1e-12);
asserts.isapprox(LAMBDACI, [1.607409296574247; 5.563830152734323], 1e-12);
%=============================================================================
xm = [0 2; 1 3; 2 4; 3 6; 5 8];
[LAMBDAM, LAMBDACIM] = poissfit(xm);
asserts.isequal(size(LAMBDAM), [1 2]);
asserts.isapprox(LAMBDAM, [2.2 4.6], 1e-12);
asserts.isapprox(LAMBDACIM, [1.098232073447368 2.916005407408936;
                            3.936407702660469 6.902258578966752], 1e-12);
%=============================================================================
[LAMBDA, LAMBDACI] = poissfit(single(x));
asserts.isequal(class(LAMBDA), 'double');
asserts.isequal(class(LAMBDACI), 'double');
asserts.isapprox(LAMBDA, 3.166666666666667, 1e-12);
%=============================================================================
[LAMBDA, LAMBDACI] = poissfit([1 NaN 3]);
asserts.istrue(isnan(LAMBDA));
asserts.istrue(all(isnan(LAMBDACI(:))));
[LAMBDA, LAMBDACI] = poissfit([0 0 0]);
asserts.isequal(LAMBDA, 0);
asserts.isequal(LAMBDACI(1), 0);
asserts.istrue(isfinite(LAMBDACI(2)) && LAMBDACI(2) > 0);
%=============================================================================
asserts.checkerror('poissfit()', _('Not enough input arguments.'));
asserts.checkerror('poissfit([])', _('X must be a nonempty vector or matrix.'));
asserts.checkerror('poissfit(ones(1, 1, 2))', _('X must be a nonempty vector or matrix.'));
asserts.checkerror('poissfit({1 2 3})', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('poissfit([-1 1 2])', sprintf(_('%s must contain nonnegative integer finite values.'), 'X'));
asserts.checkerror('poissfit([1.5 2 3])', sprintf(_('%s must contain nonnegative integer finite values.'), 'X'));
asserts.checkerror('poissfit([1 Inf 2])', sprintf(_('%s must contain nonnegative integer finite values.'), 'X'));
asserts.checkerror('poissfit([1 2 3], {0.05})', sprintf(_('%s must be numeric.'), 'ALPHA'));
asserts.checkerror('poissfit([1 2 3], -0.1)', sprintf(_('%s must be a scalar in the range [0,1].'), 'ALPHA'));
asserts.checkerror('poissfit([1 2 3], 1.1)', sprintf(_('%s must be a scalar in the range [0,1].'), 'ALPHA'));
%=============================================================================%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('poissinv'), 2);
asserts.isequal(nargout('poissinv'), 1);
%=============================================================================
y = [0 0.025 0.5 0.975 1];
lambda = [0.5 1 2 4 8];
R = poissinv(y, lambda);
asserts.isequal(R(1:4), [0 0 2 8]);
asserts.istrue(isinf(R(5)) && R(5) > 0);
%=============================================================================
R = poissinv([0.1 0.9 1], 0);
asserts.isequal(R, [0 0 0]);
%=============================================================================
R = poissinv(single(y), single(lambda));
asserts.isequal(class(R), 'single');
asserts.isequal(double(R(1:4)), [0 0 2 8]);
asserts.istrue(isinf(R(5)) && R(5) > 0);
%=============================================================================
R = poissinv([-0.1 1.1 NaN 0 1], 2);
asserts.istrue(all(isnan(R(1:3))));
asserts.isequal(R(4), 0);
asserts.istrue(isinf(R(5)) && R(5) > 0);
%=============================================================================
R = poissinv([], []);
asserts.isequal(size(R), [0 0]);
%=============================================================================
asserts.checkerror('poissinv(ones(2), ones(3))', _('Size mismatch on input arguments'));
asserts.checkerror('poissinv({0.5}, 2)', sprintf(_('%s must be real numeric.'), 'Y'));
asserts.checkerror('poissinv(0.5, {2})', _('LAMBDA must be a nonnegative numeric array.'));
%=============================================================================
asserts.isequal(poissinv(poisscdf(2, 3), 3), 2);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('poisslike'), 2);
asserts.isequal(nargout('poisslike'), 2);
%=============================================================================
x = [0 1 2 3 5 8];
[NLOGL, AVAR] = poisslike(3, x);
asserts.isapprox(NLOGL, 15.00336781062121, 1e-12);
asserts.isapprox(AVAR, 0.5, 1e-12);
%=============================================================================
[NLOGL, AVAR] = poisslike(single(2), single([1 2 3]));
asserts.isequal(class(NLOGL), 'double');
asserts.isequal(class(AVAR), 'double');
asserts.isapprox(NLOGL, 4.326023566428328, 1e-12);
asserts.isapprox(AVAR, 0.6666666666666666, 1e-12);
%=============================================================================
[NLOGL, AVAR] = poisslike(0, [0 0 0]);
asserts.isequal(NLOGL, 0);
asserts.isequal(AVAR, 0);
[NLOGL, AVAR] = poisslike(0, [0 1]);
asserts.istrue(isinf(NLOGL));
asserts.istrue(isnan(AVAR));
[NLOGL, AVAR] = poisslike(NaN, x);
asserts.istrue(isnan(NLOGL));
asserts.istrue(isnan(AVAR));
[NLOGL, AVAR] = poisslike(1, [1 NaN 3]);
asserts.istrue(isnan(NLOGL));
asserts.istrue(isnan(AVAR));
%=============================================================================
asserts.checkerror('poisslike(1)', _('Not enough input arguments.'));
asserts.checkerror('poisslike({1}, [1 2 3])', sprintf(_('%s must be real numeric.'), 'LAMBDA'));
asserts.checkerror('poisslike(1, {1 2 3})', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('poisslike(1, [])', sprintf(_('%s must be nonempty.'), 'X'));
asserts.checkerror('poisslike(1, [-1 1 2])', sprintf(_('%s must contain nonnegative integer finite values.'), 'X'));
asserts.checkerror('poisslike(1, [1.5 2 3])', sprintf(_('%s must contain nonnegative integer finite values.'), 'X'));
asserts.checkerror('poisslike(1, [1 Inf 2])', sprintf(_('%s must contain nonnegative integer finite values.'), 'X'));
%=============================================================================%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('poisspdf'), 2);
asserts.isequal(nargout('poisspdf'), 1);
%=============================================================================
x = [0 1 2 5 10];
lambda = [0.5 1 2 4 8];
R = poisspdf(x, lambda);
REF = [0.606530659712633 0.367879441171442 0.270670566473225 ...
       0.156293451850532 0.0992615338315354];
asserts.isapprox(R, REF, 1e-12);
%=============================================================================
R = poisspdf([0 1 1.5 -1], 2);
asserts.isapprox(R, [0.135335283236613 0.270670566473225 0 0], 1e-12);
%=============================================================================
R = poisspdf([0 1], 0);
asserts.isequal(R, [1 0]);
%=============================================================================
R = poisspdf(single(x), single(lambda));
asserts.isequal(class(R), 'single');
asserts.isapprox(R, single(REF), 1e-6);
%=============================================================================
R = poisspdf([NaN 1 1], [2 -1 NaN]);
asserts.istrue(all(isnan(R)));
%=============================================================================
R = poisspdf([], []);
asserts.isequal(size(R), [0 0]);
%=============================================================================
asserts.checkerror('poisspdf(ones(2), ones(3))', _('Size mismatch on input arguments'));
asserts.checkerror('poisspdf({1}, 2)', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('poisspdf(1, {2})', _('LAMBDA must be a nonnegative numeric array.'));
%=============================================================================
asserts.isapprox(poisspdf(3, 3), exp(-3) * 27 / 6, 1e-12);
asserts.istrue(isnan(poisspdf(1, -1)));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('poissrnd'), -1);
asserts.isequal(nargout('poissrnd'), 1);
%=============================================================================
rng(0);
R = poissrnd(4, 2, 3);
REF = [6 2 5; 7 7 2];
asserts.isequal(R, REF);
%=============================================================================
rng(0);
U = rand(2, 3);
E = poissinv(U, 4);
rng(0);
R = poissrnd(4, 2, 3);
asserts.isequal(size(R), [2 3]);
asserts.isequal(R, E);
%=============================================================================
rng(0);
U = rand(1, 3);
E = poissinv(U, [1 4 10]);
rng(0);
R = poissrnd([1 4 10]);
asserts.isequal(R, E);
%=============================================================================
rng(0);
R = poissrnd(single(4), [2 3]);
asserts.isequal(class(R), 'single');
asserts.isequal(size(R), [2 3]);
R = poissrnd(4, single([2 3]));
asserts.isequal(class(R), 'double');
asserts.isequal(size(R), [2 3]);
%=============================================================================
R = poissrnd([-1 Inf NaN], [1 3]);
asserts.istrue(all(isnan(R)));
asserts.isequal(poissrnd(0, 1, 3), zeros(1, 3));
R = poissrnd(4, 0, 3);
asserts.isequal(size(R), [0 3]);
R = poissrnd(single(4), [2 0 3]);
asserts.isequal(class(R), 'single');
asserts.isequal(size(R), [2 0 3]);
%=============================================================================
asserts.checkerror('poissrnd([1 2], 2, 2)', _('Size mismatch on input arguments'));
asserts.checkerror('poissrnd(1, 1.5, 2)', _('Size must contain integer values.'));
asserts.checkerror('poissrnd({1})', _('LAMBDA must be a nonnegative numeric array.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('poissstat'), 1);
asserts.isequal(nargout('poissstat'), 2);
%=============================================================================
[m, v] = poissstat([0 1 5 Inf]);
asserts.isapprox(m(1:3), [0 1 5], 1e-15);
asserts.isapprox(v(1:3), [0 1 5], 1e-15);
asserts.istrue(isinf(m(4)) && isinf(v(4)));
%=============================================================================
[m, v] = poissstat(single([1 5]));
asserts.isequal(class(m), 'single');
asserts.isequal(class(v), 'single');
asserts.isapprox(double(m), [1 5], 1e-7);
asserts.isapprox(double(v), [1 5], 1e-7);
%=============================================================================
[m, v] = poissstat([-1 NaN]);
asserts.istrue(all(isnan(m)));
asserts.istrue(all(isnan(v)));
%=============================================================================
asserts.checkerror('poissstat({1})', _('LAMBDA must be a nonnegative numeric array.'));
%=============================================================================
[poissMean, poissVariance] = poissstat(3);
asserts.isequal(poissMean, 3);
asserts.isequal(poissVariance, 3);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('ppca'), -3);
asserts.isequal(nargout('ppca'), 6);
%=============================================================================
Y = [1 2 3; 2 3 5; 4 5 8; 5 7 11; 7 8 13];
[coeff, score, pcvar, mu, v, S] = ppca(Y, 2, ...
  'Options', statset('MaxIter', 20, 'TolFun', 1e-12, 'TolX', 1e-12));
asserts.isapprox(coeff, [0.439583987643785 0.877689815610245; ...
  0.471929899515482 -0.406484914431635; ...
  0.764230389182801 -0.253831837864286], 1e-12);
asserts.isapprox(score(:, 1), [-6.467776809863050; -4.027802144338180; ...
  0.087916797528757; 3.764051751751909; 6.643610404920564], 1e-12);
asserts.isapprox(pcvar, [29.092175285415173; 0.101473255844794], 1e-12);
asserts.isequal(mu, [3.8 5 8]);
asserts.istrue(abs(v - 0.001693722330681) < 1e-12);
asserts.isequal(S.NumIter, 1);
asserts.isapprox(S.Recon(1, :), [0.984149627580871 1.935028193448214 3.049238696319314], 1e-12);
asserts.isapprox(S.RMSResid, 0.041154857923230, 1e-12);
asserts.isequal(size(S.W), [3 2]);
asserts.isequal(size(S.Xexp), [5 2]);
%=============================================================================
Ym = Y;
Ym(2, 2) = NaN;
Ym(4, 3) = NaN;
[cm, sm, pm, mum, vm, Sm] = ppca(Ym, 2, ...
  'Options', statset('MaxIter', 20, 'TolFun', 1e-12, 'TolX', 1e-12));
asserts.isapprox(cm, [0.482024395384306 0.035140713937748; ...
  0.431764325679620 0.859919364209421; ...
  0.762385761491397 -0.509218830446803], 1e-12);
asserts.isapprox(sm(:, 1), [-6.122004707630984; -2.687501744492176; ...
  0.431290263017778; 1.393630955438844; 6.984585233666541], 1e-12);
asserts.isapprox(pm, [23.903564171047122; 1.064779319056134], 1e-12);
asserts.isapprox(mum, [3.800000000000000 5.461336270672396 7.299470222640876], 1e-12);
asserts.istrue(abs(vm - 0.052207242887008) < 1e-12);
asserts.isapprox(Sm.Recon(2, 2), 5.139123262324667, 1e-12);
asserts.isapprox(Sm.Recon(4, 3), 7.718031665263140, 1e-12);
asserts.isapprox(Sm.RMSResid, 0.254560085098954, 1e-12);
%=============================================================================
W0 = [1 0; 0 1; 1 1];
[cw, sw, pw, muw, vw, Sw] = ppca(Ym, 2, 'W0', W0, 'v0', 0.1, ...
  'Options', statset('MaxIter', 3));
asserts.isequal(size(cw), [3 2]);
asserts.isequal(size(sw), [5 2]);
asserts.isequal(size(pw), [2 1]);
asserts.isequal(size(muw), [1 3]);
asserts.istrue(vw > 0);
asserts.isequal(size(Sw.Recon), [5 3]);
%=============================================================================
[cs, ss, ps, mus, vs, Ss] = ppca(single(Y), 2, 'Options', statset('MaxIter', 1));
asserts.isequal(class(cs), 'single');
asserts.isequal(class(ss), 'single');
asserts.isequal(class(ps), 'single');
asserts.isequal(class(mus), 'single');
asserts.isequal(class(vs), 'single');
asserts.isequal(class(Ss.W), 'single');
%=============================================================================
asserts.checkerror('ppca()', _('Not enough input arguments.'));
asserts.checkerror('ppca({1}, 1)', sprintf(_('%s must be a real numeric matrix.'), 'Y'));
asserts.checkerror('ppca([1; 2], 1)', _('Y must contain at least two observations and two variables.'));
asserts.checkerror('ppca([1 Inf; 2 3], 1)', sprintf(_('%s must not contain Inf values.'), 'Y'));
asserts.checkerror('ppca(Y, 0)', sprintf(_('%s must be a positive integer scalar.'), 'K'));
asserts.checkerror('ppca(Y, 1.5)', sprintf(_('%s must be a positive integer scalar.'), 'K'));
asserts.checkerror('ppca([NaN 1; NaN 2; NaN 3], 1)', _('Each variable must contain at least one observed value.'));
asserts.checkerror('ppca(Y, 2, ''W0'', ones(2, 2))', sprintf(_('%s has incompatible size.'), 'W0'));
asserts.checkerror('ppca(Y, 2, ''W0'', [1 2; 3 4; 5 Inf])', sprintf(_('%s must contain finite values.'), 'W0'));
asserts.checkerror('ppca(Y, 2, ''v0'', 0)', sprintf(_('%s must be a positive scalar.'), 'v0'));
asserts.checkerror('ppca(Y, 2, ''Options'', 1)', sprintf(_('%s must be a scalar structure.'), 'Options'));
asserts.checkerror('ppca(Y, 2, ''Unknown'', 1)', _('Unknown option.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('prctile'), -1);
asserts.isequal(nargout('prctile'), 1);
%=============================================================================
C = (1:5)' * (2:6);
P = prctile(C, [25 50 75], 1);
REF = [3.5 5.25 7 8.75 10.5; ...
       6 9 12 15 18; ...
       8.5 12.75 17 21.25 25.5];
asserts.isapprox(P, REF, 1e-12);
P2 = prctile(C, [25 50 75], 2);
REF2 = [2.75 4 5.25; ...
        5.5 8 10.5; ...
        8.25 12 15.75; ...
        11 16 21; ...
        13.75 20 26.25];
asserts.isapprox(P2, REF2, 1e-12);
%=============================================================================
D = reshape(1:30, [3 5 2]);
Pall = prctile(D, [25 75], 'all');
asserts.isequal(Pall, [8; 23]);
Ppage = prctile(D, [25 75], [1 2]);
asserts.isapprox(Ppage(:), [4.25; 11.75; 19.25; 26.75], 1e-12);
%=============================================================================
methods = [prctile(1:5, 25, 'Method', 'midpoint'), ...
           prctile(1:5, 25, 'Method', 'inclusive'), ...
           prctile(1:5, 25, 'Method', 'exclusive')];
asserts.isapprox(methods, [1.75 2 1.5], 1e-12);
%=============================================================================
S = single([1 2 3]);
Psingle = prctile(S, [25 50 75]);
asserts.isequal(class(Psingle), 'single');
asserts.isapprox(double(Psingle), [1.25 2 2.75], 1e-6);
%=============================================================================
asserts.checkerror('prctile()', _('Not enough input arguments.'));
asserts.checkerror('prctile({1}, 50)', sprintf(_('%s must be a real numeric array.'), 'A'));
asserts.checkerror('prctile([1 2], -1)', _('Percentages must be in the range [0,100].'));
asserts.checkerror('prctile([1 2], 101)', _('Percentages must be in the range [0,100].'));
asserts.checkerror('prctile([1 2], 50, ''Method'', ''bad'')', _('Invalid quantile method.'));
