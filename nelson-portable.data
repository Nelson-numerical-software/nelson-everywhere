%=============================================================================
function a = struct2array(s)
  narginchk(1, 1);
  if ~isstruct(s)
    error('Nelson:data_structures:inputStructure', 'Input must be a structure.');
  end
  c = struct2cell(s);
  a = [c{:}];
end
