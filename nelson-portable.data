%=============================================================================
function y = cospi(varargin)
  narginchk(1, 1);
  nargoutchk(0, 1);
  x = varargin{1};
  x = mod(x - 0.5, 2) - 1;
  x(x == -1) = 0;
  y = sin(x * pi);
end
