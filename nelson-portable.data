% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function options = odeOptionsFromObject(obj)
  options = odeDefaultOptions();
  options = odeMergeOptions(options, obj.SolverOptions);
  options.RelTol = obj.RelativeTolerance;
  options.AbsTol = obj.AbsoluteTolerance;
  options.NonNegative = obj.NonNegativeVariables;
  options.InitialSlope = obj.InitialSlope;
  options.Parameters = obj.Parameters;
  if ~isempty(obj.MassMatrix)
    options.Mass = obj.MassMatrix.MassMatrix;
    options.MassSingular = obj.MassMatrix.Singular;
    options.MStateDependence = obj.MassMatrix.StateDependence;
    options.MvPattern = obj.MassMatrix.SparsityPattern;
  end
  if ~isempty(obj.Jacobian)
    options.Jacobian = obj.Jacobian.Jacobian;
    options.JPattern = obj.Jacobian.SparsityPattern;
    options.JConstant = obj.Jacobian.Constant;
  end
  if ~isempty(obj.EventDefinition)
    options.Events = @odeEvaluateEventObject;
    options.EventDefinitionObject = obj.EventDefinition;
  end
  if isprop(obj.SolverOptions, 'ComputeConsistentInitialConditions')
    options.ComputeConsistentInitialConditions = obj.SolverOptions.ComputeConsistentInitialConditions;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function status = odeOutputPlot(kind, t, y, flag)
  persistent states
  status = 0;
  if isempty(states)
    states = struct();
  end
  if isstring(flag)
    flag = char(flag);
  end
  state = odeOutputPlotGetState(states, kind);
  switch flag
    case 'init'
      state = odeOutputPlotInitialState(kind, t, y);
      states.(kind) = state;
    case 'done'
      odeOutputPlotFlush(kind, state);
      states.(kind) = state;
      drawnow();
    case ''
      if isempty(t) || isempty(y)
        return
      end
      state = odeOutputPlotAppend(kind, state, t, y);
      states.(kind) = state;
    otherwise
      error('Nelson:ode_solvers:unknownOutputCallbackFlag', 'Unknown output callback flag.');
  end
end
%=============================================================================
function state = odeOutputPlotEmptyState()
  state = struct('XData', [], 'YData', [], 'ZData', [], 'Handles', [], 'DrawCount', 0);
end
%=============================================================================
function state = odeOutputPlotGetState(states, kind)
  if isfield(states, kind)
    state = states.(kind);
  else
    state = odeOutputPlotEmptyState();
  end
end
%=============================================================================
function state = odeOutputPlotInitialState(kind, t, y)
  state = odeOutputPlotGetReusableState(kind);
  existingXData = state.XData;
  state = odeOutputPlotAppend(kind, state, t(1), y);
  if strcmp(kind, 'time') && length(t) >= 2
    bounds = [min([existingXData(:); t(:)]) max([existingXData(:); t(:)])];
    if bounds(1) ~= bounds(2)
      xlim(bounds);
    end
  end
end
%=============================================================================
function state = odeOutputPlotGetReusableState(kind)
  state = odeOutputPlotEmptyState();
  ax = gca();
  if ishold() && strcmp(kind, 'time')
    children = ax.Children;
    for k = 1:numel(children)
      child = children(k);
      if strcmp(child.Type, 'line') && strcmp(child.Tag, 'odeOutputPlot')
        state.XData = child.XData;
        state.YData = child.YData;
        state.Handles = {child};
        state.DrawCount = 0;
        return
      end
    end
  end
end
%=============================================================================
function state = odeOutputPlotAppend(kind, state, t, y)
  [newX, newY, newZ] = odeOutputPlotData(kind, t, y);
  state.XData = [state.XData newX];
  state.YData = [state.YData newY];
  state.ZData = [state.ZData newZ];
  if isempty(state.Handles) || ~odeOutputPlotHandlesValid(state.Handles)
    state.Handles = odeOutputPlotCreate(kind, state);
    state.DrawCount = 0;
  else
    state.DrawCount = state.DrawCount + 1;
    if odeOutputPlotShouldDraw(state)
      odeOutputPlotUpdate(kind, state);
      state.DrawCount = 0;
    end
  end
end
%=============================================================================
function tf = odeOutputPlotShouldDraw(state)
  tf = length(state.XData) <= 16 || state.DrawCount >= 250;
end
%=============================================================================
function odeOutputPlotFlush(kind, state)
  if isempty(state.Handles) || ~odeOutputPlotHandlesValid(state.Handles)
    return
  end
  odeOutputPlotUpdate(kind, state);
end
%=============================================================================
function [x, y, z] = odeOutputPlotData(kind, t, y)
  z = [];
  t = t(:).';
  y = odeOutputPlotNormalizeSolution(t, y);
  switch kind
    case 'time'
      x = t;
    case 'phase2'
      odeOutputPlotCheckComponents(y, 2);
      x = y(1, :);
      y = y(2, :);
    case 'phase3'
      odeOutputPlotCheckComponents(y, 3);
      x = y(1, :);
      z = y(3, :);
      y = y(2, :);
    otherwise
      error('Nelson:ode_solvers:unknownOutputPlotType', 'Unknown output plot type.');
  end
end
%=============================================================================
function y = odeOutputPlotNormalizeSolution(t, y)
  if isvector(y)
    y = y(:);
  end
  if size(y, 2) ~= length(t)
    if size(y, 1) == length(t)
      y = y.';
    elseif length(t) ~= 1
      error('Nelson:ode_solvers:incompatibleTimeSolutionSizes', 'Incompatible time and solution sizes.');
    end
  end
end
%=============================================================================
function odeOutputPlotCheckComponents(y, n)
  if size(y, 1) < n
    error('Nelson:ode_solvers:notEnoughSolutionComponents', 'Not enough solution components.');
  end
end
%=============================================================================
function handles = odeOutputPlotCreate(kind, state)
  ax = gca();
  switch kind
    case 'time'
      handles = odeOutputPlotCreateTimeLines(ax, state.XData, state.YData);
      xlabel(_('Time'));
      ylabel(_('Solution'));
    case 'phase2'
      handles = line('XData', state.XData, 'YData', state.YData, 'Parent', ax);
      handles.Tag = 'odeOutputPlot';
      xlabel('y(1)');
      ylabel('y(2)');
    case 'phase3'
      handles = line('XData', state.XData, 'YData', state.YData, ...
        'ZData', state.ZData, 'Parent', ax);
      handles.Tag = 'odeOutputPlot';
      xlabel('y(1)');
      ylabel('y(2)');
      zlabel('y(3)');
      view(3);
  end
end
%=============================================================================
function handles = odeOutputPlotCreateTimeLines(ax, x, y)
  handles = cell(size(y, 1), 1);
  wasHold = ishold();
  for k = 1:size(y, 1)
    handles{k} = line('XData', x, 'YData', y(k, :), 'Parent', ax);
    handles{k}.Tag = 'odeOutputPlot';
    hold on
  end
  if ~wasHold
    hold off
  end
end
%=============================================================================
function tf = odeOutputPlotHandlesValid(handles)
  if iscell(handles)
    tf = ~isempty(handles);
    for k = 1:length(handles)
      tf = tf && ishandle(handles{k});
    end
  else
    tf = ~isempty(handles) && ishandle(handles);
  end
end
%=============================================================================
function odeOutputPlotUpdate(kind, state)
  switch kind
    case 'time'
      for k = 1:length(state.Handles)
        state.Handles{k}.XData = state.XData;
        state.Handles{k}.YData = state.YData(k, :);
      end
    case 'phase2'
      state.Handles.XData = state.XData;
      state.Handles.YData = state.YData;
    case 'phase3'
      state.Handles.XData = state.XData;
      state.Handles.YData = state.YData;
      state.Handles.ZData = state.ZData;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function problem = odePrepareProblem(solver, odefun, tspan, y0, yp0, options)
  if ischar(odefun) || isStringScalar(odefun)
    odefun = odeLegacyTextFunction(str2func(char(odefun)), solver);
  end
  if ~isa(odefun, 'function_handle')
    error('Nelson:ode_solvers:functionHandleExpected', '%s must be a function handle.', 'Value');
  end
  if ~isnumeric(tspan) || numel(tspan) < 2
    error('Nelson:ode_solvers:timeSpanContainLeastTwoValues', 'Time span must contain at least two values.');
  end
  if ~isvector(tspan) || any(~isfinite(tspan(:))) || ~odeIsStrictlyMonotone(tspan(:).')
    error('Nelson:ode_solvers:timeSpanEntriesStrictlyIncreaseDecrease', 'Time span entries must strictly increase or decrease.');
  end
  tspan = tspan(:).';
  odeValidateVector(y0, 'InitialValue');
  if nargin < 6 || isempty(options)
    options = odeDefaultOptions();
  elseif odeIsSolverOptions(options)
    options = struct(options);
  end
  parameters = [];
  eventDefinitionObject = [];
  if isstruct(options) && isfield(options, 'Parameters')
    parameters = options.Parameters;
    options = rmfield(options, 'Parameters');
  end
  if isstruct(options) && isfield(options, 'EventDefinitionObject')
    eventDefinitionObject = options.EventDefinitionObject;
    options = rmfield(options, 'EventDefinitionObject');
  end
  options = odeMergeOptions(odeDefaultOptions(), options);
  options.Parameters = parameters;
  options = odeApplyDefaults(options, tspan, y0, solver);
  if ~isempty(eventDefinitionObject)
    options.EventDefinitionObject = eventDefinitionObject;
  end
  tfinal = tspan(length(tspan));
  problem.solver = solver;
  problem.odefun = odefun;
  problem.t0 = tspan(1);
  problem.tfinal = tfinal;
  problem.tspan = tspan;
  problem.y0 = y0(:);
  problem.yp0 = yp0;
  problem.options = options;
  problem.direction = sign(problem.tfinal - problem.t0);
  problem.errorExponent = odeErrorExponent(solver);
  if problem.direction == 0
    error('Nelson:ode_solvers:timeSpanEndpointsDistinct', 'Time span endpoints must be distinct.');
  end
end
%=============================================================================
function fcn = odeLegacyTextFunction(originalFcn, solver)
  isImplicit = strcmp(solver, 'ode15i');
  fcn = @(t, y, varargin) odeCallLegacyTextFunction(originalFcn, isImplicit, t, y, varargin{:});
end
%=============================================================================
function varargout = odeCallLegacyTextFunction(originalFcn, isImplicit, t, y, varargin)
  if isImplicit
    args = [{t, y, varargin{1}, []}, varargin(2:end)];
  else
    args = [{t, y, []}, varargin];
  end
  if nargout == 0
    feval(originalFcn, args{:});
  else
    [varargout{1:nargout}] = feval(originalFcn, args{:});
  end
end
%=============================================================================
function tf = odeIsStrictlyMonotone(tspan)
  delta = diff(tspan);
  tf = all(delta > 0) || all(delta < 0);
end
%=============================================================================
function exponent = odeErrorExponent(solver)
  if strcmp(solver, 'ode23')
    exponent = -1 / 3;
  elseif strcmp(solver, 'ode113')
    exponent = -1 / 4;
  elseif strcmp(solver, 'ode78')
    exponent = -1 / 7;
  elseif strcmp(solver, 'ode89')
    exponent = -1 / 8;
  elseif strcmp(solver, 'ode15s') || strcmp(solver, 'ode23tb')
    exponent = -1 / 3;
  elseif strcmp(solver, 'ode23s') || strcmp(solver, 'ode23t')
    exponent = -1 / 2;
  else
    exponent = -1 / 5;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function gradient = odeProjectedAdjointGradient(sol, sensitivity, parameters, indices)
  n = size(sol.y, 1);
  p = length(indices);
  gradient = zeros(p, 1);
  if ~isempty(sensitivity.ObjectiveFcn)
    tfinal = sol.x(length(sol.x));
    yfinal = sol.y(:, length(sol.x));
    sfinal = reshape(sol.sensitivity(:, :, length(sol.x)), n, p);
    base = odeAdjointScalar(sensitivity.ObjectiveFcn, tfinal, yfinal, parameters);
    gradient = gradient + odeAdjointParameterGradient(...
      sensitivity.ObjectiveFcn, tfinal, yfinal, parameters, indices, base);
    gradient = gradient + sfinal.' * odeAdjointStateGradient(...
      sensitivity.ObjectiveFcn, tfinal, yfinal, parameters, base);
  end
  if ~isempty(sensitivity.QuadratureFcn)
    gradient = gradient + odeAdjointQuadratureProjectedGradient(...
      sol, sensitivity.QuadratureFcn, parameters, indices);
  end
end
%=============================================================================
function gradient = odeAdjointQuadratureProjectedGradient(sol, fcn, parameters, indices)
  p = length(indices);
  integrand = zeros(p, length(sol.x));
  for k = 1:length(sol.x)
    y = sol.y(:, k);
    s = sol.sensitivity(:, :, k);
    base = odeAdjointScalar(fcn, sol.x(k), y, parameters);
    integrand(:, k) = odeAdjointParameterGradient(fcn, sol.x(k), y, parameters, indices, base) ...
      + s.' * odeAdjointStateGradient(fcn, sol.x(k), y, parameters, base);
  end
  gradient = zeros(p, 1);
  for k = 1:length(sol.x) - 1
    dt = sol.x(k + 1) - sol.x(k);
    gradient = gradient + 0.5 * dt * (integrand(:, k) + integrand(:, k + 1));
  end
end
%=============================================================================
function value = odeAdjointScalar(fcn, t, y, parameters)
  value = feval(fcn, t, y, parameters);
  if ~isnumeric(value) || ~isreal(value) || ~isscalar(value)
    error('Nelson:ode_solvers:adjointScalarFunctionReturnRealScalar', 'Adjoint scalar function must return a real scalar.');
  end
end
%=============================================================================
function gradient = odeAdjointStateGradient(fcn, t, y, parameters, base)
  gradient = zeros(length(y), 1);
  for k = 1:length(y)
    step = sqrt(eps) * max(1, abs(y(k)));
    trial = y;
    trial(k) = trial(k) + step;
    gradient(k) = (odeAdjointScalar(fcn, t, trial, parameters) - base) / step;
  end
end
%=============================================================================
function gradient = odeAdjointParameterGradient(fcn, t, y, parameters, indices, base)
  gradient = zeros(length(indices), 1);
  for k = 1:length(indices)
    idx = indices(k);
    step = sqrt(eps) * max(1, abs(parameters(idx)));
    trial = parameters;
    trial(idx) = trial(idx) + step;
    gradient(k) = (odeAdjointScalar(fcn, t, y, trial) - base) / step;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% After a rejected step the variable-order BDF kernel drops the oldest
% history point, lowering the working order by one (down to BDF2). A sharp
% solution feature that keeps rejecting high-order steps is then attacked
% with a more robust low-order formula, and the order rebuilds naturally as
% steps are accepted again.
function solverState = odeReduceOrderOnFailure(problem, solverState)
  if ~strcmp(problem.solver, 'ode15s')
    return
  end
  if ~isfield(solverState, 'consecutiveRejections')
    solverState.consecutiveRejections = 0;
  end
  solverState.consecutiveRejections = solverState.consecutiveRejections + 1;
  % An isolated rejection is normal step-size calibration; only a repeated
  % failure at the same location indicates the high-order formula is
  % struggling (sharp feature) and warrants dropping an order.
  if solverState.consecutiveRejections < 2
    return
  end
  if ~isfield(solverState, 'historyValid') || ~solverState.historyValid
    return
  end
  if ~isfield(solverState, 't') || length(solverState.t) <= 3
    return
  end
  solverState.t = solverState.t(2:end);
  solverState.y = solverState.y(:, 2:end);
  solverState.slope = solverState.slope(:, 2:end);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function sol = odeResampleSolution(sol, tspan)
  if length(tspan) <= 2
    refine = sol.extdata.options.Refine;
    if isempty(refine) || refine <= 1
      return
    end
    tspan = odeRefinedTimeVector(sol.x, refine);
  else
    tspan = odeReachedTimeVector(sol.x, tspan);
  end
  if length(tspan) < 2
    return
  end
  internal = sol;
  values = zeros(size(sol.y, 1), length(tspan));
  slopes = values;
  internalSlopes = [];
  if isfield(sol, 'extdata') && isfield(sol.extdata, 'slopes')
    internalSlopes = sol.extdata.slopes;
  end
  [values, slopes] = odeDevalInterpolate(sol.x, sol.y, tspan(:).', internalSlopes);
  values = odeApplyResampledNonNegative(sol.extdata.options, values);
  sol.x = tspan(:).';
  sol.y = values;
  sol.extdata.internal = internal;
  sol.extdata.slopes = slopes;
end

function output = odeReachedTimeVector(x, tspan)
  direction = sign(x(length(x)) - x(1));
  if direction == 0
    output = x(1);
    return
  end
  finalTime = x(length(x));
  keep = direction * (finalTime - tspan) >= -eps * (1 + abs(finalTime));
  output = tspan(keep);
  if isempty(output) || abs(output(length(output)) - finalTime) > eps * (1 + abs(finalTime))
    output(end + 1) = finalTime;
  end
end

function refined = odeRefinedTimeVector(x, refine)
  refined = x(1);
  for k = 1:(length(x) - 1)
    for j = 1:refine
      refined(end + 1) = x(k) + (j / refine) * (x(k + 1) - x(k));
    end
  end
end

function values = odeApplyResampledNonNegative(options, values)
  idx = options.NonNegative;
  if isempty(idx)
    return
  end
  values(idx(:), :) = max(values(idx(:), :), 0);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function sol = odeRestoreComplexSolution(sol, restore)
  sol = odeRestoreComplexSolutionStruct(sol, restore.StateSize, restore.Options);
end
%=============================================================================
function sol = odeRestoreComplexSolutionStruct(sol, n, originalOptions)
  sol.y = odeRealToComplexRows(sol.y, n);
  if isfield(sol, 'ye')
    sol.ye = odeRealToComplexRows(sol.ye, n);
  end
  if isfield(sol, 'extdata')
    if isfield(sol.extdata, 'slopes')
      sol.extdata.slopes = odeRealToComplexRows(sol.extdata.slopes, n);
    end
    if isfield(sol.extdata, 'internal')
      sol.extdata.internal = odeRestoreComplexSolutionStruct(sol.extdata.internal, n, originalOptions);
    end
    sol.extdata.options = originalOptions;
  end
  if isfield(sol, 'idata')
    sol.idata.idxNonNegative = originalOptions.NonNegative;
  end
end
%=============================================================================
function y = odeRealToComplexRows(z, n)
  if isempty(z)
    y = zeros(n, 0);
  else
    y = z(1:n, :) + 1i * z((n + 1):(2 * n), :);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function dy = odeRhs(problem, t, y)
  if strcmp(problem.solver, 'ode15i')
    dy = odeImplicitSlope(problem, t, y);
  else
    dy = odeCallFcn(problem.odefun, t, y, problem.options);
  end
  if ~isempty(problem.options.Mass)
    mass = problem.options.Mass;
    if isa(mass, 'function_handle')
      mass = odeCallFcn(mass, t, y, problem.options);
    end
    dy = mass \ dy;
  end
  dy = dy(:);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [jac, evals] = odeRhsJacobian(problem, t, y, f0)
  evals = 0;
  jac = problem.options.Jacobian;
  if isempty(jac)
    [jac, evals] = odeFiniteDifferenceRhsJacobian(problem, t, y, f0);
    return
  end
  if isa(jac, 'function_handle')
    jac = odeCallFcn(jac, t, y, problem.options);
    evals = 1;
  end
  if ~isempty(problem.options.Mass)
    mass = problem.options.Mass;
    if isa(mass, 'function_handle')
      mass = odeCallFcn(mass, t, y, problem.options);
      evals = evals + 1;
    end
    jac = mass \ jac;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% Modified Rosenbrock (2,3) pair of Shampine and Reichelt (the ode23s
% formula). Second-order accurate, L-stable, with an embedded third-order
% error estimate. The right-hand side and Jacobian are already expressed in
% standard form y' = F(t, y) (the mass matrix, if any, is pre-applied by
% odeRhs / odeRhsJacobian).
function [yhigh, ylow, evals] = odeRosenbrock23Step(problem, t, y, h)
  d = 1 / (2 + sqrt(2));
  e32 = 6 + sqrt(2);
  n = length(y);
  f0 = odeRhs(problem, t, y);
  [jac, jacEvals] = odeRhsJacobian(problem, t, y, f0);
  [tder, tderEvals] = odeRosenbrockTimeDerivative(problem, t, y, f0);
  W = eye(n, n) - h * d * jac;
  k1 = W \ (f0 + h * d * tder);
  f1 = odeRhs(problem, t + 0.5 * h, y + 0.5 * h * k1);
  k2 = W \ (f1 - k1) + k1;
  yhigh = y + h * k2;
  f2 = odeRhs(problem, t + h, yhigh);
  k3 = W \ (f2 - e32 * (k2 - f1) - 2 * (k1 - f0) + h * d * tder);
  errorEstimate = (h / 6) * (k1 - 2 * k2 + k3);
  ylow = yhigh - errorEstimate;
  evals = 3 + tderEvals + jacEvals;
end
%=============================================================================
function [tder, evals] = odeRosenbrockTimeDerivative(problem, t, y, f0)
  % Finite-difference approximation of the partial derivative df/dt, needed
  % for non-autonomous problems. It vanishes for autonomous right-hand sides.
  delta = sqrt(eps) * max(1, abs(t));
  ft = odeRhs(problem, t + delta, y);
  tder = (ft - f0) / delta;
  evals = 1;
end
