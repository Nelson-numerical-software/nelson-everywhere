% LICENCE_BLOCK_END
%=============================================================================
function s = seconds(x)
  narginchk(1, 1);
  if isa(x, 'duration')
    s = double(x);
  else
    s = duration(0, 0, double(x));
    s.Format = 's';
  end
end
