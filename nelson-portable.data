% LICENCE_BLOCK_END
function launcher = progressive_case_launcher(testCase)
  if testCase.options.gui_mode
    launcher = 'gui';
  elseif testCase.options.adv_cli_mode
    launcher = 'adv_cli';
  else
    launcher = 'cli';
  end
end
