function varargout = cmdsep(varargin)
  nargoutchk(0, 1);
  narginchk(0, 0);
  if ispc()
    varargout{1} = "&&";
  else
    varargout{1} = ";";
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
