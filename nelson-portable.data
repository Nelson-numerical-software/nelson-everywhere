function varargout = loglog(varargin)
  go = plot(varargin{:});
  ax = go.Parent;
  ax.XScale = 'log';
  ax.YScale = 'log';
  if (nargout > 0)
    varargout{1} = go;
  end
end
%=============================================================================
%=============================================================================
