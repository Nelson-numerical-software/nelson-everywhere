%=============================================================================
function varargout = ind2sub(dims, ind)
  narginchk(2, 2);
  if (isvector(dims) && all(round(dims) == dims))
    if (isnumeric(ind) && all(round(ind) == ind))
      if (nargout <= 1)
        % with a single output, the reference implementation returns the linear index unchanged
        % (no range validation)
        varargout{1} = ind;
        return
      end
      ntot = prod(dims);
      if (all(ind > 0 & ind <= ntot))
        nd = length(dims);
        if (nargout > 0)
          vlen = nargout;
        else
          vlen = 1;
        end
        if (nd > vlen);
          dims(vlen) = prod(dims(vlen:nd));
          dims(vlen + 1:nd) = [];
        end
        nd = length(dims);
        scale = [1, cumprod(dims(:))'];
        for i = nd:-1:2
          k = (ind >= scale(i));
          r = ones(size(ind));
          t = zeros(size(ind));
          t(k) = floor((ind(k) - 1) / scale(i));
          r(k) = t(k) + 1;
          ind(k) = ind(k) - t(k) * scale(i);
          varargout{i} = r;
        end
        varargout{1} = ind;
        for i = nd + 1:vlen
          varargout{i} = ones(size(ind));
        end
      else
        error('Nelson:elementary_functions:indexOutRange', 'Index out of range');
      end
    else
      error('Nelson:elementary_functions:integerValuedIndexArgumentExpected', 'Integer-valued index argument expected.');
    end
  else
    error('Nelson:elementary_functions:dimensionsIntegerVector', 'dimensions must be an integer vector.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function h = invhilb(n, requestedClassName)
  % https://nhigham.com/2020/06/30/what-is-the-hilbert-matrix/
  narginchk(1, 2)
  nargoutchk(0, 1)
  if nargin < 2
    className = 'double';
  else
    className = requestedClassName;
  end
  if isStringScalar(className)
    className = convertStringsToChars(className);
  end
  if ~strcmp(className, 'double') && ~strcmp(className, 'single')
    error('Nelson:elementary_functions:notSupportedClass', '#%d argument must be ''%s'' or ''%s''.', 2, 'double', 'single');
  end
  h = zeros(n, className);
  for row = 1:n
    for col = row:n
      entry = inverseHilbertEntry(n, row, col);
      h(row, col) = entry;
      h(col, row) = entry;
    end
  end
end
%=============================================================================
function entry = inverseHilbertEntry(order, row, col)
  signValue = 1 - 2 * rem(row + col, 2);
  left = nchoosek(order + row - 1, order - col);
  right = nchoosek(order + col - 1, order - row);
  center = nchoosek(row + col - 2, row - 1);
  entry = signValue * (row + col - 1) * left * right * center * center;
end
