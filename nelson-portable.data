%=============================================================================
function options = ip_parse_registration_options(args, optimizer)
  options = struct('InitialTransformation', eye(3), 'Interpolation', 'linear', ...
    'MaximumIterations', double(optimizer.MaximumIterations), ...
    'AngleSearch', double(optimizer.AngleSearch), 'ScaleSearch', double(optimizer.ScaleSearch), ...
    'ShearSearch', double(optimizer.ShearSearch));
  if mod(numel(args), 2) ~= 0
    error('Nelson:image_processing:nameValueArgumentsAppearPairs', 'Name-value arguments must be paired.');
  end
  for k = 1:2:numel(args)
    if ~(ischar(args{k}) || isStringScalar(args{k}))
      error('Nelson:image_processing:registrationOptionNameString', '%s option name must be a string.', 'Registration');
    end
    name = lower(convertStringsToChars(args{k}));
    value = args{k + 1};
    switch name
      case 'initialtransformation'
        options.InitialTransformation = ip_tform_matrix(value);
      case 'interpolation'
        options.Interpolation = ip_registration_interpolation(value);
      case 'pyramidlevels'
        ip_validate_registration_positive_integer(value, 'PyramidLevels');
      case 'displayoptimization'
      otherwise
        error('Nelson:image_processing:unsupportedRegistrationOption', 'Unsupported "%s" option.', 'registration');
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function options = ip_parse_registration_output_options(args)
  options = struct('Interpolation', 'linear');
  if mod(numel(args), 2) ~= 0
    error('Nelson:image_processing:nameValueArgumentsAppearPairs', 'Name-value arguments must be paired.');
  end
  for k = 1:2:numel(args)
    if ~(ischar(args{k}) || isStringScalar(args{k}))
      error('Nelson:image_processing:registrationOptionNameString', '%s option name must be a string.', 'Registration');
    end
    name = lower(convertStringsToChars(args{k}));
    if strcmp(name, 'interpolation')
      options.Interpolation = ip_registration_interpolation(args{k + 1});
    elseif ~strcmp(name, 'initialtransformation') && ~strcmp(name, 'pyramidlevels') ...
        && ~strcmp(name, 'displayoptimization')
      error('Nelson:image_processing:unsupportedRegistrationOption', 'Unsupported "%s" option.', 'registration');
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [dx, dy, peakcorr] = ip_phase_correlation_translation(moving, fixed)
  moving = moving - mean(moving(:));
  fixed = fixed - mean(fixed(:));
  if all(moving(:) == 0) || all(fixed(:) == 0)
    dx = 0;
    dy = 0;
    peakcorr = 0;
    return
  end
  cps = fft2(fixed) .* conj(fft2(moving));
  cpsAbs = abs(cps);
  keep = cpsAbs > 0;
  cps(keep) = cps(keep) ./ cpsAbs(keep);
  cps(~keep) = 0;
  corr = real(conj(fft2(conj(cps))) / numel(cps));
  [peakcorr, index] = max(corr(:));
  [row, col] = ind2sub(size(corr), index);
  dy = row - 1;
  dx = col - 1;
  rows = size(corr, 1);
  cols = size(corr, 2);
  if dy > floor(rows / 2)
    dy = dy - rows;
  end
  if dx > floor(cols / 2)
    dx = dx - cols;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function out = ip_reconstruct_by_dilation_2d(marker, mask, conn)
  previous = marker;
  nhood = ip_connectivity_nhood_2d(conn);
  maxIterations = numel(marker) + 1;
  for k = 1:maxIterations
    current = min(imdilate(previous, nhood), mask);
    if isequal(current, previous)
      out = current;
      return
    end
    previous = current;
  end
  out = previous;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function out = ip_reconstruct_by_erosion_2d(marker, mask, conn)
  previous = marker;
  nhood = ip_connectivity_nhood_2d(conn);
  maxIterations = numel(marker) + 1;
  for k = 1:maxIterations
    current = max(imerode(previous, nhood), mask);
    if isequal(current, previous)
      out = current;
      return
    end
    previous = current;
  end
  out = previous;
end
