function M = median(A, varargin)
  if ~A.isOrdinal
    error('Nelson:categorical:requiresOrdinal', '%s requires ordinal categorical arrays.', 'Median');
  end
  S = sort(A(:));
  M = S(ceil(numel(S) / 2));
end
