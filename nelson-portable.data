function display_skip_reason(testCase)
  if testCase.skip && ~isempty(testCase.msg)
    msg = sprintf('    Reason: %s\n', testCase.msg);
    if length(msg) > 75
      msg = [msg(1:75), '...', '\n'];
    end
    fprintf(stdout, msg);
  end
end
