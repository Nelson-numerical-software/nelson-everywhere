% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function options = odeMergeOptions(options, extra)
  if isempty(extra)
    return
  end
  if odeIsSolverOptions(extra)
    extra = struct(extra);
  end
  if ~isstruct(extra)
    error('Nelson:ode_solvers:optionsStructureExpected', 'Options structure expected.');
  end
  names = fieldnames(extra);
  for k = 1:length(names)
    if strcmp(names{k}, 'Sensitivity')
      options.Sensitivity = extra.(names{k});
      continue
    end
    if strcmp(names{k}, 'ID') || strcmp(names{k}, 'ComputeConsistentInitialConditions')
      continue
    end
    name = odeOptionName(names{k});
    options.(name) = extra.(names{k});
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function hnext = odeNextStep(problem, h, err, accepted, acceptedSteps, solverState)
  exponent = problem.errorExponent;
  if nargin >= 6 && strcmp(problem.solver, 'ode15s')
    % The BDF kernel runs at a history-dependent order k: keep the step
    % size controller consistent with the O(h^(k+1)) local error.
    k = odeBDFOrderFromState(problem, solverState);
    exponent = -1 / (k + 1);
  end
  safety = 0.9;
  if strcmp(problem.solver, 'ode89')
    % At order eight a step barely inside the tolerance leaves little
    % headroom; a more conservative growth keeps the global error well
    % below the requested tolerance.
    safety = 0.7;
  end
  if err <= 0
    factor = 5;
  else
    factor = min(5, max(0.2, safety * err ^ exponent));
  end
  factor = odeLimitStepGrowth(problem, factor, accepted, acceptedSteps);
  if ~accepted
    factor = min(factor, 0.5);
  end
  hnext = h * factor;
  minStep = problem.options.MinStep;
  if minStep > 0 && abs(hnext) < minStep
    hnext = problem.direction * minStep;
  end
end
%=============================================================================
function factor = odeLimitStepGrowth(problem, factor, accepted, acceptedSteps)
  if ~accepted || ~strcmp(problem.solver, 'ode15i')
    return
  end
  startupGrowth = [1 2 1 1 2];
  if acceptedSteps <= length(startupGrowth)
    factor = min(factor, startupGrowth(acceptedSteps));
  else
    factor = min(factor, 2);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function name = odeOptionName(name)
  if isstring(name)
    name = char(name);
  end
  if ~ischar(name)
    error('Nelson:ode_solvers:optionNameExpected', 'Option name expected.');
  end
  names = fieldnames(odeDefaultOptions());
  idx = find(strcmpi(name, names));
  if isempty(idx)
    matches = [];
    for k = 1:length(names)
      candidate = names{k};
      if length(name) <= length(candidate) && strcmpi(name, candidate(1:length(name)))
        matches(end + 1) = k;
      end
    end
    idx = matches;
  end
  if isempty(idx)
    error('Nelson:ode_solvers:unknownOdeOptionName', 'Unknown %s option name.', 'ODE');
  end
  if length(idx) > 1
    error('Nelson:ode_solvers:ambiguousOdeOptionName', 'Ambiguous %s option name.', 'ODE');
  end
  name = names{idx(1)};
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function options = odeOptionsFromObject(obj)
  options = odeDefaultOptions();
  options = odeMergeOptions(options, obj.SolverOptions);
  options.RelTol = obj.RelativeTolerance;
  options.AbsTol = obj.AbsoluteTolerance;
  options.NonNegative = obj.NonNegativeVariables;
  options.InitialSlope = obj.InitialSlope;
  options.Parameters = obj.Parameters;
  if ~isempty(obj.MassMatrix)
    options.Mass = obj.MassMatrix.MassMatrix;
    options.MassSingular = obj.MassMatrix.Singular;
    options.MStateDependence = obj.MassMatrix.StateDependence;
    options.MvPattern = obj.MassMatrix.SparsityPattern;
  end
  if ~isempty(obj.Jacobian)
    options.Jacobian = obj.Jacobian.Jacobian;
    options.JPattern = obj.Jacobian.SparsityPattern;
    options.JConstant = obj.Jacobian.Constant;
  end
  if ~isempty(obj.EventDefinition)
    options.Events = @odeEvaluateEventObject;
    options.EventDefinitionObject = obj.EventDefinition;
  end
  if isprop(obj.SolverOptions, 'ComputeConsistentInitialConditions')
    options.ComputeConsistentInitialConditions = obj.SolverOptions.ComputeConsistentInitialConditions;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
