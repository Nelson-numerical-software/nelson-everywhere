function timeout = discover_defaultTimeout(kind, tagTimeout)
  if nargin < 2
    tagTimeout = 0;
  end
  if tagTimeout > 0
    timeout = tagTimeout;
    return
  end
  if strcmp(kind, 'bench')
    timeout = 380;
  else
    timeout = 140;
  end
end
