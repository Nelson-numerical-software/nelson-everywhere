function value = get(obj, propertyName)
  if nargin == 1
    value = struct(obj);
    return
  end
  propertyName = timeseriesText(propertyName, 'Property name');
  if isfield(obj.Members_, propertyName)
    value = obj.Members_.(propertyName);
  else
    value = obj.(propertyName);
  end
end
