function args = graphicsSelectTableSeriesArgs(tableArgs, k, nSeries)
  args = {};
  if isempty(tableArgs)
    return
  end
  if nSeries == 1
    args = tableArgs{1};
  else
    args = tableArgs{k};
  end
end
