% LICENCE_BLOCK_END
%=============================================================================
function sol = odeRunSensitivity(solver, odefun, tspan, y0, yp0, options, sensitivity)
  odeValidateSensitivityProblem(solver, options, sensitivity);
  if strcmp(sensitivity.Method, 'adjoint')
    sol = odeRunAdjointSensitivity(solver, odefun, tspan, y0, yp0, options, sensitivity);
    return
  end
  parameters = options.Parameters(:);
  indices = odeSensitivityParameterIndices(sensitivity, length(parameters));
  y0 = y0(:);
  if odeIsSundialsSolver(solver) && isempty(options.Events)
    sol = odeRunSundialsSensitivity(...
      solver, odefun, tspan, y0, yp0, options, sensitivity, parameters, indices);
    return
  end
  if odeSensitivityIsImplicitSolver(solver)
    sol = odeRunImplicitSensitivity(solver, odefun, tspan, y0, yp0, options, ...
      sensitivity, parameters, indices);
    return
  end
  s0 = odeSensitivityInitialValue(sensitivity, length(y0), length(indices));
  z0 = [y0; s0(:)];
  augOptions = odeSensitivityOptions(options, length(y0));
  augfun = @(t, z) odeSensitivityRhs(odefun, t, z, length(y0), parameters, indices, ...
    sensitivity, options);
  sol = odeRunSolver(solver, augfun, tspan, z0, [], augOptions);
  sol = odeSensitivitySplitSolution(sol, length(y0), length(indices));
end
%=============================================================================
function sol = odeRunSundialsSensitivity(solver, odefun, tspan, y0, yp0, options, ...
    sensitivity, parameters, indices)
  n = length(y0);
  p = length(indices);
  s0 = odeSensitivityInitialValue(sensitivity, n, p);
  sensitivityData = struct();
  sensitivityData.Parameters = parameters(:);
  sensitivityData.ParameterIndices = indices(:) - 1;
  sensitivityData.ParameterScales = max(abs(parameters(indices(:))), 1);
  sensitivityData.InitialValue = s0;
  if strcmp(solver, 'idas')
    if isempty(yp0)
      yp0 = zeros(size(y0));
    else
      yp0 = yp0(:);
    end
    sensitivityData.InitialSlope = odeSensitivityInitialSlopeImplicit(...
      odefun, tspan(1), y0, yp0, s0, sensitivity, parameters, indices, options);
  else
    sensitivityData.InitialSlope = [];
  end
  nativeOptions = options;
  nativeOptions.Sensitivity = sensitivityData;
  problem = odePrepareProblem(solver, odefun, tspan, y0, yp0, nativeOptions);
  sol = __ode_sundials_run__(problem);
  odeDisplayStats(problem, sol.stats);
end
%=============================================================================
function odeValidateSensitivityProblem(solver, options, sensitivity)
  if ~isnumeric(options.Parameters) || ~isreal(options.Parameters) || ~isvector(options.Parameters)
    error('Nelson:ode_solvers:parametersNumericVectorPerformSensitivityAnalysis', 'Parameters must be a numeric vector to perform a sensitivity analysis.');
  end
  if ~odeSensitivityIsImplicitSolver(solver) && ~isempty(sensitivity.InitialSlope)
    error('Nelson:ode_solvers:sensitivityInitialSlopesNotSupportedExplicit', 'Sensitivity initial slopes are not supported for explicit problems.');
  end
  if isfield(options, 'EventDefinitionObject') ...
      && odeSensitivityHasCallbackEvent(options.EventDefinitionObject)
    error('Nelson:ode_solvers:sensitivityEquationsEventCallbacksNotSupported', 'Sensitivity equations with event callbacks are not supported yet.');
  end
end
%=============================================================================
function tf = odeSensitivityIsImplicitSolver(solver)
  tf = strcmp(solver, 'ode15i') || strcmp(solver, 'idas');
end
%=============================================================================
function sol = odeRunImplicitSensitivity(solver, odefun, tspan, y0, yp0, options, ...
    sensitivity, parameters, indices)
  n = length(y0);
  p = length(indices);
  if isempty(yp0)
    yp0 = zeros(size(y0));
  else
    yp0 = yp0(:);
  end
  s0 = odeSensitivityInitialValue(sensitivity, n, p);
  sp0 = odeSensitivityInitialSlopeImplicit(...
    odefun, tspan(1), y0, yp0, s0, sensitivity, parameters, indices, options);
  z0 = [y0; s0(:)];
  zp0 = [yp0; sp0(:)];
  augOptions = odeSensitivityOptions(options, n);
  augOptions.InitialSlope = zp0;
  augfun = @(t, z, zp) odeSensitivityImplicitResidual(...
    odefun, t, z, zp, n, p, parameters, indices, options);
  sol = odeRunSolver(solver, augfun, tspan, z0, zp0, augOptions);
  sol = odeSensitivitySplitSolution(sol, n, p);
end
%=============================================================================
function sp0 = odeSensitivityInitialSlopeImplicit(...
    odefun, t, y, yp, s0, sensitivity, parameters, indices, options)
  n = length(y);
  p = length(indices);
  if ~isempty(sensitivity.InitialSlope)
    sp0 = odeSensitivityInitialSlopeValue(sensitivity.InitialSlope, n, p);
    return
  end
  residual = odeSensitivityImplicitPhysicalResidual(odefun, t, y, yp, parameters);
  jacY = odeSensitivityImplicitStateJacobian(odefun, t, y, yp, parameters, residual);
  jacYp = odeSensitivityImplicitSlopeJacobian(odefun, t, y, yp, parameters, residual);
  jacP = odeSensitivityImplicitParameterJacobian(...
    odefun, t, y, yp, parameters, indices, residual);
  sp0 = zeros(n, p);
  for k = 1:p
    sp0(:, k) = odeSensitivitySolveMass(jacYp, -(jacY * s0(:, k) + jacP(:, k)));
  end
end
%=============================================================================
function sp0 = odeSensitivityInitialSlopeValue(value, n, p)
  if isequal(size(value), [n p])
    sp0 = value;
  elseif numel(value) == n * p
    sp0 = reshape(value, n, p);
  else
    error('Nelson:ode_solvers:sensitivityInitialSlopeSizeMismatch', 'Sensitivity initial slope has incompatible size.');
  end
end
%=============================================================================
function residual = odeSensitivityImplicitResidual(...
    odefun, t, z, zp, n, p, parameters, indices, options)
  y = z(1:n);
  yp = zp(1:n);
  smat = reshape(z(n + 1:length(z)), n, p);
  spmat = reshape(zp(n + 1:length(zp)), n, p);
  f0 = odeSensitivityImplicitPhysicalResidual(odefun, t, y, yp, parameters);
  jacY = odeSensitivityImplicitStateJacobian(odefun, t, y, yp, parameters, f0);
  jacYp = odeSensitivityImplicitSlopeJacobian(odefun, t, y, yp, parameters, f0);
  jacP = odeSensitivityImplicitParameterJacobian(odefun, t, y, yp, parameters, indices, f0);
  sres = jacY * smat + jacYp * spmat + jacP;
  residual = [f0(:); sres(:)];
end
%=============================================================================
function tf = odeSensitivityHasCallbackEvent(eventDefinition)
  response = eventDefinition.Response;
  if iscell(response)
    tf = false;
    for k = 1:numel(response)
      tf = tf || strcmpi(response{k}, 'callback');
    end
  else
    tf = strcmpi(response, 'callback');
  end
end
%=============================================================================
function indices = odeSensitivityParameterIndices(sensitivity, count)
  if isempty(sensitivity.ParameterIndices)
    indices = (1:count).';
  else
    indices = sensitivity.ParameterIndices(:);
  end
  if any(indices > count)
    error('Nelson:ode_solvers:parameterindicesExceedNumberParameters', 'ParameterIndices exceed the number of parameters.');
  end
end
%=============================================================================
function s0 = odeSensitivityInitialValue(sensitivity, n, p)
  if isempty(sensitivity.InitialValue)
    s0 = zeros(n, p);
    return
  end
  value = sensitivity.InitialValue;
  if isequal(size(value), [n p])
    s0 = value;
  elseif numel(value) == n * p
    s0 = reshape(value, n, p);
  else
    error('Nelson:ode_solvers:sensitivityInitialValueIncompatibleSize', 'Sensitivity initial value has incompatible size.');
  end
end
%=============================================================================
function options = odeSensitivityOptions(options, n)
  baseOptions = options;
  options.Parameters = [];
  if ~isempty(baseOptions.Events)
    options.Events = @(t, z) odeSensitivityEvents(baseOptions, t, z, n);
  else
    options.Events = [];
  end
  if isfield(options, 'EventDefinitionObject')
    options = rmfield(options, 'EventDefinitionObject');
  end
  if ~isempty(baseOptions.OutputFcn)
    options.OutputFcn = @(t, z, flag) odeSensitivityOutput(baseOptions, t, z, flag, n);
  else
    options.OutputFcn = [];
  end
  options.OutputSel = [];
  options.NonNegative = baseOptions.NonNegative;
  options.Mass = [];
  options.MvPattern = [];
  options.Jacobian = [];
  options.JPattern = [];
  options.Vectorized = 'off';
end
%=============================================================================
function stop = odeSensitivityOutput(options, t, z, flag, n)
  y = z;
  if ~isempty(z) && isempty(flag)
    y = z(1:n, :);
  elseif ~isempty(z) && strcmp(flag, 'init')
    y = z(1:n, :);
  end
  if ~isempty(options.OutputSel) && (isempty(flag) || strcmp(flag, 'init'))
    y = y(options.OutputSel, :);
  end
  args = {t, y, flag};
  if isfield(options, 'Parameters') && ~isempty(options.Parameters)
    args = odeAppendParameters(args, options.Parameters);
  end
  stop = feval(options.OutputFcn, args{:});
end
%=============================================================================
function [value, isterminal, direction] = odeSensitivityEvents(options, t, z, n)
  y = z(1:n);
  if isfield(options, 'EventDefinitionObject')
    args = {options.EventDefinitionObject, t, y};
    if isfield(options, 'Parameters') && ~isempty(options.Parameters)
      args = odeAppendParameters(args, options.Parameters);
    end
    [value, isterminal, direction] = odeEvaluateEventObject(args{:});
  else
    [value, isterminal, direction] = odeCallFcn(options.Events, t, y, options);
  end
end
%=============================================================================
function dz = odeSensitivityRhs(odefun, t, z, n, parameters, indices, sensitivity, options)
  y = z(1:n);
  pcount = length(indices);
  smat = reshape(z(n + 1:length(z)), n, pcount);
  f0 = odeSensitivityPhysicalRhs(odefun, t, y, parameters, options);
  jacY = odeSensitivityStateJacobian(odefun, t, y, parameters, f0, sensitivity, options);
  jacP = odeSensitivityParameterJacobian(odefun, t, y, parameters, indices, f0, options);
  ds = jacY * smat + jacP;
  dz = [f0(:); ds(:)];
end
%=============================================================================
function residual = odeSensitivityImplicitPhysicalResidual(odefun, t, y, yp, parameters)
  residual = feval(odefun, t, y, yp, parameters);
  residual = residual(:);
end
%=============================================================================
function rhs = odeSensitivityPhysicalRhs(odefun, t, y, parameters, options)
  rhs = feval(odefun, t, y, parameters);
  if ~isempty(options.Mass)
    mass = odeSensitivityMassValue(options.Mass, t, y, parameters, options);
    rhs = odeSensitivitySolveMass(mass, rhs);
  end
end
%=============================================================================
function mass = odeSensitivityMassValue(mass, t, y, parameters, options)
  if isa(mass, 'function_handle')
    localOptions = options;
    localOptions.Parameters = parameters;
    mass = odeCallFcn(mass, t, y, localOptions);
  end
end
%=============================================================================
function rhs = odeSensitivitySolveMass(mass, rhs)
  if isscalar(mass)
    rhs = rhs ./ mass;
  else
    rhs = mass \ rhs;
  end
end
%=============================================================================
function jac = odeSensitivityImplicitStateJacobian(odefun, t, y, yp, parameters, f0)
  n = length(y);
  jac = zeros(n, n);
  for k = 1:n
    step = sqrt(eps) * max(abs(y(k)), 1);
    trial = y;
    trial(k) = trial(k) + step;
    trialResidual = odeSensitivityImplicitPhysicalResidual(odefun, t, trial, yp, parameters);
    jac(:, k) = (trialResidual - f0) / step;
  end
end
%=============================================================================
function jac = odeSensitivityImplicitSlopeJacobian(odefun, t, y, yp, parameters, f0)
  n = length(yp);
  jac = zeros(n, n);
  for k = 1:n
    step = sqrt(eps) * max(abs(yp(k)), 1);
    trial = yp;
    trial(k) = trial(k) + step;
    trialResidual = odeSensitivityImplicitPhysicalResidual(odefun, t, y, trial, parameters);
    jac(:, k) = (trialResidual - f0) / step;
  end
end
%=============================================================================
function jac = odeSensitivityImplicitParameterJacobian(...
    odefun, t, y, yp, parameters, indices, f0)
  n = length(y);
  jac = zeros(n, length(indices));
  for k = 1:length(indices)
    idx = indices(k);
    step = sqrt(eps) * max(abs(parameters(idx)), 1);
    trial = parameters;
    trial(idx) = trial(idx) + step;
    trialResidual = odeSensitivityImplicitPhysicalResidual(odefun, t, y, yp, trial);
    jac(:, k) = (trialResidual - f0) / step;
  end
end
%=============================================================================
function jac = odeSensitivityStateJacobian(odefun, t, y, parameters, f0, sensitivity, options)
  if ~isempty(sensitivity.Jacobian)
    jac = sensitivity.Jacobian.Jacobian;
    if isa(jac, 'function_handle')
      jac = feval(jac, t, y, parameters);
    end
    if ~isempty(options.Mass)
      mass = odeSensitivityMassValue(options.Mass, t, y, parameters, options);
      jac = odeSensitivitySolveMass(mass, jac);
    end
    return
  end
  n = length(y);
  jac = zeros(n, n);
  for k = 1:n
    step = sqrt(eps) * max(abs(y(k)), 1);
    trial = y;
    trial(k) = trial(k) + step;
    trialRhs = odeSensitivityPhysicalRhs(odefun, t, trial, parameters, options);
    jac(:, k) = (trialRhs - f0) / step;
  end
end
%=============================================================================
function jac = odeSensitivityParameterJacobian(odefun, t, y, parameters, indices, f0, options)
  n = length(y);
  jac = zeros(n, length(indices));
  for k = 1:length(indices)
    idx = indices(k);
    step = sqrt(eps) * max(abs(parameters(idx)), 1);
    trial = parameters;
    trial(idx) = trial(idx) + step;
    trialRhs = odeSensitivityPhysicalRhs(odefun, t, y, trial, options);
    jac(:, k) = (trialRhs - f0) / step;
  end
end
%=============================================================================
function sol = odeSensitivitySplitSolution(sol, n, p)
  z = sol.y;
  nt = size(z, 2);
  sol.y = z(1:n, :);
  if isfield(sol, 'extdata') && isfield(sol.extdata, 'slopes')
    sol.extdata.slopes = sol.extdata.slopes(1:n, :);
  end
  if isfield(sol, 'extdata') && isfield(sol.extdata, 'yp0') && ~isempty(sol.extdata.yp0)
    sol.extdata.yp0 = sol.extdata.yp0(1:n);
  end
  sensitivity = zeros(n, p, nt);
  for k = 1:nt
    sensitivity(:, :, k) = reshape(z(n + 1:size(z, 1), k), n, p);
  end
  sol.sensitivity = sensitivity;
  if isfield(sol, 'ye')
    zevent = sol.ye;
    sol.ye = zevent(1:n, :);
    ne = size(zevent, 2);
    eventSensitivity = zeros(n, p, ne);
    for k = 1:ne
      eventSensitivity(:, :, k) = reshape(zevent(n + 1:size(zevent, 1), k), n, p);
    end
    sol.eventSensitivity = eventSensitivity;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function sol = odeRunSolver(solver, odefun, tspan, y0, yp0, options, nout)
  if nargin < 7
    nout = 1;
  end
  if strcmp(solver, 'autoswitch')
    sol = odeRunAutoSwitchSolver(odefun, tspan, y0, yp0, options, nout);
    return
  end
  problem = odePrepareProblem(solver, odefun, tspan, y0, yp0, options);
  problem.storeRequestedOutputOnly = nout > 1 && length(problem.tspan) > 2;
  if odeIsSundialsSolver(problem.solver)
    if ~odeSundialsAvailable()
      error('Nelson:ode_solvers:sundialsBackendNotAvailable', 'SUNDIALS backend is not available.');
    end
    sol = __ode_sundials_run__(problem);
    sol = odeApplySundialsOutputFcn(problem, sol);
    odeDisplayStats(problem, sol.stats);
    return
  end
  [x, y, slopes, xe, ye, ie, stats] = odeIntegrate(problem);
  sol = odeBuildSolution(problem, x, y, slopes, xe, ye, ie, stats);
  odeDisplayStats(problem, stats);
end
%=============================================================================
function sol = odeApplySundialsOutputFcn(problem, sol)
  if isempty(problem.options.OutputFcn)
    return
  end
  stop = odeCallOutput(problem, problem.tspan, problem.y0, 'init');
  stopIndex = [];
  if stop
    stopIndex = 1;
  else
    for k = 2:length(sol.x)
      stop = odeCallOutput(problem, sol.x(k), sol.y(:, k), '');
      if stop
        stopIndex = k;
        break
      end
    end
  end
  odeCallOutput(problem, [], [], 'done');
  if ~isempty(stopIndex)
    sol = odeTrimSundialsSolution(sol, stopIndex, problem.direction);
  end
end
%=============================================================================
function sol = odeTrimSundialsSolution(sol, stopIndex, direction)
  sol.x = sol.x(1:stopIndex);
  sol.y = sol.y(:, 1:stopIndex);
  if isfield(sol, 'yp')
    sol.yp = sol.yp(:, 1:stopIndex);
  end
  if isfield(sol, 'extdata') && isfield(sol.extdata, 'slopes')
    sol.extdata.slopes = sol.extdata.slopes(:, 1:stopIndex);
  end
  if isfield(sol, 'xe')
    if direction > 0
      keep = sol.xe <= sol.x(end);
    else
      keep = sol.xe >= sol.x(end);
    end
    sol.xe = sol.xe(keep);
    sol.ye = sol.ye(:, keep);
    sol.ie = sol.ie(keep);
  end
end
%=============================================================================
function sol = odeRunAutoSwitchSolver(odefun, tspan, y0, yp0, options, nout)
  nonstiffSolver = 'ode45';
  stiffSolver = 'ode15s';
  problem = odePrepareProblem(nonstiffSolver, odefun, tspan, y0, yp0, options);
  problem.storeRequestedOutputOnly = nout > 1 && length(problem.tspan) > 2;
  problem.autoSwitch = odeAutoSwitchState(nonstiffSolver, stiffSolver);
  [x, y, slopes, xe, ye, ie, stats] = odeIntegrate(problem);
  sol = odeBuildSolution(problem, x, y, slopes, xe, ye, ie, stats);
  sol = odeAnnotateAutoSwitch(sol, stats);
  odeDisplayStats(problem, stats);
end
%=============================================================================
function state = odeAutoSwitchState(nonstiffSolver, stiffSolver)
  state = struct();
  state.enabled = true;
  state.initialSolver = nonstiffSolver;
  state.stiffSolver = stiffSolver;
  state.selectedSolver = nonstiffSolver;
  state.switched = false;
  state.reason = 'nonstiffAccepted';
  state.switchTime = [];
  state.switchCount = 0;
  state.nonstiffCandidateSteps = 0;
  state.mode = 'step';
end
%=============================================================================
function sol = odeAnnotateAutoSwitch(sol, stats)
  sol.solver = stats.autoSwitchSelectedSolver;
  if isfield(sol, 'stats')
    sol.stats.autoSwitchInitialSolver = stats.autoSwitchInitialSolver;
    sol.stats.autoSwitchSelectedSolver = stats.autoSwitchSelectedSolver;
    sol.stats.autoSwitchSwitched = stats.autoSwitchSwitched;
    sol.stats.autoSwitchReason = stats.autoSwitchReason;
    sol.stats.autoSwitchLastReason = stats.autoSwitchLastReason;
    sol.stats.autoSwitchMode = stats.autoSwitchMode;
    sol.stats.autoSwitchSwitchTime = stats.autoSwitchSwitchTime;
    sol.stats.autoSwitchSwitchCount = stats.autoSwitchSwitchCount;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function obj = odeSelectSolver(obj, solver)
  if nargin < 2
    solver = obj.Solver;
  end
  if isempty(solver)
    solver = 'auto';
  end
  solver = odeSolverName(solver);
  requestedSolver = solver;
  useSundials = odeCanUseSundialsAuto(obj);
  switch solver
    case 'auto'
      if useSundials && strcmp(obj.EquationType, 'fullyimplicit')
        obj.SelectedSolver = 'idas';
      elseif useSundials && ~isempty(obj.MassMatrix)
        obj.SelectedSolver = 'cvodesstiff';
      elseif useSundials
        obj.SelectedSolver = 'cvodesnonstiff';
      elseif strcmp(obj.EquationType, 'fullyimplicit')
        obj.SelectedSolver = 'ode15i';
      elseif ~isempty(obj.MassMatrix)
        obj.SelectedSolver = 'ode15s';
      else
        obj.SelectedSolver = 'ode45';
      end
    case 'autoswitch'
      if strcmp(obj.EquationType, 'fullyimplicit')
        error('Nelson:ode_solvers:autoSwitchingSupportedExplicitOdeProblems', 'Auto-switching is only supported for explicit ODE problems.');
      end
      if ~isempty(obj.MassMatrix)
        error('Nelson:ode_solvers:autoSwitchingMassMatricesNotSupported', 'Auto-switching with mass matrices is not supported yet.');
      end
      obj.SelectedSolver = 'autoswitch';
    case 'stiff'
      if useSundials
        obj.SelectedSolver = 'cvodesstiff';
      else
        obj.SelectedSolver = 'ode15s';
      end
    case 'nonstiff'
      if useSundials
        obj.SelectedSolver = 'cvodesnonstiff';
      else
        obj.SelectedSolver = 'ode45';
      end
    otherwise
      obj.SelectedSolver = solver;
  end
  if strcmp(obj.SelectedSolver, 'autoswitch')
    obj.SolverOptions = odeMakeSolverOptions('ode45');
    obj.SelectedSolver = 'autoswitch';
    obj.Solver = requestedSolver;
    return
  end
  if ~odeIsSolverOptions(obj.SolverOptions) ...
      || ~strcmp(obj.SolverOptions.ID, obj.SelectedSolver)
    obj.SolverOptions = odeMakeSolverOptions(obj.SelectedSolver);
    obj.Solver = requestedSolver;
  end
end
%=============================================================================
function tf = odeCanUseSundialsAuto(obj)
  tf = odeSundialsAvailable();
  if ~tf
    return
  end
  if odeHasDirectSensitivity(obj) || odeHasDelayDefinition(obj.DelayDefinition) ...
      || ~isempty(obj.Jacobian) || ~isempty(obj.NonNegativeVariables)
    tf = false;
    return
  end
  if odeIsSolverOptions(obj.SolverOptions) && isprop(obj.SolverOptions, 'OutputFcn') ...
      && ~isempty(obj.SolverOptions.OutputFcn)
    tf = false;
    return
  end
  if ~isempty(obj.MassMatrix) && strcmp(obj.MassMatrix.Singular, 'yes')
    tf = false;
    return
  end
  if ~isempty(obj.EventDefinition) && odeEventUsesCallback(obj.EventDefinition)
    tf = false;
  end
end
%=============================================================================
function tf = odeHasDirectSensitivity(obj)
  tf = ~isempty(obj.Sensitivity) && ~strcmp(obj.Sensitivity.Method, 'adjoint');
end
%=============================================================================
function tf = odeEventUsesCallback(eventDefinition)
  responses = eventDefinition.Response;
  if ischar(responses) || isstring(responses)
    tf = strcmpi(char(responses), 'callback');
  elseif iscell(responses)
    tf = false;
    for k = 1:numel(responses)
      tf = tf || strcmpi(char(responses{k}), 'callback');
    end
  else
    tf = false;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [odefun, y0, yp0, options, restore] = odeSeparateComplexParts(solver, odefun, y0, yp0, options)
  n = length(y0(:));
  restore = struct('StateSize', n, 'Options', options);
  y0 = odeComplexToRealState(y0);
  yp0 = odeComplexToRealOptionalState(yp0);
  options = odeSeparateComplexOptions(options, n);
  isImplicit = strcmp(solver, 'ode15i') || strcmp(solver, 'idas');
  originalFcn = odefun;
  odefun = @(t, y, varargin) odeSeparatedComplexOdeFcn(originalFcn, n, isImplicit, t, y, varargin{:});
end
%=============================================================================
function options = odeSeparateComplexOptions(options, n)
  options.AbsTol = odeDuplicateStateOption(options.AbsTol, n);
  options.InitialSlope = odeComplexToRealOptionalState(options.InitialSlope);
  options.Mass = odeSeparateComplexMatrixOption(options.Mass, n);
  options.Jacobian = odeSeparateComplexMatrixOption(options.Jacobian, n);
  options.JPattern = odeDuplicatePattern(options.JPattern, n);
  options.MvPattern = odeDuplicatePattern(options.MvPattern, n);
  options.NonNegative = options.NonNegative(:);
  if ~isempty(options.OutputSel)
    originalOutputSel = options.OutputSel(:);
    originalOutputFcn = options.OutputFcn;
    options.OutputFcn = @(t, y, flag, varargin) odeSeparatedComplexOutputFcn(...
      originalOutputFcn, n, originalOutputSel, t, y, flag, varargin{:});
    options.OutputSel = [];
  elseif ~isempty(options.OutputFcn)
    originalOutputFcn = options.OutputFcn;
    options.OutputFcn = @(t, y, flag, varargin) odeSeparatedComplexOutputFcn(...
      originalOutputFcn, n, [], t, y, flag, varargin{:});
  end
  if isfield(options, 'EventDefinitionObject')
    options.EventDefinitionObject = odeSeparateComplexEventObject(options.EventDefinitionObject, n);
  elseif ~isempty(options.Events)
    originalEvents = options.Events;
    options.Events = @(t, y, varargin) odeSeparatedComplexEventFcn(originalEvents, n, t, y, varargin{:});
  end
end
%=============================================================================
function z = odeComplexToRealOptionalState(y)
  if isempty(y)
    z = y;
  else
    z = odeComplexToRealState(y);
  end
end
%=============================================================================
function value = odeDuplicateStateOption(value, n)
  if isempty(value) || isscalar(value)
    return
  end
  value = value(:);
  if length(value) == n
    value = [value; value];
  end
end
%=============================================================================
function value = odeSeparateComplexMatrixOption(value, n)
  if isempty(value)
    return
  end
  if isa(value, 'function_handle')
    originalValue = value;
    value = @(t, y, varargin) odeComplexMatrixBlock(...
      originalValue(t, odeRealToComplexState(y, n), varargin{:}), n);
  else
    value = odeComplexMatrixBlock(value, n);
  end
end
%=============================================================================
function pattern = odeDuplicatePattern(pattern, n)
  if isempty(pattern)
    return
  end
  if isequal(size(pattern), [n n])
    pattern = [pattern pattern; pattern pattern];
  end
end
%=============================================================================
function eventDefinition = odeSeparateComplexEventObject(eventDefinition, n)
  if ~isempty(eventDefinition.EventFcn)
    originalEventFcn = eventDefinition.EventFcn;
    eventDefinition.EventFcn = @(t, y, varargin) odeSeparatedComplexEventFcn(...
      originalEventFcn, n, t, y, varargin{:});
  end
  if ~isempty(eventDefinition.CallbackFcn)
    originalCallback = eventDefinition.CallbackFcn;
    eventDefinition.CallbackFcn = @(t, y, index, varargin) odeSeparatedComplexCallback(...
      originalCallback, n, t, y, index, varargin{:});
  end
end
%=============================================================================
function dy = odeSeparatedComplexOdeFcn(fcn, n, isImplicit, t, y, varargin)
  y = odeRealToComplexState(y, n);
  if isImplicit
    yp = odeRealToComplexState(varargin{1}, n);
    args = [{t, y, yp}, varargin(2:end)];
  else
    args = [{t, y}, varargin];
  end
  dy = feval(fcn, args{:});
  dy = odeComplexToRealState(dy);
end
%=============================================================================
function stop = odeSeparatedComplexOutputFcn(fcn, n, outputSel, t, y, flag, varargin)
  if ~isempty(y)
    y = odeRealToComplexState(y, n);
  end
  if ~isempty(outputSel) && isempty(flag)
    y = y(outputSel, :);
  end
  stop = feval(fcn, t, y, flag, varargin{:});
end
%=============================================================================
function varargout = odeSeparatedComplexEventFcn(fcn, n, t, y, varargin)
  y = odeRealToComplexState(y, n);
  args = {t, y};
  if ~isempty(varargin)
    rest = varargin;
    first = rest{1};
    if isnumeric(first) && size(first, 1) == 2 * n
      rest{1} = odeRealToComplexState(first, n);
    end
    args = [args, rest];
  end
  nin = nargin(fcn);
  if nin >= 0 && nin < length(args)
    args = args(1:nin);
  end
  if nargout == 0
    feval(fcn, args{:});
  else
    [varargout{1:nargout}] = feval(fcn, args{:});
  end
end
%=============================================================================
function varargout = odeSeparatedComplexCallback(fcn, n, t, y, index, varargin)
  y = odeRealToComplexState(y, n);
  nout = nargout;
  if nout <= 0
    feval(fcn, t, y, index, varargin{:});
    varargout = {};
  elseif nout == 1
    varargout{1} = feval(fcn, t, y, index, varargin{:});
  else
    [varargout{1}, eventY] = feval(fcn, t, y, index, varargin{:});
    varargout{2} = odeComplexToRealState(eventY);
  end
end
%=============================================================================
function z = odeComplexToRealState(y)
  y = y(:);
  z = [real(y); imag(y)];
end
%=============================================================================
function y = odeRealToComplexState(z, n)
  y = z(1:n, :) + 1i * z((n + 1):(2 * n), :);
end
%=============================================================================
function block = odeComplexMatrixBlock(value, n)
  if isscalar(value)
    if isreal(value)
      block = value;
    else
      eyeN = eye(n);
      block = [real(value) * eyeN -imag(value) * eyeN; ...
        imag(value) * eyeN real(value) * eyeN];
    end
    return
  end
  block = [real(value) -imag(value); imag(value) real(value)];
end
