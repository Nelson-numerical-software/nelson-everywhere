function value = ltiValidateTextScalar(name, value)
  if isStringScalar(value)
    value = char(value);
  end
  if ~ischar(value) || size(value, 1) ~= 1
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', name);
  end
end
