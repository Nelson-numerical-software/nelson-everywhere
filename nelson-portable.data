%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('expcdf'), 3);
asserts.isequal(nargout('expcdf'), 1);
%=============================================================================
x = [-1 0 0.5 2 Inf];
mu = [1 1 2 3 4];
R = expcdf(x, mu);
REF = [0 0 0.221199216928595 0.486582880967408 1];
asserts.isapprox(R, REF, 1e-12);
%=============================================================================
R = expcdf(x, mu, 'upper');
REF = [1 1 0.778800783071405 0.513417119032592 0];
asserts.isapprox(R, REF, 1e-12);
%=============================================================================
R = expcdf([0 1 2]);
asserts.isapprox(R, [0 0.632120558828558 0.864664716763387], 1e-12);
%=============================================================================
R = expcdf(single(x), single(mu));
asserts.isequal(class(R), 'single');
asserts.isapprox(R, single([0 0 0.221199216928595 0.486582880967408 1]), 1e-6);
%=============================================================================
R = expcdf([NaN 1 1], [1 -1 NaN]);
asserts.istrue(all(isnan(R)));
%=============================================================================
R = expcdf([], []);
asserts.isequal(size(R), [0 0]);
%=============================================================================
asserts.checkerror('expcdf(ones(2), ones(3))', _('Size mismatch on input arguments'));
asserts.checkerror('expcdf(1, 1, ''bad'')', sprintf(_('Invalid %s distribution option.'), 'exponential'));
asserts.checkerror('expcdf({1}, 1)', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('expcdf(1, {1})', sprintf(_('%s must be real numeric.'), 'MU'));
%=============================================================================
asserts.isapprox(expcdf(2, 4), 1 - exp(-0.5), 1e-12);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('expfit'), 5);
asserts.isequal(nargout('expfit'), 2);
%=============================================================================
x = [0.5 1 2 3 5 8];
[PHAT, PCI] = expfit(x);
asserts.isapprox(PHAT, 3.25, 1e-12);
asserts.isapprox(PCI, [1.460097260500232; 7.234107128165739], 1e-12);
%=============================================================================
[PHAT, PCI] = expfit(x, 0.01);
asserts.isapprox(PHAT, 3.25, 1e-12);
asserts.isapprox(PCI, [1.135504546639229; 9.302032326741445], 1e-12);
%=============================================================================
censor = [0 0 0 1 0 1];
freq = [1 2 1 1 2 1];
[PHAT, PCI] = expfit(x, 0.05, censor, freq);
asserts.isapprox(PHAT, 4.25, 1e-12);
asserts.isapprox(PCI, [1.909357956038766; 9.459986244524428], 1e-12);
%=============================================================================
opts = statset('MaxIter', 100, 'TolX', 1e-8);
[PHAT2, PCI2] = expfit(x, [], [], [], opts);
asserts.isapprox(PHAT2, 3.25, 1e-12);
asserts.isapprox(PCI2, [1.460097260500232; 7.234107128165739], 1e-12);
%=============================================================================
xm = [0.5 1; 1 2; 2 3; 3 4; 5 7];
[PHATM, PCIM] = expfit(xm);
asserts.isequal(size(PHATM), [2 1]);
asserts.isapprox(PHATM, [2.3; 3.4], 1e-12);
asserts.isequal(size(PCIM), [2 2]);
asserts.isapprox(PCIM, [0.9573239705065707 1.415174565096670;
                       5.525820059849520 8.168603566734074], 1e-12);
%=============================================================================
[PHAT, PCI] = expfit(single(x));
asserts.isequal(class(PHAT), 'double');
asserts.isequal(class(PCI), 'double');
asserts.isapprox(PHAT, 3.25, 1e-12);
%=============================================================================
[PHAT, PCI] = expfit([1 NaN 3]);
asserts.istrue(isnan(PHAT));
asserts.istrue(all(isnan(PCI(:))));
[PHAT, PCI] = expfit([1 2 3], [], [1 1 1], []);
asserts.istrue(isnan(PHAT));
asserts.istrue(all(isnan(PCI(:))));
[PHAT, PCI] = expfit([1 2 3], [], [], [0 0 0]);
asserts.istrue(isnan(PHAT));
asserts.istrue(all(isnan(PCI(:))));
[PHAT, PCI] = expfit([0 1 2]);
asserts.isapprox(PHAT, 1, 1e-12);
asserts.istrue(all(isfinite(PCI(:))));
%=============================================================================
asserts.checkerror('expfit()', _('Not enough input arguments.'));
asserts.checkerror('expfit([])', _('X must be a nonempty vector or matrix.'));
asserts.checkerror('expfit(ones(1, 1, 2))', _('X must be a nonempty vector or matrix.'));
asserts.checkerror('expfit({1 2 3})', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('expfit([-1 1 2])', sprintf(_('%s must contain nonnegative finite values.'), 'X'));
asserts.checkerror('expfit([1 Inf 2])', sprintf(_('%s must contain nonnegative finite values.'), 'X'));
asserts.checkerror('expfit([1 2 3], {0.05})', sprintf(_('%s must be numeric.'), 'ALPHA'));
asserts.checkerror('expfit([1 2 3], -0.1)', sprintf(_('%s must be a scalar in the range [0,1].'), 'ALPHA'));
asserts.checkerror('expfit([1 2 3], 1.1)', sprintf(_('%s must be a scalar in the range [0,1].'), 'ALPHA'));
asserts.checkerror('expfit([1 2 3], [], [0 2 0])', _('CENSORING must contain 0 or 1 values.'));
asserts.checkerror('expfit([1 2 3], [], [], [1 -1 1])', sprintf(_('%s must contain nonnegative finite values.'), 'FREQ'));
asserts.checkerror('expfit([1 2 3], [], ones(2, 2))', _('Size mismatch on input arguments'));
asserts.checkerror('expfit([1 2 3], [], [], [], 1)', sprintf(_('%s must be a scalar structure.'), 'OPTIONS'));
asserts.checkerror('expfit([1 2 3], [], [], [], statset(''MaxIter'', 0))', sprintf(_('%s must be a positive integer scalar.'), 'OPTIONS MaxIter'));
asserts.checkerror('expfit([1 2 3], [], [], [], statset(''TolX'', 0))', sprintf(_('%s must be a positive scalar.'), 'OPTIONS TolX'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('expinv'), 2);
asserts.isequal(nargout('expinv'), 1);
%=============================================================================
p = [0 0.025 0.5 0.975 1];
mu = [1 1 2 3 4];
R = expinv(p, mu);
REF = [0 0.0253178079842899 1.38629436111989 11.0666383623418 Inf];
asserts.isapprox(R(1:4), REF(1:4), 1e-12);
asserts.istrue(isinf(R(5)) && R(5) > 0);
%=============================================================================
R = expinv([0 0.5 0.975]);
asserts.isapprox(R, [0 0.693147180559945 3.68887945411394], 1e-12);
%=============================================================================
R = expinv(single([0.025 0.5 0.975]), single([1 2 3]));
asserts.isequal(class(R), 'single');
asserts.isapprox(R, single([0.0253178079842899 1.38629436111989 11.0666383623418]), 1e-5);
%=============================================================================
R = expinv([-0.1 1.1 NaN 0 1], 2);
asserts.istrue(all(isnan(R(1:3))));
asserts.isequal(R(4), 0);
asserts.istrue(isinf(R(5)) && R(5) > 0);
%=============================================================================
R = expinv([], []);
asserts.isequal(size(R), [0 0]);
%=============================================================================
asserts.checkerror('expinv(ones(2), ones(3))', _('Size mismatch on input arguments'));
asserts.checkerror('expinv({0.5}, 1)', sprintf(_('%s must be real numeric.'), 'P'));
asserts.checkerror('expinv(0.5, {1})', sprintf(_('%s must be real numeric.'), 'MU'));
%=============================================================================
asserts.isapprox(expinv(1 - exp(-0.5), 4), 2, 1e-12);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('explike'), 4);
asserts.isequal(nargout('explike'), 2);
%=============================================================================
x = [0.5 1 2 3 5 8];
[NLOGL, AVAR] = explike(3.25, x);
asserts.isapprox(NLOGL, 13.07192997804988, 1e-12);
asserts.isapprox(AVAR, 1.760416666666667, 1e-12);
%=============================================================================
censor = [0 0 0 1 0 1];
freq = [1 2 1 1 2 1];
[NLOGL, AVAR] = explike(4.125, x, censor, freq);
asserts.isapprox(NLOGL, 14.68421430053805, 1e-12);
asserts.isapprox(AVAR, 2.673883928571429, 1e-12);
%=============================================================================
[NLOGL, AVAR] = explike(single(2), single([1 2 3]));
asserts.isequal(class(NLOGL), 'double');
asserts.isequal(class(AVAR), 'double');
asserts.isapprox(NLOGL, 5.079441541679836, 1e-12);
asserts.isapprox(AVAR, 1.333333333333333, 1e-12);
%=============================================================================
[NLOGL, AVAR] = explike(0, x);
asserts.istrue(isinf(NLOGL));
asserts.istrue(isnan(AVAR));
[NLOGL, AVAR] = explike(NaN, x);
asserts.istrue(isnan(NLOGL));
asserts.istrue(isnan(AVAR));
[NLOGL, AVAR] = explike(1, [1 NaN 3]);
asserts.istrue(isnan(NLOGL));
asserts.istrue(isnan(AVAR));
%=============================================================================
asserts.checkerror('explike(1)', _('Not enough input arguments.'));
asserts.checkerror('explike({1}, [1 2 3])', sprintf(_('%s must be real numeric.'), 'MU'));
asserts.checkerror('explike(1, {1 2 3})', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('explike(1, [])', sprintf(_('%s must be nonempty.'), 'X'));
asserts.checkerror('explike(1, [-1 1 2])', sprintf(_('%s must contain nonnegative finite values.'), 'X'));
asserts.checkerror('explike(1, [1 Inf 2])', sprintf(_('%s must contain nonnegative finite values.'), 'X'));
asserts.checkerror('explike(1, [1 2 3], [0 2 0])', _('CENSORING must contain 0 or 1 values.'));
asserts.checkerror('explike(1, [1 2 3], [], [1 -1 1])', sprintf(_('%s must contain nonnegative finite values.'), 'FREQ'));
asserts.checkerror('explike(1, [1 2 3], ones(2, 2))', _('Size mismatch on input arguments'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('exppdf'), 2);
asserts.isequal(nargout('exppdf'), 1);
%=============================================================================
x = [-1 0 0.5 2 Inf];
mu = [1 1 2 3 4];
R = exppdf(x, mu);
REF = [0 1 0.389400391535702 0.171139039677531 0];
asserts.isapprox(R, REF, 1e-12);
%=============================================================================
R = exppdf([0 1 2]);
asserts.isapprox(R, [1 0.367879441171442 0.135335283236613], 1e-12);
%=============================================================================
R = exppdf(single(x), single(mu));
asserts.isequal(class(R), 'single');
asserts.isapprox(R, single(REF), 1e-6);
%=============================================================================
R = exppdf([NaN 1 1], [1 -1 NaN]);
asserts.istrue(all(isnan(R)));
%=============================================================================
R = exppdf([], []);
asserts.isequal(size(R), [0 0]);
%=============================================================================
asserts.checkerror('exppdf(ones(2), ones(3))', _('Size mismatch on input arguments'));
asserts.checkerror('exppdf({1}, 1)', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('exppdf(1, {1})', sprintf(_('%s must be real numeric.'), 'MU'));
%=============================================================================
asserts.isapprox(exppdf(2, 4), exp(-0.5) / 4, 1e-12);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('exprnd'), -1);
asserts.isequal(nargout('exprnd'), 1);
%=============================================================================
rng(0);
R = exprnd(2, 2, 3);
REF = [3.371813962263367 0.2716092432909177 2.001298060376156;
       4.724499014771342 4.892353409599266 0.2052627197195187];
asserts.isapprox(R, REF, 1e-14);
%=============================================================================
rng(0);
U = rand(2, 4);
E = -2 .* log1p(-U);
rng(0);
R = exprnd(2, 2, 4);
asserts.isequal(size(R), [2 4]);
asserts.isapprox(R, E, 1e-14);
%=============================================================================
rng(0);
U = rand(1, 3);
E = -[1 2 3] .* log1p(-U);
rng(0);
R = exprnd([1 2 3]);
asserts.isapprox(R, E, 1e-14);
%=============================================================================
rng(0);
U = rand(2, 3, 'single');
E = -single(2) .* log1p(-U);
rng(0);
R = exprnd(single(2), [2 3]);
asserts.isequal(class(R), 'single');
asserts.isapprox(double(R), double(E), 1e-6);
%=============================================================================
R = exprnd(0, [1 3]);
asserts.istrue(all(isnan(R)));
R = exprnd(-1, [1 3]);
asserts.istrue(all(isnan(R)));
R = exprnd(NaN, [1 3]);
asserts.istrue(all(isnan(R)));
%=============================================================================
R = exprnd(1, 0, 3);
asserts.isequal(size(R), [0 3]);
R = exprnd(single(1), [2 0 3]);
asserts.isequal(class(R), 'single');
asserts.isequal(size(R), [2 0 3]);
R = exprnd(1, -1, 3);
asserts.isequal(size(R), [0 3]);
%=============================================================================
asserts.checkerror('exprnd([1 2], 2, 2)', _('Size mismatch on input arguments'));
asserts.checkerror('exprnd(1, 1.5, 2)', _('Size must contain integer values.'));
asserts.checkerror('exprnd(1, Inf, 2)', _('Size must contain integer values.'));
asserts.checkerror('exprnd({1})', sprintf(_('%s must be real numeric.'), 'MU'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('expstat'), 1);
asserts.isequal(nargout('expstat'), 2);
%=============================================================================
[m, v] = expstat(3);
asserts.isequal(m, 3);
asserts.isequal(v, 9);
%=============================================================================
[m, v] = expstat([1 2 3 Inf]);
asserts.isapprox(m(1:3), [1 2 3], 1e-15);
asserts.isapprox(v(1:3), [1 4 9], 1e-15);
asserts.istrue(isinf(m(4)) && m(4) > 0);
asserts.istrue(isinf(v(4)) && v(4) > 0);
%=============================================================================
[m, v] = expstat(single([1 2 3]));
asserts.isequal(class(m), 'single');
asserts.isequal(class(v), 'single');
asserts.isapprox(double(m), [1 2 3], 1e-7);
asserts.isapprox(double(v), [1 4 9], 1e-6);
%=============================================================================
[m, v] = expstat([0 -1 NaN]);
asserts.istrue(all(isnan(m)));
asserts.istrue(all(isnan(v)));
%=============================================================================
[m, v] = expstat([]);
asserts.isequal(size(m), [0 0]);
asserts.isequal(size(v), [0 0]);
%=============================================================================
asserts.checkerror('expstat({1})', sprintf(_('%s must be real numeric.'), 'MU'));
%=============================================================================
[expMean, expVariance] = expstat(4);
asserts.isequal(expMean, 4);
asserts.isequal(expVariance, 16);
