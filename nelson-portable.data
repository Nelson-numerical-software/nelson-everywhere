%=============================================================================
function varargout = xlabel(varargin)
  nargoutchk(0, 1);
  if (nargin < 1)
    error('Nelson:notEnoughInputs', 'Not enough input arguments.');
  end
  inputArguments = convertStringToCharArgs(varargin);
  if (isscalar(inputArguments{1}) && isgraphics(inputArguments{1}, 'tiledlayout'))
    t = inputArguments{1};
    inputArguments = inputArguments(2:end);
    h = t.XLabel;
    set(h, 'String', inputArguments{1}, ...
      'HorizontalAlignment', 'center', ...
      'VerticalAlignment', 'top', ...
      inputArguments{2:end});
    if nargout == 1
      varargout{1} = h;
    end
    return;
  elseif (isscalar(inputArguments{1}) && (isgraphics(inputArguments{1}, 'axes') || isgraphics(inputArguments{1}, 'hggroup')))
    ax = inputArguments{1};
    inputArguments = inputArguments(2:end);
  else
    ax = gca();
  end
  % Label stays visible independently of the axes 'Visible' state.
  visibility = 'on';
  h = ax.XLabel;
  if ~(isscalar(h) && isgraphics(h, 'text'))
    h = __text__('Parent', ax, 'AutoParent', 'off');
  end
  if isEmptyTextString(h.String)
    % Rotation and alignment are owned by the axes and re-derived from the View
    % (auto RotationMode semantics), so they update when the view changes.
    set(h, ...
      'Parent', ax, ...
      'AffectAutoLimits', 'off', ...
      'Visible', visibility);
  end
  ax.XLabel = h;
  removeChild(ax, h);
  set(h, 'String', inputArguments{1}, inputArguments{2:end});
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function removeChild(parent, h)
  if ~isgraphics(h)
    return;
  end
  children = allchild(parent);
  if ~isempty(children)
    children(children == h) = [];
    parent.Children = children;
  end
end
%=============================================================================
function tf = isEmptyTextString(value)
  tf = length(value) == 0 || strcmp(value, '');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = xlim(varargin)
  narginchk(0, 2);
  nargoutchk(0, 1);
  value = [];
  if nargin == 0
    ax = gca();
    varargout{1} = ax.XLim;
    return
  end
  if nargin == 1
    if isgraphics(varargin{1})
      ax = varargin{1};
      varargout{1} = ax.XLim;
      return
    else
      if ischar(varargin{1})
        if (strcmp(varargin{1}, 'mode'))
          res = xlim(gca(), varargin{1});
          varargout{1} = res;
          return;
        end
        if (strcmp(varargin{1}, 'method'))
          res = xlim(gca(), varargin{1});
          varargout{1} = res;
          return;
        end
        if (strcmp(varargin{1}, 'auto'))
          xlim(gca(), varargin{1});
          return;
        end
        if (strcmp(varargin{1}, 'manual'))
          xlim(gca(), varargin{1});
          return;
        end
        if (isLimitMethod(varargin{1}))
          xlim(gca(), varargin{1});
          return;
        end
        error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
      else
        ax = gca();
        value = varargin{1};
      end
    end
  else
    % nargin == 2
    ax = varargin{1};
    if ~isgraphics(ax, 'axes')
      error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
    end
    value = varargin{2};
  end
  if ischar(value)
    if (strcmp(value, 'mode'))
      res = ax.XLimMode;
      varargout{1} = res;
      return;
    end
    if (strcmp(value, 'method'))
      res = ax.XLimitMethod;
      varargout{1} = res;
      return;
    end
    if (strcmp(value, 'auto'))
      ax.XLimMode = 'auto';
      if nargout == 1
        error('Nelson:graphics:invalidOutputArgument', 'Invalid output argument.');
      end
      return;
    end
    if (strcmp(value, 'manual'))
      ax.XLimMode = 'manual';
      if nargout == 1
        error('Nelson:graphics:invalidOutputArgument', 'Invalid output argument.');
      end
      return;
    end
    if (isLimitMethod(value))
      ax.XLimitMethod = value;
      ax.XLimMode = 'auto';
      if nargout == 1
        error('Nelson:graphics:invalidOutputArgument', 'Invalid output argument.');
      end
      return;
    end
    error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
  else if (isnumeric(value) && numel(value) == 2)
      ax.XLim = value;
    else
      error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
    end
    if nargout == 1
      error('Nelson:graphics:invalidOutputArgument', 'Invalid output argument.');
    end
  end
end
%=============================================================================
function tf = isLimitMethod(value)
  tf = strcmp(value, 'tickaligned') || strcmp(value, 'tight') || strcmp(value, 'padded');
end
