%=============================================================================
function __check_class_names__(observed, requested, requireSameLength)
  if isequal(observed, requested)
    return
  end
  if requireSameLength && length(requested) ~= length(observed)
    error('Nelson:statistics:classNamesIncludeAllObservedClasses', 'ClassNames must include all observed classes.');
  end
  loc = __class_locations__(observed, requested);
  if any(loc == 0)
    error('Nelson:statistics:classNamesIncludeAllObservedClasses', 'ClassNames must include all observed classes.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function loc = __class_locations__(values, requested)
  loc = zeros(length(values), 1);
  for k = 1:length(values)
    for j = 1:length(requested)
      if isequal(values(k), requested(j))
        loc(k) = j;
        break
      end
      if iscell(values) && iscell(requested) && strcmp(values{k}, requested{j})
        loc(k) = j;
        break
      end
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function value = __class_names__(value, observed)
  if ~isvector(value)
    error('Nelson:statistics:classNamesVectorClassLabels', 'ClassNames must be a vector of class labels.');
  end
  if isnumeric(observed)
    if ~(isnumeric(value) && isreal(value))
      error('Nelson:statistics:classNamesMatchClassLabelType', 'ClassNames must match the class label type.');
    end
    value = value(:);
  elseif islogical(observed)
    if ~islogical(value)
      error('Nelson:statistics:classNamesMatchClassLabelType', 'ClassNames must match the class label type.');
    end
    value = value(:);
  elseif isstring(observed)
    value = string(value(:));
  elseif iscategorical(observed)
    value = categorical(value);
    value = value(:);
  elseif iscellstr(observed)
    if ~(iscellstr(value) || isstring(value))
      error('Nelson:statistics:classNamesMatchClassLabelType', 'ClassNames must match the class label type.');
    end
    value = cellstr(value(:));
  else
    error('Nelson:statistics:classNamesMatchClassLabelType', 'ClassNames must match the class label type.');
  end
  if length(unique(value)) ~= length(value)
    error('Nelson:statistics:classNamesContainUniqueLabels', 'ClassNames must contain unique labels.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [X, yIndex, classNames, Yclean] = __classification_training_data__(X, Y, varargin)
  exactClasses = [];
  if nargin > 2
    exactClasses = varargin{1};
  end
  if ~(isnumeric(X) && isreal(X) && ismatrix(X) && ~issparse(X))
    error('Nelson:statistics:xRealNumericMatrix', '%s must be a real numeric matrix.', 'X');
  end
  X = double(X);
  if isempty(X) || size(X, 2) == 0
    error('Nelson:statistics:xObservationAndPredictor', 'X must contain at least one observation and one predictor.');
  end
  if any(~isfinite(X(:)))
    error('Nelson:statistics:xMustBeFinite', '%s must contain finite values.', 'X');
  end
  if ~isvector(Y) || length(Y) ~= size(X, 1)
    error('Nelson:statistics:yVectorOneLabelRow', 'Y must be a vector with one %s per row of X.', 'label');
  end
  [yIndex, ~, classNames] = grp2idx(Y(:));
  yIndex = double(yIndex(:));
  keep = ~isnan(yIndex);
  X = X(keep, :);
  yIndex = yIndex(keep);
  if isempty(yIndex) || length(unique(yIndex)) < 2
    error('Nelson:statistics:yContainLeastTwoClasses', 'Y must contain at least two classes.');
  end
  if ~isempty(exactClasses) && length(unique(yIndex)) ~= exactClasses
    error('Nelson:statistics:yContainExactlyTwoClasses', 'Y must contain exactly two classes.');
  end
  if nargout > 3
    Yclean = __labels_from_class_index__(classNames, yIndex, length(yIndex));
  end
end
