    function varargout = bounds(A, varargin)
      [varargout{1:nargout}] = table.applyReduceMulti(A, @bounds, 'bounds', max(nargout, 1), varargin{:});
    end

    function R = cumsum(A, varargin)
      R = table.applyMapWithArgs(A, @cumsum, 'cumsum', varargin{:});
