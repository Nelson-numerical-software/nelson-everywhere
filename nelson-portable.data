      "render": {
        "type": "image",
        "src": "PlanarVelocitySensor.svg"
      },
      "help": "Absolute velocity of the frame-a point along the chosen axis (x, y) or the angular velocity (omega)."
    },
    {
      "type": "PlanarAccelerationSensor",
      "label": "PlanarAccelerationSensor",
      "acausal": true,
      "domain": "planar",
      "width": 90,
      "height": 70,
      "physicalPins": [
        {
          "name": "a",
          "x": 0,
          "y": 35,
