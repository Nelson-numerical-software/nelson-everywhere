% LICENCE_BLOCK_END
%=============================================================================
function shading(varargin)
  nargoutchk(0, 0);
  inputArguments = convertStringToCharArgs(varargin);
  if isempty(inputArguments)
    error('Nelson:notEnoughInputs', 'Not enough input arguments.');
  end
  if isscalar(inputArguments{1}) && isgraphics(inputArguments{1}, 'axes')
    ax = inputArguments{1};
    inputArguments = inputArguments(2:end);
  else
    ax = gca();
  end
  if length(inputArguments) ~= 1 || ~ischar(inputArguments{1})
    error('Nelson:shading:shadingModeExpected', 'A shading mode expected.');
  end
  mode = lower(inputArguments{1});
  h = surfacePatchChildren(ax);
  if isempty(h)
    return
  end
  if strcmp(mode, 'faceted')
    set(h, 'FaceColor', 'flat', 'EdgeColor', [0 0 0]);
  elseif strcmp(mode, 'flat')
    set(h, 'FaceColor', 'flat', 'EdgeColor', 'none');
  elseif strcmp(mode, 'interp')
    set(h, 'FaceColor', 'interp', 'EdgeColor', 'none');
  else
    error('Nelson:shading:invalidPropertyValue', 'Illegal selection for property.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = shrinkfaces(varargin)
  narginchk(1, 3);
  nargoutchk(0, 2);
  [faces, vertices, sf, patchHandle] = parseShrinkfacesInputs(varargin);
  [newFaces, newVertices] = shrinkFaceData(faces, vertices, sf);
  if nargout == 0
    if ~isempty(patchHandle)
      patchHandle.Faces = newFaces;
      patchHandle.Vertices = newVertices;
    end
  elseif nargout == 1
    varargout{1} = struct('faces', newFaces, 'vertices', newVertices);
  else
    varargout{1} = newFaces;
    varargout{2} = newVertices;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = slice(varargin)
  narginchk(4, 9);
  nargoutchk(0, 1);
  [parent, x, y, z, V, xs, ys, zs, method] = parseVolumeSliceInputs(varargin);
  ax = graphicsTargetAxes(parent);
  if isempty(parent)
    parent = ax;
  end
  h = volumeSliceSurfaces(parent, x, y, z, V, xs, ys, zs, method, ...
    {'FaceColor', 'flat', 'EdgeColor', graphicsDefaultEdgeColor()});
  applySliceAxes(ax, x, y, z, V);
  if ~isempty(h)
    h(1).UserData = struct('ChartType', 'slice', 'XSlice', xs, 'YSlice', ys, 'ZSlice', zs);
  end
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function applySliceAxes(ax, x, y, z, V)
  ax.XLim = [min(x) max(x)];
  ax.YLim = [min(y) max(y)];
  ax.ZLim = [min(z) max(z)];
  finiteValues = V(isfinite(V));
  if ~isempty(finiteValues)
    limits = [min(finiteValues(:)) max(finiteValues(:))];
    if limits(1) ~= limits(2)
      ax.CLim = limits;
    end
  end
  view(ax, 3);
  grid(ax, 'on');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function W = smooth3(varargin)
  narginchk(1, 4);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [V, method, windowSize, sd] = parseSmooth3Inputs(args);
  W = double(V);
  weights = smooth3KernelWeights(method, windowSize, sd);
  for dim = 1:3
    W = smooth3ApplyWeights(W, weights{dim}, dim);
  end
end
%=============================================================================
%=============================================================================
