% LICENCE_BLOCK_END
function kind = run_accumulator_job_kind(nativeIndex)
  kind = cell(length(nativeIndex), 1);
  for k = 1:length(nativeIndex)
    kind{k} = 'test';
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
