% LICENCE_BLOCK_END
%=============================================================================
function M = mode(A, varargin)
  counts = countcats(A);
  [~, idx] = max(counts);
  M = categorical.fromCodes(idx, A.categoryNames, A.isOrdinal, A.isProtected);
end
