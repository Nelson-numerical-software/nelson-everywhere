%=============================================================================
function y = pinv(varargin)
  narginchk(1, 2);
  nargoutchk(0, 1);
  A = varargin{1};
  if (isempty(A))
    y = A;
    return;
  end
  [U, S, V] = svd(A, 'econ');
  s = diag(S);
  if nargin < 2
    tol = max(size(A)) * eps(norm(s, inf));
  else
    tol = varargin{2};
  end
  r1 = sum(s > tol) + 1;
  V(:, r1:end) = [];
  U(:, r1:end) = [];
  s(r1:end) = [];
  s = 1 ./ s(:);
  y = (V .* s.') * U';
end
