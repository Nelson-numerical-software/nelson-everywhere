classdef ClassificationSVM
  properties
    SupportVectors = zeros(0, 0)
    SupportVectorLabels = []
    Alpha = []
    Bias = 0
    ClassNames = []
    KernelFunction = 'linear'
    KernelScale = 1
    PolynomialOrder = 3
    BoxConstraint = 1
    BoxConstraints = []
    Cost = []
    Standardize = false
    Mu = []
    Sigma = []
    NumObservations = 0
    NumPredictors = 0
    PredictorNames = {}
