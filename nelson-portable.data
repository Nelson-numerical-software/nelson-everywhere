classdef NelsonKSTestCDF
  methods
    function y = cdf(~, x)
      y = 0.2 + 0.3 .* x;
    end
  end
end
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [X, y] = statistics_fitrensemble_fixture()
  X = [0 0; 0 1; 1 0; 1 1; 5 5; 5 6; 6 5; 6 6; 10 0; 10 1; 11 0; 11 1];
  y = [1; 1.2; 1.1; 1.3; 10; 10.2; 10.1; 10.3; 20; 20.2; 20.1; 20.3];
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--WEIGHT 2-->
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('adtest'), -2);
asserts.isequal(nargout('adtest'), 4);
%=============================================================================
[h, p, adstat, cv] = adtest([1 2 3 4 5]);
asserts.isequal(h, false);
asserts.isapprox(p, 0.919582303387710, 1e-12);
asserts.isapprox(adstat, 0.143594203672524, 1e-12);
asserts.isapprox(cv, 0.607414449395958, 1e-12);
%=============================================================================
[h2, p2, adstat2, cv2] = adtest([0.2 0.5 1.2 2.0 3.5], ...
  'Distribution', 'exp');
asserts.isequal(h2, false);
asserts.isapprox(p2, 0.888268211707402, 1e-12);
asserts.isapprox(adstat2, 0.159026908718809, 1e-12);
asserts.isapprox(cv2, cv, 1e-12);
%=============================================================================
[h3, p3, adstat3, cv3] = adtest([-2 -1 0 1 2], ...
  'Distribution', 'ev', 'Alpha', 0.1);
asserts.isequal(h3, true);
asserts.istrue(p3 > 0 && p3 < 1e-8);
asserts.isapprox(adstat3, 3.546888106839127, 1e-12);
asserts.isapprox(cv3, 0.509057049824038, 1e-12);
%=============================================================================
[h4, p4, adstat4, cv4] = adtest([1 2 4 8 16], ...
  'Distribution', 'logn', 'Asymptotic', true);
asserts.isequal(h4, false);
asserts.isapprox(p4, 0.970578723749282, 1e-12);
asserts.isapprox(adstat4, 0.143594203672524, 1e-12);
asserts.isapprox(cv4, 0.753193917250988, 1e-12);
%=============================================================================
[h5, p5, adstat5, cv5] = adtest([1 2 3 5 8], ...
  'Distribution', 'weibull', 'MCTol', 0.01);
asserts.isequal(h5, true);
asserts.istrue(p5 > 0 && p5 < 1e-8);
asserts.isapprox(adstat5, 3.556273795468238, 1e-12);
asserts.isapprox(cv5, cv, 1e-12);
%=============================================================================
[h6, p6, adstat6, cv6] = adtest(single([1 2 NaN 3 4 5]));
asserts.isequal(h6, false);
asserts.isequal(class(p6), 'double');
asserts.isapprox(p6, p, 1e-12);
asserts.isapprox(adstat6, adstat, 1e-12);
asserts.isapprox(cv6, cv, 1e-12);
%=============================================================================
[h7, p7, adstat7, cv7] = adtest([zeros(1, 20) 100]);
asserts.isequal(h7, true);
asserts.istrue(p7 > 0 && p7 < 1e-16);
asserts.isapprox(adstat7, 7.569082917062044, 1e-12);
asserts.isapprox(cv7, 0.723656900888204, 1e-12);
%=============================================================================
asserts.checkerror('adtest()', _('Not enough input arguments.'));
asserts.checkerror('adtest({1})', sprintf(_('%s must be a real numeric vector.'), 'X'));
asserts.checkerror('adtest([1 NaN])', _('X must contain at least three non-NaN observations.'));
asserts.checkerror('adtest([1 2 3], ''Alpha'', 2)', sprintf(_('%s must be a scalar in the range (0,1).'), 'ALPHA'));
asserts.checkerror('adtest([1 2 3], ''Distribution'', ''bad'')', sprintf(_('%s has an unsupported value.'), 'DISTRIBUTION'));
asserts.checkerror('adtest([-1 1 2], ''Distribution'', ''exp'')', _('X must be nonnegative for the exponential distribution.'));
asserts.checkerror('adtest([0 1 2], ''Distribution'', ''logn'')', sprintf(_('X must be positive for the %s distribution.'), 'lognormal'));
asserts.checkerror('adtest([0 1 2], ''Distribution'', ''weibull'')', sprintf(_('X must be positive for the %s distribution.'), 'Weibull'));
asserts.checkerror('adtest([1 2 3], ''MCTol'', 0.01, ''Asymptotic'', true)', _('ASYMPTOTIC must be false when MCTOL is specified.'));
asserts.checkerror('adtest([1 2 3], ''Alpha'')', _('Name-value arguments must be paired.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--WEIGHT 2-->
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('anova1'), 3);
asserts.isequal(nargout('anova1'), 3);
%=============================================================================
X = [6 7 8; 5 7 9; 4 8 NaN; 6 9 10];
[p, tbl, stats] = anova1(X, [], 'off');
asserts.isapprox(p, 0.002471774786825, 1e-12);
asserts.isequal(tbl{1, 1}, 'Source');
asserts.isequal(tbl{1, 6}, 'Prob>F');
asserts.isapprox(tbl{2, 2}, 26.136363636363640, 1e-12);
asserts.isapprox(tbl{3, 2}, 7.500000000000000, 1e-12);
asserts.isapprox(tbl{4, 2}, 33.636363636363626, 1e-12);
asserts.isequal(tbl{2, 3}, 2);
asserts.isequal(tbl{3, 3}, 8);
asserts.isequal(tbl{4, 3}, 10);
asserts.isapprox(tbl{2, 4}, 13.068181818181820, 1e-12);
asserts.isapprox(tbl{3, 4}, 0.937500000000000, 1e-12);
asserts.isapprox(tbl{2, 5}, 13.939393939393941, 1e-12);
asserts.isapprox(tbl{2, 6}, p, 1e-12);
asserts.isequal(tbl{3, 5}, []);
asserts.isequal(tbl{4, 6}, []);
asserts.isequal(stats.gnames, {'1'; '2'; '3'});
asserts.isequal(stats.n, [4 4 3]);
asserts.isapprox(stats.means, [5.250000000000000 7.750000000000000 9.000000000000000], 1e-12);
asserts.isequal(stats.df, 8);
asserts.isapprox(stats.s, 0.968245836551854, 1e-12);
asserts.isequal(stats.source, 'anova1');
%=============================================================================
y = [1 2 3 4 NaN 1.5 2.5 3.5 5 6]';
g = {'b', 'b', 'a', 'a', 'a', 'b', 'b', 'a', 'c', 'c'}';
[p2, tbl2, stats2] = anova1(y, g, 'off');
asserts.isapprox(p2, 0.001146125498384, 1e-12);
asserts.isapprox(tbl2{2, 2}, 19.250000000000000, 1e-12);
asserts.isapprox(tbl2{3, 2}, 2.250000000000000, 1e-12);
asserts.isapprox(tbl2{4, 2}, 21.500000000000000, 1e-12);
asserts.isapprox(tbl2{2, 4}, 9.625000000000000, 1e-12);
asserts.isapprox(tbl2{3, 4}, 0.375000000000000, 1e-12);
asserts.isapprox(tbl2{2, 5}, 25.666666666666668, 1e-12);
asserts.isequal(stats2.gnames, {'a'; 'b'; 'c'});
asserts.isequal(stats2.n, [3 4 2]);
asserts.isapprox(stats2.means, [3.500000000000000 1.750000000000000 5.500000000000000], 1e-12);
%=============================================================================
[p3, tbl3, stats3] = anova1([1 2; 3 NaN; 5 7], {'left', 'right'}, 'off');
asserts.isapprox(p3, 0.574220426452033, 1e-12);
asserts.isequal(stats3.gnames, {'left'; 'right'});
asserts.isequal(stats3.n, [3 2]);
asserts.isapprox(stats3.means, [3.000000000000000 4.500000000000000], 1e-12);
asserts.isapprox(tbl3{2, 5}, 0.395121951219512, 1e-12);
[p3b, ~, stats3b] = anova1([1 2; 3 NaN; 5 7], ['left '; 'right'], 'off');
asserts.isapprox(p3b, p3, 1e-12);
asserts.isequal(stats3b.gnames, {'left'; 'right'});
%=============================================================================
[p4, tbl4, stats4] = anova1(single([1 2 3; 2 4 6; 3 6 9]), [], 'off');
asserts.isequal(class(p4), 'double');
asserts.isapprox(p4, 0.156121984524351, 1e-12);
asserts.isapprox(stats4.s, 2.160246899469287, 1e-12);
asserts.isequal(tbl4{2, 3}, 2);
asserts.isequal(tbl4{3, 3}, 6);
%=============================================================================
[p5, tbl5, stats5] = anova1([1 2; 3 4; 5 7], 'off');
asserts.isapprox(p5, 0.512225258699542, 1e-12);
asserts.isapprox(tbl5{2, 2}, 2.666666666666666, 1e-12);
asserts.isapprox(stats5.means, [3.000000000000000 4.333333333333333], 1e-12);
%=============================================================================
asserts.checkerror('anova1()', _('Not enough input arguments.'));
asserts.checkerror('anova1({1}, [], ''off'')', sprintf(_('%s must be a real numeric vector or matrix.'), 'X'));
asserts.checkerror('anova1([1 2 3], [1 2], ''off'')', _('GROUP must have the expected number of labels.'));
asserts.checkerror('anova1([1 2; 3 4], {''only''}, ''off'')', _('GROUP must have the expected number of labels.'));
asserts.checkerror('anova1([1 2; 3 4], {1}, ''off'')', sprintf(_('%s must be a vector or text array.'), 'GROUP'));
asserts.checkerror('anova1([1 2; 3 4], [], ''bad'')', _('Display option must be ''on'' or ''off''.'));
asserts.checkerror('anova1([1 NaN], [1 2], ''off'')', _('At least two groups with more observations than groups are required.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--WEIGHT 2-->
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('anova2'), 3);
asserts.isequal(nargout('anova2'), 3);
%=============================================================================
Y = [8 9 6; 7 8 5; 9 10 7; 12 14 11; 13 15 12; 11 13 10];
[p, tbl, stats] = anova2(Y, 2, 'off');
asserts.isapprox(p, [0.047926866824987 0.002089444381749 0.993662524052472], 1e-12);
asserts.isequal(tbl{1, 1}, 'Source');
asserts.isequal(tbl{2, 1}, 'Columns');
asserts.isequal(tbl{3, 1}, 'Rows');
asserts.isequal(tbl{4, 1}, 'Interaction');
asserts.isequal(tbl{5, 1}, 'Error');
asserts.isapprox(tbl{2, 2}, 27.000000000000000, 1e-12);
asserts.isapprox(tbl{3, 2}, 82.333333333333343, 1e-12);
asserts.isapprox(tbl{4, 2}, 0.666666666666667, 1e-12);
asserts.isapprox(tbl{5, 2}, 28.000000000000000, 1e-12);
asserts.isapprox(tbl{6, 2}, 138.000000000000000, 1e-12);
asserts.isequal([tbl{2, 3} tbl{3, 3} tbl{4, 3} tbl{5, 3} tbl{6, 3}], [2 2 4 9 17]);
asserts.isapprox(tbl{2, 4}, 13.500000000000000, 1e-12);
asserts.isapprox(tbl{3, 4}, 41.166666666666671, 1e-12);
asserts.isapprox(tbl{4, 4}, 0.166666666666667, 1e-12);
asserts.isapprox(tbl{5, 4}, 3.111111111111111, 1e-12);
asserts.isapprox(tbl{2, 5}, 4.339285714285714, 1e-12);
asserts.isapprox(tbl{3, 5}, 13.232142857142858, 1e-12);
asserts.isapprox(tbl{4, 5}, 0.053571428571429, 1e-12);
asserts.isequal(stats.source, 'anova2');
asserts.isapprox(stats.rowmeans, [7.166666666666667 10.500000000000000 12.333333333333334], 1e-12);
asserts.isapprox(stats.colmeans(:)', [10.000000000000000 11.500000000000000 8.500000000000000], 1e-12);
asserts.isapprox(stats.cellmeans, [7.500000000000000 8.500000000000000 5.500000000000000; ...
                                  10.500000000000000 12.000000000000000 9.000000000000000; ...
                                  12.000000000000000 14.000000000000000 11.000000000000000], 1e-12);
asserts.isapprox(stats.sigmasq, 3.111111111111111, 1e-12);
asserts.isequal(stats.df, 9);
%=============================================================================
Z = [8 9 6; 7 8 5; 12 14 11; 13 15 12];
[p2, tbl2, stats2] = anova2(Z, 'off');
asserts.isapprox(p2, [4.555393586003209e-05 6.465256112697659e-07], 1e-12);
asserts.isequal(size(tbl2), [5 6]);
asserts.isequal(tbl2{2, 1}, 'Columns');
asserts.isequal(tbl2{3, 1}, 'Rows');
asserts.isequal(tbl2{4, 1}, 'Error');
asserts.isapprox(tbl2{2, 2}, 18.000000000000000, 1e-12);
asserts.isapprox(tbl2{3, 2}, 99.333333333333343, 1e-12);
asserts.isapprox(tbl2{4, 2}, 0.666666666666657, 1e-12);
asserts.isapprox(tbl2{5, 2}, 118.000000000000000, 1e-12);
asserts.isequal([tbl2{2, 3} tbl2{3, 3} tbl2{4, 3} tbl2{5, 3}], [2 3 6 11]);
asserts.isapprox(tbl2{2, 5}, 81.000000000001151, 1e-10);
asserts.isapprox(tbl2{3, 5}, 298.000000000004263, 1e-10);
asserts.isapprox(stats2.rowmeans, [7.666666666666667 6.666666666666667 ...
                                  12.333333333333334 13.333333333333334], 1e-12);
asserts.isapprox(stats2.colmeans(:)', [10.000000000000000 11.500000000000000 8.500000000000000], 1e-12);
asserts.isequal(stats2.cellmeans, []);
asserts.isapprox(stats2.sigmasq, 0.111111111111110, 1e-12);
%=============================================================================
[ps, tbls, statss] = anova2(single(Y), 2, 'off');
asserts.isequal(class(ps), 'double');
asserts.isapprox(ps, p, 1e-12);
asserts.isapprox(tbls{5, 4}, tbl{5, 4}, 1e-12);
asserts.isapprox(statss.cellmeans, stats.cellmeans, 1e-12);
%=============================================================================
asserts.checkerror('anova2()', _('Not enough input arguments.'));
asserts.checkerror('anova2({1}, 1, ''off'')', sprintf(_('%s must be a real numeric matrix.'), 'Y'));
asserts.checkerror('anova2([1 2 3], 1, ''off'')', sprintf(_('%s must have at least two rows and two columns.'), 'Y'));
asserts.checkerror('anova2([1 2; 3 Inf], 1, ''off'')', _('Y must contain finite observations.'));
asserts.checkerror('anova2([1 2; 3 NaN], 1, ''off'')', _('Y must contain finite observations.'));
asserts.checkerror('anova2([1 2; 3 4], 0, ''off'')', sprintf(_('%s must be a positive integer scalar.'), 'REPS'));
asserts.checkerror('anova2([1 2; 3 4; 5 6], 2, ''off'')', sprintf(_('%s must be a multiple of REPS.'), 'The number of rows in Y'));
asserts.checkerror('anova2([1 2; 3 4], 2, ''off'')', _('Y must contain at least two row-factor levels.'));
asserts.checkerror('anova2([1 2; 3 4], 1, ''bad'')', _('Display option must be ''on'' or ''off''.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--WEIGHT 2-->
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('ansaribradley'), -3);
asserts.isequal(nargout('ansaribradley'), 3);
%=============================================================================
[h, p, stats] = ansaribradley([1 2 9 10], [4 5 6 7]);
asserts.isequal(h, true);
asserts.isapprox(p, 0.028571428571429, 1e-12);
asserts.isequal(stats.W, 6);
asserts.isapprox(stats.Wstar, -2.366431913239846, 1e-12);
%=============================================================================
[h2, p2, stats2] = ansaribradley([1 2 9 10], [4 5 6 7], ...
  'Tail', 'right', 'Alpha', 0.2);
asserts.isequal(h2, true);
asserts.isapprox(p2, 0.014285714285714, 1e-12);
asserts.isequal(stats2.W, 6);
asserts.isapprox(stats2.Wstar, stats.Wstar, 1e-12);
%=============================================================================
[h3, p3, stats3] = ansaribradley(1:10, (1:10) + 0.1, 'Method', 'approximate');
asserts.isequal(h3, false);
asserts.isequal(p3, 1);
asserts.isequal(stats3.W, 55);
asserts.isequal(stats3.Wstar, 0);
%=============================================================================
X = [1 2; 3 4; 9 6; 10 8];
Y = [4 1; 5 3; 6 9; 7 10];
[h4, p4, stats4] = ansaribradley(X, Y, 'Dim', 1);
asserts.isequal(h4, [true false]);
asserts.isapprox(p4, [0.028571428571429 0.142857142857143], 1e-12);
asserts.isequal(stats4.W, [6 13]);
asserts.isapprox(stats4.Wstar, [-2.366431913239846 1.774823934929885], 1e-12);
%=============================================================================
[hs, ps, statss] = ansaribradley(single([1 2 9 10]), single([4 5 6 7]));
asserts.isequal(hs, true);
asserts.isequal(class(ps), 'double');
asserts.isapprox(ps, p, 1e-12);
asserts.isequal(statss.W, stats.W);
%=============================================================================
asserts.checkerror('ansaribradley([1 2])', _('Not enough input arguments.'));
asserts.checkerror('ansaribradley({1}, [1])', sprintf(_('%s must be a real numeric array.'), 'X'));
asserts.checkerror('ansaribradley([1], {1})', sprintf(_('%s must be a real numeric array.'), 'Y'));
asserts.checkerror('ansaribradley([NaN], [1])', sprintf(_('%s must contain at least one non-NaN observation.'), 'X and Y'));
asserts.checkerror('ansaribradley(ones(2,2), ones(3,3))', sprintf(_('X and Y must have %s.'), 'compatible sizes outside the test dimension'));
asserts.checkerror('ansaribradley([1], [2], ''Alpha'')', _('Name-value arguments must be paired.'));
asserts.checkerror('ansaribradley([1], [2], ''Unknown'', 1)', _('Invalid name-value argument name.'));
asserts.checkerror('ansaribradley([1], [2], ''Unknown'', 1)', _('Invalid name-value argument name.'), 'Nelson:statistics:unknownNameValue');
asserts.checkerror('ansaribradley([1], [2], ''Alpha'', 2)', sprintf(_('%s must be a scalar in the range (0,1).'), 'ALPHA'));
asserts.checkerror('ansaribradley([1], [2], ''Tail'', ''bad'')', sprintf(_('%s has an unsupported value.'), 'TAIL'));
asserts.checkerror('ansaribradley([1], [2], ''Method'', ''bad'')', sprintf(_('%s has an unsupported value.'), 'METHOD'));
asserts.checkerror('ansaribradley([1 1], [2 2], ''Method'', ''exact'')', _('Exact method is not supported when ties are present.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('betacdf'), 4);
asserts.isequal(nargout('betacdf'), 1);
%=============================================================================
x = [0 0.1 0.5 0.9 1];
a = [0.5 1 2 5 2];
b = [2 3 2 1 0.5];
R = betacdf(x, a, b);
REF = [0 0.271 0.5 0.59049 1];
asserts.isapprox(R, REF, 1e-12);
%=============================================================================
R = betacdf(x, a, b, 'upper');
REF = [1 0.729 0.5 0.40951 0];
asserts.isapprox(R, REF, 1e-12);
%=============================================================================
R = betacdf(single(x), single(a), single(b));
asserts.isequal(class(R), 'single');
asserts.isapprox(R, single([0 0.271 0.5 0.59049 1]), 1e-6);
%=============================================================================
R = betacdf([-1 2 NaN 0.5 0.5], [2 2 2 -1 2], [2 2 2 2 NaN]);
asserts.isequal(R(1), 0);
asserts.isequal(R(2), 1);
asserts.istrue(all(isnan(R(3:5))));
%=============================================================================
R = betacdf([], [], []);
asserts.isequal(size(R), [0 0]);
%=============================================================================
asserts.checkerror('betacdf(ones(2), ones(3), 1)', _('Size mismatch on input arguments'));
asserts.checkerror('betacdf(1, 2, 1, ''bad'')', sprintf(_('Invalid %s distribution option.'), 'beta'));
asserts.checkerror('betacdf({1}, 2, 1)', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('betacdf(1, {2}, 1)', sprintf(_('%s must be real numeric.'), 'A'));
asserts.checkerror('betacdf(1, 2, {1})', sprintf(_('%s must be real numeric.'), 'B'));
%=============================================================================
asserts.isapprox(betacdf(0.5, 2, 2), 0.5, 1e-12);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('betafit'), 2);
asserts.isequal(nargout('betafit'), 2);
%=============================================================================
x = [0.12 0.2 0.35 0.5 0.7 0.85];
[PHAT, PCI] = betafit(x);
asserts.isapprox(PHAT, [1.454428030863046 1.726016528287111], 1e-12);
asserts.isapprox(PCI, [0.5067427948095659 0.5856340607364172;
                      4.174427182048263 5.087021496280666], 1e-12);
%=============================================================================
[PHAT, PCI] = betafit(x, 0.01);
asserts.isapprox(PHAT, [1.454428030863046 1.726016528287111], 1e-12);
asserts.isapprox(PCI, [0.3638341935188416 0.4169887190901191;
                      5.814079420357204 7.144397245136134], 1e-12);
%=============================================================================
xm = [0.1 0.2; 0.2 0.35; 0.4 0.55; 0.65 0.75; 0.85 0.9];
[PHATM, PCIM] = betafit(xm);
asserts.isequal(size(PHATM), [2 2]);
asserts.isapprox(PHATM, [1.210569072748261 1.516000289787297;
                        1.811987026844903 1.457046571880519], 1e-12);
asserts.isequal(size(PCIM), [2 2 2]);
asserts.isapprox(PCIM(:, :, 1), [0.3866968576775351 0.5517338703873901;
                                3.789732062205271 5.950870812315589], 1e-12);
asserts.isapprox(PCIM(:, :, 2), [0.4639236934118748 0.4600587444659575;
                                4.953954521556974 4.614594849388551], 1e-12);
%=============================================================================
[PHAT, PCI] = betafit(single(x));
asserts.isequal(class(PHAT), 'double');
asserts.isequal(class(PCI), 'double');
asserts.isapprox(PHAT, [1.454428030863046 1.726016528287111], 1e-6);
%=============================================================================
[PHAT, PCI] = betafit([0.4 NaN 0.6]);
asserts.istrue(all(isnan(PHAT)));
asserts.istrue(all(isnan(PCI(:))));
%=============================================================================
asserts.checkerror('betafit()', _('Not enough input arguments.'));
asserts.checkerror('betafit([])', _('X must be a nonempty vector or matrix.'));
asserts.checkerror('betafit([])', _('X must be a nonempty vector or matrix.'), 'Nelson:statistics:xMustBeNonemptyVectorOrMatrix');
asserts.checkerror('betafit(ones(1, 1, 2))', _('X must be a nonempty vector or matrix.'));
asserts.checkerror('betafit({0.2 0.5})', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('betafit([0 0.2 0.5])', _('X must contain finite values in the open interval (0,1).'));
asserts.checkerror('betafit([0.2 0.5 1])', _('X must contain finite values in the open interval (0,1).'));
asserts.checkerror('betafit([0.2 Inf 0.5])', _('X must contain finite values in the open interval (0,1).'));
asserts.checkerror('betafit([0.2 0.5], {0.05})', sprintf(_('%s must be numeric.'), 'ALPHA'));
asserts.checkerror('betafit([0.2 0.5], -0.1)', sprintf(_('%s must be a scalar in the range [0,1].'), 'ALPHA'));
asserts.checkerror('betafit([0.2 0.5], 1.1)', sprintf(_('%s must be a scalar in the range [0,1].'), 'ALPHA'));
%=============================================================================%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('betainv'), 3);
asserts.isequal(nargout('betainv'), 1);
%=============================================================================
p = [0 0.025 0.5 0.975 1];
a = [0.5 1 2 5 2];
b = [2 3 2 1 0.5];
R = betainv(p, a, b);
REF = [0 0.00840375865961264 0.5 0.994949236620532 1];
asserts.isapprox(R, REF, 1e-12);
%=============================================================================
R = betainv(single([0.025 0.5 0.975]), single([1 2 5]), single([3 2 1]));
asserts.isequal(class(R), 'single');
asserts.isapprox(R, single([0.00840375865961264 0.5 0.994949236620532]), 1e-6);
%=============================================================================
R = betainv([-0.1 1.1 NaN 0 1], 2, 2);
asserts.istrue(all(isnan(R(1:3))));
asserts.isequal(R(4), 0);
asserts.isequal(R(5), 1);
%=============================================================================
R = betainv([], [], []);
asserts.isequal(size(R), [0 0]);
%=============================================================================
asserts.checkerror('betainv(ones(2), ones(3), 1)', _('Size mismatch on input arguments'));
asserts.checkerror('betainv({0.5}, 2, 1)', sprintf(_('%s must be real numeric.'), 'P'));
asserts.checkerror('betainv(0.5, {2}, 1)', sprintf(_('%s must be real numeric.'), 'A'));
asserts.checkerror('betainv(0.5, 2, {1})', sprintf(_('%s must be real numeric.'), 'B'));
%=============================================================================
asserts.isapprox(betainv(0.5, 2, 2), 0.5, 1e-12);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('betalike'), 2);
asserts.isequal(nargout('betalike'), 2);
%=============================================================================
x = [0.12 0.2 0.35 0.5 0.7 0.85];
[NLOGL, AVAR] = betalike([1.5 1.8], x);
asserts.isapprox(NLOGL, -0.4170559701508001, 1e-12);
asserts.isapprox(AVAR, [0.6525003012710696 0.6015028591774459;
                       0.6015028591774459 0.9891159349410579], 1e-12);
%=============================================================================
[NLOGL, AVAR] = betalike(single([1.5 1.8]), single([0.2 0.4 0.6]));
asserts.isequal(class(NLOGL), 'double');
asserts.isequal(class(AVAR), 'double');
asserts.isapprox(NLOGL, -0.6984089533169221, 1e-12);
asserts.isapprox(AVAR, [1.305000605439844 1.203005681254352;
                       1.203005681254352 1.978231755770069], 1e-12);
%=============================================================================
[NLOGL, AVAR] = betalike([0 1], x);
asserts.istrue(isinf(NLOGL));
asserts.istrue(all(isnan(AVAR(:))));
[NLOGL, AVAR] = betalike([NaN 1], x);
asserts.istrue(isnan(NLOGL));
asserts.istrue(all(isnan(AVAR(:))));
[NLOGL, AVAR] = betalike([1 1], [0.2 NaN 0.6]);
asserts.istrue(isnan(NLOGL));
asserts.istrue(all(isnan(AVAR(:))));
%=============================================================================
asserts.checkerror('betalike([1 2])', _('Not enough input arguments.'));
asserts.checkerror('betalike({1 2}, [0.2 0.5])', sprintf(_('PARAMS must be a %s vector.'), 'two-element real numeric'));
asserts.checkerror('betalike([1 2 3], [0.2 0.5])', sprintf(_('PARAMS must be a %s vector.'), 'two-element real numeric'));
asserts.checkerror('betalike([1 2], {0.2 0.5})', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('betalike([1 2], [])', sprintf(_('%s must be nonempty.'), 'X'));
asserts.checkerror('betalike([1 2], [])', sprintf(_('%s must be nonempty.'), 'X'), 'Nelson:validators:mustBeNonempty');
asserts.checkerror('betalike([1 2], [0 0.2])', _('X must contain finite values in the open interval (0,1).'));
asserts.checkerror('betalike([1 2], [0.2 1])', _('X must contain finite values in the open interval (0,1).'));
asserts.checkerror('betalike([1 2], [0.2 Inf])', _('X must contain finite values in the open interval (0,1).'));
%=============================================================================%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('betapdf'), 3);
asserts.isequal(nargout('betapdf'), 1);
%=============================================================================
x = [0 0.1 0.5 0.9 1];
a = [0.5 1 2 5 2];
b = [2 3 2 1 0.5];
R = betapdf(x, a, b);
REF = [Inf 2.43 1.5 3.2805 Inf];
asserts.istrue(isinf(R(1)) && R(1) > 0);
asserts.isapprox(R(2:4), REF(2:4), 1e-12);
asserts.istrue(isinf(R(5)) && R(5) > 0);
%=============================================================================
R = betapdf([0 1 0.5], [1 2 2], [3 1 2]);
asserts.isapprox(R, [3 2 1.5], 1e-12);
%=============================================================================
R = betapdf(single(x), single(a), single(b));
asserts.isequal(class(R), 'single');
asserts.istrue(isinf(R(1)) && R(1) > 0);
asserts.isapprox(R(2:4), single([2.43 1.5 3.2805]), 1e-6);
asserts.istrue(isinf(R(5)) && R(5) > 0);
%=============================================================================
R = betapdf([-1 2 NaN 0.5 0.5], [2 2 2 -1 2], [2 2 2 2 NaN]);
asserts.isequal(R(1), 0);
asserts.isequal(R(2), 0);
asserts.istrue(all(isnan(R(3:5))));
%=============================================================================
R = betapdf([], [], []);
asserts.isequal(size(R), [0 0]);
%=============================================================================
asserts.checkerror('betapdf(ones(2), ones(3), 1)', _('Size mismatch on input arguments'));
asserts.checkerror('betapdf({1}, 2, 1)', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('betapdf(1, {2}, 1)', sprintf(_('%s must be real numeric.'), 'A'));
asserts.checkerror('betapdf(1, 2, {1})', sprintf(_('%s must be real numeric.'), 'B'));
%=============================================================================
asserts.isapprox(betapdf(0.5, 2, 2), 1.5, 1e-12);
asserts.istrue(isnan(betapdf(0.5, -1, 2)));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('betarnd'), -1);
asserts.isequal(nargout('betarnd'), 1);
%=============================================================================
rng(0, 'twister');
R = betarnd(2, 5, 2, 3);
REF = [0.4331491952906957 0.1063543321687892 0.3250939404965425;
       0.5170351491539715 0.5262909727485290 0.09128371257013587];
asserts.isapprox(R, REF, 1e-13);
%=============================================================================
rng(0, 'twister');
U = rand(2, 3);
E = betainv(U, 2, 5);
rng(0, 'twister');
R = betarnd(2, 5, 2, 3);
asserts.isequal(size(R), [2 3]);
asserts.isapprox(R, E, 1e-12);
%=============================================================================
rng(0, 'twister');
U = rand(1, 3);
E = betainv(U, [1 2 3], [4 5 6]);
rng(0, 'twister');
R = betarnd([1 2 3], [4 5 6]);
asserts.isapprox(R, E, 1e-12);
%=============================================================================
rng(0, 'twister');
R = betarnd(single(2), single(5), [2 3]);
asserts.isequal(class(R), 'single');
asserts.isequal(size(R), [2 3]);
R = betarnd(2, 5, single([2 3]));
asserts.isequal(class(R), 'double');
asserts.isequal(size(R), [2 3]);
%=============================================================================
R = betarnd([0 -1 NaN], [5 5 5], [1 3]);
asserts.istrue(all(isnan(R)));
R = betarnd(2, [0 -1 NaN], [1 3]);
asserts.istrue(all(isnan(R)));
R = betarnd(2, 5, 0, 3);
asserts.isequal(size(R), [0 3]);
R = betarnd(single(2), single(5), [2 0 3]);
asserts.isequal(class(R), 'single');
asserts.isequal(size(R), [2 0 3]);
%=============================================================================
asserts.checkerror('betarnd(1)', _('Not enough input arguments.'));
asserts.checkerror('betarnd([1 2], 1, 2, 2)', _('Size mismatch on input arguments'));
asserts.checkerror('betarnd(1, 1, 1.5, 2)', _('Size must contain integer values.'));
asserts.checkerror('betarnd({1}, 1)', sprintf(_('%s must be real numeric.'), 'A'));
asserts.checkerror('betarnd(1, {1})', sprintf(_('%s must be real numeric.'), 'B'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
