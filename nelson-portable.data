    CutPoint = []
    LeftChild = []
    RightChild = []
    NodeMean = []
    NodeError = []
    NodeSize = []
    IsBranch = []
    MaxNumSplits = 0
    MinLeafSize = 1
    MinParentSize = 10
    PredictorNames = {}
