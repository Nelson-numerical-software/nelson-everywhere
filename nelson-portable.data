% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function h = bar3Base(horizontal, varargin)
  args = convertStringToCharArgs(varargin);
  [parent, args] = graphicsParseParent(args);
  [data, rowPositions, args, explicitPositions] = parseBar3Data(args);
  opts = parseBar3Options(args);
  ax = graphicsTargetAxes(parent);
  if isempty(parent)
    parent = ax;
  end
  h = drawBars(parent, ax, data, rowPositions, horizontal, opts);
  applyBar3Axes(ax, data, rowPositions, explicitPositions, horizontal, opts);
end
%=============================================================================
function [data, rowPositions, args, explicitPositions] = parseBar3Data(args)
  if isempty(args) || ~isnumeric(args{1}) || ~isreal(args{1})
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Value');
  end
  explicitPositions = false;
  if numel(args) >= 2 && isExplicitPositionSyntax(args{1}, args{2})
    rowPositions = double(args{1}(:));
    data = double(args{2});
    args = args(3:end);
    explicitPositions = true;
  else
    data = double(args{1});
    args = args(2:end);
  end
  if isvector(data)
    data = data(:);
  end
  if ~exist('rowPositions', 'var')
    rowPositions = (1:size(data, 1)).';
  end
  if numel(rowPositions) ~= size(data, 1)
    error('Nelson:bar3Base:invalidPositionVectorLength', 'Position vector length must match data rows.');
  end
  if any(~isfinite(rowPositions))
    error('Nelson:bar3Base:invalidPositionVector', 'Position vector must contain finite values.');
  end
end
%=============================================================================
function tf = isExplicitPositionSyntax(positions, data)
  tf = isnumeric(data) && isreal(data) && isvector(positions) && ~isscalar(data);
end
%=============================================================================
function opts = parseBar3Options(args)
  opts = struct('BarWidth', 0.8, 'Style', 'detached', 'FaceColor', 'flat', ...
    'EdgeColor', repmat(33 / 255, 1, 3), 'FaceAlpha', 1, 'LineStyle', '-', 'LineWidth', 0.5);
  if ~isempty(args) && isnumeric(args{1}) && isscalar(args{1})
    opts.BarWidth = double(args{1});
    args = args(2:end);
  end
  if ~isempty(args) && isText(args{1})
    value = char(args{1});
    if any(strcmpi(value, {'detached', 'grouped', 'stacked'}))
      opts.Style = lower(value);
      args = args(2:end);
    elseif isColorString(value)
      opts.FaceColor = getColorShortName(value);
      args = args(2:end);
    end
  end
  if rem(length(args), 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  for k = 1:2:length(args)
    name = lower(char(args{k}));
    value = args{k + 1};
    switch name
      case {'barwidth', 'width'}
        opts.BarWidth = double(value);
      case 'facecolor'
        opts.FaceColor = value;
      case 'edgecolor'
        opts.EdgeColor = value;
      case 'facealpha'
        opts.FaceAlpha = double(value);
      case 'linestyle'
        opts.LineStyle = value;
      case 'linewidth'
        opts.LineWidth = double(value);
      otherwise
        error('Nelson:graphics:unsupportedProperty', 'Unsupported "%s" option.', 'bar3');
    end
  end
  if ~isscalar(opts.BarWidth) || ~isfinite(opts.BarWidth) || opts.BarWidth <= 0
    error('Nelson:graphics:mustBePositiveScalar', '%s must be a positive scalar.', 'BarWidth');
  end
end
%=============================================================================
function h = drawBars(parent, ax, data, rowPositions, horizontal, opts)
  [rows, cols] = size(data);
  h = gobjects(1, cols);
  bases = zeros(rows, cols);
  if strcmp(opts.Style, 'stacked')
    bases = stackedBases(data);
  end
  for col = 1:cols
    [xData, yData, zData] = surfaceDataForColumn(data, bases, rowPositions, col, horizontal, opts);
    cData = col * ones(size(zData));
    h(col) = surface('Parent', parent, 'XData', xData, 'YData', yData, ...
      'ZData', zData, 'CData', cData, 'FaceColor', opts.FaceColor, ...
      'EdgeColor', opts.EdgeColor, 'FaceAlpha', opts.FaceAlpha, ...
      'LineStyle', opts.LineStyle, 'LineWidth', opts.LineWidth, ...
      'FaceLighting', 'flat', 'BackFaceLighting', 'reverselit');
  end
end
%=============================================================================
function bases = stackedBases(data)
  [rows, cols] = size(data);
  bases = zeros(rows, cols);
  running = zeros(rows, 1);
  for col = 1:cols
    bases(:, col) = running;
    running = running + data(:, col);
  end
end
%=============================================================================
function [xData, yData, zData] = surfaceDataForColumn(data, bases, rowPositions, col, horizontal, opts)
  [rows, cols] = size(data);
  xData = [];
  yData = [];
  zData = [];
  for row = 1:rows
    [xlim, positionLimits] = barFootprint(row, col, cols, rowPositions, opts);
    base = bases(row, col);
    top = base + data(row, col);
    [xBlock, yBlock, zBlock] = cuboidBlock(xlim, positionLimits, base, top, horizontal);
    xData = [xData; xBlock];
    yData = [yData; yBlock];
    zData = [zData; zBlock];
  end
end
%=============================================================================
function [xlim, positionLimits] = barFootprint(row, col, cols, rowPositions, opts)
  width = opts.BarWidth;
  positionUnit = rowPositionUnit(rowPositions);
  switch opts.Style
    case 'grouped'
      groupWidth = automaticGroupWidth(width, cols);
      xSpan = groupWidth * width / cols;
      positionSpan = xSpan * positionUnit;
      offset = (col - (cols + 1) / 2) * groupWidth * positionUnit / cols;
      xlim = [1 - xSpan / 2, 1 + xSpan / 2];
      center = rowPositions(row) + offset;
      positionLimits = [center - positionSpan / 2, center + positionSpan / 2];
    case 'stacked'
      xlim = [1 - width / 2, 1 + width / 2];
      span = width * positionUnit;
      positionLimits = [rowPositions(row) - span / 2, rowPositions(row) + span / 2];
    otherwise
      xlim = [col - width / 2, col + width / 2];
      span = width * positionUnit;
      positionLimits = [rowPositions(row) - span / 2, rowPositions(row) + span / 2];
  end
end
%=============================================================================
function unit = rowPositionUnit(rowPositions)
  if numel(rowPositions) < 2
    unit = 1;
    return
  end
  steps = abs(diff(rowPositions(:).'));
  steps = steps(steps > 0);
  if isempty(steps)
    unit = 1;
  else
    unit = min(steps);
  end
end
%=============================================================================
function groupWidth = automaticGroupWidth(width, cols)
  if cols <= 1
    groupWidth = width;
  else
    groupWidth = min(width, cols / (cols + 1.5));
  end
end
%=============================================================================
function [xBlock, yBlock, zBlock] = cuboidBlock(xlim, positionLimits, base, top, horizontal)
  xBlock = [NaN xlim(1) xlim(2) NaN; xlim(1) xlim(1) xlim(2) xlim(2); ...
    xlim(1) xlim(1) xlim(2) xlim(2); NaN xlim(1) xlim(2) NaN; ...
    NaN xlim(1) xlim(2) NaN; NaN NaN NaN NaN];
  pBlock = [NaN positionLimits(1) positionLimits(1) NaN; ...
    positionLimits(1) positionLimits(1) positionLimits(1) positionLimits(1); ...
    positionLimits(2) positionLimits(2) positionLimits(2) positionLimits(2); ...
    NaN positionLimits(2) positionLimits(2) NaN; ...
    NaN positionLimits(1) positionLimits(1) NaN; NaN NaN NaN NaN];
  vBlock = [NaN base base NaN; base top top base; base top top base; ...
    NaN base base NaN; NaN base base NaN; NaN NaN NaN NaN];
  if horizontal
    yBlock = vBlock;
    zBlock = pBlock;
  else
    yBlock = pBlock;
    zBlock = vBlock;
  end
end
%=============================================================================
function applyBar3Axes(ax, data, rowPositions, explicitPositions, horizontal, opts)
  if isempty(ax)
    return
  end
  [rows, cols] = size(data);
  valueFootprint = bar3ValueFootprintLimits(data, opts);
  if horizontal
    positionLimits = mapRowLimits(horizontalRowLimits(rows, opts, explicitPositions), rowPositions, explicitPositions);
    valueLimits = horizontalValueAxisLimits(data, opts);
  else
    positionLimits = mapRowLimits(rowLimits(rows, opts, explicitPositions, valueFootprint), rowPositions, explicitPositions);
    valueLimits = valueAxisLimits(data, opts);
  end
  xLimits = xAxisLimits(cols, opts);
  [xFootprint, positionFootprint] = bar3FootprintLimits(data, rowPositions, opts);
  aspectXLimits = includeLimitsWithPadding(xLimits, xFootprint, ...
    bar3XAxisPadding(xFootprint, valueFootprint, opts));
  if needsBar3LimitsPadding()
    if horizontal
      valueLimits = includeValueLimitsWithPadding(valueLimits, valueFootprint, ...
        bar3ValuePadding(valueFootprint));
    else
      positionLimits = includeLimitsWithPadding(positionLimits, positionFootprint, ...
        bar3PositionPadding(rowPositions, valueFootprint, opts));
    end
  end
  if horizontal
    ax.XLim = xLimits;
    ax.YLim = valueLimits;
    ax.ZLim = positionLimits;
  else
    ax.XLim = xLimits;
    ax.YLim = positionLimits;
    ax.ZLim = valueLimits;
  end
  applyBar3Aspect(ax, aspectXLimits, rows, horizontal);
  applyBar3Ticks(ax, rowPositions, cols, horizontal, opts);
  applyBar3ColorLimits(ax, cols);
  ax.SortMethod = 'depth';
  view(ax, 3);
  applyBar3Camera(ax, horizontal, opts);
  grid(ax, 'on');
end
%=============================================================================
function limits = mapRowLimits(indexLimits, rowPositions, explicitPositions)
  if numel(rowPositions) < 2
    step = 1;
  else
    step = rowPositionUnit(rowPositions);
  end
  mapped = rowPositions(1) + (indexLimits - 1) * step;
  limits = [min(mapped), max(mapped)];
  if explicitPositions && needsAutomaticPositionLimits(rowPositions)
    limits = niceAxisLimits(limits);
  end
end
%=============================================================================
function tf = needsAutomaticPositionLimits(rowPositions)
  defaultPositions = (1:numel(rowPositions)).';
  tf = numel(rowPositions) > 15 && any(rowPositions(:) ~= defaultPositions);
end
%=============================================================================
function limits = niceAxisLimits(limits)
  span = diff(limits);
  if ~isfinite(span) || span <= 0
    return
  end
  step = niceAxisStep(span / 7);
  limits = [floor(limits(1) / step) * step, ceil(limits(2) / step) * step];
end
%=============================================================================
function step = niceAxisStep(value)
  scale = 10 ^ floor(log10(value));
  normalized = value / scale;
  if normalized <= 1
    nice = 1;
  elseif normalized <= 2
    nice = 2;
  elseif normalized <= 5
    nice = 5;
  else
    nice = 10;
  end
  step = nice * scale;
end
%=============================================================================
function applyBar3ColorLimits(ax, cols)
  % Each series surface carries a uniform CData equal to its column index
  % (1..cols). A uniform CData reports a degenerate color range per surface, so
  % the axis auto CLim scan cannot recover the overall [1 cols] span on its own.
  % Set it explicitly, keeping a floor of 2 so a single series stays [1 2].
  ax.CLim = [1, max(cols, 2)];
end
%=============================================================================
function applyBar3Aspect(ax, xLimits, rows, horizontal)
  dx = diff(xLimits);
  if horizontal
    dz = rows + 1;
    dy = (sqrt(5) - 1) / 2 * dz;
  else
    dy = rows + 1;
    dz = (sqrt(5) - 1) / 2 * dy;
  end
  ax.PlotBoxAspectRatio = [dx dy dz];
  ax.YDir = 'reverse';
end
%=============================================================================
function applyBar3Camera(ax, horizontal, opts)
  if needsBar3StackedUnzoom(horizontal, opts)
    ax.CameraViewAngle = ax.CameraViewAngle * bar3StackedUnzoomFactor();
  end
end
%=============================================================================
function tf = needsBar3StackedUnzoom(horizontal, opts)
  tf = ~horizontal && strcmp(opts.Style, 'stacked');
end
%=============================================================================
function factor = bar3StackedUnzoomFactor()
  factor = 1 / (0.95 ^ 3);
end
%=============================================================================
function tf = needsBar3LimitsPadding()
  tf = false;
end
%=============================================================================
function [xLimits, positionLimits] = bar3FootprintLimits(data, rowPositions, opts)
  [rows, cols] = size(data);
  xMin = Inf;
  xMax = -Inf;
  positionMin = Inf;
  positionMax = -Inf;
  for col = 1:cols
    for row = 1:rows
      [xFootprint, positionFootprint] = barFootprint(row, col, cols, rowPositions, opts);
      xMin = min(xMin, xFootprint(1));
      xMax = max(xMax, xFootprint(2));
      positionMin = min(positionMin, positionFootprint(1));
      positionMax = max(positionMax, positionFootprint(2));
    end
  end
  xLimits = [xMin, xMax];
  positionLimits = [positionMin, positionMax];
end
%=============================================================================
function limits = bar3ValueFootprintLimits(data, opts)
  if strcmp(opts.Style, 'stacked')
    values = [zeros(size(data, 1), 1), cumsum(data, 2)];
  else
    values = [0; data(:)];
  end
  values = values(isfinite(values));
  if isempty(values)
    limits = [0 1];
  else
    limits = [min(values(:)), max(values(:))];
  end
end
%=============================================================================
function padding = bar3XAxisPadding(xFootprint, valueFootprint, opts)
  if crossesZero(valueFootprint)
    ratio = 0.22;
  else
    ratio = 0.13;
  end
  if strcmp(opts.Style, 'grouped')
    minPadding = opts.BarWidth / 6;
  else
    minPadding = 0.1 * opts.BarWidth;
  end
  padding = max(ratio * diff(xFootprint), minPadding);
end
%=============================================================================
function padding = bar3ValuePadding(valueFootprint)
  padding = 0.1 * diff(valueFootprint);
end
%=============================================================================
function padding = bar3PositionPadding(rowPositions, valueFootprint, opts)
  if crossesZero(valueFootprint)
    ratio = 0.4;
  elseif strcmp(opts.Style, 'grouped')
    ratio = 0.635;
  else
    ratio = 0.26;
  end
  padding = ratio * rowPositionUnit(rowPositions);
end
%=============================================================================
function tf = crossesZero(limits)
  tf = limits(1) < 0 && limits(2) > 0;
end
%=============================================================================
function limits = includeLimitsWithPadding(limits, footprint, padding)
  limits = [min(limits(1), footprint(1) - padding), max(limits(2), footprint(2) + padding)];
end
%=============================================================================
function limits = includeValueLimitsWithPadding(limits, footprint, padding)
  if footprint(1) < 0
    limits(1) = min(limits(1), footprint(1) - padding);
  end
  if footprint(2) > 0
    limits(2) = max(limits(2), footprint(2) + padding);
  end
end
%=============================================================================
function applyBar3Ticks(ax, rowPositions, cols, horizontal, opts)
  columnTicks = columnTickValues(cols, opts);
  rowTicks = rowTickValues(rowPositions);
  if horizontal
    ax.XTick = columnTicks;
    valueTicks = horizontalValueTicks(ax.YLim);
    if ~isempty(valueTicks)
      ax.YTick = valueTicks;
    end
    if ~isempty(rowTicks)
      ax.ZTick = rowTicks;
    end
  else
    ax.XTick = columnTicks;
    valueTicks = verticalValueTicks(ax.ZLim);
    if ~isempty(valueTicks)
      ax.ZTick = valueTicks;
    end
    if ~isempty(rowTicks)
      ax.YTick = rowTicks;
    end
  end
end
%=============================================================================
function ticks = columnTickValues(cols, opts)
  if strcmp(opts.Style, 'detached') && cols > 1
    ticks = 1:cols;
  else
    ticks = [];
  end
end
%=============================================================================
function ticks = rowTickValues(rowPositions)
  rows = numel(rowPositions);
  if rows <= 15
    ticks = rowPositions(:).';
  else
    ticks = [];
  end
end
%=============================================================================
function limits = xAxisLimits(cols, opts)
  width = opts.BarWidth;
  switch opts.Style
    case 'grouped'
      limits = [1 - width / (2 * cols), 1 + width / (2 * cols)];
    case 'stacked'
      limits = [1 - width / 2, 1 + width / 2];
    otherwise
      limits = [1 - width / 2, cols + width / 2];
  end
end
%=============================================================================
function limits = horizontalRowLimits(rows, opts, explicitPositions)
  if (explicitPositions && rows >= 3) || rows >= 3 || (strcmp(opts.Style, 'grouped') && rows >= 3)
    limits = [0.5, rows + 0.5];
  else
    width = opts.BarWidth;
    limits = [1 - width / 2, rows + width / 2];
  end
end
%=============================================================================
function limits = horizontalValueAxisLimits(data, opts)
  limits = valueAxisLimits(data, opts);
  if limits(1) == 0 && limits(2) > 0
    limits(2) = nicePositiveUpper(limits(2));
  end
end
%=============================================================================
function upper = nicePositiveUpper(value)
  scale = 10 ^ floor(log10(value));
  normalized = value / scale;
  if normalized <= 1
    nice = 1;
  elseif normalized <= 1.5
    nice = 1.5;
  elseif normalized <= 2
    nice = 2;
  elseif normalized < 4
    nice = 4;
  elseif normalized <= 5
    nice = 5;
  elseif normalized <= 6
    nice = 6;
  elseif normalized <= 8
    nice = 8;
  else
    nice = 10;
  end
  upper = nice * scale;
end
%=============================================================================
function ticks = verticalValueTicks(limits)
  if numel(limits) ~= 2
    ticks = [];
    return
  end
  if crossesZero(limits) && diff(limits) > 10
    step = niceAxisStep(diff(limits) / 7);
    ticks = limits(1):step:limits(2);
    return
  end
  if limits(1) ~= 0 || limits(2) <= 0
    ticks = [];
    return
  end
  upper = limits(2);
  scale = 10 ^ floor(log10(upper));
  normalized = upper / scale;
  if normalized <= 2
    step = scale / 5;
  elseif normalized <= 6
    step = scale;
  else
    step = 2 * scale;
  end
  ticks = 0:step:upper;
end
%=============================================================================
function ticks = horizontalValueTicks(limits)
  if numel(limits) ~= 2 || limits(1) ~= 0 || limits(2) <= 0
    ticks = [];
    return
  end
  upper = limits(2);
  scale = 10 ^ floor(log10(upper));
  normalized = upper / scale;
  if normalized <= 1
    step = scale / 5;
  elseif normalized <= 2
    step = 0.5 * scale;
  elseif normalized < 6
    step = scale;
  else
    step = 2 * scale;
  end
  ticks = 0:step:upper;
end
%=============================================================================
function limits = rowLimits(rows, opts, explicitPositions, valueFootprint)
  if rows >= 15 || (rows >= 5 && crossesZero(valueFootprint) && ~strcmp(opts.Style, 'stacked'))
    limits = [0, rowLimitUpper(rows)];
    return
  end
  if strcmp(opts.Style, 'detached') || (strcmp(opts.Style, 'grouped') && rows >= 3)
    limits = [0.5, rows + 0.5];
  elseif strcmp(opts.Style, 'stacked') && opts.BarWidth < 0.8
    limits = [0.5, rows + 0.5];
  else
    width = opts.BarWidth;
    limits = [1 - width / 2, rows + width / 2];
  end
end
%=============================================================================
function upper = rowLimitUpper(rows)
  if rows < 10
    upper = rows + 1;
  elseif rows < 14
    upper = 2 * ceil((rows + 0.5) / 2);
  elseif rows < 16
    upper = rows + 1;
  elseif rows < 20
    upper = 2 * ceil((rows + 0.5) / 2);
  else
    upper = 5 * ceil((rows + 0.5) / 5);
  end
end
%=============================================================================
function limits = valueAxisLimits(data, opts)
  if strcmp(opts.Style, 'stacked')
    values = [zeros(size(data, 1), 1), cumsum(data, 2)];
    values = values(:);
  else
    values = [0; data(:)];
  end
  values = values(isfinite(values));
  if isempty(values)
    limits = [0 1];
    return
  end
  limits = [min(values), max(values)];
  if limits(1) == limits(2)
    limits = [limits(1) - 0.5, limits(2) + 0.5];
  end
  if ~strcmp(opts.Style, 'stacked') && crossesZero(limits)
    limits = niceAxisLimits(limits);
  end
end
%=============================================================================
function tf = isColorString(value)
  names = [getColorShortNameList(), getColorNameList()];
  tf = any(strcmpi(value, names));
end
%=============================================================================
function tf = isText(value)
  tf = ischar(value) || isStringScalar(value);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function h = barBase(orientation, varargin)
  args = varargin;
  [parent, args] = parseParent(args);
  target = prepareParent(parent);
  [x, y, labels, displayNames, width, mode, color, properties, isDate, isCategoricalAxis] = parseBarArguments(args);
  mode = effectiveStringProperty(properties, 'BarLayout', mode);
  width = effectiveNumericProperty(properties, 'BarWidth', width);
  baseValue = effectiveScalarProperty(properties, 'BaseValue', 0);
  updatePositionLimits = isBarAxesLimitAuto(target, orientation);
  updateValueLimits = isBarValueAxisLimitAuto(target, orientation);
  h = createBars(target, orientation, x, y, displayNames, width, mode, color, baseValue, properties);
  applyBarAxesState(target, orientation, x, y, labels, width, mode, size(y, 2), baseValue, ...
    updatePositionLimits, updateValueLimits, isCategoricalAxis);
  if isDate
    % The bar positions are serial date numbers; switch the position axis
    % ('x' for vertical bars, 'y' for horizontal ones) into date mode.
    if strcmp(orientation, 'horizontal')
      applyDatetimeAxis(target, 'y');
    else
      applyDatetimeAxis(target, 'x');
    end
  end
end
%=============================================================================
function [parent, args] = parseParent(args)
  parent = [];
  if ~isempty(args) && isscalar(args{1}) && (isgraphics(args{1}, 'axes') || isgraphics(args{1}, 'hggroup'))
    parent = args{1}(1);
    args = args(2:end);
  else
    [parent, args] = graphicsExtractParentProperty(args);
  end
end
%=============================================================================
function target = prepareParent(parent)
  if isempty(parent)
    target = newplot();
  elseif isgraphics(parent, 'axes')
    target = newplot(parent);
  elseif isgraphics(parent, 'hggroup')
    target = parent;
  else
    error('Nelson:graphics:invalidParent', 'Parent must be an axes or hggroup object.');
  end
end
%=============================================================================
function [x, y, labels, displayNames, width, mode, color, properties, isDate, isCategoricalAxis] = parseBarArguments(args)
  [args, properties] = splitProperties(args);
  if ~isempty(args) && (istable(args{1}) || istimetable(args{1}))
    [x, y, labels, displayNames, isDate, isCategoricalAxis, args] = parseTableBarArguments(args);
    [args, mode, color] = splitStyleArguments(args);
    [args, width] = splitWidthArgument(args);
  else
    [args, mode, color] = splitStyleArguments(args);
    [args, width] = splitWidthArgument(args);
    [x, y, labels, displayNames, isDate, isCategoricalAxis, args] = parseArrayBarArguments(args);
  end
  if ~isempty(args)
    error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
  end
  if numel(x) ~= size(y, 1)
    error('Nelson:barBase:invalidXLength', 'X length must match the number of rows in Y.');
  end
end
%=============================================================================
function [x, y, labels, displayNames, isDate, isCategoricalAxis, args] = parseArrayBarArguments(args)
  if isempty(args) || numel(args) > 2
    error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
  end
  labels = [];
  displayNames = {};
  isDate = false;
  isCategoricalAxis = false;
  if numel(args) == 1
    y = numericMatrix(args{1}, 'Y');
    x = 1:size(y, 1);
  else
    [x, labels, isDate] = positionVector(args{1});
    isCategoricalAxis = iscategorical(args{1}) || isstring(args{1});
    y = numericMatrixForPositions(args{2}, 'Y', x);
    if iscategorical(args{1})
      [x, y] = orderCategoricalBars(x, y);
    end
  end
  args = {};
end
%=============================================================================
function [x, y] = orderCategoricalBars(x, y)
  % Place bars in category order: sort by category code so positions become
  % 1:N and Y is reordered to match categories(), as the reference does.
  [x, perm] = sort(x(:).');
  y = y(perm, :);
end
%=============================================================================
function [x, y, labels, displayNames, isDate, isCategoricalAxis, args] = parseTableBarArguments(args)
  tbl = args{1};
  args = args(2:end);
  if isempty(args)
    error('Nelson:graphics:tableVariableExpected', 'Table variable arguments expected.');
  end
  xIsCategorical = false;
  isCategoricalAxis = false;
  isDate = false;
  if numel(args) >= 2 && isTableVariableSelector(tbl, args{2})
    xNames = graphicsTableVariableNames(tbl, args{1});
    yNames = graphicsTableVariableNames(tbl, args{2});
    args = args(3:end);
    if numel(xNames) ~= 1
      error('Nelson:graphics:unrecognizedTableVariable', 'Unrecognized table variable.');
    end
    xValue = tbl.(xNames{1});
    xIsCategorical = iscategorical(xValue);
    isCategoricalAxis = xIsCategorical || isstring(xValue);
    [x, labels, isDate] = positionVector(xValue);
  else
    yNames = graphicsTableVariableNames(tbl, args{1});
    args = args(2:end);
    labels = [];
    x = [];
  end
  y = tableNumericMatrix(tbl, yNames);
  displayNames = yNames;
  if isempty(x)
    x = 1:size(y, 1);
  end
  if xIsCategorical
    [x, y] = orderCategoricalBars(x, y);
  end
end
%=============================================================================
function tf = isTableVariableSelector(tbl, selector)
  try
    graphicsTableVariableNames(tbl, selector);
    tf = true;
  catch
    tf = false;
  end
end
%=============================================================================
function data = tableNumericMatrix(tbl, names)
  data = [];
  for k = 1:numel(names)
    value = numericMatrix(tbl.(names{k}), names{k});
    if size(value, 2) ~= 1
      error('Nelson:validators:mustBeVector', '%s must be a vector.', names{k});
    end
    data = [data, value];
  end
end
%=============================================================================
function [args, properties] = splitProperties(args)
  firstProperty = [];
  for k = 1:numel(args)
    if isBarPropertyName(args{k})
      firstProperty = k;
      break
    end
  end
  if isempty(firstProperty)
    properties = {};
  else
    properties = args(firstProperty:end);
    args = args(1:firstProperty - 1);
    if mod(numel(properties), 2) ~= 0
      error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
    end
  end
end
%=============================================================================
function [args, mode, color] = splitStyleArguments(args)
  mode = 'grouped';
  color = [];
  while ~isempty(args) && (ischar(args{end}) || isStringScalar(args{end}))
    value = char(args{end});
    if strcmpi(value, 'grouped') || strcmpi(value, 'stacked')
      mode = lower(value);
    elseif isColorString(value)
      color = getColorShortName(value);
    else
      error('Nelson:barBase:unrecognizedOption', 'Unknown option.');
    end
    args(end) = [];
  end
end
%=============================================================================
function [args, width] = splitWidthArgument(args)
  width = 0.8;
  if ~isempty(args) && isnumeric(args{end}) && isscalar(args{end}) && numel(args) > 1
    width = args{end};
    args(end) = [];
  end
  validatePositiveFiniteScalar(width, sprintf(_('%s must be a positive finite scalar.'), 'Width'));
end
%=============================================================================
function y = numericMatrix(value, name)
  if ~isnumeric(value) || ~isreal(value)
    error('Nelson:graphics:mustBeRealMatrix', '%s must be a real numeric matrix.', name);
  end
  y = double(value);
  if isvector(y)
    y = y(:);
  end
end
%=============================================================================
function y = numericMatrixForPositions(value, name, x)
  y = numericMatrix(value, name);
  if isvector(value)
    if isscalar(x)
      y = double(value(:).');
    end
    return
  end
  if numel(x) ~= size(y, 1) && numel(x) == size(y, 2)
    y = y.';
  end
end
%=============================================================================
function [x, labels, isDate] = positionVector(value)
  labels = [];
  isDate = false;
  if isa(value, 'datetime')
    % Bars are positioned at the serial date numbers; the matching axis is put
    % into date mode by the caller (see barBase / applyDatetimeAxis).
    x = datetimeToSerial(value);
    x = x(:).';
    isDate = true;
    return
  end
  if iscategorical(value)
    % Labels follow the category order (as returned by categories()), not the
    % data order. Bars are positioned at the category codes so the caller can
    % reorder Y into category order (see orderCategoricalBars).
    cats = categories(value);
    labels = cats(:).';
    x = double(value(:).');
    return
  end
  if isstring(value)
    labels = cellstr(value(:)');
    x = 1:numel(labels);
    return
  end
  if iscell(value)
    labels = cellstr(value(:)');
    x = 1:numel(labels);
    return
  end
  if ~(isnumeric(value) && isreal(value))
    error('Nelson:barBase:invalidX', 'X must be numeric, categorical, or a string array.');
  end
  x = double(value(:)');
end
%=============================================================================
function h = createBars(parent, orientation, x, y, displayNames, width, mode, color, baseValue, properties)
  ax = barAxes(parent);
  nSeries = size(y, 2);
  h = gobjects(1, nSeries);
  positiveBases = baseValue * ones(size(y, 1), 1);
  negativeBases = baseValue * ones(size(y, 1), 1);
  for seriesIndex = 1:nSeries
    if strcmp(mode, 'stacked')
      [baseData, positiveBases, negativeBases] = stackedBaseData(y(:, seriesIndex), positiveBases, negativeBases);
    else
      baseData = baseValue * ones(size(y, 1), 1);
    end
    constructorArgs = {'Parent', parent, 'XData', x, 'YData', y(:, seriesIndex).', ...
      'BarLayout', mode, 'BarWidth', width, 'BaseValue', baseValue, ...
      'NumPeers', nSeries, 'SeriesIndex', seriesIndex, 'BarBaseData', baseData.'};
    if strcmp(orientation, 'horizontal')
      constructorArgs = [constructorArgs, {'Horizontal', 'on'}];
    end
    objectProperties = properties;
    if hasProperty(objectProperties, 'FaceColor') && ~hasProperty(objectProperties, 'FaceColorMode')
      objectProperties = [objectProperties, {'FaceColorMode', 'manual'}];
    end
    if ~hasProperty(objectProperties, 'FaceColor')
      constructorArgs = [constructorArgs, {'FaceColor', seriesColor(ax, color)}];
      if ~isempty(color)
        constructorArgs = [constructorArgs, {'FaceColorMode', 'manual'}];
      end
    end
    if ~hasProperty(objectProperties, 'DisplayName') && seriesIndex <= numel(displayNames)
      constructorArgs = [constructorArgs, {'DisplayName', displayNames{seriesIndex}}];
    end
    h(seriesIndex) = __bar__(constructorArgs{:}, objectProperties{:});
  end
end
%=============================================================================
function [baseData, posBase, negBase] = stackedBaseData(values, posBase, negBase)
  baseData = zeros(size(values));
  for k = 1:numel(values)
    if values(k) >= 0
      baseData(k) = posBase(k);
      posBase(k) = posBase(k) + values(k);
    else
      baseData(k) = negBase(k);
      negBase(k) = negBase(k) + values(k);
    end
  end
end
%=============================================================================
function color = seriesColor(ax, explicitColor)
  if ~isempty(explicitColor)
    color = explicitColor;
  else
    color = getColorAndUpdateIndex(ax);
  end
end
%=============================================================================
function value = effectiveStringProperty(properties, name, fallback)
  value = fallback;
  for k = 1:2:numel(properties)
    if isText(properties{k}) && strcmpi(char(properties{k}), name)
      value = lower(char(properties{k + 1}));
    end
  end
end
%=============================================================================
function value = effectiveNumericProperty(properties, name, fallback)
  value = effectiveScalarProperty(properties, name, fallback);
  validatePositiveFiniteScalar(value, sprintf(_('%s must be a positive finite scalar.'), name));
end
%=============================================================================
function value = effectiveScalarProperty(properties, name, fallback)
  value = fallback;
  for k = 1:2:numel(properties)
    if isText(properties{k}) && strcmpi(char(properties{k}), name)
      value = properties{k + 1};
    end
  end
  if ~isnumeric(value) || ~isscalar(value) || ~isfinite(value)
    error('Nelson:barBase:mustBeFiniteScalar', '%s must be a finite scalar.', name);
  end
end
%=============================================================================
function validatePositiveFiniteScalar(value, msg)
  if ~isnumeric(value) || ~isscalar(value) || ~isfinite(value) || value <= 0
    error('Nelson:barBase:mustBePositiveFinite', msg);
  end
end
%=============================================================================
function applyBarAxesState(parent, orientation, x, y, labels, width, mode, nSeries, baseValue, ...
  updatePositionLimits, updateValueLimits, isCategoricalAxis)
  ax = barAxes(parent);
  if isempty(ax)
    return
  end
  ax.Box = 'on';
  useBarTicks = ~isempty(labels) || shouldUseBarTicks(x);
  if strcmp(orientation, 'horizontal')
    if useBarTicks
      ax.YTick = x;
    end
    if ~isempty(labels)
      ax.YTickLabel = labels;
    end
  else
    if useBarTicks
      ax.XTick = x;
    end
    if ~isempty(labels)
      ax.XTickLabel = labels;
    end
  end
  if updatePositionLimits
    limits = barPositionLimits(x, width, mode, nSeries, labels);
    if strcmp(orientation, 'horizontal')
      ax.YLim = limits;
    else
      ax.XLim = limits;
    end
  end


  if updateValueLimits
    limits = barValueLimits(y, mode, baseValue);
    ticks = barValueTicks(limits, orientation);
    if strcmp(orientation, 'horizontal')
      ax.XLim = limits;
      if strcmp(ax.XTickMode, 'auto')
        ax.XTick = ticks;
      end
    else
      ax.YLim = limits;
      if strcmp(ax.YTickMode, 'auto')
        ax.YTick = ticks;
      end
    end
  end
  if isCategoricalAxis && ~isempty(labels)
    if strcmp(orientation, 'horizontal')
      __axis_categorical__(ax, 'y', labels);
    else
      __axis_categorical__(ax, 'x', labels);
    end
  end
end
%=============================================================================
function limits = barPositionLimits(x, width, mode, nSeries, labels)
  x = x(:);
  x = x(isfinite(x));
  if isempty(x)
    limits = [0 1];
    return
  end
  step = minPositiveStep(x);
  if strcmp(mode, 'grouped') && nSeries > 1 && ~isempty(labels)
    pad = 0.75 * step;
  elseif strcmp(mode, 'grouped') && nSeries > 1
    groupWidth = min(width, nSeries / (nSeries + 1.5));
    pad = (groupWidth / 2 + max(0, 1 - width)) * step;
  else
    pad = (0.8 + width / 2) * step;
  end
  limits = [min(x) - pad, max(x) + pad];
end
%=============================================================================
function limits = barValueLimits(y, mode, baseValue)
  if strcmp(mode, 'stacked')
    positiveBases = baseValue * ones(size(y, 1), 1);
    negativeBases = baseValue * ones(size(y, 1), 1);
    values = [0; baseValue];
    for seriesIndex = 1:size(y, 2)
      for rowIndex = 1:size(y, 1)
        value = y(rowIndex, seriesIndex);
        if value >= 0
          endpoint = positiveBases(rowIndex) + value;
          positiveBases(rowIndex) = endpoint;
        else
          endpoint = negativeBases(rowIndex) + value;
          negativeBases(rowIndex) = endpoint;
        end
        values = [values; endpoint];
      end
    end
  else
    values = [0; baseValue; y(:)];
  end
  values = values(isfinite(values));
  if isempty(values)
    limits = [0 1];
    return
  end
  limits = [min(values), max(values)];
  if limits(1) == limits(2)
    limits = [limits(1) - 0.5, limits(2) + 0.5];
  elseif limits(1) < 0 && limits(2) > 0
    limits = mixedSignValueLimits(limits);
  elseif limits(1) >= 0 && limits(2) > 0
    if strcmp(mode, 'stacked')
      limits(2) = positiveStackedValueUpper(limits(2));
    else
      limits(2) = positiveValueUpper(limits(2));
    end
  end
end
%=============================================================================
function upper = positiveValueUpper(value)
  step = niceStep(value / 9);
  upper = ceil(value / step) * step;
end
%=============================================================================
function ticks = barValueTicks(limits, orientation)
  if strcmp(orientation, 'vertical') && limits(1) < 0 && limits(2) > 0
    step = niceStep(diff(limits) / 3);
  else
    step = niceStep(diff(limits) / 9);
  end
  first = ceil(limits(1) / step) * step;
  last = floor(limits(2) / step) * step;
  ticks = first:step:last;
  if isempty(ticks)
    ticks = limits;
    return
  end
  if abs(ticks(1) - limits(1)) > 1e-12
    ticks = [limits(1), ticks];
  end
  if abs(ticks(end) - limits(2)) > 1e-12
    ticks = [ticks, limits(2)];
  end
end
%=============================================================================
function upper = positiveStackedValueUpper(value)
  padded = value * 1.1;
  step = niceStep(padded / 6);
  upper = ceil(padded / step) * step;
end
%=============================================================================
function limits = mixedSignValueLimits(limits)
  coarseStep = niceStep(diff(limits) / 3);
  if isMultipleOfStep(limits(1), coarseStep) && isMultipleOfStep(limits(2), coarseStep)
    return
  end
  fineStep = niceStep(diff(limits) / 8);
  limits = [floor(limits(1) / fineStep) * fineStep, ceil(limits(2) / fineStep) * fineStep];
end
%=============================================================================
function step = niceStep(value)
  value = abs(value);
  if value <= 0 || ~isfinite(value)
    step = 1;
    return
  end
  scale = 10 ^ floor(log10(value));
  normalized = value / scale;
  if normalized <= 1
    nice = 1;
  elseif normalized <= 2
    nice = 2;
  elseif normalized <= 5
    nice = 5;
  else
    nice = 10;
  end
  step = nice * scale;
end
%=============================================================================
function tf = isMultipleOfStep(value, step)
  tf = abs(value / step - round(value / step)) < 1e-12;
end
%=============================================================================
function tf = shouldUseBarTicks(x)
  x = x(:);
  x = x(isfinite(x));
  tf = ~isempty(x) && all(abs(x - round(x)) < 1e-12);
end
%=============================================================================
function value = minPositiveStep(x)
  values = sort(unique(x(:)));
  if numel(values) < 2
    value = 1;
    return
  end
  dx = diff(values);
  dx = dx(dx > 0 & isfinite(dx));
  if isempty(dx)
    value = 1;
  else
    value = min(dx);
  end
end
%=============================================================================
function res = isBarAxesLimitAuto(parent, orientation)
  ax = barAxes(parent);
  if isempty(ax)
    res = false;
  elseif strcmp(orientation, 'horizontal')
    res = strcmp(ax.YLimMode, 'auto');
  else
    res = strcmp(ax.XLimMode, 'auto');
  end
end
%=============================================================================
function res = isBarValueAxisLimitAuto(parent, orientation)
  ax = barAxes(parent);
  if isempty(ax)
    res = false;
  elseif strcmp(orientation, 'horizontal')
    res = strcmp(ax.XLimMode, 'auto');
  else
    res = strcmp(ax.YLimMode, 'auto');
  end
end
%=============================================================================
function ax = barAxes(parent)
  if isgraphics(parent, 'axes')
    ax = parent;
  else
    ax = ancestor(parent, 'axes');
  end
end
%=============================================================================
function tf = isBarPropertyName(value)
  tf = false;
  if ~isText(value)
    return
  end
  tf = isValidGraphicsProperty('bar', char(value));
end
%=============================================================================
function tf = isColorString(value)
  names = [getColorShortNameList(), getColorNameList()];
  tf = any(strcmpi(value, names));
end
%=============================================================================
function tf = hasProperty(properties, name)
  tf = false;
  for k = 1:2:numel(properties)
    if isText(properties{k}) && strcmpi(char(properties{k}), name)
      tf = true;
      return
    end
  end
end
%=============================================================================
function tf = isText(value)
  tf = ischar(value) || isStringScalar(value);
end
