function list = readAvailableModulesFromFile()
  run([nelsonroot(), '/modules/modules.m']);
  funcList = @(x) x{1};
  list = string(cellfun(funcList, modules_list, 'UniformOutput', false));
  funcAvailable = @(x) x{2};
  available = cellfun(funcAvailable, modules_list, 'UniformOutput', true);
  list = list(available);
end
