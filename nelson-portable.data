% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [b, stats] = robustfit(X, y, wfun, tune, const)
  narginchk(2, 5);
  nargoutchk(0, 2);
  if nargin < 3 || isempty(wfun)
    wfun = 'bisquare';
  end
  if nargin < 4
    tune = [];
  end
  if nargin < 5 || isempty(const)
    const = 'on';
  end
  [X, y, wfun, tune, const] = validateInputsLocal(X, y, wfun, tune, const);
  if strcmp(const, 'on')
    X = [ones(size(X, 1), 1), X];
  end
  keep = ~isnan(y) & all(~isnan(X), 2);
  [b, fitStats] = robustFitLocal(X(keep, :), y(keep), wfun, tune);
  stats = expandStatsLocal(fitStats, keep, size(X, 1));
end
%=============================================================================
function [X, y, wfun, tune, const] = validateInputsLocal(X, y, wfun, tune, const)
  if ~(isnumeric(X) && isreal(X) && ismatrix(X) && ~issparse(X))
    error('Nelson:statistics:xRealNumericMatrix', '%s must be a real numeric matrix.', 'X');
  end
  if ~(isnumeric(y) && isreal(y) && isvector(y) && ~issparse(y))
    error('Nelson:statistics:yRealNumericVector', '%s must be a real numeric vector.', 'Y');
  end
  X = double(X);
  y = double(y(:));
  if size(X, 1) ~= length(y)
    error('Nelson:statistics:xYSameNumberRows', '%s must have the same number of rows.', 'X and Y');
  end
  const = parseConstLocal(const);
  wfun = parseWeightFunctionLocal(wfun);
  tune = parseTuneLocal(tune, wfun);
end
%=============================================================================
function const = parseConstLocal(value)
  if ~isTextScalarLocal(value)
    error('Nelson:statistics:CONSTOff', 'CONST must be ''on'' or ''off''.');
  end
  const = parseChoiceLocal(value, {'on', 'off'}, 'CONST');
end
%=============================================================================
function tune = parseTuneLocal(tune, wfun)
  if isempty(tune)
    tune = defaultTuneLocal(wfun);
    return
  end
  if ~(isnumeric(tune) && isreal(tune) && isscalar(tune) && isfinite(tune) && tune > 0)
    error('Nelson:statistics:TUNEPositiveScalar', '%s must be a positive scalar.', 'TUNE');
  end
  tune = double(tune);
end
%=============================================================================
function name = parseWeightFunctionLocal(wfun)
  if isa(wfun, 'function_handle')
    name = wfun;
    return
  end
  if ~isTextScalarLocal(wfun)
    error('Nelson:statistics:WFUNCharacterVectorStringScalar', 'WFUN must be a character vector, string scalar, or function handle.');
  end
  name = parseChoiceLocal(wfun, {'andrews', 'bisquare', 'cauchy', 'fair', ...
                                 'huber', 'logistic', 'ols', 'talwar', 'welsch'}, 'WFUN');
end
%=============================================================================
function [b, stats] = robustFitLocal(X, y, wfun, tune)
  n = length(y);
  p = size(X, 2);
  if n == 0 || p == 0
    b = NaN(p, 1);
    stats = emptyStatsLocal(n, p);
    return
  end
  b = X \ y;
  dfe = n - rank(X);
  h = leverageLocal(X);
  resid = y - X * b;
  ols_s = scaleFromResidualsLocal(resid, dfe);
  if ischar(wfun) && strcmp(wfun, 'ols')
    w = ones(n, 1);
  else
    [b, resid, w] = irlsLocal(X, y, b, h, wfun, tune, p);
  end
  stats = buildStatsLocal(X, y, b, resid, w, h, dfe, ols_s);
end
%=============================================================================
function [b, resid, w] = irlsLocal(X, y, b, h, wfun, tune, p)
  w = ones(length(y), 1);
  for iter = 1:50
    resid = y - X * b;
    s = madScaleLocal(resid, p);
    u = resid ./ max(tune * s * sqrt(max(1 - h, eps)), eps);
    w = weightValuesLocal(u, wfun);
    sw = sqrt(max(w, 0));
    bnew = (X .* sw) \ (y .* sw);
    if norm(bnew - b) <= 1e-6 * max(norm(b), eps)
      b = bnew;
      break
    end
    b = bnew;
  end
  resid = y - X * b;
end
%=============================================================================
function stats = buildStatsLocal(X, y, b, resid, w, h, dfe, ols_s)
  p = length(b);
  mad_s = madScaleLocal(resid, p);
  robust_s = scaleFromResidualsLocal(sqrt(max(w, 0)) .* resid, dfe);
  s = max(mad_s, robust_s);
  covb = pinv(X' * X) * s ^ 2;
  se = sqrt(max(0, diag(covb)));
  tval = b ./ se;
  pval = 2 * (1 - tcdf(abs(tval), max(dfe, 1)));
  stats = struct();
  stats.ols_s = ols_s;
  stats.robust_s = robust_s;
  stats.mad_s = mad_s;
  stats.s = s;
  stats.resid = resid;
  stats.rstud = resid ./ max(s * sqrt(max(1 - h, eps)), eps);
  stats.se = se;
  stats.covb = covb;
  stats.coeffcorr = coefficientCorrelationLocal(covb);
  stats.t = tval;
  stats.p = pval;
  stats.w = w;
  stats.R = rFactorLocal(X);
  stats.dfe = dfe;
  stats.h = h;
end
%=============================================================================
function stats = expandStatsLocal(stats, keep, n)
  fields = {'resid', 'rstud', 'w', 'h'};
  for k = 1:length(fields)
    name = fields{k};
    values = NaN(n, 1);
    values(keep) = stats.(name);
    stats.(name) = values;
  end
end
%=============================================================================
function stats = emptyStatsLocal(n, p)
  stats = struct('ols_s', NaN, 'robust_s', NaN, 'mad_s', NaN, 's', NaN, ...
    'resid', NaN(n, 1), 'rstud', NaN(n, 1), 'se', NaN(p, 1), ...
    'covb', NaN(p, p), 'coeffcorr', NaN(p, p), 't', NaN(p, 1), ...
    'p', NaN(p, 1), 'w', NaN(n, 1), 'R', NaN(p, p), 'dfe', NaN, ...
    'h', NaN(n, 1));
end
%=============================================================================
function s = madScaleLocal(resid, p)
  deviations = sort(abs(resid - median(resid)));
  if length(deviations) > p
    deviations = deviations(p + 1:end);
  end
  s = median(deviations) / 0.6745;
  if ~(isfinite(s) && s > 0)
    s = max(scaleFromResidualsLocal(resid, length(resid) - p), eps);
  end
end
%=============================================================================
function s = scaleFromResidualsLocal(resid, dfe)
  if dfe <= 0
    s = NaN;
  else
    s = sqrt(sum(resid .^ 2) / dfe);
  end
end
%=============================================================================
function h = leverageLocal(X)
  h = diag(X * pinv(X' * X) * X');
  h = min(max(h, 0), 1);
end
%=============================================================================
function w = weightValuesLocal(u, wfun)
  if isa(wfun, 'function_handle')
    w = feval(wfun, u);
    return
  end
  switch wfun
    case 'andrews'
      w = ones(size(u));
      nz = u ~= 0;
      w(nz) = (abs(u(nz)) < pi) .* sin(u(nz)) ./ u(nz);
    case 'bisquare'
      w = (abs(u) < 1) .* (1 - u .^ 2) .^ 2;
    case 'cauchy'
      w = 1 ./ (1 + u .^ 2);
    case 'fair'
      w = 1 ./ (1 + abs(u));
    case 'huber'
      w = 1 ./ max(1, abs(u));
    case 'logistic'
      w = ones(size(u));
      nz = u ~= 0;
      w(nz) = tanh(u(nz)) ./ u(nz);
    case 'talwar'
      w = double(abs(u) < 1);
    otherwise
      w = exp(-(u .^ 2));
  end
  w(~isfinite(w)) = 1;
end
%=============================================================================
function c = coefficientCorrelationLocal(covb)
  d = sqrt(diag(covb));
  c = covb ./ (d * d');
end
%=============================================================================
function R = rFactorLocal(X)
  try
    R = chol(X' * X);
  catch
    R = [];
  end
end
%=============================================================================
function tune = defaultTuneLocal(wfun)
  if isa(wfun, 'function_handle')
    tune = 1;
    return
  end
  switch wfun
    case 'andrews'
      tune = 1.339;
    case 'cauchy'
      tune = 2.385;
    case 'fair'
      tune = 1.400;
    case 'huber'
      tune = 1.345;
    case 'logistic'
      tune = 1.205;
    case 'talwar'
      tune = 2.795;
    case 'welsch'
      tune = 2.985;
    otherwise
      tune = 4.685;
  end
end
%=============================================================================
function value = parseChoiceLocal(value, choices, name)
  text = lower(char(value));
  matches = choices(startsWith(choices, text));
  if length(matches) ~= 1
    error('Nelson:statistics:invalidValue:valueHasUnsupportedValue', '%s has an unsupported value.', name);
  end
  value = matches{1};
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [B, T] = rotatefactors(X, varargin)
  narginchk(1, Inf);
  nargoutchk(0, 2);
  preserveSingle = isa(X, 'single');
  X = validateLoadingsLocal(X);
  opts = parseOptionsLocal(convertStringToCharArgs(varargin), size(X));
  [B, T] = rotateLocal(X, opts);
  if preserveSingle
    B = single(B);
    T = single(T);
  end
end
%=============================================================================
function X = validateLoadingsLocal(X)
  if ~(isnumeric(X) && isreal(X) && ~issparse(X) && ndims(X) == 2)
    error('Nelson:statistics:xRealNumericMatrix', '%s must be a real numeric matrix.', 'X');
  end
  X = double(X);
  if isempty(X) || any(~isfinite(X(:)))
    error('Nelson:statistics:xMustBeFinite', '%s must contain finite values.', 'X');
  end
  if size(X, 2) < 1
    error('Nelson:statistics:xContainLeastOneFactor', 'X must contain at least one factor.');
  end
end
%=============================================================================
function opts = parseOptionsLocal(args, loadingsSize)
  opts = defaultOptionsLocal();
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  for k = 1:2:length(args)
    if ~isTextScalarLocal(args{k})
      error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Name');
    end
    opts = setOptionLocal(opts, lower(char(args{k})), args{k + 1}, loadingsSize);
  end
end
%=============================================================================
function opts = defaultOptionsLocal()
  opts = struct('Method', 'varimax', 'Normalize', true, 'RelTol', sqrt(eps), ...
    'MaxIt', 250, 'Coeff', 1, 'Power', 4, 'Target', [], 'Type', 'oblique');
end
%=============================================================================
function opts = setOptionLocal(opts, name, value, loadingsSize)
  switch name
    case 'method'
      opts.Method = parseChoiceLocal(value, {'varimax', 'quartimax', 'equamax', ...
        'parsimax', 'orthomax', 'promax', 'procrustes', 'pattern'}, 'Method');
    case 'normalize'
      opts.Normalize = parseOnOffLocal(value, 'Normalize');
    case 'reltol'
      opts.RelTol = parsePositiveScalarLocal(value, 'RelTol');
    case 'maxit'
      opts.MaxIt = parsePositiveIntegerLocal(value, 'MaxIt');
    case 'coeff'
      opts.Coeff = parseNonnegativeScalarLocal(value, 'Coeff');
    case 'power'
      opts.Power = parsePositiveScalarLocal(value, 'Power');
    case 'target'
      opts.Target = validateTargetLocal(value, loadingsSize);
    case 'type'
      opts.Type = parseChoiceLocal(value, {'oblique', 'orthogonal'}, 'Type');
    otherwise
      error('Nelson:statistics:unknownOption', 'Unknown option.');
  end
end
%=============================================================================
function value = parseChoiceLocal(value, choices, name)
  if ~isTextScalarLocal(value)
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', name);
  end
  value = lower(char(value));
  matches = choices(startsWith(choices, value));
  if length(matches) ~= 1
    error('Nelson:statistics:invalidValue:valueHasUnsupportedValue', '%s has an unsupported value.', name);
  end
  value = matches{1};
end
%=============================================================================
function tf = parseOnOffLocal(value, name)
  if islogical(value) && isscalar(value)
    tf = value ~= 0;
  elseif isnumeric(value) && isreal(value) && isscalar(value) && (value == 0 || value == 1)
    tf = value ~= 0;
  elseif isTextScalarLocal(value)
    value = lower(char(value));
    if strcmp(value, 'on')
      tf = true;
    elseif strcmp(value, 'off')
      tf = false;
    else
      error('Nelson:statistics:invalidValue:valueHasUnsupportedValue', '%s has an unsupported value.', name);
    end
  else
    error('Nelson:statistics:invalidValue:valueOffTrueFalse', '%s must be on, off, true, or false.', name);
  end
end
%=============================================================================
function value = parsePositiveScalarLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) && value > 0)
    error('Nelson:statistics:mustBePositiveFinite', '%s must be a positive finite scalar.', name);
  end
  value = double(value);
end
%=============================================================================
function value = parseNonnegativeScalarLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) && value >= 0)
    error('Nelson:statistics:mustBeNonnegativeFinite', '%s must be a nonnegative finite scalar.', name);
  end
  value = double(value);
end
%=============================================================================
function value = parsePositiveIntegerLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) ...
      && floor(value) == value && value > 0)
    error('Nelson:statistics:mustBePositiveInteger', '%s must be a positive integer scalar.', name);
  end
  value = double(value);
end
%=============================================================================
function target = validateTargetLocal(target, loadingsSize)
  if ~(isnumeric(target) && isreal(target) && ~issparse(target) && ndims(target) == 2)
    error('Nelson:statistics:targetRealNumericMatrix', '%s must be a real numeric matrix.', 'Target');
  end
  target = double(target);
  if ~isequal(size(target), loadingsSize)
    error('Nelson:statistics:targetSameSizeX', 'Target must have the same size as X.');
  end
  if any(~isfinite(target(:)))
    error('Nelson:statistics:targetContainFiniteValues', '%s must contain finite values.', 'Target');
  end
end
%=============================================================================
function [B, T] = rotateLocal(X, opts)
  switch opts.Method
    case {'varimax', 'quartimax', 'equamax', 'parsimax', 'orthomax'}
      [B, T] = orthomaxLocal(X, opts, rotationCoeffLocal(opts.Method, opts.Coeff));
    case 'promax'
      [B, T] = promaxLocal(X, opts);
    otherwise
      [B, T] = targetRotationLocal(X, opts);
  end
  [B, T] = orientColumnsLocal(B, T);
end
%=============================================================================
function gamma = rotationCoeffLocal(method, coeff)
  switch method
    case 'quartimax'
      gamma = 0;
    case {'equamax', 'parsimax'}
      gamma = [];
    case 'orthomax'
      gamma = coeff;
    otherwise
      gamma = 1;
  end
end
%=============================================================================
function [B, T] = orthomaxLocal(X, opts, gamma)
  [Xn, scale] = normalizeRowsLocal(X, opts.Normalize);
  [p, m] = size(Xn);
  if isempty(gamma)
    if strcmp(opts.Method, 'equamax')
      gamma = m / 2;
    else
      gamma = p * (m - 1) / max(p + m - 2, 1);
    end
  end
  T = eye(m);
  previous = 0;
  for iter = 1:opts.MaxIt
    rotated = Xn * T;
    target = p * rotated .^ 3 - gamma * (rotated * diag(sum(rotated .^ 2, 1)));
    [U, S, V] = svd(Xn' * target);
    T = U * V';
    current = sum(diag(S));
    if current <= previous * (1 + opts.RelTol)
      break
    end
    previous = current;
  end
  B = unnormalizeRowsLocal(Xn * T, scale);
end
%=============================================================================
function [B, T] = promaxLocal(X, opts)
  [orthogonal, Tortho] = orthomaxLocal(X, opts, opts.Coeff);
  target = sign(orthogonal) .* abs(orthogonal) .^ opts.Power;
  procrustesOpts = opts;
  procrustesOpts.Target = target;
  procrustesOpts.Type = 'oblique';
  [B, Tp] = targetRotationLocal(X, procrustesOpts);
  T = Tortho * (Tortho \ Tp);
end
%=============================================================================
function [B, T] = targetRotationLocal(X, opts)
  if isempty(opts.Target)
    error('Nelson:statistics:targetRequiredRotationMethod', 'Target is required for this rotation method.');
  end
  if strcmp(opts.Type, 'orthogonal')
    [U, ~, V] = svd(X' * opts.Target);
    T = U * V';
  else
    T = (X' * X) \ (X' * opts.Target);
    columnNorm = sqrt(sum(T .^ 2, 1));
    columnNorm(columnNorm == 0) = 1;
    T = T ./ repmat(columnNorm, size(T, 1), 1);
  end
  B = X * T;
end
%=============================================================================
function [Xn, scale] = normalizeRowsLocal(X, doNormalize)
  scale = ones(size(X, 1), 1);
  Xn = X;
  if ~doNormalize
    return
  end
  scale = sqrt(sum(X .^ 2, 2));
  scale(scale <= 0) = 1;
  Xn = X ./ repmat(scale, 1, size(X, 2));
end
%=============================================================================
function X = unnormalizeRowsLocal(X, scale)
  X = X .* repmat(scale, 1, size(X, 2));
end
%=============================================================================
function [B, T] = orientColumnsLocal(B, T)
  for k = 1:size(B, 2)
    [~, idx] = max(abs(B(:, k)));
    if B(idx, k) < 0
      B(:, k) = -B(:, k);
      T(:, k) = -T(:, k);
    end
  end
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || isStringScalar(value);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [dRE, X] = rowexch(varargin)
  narginchk(2, Inf);
  nargoutchk(0, 2);

  nfactors = positiveInteger(varargin{1}, sprintf(_('%s must be a positive integer scalar.'), 'NFACTORS'));
  nruns = positiveInteger(varargin{2}, sprintf(_('%s must be a positive integer scalar.'), 'NRUNS'));
  modelspec = 'linear';
  args = varargin(3:end);
  if ~isempty(args) && ~(isTextScalar(args{1}) && isOptionName(args{1}))
    modelspec = args{1};
    args = args(2:end);
  end
  [candArgs, exchArgs] = splitOptions(args);
  [dC, C] = candgen(nfactors, modelspec, candArgs{:});
  r = candexch(C, nruns, exchArgs{:});
  dRE = dC(r, :);
  X = C(r, :);
end
%=============================================================================
function [candArgs, exchArgs] = splitOptions(args)
  candArgs = {};
  exchArgs = {};
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  for k = 1:2:length(args)
    name = optionName(args{k});
    if strcmp(name, 'bounds')
      candArgs = [candArgs args(k:k + 1)];
    else
      exchArgs = [exchArgs args(k:k + 1)];
    end
  end
end
%=============================================================================
function tf = isOptionName(value)
  tf = false;
  try
    optionName(value);
    tf = true;
  catch
    tf = false;
  end
end
%=============================================================================
function name = optionName(value)
  if ~isTextScalar(value)
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
  text = lower(char(value));
  names = {'bounds', 'avoidduplicates', 'display', 'initialdesign', 'maxiterations', 'options', 'fixedrows', 'numtries'};
  matches = {};
  for k = 1:length(names)
    if strncmp(names{k}, text, length(text))
      matches{end + 1} = names{k};
    end
  end
  if isempty(matches)
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
  if length(matches) > 1
    error('Nelson:statistics:ambiguousNameValue', 'Ambiguous name-value argument name.');
  end
  name = matches{1};
end
%=============================================================================
function value = positiveInteger(value, message)
  if ~isscalar(value) || value <= 0 || floor(value) ~= value
    error('Nelson:statistics:mustBePositiveInteger', message);
  end
end
%=============================================================================
function tf = isTextScalar(value)
  tf = ischar(value) || isStringScalar(value);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [h, p, stats] = runstest(x, varargin)
  narginchk(1, Inf);
  nargoutchk(0, 3);
  [mode, reference, args] = parseLeadingInputsLocal(x, convertStringToCharArgs(varargin));
  opts = parseOptionsLocal(args);
  signs = signsLocal(x, mode, reference);
  [nruns, n1, n0] = runCountsLocal(signs);
  method = selectMethodLocal(opts.Method, mode, length(signs));
  z = zStatisticLocal(nruns, n1, n0);
  if strcmp(method, 'exact') && strcmp(mode, 'ab')
    p = exactPValueLocal(nruns, n1, n0, opts.Tail);
  else
    p = approximatePValueLocal(z, opts.Tail);
  end
  h = p <= opts.Alpha;
  stats = struct('nruns', nruns, 'n1', n1, 'n0', n0, 'z', z);
end
%=============================================================================
function [mode, reference, args] = parseLeadingInputsLocal(x, argsIn)
  mode = 'ab';
  reference = [];
  args = argsIn;
  if isempty(argsIn)
    reference = meanOmitNaNLocal(x);
    return
  end
  first = argsIn{1};
  if isTextScalarLocal(first)
    if strcmpi(char(first), 'ud')
      mode = 'ud';
      args = argsIn(2:end);
    else
      reference = meanOmitNaNLocal(x);
    end
  elseif isnumeric(first) && isreal(first) && isscalar(first)
    reference = double(first);
    args = argsIn(2:end);
  else
    error('Nelson:statistics:referenceValueRealNumericScalar', 'Reference value must be a real numeric scalar or ''ud''.');
  end
  if isempty(reference) && strcmp(mode, 'ab')
    reference = meanOmitNaNLocal(x);
  end
end
%=============================================================================
function opts = parseOptionsLocal(args)
  opts = struct('Alpha', 0.05, 'Method', 'auto', 'Tail', 'both');
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  k = 1;
  while k <= length(args)
    name = lower(char(args{k}));
    switch name
      case 'alpha'
        opts.Alpha = parseAlphaLocal(args{k + 1});
      case 'method'
        opts.Method = parseChoiceLocal(args{k + 1}, {'auto', 'exact', 'approximate'}, 'METHOD');
      case 'tail'
        opts.Tail = parseChoiceLocal(args{k + 1}, {'both', 'right', 'left'}, 'TAIL');
      otherwise
        error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
    end
    k = k + 2;
  end
end
%=============================================================================
function signs = signsLocal(x, mode, reference)
  values = validateVectorLocal(x);
  if strcmp(mode, 'ud')
    d = diff(values);
    d = d(~isnan(d) & d ~= 0);
    signs = d > 0;
  else
    values = values(~isnan(values));
    values = values(values ~= reference);
    signs = values > reference;
  end
  if length(signs) < 2 || all(signs) || ~any(signs)
    error('Nelson:statistics:xContainLeastOneValue', 'X must contain at least one value in each run category.');
  end
end
%=============================================================================
function values = validateVectorLocal(x)
  if ~(isnumeric(x) && isreal(x) && ~issparse(x) && isvector(x))
    error('Nelson:statistics:xRealNumericVector', '%s must be a real numeric vector.', 'X');
  end
  values = double(x(:));
end
%=============================================================================
function [nruns, n1, n0] = runCountsLocal(signs)
  signs = logical(signs(:));
  n1 = sum(signs);
  n0 = length(signs) - n1;
  nruns = 1 + sum(signs(2:end) ~= signs(1:end - 1));
end
%=============================================================================
function method = selectMethodLocal(method, mode, n)
  if strcmp(method, 'auto')
    if strcmp(mode, 'ud') && n > 50
      method = 'approximate';
    elseif strcmp(mode, 'ab')
      method = 'exact';
    else
      method = 'approximate';
    end
  end
  if strcmp(mode, 'ud') && strcmp(method, 'exact')
    method = 'approximate';
  end
end
%=============================================================================
function z = zStatisticLocal(nruns, n1, n0)
  n = n1 + n0;
  mu = 2 * n1 * n0 / n + 1;
  variance = 2 * n1 * n0 * (2 * n1 * n0 - n) / (n ^ 2 * (n - 1));
  if variance <= 0
    z = NaN;
  else
    z = (nruns - mu) / sqrt(variance);
  end
end
%=============================================================================
function p = approximatePValueLocal(z, tail)
  switch tail
    case 'right'
      p = normcdf(z, 0, 1, 'upper');
    case 'left'
      p = normcdf(z, 0, 1);
    otherwise
      p = 2 * normcdf(-abs(z), 0, 1);
  end
end
%=============================================================================
function p = exactPValueLocal(nruns, n1, n0, tail)
  lo = 2;
  hi = 2 * min(n1, n0) + double(n1 ~= n0);
  runs = lo:hi;
  probs = zeros(size(runs));
  for k = 1:length(runs)
    probs(k) = exactRunProbabilityLocal(runs(k), n1, n0);
  end
  switch tail
    case 'right'
      p = sum(probs(runs >= nruns));
    case 'left'
      p = sum(probs(runs <= nruns));
    otherwise
      left = sum(probs(runs <= nruns));
      right = sum(probs(runs >= nruns));
      p = min(1, 2 * min(left, right));
  end
end
%=============================================================================
function p = exactRunProbabilityLocal(runs, n1, n0)
  totalLog = gammaln(n1 + n0 + 1) - gammaln(n1 + 1) - gammaln(n0 + 1);
  if rem(runs, 2) == 0
    k = runs / 2;
    value = 2 * combinationLocal(n1 - 1, k - 1) * combinationLocal(n0 - 1, k - 1);
  else
    k = (runs - 1) / 2;
    value = combinationLocal(n1 - 1, k) * combinationLocal(n0 - 1, k - 1) ...
      + combinationLocal(n1 - 1, k - 1) * combinationLocal(n0 - 1, k);
  end
  p = value / exp(totalLog);
end
%=============================================================================
function c = combinationLocal(n, k)
  if k < 0 || k > n
    c = 0;
  else
    c = exp(gammaln(n + 1) - gammaln(k + 1) - gammaln(n - k + 1));
  end
end
%=============================================================================
function value = meanOmitNaNLocal(x)
  values = validateVectorLocal(x);
  values = values(~isnan(values));
  if isempty(values)
    error('Nelson:statistics:xAllNaN', 'X must contain at least one non-NaN value.');
  end
  value = mean(values);
end
%=============================================================================
function value = parseAlphaLocal(value)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && value > 0 && value < 1)
    error('Nelson:statistics:alphaOutOfRange', '%s must be a scalar in the range (0,1).', 'ALPHA');
  end
  value = double(value);
end
%=============================================================================
function value = parseChoiceLocal(value, choices, name)
  if ~(ischar(value) || (isstring(value) && isscalar(value)))
    error('Nelson:statistics:invalidValue:valueHasUnsupportedValue', '%s has an unsupported value.', name);
  end
  text = lower(char(value));
  matches = choices(startsWith(choices, text));
  if length(matches) ~= 1
    error('Nelson:statistics:invalidValue:valueHasUnsupportedValue', '%s has an unsupported value.', name);
  end
  value = matches{1};
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [tf, history] = sequentialfs(fun, varargin)
  narginchk(2, Inf);
  nargoutchk(0, 2);
  if ~isfunction_handle(fun)
    error('Nelson:statistics:FUNFunctionHandle', '%s must be a function handle.', 'FUN');
  end
  [data, opts] = parseInputsLocal(varargin);
  validateDataLocal(data);
  nfeatures = size(data{1}, 2);
  opts = finalizeOptionsLocal(opts, nfeatures);
  [tf, history] = selectFeaturesLocal(fun, data, opts);
end
%=============================================================================
function [data, opts] = parseInputsLocal(args)
  names = {'cv', 'mcreps', 'direction', 'keepin', 'keepout', ...
    'nfeatures', 'nullmodel', 'options'};
  firstName = length(args) + 1;
  for k = 1:length(args)
    if isTextScalarLocal(args{k}) && any(strcmpi(char(args{k}), names))
      firstName = k;
      break
    end
  end
  data = args(1:firstName - 1);
  if isempty(data)
    error('Nelson:statistics:leastOneDataArgumentRequired', 'At least one %s is required.', 'data input');
  end
  opts = defaultOptionsLocal();
  nv = args(firstName:end);
  if rem(length(nv), 2) ~= 0
    error('Nelson:statistics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  for k = 1:2:length(nv)
    name = lower(char(nv{k}));
    value = nv{k + 1};
    switch name
      case 'cv'
        opts.CV = value;
      case 'mcreps'
        opts.MCReps = value;
      case 'direction'
        opts.Direction = parseDirectionLocal(value);
      case 'keepin'
        opts.KeepIn = value;
      case 'keepout'
        opts.KeepOut = value;
      case 'nfeatures'
        opts.NFeatures = value;
      case 'nullmodel'
        opts.NullModel = parseLogicalScalarLocal(value, 'NullModel');
      case 'options'
        opts.Options = value;
      otherwise
        error('Nelson:statistics:unknownOption', 'Unknown option.');
    end
  end
end
%=============================================================================
function opts = defaultOptionsLocal()
  opts = struct('CV', 10, 'MCReps', 1, 'Direction', 'forward', ...
    'KeepIn', [], 'KeepOut', [], 'NFeatures', [], ...
    'NullModel', false, 'Options', []);
end
%=============================================================================
function validateDataLocal(data)
  nobs = size(data{1}, 1);
  if ~(isnumeric(data{1}) && isreal(data{1}) && ~issparse(data{1}) && ndims(data{1}) == 2)
    error('Nelson:statistics:firstDataInputRealNumeric', '%s must be a real numeric matrix.', 'First data input');
  end
  if isempty(data{1})
    error('Nelson:validators:mustBeNonempty', '%s must be nonempty.', 'First data input');
  end
  for k = 1:length(data)
    if size(data{k}, 1) ~= nobs
      error('Nelson:statistics:allDataInputsSameNumber', '%s must have the same number of rows.', 'All data inputs');
    end
  end
end
%=============================================================================
function opts = finalizeOptionsLocal(opts, nfeatures)
  opts.KeepIn = parseFeatureMaskLocal(opts.KeepIn, nfeatures, false, 'KeepIn');
  opts.KeepOut = parseFeatureMaskLocal(opts.KeepOut, nfeatures, false, 'KeepOut');
  if any(opts.KeepIn & opts.KeepOut)
    error('Nelson:statistics:keepInKeepOutOverlap', 'KeepIn and KeepOut must not overlap.');
  end
  opts.NFeatures = parseNFeaturesLocal(opts.NFeatures, nfeatures);
  opts.MCReps = parsePositiveIntegerLocal(opts.MCReps, 'MCReps');
  opts.CV = parseCVLocal(opts.CV);
  opts.Options = parseOptionsLocal(opts.Options, nfeatures);
end
%=============================================================================
function value = parseDirectionLocal(value)
  if ~isTextScalarLocal(value)
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Direction');
  end
  value = lower(char(value));
  choices = {'forward', 'backward'};
  matches = choices(strncmp(choices, value, length(value)));
  if isempty(matches)
    error('Nelson:statistics:invalidDirectionValue', 'Invalid %s value.', 'Direction');
  end
  if length(matches) > 1
    error('Nelson:statistics:ambiguousValue', 'Ambiguous %s value.', 'Direction');
  end
  value = matches{1};
end
%=============================================================================
function mask = parseFeatureMaskLocal(value, nfeatures, defaultValue, name)
  mask = repmat(defaultValue, 1, nfeatures);
  if isempty(value)
    return
  end
  if islogical(value) && isvector(value)
    if length(value) ~= nfeatures
      error('Nelson:statistics:mustMatchFeatures', '%s must match the number of features.', name);
    end
    mask = value(:)' ~= 0;
  elseif isnumeric(value) && isreal(value) && isvector(value)
    idx = double(value(:))';
    if any(~isfinite(idx)) || any(floor(idx) ~= idx) || any(idx < 1) || any(idx > nfeatures)
      error('Nelson:statistics:invalidFeatureIndices', '%s contains invalid feature indices.', name);
    end
    mask(:) = false;
    mask(idx) = true;
  else
    error('Nelson:statistics:invalidValue:valueHasInvalidValue', '%s has an invalid value.', name);
  end
end
%=============================================================================
function value = parseNFeaturesLocal(value, nfeatures)
  if isempty(value)
    return
  end
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) ...
      && floor(value) == value && value >= 0 && value <= nfeatures)
    error('Nelson:statistics:nFeaturesIntegerScalarBetween0', 'NFeatures must be an integer scalar between 0 and the number of features.');
  end
  value = double(value);
end
%=============================================================================
function value = parseCVLocal(value)
  if isTextScalarLocal(value)
    value = lower(char(value));
    if ~any(strcmp(value, {'none', 'resubstitution'}))
      error('Nelson:statistics:CVInvalidValue', '%s has an invalid value.', 'CV');
    end
  elseif isnumeric(value) && isreal(value) && isscalar(value)
    value = parsePositiveIntegerLocal(value, 'CV');
  else
    error('Nelson:statistics:CVPositiveIntegerNoneResubstitution', 'CV must be a positive integer, none, or resubstitution.');
  end
end
%=============================================================================
function options = parseOptionsLocal(options, nfeatures)
  if isempty(options)
    options = statset();
  elseif ~(isstruct(options) && isscalar(options))
    error('Nelson:statistics:invalidOptions', '%s must be a scalar structure.', 'Options');
  end
  displayValue = statget(options, 'Display', 'off');
  if ~isTextScalarLocal(displayValue)
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Options Display');
  end
  options.Display = lower(char(displayValue));
  options.MaxIter = statget(options, 'MaxIter', nfeatures);
  options.TolFun = statget(options, 'TolFun', 1e-6);
  if ~any(strcmp(options.Display, {'off', 'final', 'iter'}))
    error('Nelson:statistics:optionsDisplayInvalidValue', '%s has an invalid value.', 'Options Display');
  end
  if ~isPositiveIntegerLocal(options.MaxIter)
    error('Nelson:statistics:optionsMaxIterPositiveIntegerScalar', '%s must be a positive integer scalar.', 'Options MaxIter');
  end
  if ~(isnumeric(options.TolFun) && isreal(options.TolFun) && isscalar(options.TolFun) ...
      && isfinite(options.TolFun) && options.TolFun >= 0)
    error('Nelson:statistics:optionsTolFunNonnegativeScalar', '%s must be a nonnegative scalar.', 'Options TolFun');
  end
end
%=============================================================================
function [tf, history] = selectFeaturesLocal(fun, data, opts)
  if strcmp(opts.Direction, 'backward')
    [tf, history] = backwardLocal(fun, data, opts);
  else
    [tf, history] = forwardLocal(fun, data, opts);
  end
end
%=============================================================================
function [tf, history] = forwardLocal(fun, data, opts)
  tf = opts.KeepIn;
  available = ~(opts.KeepOut | tf);
  currentCrit = initialCriterionLocal(fun, data, tf, opts, Inf);
  history = appendHistoryLocal([], tf, currentCrit);
  for iter = 1:opts.Options.MaxIter
    if reachedTargetLocal(tf, opts, 'forward')
      break
    end
    [candidate, bestCrit] = bestForwardCandidateLocal(fun, data, tf, available, opts);
    if candidate == 0 || (~isinf(currentCrit) && currentCrit - bestCrit <= opts.Options.TolFun)
      break
    end
    tf(candidate) = true;
    available(candidate) = false;
    currentCrit = bestCrit;
    history = appendHistoryLocal(history, tf, currentCrit);
    displayStepLocal(opts, iter, 'added', candidate, currentCrit);
  end
end
%=============================================================================
function [tf, history] = backwardLocal(fun, data, opts)
  tf = ~opts.KeepOut;
  currentCrit = criterionLocal(fun, data, tf, opts);
  history = appendHistoryLocal([], tf, currentCrit);
  for iter = 1:opts.Options.MaxIter
    if reachedTargetLocal(tf, opts, 'backward')
      break
    end
    removable = find(tf & ~opts.KeepIn);
    [candidate, bestCrit] = bestBackwardCandidateLocal(fun, data, tf, removable, opts);
    if candidate == 0 || currentCrit - bestCrit <= opts.Options.TolFun
      break
    end
    tf(candidate) = false;
    currentCrit = bestCrit;
    history = appendHistoryLocal(history, tf, currentCrit);
    displayStepLocal(opts, iter, 'removed', candidate, currentCrit);
  end
end
%=============================================================================
function crit = initialCriterionLocal(fun, data, tf, opts, defaultValue)
  if opts.NullModel || any(tf)
    crit = criterionLocal(fun, data, tf, opts);
  else
    crit = defaultValue;
  end
end
%=============================================================================
function [candidate, bestCrit] = bestForwardCandidateLocal(fun, data, tf, available, opts)
  candidate = 0;
  bestCrit = Inf;
  candidates = find(available);
  for i = 1:length(candidates)
    trial = tf;
    trial(candidates(i)) = true;
    crit = criterionLocal(fun, data, trial, opts);
    if crit < bestCrit
      bestCrit = crit;
      candidate = candidates(i);
    end
  end
end
%=============================================================================
function [candidate, bestCrit] = bestBackwardCandidateLocal(fun, data, tf, removable, opts)
  candidate = 0;
  bestCrit = Inf;
  for i = 1:length(removable)
    trial = tf;
    trial(removable(i)) = false;
    if ~opts.NullModel && ~any(trial)
      continue
    end
    crit = criterionLocal(fun, data, trial, opts);
    if crit < bestCrit
      bestCrit = crit;
      candidate = removable(i);
    end
  end
end
%=============================================================================
function tf = reachedTargetLocal(selected, opts, direction)
  tf = false;
  if isempty(opts.NFeatures)
    return
  end
  if strcmp(direction, 'forward')
    tf = sum(selected) >= opts.NFeatures;
  else
    tf = sum(selected) <= opts.NFeatures;
  end
end
%=============================================================================
function crit = criterionLocal(fun, data, selected, opts)
  if ischar(opts.CV) && strcmp(opts.CV, 'none')
    args = subsetDataLocal(data, selected, []);
    crit = feval(fun, args{:});
  elseif ischar(opts.CV) && strcmp(opts.CV, 'resubstitution')
    args = [subsetDataLocal(data, selected, []), subsetDataLocal(data, selected, [])];
    crit = feval(fun, args{:});
  else
    crit = kfoldCriterionLocal(fun, data, selected, opts.CV);
  end
  if ~(isnumeric(crit) && isreal(crit) && isscalar(crit) && isfinite(crit))
    error('Nelson:statistics:criterionFunctionReturnFiniteReal', 'Criterion function must return a finite real scalar.');
  end
  crit = double(crit);
end
%=============================================================================
function crit = kfoldCriterionLocal(fun, data, selected, kfold)
  nobs = size(data{1}, 1);
  kfold = min(kfold, nobs);
  fold = rem(0:nobs - 1, kfold) + 1;
  total = 0;
  totalTest = 0;
  for k = 1:kfold
    test = fold(:) == k;
    train = ~test;
    args = [subsetDataLocal(data, selected, train), subsetDataLocal(data, selected, test)];
    value = feval(fun, args{:});
    total = total + double(value);
    totalTest = totalTest + sum(test);
  end
  crit = total / max(totalTest, 1);
end
%=============================================================================
function out = subsetDataLocal(data, selected, rows)
  out = cell(1, length(data));
  for k = 1:length(data)
    value = data{k};
    if isempty(rows)
      rowIdx = 1:size(value, 1);
    else
      rowIdx = rows;
    end
    if k == 1
      out{k} = value(rowIdx, selected);
    else
      out{k} = value(rowIdx, :);
    end
  end
end
%=============================================================================
function history = appendHistoryLocal(history, tf, crit)
  if isempty(history)
    history = struct('In', logical(tf), 'Crit', crit);
  else
    history.In(end + 1, :) = logical(tf);
    history.Crit(end + 1) = crit;
  end
end
%=============================================================================
function displayStepLocal(opts, iter, action, column, crit)
  if strcmp(opts.Options.Display, 'iter')
    disp(['Step ', int2str(iter), ', ', action, ' column ', ...
      int2str(column), ', criterion value ', num2str(crit)]);
  elseif strcmp(opts.Options.Display, 'final')
    return
  end
end
%=============================================================================
function value = parsePositiveIntegerLocal(value, name)
  if ~isPositiveIntegerLocal(value)
    error('Nelson:statistics:mustBePositiveInteger', '%s must be a positive integer scalar.', name);
  end
  value = double(value);
end
%=============================================================================
function tf = parseLogicalScalarLocal(value, name)
  if islogical(value) && isscalar(value)
    tf = value ~= 0;
  elseif isnumeric(value) && isscalar(value) && (value == 0 || value == 1)
    tf = value ~= 0;
  else
    error('Nelson:validators:mustBeLogicalScalar', '%s must be a logical scalar.', name);
  end
end
%=============================================================================
function tf = isPositiveIntegerLocal(value)
  tf = isnumeric(value) && isreal(value) && isscalar(value) ...
    && isfinite(value) && floor(value) == value && value > 0;
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || isStringScalar(value);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [p, h, stats] = signrank(x, y, varargin)
  narginchk(1, Inf);
  nargoutchk(0, 3);
  if nargin < 2
    [diffValues, args] = pairedDifferencesLocal(x, [], varargin, false);
  else
    [diffValues, args] = pairedDifferencesLocal(x, y, varargin, true);
  end
  opts = parseOptionsLocal(convertStringToCharArgs(args));
  [signedRank, tieSum, hasTies, ranks] = signedRankLocal(diffValues);
  method = selectMethodLocal(opts.Method, length(ranks), hasTies);
  if strcmp(method, 'exact')
    p = exactPValueLocal(signedRank, length(ranks), opts.Tail);
    zval = [];
  else
    [p, zval] = approximatePValueLocal(signedRank, ranks, opts.Tail);
  end
  h = p <= opts.Alpha;
  stats = struct('signedrank', signedRank);
  if ~isempty(zval)
    stats.zval = zval;
  end
end
%=============================================================================
function [diffValues, args] = pairedDifferencesLocal(x, y, argsIn, hasY)
  args = argsIn;
  if ~hasY || isTextScalarLocal(y)
    if hasY
      args = [{y}, argsIn];
    end
    diffValues = validateVectorLocal(x, 'X');
  else
    diffValues = pairDifferenceLocal(x, y);
  end
  diffValues = diffValues(:);
  diffValues = diffValues(~isnan(diffValues));
  diffValues = diffValues(diffValues ~= 0);
  if isempty(diffValues)
    error('Nelson:statistics:xYNonzeroDifference', 'X and Y must contain at least one nonzero non-NaN difference.');
  end
end
%=============================================================================
function values = validateVectorLocal(values, name)
  if ~(isnumeric(values) && isreal(values) && ~issparse(values) && isvector(values))
    error('Nelson:statistics:mustBeRealVector', '%s must be a real numeric vector.', name);
  end
  values = double(values(:));
end
%=============================================================================
function diffValues = pairDifferenceLocal(x, y)
  x = validateVectorLocal(x, 'X');
  if ~(isnumeric(y) && isreal(y) && ~issparse(y))
    error('Nelson:statistics:yRealNumericScalarVector', '%s must be a real numeric scalar or vector.', 'Y');
  end
  if isscalar(y)
    diffValues = x - double(y);
  elseif isvector(y)
    y = double(y(:));
    if length(x) ~= length(y)
      error('Nelson:statistics:xYSameNumberObservations', 'X and Y must have %s.', 'the same number of observations');
    end
    diffValues = x - y;
  else
    error('Nelson:statistics:yRealNumericScalarVector', '%s must be a real numeric scalar or vector.', 'Y');
  end
end
%=============================================================================
function opts = parseOptionsLocal(args)
  opts = struct('Alpha', 0.05, 'Tail', 'both', 'Method', 'auto');
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  for k = 1:2:length(args)
    if ~isTextScalarLocal(args{k})
      error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Name');
    end
    name = lower(char(args{k}));
    switch name
      case 'alpha'
        opts.Alpha = parseAlphaLocal(args{k + 1});
      case 'tail'
        opts.Tail = parseChoiceLocal(args{k + 1}, {'both', 'right', 'left'}, 'TAIL');
      case 'method'
        opts.Method = parseChoiceLocal(args{k + 1}, {'auto', 'exact', 'approximate'}, 'METHOD');
      otherwise
        error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
    end
  end
end
%=============================================================================
function alpha = parseAlphaLocal(value)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) ...
      && value > 0 && value < 1)
    error('Nelson:statistics:alphaOutOfRange', '%s must be a scalar in the range (0,1).', 'ALPHA');
  end
  alpha = double(value);
end
%=============================================================================
function value = parseChoiceLocal(value, choices, name)
  if ~isTextScalarLocal(value)
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', name);
  end
  text = lower(char(value));
  matches = choices(startsWith(choices, text));
  if length(matches) ~= 1
    error('Nelson:statistics:invalidValue:valueHasUnsupportedValue', '%s has an unsupported value.', name);
  end
  value = matches{1};
end
%=============================================================================
function [signedRank, tieSum, hasTies, ranks] = signedRankLocal(diffValues)
  [ranks, tieSum] = tiedRanksLocal(abs(diffValues));
  signedRank = sum(ranks(diffValues > 0));
  hasTies = tieSum ~= 0;
end
%=============================================================================
function method = selectMethodLocal(method, n, hasTies)
  if strcmp(method, 'exact') && hasTies
    error('Nelson:statistics:exactMethodSupportedTiesPresent', 'Exact method is not supported when ties are present.');
  end
  if strcmp(method, 'auto')
    if ~hasTies && n <= 20
      method = 'exact';
    else
      method = 'approximate';
    end
  end
end
%=============================================================================
function p = exactPValueLocal(signedRank, n, tail)
  counts = exactSignedRankCountsLocal(n);
  idx = round(signedRank) + 1;
  total = sum(counts);
  switch tail
    case 'left'
      p = sum(counts(1:idx)) / total;
    case 'right'
      p = sum(counts(idx:end)) / total;
    otherwise
      lo = sum(counts(1:idx)) / total;
      hi = sum(counts(idx:end)) / total;
      p = min(1, 2 * min(lo, hi));
  end
end
%=============================================================================
function counts = exactSignedRankCountsLocal(n)
  maxSum = n * (n + 1) / 2;
  counts = zeros(1, maxSum + 1);
  counts(1) = 1;
  for r = 1:n
    counts(r + 1:end) = counts(r + 1:end) + counts(1:end - r);
  end
end
%=============================================================================
function [p, zval] = approximatePValueLocal(signedRank, ranks, tail)
  mu = sum(ranks) / 2;
  sigma = sqrt(sum(ranks .^ 2) / 4);
  if sigma == 0
    zval = 0;
    p = 1;
    return
  end
  switch tail
    case 'left'
      zval = (signedRank - mu + 0.5) / sigma;
      p = normcdf(zval, 0, 1);
    case 'right'
      zval = (signedRank - mu - 0.5) / sigma;
      p = normcdf(zval, 0, 1, 'upper');
    otherwise
      zval = (abs(signedRank - mu) - 0.5) / sigma;
      p = 2 * normcdf(-abs(zval), 0, 1);
  end
end
%=============================================================================
function [ranks, tieSum] = tiedRanksLocal(values)
  [sortedValues, order] = sort(values(:));
  n = length(sortedValues);
  ranks = zeros(n, 1);
  tieSum = 0;
  starts = [1; find(diff(sortedValues) ~= 0) + 1];
  stops = [starts(2:end) - 1; n];
  for k = 1:length(starts)
    rows = starts(k):stops(k);
    ranks(order(rows)) = (starts(k) + stops(k)) / 2;
    tieLength = stops(k) - starts(k) + 1;
    tieSum = tieSum + tieLength ^ 3 - tieLength;
  end
end
function tf = isTextScalarLocal(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [p, h, stats] = signtest(x, y, varargin)
  narginchk(1, Inf);
  nargoutchk(0, 3);
  if nargin < 2
    [diffValues, args] = differencesLocal(x, [], varargin, false);
  else
    [diffValues, args] = differencesLocal(x, y, varargin, true);
  end
  opts = parseOptionsLocal(convertStringToCharArgs(args));
  nPositive = sum(diffValues > 0);
  n = length(diffValues);
  method = selectMethodLocal(opts.Method, n);
  if strcmp(method, 'exact')
    p = exactPValueLocal(nPositive, n, opts.Tail);
    zval = NaN;
  else
    [p, zval] = approximatePValueLocal(nPositive, n, opts.Tail);
  end
  h = p <= opts.Alpha;
  stats = struct('sign', nPositive, 'zval', zval);
end
%=============================================================================
function [diffValues, args] = differencesLocal(x, y, argsIn, hasY)
  args = argsIn;
  if ~hasY || isTextScalarLocal(y)
    if hasY
      args = [{y}, argsIn];
    end
    diffValues = validateVectorLocal(x, 'X');
  else
    diffValues = pairDifferenceLocal(x, y);
  end
  diffValues = diffValues(:);
  diffValues = diffValues(~isnan(diffValues));
  diffValues = diffValues(diffValues ~= 0);
  if isempty(diffValues)
    error('Nelson:statistics:xYNonzeroDifference', 'X and Y must contain at least one nonzero non-NaN difference.');
  end
end
%=============================================================================
function values = validateVectorLocal(values, name)
  if ~(isnumeric(values) && isreal(values) && ~issparse(values) && isvector(values))
    error('Nelson:statistics:mustBeRealVector', '%s must be a real numeric vector.', name);
  end
  values = double(values(:));
end
%=============================================================================
function diffValues = pairDifferenceLocal(x, y)
  x = validateVectorLocal(x, 'X');
  if ~(isnumeric(y) && isreal(y) && ~issparse(y))
    error('Nelson:statistics:yRealNumericScalarVector', '%s must be a real numeric scalar or vector.', 'Y');
  end
  if isscalar(y)
    diffValues = x - double(y);
  elseif isvector(y)
    y = double(y(:));
    if length(x) ~= length(y)
      error('Nelson:statistics:xYSameNumberObservations', 'X and Y must have %s.', 'the same number of observations');
    end
    diffValues = x - y;
  else
    error('Nelson:statistics:yRealNumericScalarVector', '%s must be a real numeric scalar or vector.', 'Y');
  end
end
%=============================================================================
function opts = parseOptionsLocal(args)
  opts = struct('Alpha', 0.05, 'Tail', 'both', 'Method', 'auto');
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  k = 1;
  while k <= length(args)
    name = lower(char(args{k}));
    switch name
      case 'alpha'
        opts.Alpha = parseAlphaLocal(args{k + 1});
      case 'tail'
        opts.Tail = parseChoiceLocal(args{k + 1}, {'both', 'right', 'left'}, 'TAIL');
      case 'method'
        opts.Method = parseChoiceLocal(args{k + 1}, {'auto', 'exact', 'approximate'}, 'METHOD');
      otherwise
        error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
    end
    k = k + 2;
  end
end
%=============================================================================
function value = parseAlphaLocal(value)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && value > 0 && value < 1)
    error('Nelson:statistics:alphaOutOfRange', '%s must be a scalar in the range (0,1).', 'ALPHA');
  end
  value = double(value);
end
%=============================================================================
function value = parseChoiceLocal(value, choices, name)
  if ~(ischar(value) || (isstring(value) && isscalar(value)))
    error('Nelson:statistics:invalidValue:valueHasUnsupportedValue', '%s has an unsupported value.', name);
  end
  text = lower(char(value));
  matches = choices(startsWith(choices, text));
  if length(matches) ~= 1
    error('Nelson:statistics:invalidValue:valueHasUnsupportedValue', '%s has an unsupported value.', name);
  end
  value = matches{1};
end
%=============================================================================
function method = selectMethodLocal(method, n)
  if strcmp(method, 'auto')
    if n < 100
      method = 'exact';
    else
      method = 'approximate';
    end
  end
end
%=============================================================================
function p = exactPValueLocal(nPositive, n, tail)
  switch tail
    case 'right'
      p = binocdf(nPositive - 1, n, 0.5, 'upper');
    case 'left'
      p = binocdf(nPositive, n, 0.5);
    otherwise
      lower = binocdf(nPositive, n, 0.5);
      upper = binocdf(nPositive - 1, n, 0.5, 'upper');
      p = min(1, 2 * min(lower, upper));
  end
end
%=============================================================================
function [p, zval] = approximatePValueLocal(nPositive, n, tail)
  mu = n / 2;
  sigma = sqrt(n / 4);
  switch tail
    case 'right'
      zval = (nPositive - mu - 0.5) / sigma;
      p = normcdf(zval, 0, 1, 'upper');
    case 'left'
      zval = (nPositive - mu + 0.5) / sigma;
      p = normcdf(zval, 0, 1);
    otherwise
      correction = 0.5 * sign(nPositive - mu);
      zval = (nPositive - mu - correction) / sigma;
      p = 2 * normcdf(-abs(zval), 0, 1);
  end
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
