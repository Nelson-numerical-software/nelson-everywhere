% LICENCE_BLOCK_END
%=============================================================================
function W = smooth3(varargin)
  narginchk(1, 4);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [V, method, windowSize, sd] = parseSmooth3Inputs(args);
  W = double(V);
  weights = smooth3KernelWeights(method, windowSize, sd);
  for dim = 1:3
    W = smooth3ApplyWeights(W, weights{dim}, dim);
  end
end
