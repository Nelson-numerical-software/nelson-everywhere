%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('binopdf'), 3);
asserts.isequal(nargout('binopdf'), 1);
%=============================================================================
x = [0 1 2 5 10];
n = [10 10 10 10 10];
p = [0.2 0.2 0.5 0.5 0.8];
R = binopdf(x, n, p);
REF = [0.1073741824 0.268435456 0.0439453125 0.24609375 0.1073741824];
asserts.isapprox(R, REF, 1e-12);
%=============================================================================
R = binopdf([0 10 1.5 -1 11], 10, 0.2);
asserts.isapprox(R, [0.1073741824 0.0000001024 0 0 0], 1e-12);
%=============================================================================
R = binopdf([0 1 10], 10, [0 0 1]);
asserts.isequal(R, [1 0 1]);
%=============================================================================
R = binopdf(single(x), single(n), single(p));
asserts.isequal(class(R), 'single');
asserts.isapprox(R, single(REF), 1e-6);
%=============================================================================
R = binopdf([NaN 1 1 1], [10 -1 2.5 10], [0.5 0.5 0.5 NaN]);
asserts.istrue(all(isnan(R)));
%=============================================================================
R = binopdf([], [], []);
asserts.isequal(size(R), [0 0]);
%=============================================================================
asserts.checkerror('binopdf(ones(2), ones(3), 0.5)', _('Size mismatch on input arguments'));
asserts.checkerror('binopdf({1}, 10, 0.5)', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('binopdf(1, {10}, 0.5)', _('N must be a nonnegative integer numeric array.'));
asserts.checkerror('binopdf(1, 10, {0.5})', _('P must be a numeric array in the range [0,1].'));
%=============================================================================
asserts.isapprox(binopdf(2, 4, 0.5), 0.375, 1e-12);
asserts.istrue(isnan(binopdf(1, 2, -0.1)));
asserts.checkerror('binopdf(1, 2, ''bad'')', _('P must be a numeric array in the range [0,1].'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('binornd'), -1);
asserts.isequal(nargout('binornd'), 1);
%=============================================================================
rng(0, 'twister');
R = binornd(10, 0.3, 2, 3);
REF = [4 1 3; 5 5 1];
asserts.isequal(R, REF);
%=============================================================================
rng(0, 'twister');
U = rand(2, 3);
E = binoinv(U, 10, 0.3);
rng(0, 'twister');
R = binornd(10, 0.3, 2, 3);
asserts.isequal(size(R), [2 3]);
asserts.isequal(R, E);
%=============================================================================
rng(0, 'twister');
U = rand(1, 3);
E = binoinv(U, [5 10 20], [0.2 0.3 0.7]);
rng(0, 'twister');
R = binornd([5 10 20], [0.2 0.3 0.7]);
asserts.isequal(R, E);
%=============================================================================
rng(0, 'twister');
R = binornd(single(10), single(0.3), [2 3]);
asserts.isequal(class(R), 'single');
asserts.isequal(size(R), [2 3]);
R = binornd(10, 0.3, single([2 3]));
asserts.isequal(class(R), 'double');
asserts.isequal(size(R), [2 3]);
%=============================================================================
R = binornd([-1 1.5 NaN], [0.5 0.5 0.5], [1 3]);
asserts.istrue(all(isnan(R)));
R = binornd(10, [-0.1 1.1 NaN], [1 3]);
asserts.istrue(all(isnan(R)));
asserts.isequal(binornd(0, 0.5, 1, 3), zeros(1, 3));
asserts.isequal(binornd(10, 0, 1, 3), zeros(1, 3));
asserts.isequal(binornd(10, 1, 1, 3), 10 * ones(1, 3));
R = binornd(10, 0.3, 0, 3);
asserts.isequal(size(R), [0 3]);
%=============================================================================
asserts.checkerror('binornd(1)', _('Not enough input arguments.'));
asserts.checkerror('binornd([1 2], 1, 2, 2)', _('Size mismatch on input arguments'));
asserts.checkerror('binornd(1, 1, 1.5, 2)', _('Size must contain integer values.'));
asserts.checkerror('binornd({1}, 1)', _('N must be a nonnegative integer numeric array.'));
asserts.checkerror('binornd(1, {1})', _('P must be a numeric array in the range [0,1].'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('binostat'), 2);
asserts.isequal(nargout('binostat'), 2);
%=============================================================================
[m, v] = binostat([10 20], [0.25 0.5]);
asserts.isapprox(m, [2.5 10], 1e-15);
asserts.isapprox(v, [1.875 5], 1e-15);
%=============================================================================
[m, v] = binostat(single([10 20]), single([0.25 0.5]));
asserts.isequal(class(m), 'single');
asserts.isequal(class(v), 'single');
asserts.isapprox(double(m), [2.5 10], 1e-6);
asserts.isapprox(double(v), [1.875 5], 1e-6);
%=============================================================================
[m, v] = binostat([10 1.5 -1 NaN], [0.5 0.5 0.5 0.5]);
asserts.isapprox(m(1), 5, 1e-15);
asserts.isapprox(v(1), 2.5, 1e-15);
asserts.istrue(all(isnan(m(2:4))));
asserts.istrue(all(isnan(v(2:4))));
%=============================================================================
[m, v] = binostat([10 10], [-0.1 1.1]);
asserts.istrue(all(isnan(m)));
asserts.istrue(all(isnan(v)));
%=============================================================================
asserts.checkerror('binostat(ones(2), ones(3))', _('Size mismatch on input arguments'));
asserts.checkerror('binostat({1}, 0.5)', _('N must be a nonnegative integer numeric array.'));
asserts.checkerror('binostat(1, {0.5})', _('P must be a numeric array in the range [0,1].'));
%=============================================================================
[binoMean, binoVariance] = binostat(4, 0.5);
asserts.isequal(binoMean, 2);
asserts.isequal(binoVariance, 1);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--WEIGHT 2-->
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('bootci'), -1);
asserts.isequal(nargout('bootci'), 2);
%=============================================================================
rng('default');
x = (1:10)';
[ci, bootstat] = bootci(40, @mean, x, 'Type', 'percentile');
asserts.isequal(size(ci), [2 1]);
asserts.isequal(size(bootstat), [40 1]);
asserts.istrue(ci(1) <= mean(x));
asserts.istrue(ci(2) >= mean(x));
%=============================================================================
rng(42);
[ci1, bootstat1] = bootci(30, {@bootciTwoStats, x}, 'Type', 'per');
rng(42);
[ci2, bootstat2] = bootci(30, {@bootciTwoStats, x}, 'Type', 'per');
asserts.isequal(ci1, ci2);
asserts.isequal(bootstat1, bootstat2);
asserts.isequal(size(ci1), [2 2]);
asserts.isequal(size(bootstat1), [30 2]);
%=============================================================================
rng(0);
ci = bootci(50, @mean, x, 'Type', 'normal');
asserts.isequal(size(ci), [2 1]);
rng(0);
ci = bootci(50, @mean, x, 'Type', 'cper');
asserts.isequal(size(ci), [2 1]);
rng(0);
ci = bootci(50, @mean, x, 'Type', 'bca');
asserts.isequal(size(ci), [2 1]);
%=============================================================================
rng(1);
ci = bootci(30, {@bootciMeanSum, x, x + 1}, 'Alpha', 0.1, 'Type', 'per');
asserts.isequal(size(ci), [2 1]);
%=============================================================================
rng(1);
ci = bootci(30, {@mean, x}, 'Weights', [ones(9, 1); 10], 'Type', 'per');
asserts.isequal(size(ci), [2 1]);
%=============================================================================
opts = statset('bootci');
asserts.isequal(opts.UseParallel, false);
%=============================================================================
asserts.checkerror('bootci()', _('Not enough input arguments.'));
asserts.checkerror('bootci(0, @mean, x)', sprintf(_('%s must be a positive integer scalar.'), 'NBOOT'));
asserts.checkerror('bootci(10, ''mean'', x)', sprintf(_('%s must be a function handle.'), 'BOOTFUN'));
asserts.checkerror('bootci(10, @mean, 1)', sprintf(_('At least one %s is required.'), 'nonscalar data argument'));
asserts.checkerror('bootci(10, @mean, x, ''Alpha'', 2)', _('Alpha must be a scalar between 0 and 1.'));
asserts.checkerror('bootci(10, @mean, x, ''Type'', ''bad'')', sprintf(_('Invalid %s value.'), 'Type'));
asserts.checkerror('bootci(10, @mean, x, ''Type'', ''student'')', _('Studentized bootstrap confidence intervals are not yet supported.'));
asserts.checkerror('bootci(10, @mean, x, ''Weights'', ones(2, 1))', _('Weights must be a nonnegative vector with one value per observation.'));
%=============================================================================
function y = bootciTwoStats(x)
  y = [mean(x) std(x)];
end
%=============================================================================
function y = bootciMeanSum(a, b)
  y = mean(a + b);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--WEIGHT 2-->
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('bootstrp'), -1);
asserts.isequal(nargout('bootstrp'), 2);
%=============================================================================
rng('default');
x = (1:10)';
[bootstat, bootsam] = bootstrp(25, @mean, x);
asserts.isequal(size(bootstat), [25 1]);
asserts.isequal(size(bootsam), [10 25]);
asserts.istrue(all(bootsam(:) >= 1));
asserts.istrue(all(bootsam(:) <= 10));
%=============================================================================
rng(42);
[bootstat1, bootsam1] = bootstrp(20, @bootstrpTwoStats, x);
rng(42);
[bootstat2, bootsam2] = bootstrp(20, @bootstrpTwoStats, x);
asserts.isequal(bootstat1, bootstat2);
asserts.isequal(bootsam1, bootsam2);
asserts.isequal(size(bootstat1), [20 2]);
%=============================================================================
rng(1);
bootstat = bootstrp(15, @bootstrpMeanSum, x, x + 1);
asserts.isequal(size(bootstat), [15 1]);
%=============================================================================
rng(2);
[bootstat, bootsam] = bootstrp(12, [], x);
asserts.isequal(bootstat, []);
asserts.isequal(size(bootsam), [10 12]);
%=============================================================================
rng(3);
[bootstat, bootsam] = bootstrp(18, @mean, 1:10);
asserts.isequal(size(bootstat), [18 1]);
asserts.isequal(size(bootsam), [10 18]);
%=============================================================================
rng(4);
bootstat = bootstrp(20, @mean, x, 'Weights', [ones(9, 1); 10]);
asserts.isequal(size(bootstat), [20 1]);
%=============================================================================
opts = statset('bootstrp');
asserts.isequal(opts.UseParallel, false);
opts = statset(opts, 'UseSubstreams', true);
bootstat = bootstrp(5, @mean, x, 'Options', opts);
asserts.isequal(size(bootstat), [5 1]);
%=============================================================================
asserts.checkerror('bootstrp()', _('Not enough input arguments.'));
asserts.checkerror('bootstrp(0, @mean, x)', sprintf(_('%s must be a positive integer scalar.'), 'NBOOT'));
asserts.checkerror('bootstrp(10, ''mean'', x)', _('BOOTFUN must be empty or a function handle.'));
asserts.checkerror('bootstrp(10, @mean, 1)', sprintf(_('At least one %s is required.'), 'nonscalar data argument'));
asserts.checkerror('bootstrp(10, @mean, x, ''Weights'', ones(2, 1))', _('Weights must be a nonnegative vector with one value per observation.'));
asserts.checkerror('bootstrp(10, @mean, x, ''Options'', 1)', _('Options must be a structure.'));
asserts.checkerror('bootstrp(10, @mean, x, ''Unknown'', 1)', _('Invalid name-value argument name.'));
%=============================================================================
function y = bootstrpTwoStats(x)
  y = [mean(x) std(x)];
end
%=============================================================================
function y = bootstrpMeanSum(a, b)
  y = mean(a + b);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
