function tf = run_shouldRetryCase(testCase, retryOnlyOn)
  outcome = run_normalizeStatus(testCase);
  policies = run_retryPolicies(retryOnlyOn);
  tf = any(strcmp(policies, 'all')) || any(strcmp(policies, outcome));
end
