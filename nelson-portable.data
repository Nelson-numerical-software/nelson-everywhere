%=============================================================================
function [B, I] = topkrows(A, k, direction)
  narginchk(2, 3);
  if nargin < 3
    direction = 'descend';
  end
  [S, order] = sort(A);
  if strcmpi(direction, 'descend')
    order = flipud(order(:));
    S = S(order);
  end
  I = order(1:k);
  B = A(I);
end
