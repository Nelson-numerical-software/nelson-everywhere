function count = run_countUnsuccessful(raw)
  count = 0;
  cases = run_resultCases(raw);
  for k = 1:length(cases)
    if ~strcmp(run_normalizeStatus(cases(k)), 'passed') && ~strcmp(run_normalizeStatus(cases(k)), 'skipped')
      count = count + 1;
    end
  end
end
