% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function unsetenv(env_name)
  narginchk(1, 1);
  nargoutchk(0, 0);
  if ~(ischar(env_name) || (isStringScalar(env_name)))
    error('Nelson:unsetenv:invalidInputType', 'Wrong type for argument #%d: %s expected.', 1, 'string');
  end
  setenv(char(env_name));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function A = compan(c)
  narginchk(1, 1);
  if ~isvector(c)
    error('Nelson:compan:vectorExpected', 'Input argument must be a vector.');
  end
  c = c(:).';
  n = length(c);
  if n <= 1
    A = [];
  else
    A = zeros(n - 1, n - 1, class(c));
    A(1, :) = -c(2:n) / c(1);
    if n > 2
      A(2:n - 1, 1:n - 2) = eye(n - 2, class(c));
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = deconv(varargin)

  narginchk(2, 2);
  nargoutchk(0, 2);
  b = varargin{1};
  a = varargin{2};

  if (~(isvector(a) && isvector(b)))
    error('Nelson:deconv:vectorExpected', 'B and A must be vectors.');
  end

  if ((size(b, 1) && size(a, 2)) || (size(b, 2) && size(a, 1)))
    a = a.';
  end
  if a(1) == 0
    error('Nelson:deconv:leadingCoefficientZero', 'First coefficient of A must be nonzero.');
  end
  if isscalar(a)
    q = b / a;
    varargout{1} = q;
    varargout{2} = zeros(size(b), class(q));
    return;
  end

  [mb, nb] = size(b);
  nb = max(mb, nb);
  na = length(a);

  % result is single if B or A is single
  if issingle(b) || issingle(a)
    outclass = 'single';
  else
    outclass = 'double';
  end

  if (na > nb) || all(a == 0)
    q = zeros(1, 1, outclass);
    varargout{1} = q;
    varargout{2} = cast(b, class(q));
    return;
  end

  if nb - na + 1 <= 0
    q = zeros(1, 1, outclass);
  else
    q = zeros(1, nb - na + 1, outclass);
  end
  r = cast(b, outclass);

  for i = 1:nb - na + 1
    if (r(i) ~= 0)
      q(i) = r(i) / a(1);
      for j = 1:na
        r(i + j - 1) = r(i + j - 1) - q(i) * a(j);
      end
    end
  end
  if mb ~= 1
    q = q(:);
  end

  varargout{1} = q;
  varargout{2} = r;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function pp = mkpp(breaks, coefs, d)
  narginchk(2, 3);
  nargoutchk(0, 1);
  if nargin < 3
    d = 1;
  end
  if ~isvector(breaks) || numel(breaks) < 2
    error('Nelson:mkpp:invalidBreaks', 'BREAKS must be a vector with at least two elements.');
  end
  breaks = full(breaks(:)).';
  pieces = numel(breaks) - 1;
  dprod = prod(d);
  order = size(coefs, 2);
  if ndims(coefs) > 2
    error('Nelson:mkpp:invalidCoefs', 'COEFS must be a matrix.');
  end
  if size(coefs, 1) ~= pieces * dprod
    error('Nelson:mkpp:invalidCoefsSize', 'The number of rows of COEFS must equal PIECES times PROD(D).');
  end
  pp = struct('form', 'pp', 'breaks', breaks, 'coefs', coefs, ...
    'pieces', pieces, 'order', order, 'dim', d);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function p = poly(r)
  narginchk(1, 1);
  nargoutchk(0, 1);
  rowCount = size(r, 1);
  columnCount = size(r, 2);
  if rowCount == columnCount
    rootValues = eig(r);
  elseif ((rowCount == 1) || (columnCount == 1))
    rootValues = r;
  else
    error('Nelson:poly:InputSize', 'Argument must be a vector or a square matrix.')
  end
  rootValues = rootValues(isfinite(rootValues));
  rootCount = length(rootValues);
  p = zeros(1, rootCount + 1, class(r));
  p(1) = 1;
  for rootIndex = 1:rootCount
    activeRange = 1:rootIndex;
    p(activeRange + 1) = p(activeRange + 1) - rootValues(rootIndex) .* p(activeRange);
  end
  positiveImaginaryRoots = sort(rootValues(imag(rootValues) > 0));
  negativeImaginaryRoots = sort(conj(rootValues(imag(rootValues) < 0)));
  if isequal(positiveImaginaryRoots, negativeImaginaryRoots)
    p = real(p);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [a, b] = polyder(varargin)
  narginchk(1, 2);
  nargoutchk(0, 2);
  numerator = polynomialRow(varargin{1});
  if nargin < 2
    denominator = 1;
  else
    denominator = polynomialRow(varargin{2});
  end
  numeratorDerivative = derivativeCoefficients(numerator);
  denominatorDerivative = derivativeCoefficients(denominator);
  leftTerm = conv(numeratorDerivative, denominator);
  rightTerm = conv(numerator, denominatorDerivative);
  padding = length(leftTerm) - length(rightTerm);
  if padding > 0
    rightTerm = [zeros(1, padding), rightTerm];
  elseif padding < 0
    leftTerm = [zeros(1, -padding), leftTerm];
  end
  if nargout < 2
    a = trimDerivative(leftTerm + rightTerm);
  else
    a = trimDerivative(leftTerm - rightTerm);
  end
  b = trimDenominator(conv(denominator, denominator), denominator);
  maximumOrder = max(length(numerator) + length(denominator) - 2, 1);
  if length(a) > maximumOrder
    a = a(2:end);
  end
end
%=============================================================================
function p = polynomialRow(p)
  p = p(:).';
end
%=============================================================================
function dp = derivativeCoefficients(p)
  degree = length(p) - 1;
  if degree > 0
    dp = p(1:degree) .* (degree:-1:1);
  else
    dp = 0;
  end
end
%=============================================================================
function p = trimDerivative(p)
  first = find(p ~= 0, 1);
  if isempty(first)
    p = 0;
  else
    p = p(first:end);
  end
end
%=============================================================================
function p = trimDenominator(p, source)
  first = find(p ~= 0, 1);
  if isempty(first)
    p = zeros(class(source));
  else
    p = p(first:end);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [p, S, mu] = polyfit(x, y, n)
  if (numel(x) ~= numel(y))
    error('Nelson:polyfit:XYSizeMismatch', 'The first two inputs must have the same number of elements.');
  end
  x = x(:);
  y = y(:);
  if nargout > 2
    mu = [mean(x); std(x)];
    if mu(2) == 0
      mu(2) = 1;
    end
    x = (x - mu(1)) ./ mu(2);
  end
  A = ones(numel(x), n + 1);
  for i = n:-1:1
    A(:, i) = x .* A(:, i + 1);
  end
  [Q, R] = qr(A, 0);
  p = (R \ (Q' * y)).';
  if nargout > 1
    r = y - A * p.';
    S.R = R;
    S.df = max(0, numel(y) - (n + 1));
    S.normr = norm(r);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function pint = polyint(varargin)
  narginchk(1, 2)
  nargoutchk(0, 1)
  p = varargin{1};
  if nargin < 2
    k = 0;
  else
    k = varargin{2};
  end
  pint = [(p(:).') ./ (length(p):-1:1), k];
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [y, delta] = polyval(p, x, S, mu)
  narginchk(2, 4);
  nargoutchk(0, 2);
  if nargin >= 4 && ~isempty(mu)
    evaluationPoints = (x - mu(1)) ./ mu(2);
  else
    evaluationPoints = x;
  end

  coefficientCount = numel(p);
  y = hornerEvaluate(p, evaluationPoints, coefficientCount);
  if nargout < 2
    return
  end
  if nargin < 3 || isempty(S)
    error('Nelson:polyval:missingS', 'S is required to compute error estimates.');
  end
  delta = polynomialDelta(S, evaluationPoints, coefficientCount);
end
%=============================================================================
function y = hornerEvaluate(coefficients, evaluationPoints, coefficientCount)
  if isempty(coefficients)
    y = zeros(size(evaluationPoints));
    return
  end
  y = coefficients(1) + zeros(size(evaluationPoints));
  for coefficientIndex = 2:coefficientCount
    y = y .* evaluationPoints + coefficients(coefficientIndex);
  end
end
%=============================================================================
function delta = polynomialDelta(S, evaluationPoints, coefficientCount)
  xColumn = evaluationPoints(:);
  vandermondeLike = ones(numel(xColumn), coefficientCount) + 0 * xColumn;
  for coefficientIndex = coefficientCount - 1:-1:1
    vandermondeLike(:, coefficientIndex) = ...
      xColumn .* vandermondeLike(:, coefficientIndex + 1);
  end
  normalizedDesign = vandermondeLike / S.R;
  leverage = sqrt(1 + sum(normalizedDesign .* conj(normalizedDesign), 2));
  if S.df == 0
    warning('Nelson:polyval:zeroDegreesOfFreedom', 'Zero degrees of freedom; delta is set to Inf.');
    delta = Inf(size(evaluationPoints));
  else
    delta = (S.normr / sqrt(S.df)) * leverage;
    delta = reshape(delta, size(evaluationPoints));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = polyvalm(c, x)
  narginchk(2, 2);
  nargoutchk(0, 1);

  if ~(isvector(c) || isempty(c))
    error('Nelson:polyvalm:InvalidP', 'First argument must be a vector.');
  end

  [m, n] = size(x);
  if m ~= n
    error('Nelson:polyvalm:NonSquareMatrix', 'Second argument must be a square matrix.');
  end

  n = length(c);
  r = size(x, 1);
  if (n == 0)
    y = zeros(r, class(x));
  else
    id = eye(r, class(x));
    y = c(1) * id;
    for i = 2:n
      y = y * x + c(i) * id;
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function v = ppval(pp, xq)
  narginchk(2, 2);
  nargoutchk(0, 1);
  if ~isstruct(pp) || ~isfield(pp, 'form') || ~strcmp(pp.form, 'pp')
    error('Nelson:ppval:invalidStructure', 'Piecewise polynomial structure expected.');
  end
  breaks = pp.breaks;
  coefs = pp.coefs;
  pieces = pp.pieces;
  if isfield(pp, 'dim')
    d = prod(pp.dim);
  else
    d = 1;
  end
  order = size(coefs, 2);
  xqSize = size(xq);
  q = xq(:);
  nq = numel(q);
  v = zeros(d, nq) + 0 * coefs(1);
  for k = 1:nq
    x = q(k);
    if x <= breaks(1)
      piece = 1;
    elseif x >= breaks(end)
      piece = pieces;
    else
      piece = find(breaks <= x, 1, 'last');
      if piece > pieces
        piece = pieces;
      end
    end
    dx = x - breaks(piece);
    baseRow = (piece - 1) * d;
    for r = 1:d
      c = coefs(baseRow + r, :);
      val = 0;
      for j = 1:order
        val = val * dx + c(j);
      end
      v(r, k) = val;
    end
  end
  if d == 1
    v = reshape(v, xqSize);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = residue(varargin)
  narginchk(2, 3);
  nargoutchk(0, 3);
  if nargin == 2
    [r, p, k] = residue_expansion(varargin{1}, varargin{2});
    varargout{1} = r;
    if nargout >= 2
      varargout{2} = p;
    end
    if nargout >= 3
      varargout{3} = k;
    end
  else
    [b, a] = residue_recombine(varargin{1}, varargin{2}, varargin{3});
    varargout{1} = b;
    if nargout >= 2
      varargout{2} = a;
    end
  end
end
%=============================================================================
function [r, p, k] = residue_expansion(b, a)
  b = strip_leading_zeros(full(b(:)).');
  a = strip_leading_zeros(full(a(:)).');
  if isempty(a)
    error('Nelson:residue:denominatorMustBeNonzero', 'Denominator polynomial must be nonzero.');
  end
  la = numel(a);
  lb = numel(b);
  if lb >= la
    [k, b] = deconv(b, a);
    k = k(:).';
    b = strip_leading_zeros(b);
  else
    k = [];
  end
  n = la - 1;
  if n == 0
    r = zeros(0, 1);
    p = zeros(0, 1);
    return
  end
  tol = residue_tolerance();
  [p, mult] = cluster_poles(roots(a), tol);
  brhs = pad_or_trim_column(b(:), n);
  M = zeros(n, n) + 0 * (brhs(1) + p(1));
  for i = 1:n
    q = a(1) * poly_without(p, i, mult(i), tol);
    M(:, i) = pad_or_trim_column(q(:), n);
  end
  r = M \ brhs;
  if isreal(a) && isreal(b)
    r = drop_negligible_imaginary(r);
    p = drop_negligible_imaginary(p);
  end
end
%=============================================================================
function [b, a] = residue_recombine(r, p, k)
  r = full(r(:));
  p = full(p(:));
  n = numel(p);
  if numel(r) ~= n
    error('Nelson:dimagree:rPNumberElements', 'R and P must have the same number of elements.');
  end
  tol = residue_tolerance();
  mult = consecutive_multiplicity(p, tol);
  if n == 0
    a = 1;
  else
    a = poly(p.');
  end
  b = 0;
  for i = 1:n
    b = add_polynomials(b, r(i) * poly_without(p, i, mult(i), tol));
  end
  if ~isempty(k)
    b = add_polynomials(b, conv(full(k(:)).', a));
  end
  if isreal(r) && isreal(p) && isreal_or_empty(k)
    b = drop_negligible_imaginary(b);
    a = drop_negligible_imaginary(a);
  end
end
%=============================================================================
function t = residue_tolerance()
  t = 1e-3;
end
%=============================================================================
function v = strip_leading_zeros(v)
  v = v(:).';
  idx = find(v ~= 0, 1, 'first');
  if isempty(idx)
    v = zeros(1, 0);
  else
    v = v(idx:end);
  end
end
%=============================================================================
function [pcl, mult] = cluster_poles(p, tol)
  % Poles are ordered by decreasing magnitude with a stable tie break, then
  % equal poles are grouped together and replaced by their average.
  p = p(:);
  n = numel(p);
  [ignore, ord] = sortrows([-abs(p), (1:n)']); %#ok
  p = p(ord);
  used = false(n, 1);
  pcl = zeros(0, 1);
  mult = zeros(0, 1);
  for i = 1:n
    if used(i)
      continue
    end
    used(i) = true;
    idxs = i;
    for j = i + 1:n
      if ~used(j) && abs(p(j) - p(i)) <= tol * max(1, abs(p(i)))
        idxs(end + 1) = j;
        used(j) = true;
      end
    end
    m = numel(idxs);
    pm = mean(p(idxs));
    for t = 1:m
      pcl(end + 1, 1) = pm;
      mult(end + 1, 1) = t;
    end
  end
end
%=============================================================================
function mult = consecutive_multiplicity(p, tol)
  n = numel(p);
  mult = zeros(n, 1);
  t = 0;
  for i = 1:n
    if i > 1 && abs(p(i) - p(i - 1)) <= tol * max(1, abs(p(i)))
      t = t + 1;
    else
      t = 1;
    end
    mult(i) = t;
  end
end
%=============================================================================
function q = poly_without(p, idx, t, tol)
  v = p(idx);
  keep = true(numel(p), 1);
  removed = 0;
  for j = 1:numel(p)
    if removed < t && abs(p(j) - v) <= tol * max(1, abs(v))
      keep(j) = false;
      removed = removed + 1;
    end
  end
  q = poly(p(keep).');
end
%=============================================================================
function w = pad_or_trim_column(v, n)
  v = v(:);
  m = numel(v);
  if m == n
    w = v;
  elseif m < n
    w = [zeros(n - m, 1); v];
  else
    w = v(m - n + 1:end);
  end
end
%=============================================================================
function s = add_polynomials(p1, p2)
  p1 = p1(:).';
  p2 = p2(:).';
  n1 = numel(p1);
  n2 = numel(p2);
  n = max(n1, n2);
  s = zeros(1, n) + 0 * (p1(1) + p2(1));
  s(n - n1 + 1:end) = p1;
  s(n - n2 + 1:end) = s(n - n2 + 1:end) + p2;
end
%=============================================================================
function v = drop_negligible_imaginary(v)
  if ~isreal(v)
    tolimag = 1e-10 * (1 + abs(real(v)));
    mask = abs(imag(v)) <= tolimag;
    if all(mask(:))
      v = real(v);
    end
  end
end
%=============================================================================
function tf = isreal_or_empty(k)
  tf = isempty(k) || isreal(k);
end
