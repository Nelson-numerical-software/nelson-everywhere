A = [33, 2, 5; 23, 200, 2; 9, 2, 45];
B = [4, 5; 12, 5; 82, 1];
C = [34, 56, 2; 6, 2, 112];
D = [2, 0; 0, 19];
sys1 = ss(A, B, C, D);
inputs = 1;
outputs = 1;

R = ssdelete(sys1, inputs, outputs);
a = A;
b = [5; 5; 1];
c = [6 2 112];
d = 19;
REF = ss(a, b, c, d);

asserts.isequal(R, REF);
