function [C, ia, ib] = union(A, B, varargin)
  if ~isa(B, 'categorical')
    B = categorical(B);
  end
  AB = [A(:); B(:)];
  [C, i] = unique(AB, varargin{:});
  ia = i(i <= numel(A));
  ib = i(i > numel(A)) - numel(A);
end
%=============================================================================
%=============================================================================
