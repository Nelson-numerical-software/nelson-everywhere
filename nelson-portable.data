%=============================================================================
function y = rad2deg(varargin)
  narginchk(1, 1);
  nargoutchk(0, 1);
  x = varargin{1};
  if isfloat(x)
    y = (180 / pi) * x;
  else
    error('Nelson:trigonometric_functions:nonFloatInput', 'Input must be single or double.');
  end
end
