function y = reallog(x)
  narginchk(1, 1);
  nargoutchk(0, 1);
  if ~isreal(x) || any(x < 0, 'all')
    error('Nelson:validators:mustBeReal', '%s must be real.', 'Result');
  end
  y = log(x);
end
