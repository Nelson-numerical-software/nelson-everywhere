% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% Integrates fun along the piecewise linear path points(1), points(2), ...
% Real segments use the adaptive rule directly (infinite ends allowed),
% complex segments are parameterized over [0, 1].
%=============================================================================
function [q, errbnd] = integral_contour(fun, points, reltol, abstol, arrayValued, maxIntervals)
  if nargin < 6
    maxIntervals = [];
  end
  if any(imag(points) ~= 0) && ~all(isfinite(points))
    error('Nelson:integral:nonFiniteContourError', _('Contour endpoints and waypoints must be finite.'));
  end
  q = 0;
  errbnd = 0;
  for k = 1:numel(points) - 1
    a = points(k);
    b = points(k + 1);
    if imag(a) == 0 && imag(b) == 0
      [part, err] = integral_gk(fun, real(a), real(b), reltol, abstol, arrayValued, maxIntervals);
    else
      dz = b - a;
      pathFun = @(t) fun(a + dz .* t) .* dz;
      [part, err] = integral_gk(pathFun, 0, 1, reltol, abstol, arrayValued, maxIntervals);
    end
    q = q + part;
    errbnd = errbnd + err;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% Adaptive Gauss-Kronrod (G7-K15) quadrature with support for infinite
% limits and array-valued integrands.
% The optional mesh output describes the final subdivision of the
% normalized variable: map (kind, a, b), sorted intervals [L, R] and their
% integrals Q (row vector, or cell array for array-valued integrands).
%=============================================================================
function [q, errbnd, mesh] = integral_gk(fun, a, b, reltol, abstol, arrayValued, maxIntervals)
  if nargin < 7 || isempty(maxIntervals)
    maxIntervals = 100000;
  end
  a = double(a);
  b = double(b);
  if isnan(a) || isnan(b)
    q = NaN;
    errbnd = NaN;
    mesh = [];
    return
  end
  if a == b
    q = integral_zero_result(fun, a, arrayValued);
    errbnd = 0;
    mesh = [];
    return
  end
  sgn = 1;
  if a > b
    tmp = a;
    a = b;
    b = tmp;
    sgn = -1;
  end
  kind = integral_transform_kind(a, b);

  [nodes, wk, wgw] = integral_gk_rule();

  % initial subdivision of the normalized interval [-1, 1]
  edges = linspace(-1, 1, 11);
  L = edges(1:end - 1);
  R = edges(2:end);

  if arrayValued
    [q, errbnd, L, R, Q] = integral_gk_arrayvalued(fun, kind, a, b, nodes, wk, wgw, ...
      L, R, reltol, abstol, maxIntervals);
  else
    [q, errbnd, L, R, Q] = integral_gk_vectorized(fun, kind, a, b, nodes, wk, wgw, ...
      L, R, reltol, abstol, maxIntervals);
  end
  q = sgn * q;
  if nargout > 2
    [L, order] = sort(L);
    mesh = struct('kind', kind, 'a', a, 'b', b, 'L', L, 'R', R(order));
    mesh.Q = Q(order);
  end
end
%=============================================================================
function [q, errbnd, L, R, Qk] = integral_gk_vectorized(fun, kind, a, b, nodes, wk, wgw, ...
  L, R, reltol, abstol, maxIntervals)
  [Qk, err] = integral_gk_eval_vec(fun, kind, a, b, nodes, wk, wgw, L, R);
  while true
    Q = sum(Qk);
    E = sum(err);
    if ~isfinite(Q)
      break
    end
    tol = max(abstol, reltol * abs(Q));
    if E <= tol
      break
    end
    thresh = tol / numel(L);
    idx = find(err > thresh);
    if isempty(idx)
      break
    end
    Ls = L(idx);
    Rs = R(idx);
    Ms = 0.5 * (Ls + Rs);
    nL = [Ls, Ms];
    nR = [Ms, Rs];
    [nQk, nErr] = integral_gk_eval_vec(fun, kind, a, b, nodes, wk, wgw, nL, nR);
    keep = true(1, numel(L));
    keep(idx) = false;
    L = [L(keep), nL];
    R = [R(keep), nR];
    Qk = [Qk(keep), nQk];
    err = [err(keep), nErr];
    if numel(L) > maxIntervals
      warning('Nelson:integral:maxIntervalCount', 'Reached the limit on the maximum number of intervals in use. Answer may not be accurate.');
      break
    end
  end
  q = sum(Qk);
  errbnd = sum(err);
end
%=============================================================================
function [q, errbnd, L, R, Qcell] = integral_gk_arrayvalued(fun, kind, a, b, nodes, wk, wgw, ...
  L, R, reltol, abstol, maxIntervals)
  [Qcell, err] = integral_gk_eval_av(fun, kind, a, b, nodes, wk, wgw, L, R);
  while true
    Q = integral_sum_cells(Qcell);
    E = sum(err);
    Qnorm = max(abs(Q(:)));
    if ~all(isfinite(Q(:)))
      break
    end
    tol = max(abstol, reltol * Qnorm);
    if E <= tol
      break
    end
    thresh = tol / numel(L);
    idx = find(err > thresh);
    if isempty(idx)
      break
    end
    Ls = L(idx);
    Rs = R(idx);
    Ms = 0.5 * (Ls + Rs);
    nL = [Ls, Ms];
    nR = [Ms, Rs];
    [nQcell, nErr] = integral_gk_eval_av(fun, kind, a, b, nodes, wk, wgw, nL, nR);
    keep = true(1, numel(L));
    keep(idx) = false;
    L = [L(keep), nL];
    R = [R(keep), nR];
    Qcell = [Qcell(keep), nQcell];
    err = [err(keep), nErr];
    if numel(L) > maxIntervals
      warning('Nelson:integral:maxIntervalCount', 'Reached the limit on the maximum number of intervals in use. Answer may not be accurate.');
      break
    end
  end
  q = integral_sum_cells(Qcell);
  errbnd = sum(err);
end
%=============================================================================
function s = integral_sum_cells(Qcell)
  s = Qcell{1};
  for m = 2:numel(Qcell)
    s = s + Qcell{m};
  end
end
%=============================================================================
function kind = integral_transform_kind(a, b)
  fa = isfinite(a);
  fb = isfinite(b);
  if fa && fb
    kind = 'finite';
  elseif fa && ~fb
    kind = 'ainf';
  elseif ~fa && fb
    kind = 'binf';
  else
    kind = 'both';
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% Gauss-Kronrod rule on the intervals [L(k), R(k)] of the normalized
% variable (array-valued integrand evaluated at scalar abscissae).
%=============================================================================
function [Qcell, err] = integral_gk_eval_av(fun, kind, a, b, nodes, wk, wgw, L, R)
  M = numel(L);
  Qcell = cell(1, M);
  err = zeros(1, M);
  ng = numel(nodes);
  for m = 1:M
    half = 0.5 * (R(m) - L(m));
    mid = 0.5 * (R(m) + L(m));
    tn = mid + half * nodes;
    [xn, wn] = integral_map(kind, a, b, tn);
    Sk = [];
    Sg = [];
    for k = 1:ng
      gv = fun(xn(k)) .* wn(k);
      if k == 1
        Sk = gv .* wk(k);
        Sg = gv .* wgw(k);
      else
        Sk = Sk + gv .* wk(k);
        Sg = Sg + gv .* wgw(k);
      end
    end
    Qk = half .* Sk;
    Qg = half .* Sg;
    Qcell{m} = Qk;
    d = abs(Qg(:) - Qk(:));
    err(m) = max(d);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% Gauss-Kronrod rule on the intervals [L(k), R(k)] of the normalized
% variable (vectorized integrand): integrals and error estimates.
%=============================================================================
function [Qk, err] = integral_gk_eval_vec(fun, kind, a, b, nodes, wk, wgw, L, R)
  half = 0.5 * (R - L);
  mid = 0.5 * (R + L);
  T = mid.' + half.' .* nodes;
  [X, W] = integral_map(kind, a, b, T);
  G = fun(X) .* W;
  Qk = half .* (G * wk.').';
  Qg = half .* (G * wgw.').';
  err = abs(Qk - Qg);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% Nodes and weights of the 15-point Kronrod rule and of the embedded
% 7-point Gauss rule.
%=============================================================================
function [nodes, wk, wgw] = integral_gk_rule()
  xgk = [0.991455371120813, 0.949107912342759, 0.864864423359769, ...
    0.741531185599394, 0.586087235467691, 0.405845151377397, ...
    0.207784955007898, 0.000000000000000];
  wgk = [0.022935322010529, 0.063092092629979, 0.104790010322250, ...
    0.140653259715525, 0.169004726639267, 0.190350578064785, ...
    0.204432940075298, 0.209482141084728];
  wg = [0.129484966168870, 0.279705391489277, 0.381830050505119, ...
    0.417959183673469];
  nodes = [-xgk(1:7), xgk(8), fliplr(xgk(1:7))];
  wk = [wgk(1:7), wgk(8), fliplr(wgk(1:7))];
  wgw = zeros(1, 15);
  wgw([2, 14]) = wg(1);
  wgw([4, 12]) = wg(2);
  wgw([6, 10]) = wg(3);
  wgw(8) = wg(4);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% Adaptive integration of fun from lower to upper, keeping the final mesh
% of every segment (split at the waypoints) with the partial sums before
% each of its intervals, so that integral_interpolant_eval can evaluate
% the integral from lower to any x.
%=============================================================================
function data = integral_interpolant_build(fun, lower, upper, opts)
  if ~opts.Vectorized && ~opts.ArrayValued
    fun = @(x) arrayfun(fun, x);
  end
  lo = min(lower, upper);
  hi = max(lower, upper);
  points = integral_path(lo, hi, opts.Waypoints);
  nseg = numel(points) - 1;
  segments = cell(1, nseg);
  subintervals = cell(1, nseg);
  total = 0;
  errbnd = 0;
  for k = 1:nseg
    [q, err, mesh] = integral_gk(fun, points(k), points(k + 1), opts.RelTol, opts.AbsTol, opts.ArrayValued);
    Q = mesh.Q;
    if opts.ArrayValued
      Q = cell2mat(cellfun(@(c) c(:).', Q(:), 'UniformOutput', false));
      mesh.Qcum = [zeros(1, size(Q, 2)); cumsum(Q(1:end - 1, :), 1)] + total(:).';
    else
      mesh.Qcum = [0; cumsum(Q(1:end - 1)).'] + total;
    end
    mesh.edges = [mesh.L, mesh.R(end)];
    x = integral_map(mesh.kind, mesh.a, mesh.b, mesh.edges);
    x([1, end]) = [mesh.a, mesh.b];
    if k > 1
      x = x(2:end);
    end
    subintervals{k} = x;
    segments{k} = mesh;
    total = total + q;
    errbnd = errbnd + err;
  end
  subintervals = [subintervals{:}];
  data = struct();
  data.fun = fun;
  data.arrayValued = opts.ArrayValued;
  data.points = points;
  data.segments = segments;
  data.backward = lower > upper;
  data.total = total;
  data.valueSize = size(total);
  if data.backward
    data.integral = -total;
    data.subintervals = fliplr(subintervals);
  else
    data.integral = total;
    data.subintervals = subintervals;
  end
  data.errbnd = errbnd;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% F(x) = integral of fun from lower to x, for the data computed by
% integral_interpolant_build: partial sum of the mesh intervals before x
% plus the Gauss-Kronrod rule on the part of the interval containing x.
% NaN outside the integration interval.
%=============================================================================
function Fq = integral_interpolant_eval(data, xq)
  x = double(xq(:).');
  nq = numel(x);
  nv = prod(data.valueSize);
  G = NaN(nq, nv);
  done = false(1, nq);
  points = data.points;
  for k = 1:numel(data.segments)
    in = find(~done & x >= points(k) & x <= points(k + 1));
    if ~isempty(in)
      G(in, :) = integralSegmentEval(data, data.segments{k}, x(in));
      done(in) = true;
    end
  end
  if data.backward
    G = G - data.total(:).';
  end
  if ~data.arrayValued
    Fq = reshape(G, size(xq));
  elseif numel(data.valueSize) == 2 && min(data.valueSize) == 1
    Fq = G;
  else
    Fq = reshape(G, [nq, data.valueSize]);
  end
end
%=============================================================================
function G = integralSegmentEval(data, mesh, x)
  t = integralInverseMap(mesh.kind, mesh.a, mesh.b, x);
  nint = numel(mesh.L);
  [~, j] = histc(t, mesh.edges);
  j = min(max(j, 1), nint);
  G = mesh.Qcum(j, :);
  % partial interval [L(j), t]: skipped when empty (x on a mesh point)
  part = find(t > mesh.L(j));
  if isempty(part)
    return
  end
  [nodes, wk, wgw] = integral_gk_rule();
  L = mesh.L(j(part));
  R = t(part);
  if data.arrayValued
    Qcell = integral_gk_eval_av(data.fun, mesh.kind, mesh.a, mesh.b, nodes, wk, wgw, L, R);
    for m = 1:numel(part)
      v = Qcell{m};
      G(part(m), :) = G(part(m), :) + v(:).';
    end
  else
    Qk = integral_gk_eval_vec(data.fun, mesh.kind, mesh.a, mesh.b, nodes, wk, wgw, L, R);
    G(part) = G(part) + Qk(:);
  end
end
%=============================================================================
function t = integralInverseMap(kind, a, b, x)
  % inverse of integral_map
  switch kind
    case 'finite'
      u = min(max((x - 0.5 * (a + b)) / (0.5 * (b - a)), -1), 1);
      t = 2 * sin(asin(u) / 3);
    case 'ainf'
      s = x - a;
      t = (s - 1) ./ (s + 1);
    case 'binf'
      s = b - x;
      t = (1 - s) ./ (1 + s);
    otherwise
      t = 2 * x ./ (1 + sqrt(1 + 4 * x .^ 2));
  end
  t(x == a) = -1;
  t(x == b) = 1;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% Change of variable from the normalized variable T in [-1, 1] to x in
% [a, b] (finite or infinite): abscissae X and jacobian W.
%=============================================================================
function [X, W] = integral_map(kind, a, b, T)
  switch kind
    case 'finite'
      A = 0.5 * (b - a);
      B = 0.5 * (a + b);
      X = A .* (3 * T - T .^ 3) / 2 + B;
      W = A .* (3 - 3 * T .^ 2) / 2;
    case 'ainf'
      X = a + (1 + T) ./ (1 - T);
      W = 2 ./ (1 - T) .^ 2;
    case 'binf'
      X = b - (1 - T) ./ (1 + T);
      W = 2 ./ (1 + T) .^ 2;
    otherwise
      X = T ./ (1 - T .^ 2);
      W = (1 + T .^ 2) ./ (1 - T .^ 2) .^ 2;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function opts = integral_parse_options(fname, varargin)
  opts = struct('RelTol', 1e-6, 'AbsTol', 1e-10, 'ArrayValued', false, 'Vectorized', true, ...
    'Waypoints', [], 'Method', 'auto');
  oneDimensional = strcmp(fname, 'integral') || strcmp(fname, 'integralInterpolant');
  n = numel(varargin);
  if mod(n, 2) ~= 0
    error(['Nelson:', fname, ':optionsPairs'], _('Options must be given as name/value pairs.'));
  end
  for k = 1:2:n
    name = varargin{k};
    value = varargin{k + 1};
    if ~(ischar(name) || (isstring(name) && isscalar(name)))
      error(['Nelson:', fname, ':optionName'], _('Option name must be a character vector.'));
    end
    name = char(name);
    if strcmpi(name, 'RelativeTolerance') || strcmpi(name, 'RelTol')
      opts.RelTol = integralNonnegativeScalar(fname, 'RelativeTolerance', value);
    elseif strcmpi(name, 'AbsoluteTolerance') || strcmpi(name, 'AbsTol')
      opts.AbsTol = integralNonnegativeScalar(fname, 'AbsoluteTolerance', value);
    elseif strcmpi(name, 'ArrayValued') && oneDimensional
      opts.ArrayValued = integralLogicalScalar(fname, 'ArrayValued', value);
    elseif strcmpi(name, 'Vectorized')
      opts.Vectorized = integralLogicalScalar(fname, 'Vectorized', value);
    elseif strcmpi(name, 'Waypoints') && oneDimensional
      opts.Waypoints = integralWaypoints(fname, value);
    elseif strcmpi(name, 'Waypoints')
      opts.Waypoints = integralGridWaypoints(fname, value, 2 + strcmp(fname, 'integral3'));
    elseif strcmpi(name, 'Method') && strcmp(fname, 'integral3')
      opts.Method = integralMethod(fname, value);
    else
      error(['Nelson:', fname, ':unknownOption'], sprintf(_('Unknown option name: %s'), name));
    end
  end
end
%=============================================================================
function value = integralNonnegativeScalar(fname, name, value)
  if ~(isnumeric(value) && isscalar(value) && isreal(value) && value >= 0)
    error(['Nelson:', fname, ':', name], sprintf('%s must be a nonnegative real scalar.', name));
  end
  value = double(value);
end
%=============================================================================
function value = integralLogicalScalar(fname, name, value)
  if ~(isscalar(value) && (islogical(value) || (isnumeric(value) && isreal(value))))
    error(['Nelson:', fname, ':', name], sprintf(_('%s must be a logical scalar.'), name));
  end
  value = logical(value);
end
%=============================================================================
function value = integralWaypoints(fname, value)
  if ~(isnumeric(value) || islogical(value)) || ~(isvector(value) || isempty(value)) || ~all(isfinite(value(:)))
    error(['Nelson:', fname, ':invalidWaypoints'], _('''Waypoints'' value must be a vector with all finite values.'));
  end
  value = double(value(:).');
end
%=============================================================================
function waypoints = integralGridWaypoints(fname, value, ndims)
  % [x y (z)] array of points or {x y (z)} grid vectors -> one row vector per dimension
  if isempty(value)
    waypoints = {};
    return
  end
  if iscell(value) && numel(value) == ndims
    waypoints = value(:).';
  elseif isnumeric(value) && ismatrix(value) && size(value, 2) == ndims
    waypoints = num2cell(value, 1);
  else
    waypoints = {};
  end
  valid = ~isempty(waypoints);
  for k = 1:numel(waypoints)
    w = waypoints{k};
    valid = valid && (isnumeric(w) || islogical(w)) && (isvector(w) || isempty(w)) && isreal(w) && all(isfinite(w(:)));
    if valid
      waypoints{k} = double(w(:).');
    end
  end
  if ~valid
    error(['Nelson:', fname, ':invalidWaypoints'], sprintf(_('''Waypoints'' value must be a %d-column array or a cell array of %d vectors with real finite values.'), ndims, ndims));
  end
end
%=============================================================================
function method = integralMethod(fname, value)
  method = '';
  if ischar(value) || (isstring(value) && isscalar(value))
    method = lower(char(value));
  end
  if ~any(strcmp(method, {'auto', 'tiled', 'iterated'}))
    error(['Nelson:', fname, ':Method'], _('Method must be ''auto'', ''tiled'', or ''iterated''.'));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% Path of integration from a to b through waypoints:
% real problem: [a, b] split at the waypoints lying strictly inside it,
% complex problem: piecewise linear contour through the waypoints in order.
%=============================================================================
function points = integral_path(a, b, waypoints)
  if isreal(a) && isreal(b) && isreal(waypoints)
    a = double(a);
    b = double(b);
    inside = waypoints(waypoints > min(a, b) & waypoints < max(a, b));
    inside = unique(inside);
    if a > b
      inside = fliplr(inside);
    end
    points = [a, inside, b];
  else
    points = [double(a), waypoints, double(b)];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function q = integral_zero_result(fun, a, arrayValued)
  if arrayValued
    v = fun(a);
    q = zeros(size(v));
    if ~isreal(v)
      q = complex(q, q) - complex(q, q);
    end
  else
    q = 0;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function vq = interp1_eval(x, v, xq, method, extrapMode, extrapValue)
  if nargin < 4 || isempty(method)
    method = 'linear';
  end
  if nargin < 5 || isempty(extrapMode)
    extrapMode = 'default';
  end
  if nargin < 6
    extrapValue = NaN;
  end

  x = full(x(:));
  if ~isnumeric(x) || ~isnumeric(v) || ~isnumeric(xq)
    error('Nelson:interp1:numericExpected', 'Numeric input arguments expected.');
  end
  if issparse(x) || issparse(v) || issparse(xq)
    error('Nelson:special_functions:denseExpected', 'dense type for all input arguments expected.');
  end
  if ~isreal(x) || ~isreal(xq)
    error('Nelson:interp1:mustBeReal', 'Sample points and query points must be real.');
  end
  n = numel(x);
  if n < 2
    error('Nelson:special_functions:notEnoughSamplePoints', 'At least two sample points expected.');
  end
  dx = diff(x);
  if any(dx == 0) || ~(all(dx > 0) || all(dx < 0))
    error('Nelson:interp1:samplePointsNotMonotonic', 'Sample points must be strictly monotonic.');
  end

  originalVector = isvector(v);
  if originalVector
    if numel(v) ~= n
      error('Nelson:dimagree:xVLength', 'X and V must be of the same length.');
    end
    vMatrix = full(v(:));
    extraDims = [];
  else
    if size(v, 1) ~= n
      error('Nelson:dimagree:lENGTHXSIZEV1', 'LENGTH(X) and SIZE(V,1) must be the same.');
    end
    extraDims = size(v);
    extraDims = extraDims(2:end);
    vMatrix = reshape(full(v), n, []);
  end

  if dx(1) < 0
    x = flipud(x);
    vMatrix = flipud(vMatrix);
  end

  qSize = size(xq);
  q = full(xq(:));
  out = zeros(numel(q), size(vMatrix, 2)) + 0 * vMatrix(1, 1);
  for col = 1:size(vMatrix, 2)
    out(:, col) = interp1_eval_column(x, vMatrix(:, col), q, method, extrapMode, extrapValue);
  end

  if originalVector
    vq = reshape(out(:, 1), qSize);
  else
    if isvector(xq)
      vq = reshape(out, [numel(q), extraDims]);
    else
      vq = reshape(out, [qSize, extraDims]);
    end
  end
end
%=============================================================================
function yq = interp1_eval_column(x, y, q, method, extrapMode, extrapValue)
  if strcmp(method, 'spline')
    % Use the dedicated not-a-knot spline; interp1 extrapolates for 'spline'
    % by default, matching spline().
    yq = spline(x, y, q);
    if strcmp(extrapMode, 'constant')
      outside = (q < min(x)) | (q > max(x));
      yq(outside) = extrapValue;
    end
    return
  end
  if strcmp(method, 'cubic') || strcmp(method, 'v5cubic')
    % 'cubic'/'v5cubic' use cubic convolution on a uniformly spaced grid; on a
    % non-uniform grid the reference warns and falls back to 'spline'.
    if strcmp(extrapMode, 'extrap')
      % 'cubic'/'v5cubic' do not extrapolate; the reference warns and returns
      % NaN outside the sample range.
      warning('Nelson:interp1:noExtrap', 'The ''cubic'' and ''v5cubic'' methods do not support extrapolation.');
      extrapMode = 'default';
      extrapValue = NaN;
    end
    dh = diff(x);
    if all(abs(dh - dh(1)) <= 1e-10 * max(abs(dh(1)), 1))
      yq = interp1_cubic_convolution(x, y, q, extrapMode, extrapValue);
    else
      warning('Nelson:interp1:cubicNonUniform', 'The ''cubic'' method requires the grid to have a uniform spacing. Switching the method from ''cubic'' to ''spline'' because this condition is not met.');
      yq = spline(x, y, q);
      if strcmp(extrapMode, 'constant')
        outside = (q < min(x)) | (q > max(x));
        yq(outside) = extrapValue;
      end
    end
    return
  end
  % 'makima' is evaluated by the pure Nelson path (interp1_vector); the native
  % __interp1__ does not implement modified Akima interpolation.
  nativeMethods = {'linear', 'nearest', 'previous', 'next', 'pchip', 'spline'};
  if any(strcmp(method, nativeMethods))
    try
      if strcmp(extrapMode, 'extrap')
        yq = __interp1__(x, y, q, method, 'extrap');
      elseif strcmp(extrapMode, 'constant')
        yq = __interp1__(x, y, q, method, extrapValue);
      elseif any(strcmp(method, {'pchip', 'spline'}))
        yq = __interp1__(x, y, q, method, 'extrap');
      else
        yq = __interp1__(x, y, q, method);
      end
      return
    catch
    end
  end
  yq = interp1_vector(x, y, q, method, extrapMode, extrapValue);
end
%=============================================================================
function yq = interp1_cubic_convolution(x, y, q, extrapMode, extrapValue)
  n = numel(x);
  x = x(:);
  y = y(:);
  q = q(:);
  h = x(2) - x(1);
  yq = zeros(numel(q), 1);
  lo = x(1);
  hi = x(n);
  for k = 1:numel(q)
    qi = q(k);
    if (qi < lo || qi > hi) && ~strcmp(extrapMode, 'extrap')
      if strcmp(extrapMode, 'constant')
        yq(k) = extrapValue;
      else
        yq(k) = NaN;
      end
      continue
    end
    idx = floor((qi - lo) / h) + 1;
    if idx < 1
      idx = 1;
    elseif idx > n - 1
      idx = n - 1;
    end
    t = (qi - x(idx)) / h;
    yi = y(idx);
    yp1 = y(idx + 1);
    if idx - 1 >= 1
      ym1 = y(idx - 1);
    else
      ym1 = 3 * y(1) - 3 * y(2) + y(3);
    end
    if idx + 2 <= n
      yp2 = y(idx + 2);
    else
      yp2 = 3 * y(n) - 3 * y(n - 1) + y(n - 2);
    end
    yq(k) = yi + 0.5 * t * ((yp1 - ym1) ...
      + t * ((2 * ym1 - 5 * yi + 4 * yp1 - yp2) ...
      + t * (-ym1 + 3 * yi - 3 * yp1 + yp2)));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function pp = interp1_pp(x, v, method)
  x = full(x(:)).';
  if ~isvector(v)
    error('Nelson:interp1:ppFormVectorOnly', 'PP form is supported for vector sample values.');
  end
  v = full(v(:)).';
  if numel(x) ~= numel(v)
    error('Nelson:dimagree:xVLength', 'X and V must be of the same length.');
  end
  if strcmp(method, 'nearest') || strcmp(method, 'previous') || strcmp(method, 'next')
    error('Nelson:interp1:ppFormContinuousOnly', 'PP form is supported for continuous interpolation methods.');
  end
  if any(diff(x) < 0)
    x = fliplr(x);
    v = fliplr(v);
  end
  n = numel(x);
  coefs = zeros(n - 1, 4) + 0 * v(1);
  if strcmp(method, 'linear')
    for k = 1:n - 1
      slope = (v(k + 1) - v(k)) / (x(k + 1) - x(k));
      coefs(k, :) = [0, 0, slope, v(k)];
    end
  else
    if strcmp(method, 'makima')
      d = interp1_makima_slopes_local(x(:), v(:));
    else
      d = interp1_pchip_slopes_local(x(:), v(:));
    end
    for k = 1:n - 1
      h = x(k + 1) - x(k);
      c0 = v(k);
      c1 = d(k);
      c2 = (3 * (v(k + 1) - v(k)) / h - 2 * d(k) - d(k + 1)) / h;
      c3 = (2 * (v(k) - v(k + 1)) / h + d(k) + d(k + 1)) / (h * h);
      coefs(k, :) = [c3, c2, c1, c0];
    end
  end
  pp = struct('form', 'pp', 'breaks', x, 'coefs', coefs, 'pieces', n - 1, 'order', 4, 'dim', 1);
end
%=============================================================================
function d = interp1_pchip_slopes_local(x, y)
  n = numel(x);
  h = diff(x);
  delta = diff(y) ./ h;
  d = zeros(size(y)) + 0 * y(1);
  if n == 2
    d(:) = delta(1);
    return
  end
  for k = 2:n - 1
    if isreal(delta(k - 1)) && isreal(delta(k)) && delta(k - 1) * delta(k) > 0
      w1 = 2 * h(k) + h(k - 1);
      w2 = h(k) + 2 * h(k - 1);
      d(k) = (w1 + w2) / (w1 / delta(k - 1) + w2 / delta(k));
    else
      d(k) = (delta(k - 1) + delta(k)) / 2;
    end
  end
  d(1) = ((2 * h(1) + h(2)) * delta(1) - h(1) * delta(2)) / (h(1) + h(2));
  d(n) = ((2 * h(end) + h(end - 1)) * delta(end) - h(end) * delta(end - 1)) / (h(end) + h(end - 1));
end
%=============================================================================
function d = interp1_makima_slopes_local(x, y)
  n = numel(x);
  h = diff(x);
  delta = diff(y) ./ h;
  d = zeros(size(y)) + 0 * y(1);
  if n == 2
    d(:) = delta(1);
    return
  end
  m = zeros(n + 3, 1) + 0 * y(1);
  m(3:n + 1) = delta;
  m(2) = 2 * m(3) - m(4);
  m(1) = 2 * m(2) - m(3);
  m(n + 2) = 2 * m(n + 1) - m(n);
  m(n + 3) = 2 * m(n + 2) - m(n + 1);
  for i = 1:n
    w1 = abs(m(i + 3) - m(i + 2)) + abs(m(i + 3) + m(i + 2)) / 2;
    w2 = abs(m(i + 1) - m(i)) + abs(m(i + 1) + m(i)) / 2;
    if w1 + w2 == 0
      d(i) = 0;
    else
      d(i) = (w1 * m(i + 1) + w2 * m(i + 2)) / (w1 + w2);
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function yq = interp1_vector(x, y, q, method, extrapMode, extrapValue)
  n = numel(x);
  yq = zeros(size(q)) + 0 * y(1);
  defaultExtrap = any(strcmp(method, {'pchip', 'makima', 'spline'}));

  if strcmp(method, 'makima')
    d = interp1_makima_slopes(x, y);
  elseif any(strcmp(method, {'pchip', 'spline', 'cubic'}))
    d = interp1_pchip_slopes(x, y);
  else
    d = [];
  end

  for k = 1:numel(q)
    xk = q(k);
    if isnan(xk)
      yq(k) = NaN;
      continue
    end
    outside = (xk < x(1)) || (xk > x(end));
    if outside && strcmp(extrapMode, 'constant')
      yq(k) = extrapValue;
      continue
    end
    if outside && strcmp(extrapMode, 'default') && ~defaultExtrap
      yq(k) = NaN;
      continue
    end

    if xk <= x(1)
      left = 1;
    elseif xk >= x(end)
      left = n - 1;
    else
      left = find(x <= xk, 1, 'last');
      if left >= n
        left = n - 1;
      end
    end

    switch method
      case 'nearest'
        if abs(xk - x(left)) <= abs(x(left + 1) - xk)
          yq(k) = y(left);
        else
          yq(k) = y(left + 1);
        end
      case 'previous'
        if xk < x(1)
          yq(k) = y(1);
        else
          idx = find(x <= xk, 1, 'last');
          yq(k) = y(idx);
        end
      case 'next'
        if xk > x(end)
          yq(k) = y(end);
        else
          idx = find(x >= xk, 1, 'first');
          yq(k) = y(idx);
        end
      case {'pchip', 'makima', 'spline', 'cubic'}
        h = x(left + 1) - x(left);
        t = (xk - x(left)) / h;
        h00 = (2 * t ^ 3) - (3 * t ^ 2) + 1;
        h10 = (t ^ 3) - (2 * t ^ 2) + t;
        h01 = (-2 * t ^ 3) + (3 * t ^ 2);
        h11 = (t ^ 3) - (t ^ 2);
        yq(k) = h00 * y(left) + h10 * h * d(left) + h01 * y(left + 1) + h11 * h * d(left + 1);
      otherwise
        frac = (xk - x(left)) / (x(left + 1) - x(left));
        yq(k) = y(left) + frac * (y(left + 1) - y(left));
    end
  end
end
%=============================================================================
function d = interp1_pchip_slopes(x, y)
  n = numel(x);
  h = diff(x);
  delta = diff(y) ./ h;
  d = zeros(size(y)) + 0 * y(1);
  if n == 2
    d(:) = delta(1);
    return
  end
  for k = 2:n - 1
    if isreal(delta(k - 1)) && isreal(delta(k)) && delta(k - 1) * delta(k) > 0
      w1 = 2 * h(k) + h(k - 1);
      w2 = h(k) + 2 * h(k - 1);
      d(k) = (w1 + w2) / (w1 / delta(k - 1) + w2 / delta(k));
    else
      d(k) = (delta(k - 1) + delta(k)) / 2;
    end
  end
  d(1) = interp1_pchip_endpoint(h(1), h(2), delta(1), delta(2));
  d(n) = interp1_pchip_endpoint(h(end), h(end - 1), delta(end), delta(end - 1));
end
%=============================================================================
function d = interp1_makima_slopes(x, y)
  % Modified Akima piecewise cubic Hermite slopes at the nodes.
  % The classic Akima weights are augmented with the '+ |sum| / 2' term so
  % that regions where consecutive slopes are equal but non-zero no longer
  % produce the 0/0 indeterminate form of the original Akima scheme.
  n = numel(x);
  h = diff(x);
  delta = diff(y) ./ h;
  d = zeros(size(y)) + 0 * y(1);
  if n == 2
    d(:) = delta(1);
    return
  end
  % Extend the segment slopes with two synthetic values on each side using a
  % linear extrapolation of the slope sequence.
  m = zeros(n + 3, 1) + 0 * y(1);
  m(3:n + 1) = delta;
  m(2) = 2 * m(3) - m(4);
  m(1) = 2 * m(2) - m(3);
  m(n + 2) = 2 * m(n + 1) - m(n);
  m(n + 3) = 2 * m(n + 2) - m(n + 1);
  for i = 1:n
    w1 = abs(m(i + 3) - m(i + 2)) + abs(m(i + 3) + m(i + 2)) / 2;
    w2 = abs(m(i + 1) - m(i)) + abs(m(i + 1) + m(i)) / 2;
    if w1 + w2 == 0
      d(i) = 0;
    else
      d(i) = (w1 * m(i + 1) + w2 * m(i + 2)) / (w1 + w2);
    end
  end
end
%=============================================================================
function d = interp1_pchip_endpoint(h1, h2, del1, del2)
  d = ((2 * h1 + h2) * del1 - h1 * del2) / (h1 + h2);
  if isreal(d) && isreal(del1) && isreal(del2)
    if sign(d) ~= sign(del1)
      d = 0;
    elseif sign(del1) ~= sign(del2) && abs(d) > abs(3 * del1)
      d = 3 * del1;
    end
  end
end
%=============================================================================
%=============================================================================
