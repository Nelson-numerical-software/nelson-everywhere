%=============================================================================
function B = binomial(nSize, className)
  pascalFactor = abs(pascal(nSize, 1, className));
  reverseIndex = nSize:-1:1;
  powerScale = (-2) .^ (0:nSize - 1);
  B = (pascalFactor .* powerScale) * pascalFactor(reverseIndex, reverseIndex);
end
