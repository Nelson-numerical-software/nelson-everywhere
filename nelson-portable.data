if ((strcmp(getnelsonmode(), 'GUI') == 1) || (strcmp(getnelsonmode(), 'WEB_GUI') == 1) || (strcmp(getnelsonmode(), 'ADVANCED_TERMINAL') == 1))
  if ~any(strcmp(argv(), '--nouserstartup'))
    history('save');
  end
  removegateway(modulepath('history_manager', 'builtin'));
end
