% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function test_cases = sort_test_cases_by_order(test_cases)
  if isempty(test_cases) || ~isfield(test_cases, 'test_order_index')
    return
  end
  [~, order] = sort([test_cases.test_order_index]);
  test_cases = test_cases(order);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function [tests, bugs] = split_bug_test_cases(testCases)
  tests = [];
  bugs = [];
  for k = 1:length(testCases)
    if is_bug_test_case(testCases(k))
      bugs = [bugs; testCases(k)];
    else
      tests = [tests; testCases(k)];
    end
  end
end
%=============================================================================
function tf = is_bug_test_case(testCase)
  [~, name, ~] = fileparts(testCase.filename); %#ok<NLS0004>
  tf = startsWith(name, 'bug_');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function msg = test_case_message(testCase, launcherMessage)
  if strcmp(testCase.command, 'echo skip')
    msg = '';
  else
    msg = launcherMessage;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function [status, message, testCase] = test_case_native_status(testCase, nativeResult)
  status = 0;
  message = '';
  if strcmp(testCase.command, 'echo skip')
    return
  end
  testCase = applyNativeProcessResult(testCase, nativeResult);
  status = nativeResult.exit_code;
  message = nativeRunMessage(nativeResult);
  if isfield(testCase, 'runfile_result') && isstruct(testCase.runfile_result)
    status = testCase.runfile_result.r;
    if isfield(testCase.runfile_result, 'msg')
      message = testCase.runfile_result.msg;
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function cmd = test_case_process_options(test_case)
  cmd = '';
  cmd = append_process_option(cmd, test_case.options.english_imposed, '--language en_US');
  cmd = append_process_option(cmd, true, '--nousermodules');
  cmd = append_process_option(cmd, ~test_case.options.ipc_required, '--noipc');
  cmd = append_process_option(cmd, ~test_case.options.file_watcher_required, '--withoutfilewatcher');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function args = test_case_process_user_arguments(test_case)
  args = '';
  args = append_process_option(args, should_disable_audio(test_case), '--noaudio');
  args = append_process_option(args, ~test_case.options.python_environment_required, '--without_python');
  args = append_process_option(args, ~test_case.options.julia_environment_required, '--without_julia');
end
