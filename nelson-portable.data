% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function v = del2(u, varargin)
  narginchk(1, inf);
  if ~(isnumeric(u) || islogical(u))
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Input');
  end
  if isa(u, 'single')
    u = single(u);
  else
    u = double(u);
  end
  nd = ndims(u);
  h = ones(1, nd);
  ns = numel(varargin);
  if ns == 1
    h(:) = spacingScalar(varargin{1});
  elseif ns >= 2
    h(2) = spacingScalar(varargin{1});
    h(1) = spacingScalar(varargin{2});
    for d = 3:min(ns, nd)
      h(d) = spacingScalar(varargin{d});
    end
  end
  acc = zeros(size(u), class(u));
  for d = 1:nd
    acc = acc + secondDiffAlongDim(u, d, h(d));
  end
  v = acc / (2 * nd);
end
%=============================================================================
function D = secondDiffAlongDim(u, d, h)
  sz = size(u);
  n = sz(d);
  D = zeros(sz, class(u));
  if n < 3
    return;
  end
  order = [d, setdiff(1:ndims(u), d)];
  up = permute(u, order);
  szp = size(up);
  m = szp(1);
  rest = prod(szp(2:end));
  up = reshape(up, m, rest);
  interior = (up(1:m - 2, :) - 2 * up(2:m - 1, :) + up(3:m, :)) / (h ^ 2);
  Dp = zeros(m, rest, class(u));
  Dp(2:m - 1, :) = interior;
  if m == 3
    Dp(1, :) = interior(1, :);
    Dp(m, :) = interior(1, :);
  else
    Dp(1, :) = 2 * interior(1, :) - interior(2, :);
    Dp(m, :) = 2 * interior(m - 2, :) - interior(m - 3, :);
  end
  Dp = reshape(Dp, szp);
  D = ipermute(Dp, order);
end
%=============================================================================
function s = spacingScalar(value)
  if ~isnumeric(value) || ~isscalar(value)
    error('Nelson:del2:invalidSpacing', 'Spacing must be a numeric scalar.');
  end
  s = double(value);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = gradient(varargin)
  % gradient: Compute gradient along specified dimensions.
  %   Computes the gradient of the input data along the specified dimensions.
  % FX = gradient(F)
  % [FX, FY] = gradient(F)
  % [FX, FY, FZ, ... , FN] = gradient(F)
  % [...] = gradient(F, h)
  % [...] = gradient(F, hx, hy, ... , hN)

  m = varargin{1};
  inputArguments = varargin(2:end);

  if (isvector(m))
    needTranspose = (size(m, 2) == 1);
    m = m(:).';
  else
    needTranspose = false;
  end

  [d, nd] = computeD(m, inputArguments, nargin);
  m = shiftdim(m, 1);
  % with nargout == 0 (expression statement), one output must still be
  % computed so that 'ans' is defined.
  for i = 1:min(nd, max(1, nargout))
    [varargout{i}, m] = computeGradient(m, d, i, nd);
  end

  if (needTranspose)
    varargout{1} = varargout{1}.';
  end
end
%=============================================================================
function [d, nd] = computeD(m, inputArguments, nbInputs)
  % computeD: Compute differences for gradient computation.
  %   Computes the differences required for gradient computation along each dimension.
  %
  %   Input arguments:
  %       - m: Input data.
  %       - inputArguments: Additional arguments for gradient computation.
  %       - nbInputs: Number of input arguments provided.
  %
  %   Output arguments:
  %       - d: Cell array containing differences along each dimension.
  %       - nd: Number of dimensions in the input data.
  nd = ndims(m);
  sz = size(m);
  if (length(sz) > 1)
    tmp = sz(1);
    sz(1) = sz(2);
    sz(2) = tmp;
  end

  d = cell(1, nd);
  if (nbInputs == 1)
    for i = 1:nd
      d{i} = ones(sz(i) - 1, 1);
    end
  elseif (nbInputs == 2)
    if (isscalar(inputArguments{1}))
      for i = 1:nd
        d{i} = inputArguments{1} * ones(sz(i) - 1, 1);
      end
    else
      d{1} = diff(inputArguments{1}(:));
    end
  else
    if (nbInputs < nd)
      error('Nelson:gradient:spacingMismatch', 'The number of spacing values do not match.');
    end
    for i = 1:nd
      if (isscalar(inputArguments{i}))
        d{i} = inputArguments{i} * ones(sz(i) - 1, 1);
      else
        d{i} = diff(inputArguments{i}(:));
      end
    end
  end
end
%=============================================================================
function [result, m] = computeGradient(m, d, idx, nd)
  % computeGradient: Compute gradient along a specific dimension.
  %   Computes the gradient of the input data along the specified dimension.
  %
  %   Input arguments:
  %       - m: Input data.
  %       - d: Cell array containing differences along each dimension.
  %       - idx: Index of the dimension for gradient computation.
  %       - nd: Number of dimensions in the input data.
  %
  %   Output arguments:
  %       - result: Gradient of the input data along the specified dimension.
  %       - m: Updated input data after gradient computation.
  m_rows = size(m, 1);
  mc = numel(m) / m_rows;
  Y = zeros(size(m), class(m));

  if (m_rows > 1)
    Y(1, :) = diff(m(1:2, :)) / d{idx}(1);
    Y(m_rows, :) = diff(m(m_rows - 1:m_rows, :) / d{idx}(m_rows - 1));
  end

  if (m_rows > 2)
    Y(2:m_rows - 1, :) = ((m(3:m_rows, :) - m(1:m_rows - 2, :)) ./ kron(d{idx}(1:m_rows - 2) + d{idx}(2:m_rows - 1), ones(1, mc)));
  end

  if (idx == 1)
    result = shiftdim(Y, nd - 1);
    m = shiftdim(m, nd - 1);
  elseif (idx == 2)
    result = Y;
    m = shiftdim(m, 2);
  else
    result = shiftdim(Y, nd - idx + 1);
    m = shiftdim(m, 1);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% Upper Hessenberg reduction using Householder reflectors.
% H = hess(A)        returns the upper Hessenberg form H.
% [P, H] = hess(A)   returns unitary P and H such that A = P * H * P'.
%=============================================================================
function varargout = hess(varargin)
  narginchk(1, 1);
  nargoutchk(0, 2);

  A = varargin{1};
  if ~isnumeric(A) || ndims(A) > 2 || size(A, 1) ~= size(A, 2)
    error('Nelson:linear_algebra:squareMatrixExpected', '%s expected.', 'Square matrix');
  end

  n = size(A, 1);
  H = A;
  P = eye(n, class(A));

  for k = 1:n - 2
    x = H(k + 1:n, k);
    if norm(x(2:end)) == 0
      continue;
    end
    if x(1) == 0
      s = 1;
    else
      s = x(1) / abs(x(1));
    end
    alpha = -s * norm(x);
    v = x;
    v(1) = v(1) - alpha;
    nv = norm(v);
    if nv == 0
      continue;
    end
    v = v / nv;
    % Apply H_k = I - 2*v*v' on the left and on the right.
    H(k + 1:n, :) = H(k + 1:n, :) - 2 * v * (v' * H(k + 1:n, :));
    H(:, k + 1:n) = H(:, k + 1:n) - 2 * (H(:, k + 1:n) * v) * v';
    % Accumulate P = Q_1 * Q_2 * ... so that A = P * H * P'.
    P(:, k + 1:n) = P(:, k + 1:n) - 2 * (P(:, k + 1:n) * v) * v';
  end

  if nargout <= 1
    varargout{1} = H;
  else
    varargout{1} = P;
    varargout{2} = H;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = isbanded(varargin)
  narginchk(3, 3);
  nargoutchk(0, 1);

  A = varargin{1};
  lower = varargin{2};
  if (~isreal(lower) || lower < 0)
    error('Nelson:isbanded:invalidLower', '%s must be nonnegative integers.', 'LOWER');
  end

  upper = varargin{3};
  if (~isreal(upper) || upper < 0)
    error('Nelson:isbanded:invalidUpper', '%s must be nonnegative integers.', 'UPPER');
  end

  res = [];
  if ~isempty(A)
    res = (islogical(A) || isnumeric(A)) && (ndims(A) == 2);
    if (res)
      [i, j] = find(A);
      u = j >= i;
      res = all(j(u) - i(u) <= upper);
      if (res)
        l = i >= j;
        res = all(i(l) - j(l) <= lower);
      end
    end
  end
  varargout{1} = res;
end
%=============================================================================

%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = kron(varargin)
  % https://en.wikipedia.org/wiki/Kronecker_product
  narginchk(2, 2);
  nargoutchk(0, 1);

  A = varargin{1};
  B = varargin{2};

  if ~ismatrix(A) || ~ismatrix(B)
    error('Nelson:kron:inputMustBe2D', 'Inputs must be 2-D.');
  end

  if issparse(A) || issparse(B)
    varargout{1} = sparse(kron(full(A), full(B)));
  elseif (isa(A, 'double') || isa(A, 'single')) && ...
      (isa(B, 'double') || isa(B, 'single')) && ...
      isreal(A) && isreal(B)
    varargout{1} = builtin('kron', A, B);
  else
    [m, n] = size(A);
    [p, q] = size(B);
    % preserve integer / single classes (compatible with the reference implementation)
    if isinteger(A)
      outClass = class(A);
    elseif isinteger(B)
      outClass = class(B);
    elseif isa(A, 'single') || isa(B, 'single')
      outClass = 'single';
    else
      outClass = 'double';
    end
    result = zeros(m * p, n * q, outClass);
    for i = 1:m
      for j = 1:n
        a_ij = A(i, j);
        submatrix = a_ij * B;
        row_start = (i - 1) * p + 1;
        row_end = i * p;
        col_start = (j - 1) * q + 1;
        col_end = j * q;
        result(row_start:row_end, col_start:col_end) = submatrix;
      end
    end
    varargout{1} = result;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [X, r] = linsolve(A, B, opts)
  narginchk(2, 3);
  transA = false;
  if nargin == 3
    if ~isstruct(opts)
      error('Nelson:linsolve:invalidOptions', 'Third argument must be a structure of options.');
    end
    if isfield(opts, 'TRANSA') && ~isempty(opts.TRANSA) && opts.TRANSA
      transA = true;
    end
  end
  if transA
    X = A' \ B;
  else
    X = A \ B;
  end
  if nargout > 1
    r = rcond(A);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function Z = null(A, opt)
  narginchk(1, 2);
  nargoutchk(0, 1);
  if ~isnumeric(A) || ndims(A) > 2
    error('Nelson:null:invalidInput', 'Input must be a 2D numeric matrix.');
  end
  [m, n] = size(A);
  if nargin == 2
    if ~(ischar(opt) || (isstring(opt) && isscalar(opt))) || ~strcmpi(char(opt), 'r')
      error('Nelson:null:invalidOption', 'Second argument must be ''r''.');
    end
    % rational basis via reduced row echelon form
    [R, pivcol] = rref(A);
    r = numel(pivcol);
    nopiv = 1:n;
    nopiv(pivcol) = [];
    Z = zeros(n, n - r);
    if n > r
      Z(nopiv, :) = eye(n - r);
      Z(pivcol, :) = -R(1:r, nopiv);
    end
    return;
  end
  % orthonormal basis via singular value decomposition
  if isempty(A)
    Z = zeros(n, n);
    return;
  end
  [~, S, V] = svd(A);
  if m > 1
    s = diag(S);
  else
    s = S(1, 1);
  end
  tol = max(m, n) * eps(max(s));
  r = sum(s > tol);
  Z = V(:, r + 1:n);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = orth(varargin)
  narginchk(1, 2);
  nargoutchk(0, 1);

  A = varargin{1};
  [O, s] = svd(A, 'econ');
  d = diag(s);

  if ~isempty(d) && isnan(d(1))
    error('Nelson:linear_algebra:inputMustBeFinite', '%s must not contain NaN or Inf.', 'Input argument');
  end

  if nargin == 2
    tol = varargin{2};
    if ~(isscalar(tol) && isnumeric(tol) && isreal(tol))
      error('Nelson:orth:invalidTolerance', 'Input argument must be a real numeric scalar tolerance');
    end
  else
    tol = max(size(A)) * eps(norm(d, inf));
  end

  r = sum(d > tol);
  O(:, r + 1:end) = [];
  varargout{1} = O;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
