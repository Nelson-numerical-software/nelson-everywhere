%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function stats = ip_regionprops3_measure(components, imageSize, intensity, properties)
  template = struct();
  for p = 1:numel(properties)
    template.(properties{p}) = [];
  end
  stats = repmat(template, numel(components), 1);
  intensityValues = [];
  if ~isempty(intensity)
    intensityValues = double(intensity);
  end
  for k = 1:numel(components)
    idx = components{k}(:);
    [r, c, z] = ind2sub(imageSize, idx);
    geom = ip_regionprops3_geometry(r, c, z);
    for p = 1:numel(properties)
      prop = properties{p};
      stats(k).(prop) = ip_regionprops3_value(prop, idx, r, c, z, geom, ...
        imageSize, intensityValues);
    end
  end
end
%=============================================================================
function geom = ip_regionprops3_geometry(r, c, z)
  minR = min(r);
  maxR = max(r);
  minC = min(c);
  maxC = max(c);
  minZ = min(z);
  maxZ = max(z);
  geom = struct('MinR', minR, 'MaxR', maxR, 'MinC', minC, 'MaxC', maxC, ...
    'MinZ', minZ, 'MaxZ', maxZ, 'Height', maxR - minR + 1, ...
    'Width', maxC - minC + 1, 'Depth', maxZ - minZ + 1);
end
%=============================================================================
function value = ip_regionprops3_value(prop, idx, r, c, z, geom, imageSize, intensityValues)
  switch prop
    case 'Volume'
      value = numel(idx);
    case 'Centroid'
      value = [mean(c), mean(r), mean(z)];
    case 'BoundingBox'
      value = [geom.MinC - 0.5, geom.MinR - 0.5, geom.MinZ - 0.5, ...
        geom.Width, geom.Height, geom.Depth];
    case 'VoxelIdxList'
      value = idx(:);
    case 'VoxelList'
      value = [c(:), r(:), z(:)];
    case 'Image'
      value = ip_regionprops3_local_image(r, c, z, geom);
    case 'SubarrayIdx'
      value = {geom.MinR:geom.MaxR, geom.MinC:geom.MaxC, geom.MinZ:geom.MaxZ};
    case 'Extent'
      value = numel(idx) / (geom.Width * geom.Height * geom.Depth);
    case 'EquivDiameter'
      value = 2 * ((3 * numel(idx)) / (4 * pi)) ^ (1 / 3);
    case 'MeanIntensity'
      value = mean(intensityValues(idx));
    case 'MinIntensity'
      value = min(intensityValues(idx));
    case 'MaxIntensity'
      value = max(intensityValues(idx));
    case 'VoxelValues'
      value = intensityValues(idx);
      value = value(:);
    case 'WeightedCentroid'
      value = ip_regionprops3_weighted_centroid(r, c, z, intensityValues(idx));
    otherwise
      error('Nelson:image_processing:unsupportedRegionProperty', 'Unsupported "%s" option.', 'region property');
  end
end
%=============================================================================
function image = ip_regionprops3_local_image(r, c, z, geom)
  image = false(geom.Height, geom.Width, geom.Depth);
  local = sub2ind(size(image), r - geom.MinR + 1, c - geom.MinC + 1, z - geom.MinZ + 1);
  image(local) = true;
end
%=============================================================================
function centroid = ip_regionprops3_weighted_centroid(r, c, z, values)
  total = sum(values);
  if total == 0
    centroid = [NaN NaN NaN];
  else
    centroid = [sum(c .* values) / total, sum(r .* values) / total, sum(z .* values) / total];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function tf = ip_regionprops3_needs_intensity(properties)
  needs = {'MeanIntensity', 'MinIntensity', 'MaxIntensity', 'VoxelValues', 'WeightedCentroid'};
  tf = false;
  for k = 1:numel(properties)
    tf = tf || any(strcmp(needs, properties{k}));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function properties = ip_regionprops3_properties(args)
  basic = {'Volume', 'Centroid', 'BoundingBox'};
  allProps = {'Volume', 'Centroid', 'BoundingBox', 'VoxelIdxList', 'VoxelList', 'Image', ...
    'SubarrayIdx', 'Extent', 'EquivDiameter', 'MeanIntensity', 'MinIntensity', ...
    'MaxIntensity', 'VoxelValues', 'WeightedCentroid'};
  if isempty(args)
    properties = basic;
    return
  end
  properties = {};
  for k = 1:numel(args)
    item = args{k};
    if iscell(item)
      for j = 1:numel(item)
        properties = ip_regionprops3_append(properties, item{j}, basic, allProps);
      end
    else
      properties = ip_regionprops3_append(properties, item, basic, allProps);
    end
  end
end
%=============================================================================
function properties = ip_regionprops3_append(properties, value, basic, allProps)
  if ~(ischar(value) || isStringScalar(value))
    error('Nelson:image_processing:unsupportedRegionProperty', 'Unsupported "%s" option.', 'region property');
  end
  name = lower(convertStringsToChars(value));
  if strcmp(name, 'basic')
    properties = ip_regionprops3_append_many(properties, basic);
  elseif strcmp(name, 'all')
    properties = ip_regionprops3_append_many(properties, allProps);
  else
    properties{end + 1} = ip_regionprops3_canonical(name, allProps);
  end
end
%=============================================================================
function properties = ip_regionprops3_append_many(properties, names)
  for k = 1:numel(names)
    if ~any(strcmp(properties, names{k}))
      properties{end + 1} = names{k};
    end
  end
end
%=============================================================================
function prop = ip_regionprops3_canonical(name, allProps)
  aliases = {'VoxelIndices', 'VoxelIdxList'; 'VoxelValues', 'VoxelValues'};
  for k = 1:size(aliases, 1)
    if strcmp(name, lower(aliases{k, 1}))
      prop = aliases{k, 2};
      return
    end
  end
  for k = 1:numel(allProps)
    if strcmp(name, lower(allProps{k}))
      prop = allProps{k};
      return
    end
  end
  error('Nelson:image_processing:unsupportedRegionProperty', 'Unsupported "%s" option.', 'region property');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function name = ip_regionprops_canonical_name(name, supportedProps)
  name = convertStringsToChars(name);
  matches = strcmpi(name, supportedProps);
  if any(matches)
    name = supportedProps{find(matches, 1)};
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function T = ip_registration_affine_matrix(imgSize, angleDegrees, scaleX, scaleY, shear)
  rows = imgSize(1);
  cols = imgSize(2);
  cx = (cols + 1) / 2;
  cy = (rows + 1) / 2;
  theta = angleDegrees * pi / 180;
  c = cos(theta);
  s = sin(theta);
  toOrigin = [1 0 0; 0 1 0; -cx -cy 1];
  fromOrigin = [1 0 0; 0 1 0; cx cy 1];
  affinePart = [scaleX 0 0; shear scaleY 0; 0 0 1] ...
    * [c s 0; -s c 0; 0 0 1];
  T = toOrigin * affinePart * fromOrigin;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [bestT, bestAngle, bestScaleX, bestScaleY, bestShear] = ...
  ip_registration_affine_search(moving, fixed, angles, options, metricType, varargin)
  if nargin == 5
    scalesX = unique([1 - options.ScaleSearch, 1, 1 + options.ScaleSearch]);
    scalesY = scalesX;
    shears = unique([-options.ShearSearch, 0, options.ShearSearch]);
  else
    scalesX = varargin{1};
    scalesY = varargin{2};
    shears = varargin{3};
  end
  bestScore = -Inf;
  bestT = options.InitialTransformation;
  bestAngle = 0;
  bestScaleX = 1;
  bestScaleY = 1;
  bestShear = 0;
  for a = angles
    for sx = scalesX
      for sy = scalesY
        for sh = shears
          [score, candidateT] = ip_score_affine_candidate(...
            moving, fixed, a, sx, sy, sh, metricType, options);
          if score > bestScore
            bestScore = score;
            bestT = candidateT;
            bestAngle = a;
            bestScaleX = sx;
            bestScaleY = sy;
            bestShear = sh;
          end
        end
      end
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function method = ip_registration_interpolation(value)
  if ~(ischar(value) || isStringScalar(value))
    error('Nelson:image_processing:interpolationMethodString', '%s must be a string.', 'Interpolation method');
  end
  method = lower(convertStringsToChars(value));
  if ~(strcmp(method, 'nearest') || strcmp(method, 'linear') || strcmp(method, 'bilinear') ...
      || strcmp(method, 'cubic'))
    error('Nelson:image_processing:unsupportedInterpolationMethod', 'Unsupported "%s" option.', 'interpolation method');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function metricType = ip_registration_metric_type(metric)
  if isstruct(metric)
    if ~isfield(metric, 'Type')
      error('Nelson:image_processing:registrationMetricContainTypeField', 'Registration metric must contain a Type field.');
    end
    metric = metric.Type;
  end
  if ~(ischar(metric) || isStringScalar(metric))
    error('Nelson:image_processing:registrationMetricTypeString', '%s must be a string.', 'Registration metric type');
  end
  metricType = lower(convertStringsToChars(metric));
  switch metricType
    case {'meansquares', 'mean-squares', 'mean_squares'}
      metricType = 'meansquares';
    case {'correlation', 'mattesmutualinformation'}
      metricType = 'correlation';
    otherwise
      error('Nelson:image_processing:unsupportedRegistrationMetric', 'Unsupported "%s" option.', 'registration metric');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function optimizer = ip_registration_optimizer(optimizer)
  if ~isstruct(optimizer)
    error('Nelson:image_processing:registrationOptimizerStructure', 'Registration optimizer must be a structure.');
  end
  if ~isfield(optimizer, 'MaximumIterations')
    optimizer.MaximumIterations = 50;
  end
  if ~isnumeric(optimizer.MaximumIterations) || ~isreal(optimizer.MaximumIterations) ...
      || numel(optimizer.MaximumIterations) ~= 1 || optimizer.MaximumIterations < 1 ...
      || fix(optimizer.MaximumIterations) ~= optimizer.MaximumIterations
    error('Nelson:image_processing:maximumiterationsPositiveIntegerScalar', '%s must be a positive integer scalar.', 'MaximumIterations');
  end
  if ~isfield(optimizer, 'AngleSearch')
    optimizer.AngleSearch = 15;
  end
  if ~isfield(optimizer, 'ScaleSearch')
    optimizer.ScaleSearch = 0.05;
  end
  if ~isfield(optimizer, 'ShearSearch')
    optimizer.ShearSearch = 0.05;
  end
  if ~isnumeric(optimizer.AngleSearch) || ~isreal(optimizer.AngleSearch) ...
      || numel(optimizer.AngleSearch) ~= 1 || ~isfinite(optimizer.AngleSearch) ...
      || optimizer.AngleSearch < 0
    error('Nelson:image_processing:anglesearchNonnegativeFiniteScalar', '%s must be a nonnegative finite scalar.', 'AngleSearch');
  end
  if ~isnumeric(optimizer.ScaleSearch) || ~isreal(optimizer.ScaleSearch) ...
      || numel(optimizer.ScaleSearch) ~= 1 || ~isfinite(optimizer.ScaleSearch) ...
      || optimizer.ScaleSearch < 0 || optimizer.ScaleSearch >= 1
    error('Nelson:image_processing:scalesearchFiniteScalarRange', '%s must be a finite scalar in the range [%s].', 'ScaleSearch', '0, 1');
  end
  if ~isnumeric(optimizer.ShearSearch) || ~isreal(optimizer.ShearSearch) ...
      || numel(optimizer.ShearSearch) ~= 1 || ~isfinite(optimizer.ShearSearch) ...
      || optimizer.ShearSearch < 0 || optimizer.ShearSearch >= 1
    error('Nelson:image_processing:shearsearchFiniteScalarRange', '%s must be a finite scalar in the range [%s].', 'ShearSearch', '0, 1');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function score = ip_registration_score(moving, fixed, T, metricType, interpolation)
  warped = imwarp(moving, T, 'Interpolation', interpolation, ...
    'OutputView', [size(fixed, 1), size(fixed, 2)]);
  if strcmp(metricType, 'meansquares')
    d = warped - fixed;
    score = -mean(d(:) .^ 2);
  else
    a = warped(:) - mean(warped(:));
    b = fixed(:) - mean(fixed(:));
    denom = sqrt(sum(a .^ 2) * sum(b .^ 2));
    if denom == 0
      score = 0;
    else
      score = sum(a .* b) / denom;
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [bestT, bestAngle, bestScale] = ip_registration_search(moving, fixed, angles, scales, metricType, options)
  bestScore = -Inf;
  bestT = options.InitialTransformation;
  bestAngle = 0;
  bestScale = 1;
  for a = angles
    for s = scales
      candidateBase = options.InitialTransformation ...
        * ip_registration_similarity_matrix(size(moving), a, s);
      candidateWarped = imwarp(moving, candidateBase, 'Interpolation', options.Interpolation, ...
        'OutputView', [size(fixed, 1), size(fixed, 2)]);
      delta = imregcorr(candidateWarped, fixed);
      candidateT = candidateBase * delta.T;
      score = ip_registration_score(moving, fixed, candidateT, metricType, options.Interpolation);
      if score > bestScore
        bestScore = score;
        bestT = candidateT;
        bestAngle = a;
        bestScale = s;
      end
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function T = ip_registration_similarity_matrix(imgSize, angleDegrees, scale)
  rows = imgSize(1);
  cols = imgSize(2);
  cx = (cols + 1) / 2;
  cy = (rows + 1) / 2;
  theta = angleDegrees * pi / 180;
  c = cos(theta);
  s = sin(theta);
  toOrigin = [1 0 0; 0 1 0; -cx -cy 1];
  fromOrigin = [1 0 0; 0 1 0; cx cy 1];
  A = [scale * c scale * s 0; -scale * s scale * c 0; 0 0 1];
  T = toOrigin * A * fromOrigin;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function transformType = ip_registration_transform_type(value)
  if ~(ischar(value) || isStringScalar(value))
    error('Nelson:image_processing:registrationTransformationTypeString', '%s must be a string.', 'Registration transformation type');
  end
  transformType = lower(convertStringsToChars(value));
  switch transformType
    case {'translation', 'rigid', 'similarity', 'affine'}
    otherwise
      error('Nelson:image_processing:unsupportedRegistrationTransformationType', 'Unsupported "%s" option.', 'registration transformation type');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function out = ip_resize3_linear_dim(data, outputLength, dim)
  inputLength = size(data, dim);
  [lo, hi, alpha] = ip_resize3_coordinates(inputLength, outputLength);
  if dim == 1
    weightShape = [outputLength 1 1];
    alpha = reshape(alpha, weightShape);
    out = data(lo, :, :) .* (1 - alpha) + data(hi, :, :) .* alpha;
  elseif dim == 2
    weightShape = [1 outputLength 1];
    alpha = reshape(alpha, weightShape);
    out = data(:, lo, :) .* (1 - alpha) + data(:, hi, :) .* alpha;
  else
    weightShape = [1 1 outputLength];
    alpha = reshape(alpha, weightShape);
    out = data(:, :, lo) .* (1 - alpha) + data(:, :, hi) .* alpha;
  end
end
%=============================================================================
function [lo, hi, alpha] = ip_resize3_coordinates(inputLength, outputLength)
  coord = ((1:outputLength) - 0.5) * inputLength / outputLength + 0.5;
  lo = floor(coord);
  hi = lo + 1;
  alpha = coord - lo;
  lo = min(max(lo, 1), inputLength);
  hi = min(max(hi, 1), inputLength);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function out = ip_resize3_nearest(volume, outputSize)
  rowIndex = ip_resize3_nearest_index(size(volume, 1), outputSize(1));
  columnIndex = ip_resize3_nearest_index(size(volume, 2), outputSize(2));
  planeIndex = ip_resize3_nearest_index(size(volume, 3), outputSize(3));
  out = volume(rowIndex, columnIndex, planeIndex);
end
%=============================================================================
function idx = ip_resize3_nearest_index(inputLength, outputLength)
  coord = ((1:outputLength) - 0.5) * inputLength / outputLength + 0.5;
  idx = min(max(round(coord), 1), inputLength);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function ref = ip_resolve_output_ref(outputView, srcRef, tform)
  if ischar(outputView) || isstring(outputView)
    mode = lower(convertStringsToChars(outputView));
    if strcmp(mode, 'same')
      ref = srcRef;
    elseif strcmp(mode, 'full')
      ref = ip_full_output_ref(srcRef, tform);
    else
      error('Nelson:image_processing:unsupportedOutputView', 'Unsupported "%s" option.', 'output view');
    end
  elseif isstruct(outputView)
    ref = ip_validate_imref2d(outputView);
  else
    ref = ip_make_imref2d(outputView, [], []);
  end
end
%=============================================================================
function ref = ip_full_output_ref(srcRef, tform)
  xlim = srcRef.XWorldLimits;
  ylim = srcRef.YWorldLimits;
  dx = srcRef.PixelExtentInWorldX;
  dy = srcRef.PixelExtentInWorldY;
  xCenters = [xlim(1) + dx / 2, xlim(2) - dx / 2];
  yCenters = [ylim(1) + dy / 2, ylim(2) - dy / 2];
  corners = [xCenters(1) yCenters(1) 1; xCenters(2) yCenters(1) 1; ...
    xCenters(1) yCenters(2) 1; xCenters(2) yCenters(2) 1] * tform;
  x = corners(:, 1) ./ corners(:, 3);
  y = corners(:, 2) ./ corners(:, 3);
  xLimits = [min(x) - dx / 2, max(x) + dx / 2];
  yLimits = [min(y) - dy / 2, max(y) + dy / 2];
  imageSize = [max(1, ceil(diff(yLimits) / dy)) max(1, ceil(diff(xLimits) / dx))];
  xLimits(2) = xLimits(1) + imageSize(2) * dx;
  yLimits(2) = yLimits(1) + imageSize(1) * dy;
  ref = ip_make_imref2d(imageSize, xLimits, yLimits);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function ref = ip_resolve_output_ref3d(outputView, srcRef, tform)
  if ischar(outputView) || isStringScalar(outputView)
    mode = lower(convertStringsToChars(outputView));
    if strcmp(mode, 'same')
      ref = srcRef;
    elseif strcmp(mode, 'full')
      ref = ip_full_output_ref3d(srcRef, tform);
    else
      error('Nelson:image_processing:unsupportedOutputView', 'Unsupported "%s" option.', 'output view');
    end
  elseif isstruct(outputView)
    ref = ip_validate_imref3d(outputView);
  else
    ref = ip_make_imref3d(outputView, [], [], []);
  end
end
%=============================================================================
function ref = ip_full_output_ref3d(srcRef, tform)
  dx = srcRef.PixelExtentInWorldX;
  dy = srcRef.PixelExtentInWorldY;
  dz = srcRef.PixelExtentInWorldZ;
  xCenters = [srcRef.XWorldLimits(1) + dx / 2, srcRef.XWorldLimits(2) - dx / 2];
  yCenters = [srcRef.YWorldLimits(1) + dy / 2, srcRef.YWorldLimits(2) - dy / 2];
  zCenters = [srcRef.ZWorldLimits(1) + dz / 2, srcRef.ZWorldLimits(2) - dz / 2];
  [X, Y, Z] = ndgrid(xCenters, yCenters, zCenters);
  corners = [X(:), Y(:), Z(:), ones(numel(X), 1)] * tform;
  xLimits = [min(corners(:, 1)) - dx / 2, max(corners(:, 1)) + dx / 2];
  yLimits = [min(corners(:, 2)) - dy / 2, max(corners(:, 2)) + dy / 2];
  zLimits = [min(corners(:, 3)) - dz / 2, max(corners(:, 3)) + dz / 2];
  imageSize = [max(1, ceil(diff(yLimits) / dy)), max(1, ceil(diff(xLimits) / dx)), ...
    max(1, ceil(diff(zLimits) / dz))];
  xLimits(2) = xLimits(1) + imageSize(2) * dx;
  yLimits(2) = yLimits(1) + imageSize(1) * dy;
  zLimits(2) = zLimits(1) + imageSize(3) * dz;
  ref = ip_make_imref3d(imageSize, xLimits, yLimits, zLimits);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [score, candidateT] = ip_score_affine_candidate(moving, fixed, angle, scaleX, scaleY, shear, metricType, options)
  candidateBase = options.InitialTransformation ...
    * ip_registration_affine_matrix(size(moving), angle, scaleX, scaleY, shear);
  candidateWarped = imwarp(moving, candidateBase, 'Interpolation', options.Interpolation, ...
    'OutputView', [size(fixed, 1), size(fixed, 2)]);
  delta = imregcorr(candidateWarped, fixed);
  candidateT = candidateBase * delta.T;
  score = ip_registration_score(moving, fixed, candidateT, metricType, options.Interpolation);
end
