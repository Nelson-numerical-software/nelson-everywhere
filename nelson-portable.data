%=============================================================================
% NFlow.internal.runStopFcn(code, out)
%
% Run a model's StopFcn once a simulation stops: the
% callback text is executed in the base workspace, where the To Workspace
% variables already live, with the SimulationOutput exposed as 'out'. A failing
% callback warns instead of aborting the completed run. Shared by sim() and the
% GUI Run hook.
%=============================================================================
function runStopFcn(code, out)
  narginchk(2, 2);
  if ~(ischar(code) || (isstring(code) && isscalar(code)))
    return
  end
  code = strtrim(char(code));
  if isempty(code)
    return
  end
  assignin('base', 'out', out);
  try
    evalin('base', code);
  catch e
    warning('Nelson:nflow_engine:stopFcn', sprintf('StopFcn failed: %s', e.message));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% fired = NFlow.internal.runStopFcnForRun(documentJson, resultJson)
%
% Fire a model's StopFcn from the GUI Run path. The editor runs the engine in
% C++ (not through sim()), so this bare-identifier helper is called by name
% (feval) from the interpreter thread once the run stops: it decodes the model
% and the engine result, and if the model carries a top-level 'stopFcn' it
% builds the same 'out' struct sim() exposes and runs the callback in the base
% workspace. Returns true when a callback was present and executed.
% See NFlow.internal.buildSimOutput, NFlow.internal.runStopFcn, sim.
%=============================================================================
function fired = runStopFcnForRun(documentJson, resultJson)
  narginchk(2, 2);
  fired = false;
  document = jsondecode(documentJson);
  if ~isfield(document, 'stopFcn')
    return
  end
  stopFcn = document.stopFcn;
  if ~(ischar(stopFcn) || (isstring(stopFcn) && isscalar(stopFcn)))
    return
  end
  if isempty(strtrim(char(stopFcn)))
    return
  end
  result = jsondecode(resultJson);
  out = NFlow.internal.buildSimOutput(result, document);
  NFlow.internal.runStopFcn(char(stopFcn), out);
  fired = true;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
classdef NFlow
  % NFlow  Namespace for the nflow programmatic model API.
  methods (Static)
    function connection = connectBlocks(src, dst, varargin)
      % NFlow.connectBlocks  Connect the first free ports of two blocks.
      %   connection = NFlow.connectBlocks(src, dst)
      %   connection = NFlow.connectBlocks(src, dst, 'RoutingStyle', style)
      connection = __nflow_connectBlocks__(src, dst, varargin{:});
    end

    function figures = plotScopes(out)
      % NFlow.plotScopes  Open one figure per scope of a simulation result.
      %   figures = NFlow.plotScopes(out)
      %
      %   out is the structure returned by sim(). Every logged signal in
      %   out.logsout is drawn in its own figure, one line per channel. Handy
      %   as a model StopFcn, e.g. set the model's StopFcn to
      %   'NFlow.plotScopes(out)' to pop the traces up when the run stops.
      narginchk(1, 1);
      figures = [];
      if ~isstruct(out) || ~isfield(out, 'logsout')
        return
      end
      logs = out.logsout;
      for k = 1:numel(logs)
        values = logs(k).values;
        if isempty(values)
          continue
        end
        t = logs(k).time(:);
        if isempty(t) || numel(t) ~= size(values, 1)
          t = (1:size(values, 1))';
        end
        f = figure();
        plot(t, values, 'LineWidth', 1.4);
        grid('on');
        xlabel('t (s)');
        ylabel('signal');
        title(['scope: ', logs(k).name]);
        channels = size(values, 2);
        legendLabels = cell(1, channels);
        for j = 1:channels
          legendLabels{j} = sprintf('in %d', j);
        end
        legend(legendLabels, 'Location', 'best');
        figures(end + 1) = f; %#ok<AGROW>
      end
    end

    function fmuPath = exportfmu(modelFile, destinationDirectory)
      % NFlow.exportfmu  Export a model as an FMI 3.0 Co-Simulation source FMU.
      %   fmuPath = NFlow.exportfmu(modelFile)
      %   fmuPath = NFlow.exportfmu(modelFile, destinationDirectory)
      %
      %   Generates the model to C, wraps it with an FMI 3.0 Co-Simulation
      %   interface, and packages modelDescription.xml + the C sources into a
      %   <model>.fmu archive. Returns the full path to the .fmu.
      %
      %   Only Float64 signals are supported at the FMU boundary; conditional-
      %   execution and FMU / nelsonFunction blocks are rejected.
      narginchk(1, 2);
      if ~ischar(modelFile) && ~(isstring(modelFile) && isscalar(modelFile))
        error('Nelson:nflow_engine:invalidArgument:firstArgumentANflowModelFile', 'First argument must be a .nflow model file path.');
      end
      modelFile = char(modelFile);
      if ~isfile(modelFile)
        error('Nelson:nflow_engine:modelFileNotFound', 'The model file does not exist: %s', modelFile);
      end
      if nargin < 2 || isempty(destinationDirectory)
        destinationDirectory = fileparts(modelFile);
        if isempty(destinationDirectory)
          destinationDirectory = pwd();
        end
      end
      destinationDirectory = char(destinationDirectory);
      if ~isdir(destinationDirectory)
        mkdir(destinationDirectory);
      end
      if ispc()
        try
          loadcompilerconf();
        catch
        end
      end
      % Stage the FMU tree (modelDescription.xml + sources/) in a temp directory.
      staging = tempname();
      mkdir(staging);
      % When the FMI 3.0 headers are available (nflow_fmi module) and a C
      % toolchain is present, the sources are also compiled to a platform binary
      % under binaries/<platform>/; otherwise a source-only FMU is produced.
      fmiInclude = '';
      try
        % Prefer the shipped copy (installed with the module); fall back to the
        % vendored fmi4c sources in a development tree.
        candidates = {[modulepath('nflow_fmi'), '/resources/fmi3'], ...
          [modulepath('nflow_fmi'), '/src/fmi4c/3rdparty/fmi']};
        for ci = 1:numel(candidates)
          if isdir(candidates{ci})
            fmiInclude = candidates{ci};
            break;
          end
        end
      catch
      end
      modelName = __nflow_export_fmu_sources__(modelFile, staging, fmiInclude);
      fmuPath = fullfile(destinationDirectory, [modelName, '.fmu']);
      if isfile(fmuPath)
        delete(fmuPath);
      end
      % A .fmu is a zip whose root holds modelDescription.xml and sources/ (and
      % binaries/ when the binary was built). Pass absolute staged files with a
      % trailing-separator root so the archive entries are relative to the
      % staging directory (no staging prefix).
      files = {fullfile(staging, 'modelDescription.xml'), fullfile(staging, 'sources')};
      binDir = fullfile(staging, 'binaries');
      if isdir(binDir)
        files{end + 1} = binDir;
      end
      zip(fmuPath, files, [staging, filesep]);
    end

    function info = sspInfo(sspFile)
      % NFlow.sspInfo  Inspect an SSP (System Structure and Parameterization) file.
      %   info = NFlow.sspInfo(sspFile)
      %
      %   Reads the SystemStructure.ssd of an .ssp archive and returns a struct:
      %     info.name         top-level system name
      %     info.components   struct array {name, source, type, implementation}
      %                       (each component references an FMU under resources/)
      %     info.connections  struct array {startElement, startConnector,
      %                       endElement, endConnector}
      narginchk(1, 1);
      sspFile = char(sspFile);
      if ~isfile(sspFile)
        error('Nelson:nflow_engine:sspNotFound', 'SSP file not found: %s', sspFile);
      end
      staging = tempname();
      mkdir(staging);
      unzip(sspFile, staging);
      ssd = fullfile(staging, 'SystemStructure.ssd');
      if ~isfile(ssd)
        error('Nelson:nflow_engine:invalidSSP', 'Invalid SSP: SystemStructure.ssd not found at the archive root.');
      end
      doc = xmlread(ssd);
      root = doc.getDocumentElement();
      info = struct();
      info.name = char(root.getAttribute('name'));

      % Map each component name to the .ssv files it binds. This DOM offers no
      % tree navigation (no getParentNode, and a scoped getElementsByTagName on an
      % element returns nothing), so the Component<->ParameterBinding association
      % is recovered from the .ssd text: a binding belongs to the nearest
      % Component element that opens before it.
      ssdText = fileread(ssd);
      bindMap = NFlow.componentBindings(ssdText);
      info.systemConnectors = NFlow.systemConnectors(ssdText);

      comps = doc.getElementsByTagName('Component');
      components = struct('name', {}, 'source', {}, 'type', {}, ...
        'implementation', {}, 'parameterSources', {}, 'inlineParameters', {});
      for i = 0:(comps.getLength() - 1)
        c = comps.item(i);
        nm = char(c.getAttribute('name'));
        srcs = {};
        inlinePv = struct();
        bi = find(strcmp({bindMap.name}, nm), 1);
        if ~isempty(bi)
          srcs = bindMap(bi).sources;
          % Parameter values written straight into the .ssd (a ParameterBinding
          % with no source but an inline ParameterSet) are parsed here.
          for k = 1:numel(bindMap(bi).inlineSets)
            inlinePv = NFlow.mergeStruct(inlinePv, ...
              NFlow.readSsvText(bindMap(bi).inlineSets{k}));
          end
        end
        components(end + 1) = struct( ...
          'name', nm, ...
          'source', char(c.getAttribute('source')), ...
          'type', char(c.getAttribute('type')), ...
          'implementation', char(c.getAttribute('implementation')), ...
          'parameterSources', {srcs}, ...
          'inlineParameters', inlinePv); %#ok<AGROW>
      end
      info.components = components;

      conns = doc.getElementsByTagName('Connection');
      connections = struct('startElement', {}, 'startConnector', {}, 'endElement', {}, 'endConnector', {});
      for i = 0:(conns.getLength() - 1)
        k = conns.item(i);
        connections(end + 1) = struct( ...
          'startElement', char(k.getAttribute('startElement')), ...
          'startConnector', char(k.getAttribute('startConnector')), ...
          'endElement', char(k.getAttribute('endElement')), ...
          'endConnector', char(k.getAttribute('endConnector'))); %#ok<AGROW>
      end
      info.connections = connections;
    end

    function nflowPath = sspImport(sspFile, destinationDirectory)
      % NFlow.sspImport  Import an SSP into a runnable .nflow model.
      %   nflowPath = NFlow.sspImport(sspFile)
      %   nflowPath = NFlow.sspImport(sspFile, destinationDirectory)
      %
      %   Extracts the SSP's component FMUs, maps each component to an FMU block
      %   and each connection to a wire (connectors matched to ports by name via
      %   native FMU inspection), and writes a .nflow model that simulates like
      %   any diagram. Component FMUs must be FMI 2.0 or 3.0 (FMI 1.0 is not
      %   supported); an FMU that cannot be inspected is reported.
      narginchk(1, 2);
      sspFile = char(sspFile);
      if ~isfile(sspFile)
        error('Nelson:nflow_engine:sspNotFound', 'SSP file not found: %s', sspFile);
      end
      if nargin < 2 || isempty(destinationDirectory)
        destinationDirectory = fileparts(sspFile);
        if isempty(destinationDirectory)
          destinationDirectory = pwd();
        end
      end
      destinationDirectory = char(destinationDirectory);
      if ~isdir(destinationDirectory)
        mkdir(destinationDirectory);
      end
      info = NFlow.sspInfo(sspFile);
      [~, stem] = fileparts(sspFile);
      stem = regexprep(stem, '[^a-zA-Z0-9_]', '_');
      % Extract the SSP resources next to the produced model so the FMU blocks
      % resolve their sources.
      resDir = fullfile(destinationDirectory, [stem, '_resources']);
      if isdir(resDir)
        rmdir(resDir, 's');
      end
      mkdir(resDir);
      unzip(sspFile, resDir);

      blocks = {};
      % Per component: its block id and ordered input/output connector names.
      compIndex = struct('name', {}, 'blockId', {}, 'inputs', {}, 'outputs', {});
      for i = 1:numel(info.components)
        comp = info.components(i);
        fmuPath = fullfile(resDir, strrep(comp.source, '/', filesep));
        if ~isfile(fmuPath)
          error('Nelson:nflow_engine:sspFmuNotFound', 'SSP component FMU not found: %s', comp.source);
        end
        j = jsondecode(__nflow_fmi_inspect_json__(fmuPath));
        if ~isfield(j, 'success') || ~j.success
          % Not loadable: most commonly FMI 1.0 (the runtime supports 2.0 and
          % 3.0) or a corrupt FMU. Report the version, read from the inspector
          % when exposed, otherwise straight from the modelDescription.xml.
          ver = '';
          if isfield(j, 'fmiVersion')
            ver = char(j.fmiVersion);
          else
            ver = NFlow.fmuFmiVersion(fmuPath);
          end
          if ~isempty(ver) && ~strcmp(ver, '2.0') && ~strcmp(ver, '3.0')
            error('Nelson:nflow_engine:unsupportedFmiVersion', 'SSP component requires FMI 2.0 or 3.0 but is FMI %s: %s', ver, comp.source);
          end
          error('Nelson:nflow_engine:fmuLoadFailed', 'Cannot load SSP component FMU (FMI 2.0 or 3.0 Co-Simulation required): %s', comp.source);
        end
        inNames = {}; outNames = {};
        % jsondecode yields a struct array when every variable has the same
        % fields, and a cell array when they differ (outputs have no 'start').
        vars = j.variables;
        for v = 1:numel(vars)
          if iscell(vars)
            var = vars{v};
          else
            var = vars(v);
          end
          if strcmp(var.causality, 'input')
            inNames{end + 1} = var.name; %#ok<AGROW>
          elseif strcmp(var.causality, 'output')
            outNames{end + 1} = var.name; %#ok<AGROW>
          end
        end
        blockId = regexprep(comp.name, '[^a-zA-Z0-9_]', '_');
        params = struct('path', fmuPath);
        % SSP parameterization: apply the values from every .ssv this component
        % binds, so the FMU block starts with the composition's parameters.
        pv = struct();
        if isfield(comp, 'parameterSources')
          for s = 1:numel(comp.parameterSources)
            ssvPath = fullfile(resDir, strrep(comp.parameterSources{s}, '/', filesep));
            if isfile(ssvPath)
              pv = NFlow.mergeStruct(pv, NFlow.readSsv(ssvPath));
            end
          end
        end
        % Values embedded directly in the .ssd take effect alongside any .ssv.
        if isfield(comp, 'inlineParameters')
          pv = NFlow.mergeStruct(pv, comp.inlineParameters);
        end
        if ~isempty(fieldnames(pv))
          params.parameterValues = pv;
        end
        % Port layout for the FMU block renderer: without numInputs/numOutputs
        % and the port names, the block draws a single default port at its origin
        % (a stray marker in the top-left corner) instead of one labelled port per
        % connector. These are the same fields FMU inspection writes.
        params.numInputs = numel(inNames);
        params.numOutputs = numel(outNames);
        params.inputNames = inNames;
        params.outputNames = outNames;
        blocks{end + 1} = struct('id', blockId, 'type', 'fmu', ...
          'inputs', numel(inNames), 'outputs', max(1, numel(outNames)), ...
          'params', params); %#ok<AGROW>
        compIndex(end + 1) = struct('name', comp.name, 'blockId', blockId, ...
          'inputs', {inNames}, 'outputs', {outNames}); %#ok<AGROW>
      end

      findComp = @(nm) find(strcmp({compIndex.name}, nm), 1);
      connections = {};
      for i = 1:numel(info.connections)
        cn = info.connections(i);
        si = findComp(cn.startElement);
        di = findComp(cn.endElement);
        if ~isempty(cn.startElement) && ~isempty(cn.endElement)
          % Component-to-component: wire output port -> input port by name.
          if isempty(si) || isempty(di)
            continue;
          end
          fromIdx = find(strcmp(compIndex(si).outputs, cn.startConnector), 1);
          toIdx = find(strcmp(compIndex(di).inputs, cn.endConnector), 1);
          if isempty(fromIdx) || isempty(toIdx)
            continue; % connector not found on that component's ports
          end
          connections{end + 1} = struct('from', compIndex(si).blockId, ...
            'fromIndex', fromIdx - 1, 'to', compIndex(di).blockId, ...
            'toIndex', toIdx - 1); %#ok<AGROW>
        elseif ~isempty(cn.startElement) && isempty(cn.endElement) && ~isempty(si)
          % Component output -> parent system output: expose it as a recordable
          % To Workspace sink named after the system connector, so the imported
          % model produces the composition's observable outputs.
          fromIdx = find(strcmp(compIndex(si).outputs, cn.startConnector), 1);
          if isempty(fromIdx)
            continue;
          end
          sinkVar = regexprep(cn.endConnector, '[^a-zA-Z0-9_]', '_');
          sinkId = ['out_', sinkVar];
          blocks{end + 1} = struct('id', sinkId, 'type', 'toWorkspace', ...
            'inputs', 1, 'outputs', 0, 'params', struct('VariableName', sinkVar, ...
            'SaveFormat', 'Array', 'Decimation', 1, 'MaxDataPoints', 'inf')); %#ok<AGROW>
          connections{end + 1} = struct('from', compIndex(si).blockId, ...
            'fromIndex', fromIdx - 1, 'to', sinkId, 'toIndex', 0); %#ok<AGROW>
        end
        % A parent-system input -> component input (empty startElement) has no
        % driver in the imported model; left unconnected (the FMU input holds 0).
      end

      % Lay the blocks out so the imported model is readable instead of stacked
      % at the origin (blocks created above carry no x/y). Signal flow is
      % left-to-right: FMU components in left column(s), To Workspace output
      % sinks in a column to their right; each column stacks vertically, wrapping
      % to a new column after a few rows so a large composition stays compact.
      x0 = 80; yTop = 80; dx = 240; dy = 150; rowsPerCol = 5;
      rFmu = 0;
      for bi = 1:numel(blocks)
        if strcmp(blocks{bi}.type, 'toWorkspace')
          continue % sinks placed after, to the right of every component column
        end
        col = floor(rFmu / rowsPerCol);
        row = mod(rFmu, rowsPerCol);
        blocks{bi}.x = x0 + col * dx;
        blocks{bi}.y = yTop + row * dy;
        blocks{bi}.rotation = 0;
        rFmu = rFmu + 1;
      end
      fmuCols = max(1, ceil(rFmu / rowsPerCol));
      sinkX = x0 + fmuCols * dx + 120;
      rSink = 0;
      for bi = 1:numel(blocks)
        if ~strcmp(blocks{bi}.type, 'toWorkspace')
          continue
        end
        blocks{bi}.x = sinkX + floor(rSink / rowsPerCol) * dx;
        blocks{bi}.y = yTop + mod(rSink, rowsPerCol) * dy;
        blocks{bi}.rotation = 0;
        rSink = rSink + 1;
      end

      d = struct();
      d.blocks = blocks;
      d.connections = connections;
      d.sampleTime = 0.01;
      d.duration = 10.0;
      d.variables = struct();
      d.solver = 'discrete';
      nflowPath = fullfile(destinationDirectory, [stem, '.nflow']);
      fid = fopen(nflowPath, 'wt');
      fwrite(fid, jsonencode(d));
      fclose(fid);
    end

    function sspPath = sspExport(sspFile, components, connections)
      % NFlow.sspExport  Compose nflow models into an SSP archive.
      %   sspPath = NFlow.sspExport(sspFile, components)
      %   sspPath = NFlow.sspExport(sspFile, components, connections)
      %
      %   components : struct array with fields
      %       .name   component name (used for resources/<name>.fmu)
      %       .model  path to a .nflow model, exported to an FMI 3.0 FMU
      %   connections (optional) : struct array with fields
      %       .startElement .startConnector .endElement .endConnector
      %       (connectors are the models' external label-port names)
      %
      %   Each model is exported to an FMU, placed under resources/, listed as a
      %   Component (with its inspected input/output Connectors) in
      %   SystemStructure.ssd, and the whole tree is zipped into the .ssp.
      narginchk(2, 3);
      if nargin < 3
        connections = struct('startElement', {}, 'startConnector', {}, 'endElement', {}, 'endConnector', {});
      end
      sspFile = char(sspFile);
      staging = tempname();
      mkdir(staging);
      resDir = fullfile(staging, 'resources');
      mkdir(resDir);

      esc = @(s) strrep(strrep(strrep(strrep(char(s), '&', '&amp;'), '<', '&lt;'), '>', '&gt;'), '"', '&quot;');
      body = '';
      for i = 1:numel(components)
        comp = components(i);
        cname = char(comp.name);
        fmu = NFlow.exportfmu(char(comp.model), resDir);
        % Name the component FMU after the component (stable source path).
        target = fullfile(resDir, [cname, '.fmu']);
        if ~strcmp(fmu, target)
          copyfile(fmu, target);
          delete(fmu);
        end
        % Inspect for the connector list (ports by causality).
        connectors = '';
        try
          j = jsondecode(__nflow_fmi_inspect_json__(target));
          if isfield(j, 'variables')
            vars = j.variables;
            for v = 1:numel(vars)
              if iscell(vars)
                var = vars{v};
              else
                var = vars(v);
              end
              if strcmp(var.causality, 'input') || strcmp(var.causality, 'output')
                connectors = [connectors, ...
                  '        <ssd:Connector name="', esc(var.name), '" kind="', var.causality, '">', char(10), ...
                  '          <ssc:Real/>', char(10), ...
                  '        </ssd:Connector>', char(10)]; %#ok<AGROW>
              end
            end
          end
        catch
        end
        body = [body, ...
          '      <ssd:Component name="', esc(cname), '" source="resources/', esc(cname), '.fmu"', ...
          ' type="application/x-fmu-sharedlibrary" implementation="CoSimulation">', char(10), ...
          '        <ssd:Connectors>', char(10), connectors, '        </ssd:Connectors>', char(10), ...
          '      </ssd:Component>', char(10)]; %#ok<AGROW>
      end

      connXml = '';
      for i = 1:numel(connections)
        cn = connections(i);
        connXml = [connXml, ...
          '      <ssd:Connection startElement="', esc(char(cn.startElement)), ...
          '" startConnector="', esc(char(cn.startConnector)), ...
          '" endElement="', esc(char(cn.endElement)), ...
          '" endConnector="', esc(char(cn.endConnector)), '"/>', char(10)]; %#ok<AGROW>
      end

      % Connections that reference the parent system (an empty start/end element)
      % define the composition's own connectors: an empty startElement is a
      % system input named after startConnector, an empty endElement a system
      % output named after endConnector. Declare them so the SSP is self-describing.
      sysConn = struct('name', {}, 'kind', {});
      for i = 1:numel(connections)
        cn = connections(i);
        if isempty(char(cn.startElement)) && ~isempty(char(cn.startConnector))
          sysConn = NFlow.addConnector(sysConn, char(cn.startConnector), 'input');
        end
        if isempty(char(cn.endElement)) && ~isempty(char(cn.endConnector))
          sysConn = NFlow.addConnector(sysConn, char(cn.endConnector), 'output');
        end
      end
      sysConnXml = '';
      for i = 1:numel(sysConn)
        sysConnXml = [sysConnXml, ...
          '      <ssd:Connector name="', esc(sysConn(i).name), '" kind="', sysConn(i).kind, '">', char(10), ...
          '        <ssc:Real/>', char(10), ...
          '      </ssd:Connector>', char(10)]; %#ok<AGROW>
      end
      sysConnBlock = '';
      if ~isempty(sysConnXml)
        sysConnBlock = ['    <ssd:Connectors>', char(10), sysConnXml, '    </ssd:Connectors>', char(10)];
      end

      [~, sysName] = fileparts(sspFile);
      ssd = ['<?xml version="1.0" encoding="UTF-8"?>', char(10), ...
        '<ssd:SystemStructureDescription version="1.0" name="', esc(sysName), '"', ...
        ' xmlns:ssd="http://ssp-standard.org/SSP1/SystemStructureDescription"', ...
        ' xmlns:ssc="http://ssp-standard.org/SSP1/SystemStructureCommon">', char(10), ...
        '  <ssd:System name="', esc(sysName), '">', char(10), ...
        sysConnBlock, ...
        '    <ssd:Elements>', char(10), body, '    </ssd:Elements>', char(10), ...
        '    <ssd:Connections>', char(10), connXml, '    </ssd:Connections>', char(10), ...
        '  </ssd:System>', char(10), ...
        '</ssd:SystemStructureDescription>', char(10)];
      fid = fopen(fullfile(staging, 'SystemStructure.ssd'), 'wt');
      fwrite(fid, ssd);
      fclose(fid);

      if isfile(sspFile)
        delete(sspFile);
      end
      zip(sspFile, {fullfile(staging, 'SystemStructure.ssd'), resDir}, [staging, filesep]);
      sspPath = sspFile;
    end

    function sspPath = sspExportDiagram(nflowFile, sspFile)
      % NFlow.sspExportDiagram  Package a diagram of FMU blocks into an SSP.
      %   sspPath = NFlow.sspExportDiagram(nflowFile, sspFile)
      %
      %   The inverse of NFlow.sspImport: reads a .nflow model whose blocks are
      %   FMU blocks (each referencing a component FMU) and re-emits an SSP that
      %   references those same FMUs directly (no re-export). Each 'fmu' block
      %   becomes a Component, wires between FMU blocks become Connections
      %   (port indices mapped back to connector names by native inspection), and
      %   every 'toWorkspace' sink fed by an FMU output becomes a system output
      %   connector. SSP <-> nflow round-trips: sspImport then sspExportDiagram
      %   reproduces the composition's components and connections.
      narginchk(2, 2);
      nflowFile = char(nflowFile);
      sspFile = char(sspFile);
      if ~isfile(nflowFile)
        error('Nelson:nflow_engine:modelFileNotFound', 'The model file does not exist: %s', nflowFile);
      end
      model = jsondecode(fileread(nflowFile));
      getBlock = @(k) NFlow.cellOrArrayElement(model.blocks, k);
      nBlocks = numel(model.blocks);

      staging = tempname();
      mkdir(staging);
      resDir = fullfile(staging, 'resources');
      mkdir(resDir);
      esc = @(s) strrep(strrep(strrep(strrep(char(s), '&', '&amp;'), '<', '&lt;'), '>', '&gt;'), '"', '&quot;');

      % Index the FMU blocks: component name, ordered input/output connector
      % names (native inspection), and the To Workspace sinks (system outputs).
      compIndex = struct('id', {}, 'name', {}, 'inputs', {}, 'outputs', {});
      sinkVar = containers.Map('KeyType', 'char', 'ValueType', 'char');
      body = '';
      for k = 1:nBlocks
        blk = getBlock(k);
        btype = char(blk.type);
        if strcmp(btype, 'fmu')
          fmuPath = char(blk.params.path);
          if ~isfile(fmuPath)
            error('Nelson:nflow_engine:fmuNotFound', 'FMU block source not found: %s', fmuPath);
          end
          cname = regexprep(char(blk.id), '[^a-zA-Z0-9_]', '_');
          target = fullfile(resDir, [cname, '.fmu']);
          copyfile(fmuPath, target);
          [inNames, outNames, connectors] = NFlow.fmuConnectorList(target, esc);
          % Carry the block's parameter overrides back out as a .ssv bound to the
          % component, so a composition imported with parameters re-exports them
          % (SSV round-trip). Only structs with fields produce a binding.
          paramBinding = '';
          if isfield(blk, 'params') && isfield(blk.params, 'parameterValues') ...
              && isstruct(blk.params.parameterValues) ...
              && ~isempty(fieldnames(blk.params.parameterValues))
            ssvName = [cname, '.ssv'];
            NFlow.writeSsv(fullfile(resDir, ssvName), blk.params.parameterValues, cname);
            paramBinding = ['        <ssd:ParameterBindings>', char(10), ...
              '          <ssd:ParameterBinding source="resources/', esc(ssvName), '"/>', char(10), ...
              '        </ssd:ParameterBindings>', char(10)];
          end
          body = [body, ...
            '      <ssd:Component name="', esc(cname), '" source="resources/', esc(cname), '.fmu"', ...
            ' type="application/x-fmu-sharedlibrary" implementation="CoSimulation">', char(10), ...
            '        <ssd:Connectors>', char(10), connectors, '        </ssd:Connectors>', char(10), ...
            paramBinding, ...
            '      </ssd:Component>', char(10)]; %#ok<AGROW>
          compIndex(end + 1) = struct('id', char(blk.id), 'name', cname, ...
            'inputs', {inNames}, 'outputs', {outNames}); %#ok<AGROW>
        elseif strcmp(btype, 'toWorkspace')
          vn = 'out';
          if isfield(blk, 'params') && isfield(blk.params, 'VariableName')
            vn = char(blk.params.VariableName);
          end
          sinkVar(char(blk.id)) = vn;
        end
      end
      findComp = @(bid) find(strcmp({compIndex.id}, bid), 1);

      % Connections: FMU->FMU wires become Connections; FMU->To Workspace wires
      % become system outputs. Everything else is dropped (system inputs have no
      % driver, exactly as sspImport leaves them).
      connXml = '';
      sysConn = struct('name', {}, 'kind', {});
      for k = 1:numel(model.connections)
        cn = NFlow.cellOrArrayElement(model.connections, k);
        fromId = char(cn.from); toId = char(cn.to);
        si = findComp(fromId);
        if isempty(si)
          continue; % only FMU outputs are exported as sources
        end
        fromIdx = double(cn.fromIndex) + 1;
        if fromIdx < 1 || fromIdx > numel(compIndex(si).outputs)
          continue;
        end
        startConn = compIndex(si).outputs{fromIdx};
        di = findComp(toId);
        if ~isempty(di)
          toIdx = double(cn.toIndex) + 1;
          if toIdx < 1 || toIdx > numel(compIndex(di).inputs)
            continue;
          end
          connXml = [connXml, ...
            '      <ssd:Connection startElement="', esc(compIndex(si).name), ...
            '" startConnector="', esc(startConn), ...
            '" endElement="', esc(compIndex(di).name), ...
            '" endConnector="', esc(compIndex(di).inputs{toIdx}), '"/>', char(10)]; %#ok<AGROW>
        elseif isKey(sinkVar, toId)
          outName = regexprep(sinkVar(toId), '[^a-zA-Z0-9_]', '_');
          sysConn = NFlow.addConnector(sysConn, outName, 'output');
          connXml = [connXml, ...
            '      <ssd:Connection startElement="', esc(compIndex(si).name), ...
            '" startConnector="', esc(startConn), ...
            '" endElement="" endConnector="', esc(outName), '"/>', char(10)]; %#ok<AGROW>
        end
      end

      sysConnXml = '';
      for i = 1:numel(sysConn)
        sysConnXml = [sysConnXml, ...
          '      <ssd:Connector name="', esc(sysConn(i).name), '" kind="', sysConn(i).kind, '">', char(10), ...
          '        <ssc:Real/>', char(10), ...
          '      </ssd:Connector>', char(10)]; %#ok<AGROW>
      end
      sysConnBlock = '';
      if ~isempty(sysConnXml)
        sysConnBlock = ['    <ssd:Connectors>', char(10), sysConnXml, '    </ssd:Connectors>', char(10)];
      end

      [~, sysName] = fileparts(sspFile);
      ssd = ['<?xml version="1.0" encoding="UTF-8"?>', char(10), ...
        '<ssd:SystemStructureDescription version="1.0" name="', esc(sysName), '"', ...
        ' xmlns:ssd="http://ssp-standard.org/SSP1/SystemStructureDescription"', ...
        ' xmlns:ssc="http://ssp-standard.org/SSP1/SystemStructureCommon">', char(10), ...
        '  <ssd:System name="', esc(sysName), '">', char(10), ...
        sysConnBlock, ...
        '    <ssd:Elements>', char(10), body, '    </ssd:Elements>', char(10), ...
        '    <ssd:Connections>', char(10), connXml, '    </ssd:Connections>', char(10), ...
        '  </ssd:System>', char(10), ...
        '</ssd:SystemStructureDescription>', char(10)];
      fid = fopen(fullfile(staging, 'SystemStructure.ssd'), 'wt');
      fwrite(fid, ssd);
      fclose(fid);

      if isfile(sspFile)
        delete(sspFile);
      end
      zip(sspFile, {fullfile(staging, 'SystemStructure.ssd'), resDir}, [staging, filesep]);
      sspPath = sspFile;
    end

    function [inNames, outNames, connectors] = fmuConnectorList(fmuPath, esc)
      % FMUCONNECTORLIST  Ordered input/output connector names + <ssd:Connector>
      % XML for an FMU, via native inspection. Shared by the SSP exporters.
      inNames = {}; outNames = {}; connectors = '';
      j = jsondecode(__nflow_fmi_inspect_json__(char(fmuPath)));
      if ~isfield(j, 'variables')
        return;
      end
      vars = j.variables;
      for v = 1:numel(vars)
        if iscell(vars)
          var = vars{v};
        else
          var = vars(v);
        end
        if strcmp(var.causality, 'input') || strcmp(var.causality, 'output')
          if strcmp(var.causality, 'input')
            inNames{end + 1} = var.name; %#ok<AGROW>
          else
            outNames{end + 1} = var.name; %#ok<AGROW>
          end
          connectors = [connectors, ...
            '        <ssd:Connector name="', esc(var.name), '" kind="', var.causality, '">', char(10), ...
            '          <ssc:Real/>', char(10), ...
            '        </ssd:Connector>', char(10)]; %#ok<AGROW>
        end
      end
    end

    function el = cellOrArrayElement(container, k)
      % CELLORARRAYELEMENT  Element k of a jsondecode result that may be a cell
      % array (heterogeneous structs) or a struct array (homogeneous).
      if iscell(container)
        el = container{k};
      else
        el = container(k);
      end
    end

    function bindMap = componentBindings(ssdText)
      % COMPONENTBINDINGS  Component -> parameter bindings, from .ssd text.
      %   Returns a struct array with fields 'name', 'sources' (a cell of bound
      %   .ssv paths) and 'inlineSets' (a cell of ParameterSet text blobs written
      %   straight into the .ssd). Each artefact is attributed to the nearest
      %   Component element opening before it; those preceding every Component
      %   (system-level) are ignored. Robust to the ssd:/ssc: namespace prefixes.
      bindMap = struct('name', {}, 'sources', {}, 'inlineSets', {});
      [compNames, compAt] = regexp(ssdText, ...
        '<\w*:?Component\b[^>]*\bname="([^"]*)"', 'tokens', 'start');
      if isempty(compNames)
        return;
      end
      compAt = double(compAt);
      names = cellfun(@(t) t{1}, compNames, 'UniformOutput', false);
      bindMap = struct('name', names, 'sources', repmat({{}}, 1, numel(names)), ...
        'inlineSets', repmat({{}}, 1, numel(names)));
      % Referenced .ssv files.
      [bindSrc, bindAt] = regexp(ssdText, ...
        '<\w*:?ParameterBinding\b[^>]*\bsource="([^"]*)"', 'tokens', 'start');
      for b = 1:numel(bindSrc)
        owner = find(compAt < bindAt(b), 1, 'last');
        if ~isempty(owner)
          bindMap(owner).sources{end + 1} = bindSrc{b}{1};
        end
      end
      % Inline ParameterSet blocks (values embedded directly in the .ssd).
      [setTok, setAt] = regexp(ssdText, ...
        '<\w*:?ParameterSet\b[\s\S]*?</\w*:?ParameterSet>', 'match', 'start');
      for s = 1:numel(setTok)
        owner = find(compAt < setAt(s), 1, 'last');
        if ~isempty(owner)
          bindMap(owner).inlineSets{end + 1} = setTok{s};
        end
      end
    end

    function pv = readSsv(ssvPath)
      % READSSV  Parameter name -> value map from an SSV file.
      %   pv = NFlow.readSsv(ssvPath) parses a System Structure Parameter Values
      %   (.ssv) file and returns a struct mapping each parameter name to its
      %   value. See NFlow.readSsvText for the value conventions.
      pv = NFlow.readSsvText(fileread(ssvPath));
    end

    function pv = readSsvText(txt)
      % READSSVTEXT  Parameter name -> value map from ParameterSet XML text.
      %   Parses <ssv:Parameter> entries out of a ParameterSet blob (an .ssv body
      %   or a ParameterSet embedded inline in a .ssd). Real/Integer/Enumeration
      %   become doubles; Boolean becomes logical. Names are sanitized to valid
      %   field names. Text-based because this DOM offers no scoped element query
      %   to pair a Parameter with its typed value child.
      pv = struct();
      m = regexp(txt, ...
        ['<\w*:?Parameter\b[^>]*\bname="([^"]*)"[^>]*>[\s\S]*?', ...
         '<\w*:?(Real|Integer|Enumeration|Boolean)\b[^>]*\bvalue="([^"]*)"'], ...
        'tokens');
      for i = 1:numel(m)
        nm = m{i}{1};
        kind = m{i}{2};
        raw = m{i}{3};
        if isempty(nm)
          continue;
        end
        fld = regexprep(nm, '[^a-zA-Z0-9_]', '_');
        if strcmp(kind, 'Boolean')
          pv.(fld) = strcmp(raw, 'true') || strcmp(raw, '1');
        else
          pv.(fld) = str2double(raw);
        end
      end
    end

    function writeSsv(ssvPath, pv, setName)
      % WRITESSV  Write a parameter name -> value struct as an SSV file.
      %   NFlow.writeSsv(ssvPath, pv) writes a System Structure Parameter Values
      %   (.ssv) file: each field of pv becomes an <ssv:Parameter>. The inverse of
      %   NFlow.readSsv. logical -> Boolean, integer -> Integer, everything else
      %   -> Real. Round-trips through readSsv.
      if nargin < 3 || isempty(setName)
        setName = 'parameters';
      end
      esc = @(s) strrep(strrep(strrep(strrep(char(s), '&', '&amp;'), '<', '&lt;'), '>', '&gt;'), '"', '&quot;');
      f = fieldnames(pv);
      body = '';
      for i = 1:numel(f)
        v = pv.(f{i});
        if islogical(v)
          if v
            val = 'true';
          else
            val = 'false';
          end
          typed = ['<ssv:Boolean value="', val, '"/>'];
        elseif isinteger(v)
          typed = ['<ssv:Integer value="', sprintf('%d', v), '"/>'];
        else
          typed = ['<ssv:Real value="', sprintf('%.15g', double(v)), '"/>'];
        end
        body = [body, ...
          '    <ssv:Parameter name="', esc(f{i}), '">', typed, '</ssv:Parameter>', char(10)]; %#ok<AGROW>
      end
      ssv = ['<?xml version="1.0" encoding="UTF-8"?>', char(10), ...
        '<ssv:ParameterSet version="1.0" name="', esc(setName), '"', ...
        ' xmlns:ssv="http://ssp-standard.org/SSP1/SystemStructureParameterValues"', ...
        ' xmlns:ssc="http://ssp-standard.org/SSP1/SystemStructureCommon">', char(10), ...
        '  <ssv:Parameters>', char(10), body, '  </ssv:Parameters>', char(10), ...
        '</ssv:ParameterSet>', char(10)];
      fid = fopen(char(ssvPath), 'wt');
      fwrite(fid, ssv);
      fclose(fid);
    end

    function s = mergeStruct(s, t)
      % MERGESTRUCT  Copy every field of t into s (t wins on conflicts).
      f = fieldnames(t);
      for i = 1:numel(f)
        s.(f{i}) = t.(f{i});
      end
    end

    function c = addConnector(c, name, kind)
      % ADDCONNECTOR  Append {name, kind} to a connector struct array, unique by
      % name (the first kind seen wins).
      if isempty(name) || any(strcmp({c.name}, name))
        return;
      end
      c(end + 1) = struct('name', name, 'kind', kind);
    end

    function sc = systemConnectors(ssdText)
      % SYSTEMCONNECTORS  Parent-system connectors from .ssd text.
      %   Returns a struct array {name, kind}. A Connector is system-level when it
      %   opens before the first Component element (component connectors live
      %   inside their Component); text-based because this DOM cannot scope a
      %   query to the System element.
      sc = struct('name', {}, 'kind', {});
      [~, compAt] = regexp(ssdText, '<\w*:?Component\b', 'match', 'start');
      firstComp = Inf;
      if ~isempty(compAt)
        firstComp = double(compAt(1));
      end
      [ctok, cat] = regexp(ssdText, '<\w*:?Connector\b[^>]*>', 'match', 'start');
      for i = 1:numel(ctok)
        if double(cat(i)) >= firstComp
          continue;
        end
        nm = regexp(ctok{i}, '\bname="([^"]*)"', 'tokens', 'once');
        kd = regexp(ctok{i}, '\bkind="([^"]*)"', 'tokens', 'once');
        if ~isempty(nm) && ~isempty(kd)
          sc = NFlow.addConnector(sc, nm{1}, kd{1});
        end
      end
    end

    function ver = fmuFmiVersion(fmuPath)
      % FMUFMIVERSION  FMI version string declared by an FMU's modelDescription.
      %   ver = NFlow.fmuFmiVersion(fmuPath) reads the fmiVersion attribute
      %   from the FMU archive's modelDescription.xml (e.g. '2.0', '3.0').
      %   Returns '' when it cannot be determined. Used to report a precise
      %   diagnostic for components the FMI 3.0 runtime cannot load.
      ver = '';
      tmp = [tempdir(), filesep, 'nflow_fmiver_', ...
        regexprep(tempname('.'), '[^a-zA-Z0-9_]', '_')];
      try
        mkdir(tmp);
        unzip(fmuPath, tmp);
        md = fullfile(tmp, 'modelDescription.xml');
        if isfile(md)
          txt = fileread(md);
          tok = regexp(txt, 'fmiVersion\s*=\s*"([^"]*)"', 'tokens', 'once');
          if ~isempty(tok)
            ver = tok{1};
          end
        end
      catch
      end
      if isdir(tmp)
        rmdir(tmp, 's');
      end
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [A, B, C, D] = linmod(model, x0, u0)
  % linmod  Numerical linearization of an nflow model.
  %
  %   [A, B, C, D] = linmod(model)
  %   [A, B, C, D] = linmod(model, x0, u0)
  %
  %   model is a loaded system (name or handle) or the path to a .nflow file.
  %   x0 (length nx) and u0 (length nu) optionally set the operating point;
  %   absent, the post-INIT state and zero inputs are used.
  %
  %   Returns the continuous-time state-space linearization about the model's
  %   post-INIT operating point (external inputs held at zero), obtained by
  %   central-differencing the same global right-hand side the ode4 / CVODES
  %   solver assembles:
  %       A = d(xdot)/dx   (nx-by-nx)      B = d(xdot)/du   (nx-by-nu)
  %       C = dy/dx        (ny-by-nx)      D = dy/du        (ny-by-nu)
  %   where x is the packed continuous state, u the external-port Label Source
  %   inputs (isExternalPort), and y the Label Sink outputs. A linear model
  %   linearizes to itself. An input that should participate in B / D must be an
  %   external-port Label Source; internal goto/from routing does not count.
  %
  %   Both top-level (flat) models and continuous states nested inside
  %   subsystems are supported: a nested state's coupling to the external inputs
  %   (B) and to the outputs across the subsystem boundary (C) is captured.
  narginchk(1, 3);
  nargoutchk(0, 4);

  % Pass the model's raw JSON straight through: jsondecode/jsonencode would
  % homogenize heterogeneous (nested subsystem) block arrays and corrupt the
  % inner diagram, so operating-point vectors go as separate builtin arguments
  % and the engine injects any required scope sink itself.
  documentJson = prepare_model_json(linmod_model_json(model));
  if nargin >= 3 && ~isempty(u0)
    resultJson = __nflow_linearize__(documentJson, double(x0(:))', double(u0(:))');
  elseif nargin >= 2 && ~isempty(x0)
    resultJson = __nflow_linearize__(documentJson, double(x0(:))');
  else
    resultJson = __nflow_linearize__(documentJson);
  end
  r = jsondecode(resultJson);
  if ~isfield(r, 'status') || ~strcmp(r.status, 'done')
    reason = 'unknown error';
    if isfield(r, 'reason')
      reason = r.reason;
    end
    error('Nelson:nflow_engine:linmod', 'linmod failed: %s', reason);
  end

  nx = double(r.nx);
  ny = double(r.ny);
  nu = double(r.nu);
  A = linmod_reshape(r.A, nx, nx);
  B = linmod_reshape(r.B, nx, nu);
  C = linmod_reshape(r.C, ny, nx);
  D = linmod_reshape(r.D, ny, nu);
end
%=============================================================================
function M = linmod_reshape(flat, rows, cols)
  % Row-major flat vector -> rows-by-cols matrix.
  if rows * cols == 0
    M = zeros(rows, cols);
    return
  end
  M = reshape(flat(:), cols, rows).';
end
%=============================================================================
function documentJson = linmod_model_json(model)
  % A loaded model (handle or name) is snapshotted to a temp file; otherwise the
  % argument is treated as a .nflow file path.
  if isnumeric(model) && isscalar(model)
    documentJson = linmod_snapshot(model);
    return
  end
  if ~(ischar(model) || (isstring(model) && isscalar(model)))
    error('Nelson:nflow_engine:linmodArgs', 'model must be a name, a handle or a .nflow file path.');
  end
  name = char(model);
  if bdIsLoaded(name)
    documentJson = linmod_snapshot(name);
    return
  end
  filename = name;
  if ~isfile(filename)
    if ~endsWith(lower(filename), '.nflow')
      filename = [filename, '.nflow'];
    end
  end
  if ~isfile(filename)
    error('Nelson:nflow_engine:modelNotFound', ...
      'Model ''%s'' is not a loaded system nor an existing .nflow file.', name);
  end
  documentJson = fileread(filename);
end
%=============================================================================
function documentJson = linmod_snapshot(model)
  target = [tempname(), '.nflow'];
  cleanup = onCleanup(@() linmod_delete_snapshot(target));
  save_system(model, target);
  documentJson = fileread(target);
end
%=============================================================================
function linmod_delete_snapshot(target)
  if isfile(target)
    delete(target);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function documentJson = prepare_model_json(documentJson)
  documentJson = NFlow.internal.prepareModelJson(documentJson);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = sim(model, varargin)
  % sim  Run an nflow simulation of a model.
  %
  %   out = sim(model)
  %   out = sim(model, 'StopTime', T)
  %   out = sim(model, 'StopTime', T, 'SampleTime', dt)
  %
  %   model is a loaded system (name or handle) or the path to a .nflow file.
  %   'StopTime' and 'SampleTime' override the values stored in the model.
  %
  %   out is a structure holding the simulation results: one field per
  %   To Workspace block (its VariableName), plus 'tout' (the time vector).
  %   From Workspace blocks read their signal from the base workspace, and
  %   To Workspace blocks also write their result there, as during an
  %   interactive run.
  %
  %   If the model carries a top-level 'stopFcn' field (a text blob of Nelson
  %   commands), it runs in the base workspace once
  %   the run stops, with the result exposed as 'out'. It fires only from
  %   sim() (never on model load) and runs even when no output is requested,
  %   e.g. set stopFcn to 'NFlow.plotScopes(out)' to pop the scopes up.
  narginchk(1, inf);
  nargoutchk(0, 1);

  options = sim_parse_options(varargin);
  documentJson = sim_model_json(model);
  documentJson = prepare_model_json(documentJson);
  % Decoded only to read scalar defaults and to map To Workspace outputs; the
  % blocks/connections are NOT re-encoded from here. jsondecode homogenizes a
  % heterogeneous / nested-subsystem block array and collapses a subsystem's
  % inner diagram, so the model's raw JSON is passed straight to the engine and
  % only scalar run overrides (sample time, duration, solver, tolerances,
  % variables) are sent alongside as a small object the engine overlays.
  document = jsondecode(documentJson);

  overrides = struct();
  sampleTime = sim_field(document, 'sampleTime', 0.01);
  duration = sim_field(document, 'runtime', 10);
  if isfield(options, 'StopTime')
    duration = options.StopTime;
  end
  if isfield(options, 'SampleTime')
    sampleTime = options.SampleTime;
  end
  overrides.sampleTime = sampleTime;
  overrides.duration = duration;
  overrides.variables = sim_variables(document);

  % Forward the solver configuration stored in the model (a variable-step /
  % ode1 / ode4 name plus optional tolerances), overridable per call. Without
  % this sim() always ran the default fixed-step engine, ignoring the model's
  % Solver setting. Absent or 'discrete' keeps the fixed-step path.
  solver = sim_field(document, 'solver', '');
  if isfield(options, 'Solver')
    solver = options.Solver;
  end
  if (ischar(solver) || isstring(solver)) && ~isempty(char(solver)) ...
      && ~strcmp(char(solver), 'discrete')
    overrides.solver = char(solver);
    overrides = sim_forward_tol(overrides, document, options, 'relTol', 'RelTol');
    overrides = sim_forward_tol(overrides, document, options, 'absTol', 'AbsTol');
    overrides = sim_forward_tol(overrides, document, options, 'maxStep', 'MaxStep');
  end

  resultJson = __nflow_simulate__(documentJson, jsonencode(overrides));
  result = jsondecode(resultJson);
  if ~isfield(result, 'status') || ~strcmp(result.status, 'done')
    reason = 'unknown error';
    if isfield(result, 'reason')
      reason = result.reason;
    end
    error('Nelson:nflow_engine:simFailed', 'Simulation of ''%s'' failed: %s', ...
      sim_model_label(model, document), reason);
  end

  % A StopFcn callback (a text blob of Nelson commands stored in the model,
  % executed in the base workspace) runs once the results are ready, even when
  % the caller asked for no output, so the output must be built whenever a
  % callback is present.
  stopFcn = sim_field(document, 'stopFcn', '');
  hasStopFcn = (ischar(stopFcn) || (isstring(stopFcn) && isscalar(stopFcn))) ...
    && ~isempty(strtrim(char(stopFcn)));
  out = [];
  if nargout >= 1 || hasStopFcn
    out = NFlow.internal.buildSimOutput(result, document);
  end
  if nargout >= 1
    varargout{1} = out;
  end
  if hasStopFcn
    NFlow.internal.runStopFcn(char(stopFcn), out);
  end
end
%=============================================================================
function options = sim_parse_options(args)
  options = struct();
  if mod(numel(args), 2) ~= 0
    error('Nelson:nflow_engine:simArgs:simExpectsNameValuePairsAfter', 'sim expects name/value pairs after the model.');
  end
  for k = 1:2:numel(args)
    name = args{k};
    if ~(ischar(name) || (isstring(name) && isscalar(name)))
      error('Nelson:nflow_engine:simArgs:parameterNamesStrings', 'Parameter names must be strings.');
    end
    name = char(name);
    value = args{k + 1};
    switch name
      case {'StopTime', 'SampleTime', 'RelTol', 'AbsTol', 'MaxStep'}
        if (ischar(value) || isstring(value))
          value = str2double(char(value));
        end
        if ~(isnumeric(value) && isscalar(value) && isfinite(value))
          error('Nelson:nflow_engine:simArgs', '%s must be a finite numeric scalar.', name);
        end
        options.(name) = double(value);
      case 'Solver'
        if ~(ischar(value) || (isstring(value) && isscalar(value)))
          error('Nelson:nflow_engine:simArgs:solverAString', '''Solver'' must be a string.');
        end
        options.Solver = char(value);
      otherwise
        warning('Nelson:nflow_engine:simIgnoredParameter', ...
          'sim: parameter ''%s'' is not supported and is ignored.', name);
    end
  end
end
%=============================================================================
function documentJson = sim_model_json(model)
  % A loaded model (handle or name) is snapshotted to a temp file; otherwise
  % the argument is treated as a .nflow file path.
  if isnumeric(model) && isscalar(model)
    documentJson = sim_snapshot(model);
    return
  end
  if ~(ischar(model) || (isstring(model) && isscalar(model)))
    error('Nelson:nflow_engine:simArgs:modelANameAHandleA', 'model must be a name, a handle or a .nflow file path.');
  end
  name = char(model);
  if bdIsLoaded(name)
    documentJson = sim_snapshot(name);
    return
  end
  filename = name;
  if ~isfile(filename)
    if ~endsWith(lower(filename), '.nflow')
      filename = [filename, '.nflow'];
    end
  end
  if ~isfile(filename)
    error('Nelson:nflow_engine:modelNotFound', ...
      'Model ''%s'' is not a loaded system nor an existing .nflow file.', name);
  end
  documentJson = fileread(filename);
end
%=============================================================================
function documentJson = sim_snapshot(model)
  target = [tempname(), '.nflow'];
  cleanup = onCleanup(@() sim_delete_snapshot(target));
  save_system(model, target);
  documentJson = fileread(target);
end
%=============================================================================
function sim_delete_snapshot(target)
  if isfile(target)
    delete(target);
  end
end
%=============================================================================
function variables = sim_variables(document)
  % The on-disk 'variables' field is a text blob of 'name = value' lines; keep
  % only the numeric-scalar assignments. A sim-input object (struct) passes
  % through unchanged.
  variables = struct();
  if ~isfield(document, 'variables')
    return
  end
  raw = document.variables;
  if isstruct(raw)
    variables = raw;
    return
  end
  if ~(ischar(raw) || isstring(raw))
    return
  end
  text = char(raw);
  lines = strsplit(text, {sprintf('\n'), ';'});
  for k = 1:numel(lines)
    tokens = regexp(strtrim(lines{k}), '^([A-Za-z_]\w*)\s*=\s*(.+)$', 'tokens', 'once');
    if numel(tokens) == 2
      value = str2double(tokens{2});
      if ~isnan(value)
        variables.(tokens{1}) = value;
      end
    end
  end
end
%=============================================================================
function value = sim_field(s, name, defaultValue)
  if isfield(s, name)
    value = s.(name);
  else
    value = defaultValue;
  end
end
%=============================================================================
function request = sim_forward_tol(request, document, options, field, optName)
  v = [];
  if isfield(document, field) && isnumeric(document.(field))
    v = document.(field);
  end
  if isfield(options, optName)
    v = options.(optName);
  end
  if ~isempty(v) && isnumeric(v) && isscalar(v) && isfinite(v) && v > 0
    request.(field) = double(v);
  end
end
%=============================================================================
function label = sim_model_label(model, document)
  if isfield(document, 'name') && ~isempty(document.name)
    label = char(document.name);
  elseif ischar(model) || (isstring(model) && isscalar(model))
    label = char(model);
  else
    label = 'model';
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [x, u, y, dx] = trim(model, x0, u0)
  % trim  Find a steady-state (equilibrium) operating point of an nflow model.
  %
  %   [x, u, y, dx] = trim(model)
  %   [x, u, y, dx] = trim(model, x0, u0)
  %
  %   model is a loaded system (name or handle) or the path to a .nflow file.
  %   x0 (length nx) seeds the search; u0 (length nu) is the fixed input.
  %
  %   Solves f(x, u0) = 0 for the continuous state x by a Newton iteration on
  %   the state Jacobian A = d(xdot)/dx (from linmod), holding the inputs u = u0
  %   fixed. Returns the equilibrium state x, the inputs u, the outputs y at the
  %   solution, and dx = xdot there (its norm measures how close to equilibrium).
  narginchk(1, 3);
  nargoutchk(0, 4);

  % Pass the model's raw JSON straight through (jsondecode/jsonencode would
  % homogenize heterogeneous nested-subsystem block arrays and corrupt the inner
  % diagram); operating-point vectors go as separate builtin arguments and the
  % engine injects any required scope sink itself.
  documentJson = prepare_model_json(trim_model_json(model));

  % Probe the dimensions at the default operating point.
  r = trim_linearize(documentJson, [], []);
  nx = double(r.nx);
  nu = double(r.nu);

  if nargin >= 2 && ~isempty(x0)
    x = double(x0(:));
  else
    x = zeros(nx, 1);
  end
  if nargin >= 3 && ~isempty(u0)
    u = double(u0(:));
  else
    u = zeros(nu, 1);
  end

  tol = 1e-9;
  maxit = 50;
  dx = zeros(nx, 1);
  y = zeros(double(r.ny), 1);
  for it = 1:maxit
    r = trim_linearize(documentJson, x(:)', u(:)');
    dx = r.f0(:);
    y = r.y0(:);
    if nx == 0 || norm(dx) < tol
      break
    end
    A = reshape(r.A(:), nx, nx).';
    step = A \ dx;
    if any(~isfinite(step))
      error('Nelson:nflow_engine:trimSingularJacobian', ...
        'trim: singular state Jacobian; no isolated equilibrium for these inputs.');
    end
    x = x - step;
  end
  if nx > 0 && norm(dx) >= tol
    warning('Nelson:nflow_engine:trimNotConverged', ...
      sprintf('trim: did not converge (||xdot|| = %g after %d iterations).', ...
      norm(dx), maxit));
  end
end
%=============================================================================
function r = trim_linearize(documentJson, x, u)
  % Empty x / u leave the corresponding operating point at its default (post-INIT
  % state, zero inputs); the builtin skips empty arguments.
  resultJson = __nflow_linearize__(documentJson, x, u);
  r = jsondecode(resultJson);
  if ~isfield(r, 'status') || ~strcmp(r.status, 'done')
    reason = 'unknown error';
    if isfield(r, 'reason')
      reason = r.reason;
    end
    error('Nelson:nflow_engine:trim', 'trim failed: %s', reason);
  end
end
%=============================================================================
function documentJson = trim_model_json(model)
  if isnumeric(model) && isscalar(model)
    documentJson = trim_snapshot(model);
    return
  end
  if ~(ischar(model) || (isstring(model) && isscalar(model)))
    error('Nelson:nflow_engine:trimArgs', 'model must be a name, a handle or a .nflow file path.');
  end
  name = char(model);
  if bdIsLoaded(name)
    documentJson = trim_snapshot(name);
    return
  end
  filename = name;
  if ~isfile(filename)
    if ~endsWith(lower(filename), '.nflow')
      filename = [filename, '.nflow'];
    end
  end
  if ~isfile(filename)
    error('Nelson:nflow_engine:modelNotFound', ...
      'Model ''%s'' is not a loaded system nor an existing .nflow file.', name);
  end
  documentJson = fileread(filename);
end
%=============================================================================
function documentJson = trim_snapshot(model)
  target = [tempname(), '.nflow'];
  cleanup = onCleanup(@() trim_delete_snapshot(target));
  save_system(model, target);
  documentJson = fileread(target);
end
%=============================================================================
function trim_delete_snapshot(target)
  if isfile(target)
    delete(target);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function txt = nmm_gui_rpc(method, paramsJson)
  % JSON facade used by the package manager window (nmm_gui). Read-only:
  % every method wraps a nmm(...) query and returns a JSON text so the C++
  % transport stays a pure marshaller. Errors are reported in the payload
  % ({ok:false, error:...}) rather than thrown, so the window keeps working.
  params = struct();
  if nargin > 1 && ~isempty(paramsJson)
    try
      params = jsondecode(paramsJson);
    catch
      params = struct();
    end
  end
  try
    switch method
      case 'snapshot'
        out = snapshot(logicalParam(params, 'fresh'));
      case 'list'
        out = listInstalled();
      case 'search'
        out = searchRegistry(textParam(params, 'query'));
      case 'preview'
        out = withRegistryReuse(@() installPreview(textParam(params, 'name'), textParam(params, 'version')));
      case 'versions'
        out = withRegistryReuse(@() packageVersions(textParam(params, 'name')));
      case 'registry'
        out = registryStatus();
      case 'tree'
        out = withRegistryReuse(@() packageTree(textParam(params, 'name'), textParam(params, 'version'), logicalParam(params, 'installed')));
      case 'cache'
        out = cacheState();
      case 'cacheClear'
        nmm('cache', 'clear');
        out = cacheState();
      case 'cacheRemove'
        nmm('cache', 'remove', textParam(params, 'name'), textParam(params, 'version'));
        out = cacheState();
      case 'cacheVerify'
        out = cacheState();
        out.verify = nmm('cache', 'verify');
      case 'freeze'
        out = struct();
        out.manifest = freezeManifest();
      case 'doc'
        out = packageDoc(textParam(params, 'kind'), textParam(params, 'path'), textParam(params, 'repository'));
      case 'verifyInstalled'
        out = verifyInstalled(textParam(params, 'name'));
      otherwise
        error('Nelson:nmm_gui:unknownMethod', 'Unknown nmm_gui method: %s', method);
    end
    out.ok = true;
  catch e
    out = failure(e);
  end
  txt = jsonencode(out);
end
%=============================================================================
function value = textParam(params, name)
  value = '';
  if isstruct(params) && isfield(params, name)
    value = params.(name);
    if isstring(value)
      value = char(value);
    end
    if ~ischar(value)
      value = '';
    end
  end
end
%=============================================================================
function out = snapshot(fresh)
  % Everything the window shows on a refresh, with one registry download: the
  % status check fetches the registry, then the installed list and the search
  % reuse that verified copy (NELSON_NMM_REGISTRY_REUSE, see nmm_registry_fetch).
  % A user refresh (fresh) also skips the short-lived on-disk registry cache,
  % so it always downloads the current registry.
  % Each part reports its own failure, so a registry problem never hides the
  % installed packages.
  out = struct();
  if fresh
    out.registry = withEnv('NELSON_NMM_REGISTRY_CACHE_TTL', '0', @() partOf(@registryStatus));
  else
    out.registry = partOf(@registryStatus);
  end
  out.list = withRegistryReuse(@() partOf(@listInstalled));
  out.search = withRegistryReuse(@() partOf(@searchAll));
  out.arch = computer('arch');
end
%=============================================================================
function out = searchAll()
  out = searchRegistry('');
end
%=============================================================================
function out = withRegistryReuse(query)
  % Run a registry query on the copy fetched by the last refresh (see
  % nmm_registry_fetch): the detail panel then matches the list on screen and
  % a click does not download the registry again. Refresh fetches it fresh.
  out = withEnv('NELSON_NMM_REGISTRY_REUSE', '1', query);
end
%=============================================================================
function out = withEnv(name, value, query)
  % Run query with an environment variable set, restored afterwards.
  previous = getenv(name);
  setenv(name, value);
  try
    out = query();
  catch e
    setenv(name, previous);
    rethrow(e);
  end
  setenv(name, previous);
end
%=============================================================================
function out = partOf(query)
  try
    out = query();
    out.ok = true;
  catch e
    out = failure(e);
  end
end
%=============================================================================
function out = failure(e)
  % The identifier lets the window tell "no registry configured" apart from
  % a registry that exists but cannot be read.
  out = struct();
  out.ok = false;
  out.error = e.message;
  out.error_id = e.identifier;
end
%=============================================================================
function out = listInstalled()
  modules = nmm('list');
  items = {};
  if isstruct(modules)
    registered = registryEntries(modules);
    for name = fieldnames(modules)'
      data = modules.(name{1});
      item = struct();
      item.name = name{1};
      item.version = fieldOr(data, 'version', '');
      item.path = fieldOr(data, 'path', '');
      item.load = logical(fieldOr(data, 'load', false));
      item.active = logical(ismodule(name{1}));
      item.pinned = fieldOr(data, 'pinned_version', '');
      item.versions = installedVersions(data);
      item = mergeModuleJson(item, item.path);
      item = mergeDiskUsage(item);
      item = mergeRegistryState(item, registered);
      items{end + 1} = item;
    end
  end
  out = struct();
  out.installed = items;
end
%=============================================================================
function item = mergeModuleJson(item, modulePath)
  % modules.json only records path/version/load: pick up the descriptive
  % fields from the installed module.json so the Installed tab is informative.
  if ~ischar(modulePath) || isempty(modulePath)
    return
  end
  moduleJson = [modulePath, 'module.json'];
  if ~endsWith(modulePath, '/') && ~endsWith(modulePath, '\')
    moduleJson = [modulePath, '/module.json'];
  end
  if ~isfile(moduleJson)
    return
  end
  try
    info = jsondecode(moduleJson, '-file');
  catch
    return
  end
  for field = {'summary', 'description', 'keywords', 'platforms', 'nelson', 'homepage', 'license', 'dependencies', 'repository', 'issues', 'documentation'}
    if isfield(info, field{1}) && ~isfield(item, field{1})
      item.(field{1}) = info.(field{1});
    end
  end
end
%=============================================================================
function item = mergeDiskUsage(item)
  % Size on disk and install date (module.json time, else the folder's).
  item.bytes = 0;
  item.installed_at = '';
  if ~ischar(item.path) || isempty(item.path) || ~isdir(item.path)
    return
  end
  item.bytes = folderBytes(item.path);
  stamp = dir(fullfile(item.path, 'module.json'));
  if isempty(stamp)
    stamp = dir(item.path);
  end
  if ~isempty(stamp)
    item.installed_at = datestr(stamp(1).datenum, 'yyyy-mm-dd HH:MM');
  end
end
%=============================================================================
function b = folderBytes(folder)
  b = 0;
  entries = dir(folder);
  for k = 1:numel(entries)
    e = entries(k);
    if e.isdir
      if ~strcmp(e.name, '.') && ~strcmp(e.name, '..')
        b = b + folderBytes(fullfile(folder, e.name));
      end
    else
      b = b + e.bytes;
    end
  end
end
%=============================================================================
function packages = registryEntries(modules)
  % Every registry entry, yanked ones included, read once for the whole list:
  % each registry query downloads and verifies the registry again.
  packages = struct([]);
  if isempty(fieldnames(modules))
    return
  end
  try
    report = nmm('registry', 'list');
    packages = report.packages;
  catch
    packages = struct([]);
  end
end
%=============================================================================
function item = mergeRegistryState(item, packages)
  % Flag an installed version that the registry has since yanked (search no
  % longer lists it, so the window would not know otherwise).
  item.yanked = false;
  item.yank_reason = '';
  if isempty(item.version) || isempty(packages)
    return
  end
  match = strcmp({packages.name}, item.name) & strcmp({packages.version}, item.version);
  if ~any(match)
    return
  end
  info = packages(find(match, 1));
  if isfield(info, 'yanked') && ~isempty(info.yanked)
    value = info.yanked;
    if islogical(value) || isnumeric(value)
      item.yanked = logical(value(1));
    elseif ischar(value)
      item.yanked = any(strcmpi(value, {'true', '1', 'yes'}));
    end
  end
  if item.yanked && isfield(info, 'yank_reason') && ischar(info.yank_reason)
    item.yank_reason = info.yank_reason;
  end
end
%=============================================================================
function versions = installedVersions(data)
  versions = {};
  if isfield(data, 'versions') && ~isempty(data.versions)
    for k = 1:numel(data.versions)
      versions{end + 1} = fieldOr(data.versions(k), 'version', '');
    end
  elseif isfield(data, 'version')
    versions = {data.version};
  end
end
%=============================================================================
function out = searchRegistry(query)
  % The window only offers packages installable on this machine, so it opts in
  % to the platform filter: a binary package built for another architecture
  % (its "platforms" excludes computer('arch')) is not listed here, while the
  % core nmm('registry', 'search') still reports the whole registry.
  packages = nmm('registry', 'search', query, '-platform');
  out = struct();
  out.query = query;
  out.packages = packagesToCells(packages);
end
%=============================================================================
function out = packageVersions(name)
  out = struct();
  out.name = name;
  out.versions = nmm('registry', 'versions', name);
end
%=============================================================================
function out = registryStatus()
  out = nmm('registry', 'check');
end
%=============================================================================
function out = installPreview(name, version)
  % What an install or update of name (version) would do: the dry-run plan
  % (dependencies to install) and the registry entry of that version (package
  % type, license, optional size), shown before the command is queued.
  out = struct();
  if isempty(version)
    out.plan = nmm('install', name, '-dry-run');
    out.package = dropEmptyFields(nmm('registry', 'info', name));
  else
    out.plan = nmm('install', name, version, '-dry-run');
    out.package = dropEmptyFields(nmm('registry', 'info', name, version));
  end
end
%=============================================================================
function out = packageTree(name, version, installed)
  % Resolved dependency tree. An installed package uses its locked tree; a
  % registry package is resolved through an install dry-run plan.
  out = struct();
  if installed
    out.tree = nmm('tree', name);
  elseif isempty(version)
    out.tree = nmm('tree', nmm('install', name, '-dry-run'));
  else
    out.tree = nmm('tree', nmm('install', name, version, '-dry-run'));
  end
end
%=============================================================================
function out = cacheState()
  out = struct();
  out.dir = nmm('cache', 'dir');
  sz = nmm('cache', 'size');
  out.archives = sz.archives;
  out.bytes = sz.bytes;
  packages = nmm('cache', 'list');
  entries = {};
  for k = 1:numel(packages)
    e = struct();
    e.name = packages(k).name;
    e.version = packages(k).version;
    e.has_sha256 = logical(packages(k).has_sha256);
    e.bytes = fileBytes(packages(k).path);
    entries{end + 1} = e;
  end
  out.entries = entries;
end
%=============================================================================
function b = fileBytes(path)
  b = 0;
  d = dir(path);
  if ~isempty(d)
    b = d(1).bytes;
  end
end
%=============================================================================
function value = logicalParam(params, name)
  value = false;
  if isstruct(params) && isfield(params, name)
    v = params.(name);
    if islogical(v) || isnumeric(v)
      value = logical(v);
    elseif ischar(v)
      value = any(strcmpi(v, {'true', '1', 'yes'}));
    end
  end
end
%=============================================================================
function m = freezeManifest()
  m = '';
  modules = nmm('list');
  if ~isstruct(modules)
    return
  end
  names = sort(fieldnames(modules));
  lines = {};
  for k = 1:numel(names)
    ver = fieldOr(modules.(names{k}), 'version', '');
    lines{end + 1} = strtrim([names{k}, ' ', ver]);
  end
  m = strjoin(lines, char(10));
end
%=============================================================================
function out = packageDoc(kind, path, repository)
  % Readme or changelog of an installed package (its folder), else of the
  % repository of a registry package (raw file of a GitHub or GitLab project).
  out = struct();
  out.text = '';
  if ~isempty(path) && isdir(path)
    for name = docCandidates(kind)
      f = fullfile(path, name{1});
      if isfile(f)
        out.text = fileread(f);
        return
      end
    end
  end
  base = rawRepositoryBase(repository);
  if isempty(base)
    return
  end
  options = weboptions('Timeout', 10);
  candidates = docCandidates(kind);
  for name = candidates(1:2)
    try
      out.text = webread([base, name{1}], options);
      return
    catch
      % not published under this name: try the next one
    end
  end
end
%=============================================================================
function base = rawRepositoryBase(repository)
  % https://github.com/owner/repo(.git) -> raw.githubusercontent.com/owner/repo/HEAD/
  % https://gitlab.com/owner/repo(.git) -> gitlab.com/owner/repo/-/raw/HEAD/
  base = '';
  if ~ischar(repository) || isempty(repository)
    return
  end
  url = regexprep(strtrim(repository), '(\.git)?/?$', '');
  tokens = regexp(url, '^https://github\.com/([^/]+)/([^/]+)$', 'tokens', 'once');
  if ~isempty(tokens)
    base = ['https://raw.githubusercontent.com/', tokens{1}, '/', tokens{2}, '/HEAD/'];
    return
  end
  tokens = regexp(url, '^https://gitlab\.com/(.+)$', 'tokens', 'once');
  if ~isempty(tokens)
    base = ['https://gitlab.com/', tokens{1}, '/-/raw/HEAD/'];
  end
end
%=============================================================================
function names = docCandidates(kind)
  if strcmpi(kind, 'changelog')
    names = {'CHANGELOG.md', 'changelog.md', 'ChangeLog.md', 'CHANGES.md', 'changes.md', 'NEWS.md', 'CHANGELOG'};
  else
    names = {'README.md', 'readme.md', 'Readme.md', 'README.markdown', 'README.txt', 'readme.txt', 'README'};
  end
end
%=============================================================================
function out = verifyInstalled(name)
  out = struct();
  out.ok = true;
  out.issues = {};
  modules = nmm('list');
  if ~isstruct(modules) || ~isfield(modules, name)
    out.ok = false;
    out.issues = {'Module is not installed.'};
    return
  end
  data = modules.(name);
  path = fieldOr(data, 'path', '');
  ver = fieldOr(data, 'version', '');
  if isempty(path) || ~isdir(path)
    out.ok = false;
    out.issues = {'Installed path is missing.'};
    return
  end
  moduleJson = fullfile(path, 'module.json');
  if ~isfile(moduleJson)
    out.ok = false;
    out.issues = {'module.json is missing.'};
    return
  end
  try
    info = jsondecode(moduleJson, '-file');
  catch
    out.ok = false;
    out.issues = {'module.json is not readable.'};
    return
  end
  moduleVersion = docVersion(info);
  if ~isempty(moduleVersion) && ~isempty(ver) && ~strcmp(moduleVersion, ver)
    out.ok = false;
    out.issues{end + 1} = ['Version mismatch: installed ', ver, ', module.json ', moduleVersion, '.'];
  end
  dependencies = struct();
  if isfield(info, 'dependencies') && isstruct(info.dependencies)
    dependencies = info.dependencies;
  end
  for field = fieldnames(dependencies)'
    if ~isfield(modules, field{1})
      out.ok = false;
      out.issues{end + 1} = ['Dependency not installed: ', field{1}, '.'];
    end
  end
end
%=============================================================================
function v = docVersion(info)
  v = '';
  if isfield(info, 'version') && ischar(info.version)
    v = info.version;
  elseif isfield(info, 'module') && isstruct(info.module) && isfield(info.module, 'version') && ischar(info.module.version)
    v = info.module.version;
  end
end
%=============================================================================
function cells = packagesToCells(packages)
  % jsonencode of a struct array with identical fields is fine, but entries
  % read from a registry can carry heterogeneous fields: normalise to cells.
  % The registry normalisation fills a field an entry lacks with [], which
  % would reach the window as a (truthy) empty array: drop it instead.
  cells = {};
  for k = 1:numel(packages)
    cells{end + 1} = dropEmptyFields(packages(k));
  end
end
%=============================================================================
function s = dropEmptyFields(s)
  for field = fieldnames(s)'
    value = s.(field{1});
    if isa(value, 'double') && isempty(value)
      s = rmfield(s, field{1});
    end
  end
end
%=============================================================================
function value = fieldOr(data, name, fallback)
  value = fallback;
  if isstruct(data) && isfield(data, name)
    value = data.(name);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function nmm_progress_listener(action, name, version, step, index, total)
  % Receives nmm progress events (see modules_manager nmm_progress) and
  % forwards them to the package manager window as one JSON payload.
  % The functions directory can outlive the gateway (removegateway keeps the
  % path): only notify while the nmm_gui module is loaded.
  if ~ismodule('nmm_gui')
    return
  end
  event = struct();
  event.action = action;
  event.name = name;
  event.version = version;
  event.step = step;
  event.index = index;
  event.total = total;
  __nmm_gui_notify__('progress', jsonencode(event));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
builtinPath = modulepath('ode_solvers', 'builtin');
try
  removegateway(builtinPath);
catch
end
%=============================================================================
rmpath(modulepath('ode_solvers', 'functions'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
addpath(modulepath('ode_solvers', 'functions'), '-begin', '-frozen');
builtinPath = modulepath('ode_solvers', 'builtin');
try
  addgateway(builtinPath, 'ode_solvers');
  % Force the builtin library to load now so its variable-step CVODES backend
  % registers with the NFlow solver-backend registry at startup. The gateway DLL
  % is otherwise loaded lazily (on first ode builtin call), which would leave
  % NFlow's "variableStiff"/"variableNonstiff" solvers unavailable until then.
  __ode_sundials_available__();
catch
end
