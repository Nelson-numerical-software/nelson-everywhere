%=============================================================================
function Tout = rmprop(T, name)
  if nargin == 2 && isa(T, 'handle')
    if isstring(name)
      name = char(name);
    end
    Tout = __classdef_remove_dynamic_property__(T, name);
    return
  end
  narginchk(2, 2);
  mustBeA(T, 'table', 1);
  names = localCellstr(name);
  st = struct(T);
  if ~isfield(st.Properties, 'CustomProperties') || isempty(st.Properties.CustomProperties)
    error('Nelson:table:propertyNotFound', 'Custom property does not exist.');
  end
  for k = 1:length(names)
    if ~isfield(st.Properties.CustomProperties, names{k})
      error('Nelson:table:propertyNotFound', 'Custom property does not exist.');
    end
    st.Properties.CustomProperties = rmfield(st.Properties.CustomProperties, names{k});
  end
  if isfield(st, 'VariableCustomProperties')
    st.VariableCustomProperties = setdiff(st.VariableCustomProperties, names, 'stable');
  end
  Tout = table.fromStruct(st);
end
%=============================================================================
function names = localCellstr(names)
  if ischar(names)
    names = {names};
  elseif isstring(names)
    names = cellstr(names);
  end
  names = names(:)';
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function R = rowfun(fun, T, varargin)
  narginchk(2, Inf);
  mustBeA(T, 'table', 2);
  vars = 1:width(T);
  outputFormat = 'table';
  outputVariableNames = {'Fun'};
  st = struct(T);
  names = st.Properties.VariableNames;
  k = 1;
  while k <= length(varargin)
    option = char(varargin{k});
    switch lower(option)
      case 'inputvariables'
        vars = tableResolveVariables(names, varargin{k + 1}, st.Properties.VariableTypes, st.data);
      case 'outputformat'
        outputFormat = lower(char(varargin{k + 1}));
      case 'outputvariablenames'
        outputVariableNames = varargin{k + 1};
        if ischar(outputVariableNames)
          outputVariableNames = {outputVariableNames};
        elseif isstring(outputVariableNames)
          outputVariableNames = cellstr(outputVariableNames);
        end
      otherwise
        error('Nelson:table:unknownOption', 'Unknown option.');
    end
    k = k + 2;
  end
  values = cell(height(T), 1);
  for r = 1:height(T)
    args = cell(1, length(vars));
    for j = 1:length(vars)
      args{j} = tableColumnRows(T.(names{vars(j)}), r);
    end
    values{r} = fun(args{:});
  end
  switch outputFormat
    case 'table'
      try
        R = table(cell2mat(values), 'VariableNames', outputVariableNames(1));
      catch
        R = table(values, 'VariableNames', outputVariableNames(1));
      end
    case 'uniform'
      R = cell2mat(values);
    case 'cell'
      R = values;
    otherwise
      error('Nelson:table:unsupportedOutputFormat', 'Unsupported "%s" option.', 'OutputFormat');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function T2 = rows2vars(T, varargin)
  narginchk(1, Inf);
  mustBeA(T, 'table', 1);
  variableNamesSource = '';
  k = 1;
  while k <= length(varargin)
    option = char(varargin{k});
    switch lower(option)
      case 'variablenamessource'
        variableNamesSource = char(varargin{k + 1});
      otherwise
        error('Nelson:table:unknownOption', 'Unknown option.');
    end
    k = k + 2;
  end
  names = T.Properties.VariableNames;
  if isempty(variableNamesSource)
    newNames = cell(1, height(T));
    for r = 1:height(T)
      newNames{r} = ['Var', num2str(r)];
    end
  else
    source = T.(variableNamesSource);
    if isstring(source)
      newNames = cellstr(source);
    elseif iscellstr(source)
      newNames = source(:)';
    else
      error('Nelson:table:invalidType:variableNamesSourceContainText', 'VariableNamesSource must contain text.');
    end
  end
  data = cell(length(names), height(T) + 1);
  for j = 1:length(names)
    data{j, 1} = names{j};
    column = T.(names{j});
    for r = 1:height(T)
      value = tableColumnRows(column, r);
      if iscell(value)
        value = value{1};
      end
      data{j, r + 1} = value;
    end
  end
  T2 = cell2table(data, 'VariableNames', ['OriginalVariableNames', tableMakeUniqueNames(newNames)]);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function T = splitvars(T, vars, varargin)
  narginchk(1, Inf);
  mustBeA(T, 'table', 1);
  st = struct(T);
  names = st.Properties.VariableNames;
  if nargin < 2
    % Every variable with several columns or holding a table is split.
    idx = [];
    for k = 1:length(names)
      value = st.data.(names{k});
      if istable(value) || columnCount(value) > 1
        idx(end + 1) = k;
      end
    end
    newNames = cell(1, length(idx));
  else
    [idx, newNames] = resolveSplitVariables(names, vars, varargin);
  end
  if isempty(idx)
    return
  end
  isSplit = false(1, length(names));
  isSplit(idx) = true;
  taken = names(~isSplit);
  outNames = {};
  outData = struct();
  sourceIndex = [];
  for k = 1:length(names)
    if ~isSplit(k)
      pieceNames = names(k);
      pieces = {st.data.(names{k})};
    else
      [pieces, pieceNames] = splitValue(st.data.(names{k}), names{k}, taken);
      userNames = newNames{find(idx == k, 1)};
      if ~isempty(userNames)
        if length(userNames) ~= length(pieces)
          error('Nelson:table:dimagree:newVariableNamesMatchNumberAddedVariables', 'NewVariableNames must match the number of added variables.');
        end
        pieceNames = userNames;
      end
      taken = [taken, pieceNames];
    end
    for j = 1:length(pieces)
      if any(strcmp(outNames, pieceNames{j}))
        error('Nelson:table:duplicateVariableNames', 'Duplicate table variable name.');
      end
      outNames{end + 1} = pieceNames{j};
      outData.(pieceNames{j}) = pieces{j};
    end
    sourceIndex = [sourceIndex, k * ones(1, length(pieces))];
  end
  st.data = outData;
  st.Properties.VariableNames = outNames;
  st.Properties.VariableTypes = string([]);
  st.Properties.VariableUnits = replicateMetadata(st.Properties.VariableUnits, sourceIndex);
  st.Properties.VariableDescriptions = replicateMetadata(st.Properties.VariableDescriptions, sourceIndex);
  st.Properties.VariableContinuity = replicateMetadata(st.Properties.VariableContinuity, sourceIndex);
  T = table.fromStruct(st);
end
%=============================================================================
function [idx, newNames] = resolveSplitVariables(names, vars, options)
  if strcmp(class(vars), 'vartype')
    error('Nelson:table:splitvars:vartypeInvalidVars', 'A vartype subscripter cannot specify the variables to split.');
  end
  userNames = {};
  k = 1;
  while k <= length(options)
    if k == length(options)
      error('Nelson:table:nameValuePair:nameValueArgumentFollowedByA', 'Name-value argument must be followed by a value.');
    end
    switch lower(char(options{k}))
      case 'newvariablenames'
        userNames = options{k + 1};
      otherwise
        error('Nelson:table:unknownOption', 'Unknown option.');
    end
    k = k + 2;
  end
  if isempty(vars)
    idx = [];
  else
    idx = tableResolveVariables(names, vars);
  end
  idx = idx(:)';
  if length(unique(idx)) ~= length(idx)
    error('Nelson:table:splitvars:duplicateVars', 'List of variables to split must not specify any variable more than once.');
  end
  newNames = cell(1, length(idx));
  if ~isempty(userNames)
    if length(idx) == 1
      newNames{1} = namesAsCellstr(userNames);
    else
      if ~iscell(userNames) || length(userNames) ~= length(idx)
        error('Nelson:table:splitvars:incorrectNumVarnamesMultisplit', 'When splitting several variables, NewVariableNames must be a cell array with one cell of names per variable.');
      end
      for k = 1:length(idx)
        if ~iscell(userNames{k}) && ~isstring(userNames{k})
          error('Nelson:table:splitvars:incorrectNumVarnamesMultisplit', 'When splitting several variables, NewVariableNames must be a cell array with one cell of names per variable.');
        end
        newNames{k} = namesAsCellstr(userNames{k});
      end
    end
  end
  [idx, order] = sort(idx);
  newNames = newNames(order);
end
%=============================================================================
function [pieces, pieceNames] = splitValue(value, name, taken)
  if istable(value)
    pieceNames = value.Properties.VariableNames;
    pieces = cell(1, length(pieceNames));
    for j = 1:length(pieceNames)
      pieces{j} = value.(pieceNames{j});
      if any(strcmp(taken, pieceNames{j}))
        pieceNames{j} = [name, '_', pieceNames{j}];
      end
    end
    return
  end
  nbColumns = columnCount(value);
  if nbColumns == 1
    pieces = {value};
    pieceNames = {name};
    return
  end
  value = reshape(value, size(value, 1), nbColumns);
  pieces = cell(1, nbColumns);
  pieceNames = cell(1, nbColumns);
  for j = 1:nbColumns
    pieces{j} = value(:, j);
    pieceNames{j} = uniqueName([name, '_', num2str(j)], taken);
  end
end
%=============================================================================
function n = columnCount(value)
  % An N-D variable splits along all its trailing dimensions.
  sz = size(value);
  n = prod(sz(2:end));
end
%=============================================================================
function name = uniqueName(name, taken)
  if ~any(strcmp(taken, name))
    return
  end
  k = 1;
  while any(strcmp(taken, [name, '_', num2str(k)]))
    k = k + 1;
  end
  name = [name, '_', num2str(k)];
end
%=============================================================================
function names = namesAsCellstr(names)
  if ischar(names)
    names = {names};
  elseif isstring(names)
    names = cellstr(names);
  end
  if ~iscellstr(names)
    error('Nelson:table:invalidVariableNames', 'New variable names must be a character vector, string array, or cell array of character vectors.');
  end
  names = names(:)';
end
%=============================================================================
function value = replicateMetadata(value, sourceIndex)
  if ~isempty(value)
    value = value(sourceIndex);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
