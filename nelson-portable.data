% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
wav_file = [modulepath('audio', 'tests'), '/MacBoing.wav'];
[y_wav, fs_wav] = audioread(wav_file);
info_wav = audioinfo(wav_file);
asserts.isequal(size(y_wav), [7673 1]);
asserts.isequal(class(y_wav), 'double');
asserts.isequal(fs_wav, 11025);
asserts.isequal(info_wav.NumChannels, 1);
asserts.isequal(info_wav.SampleRate, 11025);
asserts.isequal(info_wav.TotalSamples, 7673);
%=============================================================================
[y_wav_native, fs_wav_native] = audioread(wav_file, 'native');
asserts.isequal(size(y_wav_native), [7673 1]);
asserts.isequal(class(y_wav_native), 'uint8');
asserts.isequal(fs_wav_native, fs_wav);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
filename = [tempname(), '.wav'];
fs_ref = 8000;
t = (0:99)' / fs_ref;
y = sin(2 * pi * 440 * t);
%=============================================================================
audiowrite(filename, y, fs_ref);
[z, fs] = audioread(filename);
info = audioinfo(filename);
%=============================================================================
asserts.isequal(fs, fs_ref);
asserts.isequal(info.SampleRate, fs_ref);
asserts.isequal(size(z), size(y));
asserts.isapprox(z, y, 1e-4);
%=============================================================================
rmfile(filename);
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
info = audiodevinfo();
if (~isfield(info, 'output') || isempty(info.output) || ~isfield(info.output, 'Name') ...
    || ~strcmp(info.output.Name, 'Web Audio'))
  skip_testsuite('Portable Web Audio device is not available.');
end
%=============================================================================
asserts.isequal(fieldnames(info), {'input'; 'output'});
asserts.istrue(isempty(info.input));
asserts.isequal(info.output.Name, 'Web Audio');
asserts.isequal(info.output.DriverVersion, 'Browser Web Audio');
asserts.isequal(info.output.MaxChannels, 2);
asserts.isequal(info.output.DefaultSampleRate, 44100);
asserts.isequal(info.output.ID, 0);
%=============================================================================
OUTPUT_DEVICE = 0;
INPUT_DEVICE = 1;
asserts.isequal(audiodevinfo(OUTPUT_DEVICE), 1);
asserts.isequal(audiodevinfo(INPUT_DEVICE), 0);
asserts.isequal(audiodevinfo(OUTPUT_DEVICE, 0), 'Web Audio');
asserts.isequal(audiodevinfo(OUTPUT_DEVICE, 'Web Audio'), 0);
asserts.isequal(audiodevinfo(OUTPUT_DEVICE, 0, 'DriverVersion'), 'Browser Web Audio');
asserts.isequal(audiodevinfo(OUTPUT_DEVICE, 44100, 16, 2), 0);
asserts.istrue(audiodevinfo(OUTPUT_DEVICE, 0, 44100, 16, 2));
asserts.isfalse(audiodevinfo(OUTPUT_DEVICE, 0, 44100, 16, 3));
asserts.isequal(audiodevinfo(INPUT_DEVICE, 44100, 16, 1), -1);
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
audioInfo = audiodevinfo();
if (~isfield(audioInfo, 'output') || isempty(audioInfo.output) ...
    || ~isfield(audioInfo.output, 'Name') || ~strcmp(audioInfo.output.Name, 'Web Audio'))
  skip_testsuite('Portable Web Audio device is not available.');
end
%=============================================================================
fs = 8000;
y = sin(2 * pi * 440 * (0:255)' / fs);
p = audioplayer(y, fs);
asserts.isequal(p.Running, 'off');
asserts.isequal(p.CurrentSample, 0);
asserts.isequal(p.TotalSamples, numel(y));
play(p);
asserts.isequal(p.Running, 'on');
asserts.istrue(p.CurrentSample >= 0);
pause(p);
asserts.isequal(p.Running, 'off');
resume(p);
asserts.isequal(p.Running, 'on');
stop(p);
asserts.isequal(p.Running, 'off');
asserts.isequal(p.CurrentSample, 0);
delete(p);
asserts.istrue(true);
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
audioInfo = audiodevinfo();
if (~isfield(audioInfo, 'output') || isempty(audioInfo.output) ...
    || ~isfield(audioInfo.output, 'Name') || ~strcmp(audioInfo.output.Name, 'Web Audio'))
  skip_testsuite('Portable Web Audio device is not available.');
end
%=============================================================================
y = [0; 0.5; -0.5; 1];
sound(y, 8000);
asserts.istrue(true);
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
audioInfo = audiodevinfo();
if (~isfield(audioInfo, 'output') || isempty(audioInfo.output) ...
    || ~isfield(audioInfo.output, 'Name') || ~strcmp(audioInfo.output.Name, 'Web Audio'))
  skip_testsuite('Portable Web Audio device is not available.');
end
%=============================================================================
y = [-1; 0; 1];
soundsc(y, 4000, 16, [-1 1]);
asserts.istrue(true);
%=============================================================================
% Generated portable test module boundary.
% Encode labels as categorical data and count each category.
labels = categorical({'low'; 'high'; 'medium'; 'low'; 'high'; 'low'});
disp('Categories:');
disp(categories(labels));
disp('Counts:');
disp(countcats(labels));
