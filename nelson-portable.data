%=============================================================================
function varargout = ylim(varargin)
  narginchk(0, 2);
  nargoutchk(0, 1);
  value = [];
  if nargin == 0
    ax = gca();
    varargout{1} = ax.YLim;
    return
  end
  if nargin == 1
    if isgraphics(varargin{1})
      ax = varargin{1};
      varargout{1} = ax.YLim;
      return
    else
      if ischar(varargin{1})
        if (strcmp(varargin{1}, 'mode'))
          res = ylim(gca(), varargin{1});
          varargout{1} = res;
          return;
        end
        if (strcmp(varargin{1}, 'method'))
          res = ylim(gca(), varargin{1});
          varargout{1} = res;
          return;
        end
        if (strcmp(varargin{1}, 'auto'))
          ylim(gca(), varargin{1});
          return;
        end
        if (strcmp(varargin{1}, 'manual'))
          ylim(gca(), varargin{1});
          return;
        end
        if (isLimitMethod(varargin{1}))
          ylim(gca(), varargin{1});
          return;
        end
        error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
      else
        ax = gca();
        value = varargin{1};
      end
    end
  else
    % nargin == 2
    ax = varargin{1};
    if ~isgraphics(ax, 'axes')
      error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
    end
    value = varargin{2};
  end
  if ischar(value)
    if (strcmp(value, 'mode'))
      res = ax.YLimMode;
      varargout{1} = res;
      return;
    end
    if (strcmp(value, 'method'))
      res = ax.YLimitMethod;
      varargout{1} = res;
      return;
    end
    if (strcmp(value, 'auto'))
      ax.YLimMode = 'auto';
      if nargout == 1
        error('Nelson:graphics:invalidOutputArgument', 'Invalid output argument.');
      end
      return;
    end
    if (strcmp(value, 'manual'))
      ax.YLimMode = 'manual';
      if nargout == 1
        error('Nelson:graphics:invalidOutputArgument', 'Invalid output argument.');
      end
      return;
    end
    if (isLimitMethod(value))
      ax.YLimitMethod = value;
      ax.YLimMode = 'auto';
      if nargout == 1
        error('Nelson:graphics:invalidOutputArgument', 'Invalid output argument.');
      end
      return;
    end
    error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
  else if (isnumeric(value) && numel(value) == 2)
      ax.YLim = value;
    else
      error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
    end
    if nargout == 1
      error('Nelson:graphics:invalidOutputArgument', 'Invalid output argument.');
    end
  end
end
%=============================================================================
function tf = isLimitMethod(value)
  tf = strcmp(value, 'tickaligned') || strcmp(value, 'tight') || strcmp(value, 'padded');
end
