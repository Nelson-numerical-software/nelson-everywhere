benchFile = [tempdir(), '/bench_portable_bench_run_smoke.m'];
if isfile(benchFile)
  rmfile(benchFile);
end

filewrite(benchFile, {'benchPortableValue = sum(1:8);', ...
  'asserts.isequal(benchPortableValue, 36);'});

output = evalc('status = bench_run({benchFile}, ''Workers'', 1);');
if ~status
  error('Nelson:portable:benchRunFailed', 'bench_run reported a failure.');
end
if ~contains(output, 'bench_portable_bench_run_smoke')
  error('Nelson:portable:benchRunMissing', ...
    'bench_run did not execute the portable smoke benchmark.');
end
suite = nelson.unittest.discover([], 'Kind', 'bench');
if length(suite.cases) == 0
  error('Nelson:portable:benchDiscoveryMissing', ...
    'Global benchmark discovery did not find packaged module benchmarks.');
end
interpreterBench = [modulepath('interpreter'), '/tests/bench_loop_00.m'];
if isfile(interpreterBench)
  interpreterOutput = evalc('status = bench_run(''interpreter'', ''Workers'', 1);');
  if ~status
    error('Nelson:portable:moduleBenchRunFailed', ...
      'bench_run(''interpreter'') reported a failure.');
  end
  if ~contains(interpreterOutput, 'bench_loop_00') || ...
      ~contains(interpreterOutput, 'bench_loop_19') || ...
      ~contains(interpreterOutput, 'bench_scalar_expression_loops')
    error('Nelson:portable:moduleBenchRunMissing', ...
      'bench_run(''interpreter'') did not execute packaged module benchmarks.');
  end
  specialFunctionsOutput = evalc('status = bench_run(''special_functions'', ''Workers'', 1);');
  if ~status
    error('Nelson:portable:moduleBenchRunFailed', ...
      'bench_run(''special_functions'') reported a failure.');
  end
  if ~contains(specialFunctionsOutput, 'bench_interp2')
    error('Nelson:portable:moduleBenchRunMissing', ...
      'bench_run(''special_functions'') did not execute packaged module benchmarks.');
  end
end
if isfile(benchFile)
  rmfile(benchFile);
end
disp('NELSON_PORTABLE_BENCH_RUN_OK');
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
a = inv([1 2; 3 4]);
if abs(a(1, 1) + 2) > 1e-12 || abs(a(2, 2) + 0.5) > 1e-12
  error('Nelson:portable:linearAlgebra', 'Linear algebra smoke test failed.');
end

if isbuiltin('figure')
  f = figure('Visible', 'off');
  surf(peaks(24));
  displayList = __web_display_list__(f);
  close(f);
  if length(displayList) < 100
    error('Nelson:portable:plot', 'Headless plot smoke test failed.');
  end
end

if isbuiltin('__nflow_simulate__')
  d = struct();
  d.blocks = {...
    struct('id', 'one', 'type', 'constant', 'inputs', 0, 'outputs', 1, ...
      'params', struct('Value', 1)), ...
    struct('id', 'sink', 'type', 'scope', 'inputs', 1, 'outputs', 0, ...
      'params', struct())};
  d.connections = {struct('from', 'one', 'to', 'sink', ...
    'fromIndex', 0, 'toIndex', 0)};
  d.sampleTime = 0.1;
  d.duration = 0.2;
  d.variables = struct();
  result = jsondecode(__nflow_simulate__(jsonencode(d)));
  if ~strcmp(result.status, 'done')
    error('Nelson:portable:nflow', 'NFlow smoke test failed.');
  end
end

disp('NELSON_PORTABLE_SMOKE_OK');
