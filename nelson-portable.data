%=============================================================================
function varargout = contour(varargin)
  % contour(ax, ...)
  % contour(Z)
  % contour(X, Y, Z)
  % contour(..., levels)
  % contour(..., LineSpec)
  % M = contour(...)
  % [M, c] = contour(...)
  [ax, contourProperties] = parseContourArguments(varargin, false);
  if isempty(ax)
    ax = graphicsParentProperty(contourProperties);
  end
  ax = newplotTarget(ax);
  nextPlot = ax.NextPlot;

  h = __contour__('Parent', ax, contourProperties{:});
  if (strcmp(ax.XLimMode, 'auto') && strcmp(ax.YLimMode, 'auto'))
    applyContourAxesState(ax, h);
  end
  if any(strcmp(nextPlot, {'replace', 'replaceall'}))
    ax.Box = 'on';
  end
  if nargout > 0
    varargout{1} = h.ContourMatrix;
  else
    varargout = {};
  end
  if nargout > 1
    varargout{2} = h;
  end
end
%=============================================================================
﻿%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = contour3(varargin)
  [M, h] = contour(varargin{:});
  h.Floating = 'on';

  if ~ishold
    ax = ancestor(h, 'axes');
    view(ax, 3);
    applyContour3Ticks(ax);
    grid(ax, 'on');
  end
  if nargout > 0
    varargout{1} = h.ContourMatrix;
  else
    varargout = {};
  end
  if nargout > 1
    varargout{2} = h;
  end
end
%=============================================================================
function applyContour3Ticks(ax)
  xLimits = ax.XLim;
  step = contour3TickStep(diff(xLimits));
  ax.XTick = contour3Ticks(xLimits, step);
  yLimits = ax.YLim;
  step = contour3TickStep(diff(yLimits));
  ax.YTick = contour3Ticks(yLimits, step);
end
%=============================================================================
function ticks = contour3Ticks(limits, step)
  first = ceil(limits(1) / step) * step;
  last = floor(limits(2) / step) * step;
  ticks = first:step:last;
  ticks(abs(ticks) < step * 1e-10) = 0;
end
%=============================================================================
function step = contour3TickStep(span)
  if span <= 2.5
    step = 0.5;
  else
    step = 2;
  end
end
%=============================================================================%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function M = contourc(varargin)
  inputArguments = convertStringToCharArgs(varargin);
  nbArguments = length(inputArguments);
  if nbArguments < 1
    error('Nelson:notEnoughInputs', 'Not enough input arguments.');
  end
  if nbArguments > 4
    error('Nelson:tooManyInputs', 'Too many input arguments.');
  end
  if (length(inputArguments{1}) == 1) && isgraphics(inputArguments{1}, 'axes')
    error('Nelson:contourc:axesInputIsNot', 'Axes input is not supported for contourc.');
  end

  X = [];
  Y = [];
  levels = [];
  if nbArguments == 1
    Z = inputArguments{1};
  elseif nbArguments == 2
    Z = inputArguments{1};
    levels = inputArguments{2};
  elseif nbArguments == 3
    X = inputArguments{1};
    Y = inputArguments{2};
    Z = inputArguments{3};
  else
    X = inputArguments{1};
    Y = inputArguments{2};
    Z = inputArguments{3};
    levels = inputArguments{4};
  end

  validateContourData(X, Y, Z);
  if ~isempty(levels)
    levels = normalizeContourLevels(Z, levels);
  end
  M = __contourc__(Z, X, Y, levels);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = contourf(varargin)
  % contourf(ax, ...)
  % contourf(Z)
  % contourf(X, Y, Z)
  % contourf(..., levels)
  % contourf(..., LineSpec)
  % contourf(..., Name, Value)
  % M = contourf(...)
  % [M, c] = contourf(...)
  [ax, contourProperties] = parseContourArguments(varargin, true);
  if isempty(ax)
    ax = graphicsParentProperty(contourProperties);
  end
  ax = newplotTarget(ax);
  nextPlot = ax.NextPlot;

  h = __contour__('Parent', ax, contourProperties{:});
  if (strcmp(ax.XLimMode, 'auto') && strcmp(ax.YLimMode, 'auto'))
    applyContourAxesState(ax, h);
  end
  if any(strcmp(nextPlot, {'replace', 'replaceall'}))
    ax.Box = 'on';
  end
  if nargout > 0
    varargout{1} = h.ContourMatrix;
  else
    varargout = {};
  end
  if nargout > 1
    varargout{2} = h;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = contourslice(varargin)
  narginchk(4, 1000);
  nargoutchk(0, 1);
  [parent, x, y, z, V, xs, ys, zs, levels, method] = parseContourSliceInputs(varargin);
  ax = graphicsAddTargetAxes(parent);
  if isempty(parent)
    parent = ax;
  end
  [xs, ys, zs] = expandAllSlices(x, y, z, xs, ys, zs);
  h = drawContourSlices(parent, x, y, z, V, xs, ys, zs, levels, method);
  applyContourColors(ax, h);
  applyContourAxesLimits(ax, h);
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [parent, x, y, z, V, xs, ys, zs, levels, method] = parseContourSliceInputs(args)
  args = convertStringToCharArgs(args);
  [parent, args] = graphicsParseParent(args);
  method = [];
  if ~isempty(args) && ischar(args{end})
    method = args{end};
    args = args(1:end - 1);
    validateInterpolationMethod(method);
  end
  dataArgs = args;
  levels = [];
  if numel(dataArgs) == 5 || numel(dataArgs) == 8
    levels = dataArgs{end};
    if ~isnumeric(levels)
      error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Contour levels');
    end
    dataArgs = dataArgs(1:end - 1);
  end
  [x, y, z, V, xs, ys, zs] = parseContourVolumeInputs(dataArgs);
  if isempty(method)
    if isAxisAlignedSlices(xs, ys, zs)
      method = 'nearest';
    else
      method = 'linear';
    end
  end
end
%=============================================================================
function [x, y, z, V, xs, ys, zs] = parseContourVolumeInputs(args)
  switch numel(args)
    case 4
      V = validateContourVolume(args{1});
      [x, y, z] = volumeGridVectors(V);
      xs = args{2};
      ys = args{3};
      zs = args{4};
    case 7
      V = validateContourVolume(args{4});
      [x, y, z] = volumeGridVectors(args{1}, args{2}, args{3}, V);
      xs = args{5};
      ys = args{6};
      zs = args{7};
    otherwise
      if numel(args) < 4
        error('Nelson:notEnoughInputs', 'Not enough input arguments.');
      end
      if numel(args) > 7
        error('Nelson:tooManyInputs', 'Too many input arguments.');
      end
      error('Nelson:wrongNumberOfInputs', 'Wrong number of input arguments.');
  end
  xs = numericSliceInput(xs);
  ys = numericSliceInput(ys);
  zs = numericSliceInput(zs);
end
%=============================================================================
function V = validateContourVolume(V)
  if ~isnumeric(V) || ndims(V) ~= 3
    error('Nelson:graphics:invalidVolumeData', 'Volume data must be a numeric 3-D array.');
  end
  V = double(V);
end
%=============================================================================
function values = numericSliceInput(values)
  if isempty(values)
    values = [];
    return
  end
  if ~isnumeric(values)
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Slice locations');
  end
  values = double(values);
  if isvector(values)
    values = values(:).';
  end
end
%=============================================================================
function validateInterpolationMethod(method)
  if ~any(strcmp(method, {'linear', 'nearest', 'cubic'}))
    error('Nelson:contourslice:invalidInterpolationMethod', 'Interpolation method must be ''linear'', ''nearest'', or ''cubic''.');
  end
end
%=============================================================================
function [xs, ys, zs] = expandAllSlices(x, y, z, xs, ys, zs)
  if isscalar(xs) && isnan(xs)
    xs = x;
  end
  if isscalar(ys) && isnan(ys)
    ys = y;
  end
  if isscalar(zs) && isnan(zs)
    zs = z;
  end
end
%=============================================================================
function h = drawContourSlices(parent, x, y, z, V, xs, ys, zs, levels, method)
  if ~isAxisAlignedSlices(xs, ys, zs)
    h = drawContourSurface(parent, x, y, z, V, xs, ys, zs, levels);
    return
  end
  h = gobjects(0, 1);
  for k = 1:numel(xs)
    [Xq, Yq, Zq] = xSliceGridLocal(x, y, z, xs(k));
    C = interp3(x, y, z, V, Xq, Yq, Zq, method, NaN);
    h = [h; contourPatches(parent, y, z, C, levels, @(a, b) deal(xs(k) + 0 * a, a, b))];
  end
  for k = 1:numel(ys)
    [Xq, Yq, Zq] = ySliceGridLocal(x, y, z, ys(k));
    C = interp3(x, y, z, V, Xq, Yq, Zq, method, NaN);
    h = [h; contourPatches(parent, x, z, C, levels, @(a, b) deal(a, ys(k) + 0 * a, b))];
  end
  for k = 1:numel(zs)
    [Xq, Yq, Zq] = zSliceGridLocal(x, y, z, zs(k));
    C = interp3(x, y, z, V, Xq, Yq, Zq, method, NaN);
    h = [h; contourPatches(parent, x, y, C, levels, @(a, b) deal(b, a, zs(k) + 0 * a))];
  end
end
%=============================================================================
function tf = isAxisAlignedSlices(xs, ys, zs)
  tf = min(size(xs)) <= 1 && min(size(ys)) <= 1 && min(size(zs)) <= 1;
end
%=============================================================================
function h = drawContourSurface(parent, x, y, z, V, xs, ys, zs, levels)
  C = interp3(x, y, z, V, xs, ys, zs, 'linear', NaN);
  if all(isnan(C(:)))
    h = gobjects(0, 1);
    return
  end
  if isempty(levels)
    M = contourc(C);
  else
    M = contourc(C, levels);
  end
  h = gobjects(0, 1);
  idx = 1;
  while idx < size(M, 2)
    level = M(1, idx);
    n = M(2, idx);
    pts = normalizeContourPoints(M(:, idx + 1:idx + n));
    if size(pts, 2) < 2
      idx = idx + n + 1;
      continue
    end
    xx = interp2(xs, pts(1, :), pts(2, :));
    yy = interp2(ys, pts(1, :), pts(2, :));
    zz = interp2(zs, pts(1, :), pts(2, :));
    cdata = level + zeros(size(xx));
    h(end + 1, 1) = patch(parent, 'XData', [xx(:); NaN], 'YData', [yy(:); NaN], ...
      'ZData', [zz(:); NaN], 'CData', [cdata(:); NaN], ...
      'FaceVertexCData', zeros(numel(xx) + 1, 3), 'FaceColor', 'none', ...
      'EdgeColor', 'flat', 'UserData', level, 'Tag', 'contourslice');
    idx = idx + n + 1;
  end
end
%=============================================================================
function h = contourPatches(parent, x, y, C, levels, mapper)
  if all(isnan(C(:)))
    h = gobjects(0, 1);
    return
  end
  if isempty(levels)
    M = contourc(x, y, C);
  else
    M = contourc(x, y, C, levels);
  end
  h = gobjects(0, 1);
  idx = 1;
  while idx < size(M, 2)
    level = M(1, idx);
    n = M(2, idx);
    pts = normalizeContourPoints(M(:, idx + 1:idx + n));
    if size(pts, 2) < 2
      idx = idx + n + 1;
      continue
    end
    [xx, yy, zz] = mapper(pts(1, :), pts(2, :));
    cdata = level + zeros(size(xx));
    xdata = [xx(:); NaN];
    ydata = [yy(:); NaN];
    zdata = [zz(:); NaN];
    cdata = [cdata(:); NaN];
    faceVertexCData = zeros(numel(xdata), 3);
    h(end + 1, 1) = patch(parent, 'XData', xdata, 'YData', ydata, 'ZData', zdata, ...
      'CData', cdata, 'FaceVertexCData', faceVertexCData, 'FaceColor', 'none', ...
      'EdgeColor', 'flat', 'UserData', level, 'Tag', 'contourslice');
    idx = idx + n + 1;
  end
end
%=============================================================================
function pts = normalizeContourPoints(pts)
  if isempty(pts)
    return
  end
  keep = [true, any(abs(diff(pts, 1, 2)) > 0, 1)];
  pts = pts(:, keep);
  if size(pts, 2) > 1
    pts = pts(:, end:-1:1);
  end
end
%=============================================================================
function applyContourColors(ax, h)
  if isempty(h)
    return
  end
  levels = zeros(numel(h), 1);
  for k = 1:numel(h)
    levels(k) = h(k).UserData;
  end
  finiteLevels = levels(isfinite(levels));
  if isempty(finiteLevels)
    return
  end
  limits = [min(finiteLevels), max(finiteLevels)];
  if limits(1) == limits(2)
    limits = limits + [-0.5, 0.5];
  end
  ax.CLim = limits;
  colors = colormap(ax);
  if isempty(colors)
    colors = jet(64);
  end
  for k = 1:numel(h)
    color = contourLevelColor(h(k).UserData, limits, colors);
    h(k).FaceVertexCData = repmat(color, length(h(k).XData), 1);
  end
end
%=============================================================================
function color = contourLevelColor(level, limits, colors)
  if ~isfinite(level)
    color = colors(1, :);
    return
  end
  nbColors = size(colors, 1);
  idx = 1 + round((level - limits(1)) / (limits(2) - limits(1)) * (nbColors - 1));
  idx = max(1, min(nbColors, idx));
  color = colors(idx, :);
end
%=============================================================================
function applyContourAxesLimits(ax, h)
  if isempty(h)
    return
  end
  [xb, yb, zb] = contourSliceDrawnExtent(h);
  step = contourSliceCommonStep(xb, yb, zb);
  xlim = snapLimitsToStep(xb, step);
  ylim = snapLimitsToStep(yb, step);
  zlim = snapLimitsToStep(zb, step);
  if ~isempty(xlim)
    ax.XLim = xlim;
  end
  if ~isempty(ylim)
    ax.YLim = ylim;
  end
  if ~isempty(zlim)
    ax.ZLim = zlim;
  end
  applyContourSliceTicks(ax, xlim, ylim, zlim, step);
end
%=============================================================================
function [xb, yb, zb] = contourSliceDrawnExtent(h)
  allx = [];
  ally = [];
  allz = [];
  for k = 1:numel(h)
    allx = [allx; h(k).XData(:)];
    ally = [ally; h(k).YData(:)];
    allz = [allz; h(k).ZData(:)];
  end
  xb = finiteBounds(allx);
  yb = finiteBounds(ally);
  zb = finiteBounds(allz);
end
%=============================================================================
function bounds = finiteBounds(values)
  values = values(isfinite(values));
  if isempty(values)
    bounds = [];
    return
  end
  bounds = [min(values), max(values)];
end
%=============================================================================
function step = contourSliceCommonStep(xb, yb, zb)
  spans = [];
  if ~isempty(xb)
    spans(end + 1) = xb(2) - xb(1);
  end
  if ~isempty(yb)
    spans(end + 1) = yb(2) - yb(1);
  end
  if ~isempty(zb)
    spans(end + 1) = zb(2) - zb(1);
  end
  maxSpan = max(spans);
  if isempty(maxSpan) || ~isfinite(maxSpan) || maxSpan <= 0
    step = contourSliceNiceStep(1);
    return
  end
  step = contourSliceNiceStep(maxSpan / 6);
end
%=============================================================================
function limits = snapLimitsToStep(bounds, step)
  if isempty(bounds)
    limits = [];
    return
  end
  limits = [floor(bounds(1) / step) * step, ceil(bounds(2) / step) * step];
  if limits(1) == limits(2)
    limits = limits + [-step, step];
  end
end
%=============================================================================
function applyContourSliceTicks(ax, xlim, ylim, zlim, step)
  if strcmp(ax.XTickMode, 'auto')
    ticks = contourSliceStepTicks(xlim, step);
    if ~isempty(ticks)
      ax.XTick = ticks;
    end
  end
  if strcmp(ax.YTickMode, 'auto')
    ticks = contourSliceStepTicks(ylim, step);
    if ~isempty(ticks)
      ax.YTick = ticks;
    end
  end
  if strcmp(ax.ZTickMode, 'auto')
    ticks = contourSliceStepTicks(zlim, step);
    if ~isempty(ticks)
      ax.ZTick = ticks;
    end
  end
end
%=============================================================================
function ticks = contourSliceStepTicks(limits, step)
  ticks = [];
  if numel(limits) < 2 || ~isfinite(step) || step <= 0
    return
  end
  first = ceil(limits(1) / step) * step;
  last = floor(limits(2) / step) * step;
  ticks = first:step:last;
  ticks(abs(ticks) < step * 1e-10) = 0;
end
%=============================================================================
function step = contourSliceNiceStep(value)
  if ~isfinite(value) || value <= 0
    step = 1;
    return
  end
  scale = 10 ^ floor(log10(value));
  normalized = value / scale;
  if normalized < sqrt(2)
    nice = 1;
  elseif normalized < sqrt(10)
    nice = 2;
  elseif normalized <= 5.8
    nice = 5;
  else
    nice = 10;
  end
  step = nice * scale;
end
%=============================================================================
function [Xq, Yq, Zq] = xSliceGridLocal(x, y, z, value)
  [Yq, Zq] = meshgrid(y, z);
  Xq = value * ones(size(Yq));
end
%=============================================================================
function [Xq, Yq, Zq] = ySliceGridLocal(x, y, z, value)
  [Xq, Zq] = meshgrid(x, z);
  Yq = value * ones(size(Xq));
end
%=============================================================================
function [Xq, Yq, Zq] = zSliceGridLocal(x, y, z, value)
  [Xq, Yq] = meshgrid(x, y);
  Zq = value * ones(size(Xq));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = cylinder(varargin)
  narginchk(0, 3);
  nargoutchk(0, 3);

  if (nargin == 3)
    cax = varargin{1};
    args = {varargin{1}, varargin{2}};
    nargs = 2;
  elseif (nargin == 2)
    if isgraphics(varargin{1})
      cax = varargin{1};
      args = {varargin{2}};
      nargs = 1;
    else
      cax = [];
      args = {varargin{1}, varargin{2}};
      nargs = 2;
    end
  elseif (nargin == 1)
    if isgraphics(varargin{1})
      cax = varargin{1};
      args = {};
      nargs = 0;
    else
      cax = [];
      args = {varargin{1}};
      nargs = 1;
    end
  else
    cax = [];
    args = {};
    nargs = 0;
  end
  n = 20;
  r = [1 1]';
  if (nargs > 0)
    r = args{1};
  end
  if (nargs > 1)
    n = args{2};
  end
  r = r(:);
  m = length(r);
  if (m == 1)
    r = [r; r];
    m = 2;
  end
  theta = (0:n) / n * 2 * pi;
  sintheta = sin(theta);
  sintheta(n + 1) = 0;
  x = r * cos(theta);
  y = r * sintheta;
  z = (0:m - 1)' / (m - 1) * ones(1, n + 1);

  if (nargout == 0)
    cax = newplot(cax);
    surf(x, y, z, 'Parent', cax);
  else
    varargout{1} = x;
    varargout{2} = y;
    varargout{3} = z;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = daspect(varargin)
  narginchk(0, 2);
  nargoutchk(0, 1);

  % Handle zero input: return current axes DataAspectRatio
  if nargin == 0
    currentAxes = gca();
    varargout{1} = currentAxes.DataAspectRatio;
    return
  end

  % Parse first argument
  firstArg = varargin{1};
  firstArg = convertStringsToChars(firstArg);

  % Parse second argument if present
  if nargin > 1
    secondArg = varargin{2};
    secondArg = convertStringsToChars(secondArg);
  end

  % Determine axes and value to set/query
  if length(firstArg) == 1 && isgraphics(firstArg, 'axes')
    axesHandle = firstArg;
    if nargin == 2
      aspectValue = secondArg;
    else
      varargout{1} = axesHandle.DataAspectRatio;
      return
    end
  else
    axesHandle = gca();
    aspectValue = firstArg;
  end

  % Handle string value: mode query/set
  if ischar(aspectValue)
    if strcmp(aspectValue, 'mode')
      varargout{1} = axesHandle.DataAspectRatioMode;
    else
      axesHandle.DataAspectRatioMode = aspectValue;
    end
    return
  end

  % Otherwise, set DataAspectRatio
  axesHandle.DataAspectRatio = aspectValue;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function datetick(varargin)
  narginchk(0, 6);
  nargoutchk(0, 0);
  args = convertStringToCharArgs(varargin);
  [ax, args] = parseAxis(args);
  tickAxis = 'x';
  dateFormat = [];
  keepLimits = false;
  keepTicks = false;
  for k = 1:numel(args)
    arg = args{k};
    if ischar(arg) && any(strcmpi(arg, {'x', 'y', 'z'}))
      tickAxis = lower(arg);
    elseif ischar(arg) && strcmpi(arg, 'keeplimits')
      keepLimits = true;
    elseif ischar(arg) && strcmpi(arg, 'keepticks')
      keepTicks = true;
    elseif (ischar(arg) && ~isempty(arg)) || (isnumeric(arg) && isscalar(arg))
      dateFormat = arg;
    else
      error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
    end
  end
  upperAxis = upper(tickAxis);
  limProperty = [upperAxis, 'Lim'];
  tickProperty = [upperAxis, 'Tick'];
  labelProperty = [upperAxis, 'TickLabel'];
  limits = get(ax, limProperty);
  ticks = get(ax, tickProperty);
  if ~keepTicks
    ticks = ticks(ticks >= limits(1) & ticks <= limits(2));
    if numel(ticks) < 2
      ticks = linspace(limits(1), limits(2), 6);
    end
  end
  ticks = ticks(:)';
  if isempty(ticks)
    return
  end
  if isempty(dateFormat)
    dateFormat = defaultDateFormat(max(ticks) - min(ticks));
  end
  labels = datestr(ticks(:), dateFormat);
  set(ax, tickProperty, ticks);
  set(ax, labelProperty, cellstr(labels));
  if keepLimits
    set(ax, limProperty, limits);
  end
end
%=============================================================================
function [ax, args] = parseAxis(args)
  if ~isempty(args) && isscalar(args{1}) && isgraphics(args{1}, 'axes')
    ax = args{1};
    args = args(2:end);
  else
    ax = gca();
  end
end
%=============================================================================
function fmt = defaultDateFormat(spanDays)
  if spanDays >= 730
    fmt = 'yyyy';
  elseif spanDays >= 62
    fmt = 'mmm-yy';
  elseif spanDays >= 2
    fmt = 'mm/dd';
  elseif spanDays >= 1 / 24
    fmt = 'HH:MM';
  else
    fmt = 'HH:MM:SS';
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = donutchart(varargin)
  nargoutchk(0, 1);
  narginchk(1, 1000);
  args = parseChartArguments(varargin, 'donutchart');
  h = __donutchart__(args{:});
  if nargout > 0
    varargout{1} = h;
  else
    varargout = {};
  end
end
%=============================================================================
function args = parseChartArguments(inputArguments, chartName)
  inputArguments = convertStringToCharArgs(inputArguments);
  args = {};
  if isscalar(inputArguments{1}) && isgraphics(inputArguments{1}, 'figure')
    args = {'Parent', inputArguments{1}};
    inputArguments(1) = [];
  end
  if isempty(inputArguments)
    error('Nelson:graphics:dataExpected', 'Data expected.');
  end
  if isChartPropertyName(inputArguments{1})
    data = [];
  elseif length(inputArguments) >= 2 && isnumeric(inputArguments{1}) && isNameVector(inputArguments{2}) && ~isChartPropertyName(inputArguments{2})
    args = [args, {'Data', inputArguments{1}, 'Names', inputArguments{2}}];
    inputArguments(1:2) = [];
  else
    args = [args, {'Data', inputArguments{1}}];
    inputArguments(1) = [];
  end
  if mod(length(inputArguments), 2) ~= 0
    error('Nelson:graphics:nameValuePair', 'Name-value arguments must be paired.');
  end
  k = 1;
  while k <= length(inputArguments)
    if ~isChartPropertyName(inputArguments{k})
      error('Nelson:donutchart:unknownProperty', '%s: Unrecognized property.', chartName);
    end
    args{end + 1} = canonicalChartPropertyName(inputArguments{k});
    args{end + 1} = inputArguments{k + 1};
    k = k + 2;
  end
end
%=============================================================================
function tf = isNameVector(value)
  tf = ischar(value) || isstring(value) || iscell(value);
end
%=============================================================================
function tf = isChartPropertyName(value)
  if ~(ischar(value) || isStringScalar(value))
    tf = false;
    return
  end
  tf = any(strcmpi(convertStringsToChars(value), chartPropertyNames()));
end
%=============================================================================
function name = canonicalChartPropertyName(value)
  value = convertStringsToChars(value);
  names = chartPropertyNames();
  idx = find(strcmpi(value, names), 1);
  name = names{idx};
end
%=============================================================================
function names = chartPropertyNames()
  names = {'Parent', 'InnerRadius', 'CenterLabel', 'CenterLabelFontSize', ...
    'CenterLabelFontSizeMode', 'Data', 'Names', 'DataVariable', 'NamesVariable', ...
    'Labels', 'LabelStyle', 'StartAngle', 'Direction', 'ExplodedWedges', ...
    'ColorOrder', 'FaceColor', 'EdgeColor', 'FaceAlpha', 'LineWidth', 'FontSize', ...
    'FontName', 'FontColor', 'Interpreter', 'LegendVisible', 'LegendTitle', 'Title', ...
    'DisplayOrder', 'NumDisplayWedges', 'ShowOthers', 'DataMode', 'FontSizeMode', ...
    'LabelsMode', 'LabelStyleMode', 'NamesMode', 'Visible', 'HandleVisibility', ...
    'Units', 'OuterPosition', 'InnerPosition', 'Position', 'PositionConstraint', ...
    'Layout', 'SourceTable'};
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = errorbar(varargin)
  narginchk(2, 1000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [parent, args] = parseParent(args);
  [dataArgs, lineProperties, objectProperties, orientation] = parseTrailingArguments(args);
  series = parseDataArguments(dataArgs, orientation);
  target = prepareParent(parent);
  ax = errorbarAxes(target);
  nextPlot = '';
  if ~isempty(ax) && isscalar(ax) && isgraphics(ax, 'axes')
    nextPlot = ax.NextPlot;
  end
  h = gobjects(1, numel(series));
  for k = 1:numel(series)
    color = getColorAndUpdateIndex(ax);
    lineStyle = getLineStyleAndUpdateIndex(ax);
    constructorArgs = {'Parent', target, 'Color', color, 'LineStyle', lineStyle, ...
      'XDataMode', series(k).XDataMode, 'XData', series(k).XData, 'YData', series(k).YData, ...
      'YNegativeDelta', series(k).YNegativeDelta, 'YPositiveDelta', series(k).YPositiveDelta, ...
      'XNegativeDelta', series(k).XNegativeDelta, 'XPositiveDelta', series(k).XPositiveDelta};
    constructorArgs = [constructorArgs, lineProperties, objectProperties];
    h(k) = __errorbar__(constructorArgs{:});
  end
  if ~isempty(ax) && any(strcmp(nextPlot, {'replace', 'replaceall'}))
    ax.Box = 'on';
  end
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [parent, args] = parseParent(args)
  if ~isempty(args) && isscalar(args{1}) && (isgraphics(args{1}, 'axes') || isgraphics(args{1}, 'hggroup'))
    parent = args{1}(1);
    args = args(2:end);
  else
    [parent, args] = graphicsExtractParentProperty(args);
  end
end
%=============================================================================
function target = prepareParent(parent)
  if isempty(parent)
    target = newplot();
  elseif isgraphics(parent, 'axes')
    target = newplot(parent);
  elseif isgraphics(parent, 'hggroup')
    target = parent;
  else
    error('Nelson:graphics:invalidParent', 'Parent must be an axes or hggroup object.');
  end
end
%=============================================================================
function [dataArgs, lineProperties, objectProperties, orientation] = parseTrailingArguments(args)
  firstText = find(cellfun(@isTextArgument, args), 1);
  if isempty(firstText)
    dataArgs = args;
  else
    dataArgs = args(1:firstText - 1);
  end
  lineProperties = {};
  objectProperties = {};
  orientation = '';
  if isempty(firstText)
    return
  end
  tail = args(firstText:end);
  while ~isempty(tail) && isTextArgument(tail{1}) && ~isErrorBarPropertyName(tail{1})
    text = char(tail{1});
    matchedOrientation = matchOrientation(text);
    if ~isempty(matchedOrientation)
      if ~isempty(orientation)
        error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
      end
      orientation = matchedOrientation;
    else
      if ~isempty(lineProperties)
        error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
      end
      try
        lineProperties = lineSpecProperties(text);
      catch
        if numel(tail) >= 2
          break
        end
        error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
      end
    end
    tail = tail(2:end);
  end
  objectProperties = tail;
  if mod(numel(objectProperties), 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
end
%=============================================================================
function tf = isTextArgument(value)
  tf = ischar(value) || isStringScalar(value);
end
%=============================================================================
function properties = lineSpecProperties(spec)
  [lineStyle, color, marker, msg] = colstyle(spec, 'plot', false);
  if ~isempty(msg)
    error('Nelson:errorbar:invalidLineSpec', msg);
  end
  properties = {};
  if isempty(lineStyle) && ~isempty(marker)
    lineStyle = 'none';
  end
  if ~isempty(lineStyle)
    properties = [properties, {'LineStyle', lineStyle}];
  end
  if ~isempty(color)
    properties = [properties, {'Color', color}];
  end
  if ~isempty(marker)
    properties = [properties, {'Marker', marker}];
  end
end
%=============================================================================
function orientation = matchOrientation(value)
  valid = {'horizontal', 'vertical', 'both'};
  orientation = '';
  for k = 1:numel(valid)
    if strncmpi(value, valid{k}, max(3, numel(value)))
      orientation = valid{k};
      return
    end
  end
end
%=============================================================================
function series = parseDataArguments(args, orientation)
  if isempty(orientation)
    orientation = 'vertical';
  end
  if numel(args) == 2
    y = numericData(args{1}, 'YData');
    x = [];
    e = numericData(args{2}, 'YDelta');
    [xneg, xpos, yneg, ypos] = orientSymmetricDeltas(e, orientation);
    xMode = 'auto';
  elseif numel(args) == 3
    x = numericData(args{1}, 'XData');
    y = numericData(args{2}, 'YData');
    e = numericData(args{3}, 'YDelta');
    [xneg, xpos, yneg, ypos] = orientSymmetricDeltas(e, orientation);
    xMode = xDataMode(x);
  elseif numel(args) == 4
    x = numericData(args{1}, 'XData');
    y = numericData(args{2}, 'YData');
    neg = numericData(args{3}, 'NegativeDelta');
    pos = numericData(args{4}, 'PositiveDelta');
    [xneg, xpos, yneg, ypos] = orientAsymmetricDeltas(neg, pos, orientation);
    xMode = xDataMode(x);
  elseif numel(args) == 6
    if ~strcmp(orientation, 'vertical')
      error('Nelson:errorbar:invalidUseOfOrientation', 'Invalid use of orientation with six data inputs.');
    end
    x = numericData(args{1}, 'XData');
    y = numericData(args{2}, 'YData');
    yneg = numericData(args{3}, 'YNegativeDelta');
    ypos = numericData(args{4}, 'YPositiveDelta');
    xneg = numericData(args{5}, 'XNegativeDelta');
    xpos = numericData(args{6}, 'XPositiveDelta');
    xMode = xDataMode(x);
  else
    error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
  end
  series = buildErrorBarSeries(x, y, yneg, ypos, xneg, xpos, xMode);
end
%=============================================================================
function mode = xDataMode(x)
  if isempty(x)
    mode = 'auto';
  else
    mode = 'manual';
  end
end
%=============================================================================
function [xneg, xpos, yneg, ypos] = orientSymmetricDeltas(delta, orientation)
  [xneg, xpos, yneg, ypos] = orientAsymmetricDeltas(delta, delta, orientation);
end
%=============================================================================
function [xneg, xpos, yneg, ypos] = orientAsymmetricDeltas(neg, pos, orientation)
  xneg = [];
  xpos = [];
  yneg = [];
  ypos = [];
  switch orientation
    case 'horizontal'
      xneg = neg;
      xpos = pos;
    case 'both'
      xneg = neg;
      xpos = pos;
      yneg = neg;
      ypos = pos;
    otherwise
      yneg = neg;
      ypos = pos;
  end
end
%=============================================================================
function data = numericData(value, name)
  if isempty(value)
    data = [];
    return
  end
  if ~isnumeric(value) || ~isreal(value)
    error('Nelson:errorbar:mustBeRealNumeric', '%s must be real numeric data.', name);
  end
  data = double(value);
end
%=============================================================================
function series = buildErrorBarSeries(x, y, yneg, ypos, xneg, xpos, xMode)
  if shouldSplitVectorByElement(x, y, yneg, ypos, xneg, xpos)
    series = buildPointSeries(x, y, yneg, ypos, xneg, xpos, xMode);
    return
  end
  yColumns = dataColumns(y, 'YData');
  count = numel(yColumns);
  xColumns = xColumnsForSeries(x, yColumns, count, xMode);
  for k = 1:count
    if numel(xColumns{k}) ~= numel(yColumns{k})
      error('Nelson:dimagree:valueValueNumberElements', '%s and %s must have the same number of elements.', 'XData', 'YData');
    end
  end
  ynegColumns = deltaColumnsForSeries(yneg, yColumns, count, 'YNegativeDelta');
  yposColumns = deltaColumnsForSeries(ypos, yColumns, count, 'YPositiveDelta');
  xnegColumns = deltaColumnsForSeries(xneg, yColumns, count, 'XNegativeDelta');
  xposColumns = deltaColumnsForSeries(xpos, yColumns, count, 'XPositiveDelta');
  series = repmat(emptySeries(), 1, count);
  for k = 1:count
    series(k).XDataMode = xMode;
    series(k).XData = xColumns{k};
    series(k).YData = yColumns{k};
    series(k).YNegativeDelta = ynegColumns{k};
    series(k).YPositiveDelta = yposColumns{k};
    series(k).XNegativeDelta = xnegColumns{k};
    series(k).XPositiveDelta = xposColumns{k};
  end
end
%=============================================================================
function tf = shouldSplitVectorByElement(x, y, yneg, ypos, xneg, xpos)
  tf = false;
  if isempty(y) || ~isvector(y) || numel(y) <= 1
    return
  end
  if ~isempty(x) && (~isvector(x) || numel(x) ~= numel(y))
    return
  end
  deltas = {yneg, ypos, xneg, xpos};
  for k = 1:numel(deltas)
    delta = deltas{k};
    if ~isempty(delta) && isscalar(delta)
      tf = true;
      return
    end
  end
end
%=============================================================================
function series = buildPointSeries(x, y, yneg, ypos, xneg, xpos, xMode)
  y = y(:).';
  if strcmp(xMode, 'auto')
    x = 1:numel(y);
  else
    x = x(:).';
  end
  count = numel(y);
  series = repmat(emptySeries(), 1, count);
  for k = 1:count
    series(k).XDataMode = xMode;
    series(k).XData = x(k);
    series(k).YData = y(k);
    series(k).YNegativeDelta = pointDelta(yneg, k);
    series(k).YPositiveDelta = pointDelta(ypos, k);
    series(k).XNegativeDelta = pointDelta(xneg, k);
    series(k).XPositiveDelta = pointDelta(xpos, k);
  end
end
%=============================================================================
function value = pointDelta(delta, index)
  if isempty(delta)
    value = [];
  elseif isscalar(delta)
    value = delta;
  else
    delta = delta(:).';
    value = delta(index);
  end
end
%=============================================================================
function st = emptySeries()
  st = struct('XDataMode', 'auto', 'XData', [], 'YData', [], ...
    'YNegativeDelta', [], 'YPositiveDelta', [], 'XNegativeDelta', [], 'XPositiveDelta', []);
end
%=============================================================================
function columns = dataColumns(data, name)
  if isempty(data)
    error('Nelson:errorbar:mustBeRealNumeric', '%s must be real numeric data.', name);
  end
  if isvector(data)
    columns = {data(:)'};
    return
  end
  columns = cell(1, size(data, 2));
  for k = 1:size(data, 2)
    columns{k} = data(:, k).';
  end
end
%=============================================================================
function columns = xColumnsForSeries(x, yColumns, count, xMode)
  if strcmp(xMode, 'auto')
    columns = cell(1, count);
    for k = 1:count
      columns{k} = 1:numel(yColumns{k});
    end
    return
  end
  columns = dataColumns(x, 'XData');
  if numel(columns) == 1 && count > 1
    columns = repmat(columns, 1, count);
  elseif numel(columns) ~= count
    error('Nelson:dimagree:valueValueNumberElements', '%s and %s must have the same number of elements.', 'XData', 'YData');
  end
end
%=============================================================================
function columns = deltaColumnsForSeries(delta, yColumns, count, name)
  columns = cell(1, count);
  if isempty(delta)
    columns(:) = {[]};
    return
  end
  if isscalar(delta)
    columns(:) = {delta};
    return
  end
  if isvector(delta)
    value = delta(:).';
    validateDeltaLength(value, yColumns{1}, name);
    columns(:) = {value};
    return
  end
  if size(delta, 2) ~= count
    error('Nelson:errorbar:invalidLength', '%s must be a scalar or match XData and YData length.', name);
  end
  for k = 1:count
    value = delta(:, k).';
    validateDeltaLength(value, yColumns{k}, name);
    columns{k} = value;
  end
end
%=============================================================================
function validateDeltaLength(delta, y, name)
  if numel(delta) ~= numel(y)
    error('Nelson:errorbar:invalidLength', '%s must be a scalar or match XData and YData length.', name);
  end
end
%=============================================================================
function tf = isErrorBarPropertyName(value)
  if ~(ischar(value) || isStringScalar(value))
    tf = false;
    return
  end
  names = {'AlignVertexCenters', 'CapSize', 'Clipping', 'Color', 'ColorMode', ...
    'LineWidth', 'LineStyle', 'LineStyleMode', 'Marker', 'MarkerMode', ...
    'MarkerEdgeColor', 'MarkerFaceColor', 'MarkerSize', 'XNegativeDelta', ...
    'XNegativeDeltaSource', 'XPositiveDelta', 'XPositiveDeltaSource', ...
    'YNegativeDelta', 'YNegativeDeltaSource', 'YPositiveDelta', ...
    'YPositiveDeltaSource', 'Parent', 'Visible', 'HandleVisibility', ...
    'ButtonDownFcn', 'ContextMenu', 'BusyAction', 'Interruptible', ...
    'CreateFcn', 'DeleteFcn', 'Tag', 'UserData', 'Selected', ...
    'SelectionHighlight', 'HitTest', 'PickableParts', 'DisplayName', ...
    'SeriesIndex', 'XData', 'XDataMode', 'XDataSource', 'YData', ...
    'YDataSource'};
  tf = any(strcmpi(char(value), names));
end
%=============================================================================
function ax = errorbarAxes(parent)
  if isgraphics(parent, 'axes')
    ax = parent;
  else
    ax = ancestor(parent, 'axes');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = fcontour(varargin)
  narginchk(1, 1000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [parent, args] = parseParent(args);
  if isempty(args) || ~(isa(args{1}, 'function_handle') || isFunctionHandleCell(args{1}))
    error('Nelson:graphics:functionHandleExpected', '%s must be a function handle.', 'Value');
  end
  functions = normalizeFunctions(args{1});
  args = args(2:end);
  [styleProperties, args] = parseLeadingLineSpec(args);
  [range, rangeSet, args] = parseRange(args);
  [moreStyleProperties, args] = parseLeadingLineSpec(args);
  styleProperties = [styleProperties, moreStyleProperties];
  objectProperties = parseObjectProperties(args);
  if isempty(parent)
    ax = newplot();
  elseif isgraphics(parent, 'axes')
    ax = newplot(parent);
  else
    ax = ancestor(parent, 'axes');
  end
  nextPlot = ax.NextPlot;
  rangeProperties = {};
  if rangeSet
    rangeProperties = {'XRange', range(1:2), 'YRange', range(3:4)};
  end
  h = gobjects(numel(functions), 1);
  for k = 1:numel(functions)
    h(k) = __fcontour__('Parent', ax, 'Function', functions{k}, rangeProperties{:}, ...
      styleProperties{:}, objectProperties{:});
  end
  axis(ax, 'tight');
  if any(strcmp(nextPlot, {'replace', 'replaceall'}))
    ax.Box = 'on';
  end
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [parent, args] = parseParent(args)
  parent = [];
  if ~isempty(args) && isscalar(args{1}) && (isgraphics(args{1}, 'axes') || isgraphics(args{1}, 'hggroup'))
    parent = args{1};
    args = args(2:end);
  end
end
%=============================================================================
function tf = isFunctionHandleCell(value)
  tf = iscell(value) && all(cellfun(@(f) isa(f, 'function_handle'), value(:)));
end
%=============================================================================
function functions = normalizeFunctions(value)
  if iscell(value)
    functions = value(:);
  else
    functions = {value};
  end
end
%=============================================================================
function [range, rangeSet, args] = parseRange(args)
  range = [-5 5 -5 5];
  rangeSet = false;
  if ~isempty(args) && (isa(args{1}, 'function_handle') || isFunctionHandleCell(args{1}))
    error('Nelson:graphics:tooManyFunctions', 'Too many functions.');
  end
  if ~isempty(args) && isnumeric(args{1}) && isreal(args{1}) ...
      && (numel(args{1}) == 2 || numel(args{1}) == 4)
    range = normalizeRange(args{1});
    rangeSet = true;
    args(1) = [];
  elseif ~isempty(args) && isnumeric(args{1})
    error('Nelson:graphics:invalidRange', 'Range must have two or four elements.');
  end
end
%=============================================================================
function range = normalizeRange(value)
  value = double(value(:)');
  if numel(value) == 2
    range = [value(1), value(2), value(1), value(2)];
  elseif numel(value) == 4
    range = value;
  else
    error('Nelson:graphics:invalidRange', 'Range must have two or four elements.');
  end
  if range(1) > range(2) || range(3) > range(4) || any(~isfinite(range))
    error('Nelson:graphics:rangeNotIncreasing', 'Range values must be increasing and finite.');
  end
end
%=============================================================================
function [styleProperties, args] = parseLeadingLineSpec(args)
  styleProperties = {};
  if isempty(args) || ~(ischar(args{1}) || isStringScalar(args{1}))
    return
  end
  [lineStyle, color, marker, msg] = colstyle(args{1}, 'plot', false);
  if ~isempty(msg)
    return
  end
  args(1) = [];
  if ~isempty(marker)
    error('Nelson:fcontour:markersNotSupported', 'Markers not supported.');
  end
  if ~isempty(lineStyle)
    styleProperties = [styleProperties, {'LineStyle', lineStyle}];
  end
  if ~isempty(color)
    styleProperties = [styleProperties, {'LineColor', color}];
  end
end
%=============================================================================
function properties = parseObjectProperties(args)
  properties = args;
  if isempty(properties)
    return
  end
  if mod(numel(properties), 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  for k = 1:2:numel(properties)
    if ~isFcontourPropertyName(properties{k})
      error('Nelson:graphics:invalidParameter', 'Invalid parameter ''%s''.', char(properties{k}));
    end
  end
end
%=============================================================================
function tf = isFcontourPropertyName(value)
  tf = false;
  if ~(ischar(value) || isStringScalar(value))
    return
  end
  name = lower(char(value));
  names = {'annotation', 'beingdeleted', 'busyaction', 'buttondownfcn', 'children', ...
    'clipping', 'contextmenu', 'createfcn', 'deletefcn', 'displayname', 'fill', ...
    'function', 'handlevisibility', 'hittest', 'interruptible', 'levellist', ...
    'levellistmode', 'linestyle', 'linecolor', 'linewidth', 'meshdensity', ...
    'parent', 'pickableparts', 'selected', 'selectionhighlight', 'tag', 'userdata', ...
    'visible', 'xrange', 'xrangemode', 'yrange', 'yrangemode'};
  tf = any(strcmp(name, names));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = feather(varargin)
  narginchk(1, 1000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [parent, args] = graphicsParseParent(args);
  [u, v, lineSpec, colorSpec, markerSpec, propertiesList] = parseFeatherArgs(args);
  m = numel(u);
  arrow = ([0 1 NaN .8 1 .8]' + [0 0 NaN .08 0 -.08]' .* 1i);
  z = u + v .* 1i;
  a = arrow * z + ones(6, 1) * (1:m);
  if isempty(parent)
    ax = newplot();
  else
    ax = newplot(parent);
  end
  h = plot(ax, real(a), imag(a), lineSpec, [1 m], [0 0], lineSpec, propertiesList{:});
  if isempty(colorSpec) && ~hasPropertyName(propertiesList, 'Color')
    colorOrder = get(ax, 'ColorOrder');
    if ~isempty(colorOrder)
      singleColor = colorOrder(1, :);
      for k = 1:numel(h)
        h(k).Color = singleColor;
      end
    end
  end
  if isempty(markerSpec) && ~hasPropertyName(propertiesList, 'Marker')
    for k = 1:numel(h)
      h(k).Marker = 'none';
    end
  end
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [u, v, lineSpec, colorSpec, markerSpec, propertiesList] = parseFeatherArgs(args)
  if isempty(args)
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Value');
  end
  if numel(args) >= 2 && isnumeric(args{2})
    u = args{1};
    v = args{2};
    args = args(3:end);
  else
    if ~isnumeric(args{1})
      error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Value');
    end
    z = args{1};
    u = real(z);
    v = imag(z);
    args = args(2:end);
  end
  if numel(u) ~= numel(v)
    error('Nelson:dimagree:valueValueNumberElements', '%s and %s must have the same number of elements.', 'U', 'V');
  end
  if ~(isnumeric(u) && isnumeric(v))
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Value');
  end
  u = double(u(:).');
  v = double(v(:).');
  [lineSpec, colorSpec, markerSpec, propertiesList] = parseLineSpecAndProperties(args);
end
%=============================================================================
function [lineSpec, colorSpec, markerSpec, propertiesList] = parseLineSpecAndProperties(args)
  lineSpec = '-';
  colorSpec = '';
  markerSpec = '';
  if ~isempty(args) && (ischar(args{1}) || isStringScalar(args{1}))
    [~, colorSpec, markerSpec, msg] = colstyle(args{1}, 'plot', false);
    if isempty(msg)
      lineSpec = args{1};
      args = args(2:end);
    else
      colorSpec = '';
      markerSpec = '';
    end
  end
  if mod(numel(args), 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  propertiesList = args;
end
%=============================================================================
function tf = hasPropertyName(propertiesList, name)
  tf = false;
  for k = 1:2:numel(propertiesList)
    propertyName = propertiesList{k};
    if (ischar(propertyName) || isStringScalar(propertyName)) && strcmpi(propertyName, name)
      tf = true;
      return
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = fill(varargin)
  % fill(X, Y, C)
  % fill(X1, Y1, C1, ..., Xn, Yn, Cn)
  % fill(..., Name, Value)
  % fill(ax, ...)
  % p = fill(...)

  nargoutchk(0, 1);
  narginchk(3, 1000);

  inputArguments = convertStringToCharArgs(varargin);
  [parent, inputArguments] = parseParent(inputArguments);
  ax = ancestor(parent, 'axes');
  nextPlot = '';
  if ~isempty(ax) && isscalar(ax) && isgraphics(ax, 'axes')
    nextPlot = ax.NextPlot;
  end
  [groups, propertiesList] = parseFillGroups(inputArguments, 3);

  h = gobjects(1, 0);
  for k = 1:length(groups)
    group = groups{k};
    h = [h, renderFillGroup(parent, group{1}, group{2}, group{3}, propertiesList)];
  end
  if ~isempty(ax) && any(strcmp(nextPlot, {'replace', 'replaceall'}))
    ax.Box = 'on';
  end

  if (nargout > 0)
    varargout{1} = h;
  else
    varargout = {};
  end
end
%=============================================================================
function [parent, inputArguments] = parseParent(inputArguments)
  if ~isempty(inputArguments) && isscalar(inputArguments{1}) ...
      && (isgraphics(inputArguments{1}, 'axes') || isgraphics(inputArguments{1}, 'hggroup'))
    parent = inputArguments{1}(1);
    inputArguments = inputArguments(2:end);
    parent = newplotTarget(parent);
  else
    [parent, inputArguments] = graphicsExtractParentProperty(inputArguments);
    parent = newplotTarget(parent);
  end
end
%=============================================================================
function [groups, propertiesList] = parseFillGroups(inputArguments, groupWidth)
  groups = {};
  k = 1;
  while k <= length(inputArguments)
    if isPatchPropertyName(inputArguments{k})
      break
    end
    if k + groupWidth - 1 > length(inputArguments)
      error('Nelson:notEnoughInputs', 'Not enough input arguments.');
    end
    groups{end + 1} = inputArguments(k:k + groupWidth - 1);
    k = k + groupWidth;
  end
  if isempty(groups)
    error('Nelson:notEnoughInputs', 'Not enough input arguments.');
  end
  propertiesList = inputArguments(k:end);
  if mod(length(propertiesList), 2) ~= 0
    error('Nelson:wrongNumberOfInputs', 'Wrong number of input arguments.');
  end
end
%=============================================================================
function h = renderFillGroup(parent, XData, YData, CData, propertiesList)
  [XData, YData] = normalizeFillMatrices(XData, YData);
  nbPolygons = size(XData, 2);
  h = gobjects(1, nbPolygons);
  for k = 1:nbPolygons
    X = XData(:, k);
    Y = YData(:, k);
    Z = zeros(size(X));
    C = selectColorData(CData, k, nbPolygons);
    h(k) = patch(parent, X, Y, Z, C, propertiesList{:});
  end
end
%=============================================================================
function [XData, YData] = normalizeFillMatrices(XData, YData)
  if isvector(XData)
    XData = XData(:);
  end
  if isvector(YData)
    YData = YData(:);
  end
  if size(XData, 1) == 1 && size(YData, 1) > 1
    XData = XData.';
  end
  if size(YData, 1) == 1 && size(XData, 1) > 1
    YData = YData.';
  end
  if size(XData, 2) == 1 && size(YData, 2) > 1
    XData = repmat(XData, 1, size(YData, 2));
  end
  if size(YData, 2) == 1 && size(XData, 2) > 1
    YData = repmat(YData, 1, size(XData, 2));
  end
  if ~isequal(size(XData), size(YData))
    error('Nelson:dimagree:sizeDataMismatch', 'Size of data mismatch.');
  end
end
%=============================================================================
function C = selectColorData(CData, columnIndex, nbPolygons)
  C = CData;
  if ischar(CData) || isStringScalar(CData)
    return
  end
  if isnumeric(CData) && isvector(CData) && numel(CData) == 3
    C = CData(:).';
    return
  end
  if isnumeric(CData) && ismatrix(CData)
    if size(CData, 2) == nbPolygons && size(CData, 1) ~= 3
      C = CData(:, columnIndex);
    elseif size(CData, 3) == 1 && size(CData, 2) == nbPolygons && size(CData, 1) == 3
      C = CData(:, columnIndex);
    end
  end
end
%=============================================================================
function tf = isPatchPropertyName(value)
  tf = ischar(value) && isValidGraphicsProperty('patch', value);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = fill3(varargin)
  % fill3(X, Y, Z, C)
  % fill3(X1, Y1, Z1, C1, ..., Xn, Yn, Zn, Cn)
  % fill3(..., Name, Value)
  % fill3(ax, ...)
  % p = fill3(...)

  nargoutchk(0, 1);
  narginchk(4, 1000);

  inputArguments = convertStringToCharArgs(varargin);
  [parent, inputArguments] = parseParent(inputArguments);
  nextplot = parent.NextPlot;
  [groups, propertiesList] = parseFillGroups(inputArguments, 4);

  h = gobjects(1, 0);
  for k = 1:length(groups)
    group = groups{k};
    h = [h, renderFill3Group(parent, group{1}, group{2}, group{3}, group{4}, propertiesList)];
  end

  if strcmp(nextplot, 'replaceall') || strcmp(nextplot, 'replace')
    view(parent, 3);
    grid(parent, 'off');
  elseif strcmp(nextplot, 'replacechildren')
    view(parent, 3);
  end

  if (nargout > 0)
    varargout{1} = h;
  else
    varargout = {};
  end
end
%=============================================================================
function [parent, inputArguments] = parseParent(inputArguments)
  if ~isempty(inputArguments) && isscalar(inputArguments{1}) ...
      && (isgraphics(inputArguments{1}, 'axes') || isgraphics(inputArguments{1}, 'hggroup'))
    parent = inputArguments{1}(1);
    inputArguments = inputArguments(2:end);
    if isgraphics(parent, 'axes')
      parent = newplot(parent);
    end
  else
    parent = newplot();
  end
end
%=============================================================================
function [groups, propertiesList] = parseFillGroups(inputArguments, groupWidth)
  groups = {};
  k = 1;
  while k <= length(inputArguments)
    if isPatchPropertyName(inputArguments{k})
      break
    end
    if k + groupWidth - 1 > length(inputArguments)
      error('Nelson:notEnoughInputs', 'Not enough input arguments.');
    end
    groups{end + 1} = inputArguments(k:k + groupWidth - 1);
    k = k + groupWidth;
  end
  if isempty(groups)
    error('Nelson:notEnoughInputs', 'Not enough input arguments.');
  end
  propertiesList = inputArguments(k:end);
  if mod(length(propertiesList), 2) ~= 0
    error('Nelson:wrongNumberOfInputs', 'Wrong number of input arguments.');
  end
end
%=============================================================================
function h = renderFill3Group(parent, XData, YData, ZData, CData, propertiesList)
  [XData, YData, ZData] = normalizeFill3Matrices(XData, YData, ZData);
  nbPolygons = size(XData, 2);
  h = gobjects(1, nbPolygons);
  for k = 1:nbPolygons
    C = selectColorData(CData, k, nbPolygons);
    h(k) = patch(parent, XData(:, k), YData(:, k), ZData(:, k), C, propertiesList{:});
  end
end
%=============================================================================
function [XData, YData, ZData] = normalizeFill3Matrices(XData, YData, ZData)
  if isvector(XData), XData = XData(:); end
  if isvector(YData), YData = YData(:); end
  if isvector(ZData), ZData = ZData(:); end
  widths = [size(XData, 2), size(YData, 2), size(ZData, 2)];
  nbPolygons = max(widths);
  if size(XData, 2) == 1 && nbPolygons > 1, XData = repmat(XData, 1, nbPolygons); end
  if size(YData, 2) == 1 && nbPolygons > 1, YData = repmat(YData, 1, nbPolygons); end
  if size(ZData, 2) == 1 && nbPolygons > 1, ZData = repmat(ZData, 1, nbPolygons); end
  if ~isequal(size(XData), size(YData)) || ~isequal(size(XData), size(ZData))
    error('Nelson:dimagree:sizeDataMismatch', 'Size of data mismatch.');
  end
end
%=============================================================================
function C = selectColorData(CData, columnIndex, nbPolygons)
  C = CData;
  if ischar(CData) || isStringScalar(CData)
    return
  end
  if isnumeric(CData) && isvector(CData) && numel(CData) == 3
    C = CData(:).';
    return
  end
  if isnumeric(CData) && ismatrix(CData)
    if size(CData, 2) == nbPolygons && size(CData, 1) ~= 3
      C = CData(:, columnIndex);
    elseif size(CData, 3) == 1 && size(CData, 2) == nbPolygons && size(CData, 1) == 3
      C = CData(:, columnIndex);
    end
  end
end
%=============================================================================
function tf = isPatchPropertyName(value)
  tf = ischar(value) && isValidGraphicsProperty('patch', value);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = fimplicit(varargin)
  narginchk(1, 1000);
  nargoutchk(0, 2);
  args = convertStringToCharArgs(varargin);
  [parent, args] = parseParent(args);
  if isempty(args) || ~(isa(args{1}, 'function_handle') || isFunctionHandleCell(args{1}))
    error('Nelson:graphics:functionHandleExpected', '%s must be a function handle.', 'Value');
  end
  functions = normalizeFunctions(args{1});
  args = args(2:end);
  [styleProperties, args] = parseLeadingLineSpec(args);
  [range, rangeSet, args] = parseRange(args);
  [moreStyleProperties, args] = parseLeadingLineSpec(args);
  styleProperties = [styleProperties, moreStyleProperties];
  objectProperties = parseObjectProperties(args);
  if isempty(parent)
    ax = newplot();
  elseif isgraphics(parent, 'axes')
    ax = newplot(parent);
  else
    ax = ancestor(parent, 'axes');
  end
  nextPlot = ax.NextPlot;
  rangeProperties = {};
  if rangeSet
    rangeProperties = {'XRange', range(1:2), 'YRange', range(3:4)};
  end
  colorIsUserDefined = hasColorProperty(styleProperties) || hasColorProperty(objectProperties);
  h = gobjects(numel(functions), 1);
  for k = 1:numel(functions)
    colorProperties = {};
    if ~colorIsUserDefined
      colorProperties = {'Color', getColorAndUpdateIndex(ax)};
    end
    h(k) = __fimplicit__('Parent', ax, 'Function', functions{k}, rangeProperties{:}, ...
      styleProperties{:}, colorProperties{:}, objectProperties{:});
  end
  axis(ax, 'tight');
  if rangeSet && range(1) < range(2) && range(3) < range(4)
    ax.XLim = range(1:2);
    ax.YLim = range(3:4);
  end
  if any(strcmp(nextPlot, {'replace', 'replaceall'}))
    ax.Box = 'on';
  end
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [parent, args] = parseParent(args)
  parent = [];
  if ~isempty(args) && isscalar(args{1}) && (isgraphics(args{1}, 'axes') || isgraphics(args{1}, 'hggroup'))
    parent = args{1};
    args = args(2:end);
  end
end
%=============================================================================
function tf = isFunctionHandleCell(value)
  tf = iscell(value) && all(cellfun(@(f) isa(f, 'function_handle'), value(:)));
end
%=============================================================================
function functions = normalizeFunctions(value)
  if iscell(value)
    functions = value(:);
  else
    functions = {value};
  end
end
%=============================================================================
function [range, rangeSet, args] = parseRange(args)
  range = [-5 5 -5 5];
  rangeSet = false;
  if ~isempty(args) && (isa(args{1}, 'function_handle') || isFunctionHandleCell(args{1}))
    error('Nelson:graphics:tooManyFunctions', 'Too many functions.');
  end
  if ~isempty(args) && isnumeric(args{1}) && isreal(args{1}) ...
      && (numel(args{1}) == 2 || numel(args{1}) == 4)
    range = normalizeRange(args{1});
    rangeSet = true;
    args(1) = [];
  elseif ~isempty(args) && isnumeric(args{1})
    error('Nelson:graphics:invalidRange', 'Range must have two or four elements.');
  end
end
%=============================================================================
function range = normalizeRange(value)
  value = double(value(:)');
  if numel(value) == 2
    range = [value(1), value(2), value(1), value(2)];
  elseif numel(value) == 4
    range = value;
  else
    error('Nelson:graphics:invalidRange', 'Range must have two or four elements.');
  end
  if range(1) > range(2) || range(3) > range(4) || any(~isfinite(range))
    error('Nelson:graphics:rangeNotIncreasing', 'Range values must be increasing and finite.');
  end
end
%=============================================================================
function [styleProperties, args] = parseLeadingLineSpec(args)
  styleProperties = {};
  if isempty(args) || ~(ischar(args{1}) || isStringScalar(args{1}))
    return
  end
  [lineStyle, color, marker, msg] = colstyle(args{1}, 'plot', false);
  if ~isempty(msg)
    return
  end
  args(1) = [];
  if ~isempty(lineStyle)
    styleProperties = [styleProperties, {'LineStyle', lineStyle}];
  elseif ~isempty(marker)
    styleProperties = [styleProperties, {'LineStyle', 'none'}];
  end
  if ~isempty(color)
    styleProperties = [styleProperties, {'Color', color}];
  end
  if ~isempty(marker)
    styleProperties = [styleProperties, {'Marker', marker}];
  end
end
%=============================================================================
function properties = parseObjectProperties(args)
  properties = args;
  if isempty(properties)
    return
  end
  if mod(numel(properties), 2) ~= 0
    if (ischar(properties{1}) || isStringScalar(properties{1})) ...
        && ~isFimplicitPropertyName(properties{1})
      error('Nelson:graphics:invalidParameter', 'Invalid parameter ''%s''.', char(properties{1}));
    end
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  for k = 1:2:numel(properties)
    if ~isFimplicitPropertyName(properties{k})
      error('Nelson:graphics:invalidParameter', 'Invalid parameter ''%s''.', char(properties{k}));
    end
  end
end
%=============================================================================
function tf = hasColorProperty(properties)
  tf = false;
  for k = 1:2:numel(properties)
    if (ischar(properties{k}) || isStringScalar(properties{k})) ...
        && strcmpi(char(properties{k}), 'Color')
      tf = true;
      return
    end
  end
end
%=============================================================================
function tf = isFimplicitPropertyName(value)
  tf = false;
  if ~(ischar(value) || isStringScalar(value))
    return
  end
  name = lower(char(value));
  names = {'annotation', 'beingdeleted', 'busyaction', 'buttondownfcn', 'children', ...
    'clipping', 'color', 'contextmenu', 'createfcn', 'deletefcn', 'displayname', ...
    'function', 'handlevisibility', 'hittest', 'interruptible', 'linestyle', ...
    'linewidth', 'marker', 'meshdensity', 'parent', 'pickableparts', 'selected', ...
    'selectionhighlight', 'tag', 'userdata', 'visible', 'xrange', 'xrangemode', ...
    'yrange', 'yrangemode'};
  tf = any(strcmp(name, names));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = fimplicit3(varargin)
  narginchk(1, 1000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [parent, args] = parseParent(args);
  if isempty(args) || ~isa(args{1}, 'function_handle')
    error('Nelson:graphics:functionHandleExpected', '%s must be a function handle.', 'Value');
  end
  fun = args{1};
  args = args(2:end);
  [range, rangeSet, meshDensity, styleProperties, objectProperties] = parseFimplicit3Options(args);
  if isempty(parent)
    ax = newplot();
  elseif isgraphics(parent, 'axes')
    ax = newplot(parent);
  else
    ax = ancestor(parent, 'axes');
  end
  effectiveMeshDensity = max(2, ceil(sqrt(2) * meshDensity));
  [faces, vertices, edgeXData, edgeYData, edgeZData] = ...
    __fimplicit3_mesh__(fun, range, effectiveMeshDensity);
  rangeProperties = {};
  if rangeSet
    rangeProperties = {'XRange', range(1:2), 'YRange', range(3:4), 'ZRange', range(5:6)};
  end
  defaultColorProperties = fimplicit3DefaultColorProperties(styleProperties, objectProperties, vertices);
  h = __fimplicit3__('Parent', ax, 'Function', fun, rangeProperties{:}, ...
    'MeshDensity', meshDensity, 'Faces', faces, 'Vertices', vertices, ...
    defaultColorProperties{:}, styleProperties{:}, objectProperties{:});
  edgeLineProperties = fimplicit3EdgeLineProperties(styleProperties, objectProperties);
  if ~isempty(edgeXData) && fimplicit3DrawEdgeLine(edgeLineProperties)
    line(edgeXData, edgeYData, edgeZData, 'Parent', ax, edgeLineProperties{:});
  end
  view(ax, 3);
  grid(ax, 'on');
  axis(ax, 'tight');
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function properties = fimplicit3DefaultColorProperties(styleProperties, objectProperties, vertices)
  properties = {};
  if hasFimplicit3Property(objectProperties, 'FaceVertexCData')
    return
  end
  faceColor = fimplicit3FaceColor(styleProperties, objectProperties);
  if isempty(faceColor)
    properties = {'FaceColor', 'interp', 'FaceVertexCData', vertices(:, 3)};
  elseif (ischar(faceColor) || isStringScalar(faceColor)) && strcmpi(char(faceColor), 'interp')
    properties = {'FaceVertexCData', vertices(:, 3)};
  end
end
%=============================================================================
function value = fimplicit3FaceColor(styleProperties, objectProperties)
  value = fimplicit3PropertyValue(objectProperties, 'FaceColor');
  if isempty(value)
    value = fimplicit3PropertyValue(styleProperties, 'FaceColor');
  end
end
%=============================================================================
function value = fimplicit3PropertyValue(properties, name)
  value = [];
  for k = 1:2:numel(properties)
    if strcmpi(char(properties{k}), name)
      value = properties{k + 1};
      return
    end
  end
end
%=============================================================================
function tf = hasFimplicit3Property(properties, name)
  tf = false;
  for k = 1:2:numel(properties)
    if strcmpi(char(properties{k}), name)
      tf = true;
      return
    end
  end
end
%=============================================================================
function properties = fimplicit3EdgeLineProperties(styleProperties, objectProperties)
  properties = {'Color', [0 0 0], 'LineStyle', '-', 'LineWidth', 0.5, ...
    'Marker', 'none', 'HandleVisibility', 'off'};
  properties = appendFimplicit3EdgeLineProperties(properties, styleProperties);
  for k = 1:2:numel(objectProperties)
    name = char(objectProperties{k});
    value = objectProperties{k + 1};
    if strcmpi(name, 'EdgeColor')
      properties = setFimplicit3LineProperty(properties, 'Color', value);
    elseif any(strcmpi(name, {'LineStyle', 'LineWidth', 'Marker', ...
        'MarkerEdgeColor', 'MarkerFaceColor', 'MarkerSize', 'Visible'}))
      properties = setFimplicit3LineProperty(properties, name, value);
    end
  end
end
%=============================================================================
function properties = appendFimplicit3EdgeLineProperties(properties, styleProperties)
  for k = 1:2:numel(styleProperties)
    name = char(styleProperties{k});
    if strcmpi(name, 'LineStyle') || strcmpi(name, 'Marker')
      properties = setFimplicit3LineProperty(properties, name, styleProperties{k + 1});
    end
  end
end
%=============================================================================
function properties = setFimplicit3LineProperty(properties, name, value)
  for k = 1:2:numel(properties)
    if strcmpi(char(properties{k}), name)
      properties{k + 1} = value;
      return
    end
  end
  properties = [properties, {name, value}];
end
%=============================================================================
function tf = fimplicit3DrawEdgeLine(properties)
  tf = true;
  for k = 1:2:numel(properties)
    name = char(properties{k});
    value = properties{k + 1};
    if (strcmpi(name, 'Color') || strcmpi(name, 'LineStyle')) ...
        && (ischar(value) || isStringScalar(value)) && strcmpi(char(value), 'none')
      tf = false;
      return
    end
  end
end
%=============================================================================
function [parent, args] = parseParent(args)
  parent = [];
  if ~isempty(args) && isscalar(args{1}) && (isgraphics(args{1}, 'axes') || isgraphics(args{1}, 'hggroup'))
    parent = args{1};
    args = args(2:end);
  end
end
%=============================================================================
function [range, rangeSet, meshDensity, styleProperties, objectProperties] = parseFimplicit3Options(args)
  range = [-5 5 -5 5 -5 5];
  rangeSet = false;
  meshDensity = 35;
  styleProperties = {};
  lineSpecFound = false;
  while ~isempty(args)
    if ~lineSpecFound && (ischar(args{1}) || isStringScalar(args{1}))
      [lineStyle, color, marker, msg] = colstyle(args{1}, 'plot', false);
      if isempty(msg)
        lineSpecFound = true;
        args(1) = [];
        styleProperties = appendLineSpecProperties(styleProperties, lineStyle, color, marker);
        continue
      end
    end
    if ~rangeSet && isnumeric(args{1}) && isreal(args{1}) ...
        && (numel(args{1}) == 2 || numel(args{1}) == 6)
      range = normalizeRange(args{1});
      rangeSet = true;
      args(1) = [];
      continue
    end
    break
  end
  objectProperties = args;
  if mod(numel(objectProperties), 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  for k = 1:2:numel(objectProperties)
    if ~isFimplicit3PropertyName(objectProperties{k})
      error('Nelson:graphics:invalidPropertyName', 'Invalid property name.');
    end
    if strcmpi(char(objectProperties{k}), 'MeshDensity')
      meshDensity = objectProperties{k + 1};
    end
  end
  validateMeshDensity(meshDensity);
end
%=============================================================================
function styleProperties = appendLineSpecProperties(styleProperties, lineStyle, color, marker)
  if ~isempty(lineStyle)
    styleProperties = [styleProperties, {'LineStyle', lineStyle}];
  end
  if ~isempty(color)
    styleProperties = [styleProperties, {'FaceColor', color}];
  end
  if ~isempty(marker)
    styleProperties = [styleProperties, {'Marker', marker}];
  end
end
%=============================================================================
function range = normalizeRange(value)
  value = double(value(:)');
  if numel(value) == 2
    range = [value(1), value(2), value(1), value(2), value(1), value(2)];
  elseif numel(value) == 6
    range = value;
  else
    error('Nelson:fimplicit3:invalidRange:rangeTwoSixElements', 'Range must have two or six elements.');
  end
  if range(1) >= range(2) || range(3) >= range(4) || range(5) >= range(6) || any(~isfinite(range))
    error('Nelson:graphics:rangeNotIncreasing', 'Range values must be increasing and finite.');
  end
end
%=============================================================================
function validateMeshDensity(meshDensity)
  if ~isnumeric(meshDensity) || ~isscalar(meshDensity) || meshDensity < 2 || meshDensity ~= fix(meshDensity)
    error('Nelson:graphics:invalidMeshDensity', 'MeshDensity must be a positive integer greater than one.');
  end
end
%=============================================================================
function tf = isFimplicit3PropertyName(value)
  tf = false;
  if ~(ischar(value) || isStringScalar(value))
    return
  end
  name = lower(char(value));
  names = {'alphadata', 'alphadatamapping', 'ambientstrength', 'annotation', ...
    'backfacelighting', 'beingdeleted', 'busyaction', 'buttondownfcn', 'cdata', ...
    'cdatamapping', 'children', 'clipping', 'contextmenu', 'createfcn', ...
    'deletefcn', 'diffusestrength', 'displayname', 'edgealpha', 'edgecolor', ...
    'edgelighting', 'facealpha', 'facecolor', 'facelighting', 'function', ...
    'facenormals', 'facenormalsmode', 'faces', 'facevertexalphadata', ...
    'facevertexcdata', 'facevertexcdatamode', 'handlevisibility', 'hittest', ...
    'interruptible', 'linejoin', 'linestyle', 'linewidth', 'marker', ...
    'markeredgecolor', 'markerfacecolor', 'markersize', 'meshdensity', ...
    'parent', 'pickableparts', 'selected', 'selectionhighlight', 'seriesindex', ...
    'specularcolorreflectance', 'specularexponent', 'specularstrength', 'tag', ...
    'userdata', 'vertexnormals', 'vertexnormalsmode', 'vertices', 'visible', ...
    'xdata', 'xrange', 'xrangemode', 'ydata', 'yrange', 'yrangemode', 'zdata', ...
    'zrange', 'zrangemode'};
  tf = any(strcmp(name, names));
end
