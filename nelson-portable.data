%=============================================================================
function y = sawtooth(varargin)
  narginchk(1, 2);
  nargoutchk(0, 1);
  t = varargin{1};
  width = 1;
  if nargin == 2
    width = varargin{2};
  end
  phase = mod(t / (2 * pi), 1);
  y = zeros(size(t));
  rising = phase < width;
  y(rising) = 2 * phase(rising) / width - 1;
  y(~rising) = 1 - 2 * (phase(~rising) - width) / (1 - width);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [b, g] = sgolay(k, f, w)
  narginchk(2, 3);
  nargoutchk(0, 2);
  if ~isscalar(k) || ~isfinite(k) || k ~= fix(k) || k < 0
    error('Nelson:signal:sgolay:invalidOrder', 'Polynomial order must be a nonnegative integer.');
  end
  if ~isscalar(f) || ~isfinite(f) || f ~= fix(f) || f <= 0 || mod(f, 2) == 0
    error('Nelson:signal:sgolay:invalidFrameLength', 'Frame length must be a positive odd integer.');
  end
  if k >= f
    error('Nelson:signal:sgolay:orderTooLarge', 'Polynomial order must be less than frame length.');
  end
  if nargin < 3 || isempty(w)
    w = ones(f, 1);
  else
    if ~isvector(w) || length(w) ~= f || any(w(:) <= 0) || any(~isfinite(w(:)))
      error('Nelson:signal:sgolay:invalidWeights', 'Weights must be a positive finite vector with frame length elements.');
    end
    w = w(:);
  end
  half = (f - 1) / 2;
  x = (-half:half)';
  A = zeros(f, k + 1);
  for p = 0:k
    A(:, p + 1) = x .^ p;
  end
  W = diag(w);
  g = A * inv(A' * W * A);
  b = g * A' * W;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = sgolayfilt(varargin)
  narginchk(3, 5);
  nargoutchk(0, 1);
  input = varargin{1};
  k = varargin{2};
  f = varargin{3};
  w = [];
  dim = [];
  if nargin >= 4
    w = varargin{4};
  end
  if nargin == 5
    dim = varargin{5};
  end
  if isempty(dim)
    dim = firstNonSingletonDimension(input);
  else
    validateDimension(dim);
  end
  b = sgolay(k, f, w);
  [x2D, permutationOrder, permutedShape] = reshapeInputAlongDimension(input, dim);
  y2D = zeros(size(x2D));
  for col = 1:size(x2D, 2)
    y2D(:, col) = filterVector(x2D(:, col), b, f);
  end
  y = ipermute(reshape(y2D, permutedShape), permutationOrder);
end
%=============================================================================
function dim = firstNonSingletonDimension(x)
  shape = size(x);
  dim = find(shape ~= 1, 1, 'first');
  if isempty(dim)
    dim = 1;
  end
end
%=============================================================================
function validateDimension(dim)
  if ~isscalar(dim) || ~isfinite(dim) || dim ~= fix(dim) || dim <= 0
    error('Nelson:signal:invalidDimension', '%s must be a positive integer scalar.', 'Dimension');
  end
end
%=============================================================================
function [x2D, permutationOrder, permutedShape] = reshapeInputAlongDimension(x, dim)
  shape = size(x);
  numberOfDimensions = max([2, ndims(x), dim]);
  if length(shape) < numberOfDimensions
    shape = [shape, ones(1, numberOfDimensions - length(shape))];
  end
  remainingDimensions = 1:numberOfDimensions;
  remainingDimensions(dim) = [];
  permutationOrder = [dim, remainingDimensions];
  permutedShape = shape(permutationOrder);
  x2D = reshape(permute(x, permutationOrder), permutedShape(1), []);
end
%=============================================================================
function y = filterVector(x, b, f)
  center = (f + 1) / 2;
  y = zeros(size(x));
  for idx = 1:center - 1
    y(idx) = b(idx, :) * x(1:f);
  end
  for idx = center:length(x) - center + 1
    y(idx) = b(center, :) * x(idx - center + 1:idx + center - 1);
  end
  for idx = length(x) - center + 2:length(x)
    row = f - (length(x) - idx);
    y(idx) = b(row, :) * x(end - f + 1:end);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function c = sinc(varargin)
  narginchk(1, 1);
  x = varargin{1};
  zeroMask = x == 0;
  scaledX = pi .* x;
  c = sin(scaledX) ./ scaledX;
  c(zeroMask) = 1;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = snr(varargin)
  narginchk(1, 3);
  nargoutchk(0, 2);
  x = varargin{1};
  if nargin == 2 && ~isscalar(varargin{2})
    noise = varargin{2};
    if ~isequal(size(x), size(noise))
      error('Nelson:dimagree:signalNoiseDimensions', 'Signal and noise must have the same dimensions.');
    end
    signalPower = norm(x(:)) ^ 2;
    noisePower = norm(noise(:)) ^ 2;
    outputNoisePower = noisePower;
  else
    fs = 1;
    nHarmonics = 6;
    if nargin >= 2
      fs = varargin{2};
    end
    if nargin == 3
      nHarmonics = varargin{3};
    end
    [signalPower, noisePower] = spectralSignalNoisePower(x, fs, nHarmonics);
    outputNoisePower = 10 * log10(noisePower);
  end
  r = 10 * log10(signalPower / noisePower);
  varargout{1} = r;
  if nargout > 1
    varargout{2} = outputNoisePower;
  end
end
%=============================================================================
function [signalPower, noisePower] = spectralSignalNoisePower(x, fs, nHarmonics)
  if ~isscalar(fs) || fs <= 0
    error('Nelson:signal:snr:invalidSampleRate', '%s must be a positive scalar.', 'Sample rate');
  end
  if ~isscalar(nHarmonics) || nHarmonics < 1
    error('Nelson:signal:snr:invalidHarmonics', '%s must be a positive scalar.', 'Number of harmonics');
  end
  x = x(:) - mean(x(:));
  n = length(x);
  spectrum = abs(fft(x) / n) .^ 2;
  keep = 1:floor(n / 2) + 1;
  spectrum = spectrum(keep);
  if length(spectrum) > 2
    spectrum(2:end - 1) = 2 * spectrum(2:end - 1);
  end
  spectrum(1) = 0;
  [signalPower, fundamentalIndex] = max(spectrum);
  harmonicIndexes = fundamentalIndex:fundamentalIndex:length(spectrum);
  harmonicIndexes = harmonicIndexes(1:min(length(harmonicIndexes), nHarmonics));
  noiseSpectrum = spectrum;
  noiseSpectrum(harmonicIndexes) = 0;
  noisePower = sum(noiseSpectrum);
  if noisePower == 0
    noisePower = eps(signalPower);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [b, a] = sos2tf(sos)
  narginchk(1, 1);
  nargoutchk(0, 2);
  if isempty(sos)
    b = 1;
    a = 1;
    return;
  end
  if ~ismatrix(sos) || size(sos, 2) ~= 6
    error('Nelson:signal:invalidSOSMatrix', 'SOS matrix must have six columns.');
  end
  b = 1;
  a = 1;
  for row = 1:size(sos, 1)
    b = conv(b, sos(row, 1:3));
    a = conv(a, sos(row, 4:6));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = sos2zp(sos)
  narginchk(1, 1);
  nargoutchk(0, 3);
  if isempty(sos)
    z = [];
    p = [];
    k = 1;
  else
    if ~ismatrix(sos) || size(sos, 2) ~= 6
      error('Nelson:signal:invalidSOSMatrix', 'SOS matrix must have six columns.');
    end
    z = [];
    p = [];
    k = 1;
    for row = 1:size(sos, 1)
      numerator = sos(row, 1:3);
      denominator = signalTrimTrailingZeros(sos(row, 4:6));
      sectionOrder = length(denominator);
      numerator = numerator(1:sectionOrder);
      z = [z; rootsWithTrailingZeros(numerator)];
      p = [p; roots(denominator)];
      k = k * numerator(1) / denominator(1);
    end
  end
  varargout{1} = z;
  if nargout > 1
    varargout{2} = p;
  end
  if nargout > 2
    varargout{3} = k;
  end
end
%=============================================================================
function r = rootsWithTrailingZeros(coefficients)
  trimmed = signalTrimTrailingZeros(coefficients);
  numberOfZeros = length(coefficients) - length(trimmed);
  r = roots(trimmed);
  if numberOfZeros > 0
    r = [r; zeros(numberOfZeros, 1)];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = sosfilt(sos, x, varargin)
  narginchk(2, 3);
  nargoutchk(0, 1);
  if ~ismatrix(sos) || size(sos, 2) ~= 6
    error('Nelson:signal:invalidSOSMatrix', 'SOS matrix must have six columns.');
  end
  dim = [];
  if nargin == 3
    dim = varargin{1};
  end
  y = x;
  for row = 1:size(sos, 1)
    if isempty(dim)
      y = filter(sos(row, 1:3), sos(row, 4:6), y);
    else
      y = filter(sos(row, 1:3), sos(row, 4:6), y, [], dim);
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = spectrogram(varargin)
  narginchk(1, 5);
  nargoutchk(0, 4);
  x = varargin{1}(:);
  if nargin >= 2 && ~isempty(varargin{2})
    window = varargin{2};
    if isscalar(window)
      window = hamming(window);
    else
      window = window(:);
    end
  else
    window = hamming(256);
  end
  if nargin >= 3 && ~isempty(varargin{3})
    overlap = varargin{3};
  else
    overlap = floor(length(window) / 2);
  end
  if nargin >= 4 && ~isempty(varargin{4})
    nfft = varargin{4};
  else
    nfft = max(256, 2 ^ nextpow2(length(window)));
  end
  if nargin == 5
    fs = varargin{5};
  else
    fs = 1;
  end
  [s, f, t] = signalSpectrogramCore(x, window, overlap, nfft, fs);
  p = abs(s) .^ 2 ./ (fs * sum(abs(window) .^ 2));
  if size(p, 1) > 2
    if mod(nfft, 2) == 0
      p(2:end - 1, :) = 2 * p(2:end - 1, :);
    else
      p(2:end, :) = 2 * p(2:end, :);
    end
  end
  if nargout == 0
    imagesc(t, f, pow2db(p));
  else
    varargout{1} = s;
    if nargout > 1
      varargout{2} = f;
    end
    if nargout > 2
      varargout{3} = t;
    end
    if nargout > 3
      varargout{4} = p;
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
