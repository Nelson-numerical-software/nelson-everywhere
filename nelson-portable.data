%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [x, ok] = str2num(s)
  narginchk(1, 1);
  if isstring(s) && isscalar(s)
    s = char(s);
  end
  if ~ischar(s)
    error('Nelson:string:inputCharacterVectorStringScalar', 'Input must be a character vector or string scalar.');
  end
  x = [];
  ok = false;
  if isempty(s)
    return
  end
  try
    x = eval(['[', s, ']']);
    ok = true;
  catch
    x = [];
    ok = false;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function out = symvar(s)
  narginchk(1, 1);
  if isa(s, 'function_handle')
    s = func2str(s);
  end
  if isstring(s)
    if ~isscalar(s)
      error('Nelson:string:inputArgumentCharacterVectorString', 'Input argument must be a character vector or a string scalar.');
    end
    s = char(s);
  end
  if ~ischar(s) || (~isempty(s) && ~isrow(s))
    error('Nelson:string:inputArgumentCharacterVectorString', 'Input argument must be a character vector or a string scalar.');
  end
  % Identifiers, together with the character that follows them (after optional
  % spaces), so that a name written as a function call, name(...), can be
  % detected. A name preceded by '.' is a field access and is not matched.
  tokens = regexp(s, '(?<![A-Za-z0-9_.])([A-Za-z]\w*)\s*(\()?', 'tokens');
  % Special values are never reported as variables.
  special = {'i', 'j', 'pi', 'inf', 'Inf', 'nan', 'NaN', 'eps'};
  names = cell(0, 1);
  for k = 1:numel(tokens)
    token = tokens{k};
    name = token{1};
    isCall = (numel(token) >= 2) && ~isempty(token{2});
    if isCall
      continue;
    end
    if any(strcmp(name, special))
      continue;
    end
    names{end + 1, 1} = name; %#ok<AGROW>
  end
  if isempty(names)
    out = cell(0, 1);
  else
    out = unique(names);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function pat = textBoundary(boundary)
  narginchk(0, 1);
  nargoutchk(0, 1);
  if nargin == 0 || strcmpi(char(boundary), 'either')
    expr = '\A|\z';
  elseif strcmpi(char(boundary), 'start')
    expr = '\A';
  elseif strcmpi(char(boundary), 'end')
    expr = '\z';
  else
    error('Nelson:string:boundaryStartEndEither', 'Boundary must be ''start'', ''end'', or ''either''.');
  end
  pat = pattern(expr);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function pat = whitespaceBoundary(boundary)
  narginchk(0, 1);
  nargoutchk(0, 1);
  if nargin == 0 || strcmpi(char(boundary), 'either')
    expr = '(?:(?<=\s)(?=\S)|(?<=\S)(?=\s)|(?<=^)(?=\s)|(?<=\s)(?=$))';
  elseif strcmpi(char(boundary), 'start')
    expr = '(?<!\s)(?=\s)';
  elseif strcmpi(char(boundary), 'end')
    expr = '(?<=\s)(?!\s)';
  else
    error('Nelson:string:boundaryStartEndEither', 'Boundary must be ''start'', ''end'', or ''either''.');
  end
  pat = pattern(expr);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function pat = whitespacePattern(varargin)
  narginchk(0, 2);
  nargoutchk(0, 1);
  base = pattern('[\s\x{00A0}\x{2000}-\x{200A}]');
  if nargin == 0
    % With no count, whitespacePattern matches one or more whitespace
    % characters (a maximal run), matching the reference.
    pat = pattern([pattern.regexOf(base), '+']);
  elseif nargin == 1
    pat = pattern(['(?:', pattern.regexOf(base), '){', int2str(varargin{1}), '}']);
  else
    pat = asManyOfPattern(base, [varargin{1}, varargin{2}]);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function pat = wildcardPattern(varargin)
  narginchk(0, 4);
  nargoutchk(0, 1);
  expr = '.';
  if nargin >= 2 && strcmpi(char(varargin{1}), 'Except')
    expr = ['(?:(?!', pattern.regexOf(varargin{2}), ').)'];
    pat = asFewOfPattern(pattern(expr));
    return
  elseif nargin >= 4 && strcmpi(char(varargin{3}), 'Except')
    expr = ['(?:(?!', pattern.regexOf(varargin{4}), ').)'];
  end
  pat = pattern(expr);
  if nargin == 0
    pat = asFewOfPattern(pat);
  elseif nargin == 1
    pat = asFewOfPattern(pat, varargin{1});
  elseif nargin >= 2
    pat = asFewOfPattern(pat, [varargin{1}, varargin{2}]);
  end
end
