asserts.isequal(nargin('isstatic'), 1);
asserts.isequal(nargout('isstatic'), 1);
%=============================================================================
S = tf(3);
asserts.istrue(isstatic(S));
asserts.isequal(S.Ts, 0);
S.Ts = 0.5;
asserts.isfalse(isstatic(S));
%=============================================================================
S = tf(3, 2);
asserts.istrue(isstatic(S));
asserts.isequal(S.Ts, 0);
S.Numerator = [1 2];
