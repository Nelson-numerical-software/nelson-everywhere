jac = odeJacobian(@(t, y) - 1, 'Pattern', true(1), 'Constant', 'on');
asserts.istrue(isa(jac.Jacobian, 'function_handle'));
asserts.isequal(jac.SparsityPattern, true(1));
asserts.isequal(jac.Constant, 'on');
