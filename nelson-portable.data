function test_cases = worker_pool_sort_results(test_cases)
  if isempty(test_cases) || ~isfield(test_cases, 'pool_index')
    return
  end
  [~, order] = sort([test_cases.pool_index]); %#ok<NLS0004>
  test_cases = test_cases(order);
end
