% <--WEIGHT 2-->
G = tf([2 5 1], [1 2 3]);
C = tf([5, 10], [1, 10]);
sys = feedback(G, C, +1);
asserts.isequal(sys.Numerator, {[2 25 51 10]});
asserts.isequal(sys.Denominator, {[-9 -33 -32 20]});
%=============================================================================
