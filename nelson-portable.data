% LICENCE_BLOCK_END
%=============================================================================
function varargout = polarhistogram(varargin)
  narginchk(1, 1000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [ax, args] = polarParseTargetAxes(args);
  if isempty(args) || ~isnumeric(args{1})
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Angle data');
  end
  theta = double(args{1}(:));
  args = args(2:end);
  opts = parsePolarHistogramOptions(args);
  if isempty(opts.BinEdges) && ~isempty(opts.NumBins)
    opts.BinEdges = polarNumBinsEdges(theta, opts.NumBins);
  end
  [fig, previousDrawLater] = polarBeginDrawLater(ax);
  try
    ax = polarPrepareDataAxes(ax);
    h = createPolarHistogramObject(ax, theta, opts);
    counts = h.Values;
    edges = h.BinEdges;
    patches = drawPolarHistogramPatches(ax, counts, edges, opts);
    limitHandle = __line__('Parent', ax, 'XData', [], 'YData', [], ...
      'ThetaData', edges(1:end - 1)', 'RData', counts(:), ...
      'Visible', 'off', 'HandleVisibility', 'off');
    polarAppendDataHandles(ax, limitHandle);
    state = polarHistogramState(theta, counts, edges, patches, limitHandle, opts);
    h.UserData = state;
    if ~isempty(patches)
      patches(1).UserData = state;
    end
    polarEndDrawLater(fig, previousDrawLater);
  catch exception
    polarEndDrawLater(fig, previousDrawLater);
    error(exception.message);
  end
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function opts = parsePolarHistogramOptions(args)
  defaultEdgeColor = graphicsDefaultEdgeColor();
  opts = struct('NumBins', [], 'BinEdges', [], 'Normalization', 'count', ...
    'FaceColor', 'auto', 'EdgeColor', defaultEdgeColor, 'FaceAlpha', 0.6);
  if ~isempty(args) && isnumeric(args{1})
    if isscalar(args{1})
      opts.NumBins = validateNumBins(args{1});
    else
      opts.BinEdges = validateEdges(args{1});
    end
    args = args(2:end);
  end
  if rem(length(args), 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  for k = 1:2:length(args)
    name = lower(char(args{k}));
    value = args{k + 1};
    switch name
      case 'numbins'
        opts.NumBins = validateNumBins(value);
      case 'binedges'
        opts.BinEdges = validateEdges(value);
      case 'normalization'
        opts.Normalization = validateNormalization(value);
      case 'facecolor'
        opts.FaceColor = value;
      case 'edgecolor'
        opts.EdgeColor = value;
      case 'facealpha'
        opts.FaceAlpha = validateAlpha(value);
      otherwise
        error('Nelson:graphics:unsupportedProperty', 'Unsupported "%s" option.', 'polarhistogram');
    end
  end
end
%=============================================================================
function edges = polarNumBinsEdges(theta, numBins)
  theta = theta(isfinite(theta));
  if isempty(theta)
    edges = linspace(0, 2 * pi, numBins + 1);
    return
  end
  quantum = pi / 4;
  firstEdge = floor(min(theta) / quantum) * quantum;
  lastEdge = ceil(max(theta) / quantum) * quantum;
  if firstEdge == lastEdge
    lastEdge = firstEdge + quantum;
  end
  edges = linspace(firstEdge, lastEdge, numBins + 1);
end
%=============================================================================
function patches = drawPolarHistogramPatches(parent, counts, edges, opts)
  patches = gobjects(1, numel(counts));
  faceColor = polarHistogramPatchFaceColor(parent, opts.FaceColor);
  for k = 1:numel(counts)
    theta = linspace(edges(k), edges(k + 1), 12);
    radius = counts(k) * ones(size(theta));
    x = [0, radius .* cos(theta), 0];
    y = [0, radius .* sin(theta), 0];
    patches(k) = __patch__('Parent', parent, 'XData', x, 'YData', y, ...
      'FaceColor', faceColor, 'EdgeColor', opts.EdgeColor, ...
      'FaceAlpha', opts.FaceAlpha, 'FaceLighting', 'none', ...
      'EdgeLighting', 'none');
  end
end
%=============================================================================
function color = polarHistogramPatchFaceColor(parent, value)
  if ischar(value) && strcmpi(value, 'auto')
    color = parent.ColorOrder(1, :);
    return
  end
  color = value;
end
%=============================================================================
function h = createPolarHistogramObject(parent, theta, opts)
  args = {'Parent', parent, 'Data', theta, 'Normalization', opts.Normalization, ...
    'FaceColor', opts.FaceColor, 'EdgeColor', opts.EdgeColor, 'FaceAlpha', opts.FaceAlpha};
  if ~isempty(opts.BinEdges)
    args = [args, {'BinEdges', opts.BinEdges}];
  elseif ~isempty(opts.NumBins)
    args = [args, {'NumBins', opts.NumBins}];
  end
  h = __histogram__(args{:});
end
%=============================================================================
function state = polarHistogramState(theta, counts, edges, patches, limitHandle, opts)
  state = struct();
  state.ChartType = 'polarhistogram';
  state.Data = theta;
  state.Values = counts;
  state.BinEdges = edges;
  state.Patches = patches;
  state.LimitHandle = limitHandle;
  state.Options = opts;
end
%=============================================================================
function value = validateNumBins(value)
  if ~isnumeric(value) || ~isscalar(value) || value < 1
    error('Nelson:graphics:mustBePositiveScalar', '%s must be a positive scalar.', 'NumBins');
  end
  value = floor(double(value));
end
%=============================================================================
function edges = validateEdges(value)
  if ~isnumeric(value) || numel(value) < 2 || any(diff(value(:)) <= 0)
    error('Nelson:polarhistogram:invalidBinEdges', 'BinEdges must be a strictly increasing numeric vector.');
  end
  edges = double(value(:)');
end
%=============================================================================
function value = validateNormalization(value)
  value = lower(char(value));
  if ~(strcmp(value, 'count') || strcmp(value, 'probability'))
    error('Nelson:polarhistogram:invalidNormalization', 'Normalization must be ''count'' or ''probability''.');
  end
end
%=============================================================================
function value = validateAlpha(value)
  if ~isnumeric(value) || ~isscalar(value) || value < 0 || value > 1
    error('Nelson:polarhistogram:invalidFaceAlpha', 'FaceAlpha must be between 0 and 1.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = polarplot(varargin)
  narginchk(1, 10000);
  nargoutchk(0, 1);
  inputArguments = convertStringToCharArgs(varargin);
  [ax, inputArguments] = parsePolarAxes(inputArguments);
  [fig, previousDrawLater] = polarBeginDrawLater(ax);
  try
    ax = preparePolarAxes(ax);
    [inputArguments, propertiesList] = splitLineProperties(inputArguments);
    h = gobjects(0, 1);
    showTableLegend = false;
    while ~isempty(inputArguments)
      lineSpec = '';
      if isPolarTableSyntax(inputArguments)
        [theta, radius, lineSpec, thetaVariables, radiusVariables, sourceTable, consumed] = ...
          parsePolarTableArguments(inputArguments);
        tableHandles = plotThetaRadius(ax, theta, radius, lineSpec, propertiesList);
        setPolarTableMetadata(tableHandles, sourceTable, thetaVariables, radiusVariables);
        showTableLegend = showTableLegend || numel(tableHandles) > 1;
        h = [h; tableHandles];
        inputArguments(1:consumed) = [];
      elseif length(inputArguments) == 1
        h = [h; plotRadiusOrComplex(ax, inputArguments{1}, lineSpec, propertiesList)];
        inputArguments(1) = [];
      else
        if ischar(inputArguments{2})
          [ps, cs, ms, msg] = colstyle(inputArguments{2}, 'plot', false);
        else
          msg = 'Invalid LineSpec string.';
        end
        if ischar(inputArguments{2}) && isempty(msg)
          h = [h; plotRadiusOrComplex(ax, inputArguments{1}, inputArguments{2}, propertiesList)];
          inputArguments(1:2) = [];
        elseif length(inputArguments) >= 3 && ischar(inputArguments{3})
          [ps, cs, ms, msg] = colstyle(inputArguments{3}, 'plot', false);
          if isempty(msg)
            lineSpec = inputArguments{3};
            h = [h; plotThetaRadius(ax, inputArguments{1}, inputArguments{2}, lineSpec, propertiesList)];
            inputArguments(1:3) = [];
          else
            h = [h; plotThetaRadius(ax, inputArguments{1}, inputArguments{2}, lineSpec, propertiesList)];
            inputArguments(1:2) = [];
          end
        else
          h = [h; plotThetaRadius(ax, inputArguments{1}, inputArguments{2}, lineSpec, propertiesList)];
          inputArguments(1:2) = [];
        end
      end
    end
    state = polarGetState(ax, false);
    state.DataHandles = [state.DataHandles; h(:)];
    polarSetState(ax, state);
    polarRefresh(ax, state, false);
    if showTableLegend
      legend(ax);
    end
    polarEndDrawLater(fig, previousDrawLater);
  catch exception
    polarEndDrawLater(fig, previousDrawLater);
    error(exception.message);
  end
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [ax, args] = parsePolarAxes(args)
  if ~isempty(args) && isscalar(args{1}) && (isgraphics(args{1}, 'axes') || isgraphics(args{1}, 'polaraxes'))
    ax = args{1};
    args(1) = [];
    return
  end
  gr = groot();
  if ~isempty(gr.CurrentFigure)
    ax = gca();
    return
  end
  ax = polaraxes();
end
%=============================================================================
function ax = preparePolarAxes(ax)
  if ~polarIsAxes(ax)
    ax = polarInitializeAxes(ax, false);
  end
  nextPlot = ax.NextPlot;
  state = polarGetState(ax, false);
  if ~strcmp(nextPlot, 'add') && isempty(state.DataHandles) ...
      && numel(allchild(ax)) == numel(state.GridHandles)
    return
  end
  newplot(ax);
  ax = polarInitializeAxes(ax, false);
  if ~strcmp(nextPlot, 'add')
    state = polarGetState(ax, false);
    state.GridHandles = gobjects(0, 1);
    state.DataHandles = gobjects(0, 1);
    polarSetState(ax, state);
  end
end
%=============================================================================
function [args, propertiesList] = splitLineProperties(args)
  nbInputArguments = length(args);
  propertyIndex = 0;
  if nbInputArguments > 2
    propertyIndex = nbInputArguments - 1;
    keepGoing = true;
    while propertyIndex >= 1 && keepGoing
      keepGoing = ischar(args{propertyIndex}) && isValidGraphicsProperty('line', args{propertyIndex});
      if keepGoing
        propertyIndex = propertyIndex - 2;
      end
    end
    propertyIndex = propertyIndex + 2;
  end
  propertiesList = {};
  if propertyIndex > 0 && propertyIndex < nbInputArguments
    propertiesList = args(propertyIndex:end);
    args(propertyIndex:end) = [];
  end
end
%=============================================================================
function handles = plotRadiusOrComplex(ax, values, lineSpec, propertiesList)
  if ~isnumeric(values)
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Value');
  end
  if isreal(values)
    radius = values;
    theta = defaultThetaForRadius(radius);
  else
    theta = angle(values);
    radius = abs(values);
  end
  handles = plotThetaRadius(ax, theta, radius, lineSpec, propertiesList);
end
%=============================================================================
function theta = defaultThetaForRadius(radius)
  if isvector(radius)
    n = numel(radius);
    if n <= 1
      theta = zeros(size(radius));
    else
      theta = linspace(0, 2 * pi, n);
      if size(radius, 2) == 1
        theta = theta';
      end
    end
  else
    n = size(radius, 1);
    theta = linspace(0, 2 * pi, n)';
  end
end
%=============================================================================
function handles = plotThetaRadius(ax, theta, radius, lineSpec, propertiesList)
  if ~(isnumeric(theta) && isnumeric(radius))
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Value');
  end
  [theta, radius] = matchPolarMatrices(theta, radius);
  if isvector(theta)
    theta = theta(:);
  end
  if isvector(radius)
    radius = radius(:);
  end
  handles = gobjects(0, 1);
  for k = 1:size(radius, 2)
    handles(end + 1, 1) = createPolarLine(ax, theta(:, k), radius(:, k), lineSpec, propertiesList);
  end
end
%=============================================================================
function h = createPolarLine(ax, theta, radius, lineSpec, propertiesList)
  lineProperties = propertiesFromLineSpec(lineSpec, propertiesList);
  color = getColorAndUpdateIndex(ax);
  lineStyle = getLineStyleAndUpdateIndex(ax);
  if ~any(strcmp(lineProperties, 'LineStyle'))
    lineProperties = [lineProperties, {'LineStyle', lineStyle}];
  end
  if ~any(strcmp(lineProperties, 'Visible'))
    lineProperties = [lineProperties, {'Visible', 'on'}];
  end
  h = __line__('Parent', ax, 'XData', [], 'YData', [], ...
    'ThetaData', theta, 'RData', radius, 'Color', color, ...
    lineProperties{:});
end
%=============================================================================
function properties = propertiesFromLineSpec(lineSpec, propertiesList)
  if isempty(lineSpec)
    properties = propertiesList;
    return
  end
  [ps, cs, ms, msg] = colstyle(lineSpec, 'plot', false);
  if ~isempty(msg)
    error('Nelson:polarplot:invalidLineSpec', msg);
  end
  if isempty(ps)
    ps = 'none';
  end
  if strcmp(cs, '')
    properties = {'Marker', ms, 'LineStyle', ps, propertiesList{:}};
  else
    properties = {'Color', cs, 'Marker', ms, 'LineStyle', ps, propertiesList{:}};
  end
end
%=============================================================================
function tf = isPolarTableSyntax(args)
  tf = length(args) >= 3 && (istable(args{1}) || istimetable(args{1})) ...
    && isTableVariableSelector(args{2}) && isTableVariableSelector(args{3});
end
%=============================================================================
function tf = isTableVariableSelector(value)
  tf = ischar(value) || iscellstr(value) || isstring(value);
  tf = tf && ~isempty(value);
end
%=============================================================================
function [theta, radius, lineSpec, thetaVariables, radiusVariables, sourceTable, consumed] = ...
    parsePolarTableArguments(args)
  sourceTable = args{1};
  thetaVariables = normalizeTableVariableNames(args{2});
  radiusVariables = normalizeTableVariableNames(args{3});
  theta = tableVariablesData(sourceTable, thetaVariables);
  radius = tableVariablesData(sourceTable, radiusVariables);
  lineSpec = '';
  consumed = 3;
  if length(args) >= 4 && ischar(args{4})
    [ps, cs, ms, msg] = colstyle(args{4}, 'plot', false);
    if isempty(msg)
      lineSpec = args{4};
      consumed = 4;
    end
  end
end
%=============================================================================
function names = normalizeTableVariableNames(names)
  if ischar(names)
    names = {names};
    return
  end
  if isstring(names)
    names = cellstr(names(:)');
    return
  end
  if ~iscellstr(names)
    error('Nelson:graphics:invalidVariableNames', 'Variable names must be character vectors or strings.');
  end
  names = names(:)';
end
%=============================================================================
function values = tableVariablesData(tbl, variableNames)
  values = [];
  for k = 1:length(variableNames)
    value = tableVariableData(tbl, variableNames{k});
    if isvector(value)
      value = value(:);
    end
    if isempty(values)
      values = value;
    elseif size(values, 1) == size(value, 1)
      values = [values, value];
    else
      error('Nelson:graphics:invalidTableVariables', 'Table variables must have compatible row counts.');
    end
  end
end
%=============================================================================
function value = tableVariableData(tbl, variableName)
  validateTableVariableName(variableName, tbl.Properties.VariableNames);
  value = tbl.(variableName);
  if ~(isnumeric(value) || islogical(value))
    error('Nelson:graphics:numericTableVariableExpected', 'Numeric table variable expected.');
  end
  value = double(value);
end
%=============================================================================
function validateTableVariableName(name, variableNames)
  if ~any(strcmp(name, variableNames))
    error('Nelson:graphics:unrecognizedTableVariable', 'Unrecognized table variable.');
  end
end
%=============================================================================
function setPolarTableMetadata(handles, sourceTable, thetaVariables, radiusVariables)
  for k = 1:numel(handles)
    thetaVariable = tableVariableForHandle(thetaVariables, k);
    radiusVariable = tableVariableForHandle(radiusVariables, k);
    if isprop(handles(k), 'SourceTable')
      handles(k).SourceTable = sourceTable;
    end
    if isprop(handles(k), 'ThetaVariable')
      handles(k).ThetaVariable = thetaVariable;
    end
    if isprop(handles(k), 'RVariable')
      handles(k).RVariable = radiusVariable;
    end
    if isprop(handles(k), 'DisplayName') && isempty(handles(k).DisplayName)
      handles(k).DisplayName = radiusVariable;
    end
  end
end
%=============================================================================
function name = tableVariableForHandle(names, index)
  if length(names) == 1
    name = names{1};
  else
    name = names{min(index, length(names))};
  end
end
%=============================================================================
function [a, b] = matchPolarMatrices(a, b)
  if isvector(a) && ~isvector(b)
    if length(a) == size(b, 1)
      a = repmat(a(:), [1, size(b, 2)]);
      return
    elseif length(a) == size(b, 2)
      b = b';
      a = repmat(a(:)', [size(b, 2), 1])';
      return
    else
      error('Nelson:dimagree:dimensionsDoNotMatch', 'Dimensions do not match.');
    end
  end
  if ~isvector(a) && isvector(b)
    if length(b) == size(a, 1)
      b = repmat(b(:), [1, size(a, 2)]);
    elseif length(b) == size(a, 2)
      a = a';
      b = repmat(b(:)', [size(a, 2), 1])';
    else
      error('Nelson:dimagree:dimensionsDoNotMatch', 'Dimensions do not match.');
    end
  end
  if ~isequal(size(a), size(b))
    error('Nelson:dimagree:dimensionsDoNotMatch', 'Dimensions do not match.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = polarscatter(varargin)
  narginchk(2, 1000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  if ~isempty(args) && ~(istable(args{1}) || istimetable(args{1})) ...
      && isscalar(args{1}) && isgraphics(args{1}, 'axes') && ~isgraphics(args{1}, 'polaraxes')
    error('Nelson:graphics:invalidParentInput', 'Parent input must be a polaraxes object.');
  end
  [ax, args] = polarParseTargetAxes(args);
  if ~isempty(args) && (istable(args{1}) || istimetable(args{1}))
    [theta, radius, args, tableArgs] = parseTableScatterData(args);
  else
    tableArgs = {};
    [theta, radius, args] = parseNumericScatterData(args);
  end
  [opts, chartProps, rendererProps] = parsePolarScatterOptions(args);
  [orientation, nSeries] = getSeriesOrientation(theta, radius);
  if nSeries > 1
    h = createPolarScatterSeries(ax, theta, radius, orientation, nSeries, opts, chartProps, tableArgs);
    if nargout == 1
      varargout{1} = h;
    end
    return
  end
  theta = graphicsSelectSeriesData(theta, orientation, 1, 'column');
  radius = graphicsSelectSeriesData(radius, orientation, 1, 'column');
  chartProps = [chartProps, graphicsSelectTableSeriesArgs(tableArgs, 1, nSeries)];
  [fig, previousDrawLater] = polarBeginDrawLater(ax);
  try
    ax = polarPrepareDataAxes(ax);
    if isempty(opts.Color)
      opts.Color = getColorAndUpdateIndex(ax);
    end
    renderer = createPolarMarkerLine(ax, theta, radius, opts, rendererProps);
    h = createPolarScatterObject(ax, theta, radius, opts, chartProps);
    state = h.UserData;
    state.ChartType = 'polarscatter';
    state.Renderer = renderer;
    h.UserData = state;
    polarAppendDataHandles(ax, renderer);
    polarEndDrawLater(fig, previousDrawLater);
  catch exception
    polarEndDrawLater(fig, previousDrawLater);
    error(exception.message);
  end
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [theta, radius, args] = parseNumericScatterData(args)
  if numel(args) < 2 || ~isnumeric(args{1}) || ~isnumeric(args{2})
    error('Nelson:polarscatter:numericThetaAndExpected', 'Numeric theta and radius data expected.');
  end
  theta = double(args{1});
  radius = double(args{2});
  if numel(theta) ~= numel(radius)
    error('Nelson:dimagree:valueValueNumberElements', '%s and %s must have the same number of elements.', 'Theta', 'radius');
  end
  theta = theta(:);
  radius = radius(:);
  args = args(3:end);
end
%=============================================================================
function [opts, chartProps, rendererProps] = parsePolarScatterOptions(args)
  opts = struct('SizeData', 36, 'Color', [], 'Marker', 'o', 'Filled', false);
  if ~isempty(args) && isnumeric(args{1})
    opts.SizeData = args{1};
    args = args(2:end);
  end
  if ~isempty(args) && (isnumeric(args{1}) || isColorText(args{1}))
    opts.Color = args{1};
    args = args(2:end);
  end
  [args, opts.Filled] = extractFilled(args);
  [args, markerFound, marker] = extractMarker(args);
  if markerFound
    opts.Marker = marker;
  end
  [chartProps, rendererProps] = parseNameValues(args);
end
%=============================================================================
function h = createPolarScatterSeries(ax, theta, radius, orientation, nSeries, opts, chartProps, tableArgs)
  handles = cell(1, nSeries);
  for k = 1:nSeries
    tk = graphicsSelectSeriesData(theta, orientation, k, 'column');
    rk = graphicsSelectSeriesData(radius, orientation, k, 'column');
    args = [chartProps, graphicsSelectTableSeriesArgs(tableArgs, k, nSeries)];
    handles{k} = createPolarScatterObject(ax, tk, rk, opts, args);
  end
  h = [handles{:}];
end
%=============================================================================
function h = createPolarMarkerLine(ax, theta, radius, opts, lineProps)
  color = opts.Color;
  if ischar(color) || isStringScalar(color)
    color = validatecolor(color);
  end
  % Per-point colour data (a vector of scalars, or an Nx3 matrix) maps through
  % the colormap to one colour per marker, exactly like a numeric C in scatter.
  color = resolvePolarPointColors(ax, color, numel(theta));
  markerSizes = markerSizeFromSizeData(opts.SizeData, numel(theta));
  perPointColor = isnumeric(color) && ismatrix(color) && size(color, 2) == 3 ...
    && size(color, 1) == numel(theta) && numel(theta) > 1;
  if isscalar(markerSizes) && ~perPointColor
    properties = {'LineStyle', 'none', 'Marker', opts.Marker, ...
      'MarkerSize', markerSizes, 'Color', color, 'MarkerEdgeColor', color};
    if opts.Filled
      properties = [properties, {'MarkerFaceColor', color, 'MarkerEdgeColor', 'none'}];
    end
    h = __line__('Parent', ax, 'XData', [], 'YData', [], ...
      'ThetaData', theta, 'RData', radius, properties{:}, lineProps{:});
  else
    h = [];
    theta = theta(:);
    radius = radius(:);
    if isscalar(markerSizes)
      markerSizes = repmat(markerSizes, 1, numel(theta));
    end
    for k = 1:numel(theta)
      pointColor = colorAtPoint(color, k);
      properties = {'LineStyle', 'none', 'Marker', opts.Marker, ...
        'MarkerSize', markerSizes(k), 'Color', pointColor, 'MarkerEdgeColor', pointColor};
      if opts.Filled
        properties = [properties, {'MarkerFaceColor', pointColor, 'MarkerEdgeColor', 'none'}];
      end
      h = [h, __line__('Parent', ax, 'XData', [], 'YData', [], ...
        'ThetaData', theta(k), 'RData', radius(k), properties{:}, lineProps{:})];
    end
  end
  state = struct('ChartType', 'polarscatter', 'SizeData', opts.SizeData);
  for k = 1:numel(h)
    h(k).UserData = state;
  end
end
%=============================================================================
function h = createPolarScatterObject(ax, theta, radius, opts, chartProps)
  color = opts.Color;
  if ischar(color) || isStringScalar(color)
    color = validatecolor(color);
  end
  properties = {'Parent', ax, 'XData', [], 'YData', [], ...
    'ThetaData', theta, 'RData', radius, 'SizeData', opts.SizeData, ...
    'CData', color, 'Marker', opts.Marker};
  if opts.Filled
    properties = [properties, {'MarkerFaceColor', 'flat', 'MarkerEdgeColor', 'none'}];
  end
  h = __scatter__(properties{:}, chartProps{:});
  state = struct('ChartType', 'polarscatter', 'SizeData', opts.SizeData);
  h.UserData = state;
end
%=============================================================================
function markerSize = markerSizeFromSizeData(sizeData, n)
  if isempty(sizeData)
    sizeData = 36;
  end
  if ~isnumeric(sizeData) || any(sizeData(:) <= 0)
    error('Nelson:validators:mustBePositive', '%s must be positive.', 'Size data');
  end
  markerSize = sqrt(double(sizeData(:).'));
  if isscalar(markerSize)
    return
  end
  if numel(markerSize) ~= n
    markerSize = markerSize(1);
  end
end
%=============================================================================
function rgb = resolvePolarPointColors(ax, color, n)
  rgb = color;
  if isempty(color) || ischar(color) || isStringScalar(color) || ~isnumeric(color)
    return
  end
  if ismatrix(color) && size(color, 2) == 3 && size(color, 1) == n
    return
  end
  if isvector(color) && numel(color) == n && n > 1
    cd = double(color(:));
    cmap = polarColormap(ax);
    lo = min(cd);
    hi = max(cd);
    if ~(hi > lo)
      hi = lo + 1;
    end
    m = size(cmap, 1);
    idx = round((cd - lo) / (hi - lo) * (m - 1)) + 1;
    idx = min(max(idx, 1), m);
    rgb = cmap(idx, :);
  end
end
function cmap = polarColormap(ax)
  cmap = parula(256);
  fig = ancestor(ax, 'figure');
  if ~isempty(fig)
    try
      cmap = get(fig, 'Colormap');
    catch
    end
  end
  if isempty(cmap) || size(cmap, 2) ~= 3
    cmap = parula(256);
  end
end
function color = colorAtPoint(colorData, k)
  color = colorData;
  if isnumeric(colorData) && ismatrix(colorData) && size(colorData, 2) == 3 ...
      && size(colorData, 1) >= k
    color = colorData(k, :);
  end
end
%=============================================================================
function tf = isColorText(value)
  tf = (ischar(value) || isStringScalar(value)) ...
    && (any(strcmpi(char(value), getColorShortNameList())) || any(strcmpi(char(value), getColorNameList())));
end
%=============================================================================
function [args, found] = extractFilled(args)
  found = false;
  for k = numel(args):-1:1
    if (ischar(args{k}) || isStringScalar(args{k})) && strcmpi(char(args{k}), 'filled')
      found = true;
      args(k) = [];
    end
  end
end
%=============================================================================
function [args, found, marker] = extractMarker(args)
  found = false;
  marker = 'o';
  markers = getMarkerNameList();
  for k = numel(args):-1:1
    if (ischar(args{k}) || isStringScalar(args{k})) && any(strcmpi(char(args{k}), markers))
      found = true;
      marker = char(args{k});
      args(k) = [];
      if k > 1 && (ischar(args{k - 1}) || isStringScalar(args{k - 1})) && strcmpi(char(args{k - 1}), 'Marker')
        args(k - 1) = [];
      end
      return
    end
  end
end
%=============================================================================
function [chartProps, rendererProps] = parseNameValues(args)
  if rem(length(args), 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  chartProps = {};
  rendererProps = {};
  for k = 1:2:length(args)
    name = char(args{k});
    value = args{k + 1};
    switch lower(name)
      case 'marker'
        chartProps = [chartProps, {'Marker', char(value)}];
        rendererProps = [rendererProps, {'Marker', char(value)}];
      case 'markeredgecolor'
        chartProps = [chartProps, {'MarkerEdgeColor', value}];
        rendererProps = [rendererProps, {'MarkerEdgeColor', value}];
      case 'markerfacecolor'
        chartProps = [chartProps, {'MarkerFaceColor', value}];
        rendererProps = [rendererProps, {'MarkerFaceColor', value}];
      case 'markeredgealpha'
        chartProps = [chartProps, {'MarkerEdgeAlpha', value}];
      case 'markerfacealpha'
        chartProps = [chartProps, {'MarkerFaceAlpha', value}];
      case 'linewidth'
        chartProps = [chartProps, {'LineWidth', value}];
        rendererProps = [rendererProps, {'LineWidth', value}];
      case {'displayname', 'visible', 'tag', 'userdata', 'handlevisibility'}
        chartProps = [chartProps, {name, value}];
      case 'sourcetable'
        chartProps = [chartProps, {'SourceTable', value}];
      case 'thetavariable'
        chartProps = [chartProps, {'ThetaVariable', value}];
      case 'rvariable'
        chartProps = [chartProps, {'RVariable', value}];
      otherwise
        error('Nelson:graphics:unsupportedProperty', 'Unsupported "%s" option.', 'polarscatter');
    end
  end
end
%=============================================================================
function [theta, radius, args, tableArgs] = parseTableScatterData(args)
  tbl = args{1};
  if numel(args) < 3
    error('Nelson:graphics:tableVariableExpected', 'Table variable arguments expected.');
  end
  thetaNames = graphicsTableVariableNames(tbl, args{2});
  radiusNames = graphicsTableVariableNames(tbl, args{3});
  args = args(4:end);
  nSeries = max(numel(thetaNames), numel(radiusNames));
  validateTableVariableCounts(thetaNames, radiusNames, nSeries);
  [theta, radius, tableArgs] = tableScatterSeries(tbl, thetaNames, radiusNames, nSeries);
end
%=============================================================================
function validateTableVariableCounts(thetaNames, radiusNames, nSeries)
  counts = [numel(thetaNames), numel(radiusNames)];
  if any(counts ~= 1 & counts ~= nSeries)
    error('Nelson:dimagree:tableVariableCountsMatch', 'Table variable counts must match.');
  end
end
%=============================================================================
function [theta, radius, tableArgs] = tableScatterSeries(tbl, thetaNames, radiusNames, nSeries)
  theta = [];
  radius = [];
  tableArgs = cell(1, nSeries);
  for k = 1:nSeries
    thetaName = graphicsSelectName(thetaNames, k);
    radiusName = graphicsSelectName(radiusNames, k);
    theta = graphicsAppendColumn(theta, graphicsNumericColumn(tbl.(thetaName), thetaName));
    radius = graphicsAppendColumn(radius, graphicsNumericColumn(tbl.(radiusName), radiusName));
    oneArgs = {'SourceTable', tbl, 'ThetaVariable', thetaName, 'RVariable', radiusName};
    if nSeries > 1
      oneArgs(end + 1:end + 2) = {'DisplayName', radiusName};
    end
    tableArgs{k} = oneArgs;
  end
end
%=============================================================================
function [orientation, nSeries] = getSeriesOrientation(theta, radius)
  if isvector(theta) && isvector(radius)
    orientation = 'single';
    nSeries = 1;
    return
  end
  if isvector(theta) && ~isvector(radius)
    if numel(theta) == size(radius, 1)
      orientation = 'columns';
      nSeries = size(radius, 2);
      return
    end
  end
  if ~isvector(theta) && isvector(radius)
    if numel(radius) == size(theta, 1)
      orientation = 'columns';
      nSeries = size(theta, 2);
      return
    end
  end
  if isequal(size(theta), size(radius))
    orientation = 'columns';
    nSeries = size(theta, 2);
    return
  end
  error('Nelson:dimagree:valueValueNumberElements', '%s and %s must have the same number of elements.', 'Theta', 'radius');
end
