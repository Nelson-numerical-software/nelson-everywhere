%=============================================================================
function varargout = hggroup(varargin)
  narginchk(0, 1000);
  nargoutchk(0, 1);
  inputArguments = convertStringToCharArgs(varargin);

  if (length(inputArguments) > 0)
    if isgraphics(inputArguments{1})
      if (isgraphics(inputArguments{1}, 'axes') || isgraphics(inputArguments{1}, 'hggroup'))
        ax = inputArguments{1};
        inputArguments = inputArguments(2:end);
      else
        error('Nelson:hggroup:groupCanBeOnly', 'Group can be only a child of axes or hggroup.');
      end
    else
      ax = gca();
    end
  else
    ax = gca();
  end

  inputAsStruct = struct(inputArguments{:});
  if isfield(inputAsStruct, 'Parent')
    ax = inputAsStruct.Parent;
    rmfield(inputAsStruct, 'Parent');
  end
  inputArguments = reshape([fieldnames(inputAsStruct)'; struct2cell(inputAsStruct)'], 1, []);

  h = __hggroup__('Parent', ax, inputArguments{:});

  if nargout > 0
    varargout{1} = h;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = hist(varargin)

  narginchk(1, 100);
  nargoutchk(0, 2);

  inputArguments = convertStringToCharArgs(varargin);
  % The designated target is taken out of the argument list whatever nargout is:
  % asked for its counts hist draws nothing, but the axes still has to be moved
  % out of the way of the data arguments.
  [parent, inputArguments] = graphicsParseParent(inputArguments);
  if isempty(parent)
    [parent, inputArguments] = graphicsExtractParentProperty(inputArguments);
  end
  if isempty(inputArguments)
    error('Nelson:notEnoughInputs', 'Not enough input arguments.');
  end
  if (nargout == 0)
    parent = newplotTarget(parent);
  end

  y = inputArguments{1};
  inputArguments = inputArguments(2:end);
  nbInputArguments = length(inputArguments);

  % A matrix is a set of samples, one per column, and each column is counted on
  % its own: only the trailing dimensions are folded onto columns. A vector is a
  % single sample whichever way round it is written.
  asVector = isvector(y);
  if asVector
    y = y(:);
  else
    y = y(:, :);
  end
  if isequal(size(y), [0 0])
    % [] is read as a single sample holding nothing: it answers one column of
    % zero counts.
    y = zeros(0, 1);
  end

  if ~isreal(y)
    y = real(y);
  end
  % The counting reads the values, not what the sample's type is able to hold:
  % laying the bins out on an integer sample would otherwise saturate.
  y = double(y);
  % The bins are read on the whole sample: every column is counted against the
  % same bins.
  max_val = max(y(:));
  min_val = min(y(:));

  % The centres are handed back the way they were given, and the ones built here
  % count as a row. A matrix sample hands them back transposed.
  centersGivenAsRow = true;
  if (nbInputArguments == 0)
    n = 10;
    x = binCentres(min_val, max_val, n);
  else
    x = inputArguments{1};
    inputArguments = inputArguments(2:end);
    % The bins have to be given before anything can be said about how the bars
    % look: a style standing here is refused rather than read as a bin
    % specification. A single character passes isscalar() and would count as a
    % number of bins, a longer one passes isreal() and would count as bin
    % centres sitting at the codes of its characters.
    if ~(isnumeric(x) || islogical(x))
      error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Second argument');
    end
    if (isscalar(x))
      n = x;
      if (n <= 0)
        error('Nelson:validators:mustBePositive', '%s must be positive.', 'Second argument');
      end
      x = binCentres(min_val, max_val, n);
    elseif (isreal(x))
      if (isvector(x))
        centersGivenAsRow = isrow(x);
        x = x(:);
      end
      x = sort(x);
    else
      error('Nelson:hist:secondArgumentNotScalarVector', 'Second argument must be a scalar or vector.');
    end
  end

  x = double(x);
  freq = computesFreq(x, y);

  % Whatever trails the bin specification counts for nothing, and must not be
  % forwarded either: bar has no positional left for it and would reject the
  % whole call. Only the arguments sitting before the first property name are
  % dropped, so a numeric standing there as the value of a pair is kept.
  while (~isempty(inputArguments) && ~ischar(inputArguments{1}))
    inputArguments = inputArguments(2:end);
  end

  if nargout == 0
    if (size(freq, 2) == 1)
      width = 1;
    else
      width = 0.8;
    end
    h = bar(parent, x, freq, width, inputArguments{:});
  end

  if nargout > 0
    if ~asVector
      varargout{1} = freq;
    else
      varargout{1} = freq';
    end
  end

  if nargout > 1
    % x is held as a column whatever was given: hand it back the way it came in
    % for a vector sample, and the other way round for a matrix one.
    if (isvector(x) && (centersGivenAsRow == asVector))
      varargout{2} = x';
    else
      varargout{2} = x;
    end
  end
end
%=============================================================================
function freq = computesFreq(x, y)
  cutout = (x(1:end - 1, :) + x(2:end, :)) / 2;
  % A sample sitting exactly on a cut point belongs to the bin below it. The
  % sort below is free to hand back such a tie either way round, so the cut
  % points are pushed just above the values they must still hold instead of
  % relying on the order the sort picks.
  cutout = cutout + (abs(cutout) + realmin) * eps;
  n = size(x, 1);
  offset = 30;
  withLoopOnN = (n < offset && size(x, 2) == 1);
  if ~withLoopOnN
    if (size(cutout, 2) == 1 && size(y, 2) > 1)
      % A single set of bins shared by every column: the sort below reads the
      % cut points alongside each column of the sample.
      cutout = repmat(cutout, 1, size(y, 2));
    end
    [s, idx] = sort([y; cutout], 1);
    lenY = size(y, 1);
    histValues = cumsum(idx <= lenY);
    x1 = zeros(1, size(y, 2));
    x2 = reshape(histValues(idx > lenY), size(cutout));
    x3 = histValues(end, :) - sum(isnan(y), 1);
    histValues = [x1; x2; x3];
  else
    histValues = zeros(n + 1, size(y, 2));
    for i = 1:n - 1
      histValues(i + 1, :) = sum(y <= cutout(i), 1);
    end
    histValues(n + 1, :) = sum(~isnan(y), 1);
  end
  freq = diff(histValues);
end
%=============================================================================
function x = binCentres(min_val, max_val, n)
  % A sample with no spread at all still has to be given somewhere to sit: lay
  % the bins one unit wide around the value so that it lands in the middle one
  % rather than collapsing every centre onto it. A sample with nothing in it is
  % counted against the unit range, so that it answers zero counts instead of
  % failing. An all-NaN sample keeps its NaN bins: the comparison below is false
  % for NaN, so it falls through to the plain range.
  if (isempty(min_val))
    min_val = 0;
    max_val = 1;
  elseif (min_val == max_val)
    min_val = min_val - floor(n / 2) - 0.5;
    max_val = max_val + ceil(n / 2) - 0.5;
  end
  x = [0.5:n]' / n;
  x = x * (max_val - min_val) + ones(size(x)) * min_val;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = histogram(varargin)
  narginchk(1, 1000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [parent, args] = parseParent(args);
  ax = ancestor(parent, 'axes');
  nextPlot = '';
  if ~isempty(ax) && isscalar(ax) && isgraphics(ax, 'axes')
    nextPlot = ax.NextPlot;
  end
  [constructorArgs, categoricalInfo] = parseHistogramArguments(parent, args);
  h = __histogram__(constructorArgs{:});
  if ~isempty(categoricalInfo)
    applyCategoricalAxes(parent, h, categoricalInfo);
  end
  applyStairsEdgeColor(ax, h, args);
  if ~isempty(ax) && any(strcmp(nextPlot, {'replace', 'replaceall'}))
    ax.Box = 'on';
  end
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [parent, args] = parseParent(args)
  parent = [];
  if ~isempty(args) && isscalar(args{1}) && (isgraphics(args{1}, 'axes') || isgraphics(args{1}, 'hggroup'))
    parent = newplotTarget(args{1}(1));
    args = args(2:end);
  else
    parent = newplotTarget(graphicsParentProperty(args));
  end
end
%=============================================================================
function [constructorArgs, categoricalInfo] = parseHistogramArguments(parent, args)
  constructorArgs = {};
  categoricalInfo = [];
  if ~isempty(parent)
    constructorArgs = {'Parent', parent};
  end
  if isempty(args)
    error('Nelson:graphics:dataExpected', 'Data expected.');
  end
  if isPropertyName(args{1})
    dataConsumed = false;
  elseif iscategorical(args{1})
    [constructorArgs, categoricalInfo, args] = parseCategoricalHistogram(constructorArgs, args);
    dataConsumed = true;
  else
    constructorArgs = [constructorArgs, {'Data', args{1}}];
    args = args(2:end);
    dataConsumed = true;
  end
  if dataConsumed && isempty(categoricalInfo) && ~isempty(args) && isnumeric(args{1})
    binArgument = args{1};
    args = args(2:end);
    if isscalar(binArgument)
      constructorArgs = [constructorArgs, {'NumBins', binArgument}];
    else
      constructorArgs = [constructorArgs, {'BinEdges', binArgument}];
    end
  end
  if mod(length(args), 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  constructorArgs = [constructorArgs, args];
end
%=============================================================================
function [constructorArgs, info, args] = parseCategoricalHistogram(constructorArgs, args)
  X = args{1};
  args = args(2:end);
  allCategories = categories(X);
  allCategories = allCategories(:).';
  allCounts = countcats(X);
  allCounts = allCounts(:).';
  if ~isempty(args) && ~isPropertyName(args{1}) && ...
    (iscellstr(args{1}) || isstring(args{1}) || iscategorical(args{1}))
    if iscategorical(args{1})
      cats = categories(args{1});
    else
      cats = cellstr(args{1});
    end
    cats = cats(:).';
    counts = zeros(1, numel(cats));
    for k = 1:numel(cats)
      idx = find(strcmp(allCategories, cats{k}), 1);
      if ~isempty(idx)
        counts(k) = allCounts(idx);
      end
    end
    args = args(2:end);
  else
    cats = allCategories;
    counts = allCounts;
  end
  n = numel(cats);
  edges = 0.5:1:(n + 0.5);
  constructorArgs = [constructorArgs, {'Categories', cats, ...
    'BinCounts', counts, 'BinEdges', edges}];
  info = struct('categories', {cats}, 'n', n);
end
%=============================================================================
function applyCategoricalAxes(parent, h, info)
  if isgraphics(parent, 'axes')
    ax = parent;
  else
    ax = ancestor(h, 'axes');
  end
  if isempty(ax) || ~isgraphics(ax, 'axes')
    return
  end
  ticks = 1:info.n;
  if strcmp(h.Orientation, 'horizontal')
    ax.YTick = ticks;
    ax.YTickLabel = info.categories;
  else
    ax.XTick = ticks;
    ax.XTickLabel = info.categories;
  end
end
%=============================================================================
function applyStairsEdgeColor(ax, h, args)
  % In 'stairs' DisplayStyle the histogram draws only its outline. Give that
  % outline the histogram's automatic series color (the same ColorOrder color a
  % bar-style histogram uses for its face) instead of the default edge color,
  % unless the user asked for a specific EdgeColor.
  if isempty(ax) || ~isscalar(ax) || ~isgraphics(ax, 'axes')
    return
  end
  if ~strcmp(h.DisplayStyle, 'stairs')
    return
  end
  if hasArgument(args, 'EdgeColor')
    return
  end
  colorOrder = ax.ColorOrder;
  if isempty(colorOrder)
    return
  end
  seriesIndex = 1;
  try
    seriesIndex = round(h.SeriesIndex);
  catch
  end
  nbColors = size(colorOrder, 1);
  colorIndex = mod(seriesIndex - 1, nbColors) + 1;
  h.EdgeColor = colorOrder(colorIndex, :);
end
%=============================================================================
function tf = hasArgument(args, name)
  tf = false;
  for k = 1:numel(args)
    if (ischar(args{k}) || isStringScalar(args{k})) && strcmpi(char(args{k}), name)
      tf = true;
      return
    end
  end
end
%=============================================================================
function tf = isPropertyName(value)
  if ~(ischar(value) || isStringScalar(value))
    tf = false;
    return
  end
  names = {'Data', 'BinCounts', 'NumBins', 'BinEdges', 'BinWidth', ...
    'BinMethod', 'BinLimits', 'Normalization', 'FaceColor', 'EdgeColor', ...
    'LineWidth', 'LineStyle', 'BinCountsMode', 'BinLimitsMode', ...
    'Orientation', 'DisplayStyle', 'FaceAlpha', 'EdgeAlpha', ...
    'DisplayName', 'Visible', 'Tag', 'UserData'};
  tf = any(strcmpi(char(value), names));
end
