% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function e = eomdate(y, m)
  narginchk(2, 2);
  e = datenum(y, m, eomday(y, m));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function d = eomday(y, m)
  narginchk(2, 2);
  nargoutchk(0, 1);
  mustBeNumeric(y, 1);
  mustBeInteger(y, 1);
  mustBeNumeric(m, 2);
  mustBeInteger(m, 2);
  mustBeInRange(m, 1, 12, 2);
  d = datenum(y, m + 1, 1) - datenum(y, m, 1);
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function t = etime(varargin)
  narginchk(2, 2);
  nargoutchk(0, 1);
  t1 = varargin{1};
  t0 = varargin{2};
  allReal = isreal(t0) && isreal(t1);
  if allReal
    t = 86400 * (datenum(t1(:, 1:3)) - datenum(t0(:, 1:3))) + (t1(:, 4:6) - t0(:, 4:6)) * [3600; 60; 1];
  else
    error('Nelson:time:numericInputDataReal', 'Numeric input data must be real.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function e = exceltime(t)
  narginchk(1, 1);
  if ~isa(t, 'datetime')
    error('Nelson:time:datetimeInputExpected', '%s expected.', 'Datetime input');
  end
  dn = datenum(t);
  % Excel serial dates count from 1899-12-30. Excel also incorrectly treats
  % 1900 as a leap year (a phantom 1900-02-29), so dates on or after
  % 1900-03-01 include that extra day and use the 1899-12-30 origin, while
  % earlier dates use 1899-12-31 to skip the non-existent leap day.
  e = dn - datenum(1899, 12, 30);
  before = dn < datenum(1900, 3, 1);
  e(before) = dn(before) - datenum(1899, 12, 31);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [h, m, s] = hms(t)
  narginchk(1, 1);
  nargoutchk(0, 3);
  if isa(t, 'duration')
    total = double(t);
    signValue = sign(total);
    total = abs(total);
    h = floor(total ./ 3600) .* signValue;
    r = total - floor(total ./ 3600) .* 3600;
    m = floor(r ./ 60);
    s = r - m .* 60;
  else
    v = datevec(datenum(t));
    h = reshape(v(:, 4), size(datenum(t)));
    m = reshape(v(:, 5), size(datenum(t)));
    s = reshape(v(:, 6), size(datenum(t)));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = hour(varargin)
  % Extracts the hour component from a given date/time input.
  %
  % Usage:
  %   h = hour(d)
  %   h = hour(d, formatDate)
  %
  % Input:
  %   d - Date/time input (can be a string, char, or numeric).
  %   formatDate - format date (can be a string, char).
  %
  % Output:
  %   h - Hour component of the input date/time.

  narginchk(1, 2);
  nargoutchk(0, 1); % Ensure at most one output argument.

  d = varargin{1};
  if isa(d, 'datetime')
    varargout{1} = d.Hour;
    return
  end
  if isa(d, 'duration')
    [h, ~, ~] = hms(d);
    varargout{1} = h;
    return
  end
  d = convertStringsToChars(d); % Convert strings to char for consistency.

  formatDate = '';
  if nargin == 2
    formatDate = convertStringsToChars(varargin{2});
  end

  % Validate input type
  if ~(ischar(d) || isstring(d) || isnumeric(d) || iscell(d))
    error('Nelson:time:invalidDateTimeFormatInput', 'Invalid date/time format. Input must be a string, char, or numeric.');
  end
  % Convert char inputs to numeric using datenum
  if ~isnumeric(d)
    d = datenum(d, formatDate);
  end

  % Convert numeric or parsed inputs to date vector
  c = datevec(d(:));

  % Extract hour component
  h = c(:, 4);

  if ~ischar(d)
    h = reshape(h, size(d)); % Reshape to match the input size if numeric.
  end

  varargout{1} = h; % Assign output
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
