%=============================================================================
function t = date()
  currentClock = clock();
  monthNames = {'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', ...
                'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'};
  dayText = sprintf('%02.0f', currentClock(3));
  yearText = sprintf('%.0f', currentClock(1));
  t = [dayText '-' monthNames{currentClock(2)} '-' yearText];
end
