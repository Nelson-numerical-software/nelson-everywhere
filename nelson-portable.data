% LICENCE_BLOCK_END
%=============================================================================
function varargout = dsort(varargin)
  narginchk(1, 1);
  nargoutchk(0, 2);
  p = varargin{1};
  p = p(:);
  [result, index] = sort(p, 'descend');
  varargout{1} = p(index);
  if (nargout == 2)
    varargout{2} = index;
  end
end
