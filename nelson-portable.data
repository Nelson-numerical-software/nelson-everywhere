%=============================================================================
function varargout = probplot(varargin)
  narginchk(1, 5);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [parent, args] = parseParentLocal(args);
  [dist, y, cens, freq, showRef] = parseInputsLocal(args);
  data = prepareDataLocal(y, cens, freq, dist);
  curves = computeCurvesLocal(data, dist, showRef);
  h = drawCurvesLocal(parent, curves, dist, showRef);
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [parent, args] = parseParentLocal(args)
  parent = [];
  if ~isempty(args) && isscalar(args{1}) && (isgraphics(args{1}, 'axes') || isgraphics(args{1}, 'hggroup'))
    parent = args{1};
    args = args(2:end);
  end
end
%=============================================================================
function [dist, y, cens, freq, showRef] = parseInputsLocal(args)
  if isempty(args)
    error('Nelson:notEnoughInputs', 'Not enough input arguments.');
  end
  showRef = true;
  if ischar(args{end}) || isStringScalarLocal(args{end})
    text = lower(char(args{end}));
    if strcmp(text, 'noref')
      showRef = false;
      args(end) = [];
    end
  end
  dist = 'normal';
  if ~isempty(args) && (ischar(args{1}) || isStringScalarLocal(args{1}))
    dist = normalizeDistributionLocal(args{1});
    args = args(2:end);
  end
  if isempty(args)
    error('Nelson:notEnoughInputs', 'Not enough input arguments.');
  end
  if length(args) > 3
    error('Nelson:tooManyInputs', 'Too many input arguments.');
  end
  y = validateDataLocal(args{1});
  cens = [];
  freq = [];
  if length(args) >= 2
    cens = validateSideVectorLocal(args{2}, y, 'Censoring');
  end
  if length(args) >= 3
    freq = validateSideVectorLocal(args{3}, y, 'Frequency');
  end
end
%=============================================================================
function tf = isStringScalarLocal(value)
  tf = isstring(value) && isscalar(value);
end
%=============================================================================
function dist = normalizeDistributionLocal(value)
  text = strtrim(lower(char(value)));
  text = strrep(text, '-', ' ');
  while contains(text, '  ')
    text = strrep(text, '  ', ' ');
  end
  if any(strcmp(text, {'normal', 'norm'}))
    dist = 'normal';
  elseif any(strcmp(text, {'exponential', 'exp'}))
    dist = 'exponential';
  elseif any(strcmp(text, {'extreme value', 'ev'}))
    dist = 'extreme value';
  elseif any(strcmp(text, {'half normal', 'halfnormal'}))
    dist = 'half normal';
  elseif any(strcmp(text, {'lognormal', 'log normal'}))
    dist = 'lognormal';
  elseif strcmp(text, 'logistic')
    dist = 'logistic';
  elseif any(strcmp(text, {'loglogistic', 'log logistic'}))
    dist = 'loglogistic';
  elseif strcmp(text, 'rayleigh')
    dist = 'rayleigh';
  elseif strcmp(text, 'weibull')
    dist = 'weibull';
  else
    error('Nelson:statistics:unsupportedDistribution', 'Unsupported %s.', 'distribution');
  end
end
%=============================================================================
function y = validateDataLocal(y)
  if ~(isnumeric(y) && isreal(y) && ~issparse(y) && ~isempty(y))
    error('Nelson:statistics:yRealNumericArray', '%s must be a real numeric array.', 'Y');
  end
  if ndims(y) > 2
    error('Nelson:statistics:yVectorMatrix', '%s must be a vector or matrix.', 'Y');
  end
  y = double(y);
  if isvector(y)
    y = y(:);
  end
end
%=============================================================================
function value = validateSideVectorLocal(value, y, name)
  if isempty(value)
    return
  end
  if ~(isnumeric(value) || islogical(value)) || ~isreal(value)
    error('Nelson:statistics:mustBeRealNumeric', '%s must be a real numeric array.', name);
  end
  value = double(value);
  if ~isequal(size(value), size(y))
    error('Nelson:statistics:mustMatchY', '%s must match Y.', name);
  end
end
%=============================================================================
function data = prepareDataLocal(y, cens, freq, dist)
  data = cell(size(y, 2), 1);
  for k = 1:size(y, 2)
    column = y(:, k);
    keep = isfinite(column);
    if ~isempty(cens)
      ck = cens(:, k);
      keep = keep & isfinite(ck) & (ck == 0);
    end
    column = column(keep);
    if ~isempty(freq)
      fk = freq(:, k);
      fk = fk(keep);
      column = expandByFrequencyLocal(column, fk);
    end
    column = validateRangeLocal(column, dist);
    if isempty(column)
      error('Nelson:statistics:yContainLeastOneValid', 'Y must contain at least one valid observation per column.');
    end
    data{k} = sort(column(:));
  end
end
%=============================================================================
function column = expandByFrequencyLocal(column, freq)
  if any(~isfinite(freq)) || any(freq < 0) || any(floor(freq) ~= freq)
    error('Nelson:statistics:frequencyContainNonnegativeIntegerValues', '%s must contain nonnegative integer values.', 'Frequency');
  end
  expanded = zeros(sum(freq), 1);
  at = 1;
  for k = 1:length(column)
    count = freq(k);
    if count > 0
      expanded(at:(at + count - 1)) = column(k);
      at = at + count;
    end
  end
  column = expanded;
end
%=============================================================================
function column = validateRangeLocal(column, dist)
  if any(strcmp(dist, {'exponential', 'lognormal', 'loglogistic', 'rayleigh', 'weibull'}))
    column = column(column > 0);
  elseif strcmp(dist, 'half normal')
    column = abs(column);
  end
end
%=============================================================================
function curves = computeCurvesLocal(data, dist, showRef)
  curves = cell(numel(data), 1);
  for k = 1:numel(data)
    values = data{k};
    n = length(values);
    p = ((1:n)' - 0.5) / n;
    refX = [];
    refY = [];
    if showRef
      [refX, refY] = referenceLineLocal(values, dist);
    end
    curves{k} = struct('XData', values(:), 'YData', p(:), ...
      'ReferenceX', refX(:), 'ReferenceY', refY(:), 'Distribution', dist);
  end
end
%=============================================================================
function [refX, refY] = referenceLineLocal(values, dist)
  p = [0.25; 0.75];
  if strcmp(dist, 'half normal')
    p = [0; 0.5];
  end
  xQuartiles = quantile(values, p);
  zQuartiles = distributionInvLocal(p, dist);
  dz = zQuartiles(2) - zQuartiles(1);
  if dz == 0 || isnan(dz)
    scale = 1;
  else
    scale = (xQuartiles(2) - xQuartiles(1)) / dz;
  end
  location = xQuartiles(1) - scale * zQuartiles(1);
  refX = linspace(min(values), max(values), 100)';
  refY = distributionCdfLocal((refX - location) / scale, dist);
  refY = min(max(refY, 0), 1);
end
%=============================================================================
function p = distributionCdfLocal(x, dist)
  switch dist
    case 'normal'
      p = normcdf(x, 0, 1);
    case 'exponential'
      p = 1 - exp(-max(x, 0));
    case 'extreme value'
      p = 1 - exp(-exp(x));
    case 'half normal'
      p = 2 * normcdf(max(x, 0), 0, 1) - 1;
    case 'lognormal'
      p = zeros(size(x));
      positive = x > 0;
      p(positive) = normcdf(log(x(positive)), 0, 1);
    case 'logistic'
      p = 1 ./ (1 + exp(-x));
    case 'loglogistic'
      p = zeros(size(x));
      positive = x > 0;
      p(positive) = x(positive) ./ (1 + x(positive));
    case 'rayleigh'
      p = 1 - exp(-0.5 * max(x, 0) .^ 2);
    case 'weibull'
      p = 1 - exp(-max(x, 0));
  end
end
%=============================================================================
function x = distributionInvLocal(p, dist)
  p = min(max(p, realmin), 1 - eps);
  switch dist
    case 'normal'
      x = norminv(p, 0, 1);
    case 'exponential'
      x = -log(1 - p);
    case 'extreme value'
      x = log(-log(1 - p));
    case 'half normal'
      x = norminv((p + 1) / 2, 0, 1);
    case 'lognormal'
      x = exp(norminv(p, 0, 1));
    case 'logistic'
      x = log(p ./ (1 - p));
    case 'loglogistic'
      x = p ./ (1 - p);
    case 'rayleigh'
      x = sqrt(-2 * log(1 - p));
    case 'weibull'
      x = -log(1 - p);
  end
end
%=============================================================================
function h = drawCurvesLocal(parent, curves, dist, showRef)
  if isempty(parent)
    parent = newplot();
  elseif isgraphics(parent, 'axes')
    parent = newplot(parent);
  end
  h = [];
  for k = 1:numel(curves)
    c = curves{k};
    h = [h; line(parent, c.XData, c.YData, 'Marker', '+', 'LineStyle', 'none')];
    if showRef
      h = [h; line(parent, c.ReferenceX, c.ReferenceY, 'LineStyle', '--', 'LineWidth', 1)];
    end
  end
  for k = 1:length(h)
    h(k).UserData = curves{ceil(k / (1 + double(showRef)))};
  end
  labelAxesLocal(parent, dist);
end
%=============================================================================
function labelAxesLocal(parent, dist)
  ax = parent;
  if isgraphics(parent, 'hggroup')
    ax = ancestor(parent, 'axes');
  end
  xlabel(ax, 'Data');
  ylabel(ax, 'Probability');
  title(ax, ['Probability Plot for ', displayNameLocal(dist), ' Distribution']);
  if any(strcmp(dist, {'lognormal', 'loglogistic', 'weibull'}))
    ax.XScale = 'log';
  end
  ax.YLim = [0 1];
end
%=============================================================================
function name = displayNameLocal(dist)
  switch dist
    case 'normal'
      name = 'Normal';
    case 'exponential'
      name = 'Exponential';
    case 'extreme value'
      name = 'Extreme Value';
    case 'half normal'
      name = 'Half Normal';
    case 'lognormal'
      name = 'Lognormal';
    case 'logistic'
      name = 'Logistic';
    case 'loglogistic'
      name = 'Loglogistic';
    case 'rayleigh'
      name = 'Rayleigh';
    case 'weibull'
      name = 'Weibull';
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = qqplot(varargin)
  narginchk(1, 4);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [parent, args] = parseParentLocal(args);
  [x, y, pvec] = parseInputsLocal(args);
  curves = computeCurvesLocal(x, y, pvec);
  h = drawCurvesLocal(parent, curves, isempty(y));
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [parent, args] = parseParentLocal(args)
  parent = [];
  if ~isempty(args) && isscalar(args{1}) && (isgraphics(args{1}, 'axes') || isgraphics(args{1}, 'hggroup'))
    parent = args{1};
    args = args(2:end);
  end
end
%=============================================================================
function [x, y, pvec] = parseInputsLocal(args)
  if isempty(args)
    error('Nelson:notEnoughInputs', 'Not enough input arguments.');
  end
  if length(args) > 3
    error('Nelson:tooManyInputs', 'Too many input arguments.');
  end
  x = validateDataLocal(args{1}, 'X');
  y = [];
  pvec = [];
  if length(args) >= 2
    second = args{2};
    if isnumeric(second) && isreal(second)
      if length(args) == 2 && isProbabilityVectorLocal(second)
        pvec = validatePvecLocal(second);
      else
        y = validateDataLocal(second, 'Y');
      end
    else
      error('Nelson:statistics:yRealNumericArray', '%s must be a real numeric array.', 'Y');
    end
  end
  if length(args) == 3
    pvec = validatePvecLocal(args{3});
  end
  [x, y] = alignColumnsLocal(x, y);
end
%=============================================================================
function tf = isProbabilityVectorLocal(value)
  tf = isvector(value) && ~isempty(value) && all(isfinite(double(value(:)))) ...
    && all(double(value(:)) >= 0) && all(double(value(:)) <= 100);
end
%=============================================================================
function data = validateDataLocal(data, name)
  if ~(isnumeric(data) && isreal(data) && ~issparse(data) && ~isempty(data))
    error('Nelson:statistics:mustBeRealNumeric', '%s must be a real numeric array.', name);
  end
  if ndims(data) > 2
    error('Nelson:statistics:mustBeVectorOrMatrix', '%s must be a vector or matrix.', name);
  end
  data = double(data);
  if isvector(data)
    data = data(:);
  end
end
%=============================================================================
function pvec = validatePvecLocal(pvec)
  if ~(isnumeric(pvec) && isreal(pvec) && isvector(pvec)) || isempty(pvec) ...
      || any(~isfinite(double(pvec(:)))) || any(double(pvec(:)) < 0) ...
      || any(double(pvec(:)) > 100)
    error('Nelson:statistics:pContainValuesBetween0', 'P must contain values between 0 and 100.');
  end
  pvec = double(pvec(:)) / 100;
end
%=============================================================================
function [x, y] = alignColumnsLocal(x, y)
  if isempty(y)
    return
  end
  nx = size(x, 2);
  ny = size(y, 2);
  if nx == ny
    return
  end
  if nx == 1
    x = repmat(x, 1, ny);
  elseif ny == 1
    y = repmat(y, 1, nx);
  else
    error('Nelson:statistics:xYCompatibleNumbersColumns', 'X and Y must have %s.', 'compatible numbers of columns');
  end
end
%=============================================================================
function curves = computeCurvesLocal(x, y, pvec)
  columns = size(x, 2);
  curves = cell(columns, 1);
  for k = 1:columns
    xk = cleanColumnLocal(x(:, k));
    if isempty(y)
      [xq, yq, p] = normalQuantilesLocal(xk, pvec);
      lineStats = quartileLineLocal(norminv([0.25 0.75], 0, 1), quantile(xk, [0.25 0.75]));
    else
      yk = cleanColumnLocal(y(:, k));
      [xq, yq, p] = sampleQuantilesLocal(xk, yk, pvec);
      lineStats = quartileLineLocal(quantile(xk, [0.25 0.75]), quantile(yk, [0.25 0.75]));
    end
    curves{k} = curveStructLocal(xq, yq, p, lineStats);
  end
end
%=============================================================================
function x = cleanColumnLocal(x)
  x = x(isfinite(x));
  if isempty(x)
    error('Nelson:statistics:dataFinitePerColumn', 'Data must contain at least one finite value per column.');
  end
end
%=============================================================================
function [xq, yq, p] = normalQuantilesLocal(x, pvec)
  if isempty(pvec)
    n = length(x);
    p = ((1:n)' - 0.5) / n;
    yq = sort(x);
  else
    p = pvec;
    yq = quantile(x, p);
    yq = yq(:);
  end
  xq = norminv(p, 0, 1);
end
%=============================================================================
function [xq, yq, p] = sampleQuantilesLocal(x, y, pvec)
  if isempty(pvec)
    n = min(length(x), length(y));
    p = ((1:n)' - 0.5) / n;
  else
    p = pvec;
  end
  xq = quantile(x, p);
  yq = quantile(y, p);
  xq = xq(:);
  yq = yq(:);
end
%=============================================================================
function lineStats = quartileLineLocal(xQuartiles, yQuartiles)
  xQuartiles = xQuartiles(:);
  yQuartiles = yQuartiles(:);
  dx = xQuartiles(2) - xQuartiles(1);
  if dx == 0 || isnan(dx)
    slope = 0;
  else
    slope = (yQuartiles(2) - yQuartiles(1)) / dx;
  end
  intercept = yQuartiles(1) - slope * xQuartiles(1);
  lineStats = struct('Slope', slope, 'Intercept', intercept, ...
    'XQuartiles', xQuartiles, 'YQuartiles', yQuartiles);
end
%=============================================================================
function curve = curveStructLocal(xq, yq, p, lineStats)
  finiteX = xq(isfinite(xq));
  if isempty(finiteX)
    referenceX = lineStats.XQuartiles(:).';
  else
    referenceX = [min(finiteX), max(finiteX)];
  end
  referenceY = lineStats.Intercept + lineStats.Slope * referenceX;
  curve = struct('XData', xq(:), 'YData', yq(:), 'P', p(:), ...
    'QuartileX', lineStats.XQuartiles(:), 'QuartileY', lineStats.YQuartiles(:), ...
    'ReferenceX', referenceX(:), 'ReferenceY', referenceY(:), ...
    'Slope', lineStats.Slope, 'Intercept', lineStats.Intercept);
end
%=============================================================================
function h = drawCurvesLocal(parent, curves, useNormalLabels)
  if isempty(parent)
    parent = newplot();
  elseif isgraphics(parent, 'axes')
    parent = newplot(parent);
  end
  h = [];
  for k = 1:numel(curves)
    c = curves{k};
    h = [h; line(parent, c.XData, c.YData, 'Marker', '+', 'LineStyle', 'none')];
    h = [h; line(parent, c.QuartileX, c.QuartileY, 'LineStyle', '-', 'LineWidth', 1)];
    h = [h; line(parent, c.ReferenceX, c.ReferenceY, 'LineStyle', '--', 'LineWidth', 1)];
  end
  for k = 1:length(h)
    h(k).UserData = curves{ceil(k / 3)};
  end
  labelAxesLocal(parent, useNormalLabels);
end
%=============================================================================
function labelAxesLocal(parent, useNormalLabels)
  ax = parent;
  if isgraphics(parent, 'hggroup')
    ax = ancestor(parent, 'axes');
  end
  if useNormalLabels
    xlabel(ax, 'Standard Normal Quantiles');
    ylabel(ax, 'Quantiles of Input Sample');
    title(ax, 'QQ Plot of Sample Data versus Standard Normal');
  else
    xlabel(ax, 'X Quantiles');
    ylabel(ax, 'Y Quantiles');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = randsample(varargin)
  narginchk(2, 4);
  nargoutchk(0, 1);

  population = varargin{1};
  k = positiveInteger(varargin{2}, sprintf(_('%s must be a positive integer scalar.'), 'K'));
  replacement = false;
  weights = [];
  if nargin >= 3
    replacement = logicalScalar(varargin{3}, 'Replacement');
  end
  if nargin == 4
    if ~replacement
      error('Nelson:statistics:weightedSamplingRequiresReplacement', 'Weighted sampling requires replacement.');
    end
    weights = varargin{4};
  end

  values = populationValues(population);
  n = length(values);
  if ~replacement && k > n
    error('Nelson:statistics:kExceedPopulationSizeWithout', 'K must not exceed the population size without replacement.');
  end
  idx = sampleIndices(n, k, replacement, weights);
  y = values(idx);
  y = y(:);
end
%=============================================================================
function values = populationValues(population)
  if isscalar(population) && isnumeric(population)
    n = positiveInteger(population, sprintf(_('%s must be a positive integer scalar.'), 'N'));
    values = (1:n)';
  else
    if isempty(population)
      error('Nelson:statistics:populationEmpty', 'Population must not be empty.');
    end
    values = population(:);
  end
end
%=============================================================================
function idx = sampleIndices(n, k, replacement, weights)
  if isempty(weights)
    if replacement
      idx = randi(n, k, 1);
    else
      [~, order] = sort(rand(n, 1));
      idx = order(1:k);
    end
    return
  end
  w = weights(:);
  if length(w) ~= n || any(w < 0) || sum(w) <= 0
    error('Nelson:statistics:weightsOneValuePerPopulation', 'Weights must be a nonnegative vector with one value per population element.');
  end
  cdf = cumsum(w ./ sum(w));
  u = rand(k, 1);
  idx = ones(k, 1);
  for i = 1:k
    idx(i) = find(u(i) <= cdf, 1);
  end
end
%=============================================================================
function value = positiveInteger(value, message)
  if ~isscalar(value) || value <= 0 || floor(value) ~= value
    error('Nelson:statistics:mustBePositiveInteger', message);
  end
end
%=============================================================================
function value = logicalScalar(value, label)
  if ~isscalar(value) || ~(isnumeric(value) || islogical(value)) || (value ~= 0 && value ~= 1)
    error('Nelson:statistics:mustBeScalarLogicalValue', '%s must be a scalar logical value.', label);
  end
  value = logical(value);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = range(x, dim)
  narginchk(1, 2);
  nargoutchk(0, 1);
  if ~isnumeric(x) && ~islogical(x)
    error('Nelson:validators:mustBeNumericOrLogical', '%s must be numeric or logical.', 'Input');
  end
  if nargin < 2
    y = max(x) - min(x);
  else
    y = max(x, [], dim) - min(x, [], dim);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [p, h, stats] = ranksum(x, y, varargin)
  narginchk(2, Inf);
  nargoutchk(0, 3);
  opts = parseOptionsLocal(convertStringToCharArgs(varargin));
  [x, y] = validateSamplesLocal(x, y);
  [rankSum, ustat, tieSum, hasTies] = rankSumLocal(x, y);
  method = selectMethodLocal(opts.Method, length(x), length(y), hasTies);
  if strcmp(method, 'exact')
    p = exactPValueLocal(rankSum, length(x), length(y), opts.Tail);
    zval = [];
  else
    [p, zval] = approximatePValueLocal(ustat, length(x), length(y), tieSum, opts.Tail);
  end
  h = p <= opts.Alpha;
  stats = struct('ranksum', rankSum);
  if ~isempty(zval)
    stats.zval = zval;
  end
end
%=============================================================================
function opts = parseOptionsLocal(args)
  opts = struct('Alpha', 0.05, 'Tail', 'both', 'Method', 'auto');
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  for k = 1:2:length(args)
    if ~isTextScalarLocal(args{k})
      error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Name');
    end
    name = lower(char(args{k}));
    switch name
      case 'alpha'
        opts.Alpha = parseAlphaLocal(args{k + 1});
      case 'tail'
        opts.Tail = parseChoiceLocal(args{k + 1}, {'both', 'right', 'left'}, 'TAIL');
      case 'method'
        opts.Method = parseChoiceLocal(args{k + 1}, {'auto', 'exact', 'approximate'}, 'METHOD');
      otherwise
        error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
    end
  end
end
%=============================================================================
function alpha = parseAlphaLocal(value)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) ...
      && value > 0 && value < 1)
    error('Nelson:statistics:alphaOutOfRange', '%s must be a scalar in the range (0,1).', 'ALPHA');
  end
  alpha = double(value);
end
%=============================================================================
function value = parseChoiceLocal(value, choices, name)
  if ~isTextScalarLocal(value)
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', name);
  end
  text = lower(char(value));
  matches = choices(startsWith(choices, text));
  if length(matches) ~= 1
    error('Nelson:statistics:invalidValue:valueHasUnsupportedValue', '%s has an unsupported value.', name);
  end
  value = matches{1};
end
%=============================================================================
function [x, y] = validateSamplesLocal(x, y)
  if ~(isnumeric(x) && isreal(x) && ~issparse(x) && isvector(x))
    error('Nelson:statistics:xRealNumericVector', '%s must be a real numeric vector.', 'X');
  end
  if ~(isnumeric(y) && isreal(y) && ~issparse(y) && isvector(y))
    error('Nelson:statistics:yRealNumericVector', '%s must be a real numeric vector.', 'Y');
  end
  x = double(x(:));
  y = double(y(:));
  x = x(~isnan(x));
  y = y(~isnan(y));
  if isempty(x) || isempty(y)
    error('Nelson:statistics:xYContainLeastOne', '%s must contain at least one non-NaN observation.', 'X and Y');
  end
end
%=============================================================================
function [rankSum, ustat, tieSum, hasTies] = rankSumLocal(x, y)
  n1 = length(x);
  values = [x; y];
  labels = [ones(n1, 1); zeros(length(y), 1)];
  [ranks, tieSum] = tiedRanksLocal(values);
  rankSum = sum(ranks(labels == 1));
  ustat = rankSum - n1 * (n1 + 1) / 2;
  hasTies = tieSum ~= 0;
end
%=============================================================================
function method = selectMethodLocal(method, n1, n2, hasTies)
  if strcmp(method, 'exact') && hasTies
    error('Nelson:statistics:exactMethodSupportedTiesPresent', 'Exact method is not supported when ties are present.');
  end
  if strcmp(method, 'auto')
    if ~hasTies && n1 + n2 <= 20
      method = 'exact';
    else
      method = 'approximate';
    end
  end
end
%=============================================================================
function p = exactPValueLocal(rankSum, n1, n2, tail)
  counts = exactRankSumCountsLocal(n1, n2);
  minRankSum = n1 * (n1 + 1) / 2;
  idx = round(rankSum - minRankSum) + 1;
  total = sum(counts);
  switch tail
    case 'left'
      p = sum(counts(1:idx)) / total;
    case 'right'
      p = sum(counts(idx:end)) / total;
    otherwise
      lo = sum(counts(1:idx)) / total;
      hi = sum(counts(idx:end)) / total;
      p = min(1, 2 * min(lo, hi));
  end
end
%=============================================================================
function counts = exactRankSumCountsLocal(n1, n2)
  maxExtra = n1 * n2;
  states = zeros(n1 + 1, maxExtra + 1);
  states(1, 1) = 1;
  for r = 1:(n1 + n2)
    upper = min(r, n1);
    for k = upper:-1:1
      offset = r - k;
      if offset >= 0
        states(k + 1, offset + 1:end) = states(k + 1, offset + 1:end) ...
          + states(k, 1:end - offset);
      end
    end
  end
  counts = states(n1 + 1, :);
end
%=============================================================================
function [p, zval] = approximatePValueLocal(ustat, n1, n2, tieSum, tail)
  n = n1 + n2;
  mu = n1 * n2 / 2;
  variance = n1 * n2 / 12 * ((n + 1) - tieSum / (n * (n - 1)));
  sigma = sqrt(variance);
  if sigma == 0
    zval = 0;
    p = 1;
    return
  end
  switch tail
    case 'left'
      zval = (ustat - mu + 0.5) / sigma;
      p = normcdf(zval, 0, 1);
    case 'right'
      zval = (ustat - mu - 0.5) / sigma;
      p = normcdf(zval, 0, 1, 'upper');
    otherwise
      zval = (abs(ustat - mu) - 0.5) / sigma;
      p = 2 * normcdf(-abs(zval), 0, 1);
  end
end
%=============================================================================
function [ranks, tieSum] = tiedRanksLocal(values)
  [sortedValues, order] = sort(values(:));
  n = length(sortedValues);
  ranks = zeros(n, 1);
  tieSum = 0;
  starts = [1; find(diff(sortedValues) ~= 0) + 1];
  stops = [starts(2:end) - 1; n];
  for k = 1:length(starts)
    rows = starts(k):stops(k);
    ranks(order(rows)) = (starts(k) + stops(k)) / 2;
    tieLength = stops(k) - starts(k) + 1;
    tieSum = tieSum + tieLength ^ 3 - tieLength;
  end
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
