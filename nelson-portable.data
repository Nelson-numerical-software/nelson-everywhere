%=============================================================================
% <-- Issue URL -->
% https://github.com/nelson-lang/nelson/issues/1210
% <-- Short Description -->
% Function "bode" did not unwrap phase
%=============================================================================
% <--ADV-CLI MODE-->
%=============================================================================
S = tf(1, [1 0.5 1]);
[magnitude, phase, w] = bode(S * S * S);
asserts.isequal(size(phase), [1 1 1000])
asserts.isapprox(phase(1:10), [-0.8595 -0.8675 -0.8755 -0.8836 -0.8918 -0.9001 -0.9084 -0.9168 -0.9253 -0.9339], 1e-4);
%=============================================================================
bode(S * S * S)
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
