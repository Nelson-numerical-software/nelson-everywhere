% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [status, test_suites] = run_impl(varargin)
  nbWorkers = maxNumCompThreads();
  cleanupOnExit = ~is_unittest_runfile_worker();
  try
    __totalTimeBegin = time();
    tests_manager_trace('run', 'start');
    [varargin, runtimeOptions] = extractRuntimeOptions(varargin); %#ok<NLS0004>
    [modules_list, files_to_test, result_outputfile, option, stoponfail] = ...
      test_run_parse_input_arguments(length(varargin), varargin);
    tests_manager_trace('run', ['arguments elapsed=', ...
      sprintf('%.3fs', time() - __totalTimeBegin)]);
    nelson_version = version('-number');
    nelson_version_str = sprintf('Nelson-%d.%d.%d.%d', nelson_version(1), ...
      nelson_version(2), nelson_version(3), nelson_version(4));
    if isempty(files_to_test)
      test_suites = run_impl_modules(...
        modules_list, option, nbWorkers, runtimeOptions, stoponfail, nelson_version_str);
    else
      test_suites = run_impl_files(...
        files_to_test, nbWorkers, runtimeOptions, stoponfail, nelson_version_str);
    end
    if cleanupOnExit
      run_cleanupProcesses(false);
    end
    tests_manager_trace('run', ['cleanup elapsed=', ...
      sprintf('%.3fs', time() - __totalTimeBegin)]);
    __totalTimeEnd = time();
    status = test_suites.errors == 0;
    test_suites.total_time = __totalTimeEnd - __totalTimeBegin;
    res = test_run_save_results(test_suites, result_outputfile);
    if ~res
      error('Nelson:tests_manager:cannotSaveResults', 'Impossible to save results file.');
    end
    test_run_disp_summary(test_suites);
  catch ex
    if cleanupOnExit
      run_cleanupProcesses(true);
    end
    rethrow(ex);
  end
end
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function test_suites = run_impl_append_suites(test_suites, test_suite)
  for t = test_suite
    test_suites.disabled = test_suites.disabled + t.disabled;
    test_suites.errors = test_suites.errors + t.errors;
    test_suites.passed = test_suites.passed + t.passed;
    test_suites.tests = test_suites.tests + t.tests;
    test_suites.bench = test_suites.bench + t.bench;
    test_suites.time = test_suites.time + t.time;
    test_suites.worker_pool = worker_pool_metrics_merge(test_suites.worker_pool, t.worker_pool);
    test_suites.tests_list = [test_suites.tests_list; t];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function test_suites = run_impl_files(...
    files_to_test, nbWorkers, runtimeOptions, stoponfail, nelson_version_str)
  test_suites = create_test_suites();
  test_suite = process_files_to_test(...
    files_to_test, nelson_version_str, '', nbWorkers, runtimeOptions, stoponfail);
  test_suites.disabled = test_suite.disabled;
  test_suites.errors = test_suite.errors;
  test_suites.passed = test_suite.passed;
  test_suites.tests = test_suite.tests;
  test_suites.bench = test_suite.bench;
  test_suites.time = test_suite.time;
  test_suites.worker_pool = test_suite.worker_pool;
  test_suites.tests_list = test_suite;
end
