function progressive_cleanup_scripts(testCases, worker)
  run_removeFile(worker.command_filename);
  for k = 1:length(testCases)
    run_removeFile(testCases(k).command_filename);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function updatedState = progressive_complete_missing(currentState)
  updatedState = currentState;
  missingIndices = find(~updatedState.completed);
  for caseIndex = missingIndices(:)'
    nativeResult = emptyNativeResults(1);
    nativeResult.exit_code = 1;
    nativeResult.reason = 'missing_result';
    nativeResult.stderr = 'Native process did not return a result.';
    nativeResult.index = caseIndex;
    nativeResult.metadata = updatedState.cases(caseIndex).filename;
    nativeResult.job_id = ['case_', int2str(caseIndex)];
    testCase = run_progressive_direct_case(updatedState.cases(caseIndex), ...
      nativeResult, launcher_aborted_code());
    if updatedState.fallback(caseIndex)
      testCase.worker_pool_used = true;
      testCase.worker_pool_fallback = true;
      testCase.worker_pool_failure = updatedState.failures{caseIndex};
    end
    updatedState.results{caseIndex} = testCase;
    updatedState.completed(caseIndex) = true;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function testCases = progressive_completed_cases(state)
  completedCount = state.cursor - 1;
  if completedCount == 0
    testCases = [];
    return
  end
  completed = state.results(1:completedCount);
  try
    testCases = repmat(completed{1}, completedCount, 1);
    for k = 2:completedCount
      testCases(k) = completed{k};
    end
    return
  catch
  end
  fieldTemplate = completed{1};
  for k = 2:completedCount
    [fieldTemplate, completed{k}] = ...
      align_test_case_fields(fieldTemplate, completed{k});
  end
  templateNames = fieldnames(fieldTemplate);
  for k = 1:completedCount
    for fieldIndex = 1:length(templateNames)
      fieldName = templateNames{fieldIndex};
      if ~isfield(completed{k}, fieldName)
        completed{k}.(fieldName) = [];
      end
    end
    completed{k} = orderfields(completed{k}, templateNames);
  end
  testCases = repmat(completed{1}, completedCount, 1);
  for k = 2:completedCount
    testCases(k) = completed{k};
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function [updatedState, done] = progressive_consume_events(...
    currentState, polledEvents, allowFallback)
  updatedState = currentState;
  done = false;
  for k = 1:length(polledEvents)
    event = normalize_progressive_event(polledEvents{k});
    tests_manager_trace('events', ['event=', event.event_type, ...
      ' index=', mat2str(progressive_event_index(event)), ...
      ' reason=', event.reason]);
    if strcmp(event.event_type, 'done')
      done = true;
    else
      updatedState = progressive_record_pid(updatedState, event);
      caseIndex = round(progressive_event_index(event));
      valid = caseIndex >= 1 && caseIndex <= length(updatedState.cases);
      if valid && ~updatedState.completed(caseIndex)
        if strcmp(event.event_type, 'payload')
          updatedState = progressive_apply_payload(updatedState, caseIndex, event);
        elseif strcmp(event.event_type, 'process')
          updatedState = progressive_apply_process(...
            updatedState, caseIndex, event, allowFallback);
        end
      end
    end
  end
end
%=============================================================================
%=============================================================================
