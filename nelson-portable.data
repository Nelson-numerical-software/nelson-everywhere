%=============================================================================
function stop = odeOutputParameterizedRecorder(t, y, flag, scale, offset)
  global ODE_OUTPUT_PARAMETER_LOG;
  if isempty(ODE_OUTPUT_PARAMETER_LOG)
    ODE_OUTPUT_PARAMETER_LOG = {};
  end
  entry = struct();
  entry.flag = flag;
  entry.t = t;
  entry.y = y;
  entry.scale = scale;
  entry.offset = offset;
  ODE_OUTPUT_PARAMETER_LOG{end + 1} = entry;
  stop = false;
end
