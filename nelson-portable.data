}
% Display the centered spectrum of a simple two-dimensional pattern.
imageSize = 128;
spatialPattern = zeros(imageSize);
spatialPattern(25:104, 57:72) = 1;
spatialPattern(57:72, 25:104) = 1;
centeredTransform = fftshift(fft2(spatialPattern));
logMagnitude = log(1 + abs(centeredTransform));

if ~exist('fftExampleVisible', 'var')
  fftExampleVisible = 'on';
end
fftExampleFigure = figure('Name', 'Two-dimensional Fourier transform', ...
  'NumberTitle', 'off', 'Visible', fftExampleVisible);
subplot(1, 2, 1);
imagesc(spatialPattern);
axis('image');
title('Spatial pattern');
subplot(1, 2, 2);
imagesc(logMagnitude);
axis('image');
title('Centered log magnitude');
colormap(parula(128));
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = fft2(x, r, c)
  % 2-D fast Fourier transform
  % y = fft2(X)
  % Y = fft2(X, m, n)
  inputCount = nargin();
  if inputCount < 1
    error('Nelson:notEnoughInputs', 'Not enough input arguments.');
  end
  if inputCount == 2
    error('Nelson:wrongNumberOfInputs', 'Wrong number of input arguments.');
  end
  nargoutchk(0, 1);
  if inputCount == 1
    y = transformFirstTwoDimensions(x, [], []);
  else
    y = transformFirstTwoDimensions(x, r, c);
  end
end
%=============================================================================
function y = transformFirstTwoDimensions(x, rowCount, columnCount)
  if isempty(columnCount)
    transformedColumns = fft(x, [], 2);
  else
    transformedColumns = fft(x, columnCount, 2);
  end
  if isempty(rowCount)
    y = fft(transformedColumns, [], 1);
  else
    y = fft(transformedColumns, rowCount, 1);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function Y = fftn(varargin)
  % N-D fast Fourier transform
  % Y = fftn(X)
  % Y = fftn(X, dims)
  narginchk(1, 2)
  X = varargin{1};
  if nargin() == 2
    dims = varargin{2};
  else
    dims = size(X);
  end
  dims = dims(:)';
  if (numel(dims) < ndims(X))
    points = size(X);
    dims = [dims, points((numel(dims) + 1):end)];
  end
  Y = X;
  if ~issingle(Y)
    Y = double(Y);
  end
  if (numel(Y) ~= 0)
    for n = 1:numel(dims)
      Y = fft(Y, dims(n), n);
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function Y = fftshift(varargin)
  nRhs = nargin;
  if nRhs < 1
    error('Nelson:notEnoughInputs', 'Not enough input arguments.');
  end
  if nRhs > 2
    error('Nelson:tooManyInputs', 'Too many input arguments.');
  end
  X = varargin{1};
  if (~(isnumeric(X) || islogical(X) || ischar(X)))
    error('Nelson:fftw:invalidInput', 'X must be a vector or matrix.');
  end
  if nRhs == 1
    Y = circshift(X, floor(size(X) * inv(2)));
  else
    DIM = varargin{2};
    if ((~isscalar(DIM)) || (DIM < 1) || (floor(DIM) ~= DIM))
      error('Nelson:fftw:invalidDim', 'All values of DIM must be integer values.');
    end
    Y = circshift(X, floor(size(X, DIM) * inv(2)), DIM);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = ifft2(x, r, c)
  narginchk(1, 3);
  nargoutchk(0, 1);
  if nargin() == 2
    error('Nelson:wrongNumberOfInputs', 'Wrong number of input arguments.');
  end
  if nargin() == 1
    y = ifftn(x);
  else
    y = ifftn(x, [r, c]);
  end
end
