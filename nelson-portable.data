  if isstring(value)
    value = char(value);
  end
  if ~ischar(value)
    error('Nelson:time:mustBeText', '%s must be text.', name);
  end
end
%=============================================================================
function scale = localTimeUnitDays(units)
  units = lower(localTimeText(units, 'Units'));
  switch units
    case {'weeks', 'week'}
      scale = 7;
    case {'days', 'day'}
      scale = 1;
    case {'hours', 'hour'}
      scale = 1 / 24;
    case {'minutes', 'minute'}
      scale = 1 / (24 * 60);
    case {'seconds', 'second'}
      scale = 1 / (24 * 60 * 60);
    case {'milliseconds', 'millisecond'}
      scale = 1 / (24 * 60 * 60 * 1000);
    otherwise
      scale = 1 / (24 * 60 * 60);
  end
end
%=============================================================================
%=============================================================================
