%=============================================================================
asserts.isequal(nargin('cos'), 1);
asserts.isequal(nargout('cos'), 1);
%=============================================================================
asserts.isequal(cos(NaN), NaN);
asserts.isequal(cos(-NaN), NaN);
asserts.isequal(cos(Inf), NaN);
asserts.isequal(cos(-Inf), NaN);
%=============================================================================
v = [1. 0.8660254 0.7071068 0.5 0. 0. -0.5 -0.7071068 -0.8660254 -1];
r = cos(v);
ref = [0.5403 0.6479 0.7602 0.8776 1.0000 1.0000 0.8776 0.7602 0.6479 0.5403];
asserts.isapprox(r, ref, 1e-4);
%=============================================================================
x = cos(0i);
ref = 1;
asserts.isequal(x, ref);
asserts.isequal(cos(0), 1);
asserts.isequal(cos(-0), 1);
%=============================================================================
X = cos(zeros(3, 3, 3));
REF = ones(3, 3, 3);
asserts.isequal(X, REF);
%=============================================================================
S = sparse(zeros(3, 3));
X = cos(S);
REF = sparse(ones(3, 3));
asserts.isequal(X, REF);
%=============================================================================
asserts.isequal(cos([]), []);
%=============================================================================
X = [5.235987755982988157E-01;
  7.853981633974482790E-01;
  1.047197551196597631E+00;
  1.570796326794896558E+00;
  2.094395102393195263E+00;
  2.356194490192344837E+00;
  2.617993877991494411E+00;
  3.141592653589793116E+00];
REF = [8.660254037844386755E-01;
  7.071067811865475727E-01;
  5.000000000000000994E-01;
  6.123233995736765886e-17;
  -4.999999999999998011e-01;
  -7.071067811865474595E-01;
  -8.660254037844386698E-01;
  -1.000000000000000000E+00];
asserts.isapprox(cos(X), REF, 1e-15);
%=============================================================================
msg = sprintf(_('Check for incorrect argument data type or missing argument in call to function ''%s''.'), 'cos');
asserts.checkerror('cos(''a'')', msg);
%=============================================================================
% Generated portable test module boundary.
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% Builds a nelson.display.CompactDisplayRepresentation from a data description.
% Backs the widthConstrainedDataRepresentation / fullDataRepresentation helper
% methods of nelson.mixin.CustomCompactDisplayProvider.
%   config : a nelson.display.DisplayConfiguration
%   width  : maximum number of characters (Inf for the full representation)
%   the remaining name-value arguments give the data:
%     'StringArray', strings   or   'CellArrayOfCharVectors', cellOfChars
%=============================================================================
function rep = buildCompactRepresentation(config, width, varargin)
  items = {};
  k = 1;
  while k < numel(varargin)
    name = varargin{k};
    value = varargin{k + 1};
    switch char(name)
      case 'StringArray'
        value = string(value);
        items = cellstr(value(:));
      case 'CellArrayOfCharVectors'
        items = value(:);
      case 'PaddedDisplayOutput'
        items = {char(value)};
    end
    k = k + 2;
  end
  delimiter = config.InterElementDelimiter;
  joined = strjoin(cellfun(@char, items(:).', 'UniformOutput', false), delimiter);
  if ~isinf(width) && numel(joined) > width
    if width > 1
      joined = [joined(1:(width - 1)), config.Ellipsis];
    else
      joined = config.Ellipsis;
    end
  end
  rep = nelson.display.CompactDisplayRepresentation(joined);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
classdef CompactDisplayRepresentation
  % CompactDisplayRepresentation  Result of a compact object display.
  %   Returned by the compactRepresentationForSingleLine /
  %   compactRepresentationForColumn methods of a
  %   nelson.mixin.CustomCompactDisplayProvider subclass. Usually built with
  %   the widthConstrainedDataRepresentation / fullDataRepresentation helpers.
  properties
    % PaddedDisplayOutput  char/string shown for the object.
    PaddedDisplayOutput = ''
    % Annotation  optional text appended after the data.
    Annotation = ''
    % CharacterWidth  width of the representation, in characters.
    CharacterWidth = 0
  end
  methods
    function obj = CompactDisplayRepresentation(paddedDisplayOutput, annotation)
      if nargin >= 1
        obj.PaddedDisplayOutput = paddedDisplayOutput;
      end
      if nargin >= 2
        obj.Annotation = annotation;
      end
      obj.CharacterWidth = numel(char(obj.PaddedDisplayOutput));
    end
  end
end
