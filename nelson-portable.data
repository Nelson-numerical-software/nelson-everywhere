% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function map = cool(varargin)
  narginchk(0, 1);
  if nargin < 1
    R = groot();
    f = R.CurrentFigure;
    if isempty(f)
      m = size(R.DefaultFigureColormap, 1);
    else
      m = size(f.Colormap, 1);
    end
  else
    m = varargin{1};
  end
  r = (0:m - 1)' / max(m - 1, 1);
  map = [r, (1 - r), ones(m, 1)];
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = copper(varargin)
  nargoutchk(0, 1);
  narginchk(0, 1);
  if nargin < 1
    R = groot();
    f = R.CurrentFigure;
    if isempty(f)
      m = size(R.DefaultFigureColormap, 1);
    else
      m = size(f.Colormap, 1);
    end
  else
    m = varargin{1};
  end
  varargout{1} = min(1, gray(m) * diag([1.2500 0.7812 0.4975]));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = flag(varargin)
  narginchk(0, 1);
  nargoutchk(0, 1);
  colorCount = requestedColorCount(varargin{:});
  pattern = [1 0 0;
             1 1 1;
             0 0 1;
             0 0 0];
  rowIndex = rem(0:colorCount - 1, size(pattern, 1)) + 1;
  varargout{1} = pattern(rowIndex, :);
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = gray(varargin)
  narginchk(0, 1);
  nargoutchk(0, 1);
  narginchk(0, 1);
  if nargin < 1
    R = groot();
    f = R.CurrentFigure;
    if isempty(f)
      n = size(R.DefaultFigureColormap, 1);
    else
      n = size(f.Colormap, 1);
    end
  else
    n = varargin{1};
  end

  if (n == 1)
    varargout{1} = [0, 0, 0];
  else
    if (n <= 0)
      varargout{1} = zeros(0, 3);
    else
      r = (0:n - 1)' / max(n - 1, 1);
      varargout{1} = [r, r, r];
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function map = hot(varargin)
  narginchk(0, 1);
  colorCount = requestedColorCount(varargin{:});
  hotSegmentLength = fix(3 * colorCount / 8);
  colorIndex = (1:colorCount).';
  red = saturatingRamp(colorIndex, 0, hotSegmentLength);
  green = saturatingRamp(colorIndex, hotSegmentLength, hotSegmentLength);
  blue = saturatingRamp(colorIndex, 2 * hotSegmentLength, colorCount - 2 * hotSegmentLength);
  map = [red, green, blue];
end
%=============================================================================
function channel = saturatingRamp(colorIndex, offset, span)
  channel = min(max((colorIndex - offset) ./ max(span, 1), 0), 1);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function map = hsv(varargin)
  narginchk(0, 1);
  if nargin < 1
    R = groot();
    f = R.CurrentFigure;
    if isempty(f)
      m = size(R.DefaultFigureColormap, 1);
    else
      m = size(f.Colormap, 1);
    end
  else
    m = varargin{1};
  end

  map = zeros(m, 3);
  if m <= 0
    return
  end

  for k = 1:m
    h = 6 * (k - 1) / m;
    sector = floor(h);
    fraction = h - sector;
    switch sector
      case 0
        map(k, :) = [1, fraction, 0];
      case 1
        map(k, :) = [1 - fraction, 1, 0];
      case 2
        map(k, :) = [0, 1, fraction];
      case 3
        map(k, :) = [0, 1 - fraction, 1];
      case 4
        map(k, :) = [fraction, 0, 1];
      otherwise
        map(k, :) = [1, 0, 1 - fraction];
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function map = jet(varargin)
  narginchk(0, 1);
  colorCount = requestedColorCount(varargin{:});
  map = zeros(colorCount, 3);
  if colorCount == 0
    return
  end

  bandLength = ceil(colorCount / 4);
  band = jetBandValues(bandLength);
  middleStart = ceil(bandLength / 2) - double(mod(colorCount, 4) == 1);
  positions = middleStart + (1:numel(band)).';

  map = setJetBand(map, positions + bandLength, 1, band);
  map = setJetBand(map, positions, 2, band);
  map = setJetBand(map, positions - bandLength, 3, band);
end
%=============================================================================
function values = jetBandValues(bandLength)
  rising = (1:bandLength).' / bandLength;
  plateau = ones(max(bandLength - 1, 0), 1);
  values = [rising; plateau; flipud(rising)];
end
%=============================================================================
function map = setJetBand(map, rows, channel, values)
  validRows = rows >= 1 & rows <= size(map, 1);
  if ~any(validRows)
    return
  end
  map(rows(validRows), channel) = values(validRows);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function map = lines(varargin)
  narginchk(0, 1);
  if nargin < 1
    R = groot();
    f = R.CurrentFigure;
    if isempty(f)
      m = size(R.DefaultFigureColormap, 1);
    else
      m = size(f.Colormap, 1);
    end
  else
    m = varargin{1};
  end

  colors = [
    0.0660, 0.4430, 0.7450;
    0.8660, 0.3290, 0.0000;
    0.9290, 0.6940, 0.1250;
    0.5210, 0.0860, 0.8190;
    0.2310, 0.6660, 0.1960;
    0.1840, 0.7450, 0.9370;
    0.8190, 0.0150, 0.5450];

  map = zeros(m, 3);
  for k = 1:m
    map(k, :) = colors(mod(k - 1, size(colors, 1)) + 1, :);
  end
end
