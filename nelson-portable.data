function texts = compactElementText(obj)
  % Element texts shown when a datetime row is displayed inside a cell or a struct.
  texts = reshape(datetimeDisplayText(obj), 1, []);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
