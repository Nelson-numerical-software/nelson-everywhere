% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = properties(obj)
  props = ltiPropertyNames(class(obj));
  if (nargout == 0)
    currentFormat = format();
    if strcmp(currentFormat.LineSpacing, 'loose')
      disp(' ');
    end
    disp('Properties for class ss:');
    if strcmp(currentFormat.LineSpacing, 'loose')
      disp(' ');
    end
    for p = props'
      disp(['    ', p{1}]);
    end
    if strcmp(currentFormat.LineSpacing, 'loose')
      disp(' ');
    end
  else
    varargout{1} = props;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = size(varargin)
  narginchk(1, 2);
  nargoutchk(0, 2);

  sys = varargin{1};
  p = 0; % Number of outputs
  m = 0; % Number of inputs
  n = 0; % Number of states
  if isempty(sys.A) && isempty(sys.B) && isempty(sys.C) && ~isempty(sys.D)
    p = size(sys.D, 1);
    m = size(sys.D, 2);
    n = size(sys.A, 1);
  else
    p = size(sys.C, 1);
    m = size(sys.B, 2);
    n = size(sys.A, 1);
  end

  if (nargout == 0 && nargin == 1)
    disp(sprintf(_('State-space model with %d outputs, %d inputs, and %d states.'), p, m, n));
  else
    if (nargin == 2)
      pos = varargin{2};
      if (pos < 1)
        error('Nelson:validators:mustBePositiveInteger', '%s must be a positive integer.', 'Second argument');
      end
      switch pos
        case 1
          varargout{1} = p;
        case 2
          varargout{1} = m;
        case 3
          varargout{1} = n;
        otherwise
          varargout{1} = 1;
      end
    else
      varargout{1} = p;
      if nargout > 1
        varargout{2} = m;
      end
      if nargout > 2
        varargout{3} = n;
      end
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2017 September Daniel MÃ¥rtensson (Swedish Embedded Control Systems Toolbox)
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
classdef ss
  properties
    A = []
    B = []
    C = []
    D = []
    E = []
    Offsets = []
    Scaled = false
    StateName = {}
    StatePath = {}
    StateUnit = {}
    InternalDelay = []
    InputDelay = 0
    OutputDelay = 0
    InputName = {}
    InputUnit = {}
    InputGroup = []
    OutputName = {}
    OutputUnit = {}
    OutputGroup = []
    Notes = []
    UserData = []
    SamplingGrid = []
  end

  properties (Dependent)
    Name
    Ts
    TimeUnit
  end

  properties (Hidden)
    NameValue = ''
    TsValue = 0
    TimeUnitValue = 'seconds'
    Internal = []
  end

  methods
    function obj = ss(varargin)
      nargoutchk(0, 1);
      obj.Internal.Version = 1;
      obj.Internal.Ts = 0;
      obj.Internal.IsStatic = false;
      if nargin == 0
        return
      end
      [dataArgs, propertyArgs] = splitConstructorArguments(varargin);
      obj = constructStateSpace(obj, dataArgs);
      obj = applyPropertyPairs(obj, propertyArgs);
    end

    function value = get.Ts(obj)
      value = obj.TsValue;
    end

    function obj = set.Ts(obj, value)
      value = ltiValidateSampleTime(value);
      obj.TsValue = value;
      obj.Internal.Ts = value;
      obj.Internal.IsStatic = false;
    end

    function value = get.TimeUnit(obj)
      value = obj.TimeUnitValue;
    end

    function obj = set.TimeUnit(obj, value)
      value = ltiValidateTimeUnit(value);
      obj.TimeUnitValue = value;
    end

    function value = get.Name(obj)
      value = obj.NameValue;
    end

    function obj = set.Name(obj, value)
      obj.NameValue = ltiValidateTextScalar('Name', value);
    end

    function st = struct(obj)
      st = builtin('struct');
      names = ltiPropertyNames('ss');
      for k = 1:length(names)
        name = names{k};
        st.(name) = obj.(name);
      end
      st.Internal = obj.Internal;
    end
  end
end
%=============================================================================
function [dataArgs, propertyArgs] = splitConstructorArguments(args)
  propertyStart = length(args) + 1;
  for k = 1:length(args)
    if isTextScalar(args{k}) && ~(k == 2 && islti(args{1}))
      propertyStart = k;
      break
    end
  end
  dataArgs = args(1:propertyStart - 1);
  propertyArgs = args(propertyStart:end);
end
%=============================================================================
function obj = constructStateSpace(obj, args)
  switch length(args)
    case 0
      return
    case 1
      obj = ssOneArgument(obj, args{1});
    case 4
      obj = ssFromABCD(obj, args{1}, args{2}, args{3}, args{4}, 0);
    case 5
      obj = ssFromABCD(obj, args{1}, args{2}, args{3}, args{4}, args{5});
    otherwise
      error('Nelson:control_system:wrongNumberOfArguments', 'Wrong number of input arguments.');
  end
end
%=============================================================================
function obj = ssOneArgument(obj, value)
  if islti(value)
    if isa(value, 'ss')
      obj = value;
    elseif isa(value, 'tf')
      obj = tfToSs(value);
    else
      error('Nelson:control_system:invalidType', '%s expected.', 'Supported LTI model')
    end
    return
  end
  obj = ssStaticGain(obj, value);
end
%=============================================================================
function obj = ssFromABCD(obj, A, B, C, D, Ts)
  ltiValidateSampleTime(Ts);
  obj = ssABCD(obj, A, B, C, D, Ts);
end
%=============================================================================
function obj = ssStaticGain(obj, value)
  obj.B = zeros(0, size(value, 2));
  obj.C = zeros(size(value, 1), 0);
  obj.D = value;
  obj.Ts = 0;
  obj.Internal.Ts = -2;
  obj.Internal.IsStatic = true;
end
%=============================================================================
function obj = tfToSs(sysIn)
  if ~issiso(sysIn)
    error('Nelson:control_system:invalidType', '%s expected.', 'SISO LTI model');
  end
  Ts = sysIn.Ts;
  numerator = sysIn.Numerator{1};
  denominator = sysIn.Denominator{1};
  isemptytf = isempty(numerator) && isempty(denominator);
  A = [];
  B = [];
  C = [];
  D = [];
  if ~isemptytf
    [A, B, C, D] = compreal(numerator, denominator);
  end
  obj = ss(A, B, C, D, Ts);
  obj = ltiCopyModelMetadata(obj, sysIn);
end
%=============================================================================
function obj = ssABCD(obj, A, B, C, D, Ts)
  [A, B, C, D, Ts] = adaptABCD(A, B, C, D, Ts);
  msg = checkABCDELocal(A, B, C, D);
  if ~isempty(msg)
    error(msg.identifier, msg.message);
  end
  obj.A = A;
  obj.B = B;
  obj.C = C;
  obj.D = D;
  if isequal(Ts, -2)
    obj.Ts = 0;
    obj.Internal.Ts = -2;
    obj.Internal.IsStatic = true;
  else
    obj.Ts = Ts;
    obj.Internal.Ts = Ts;
    obj.Internal.IsStatic = false;
  end
end
%=============================================================================
function [A, B, C, D, Ts] = adaptABCD(A, B, C, D, Ts)
  isDZero = isscalar(D) && D(1) == 0;
  if isempty(A) && isempty(B) && isempty(C)
    [m, n] = size(D);
    A = [];
    B = zeros(0, n);
    C = zeros(m, 0);
    Ts = -2;
    return
  end
  newRowCount = max(size(C, 1), size(D, 1));
  if isempty(C)
    C = eye(newRowCount, size(A, 1));
  end
  if isempty(D) || isDZero
    D = zeros(newRowCount, size(B, 2));
  end
end
%=============================================================================
function msg = checkABCDELocal(varargin)
  if nargin == 5
    E = varargin{5};
  else
    E = [];
  end
  A = varargin{1};
  B = varargin{2};
  C = varargin{3};
  D = varargin{4};
  [mA, nA] = size(A);
  [mB, nB] = size(B);
  [mC, nC] = size(C);
  [mD, nD] = size(D);
  [mE, nE] = size(E);
  msg.message = '';
  msg.identifier = '';
  msg = msg(zeros(0, 1));
  if mA ~= nA
    msg.message = sprintf(_('%s must be square.'), 'Matrix A');
    msg.identifier = 'Nelson:expectedSquare';
    return
  end
  if mB ~= mA
    msg.message = sprintf(_('The number of rows in matrices %s and %s must be equal.'), 'A', 'B');
    msg.identifier = 'Nelson:control_system:AAndBNumRowsMismatch';
    return
  end
  if nC ~= nA
    msg.message = sprintf(_('Matrices %s and %s should have an identical number of columns.'), 'A', 'C');
    msg.identifier = 'Nelson:control_system:AAndCNumColumnsMismatch';
    return
  end
  if nB ~= nD
    msg.message = sprintf(_('Matrices %s and %s should have an identical number of columns.'), 'B', 'D');
    msg.identifier = 'Nelson:control_system:BAndDNumColumnsMismatch';
    return
  end
  if mC ~= mD
    msg.message = sprintf(_('The number of rows in matrices %s and %s must be equal.'), 'C', 'D');
    msg.identifier = 'Nelson:control_system:CAndDNumRowsMismatch';
    return
  end
  if ~isempty(E) && (mA ~= mE || nA ~= nE)
    msg.message = sprintf(_('Matrices %s and %s should have an identical size.'), 'A', 'E');
    msg.identifier = 'Nelson:control_system:AAndESizeMismatch';
  end
end
%=============================================================================
function obj = applyPropertyPairs(obj, args)
  if isempty(args)
    return
  end
  if mod(length(args), 2) ~= 0
    error('Nelson:control_system:nameValuePair', '%s expected.', 'Name-value arguments');
  end
  for k = 1:2:length(args)
    name = resolvePropertyName(args{k}, ltiPropertyNames('ss'));
    obj.(name) = args{k + 1};
  end
end
function tf = isTextScalar(value)
  tf = ischar(value) || isStringScalar(value);
end
function name = resolvePropertyName(value, supported)
  value = ltiValidateTextScalar('Name', value);
  matches = startsWith(upper(supported), upper(value));
  if sum(matches) == 0
    error('Nelson:control_system:unknownParameter', '"%s" is not a recognized parameter.', value);
  end
  if sum(matches) > 1
    error('Nelson:control_system:ambiguousParameter', '"%s" matches multiple parameters.', value);
  end
  name = supported{find(matches, 1)};
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = subsasgn(varargin)
  obj = varargin{1};
  s = varargin{2};
  value = varargin{3};
  if strcmp(s(1).type, '()')
    if length(s) > 1
      currentValue = subsref(obj, s(1));
      value = subsasgn(currentValue, s(2:end), value);
    end
    obj = assignSubsystem(obj, s(1).subs, value);
    varargout{1} = obj;
    return
  end
  if strcmp(s(1).type, '{}')
    error('Nelson:control_system:invalidSubscript:illegalIndexingStructureArgumentTypeValue', 'Illegal indexing structure argument: type %s expected.', "'.' or '()'");
  end
  if ~strcmp(s(1).type, '.')
    error('Nelson:control_system:invalidSubscript:notAValidIndexingExpression', 'Not a valid indexing expression');
  end
  name = s(1).subs;
  if ~isprop(obj, name)
    msg = _('No property of the class ''%s'' matches the identifier ''%s''.');
    error('Nelson:control_system:unknownProperty', sprintf(msg, 'ss', name));
  end
  if length(s) > 1
    currentValue = ltiSubscriptGet(obj, name);
    value = subsasgn(currentValue, s(2:end), value);
  end
  switch name
    case 'Ts'
      obj.Ts = ltiValidateSampleTime(value);
      obj.Internal.Ts = obj.Ts;
      obj.Internal.IsStatic = false;
    case 'TimeUnit'
      obj.TimeUnit = ltiValidateTimeUnit(value);
    case 'Name'
      obj.Name = ltiValidateTextScalar('Name', value);
    otherwise
      obj = ltiSubscriptSet(obj, name, value);
  end
  varargout{1} = obj;
end
%=============================================================================
function obj = assignSubsystem(obj, indices, value)
  if length(indices) ~= 2
    error('Nelson:control_system:invalidSubscript', '%s expected.', 'Two indices');
  end
  value = ss(value);
  ltiCheckSampleTimeCompatibility(obj, value);
  outputs = indices{1};
  inputs = indices{2};
  D = obj.D;
  D(outputs, inputs) = value.D;
  obj.D = D;
  if isempty(obj.A) && isempty(value.A)
    return
  end
  if ~isequal(obj.A, value.A)
    if isempty(value.A)
      return
    end
    error('Nelson:control_system:invalidAssignment', 'State-space assignment must preserve the state matrix.');
  end
  B = obj.B;
  C = obj.C;
  if ~isempty(B) && ~isempty(value.B)
    B(:, inputs) = value.B;
    obj.B = B;
  end
  if ~isempty(C) && ~isempty(value.C)
    C(outputs, :) = value.C;
    obj.C = C;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = subsref(varargin)
  obj = varargin{1};
  s = varargin{2};
  if strcmp(s(1).type, '()')
    if length(s) > 1
      partial = subsref(obj, s(1));
      [varargout{1:nargout}] = subsref(partial, s(2:end));
      return
    end
    indices = s(1).subs;
    if length(indices) ~= 2
      error('Nelson:control_system:invalidSubscript', '%s expected.', 'Two indices');
    end
    outputs = indices{1};
    inputs = indices{2};
    A = ltiSubscriptGet(obj, 'A');
    B = ltiSubscriptGet(obj, 'B');
    C = ltiSubscriptGet(obj, 'C');
    D = ltiSubscriptGet(obj, 'D');
    if ~isempty(B)
      B = B(:, inputs);
    end
    if ~isempty(C)
      C = C(outputs, :);
    end
    if ~isempty(D)
      D = D(outputs, inputs);
    end
    sys = ss(A, B, C, D, ltiSubscriptGet(obj, 'Ts'));
    sys.E = ltiSubscriptGet(obj, 'E');
    sys.Scaled = ltiSubscriptGet(obj, 'Scaled');
    sys.TimeUnit = ltiSubscriptGet(obj, 'TimeUnit');
    sys.UserData = ltiSubscriptGet(obj, 'UserData');
    sys.InputName = ltiSelectIOProperty(ltiSubscriptGet(obj, 'InputName'), inputs);
    sys.InputUnit = ltiSelectIOProperty(ltiSubscriptGet(obj, 'InputUnit'), inputs);
    sys.OutputName = ltiSelectIOProperty(ltiSubscriptGet(obj, 'OutputName'), outputs);
    sys.OutputUnit = ltiSelectIOProperty(ltiSubscriptGet(obj, 'OutputUnit'), outputs);
    varargout{1} = sys;
    return
  end
  if strcmp(s(1).type, '{}')
    error('Nelson:control_system:invalidSubscript:illegalIndexingStructureArgumentTypeValue', 'Illegal indexing structure argument: type %s expected.', "'.'");
  end
  if ~strcmp(s(1).type, '.')
    error('Nelson:control_system:invalidSubscript:notAValidIndexingExpression', 'Not a valid indexing expression');
  end
  value = ltiSubscriptGet(obj, s(1).subs);
  if length(s) > 1
    [varargout{1:nargout}] = subsref(value, s(2:end));
  else
    varargout{1} = value;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function sys = uminus(sys)
  sys.C = -sys.C;
  sys.D = -sys.D;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2017 October Daniel MÃ¥rtensson (Swedish Embedded Control Systems Toolbox)
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function sys = append(varargin)
  for i = 1:length(varargin)
    if ~isa(varargin{i}, 'tf')
      sys = tf(varargin{i});
    else
      sys = varargin{i};
    end
    if (i == 1)
      sysAppend = sys;
    else
      sysAppend = append_two_lti(sysAppend, sys);
    end
  end
  sys = sysAppend;
end
%=============================================================================
function sys = append_two_lti(sys1, sys2)

  sampleTime = ltiResolveSampleTime(sys1, sys2);

  sys = tf();
  [ny1, nu1] = size(sys1.Numerator);
  [ny2, nu2] = size(sys2.Numerator);
  pad12 = cell(ny1, nu2);
  pad21 = cell(ny2, nu1);
  pad12(:) = {0};
  pad21(:) = {0};
  sys.Numerator = [sys1.Numerator, pad12; pad21, sys2.Numerator];
  pad12(:) = {1};
  pad21(:) = {1};
  sys.Denominator = [sys1.Denominator, pad12; pad21, sys2.Denominator];

  sys.Ts = sampleTime;
  sys.Variable = ltiMergeTfVariable(sys1, sys2, 'left');
  sys.TimeUnit = ltiMergeTimeUnit(sys1, sys2);
  sys.InputName = ltiMergeCellMetadata(sys1.InputName, nu1, sys2.InputName, nu2, 'concat');
  sys.InputUnit = ltiMergeCellMetadata(sys1.InputUnit, nu1, sys2.InputUnit, nu2, 'concat');
  sys.OutputName = ltiMergeCellMetadata(sys1.OutputName, ny1, sys2.OutputName, ny2, 'concat');
  sys.OutputUnit = ltiMergeCellMetadata(sys1.OutputUnit, ny1, sys2.OutputUnit, ny2, 'concat');
  userData = ltiMergeUserData(sys1, sys2);
  if ~isempty(userData)
    sys.UserData = userData;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = augstate(varargin)
  narginchk(1, 1);
  nargoutchk(0, 1);
  sys = ss(varargin{1});
  sysa = augstate(sys);
  sysa = tf(sysa);
end
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = balreal(varargin)
  narginchk(1, 1);
  nargoutchk(0, 4);
  sys = ss(varargin{1});
  [sysb, g, T, Ti] = balreal(sys);
  varargout{1} = sysb;
  if nargout > 1
    varargout{2} = g;
  end
  if nargout > 2
    varargout{3} = T;
  end
  if nargout > 3
    varargout{4} = Ti;
  end
end
%=============================================================================
% Copyright (c) 2017 September Daniel MÃ¥rtensson (Swedish Embedded Control Systems Toolbox)
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = c2d(varargin)
  % Convert model from continuous to discrete time
  % sysd = c2d(sysc, Ts)
  % sysd = c2d(sysc, Ts, method)
  % sysd = c2d(sysc, Ts, 'prewarp', W)

  narginchk(2, 4);
  nargoutchk(0, 1);
  sys = varargin{1};

  if ~isct(sys)
    error('Nelson:control_system:invalidType', '%s expected.', 'Continuous model');
  end

  if ~issiso(sys)
    error('Nelson:control_system:invalidType', '%s expected.', 'SISO LTI model');
  end

  variable = 'z';
  sys = ss(sys);

  Ts = varargin{2};
  mustBeNumeric(Ts, 2);
  if ~isscalar(Ts);
    error('Nelson:control_system:wrongSize', 'Wrong size for argument #%d: %s expected.', 2, 'scalar');
  end
  if (Ts < 0)
    error('Nelson:control_system:invalidSampleTime', 'Ts must be finite positive scalar.');
  end

  w0 = 0;
  method = 'Z';

  if nargin > 2
    method = toupper(convertStringsToChars(varargin{3}));
    if ~contains(method(1), {'Z', 'P', 'T'})
      error('Nelson:control_system:wrongValue', 'Wrong value for argument #%d: %s expected.', 3, 'valid method');
    end
    method = method(1);
  end

  if nargin > 3
    if ~strcmp(method, 'P')
      error('Nelson:control_system:prewarpMethodExpected', 'Wrong value for #%d argument: ''prewarp'' method expected.', 3);
    end
    w0 = varargin{4};
    mustBeNumeric(w0, 4);
    if ~isscalar(w0)
      error('Nelson:control_system:wrongSize', 'Wrong size for argument #%d: %s expected.', 4, 'scalar');
    end
    mustBePositive(w0, 4);
    mustBeFinite(w0, 4);
  end

  if nargin == 4
    sysd = c2d(sys, Ts, method, w0);
  else
    sysd = c2d(sys, Ts, method);
  end

  sysd = tf(sysd);
  sysd.Variable = variable;
  varargout{1} = sysd;
end
%=============================================================================
% Copyright (c) 2017 September Daniel MÃ¥rtensson (Swedish Embedded Control Systems Toolbox)
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = d2c(varargin)
  % sysc = d2c(sysd)
  % sysc = d2c(sysd, method)
  % sysc = d2c(sysd, 'prewarp', w0)

  narginchk(1, 3);
  nargoutchk(0, 1);

  sys = varargin{1};
  if ~isdt(sys)
    error('Nelson:control_system:invalidType', '%s expected.', 'Discrete model');
  end
  if ~issiso(sys)
    error('Nelson:control_system:invalidType', '%s expected.', 'SISO LTI model');
  end

  variable = 's';
  sys = ss(sys);

  w0 = 0;
  method = 'Z';

  if nargin > 1
    method = toupper(convertStringsToChars(varargin{2}));
    if ~contains(method(1), {'Z', 'P', 'T'})
      error('Nelson:control_system:wrongValue', 'Wrong value for argument #%d: %s expected.', 3, 'valid method');
    end
    method = method(1);
  end
  if nargin > 2
    if ~strcmp(method, 'P')
      error('Nelson:control_system:prewarpMethodExpected', 'Wrong value for #%d argument: ''prewarp'' method expected.', 2);
    end
    w0 = varargin{3};
    mustBeNumeric(w0, 3);
    if ~isscalar(w0)
      error('Nelson:control_system:wrongSize', 'Wrong size for argument #%d: %s expected.', 3, 'scalar');
    end
    mustBePositive(w0, 3);
    mustBeFinite(w0, 3);
  end

  if nargin == 3
    sysa = d2c(sys, method, w0);
  else
    sysa = d2c(sys, method);
  end

  sysa = tf(sysa);
  sysa.Variable = variable;

  varargout{1} = sysa;
end
