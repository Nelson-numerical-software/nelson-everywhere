  properties
    X = zeros(0, 0)
    Y = []
    NumNeighbors = 1
    Distance = 'euclidean'
    DistanceWeight = 'equal'
    Standardize = false
    Mu = []
    Sigma = []
    P = 2
    Scale = []
    PredictorNames = {}
    ResponseName = 'y'
    NumObservations = 0
    NumPredictors = 0
  end

  methods
    function obj = RegressionKNN(varargin)
      if nargin == 0
