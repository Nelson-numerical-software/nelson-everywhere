% LICENCE_BLOCK_END
%=============================================================================
function varargout = evalfr(varargin)
  narginchk(2, 2);
  nargoutchk(0, 1);

  sysIn = tf(varargin{1});
  w = varargin{2};
  varargout{1} = evalfr(sysIn, w);
end
%=============================================================================
% Copyright (c) 2017 October Daniel Mårtensson (Swedish Embedded Control Systems Toolbox)
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = gram(varargin)
  % Wc = gram(sys, 'c')
  % Wc = gram(sys, 'o')
  narginchk(2, 2);
  nargoutchk(0, 1);
  option = varargin{2};
  option = tolower(convertStringsToChars(option));

  sys = varargin{1};

  % Get sample time
  sampleTime = sys.Ts;

  if (sampleTime > 0)
    % Discrete way
    A = sys.A;
    B = sys.B;
    C = sys.C;

    if (strcmp(option, 'c'))
      X = dlyap(A, B * B');
    elseif (strcmp(option, 'o'))
      X = dlyap(A', C' * C);
    else
      error('Nelson:control_system:wrongArgumentValue', '%s expected.', "'o', 'c' second argument");
    end
  else
    % Continuous way
    A = sys.A;
    B = sys.B;
    C = sys.C;

    if (strcmp(option, 'c'))
      X = lyap(A, B * B');
    elseif (strcmp(option, 'o'))
      X = lyap(A', C' * C);
    else
      error('Nelson:control_system:wrongArgumentValue', '%s expected.', "'o', 'c' second argument");
    end
  end
  varargout{1} = X;
end
%=============================================================================
% Copyright (c) 2017 October Daniel Mårtensson (Swedish Embedded Control Systems Toolbox)
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = hsvd(varargin)
  narginchk(1, 1);
  nargoutchk(0, 1);
  sys = varargin{1};
  % Get gramians
  P = gram(sys, 'c');
  Q = gram(sys, 'o');
  % Get hankel singular values
  hsvd = sqrt(eig(P * Q));
  varargout{1} = hsvd;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function res = inv(sys)
  A = sys.A;
  B = sys.B;
  C = sys.C;
  D = sys.D;
  E = sys.E;

  res = sys;
  m = size(B, 2);
  n = size(A, 1);
  res.A = [A, B; C, D];
  res.B = [zeros(n, m); -eye(m)];
  res.C = [zeros(m, n), eye(m)];
  res.D = zeros(m, m);
  if isempty(E)
    E = eye(n, n);
  end
  res.E = [E, zeros(n, m); zeros(m, n + m)];
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = isequal(varargin)
  % compares two state space model
  narginchk(2, 1000);
  nargoutchk(0, 1);

  sysA = varargin{1};
  typenameA = class(sysA);
  for k = 2:nargin
    sysB = varargin{k};
    typenameB = class(sysB);
    if ~strcmp(typenameA, typenameB)
      varargout{1} = false;
      return
    end
    if isa(sysA, 'ss') || isa(sysB, 'ss')
      R = isequal(struct(sysA), struct(sysB));
      if ~R
        varargout{1} = R;
        return
      end
    else
      varargout{1} = false;
      return
    end
  end
  varargout{1} = true;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = isequalto(varargin)
  % compares two state space model
  narginchk(2, 1000);
  nargoutchk(0, 1);

  sysA = varargin{1};
  typenameA = class(sysA);
  for k = 2:nargin
    sysB = varargin{k};
    typenameB = class(sysB);
    if ~strcmp(typenameA, typenameB)
      varargout{1} = false;
      return
    end
    if isa(sysA, 'ss') || isa(sysB, 'ss')
      R = isequalto(struct(sysA), struct(sysB));
      if ~R
        varargout{1} = R;
        return
      end
    else
      varargout{1} = false;
      return
    end
  end
  varargout{1} = true;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function tf = isprop(obj, propertyName)
  if ~ischar(propertyName)
    error('Nelson:control_system:wrongType', 'Wrong type for argument #%d: %s expected.', 2, 'string');
  end
  tf = any(strcmp(ltiPropertyNames(class(obj)), propertyName));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
