%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('tiedrank'), -2);
asserts.isequal(nargout('tiedrank'), 2);
%=============================================================================
A = [-2 1 3 1 4];
[R, tieadj] = tiedrank(A);
asserts.isequal(R, [1 2.5 4 2.5 5]);
asserts.isequal(tieadj, 3);
%=============================================================================
[R, tieadj] = tiedrank(A, 1);
asserts.isequal(R, [1 2.5 4 2.5 5]);
asserts.isequal(tieadj, [1; 0; 18]);
%=============================================================================
[R, tieadj] = tiedrank(A, 0, 1);
asserts.isequal(R, [1 2.5 2 2.5 1]);
asserts.isequal(tieadj, 3);
%=============================================================================
B = [4 1 4; 2 3 5; 2 1 7; 2 4 2; 1 6 4];
[R, tieadj] = tiedrank(B, 0, 1);
asserts.isapprox(R, [1 1.5 2.5; 2.333333333333333 3 2; ...
                    2.333333333333333 1.5 1; 2.333333333333333 2 1; ...
                    1 1 2.5], 1e-12);
asserts.isequal(tieadj, [12 3 3]);
%=============================================================================
C = [NaN 3 3 1];
[R, tieadj] = tiedrank(C);
asserts.istrue(isnan(R(1)));
asserts.isequal(R(2:end), [2.5 2.5 1]);
asserts.isequal(tieadj, 3);
%=============================================================================
D = cat(3, [2 2; 1 3], [4 4; 5 NaN]);
[R, tieadj] = tiedrank(D);
asserts.isequal(R(:, :, 1), [2 1; 1 2]);
asserts.isequal(R(:, :, 2), [1 1; 2 NaN]);
asserts.isequal(size(tieadj), [1 2 2]);
asserts.isequal(tieadj(:), [0; 0; 0; 0]);
%=============================================================================
[R, tieadj] = tiedrank([NaN; NaN], 1);
asserts.istrue(all(isnan(R)));
asserts.isequal(tieadj, [0; 0; 0]);
S = tiedrank(single([10 5 5]));
asserts.isequal(class(S), 'double');
asserts.isequal(S, [3 1.5 1.5]);
%=============================================================================
asserts.checkerror('tiedrank()', _('Not enough input arguments.'));
asserts.checkerror('tiedrank({1})', sprintf(_('%s must be a real numeric array.'), 'X'));
asserts.checkerror('tiedrank([1 2], 2)', sprintf(_('%s must be a logical scalar.'), 'KENDALL'));
asserts.checkerror('tiedrank([1 2], 0, 2)', sprintf(_('%s must be a logical scalar.'), 'BIDIRECTIONAL'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('tinv'), 2);
asserts.isequal(nargout('tinv'), 1);
%=============================================================================
p = [0 0.025 0.5 0.975 1];
v = [1 2 5 10 Inf];
R = tinv(p, v);
REF = [-Inf -4.30265272974946 0 2.22813885198627 Inf];
asserts.istrue(isinf(R(1)) && R(1) < 0);
asserts.isapprox(R(2:4), REF(2:4), 1e-11);
asserts.istrue(isinf(R(5)) && R(5) > 0);
%=============================================================================
R = tinv(0.5, [1 2 5 10 Inf]);
asserts.isequal(R, [0 0 0 0 0]);
%=============================================================================
R = tinv([0.5 0.975], Inf);
REF = [0 1.95996398454005];
asserts.isapprox(R, REF, 1e-12);
%=============================================================================
R = tinv(single([0.025 0.5 0.975]), single([1 2 5]));
asserts.isequal(class(R), 'single');
asserts.isapprox(R, single([-12.7062047364321 0 2.57058183563631]), 1e-5);
asserts.isequal(tinv(single(0.5), single([1 2 5])), single([0 0 0]));
%=============================================================================
R = tinv([-0.1 1.1 NaN 0 1], 5);
asserts.istrue(all(isnan(R(1:3))));
asserts.istrue(isinf(R(4)) && R(4) < 0);
asserts.istrue(isinf(R(5)) && R(5) > 0);
%=============================================================================
R = tinv([], []);
asserts.isequal(size(R), [0 0]);
%=============================================================================
asserts.checkerror('tinv(ones(2), ones(3))', _('Size mismatch on input arguments'));
asserts.checkerror('tinv({0.5}, 2)', sprintf(_('%s must be real numeric.'), 'P'));
asserts.checkerror('tinv(0.5, {2})', sprintf(_('%s must be real numeric.'), 'V'));
%=============================================================================
asserts.isequal(tinv(0.5, 5), 0);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('tpdf'), 2);
asserts.isequal(nargout('tpdf'), 1);
%=============================================================================
x = [-3 -1 0 1 3];
v = [1 2 5 10 Inf];
R = tpdf(x, v);
REF = [0.0318309886183791 0.192450089729875 0.379606689822494 ...
       0.230361989229139 0.00443184841193801];
asserts.isapprox(R, REF, 1e-12);
%=============================================================================
R = tpdf([0 1], Inf);
REF = [0.398942280401433 0.241970724519143];
asserts.isapprox(R, REF, 1e-12);
%=============================================================================
R = tpdf(single(x), single(v));
asserts.isequal(class(R), 'single');
asserts.isapprox(R, single([0.0318309886183791 0.192450089729875 0.379606689822494 ...
                           0.230361989229139 0.00443184841193801]), 1e-6);
%=============================================================================
R = tpdf([-Inf Inf NaN 0 1], [5 5 5 -1 NaN]);
asserts.isequal(R(1), 0);
asserts.isequal(R(2), 0);
asserts.istrue(all(isnan(R(3:5))));
%=============================================================================
R = tpdf([], []);
asserts.isequal(size(R), [0 0]);
%=============================================================================
asserts.checkerror('tpdf(ones(2), ones(3))', _('Size mismatch on input arguments'));
asserts.checkerror('tpdf({1}, 2)', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('tpdf(1, {2})', sprintf(_('%s must be real numeric.'), 'V'));
%=============================================================================
asserts.isapprox(tpdf(0, 1), 1 / pi, 1e-12);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
