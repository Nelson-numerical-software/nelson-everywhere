    A(5, 2) = 0;
    A(5, 3) = -2.830160657856937661591496696351623096811;
    A(5, 4) = 2.595816144785981039931054294742889974145;
    A(6, 1) = -12.21580485360407974005910916471598682362;
    A(6, 2) = 0;
    A(6, 3) = 48.82665485823736062335980699373053427134;
    A(6, 4) = -38.55615592319928364666616600329792491404;
    A(6, 5) = 2.719085830096535863737044703969626233400;
    A(7, 1) = 108.8614188704176574066699618897203578466;
    A(7, 2) = 0;
    A(7, 3) = -432.4521181775777896358931629332707752654;
    A(7, 4) = 343.9115281800118289547200158889409233641;
    A(7, 5) = -20.55041135925273709189369488701721016265;
    A(7, 6) = 1.223582486401040366396880041626704217305;
    A(8, 1) = 113.4755131883738522204615568160304033854;
