% LICENCE_BLOCK_END
%=============================================================================
function h = hours(x)
  narginchk(1, 1);
  if isa(x, 'duration')
    h = double(x) ./ 3600;
  else
    h = duration(double(x), 0, 0);
    h.Format = 'h';
  end
end
