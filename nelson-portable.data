f = @(t, y, yp) yp + y;
[t, y] = ode15i(f, [0 1], 1, -1, odeset('MaxStep', 0.05));
asserts.istrue(abs(t(length(t)) - 1) < 1e-12);
asserts.istrue(abs(y(size(y, 1), 1) - exp(-1)) < 1e-3);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
f = @(t, y, yp) yp + y;
[t, y] = ode15i(f, [0 1], 1, -1, odeset('MaxStep', 0.05));
asserts.istrue(abs(t(length(t)) - 1) < 1e-12);
asserts.istrue(abs(y(size(y, 1), 1) - exp(-1)) < 1e-3);
%=============================================================================
residual = @(t, y, yp) yp + [-y(2); y(1)];
options = odeset('JPattern', eye(2), 'InitialStep', 0.02, 'MaxStep', 0.02, ...
  'RelTol', 1e-4, 'AbsTol', 1e-7);
[t, y] = ode15i(residual, [0 0.2], [1; 0], [0; -1], options);
asserts.istrue(abs(t(length(t)) - 0.2) < 1e-12);
asserts.istrue(norm(y(size(y, 1), :) - [cos(0.2), -sin(0.2)], inf) < 5e-4);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
residual = @(t, y, yp) yp + y;
[t, y] = ode15i(residual, [0 0.25 0.5], 1, -1);
asserts.isequal(size(t), [3 1]);
asserts.isequal(size(y), [3 1]);
asserts.istrue(max(abs(y - exp(-t))) < 5e-4);

sol = ode15i(residual, [0 0.5], 1, -1);
asserts.isequal(sol.solver, 'ode15i');
asserts.istrue(isfield(sol, 'stats'));
asserts.istrue(isfield(sol, 'idata'));
value = deval(sol, 0.25);
asserts.istrue(abs(value - exp(-0.25)) < 5e-4);
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
odeCheckSolverForTest(@ode15s);
%=============================================================================
% Stiff accuracy: the BDF kernel must track the requested tolerance on stiff
% problems (guards the predictor-based truncation error estimate).
A = [-100 1; 0 -1];
yexact = @(t)[exp(-100 * t) + (exp(-t) - exp(-100 * t)) / 99; exp(-t)];
solLoose = ode15s(@(t, y) A * y, [0 1], [1; 1], odeset('RelTol', 1e-3, 'AbsTol', 1e-6));
asserts.istrue(max(abs(solLoose.y(:, end) - yexact(1))) < 1e-2);
solTight = ode15s(@(t, y) A * y, [0 1], [1; 1], odeset('RelTol', 1e-6, 'AbsTol', 1e-9));
asserts.istrue(max(abs(solTight.y(:, end) - yexact(1))) < 1e-4);
% The variable-order kernel must reach tight tolerances without the step
% explosion of a fixed low-order formula.
asserts.istrue(solTight.stats.nsteps < 400);
%=============================================================================
% An inexact user-supplied Jacobian must not degrade the solution: the
% modified-Newton iteration has to converge on the implicit BDF equation.
wrongJac = ode15s(@(t, y) 1, [0 1], 0, odeset('Jacobian', -1, 'RelTol', 1e-3, 'AbsTol', 1e-6));
asserts.istrue(abs(wrongJac.y(end) - 1) < 1e-4);
%=============================================================================

