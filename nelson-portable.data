function filename = runfile_parseInput(args)
  filename = args{1};
  if length(args) == 2
    logical(args{2});
  end
  if ~isfile(filename)
    error('Nelson:tests_manager:fileDoesNotExist', 'An existing filename expected.');
  end
end
