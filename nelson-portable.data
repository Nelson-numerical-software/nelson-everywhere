asserts.isequal(sysc.Ts, Ts_REF);
asserts.isapprox(sysc.A, A_REF, 1e-4);
asserts.isapprox(sysc.B, B_REF, 1e-4);
asserts.isapprox(sysc.C, C_REF, 1e-4);
