function value = odeValidateSundialsLinearSolver(value)
  value = odeValidateSundialsChoice(value, 'LinearSolver', ...
    {'auto', 'dense', 'spgmr', 'spfgmr', 'spbcgs', 'sptfqmr', 'pcg', 'klu'});
end
