%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--WEIGHT 8-->
% <--ADV-CLI MODE-->
%=============================================================================
A = [-1.5 -0.2 1.0;
     -0.2 -1.7 0.6;
      1.0 0.6 -1.4];
B = [1.5 0.6;
     -1.8 1.0;
      0 0];
C = [0 -0.5 -0.1;
      0.35 -0.1 -0.15
      0.65 0 0.6];
D = [0.5 0;
      0.05 0.75
      0 0];
sys = ss(A, B, C, D);
Tf = 10;
Ts = 0.1;
[uSq, t] = gensig("square", 4, Tf, Ts);
uP = gensig("pulse", 3, Tf, Ts);
u = [uSq uP];
f = figure();
lsim(sys, u, t);
axesHandles = findobj(f, 'Type', 'axes');
lineCounts = zeros(length(axesHandles), 1);
for k = 1:length(axesHandles)
  lineCounts(k) = length(findobj(axesHandles(k), 'Type', 'line'));
end
asserts.isequal(sort(lineCounts), [0; 3; 3; 3]);
close(f);
