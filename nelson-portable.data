% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--WEIGHT 2-->
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('lognfit'), 5);
asserts.isequal(nargout('lognfit'), 2);
%=============================================================================
x = [0.5 1 2 3 5 8];
[PHAT, PCI] = lognfit(x);
asserts.isapprox(PHAT, [0.7979152904636743 0.9365014364963760], 1e-4);
asserts.isapprox(PCI, [0.04857071929664269 0.4066344491341202;
                      1.547259861630706 1.466368423858632], 1e-4);
%=============================================================================
[PHAT, PCI] = lognfit(x, 0.01);
asserts.isapprox(PHAT, [0.7979152904636743 0.9365014364963760], 1e-4);
asserts.isapprox(PCI, [-0.1868904100963166 0.2401381748259536;
                      1.782720991023665 1.632864698166798], 1e-4);
%=============================================================================
censor = [0 0 0 1 0 1];
freq = [1 2 1 1 2 1];
[PHAT, PCI] = lognfit(x, 0.05, censor, freq);
asserts.isapprox(PHAT, [0.9808752654800201 1.123582749374891], 1e-4);
asserts.isapprox(PCI, [0.1630080687412662 0.4563982307249053;
                      1.798742462218774 1.790767268024877], 1e-4);
%=============================================================================
opts = statset('MaxIter', 120, 'TolX', 1e-4);
[PHAT2, PCI2] = lognfit(x, [], [], [], opts);
asserts.isapprox(PHAT2, [0.7979152904636743 0.9365014364963760], 1e-4);
asserts.isapprox(PCI2, [0.04857071929664269 0.4066344491341202;
                       1.547259861630706 1.466368423858632], 1e-4);
%=============================================================================
xm = [0.5 1; 1 2; 2 3; 3 4; 5 7];
[PHATM, PCIM] = lognfit(xm);
asserts.isequal(size(PHATM), [2 2]);
asserts.isapprox(PHATM, [0.5416100402204420 0.8113492718048468;
                        1.024792795880652 0.6549471682747616], 1e-4);
asserts.isequal(size(PCIM), [2 2 2]);
asserts.isapprox(PCIM(:, :, 1), [-0.1695563869617602 0.3084790444798517;
                                1.252776467402644 1.314219499129842], 1e-4);
asserts.isapprox(PCIM(:, :, 2), [0.4507159303557678 0.2490134626659516;
                                1.598869661405536 1.060880873883572], 1e-4);
%=============================================================================
[PHAT, PCI] = lognfit(single(x));
asserts.isequal(class(PHAT), 'double');
asserts.isequal(class(PCI), 'double');
asserts.isapprox(PHAT, [0.7979152904636743 0.9365014364963760], 1e-4);
%=============================================================================
[PHAT, PCI] = lognfit([1 NaN 3]);
asserts.istrue(all(isnan(PHAT)));
asserts.istrue(all(isnan(PCI(:))));
[PHAT, PCI] = lognfit([1 2 3], [], [1 1 1], []);
asserts.istrue(all(isnan(PHAT)));
asserts.istrue(all(isnan(PCI(:))));
[PHAT, PCI] = lognfit([1 2 3], [], [], [0 0 0]);
asserts.istrue(all(isnan(PHAT)));
asserts.istrue(all(isnan(PCI(:))));
%=============================================================================
asserts.checkerror('lognfit()', _('Not enough input arguments.'));
asserts.checkerror('lognfit([])', _('X must be a nonempty vector or matrix.'));
asserts.checkerror('lognfit(ones(1, 1, 2))', _('X must be a nonempty vector or matrix.'));
asserts.checkerror('lognfit({1 2 3})', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('lognfit([0 1 2])', _('X must contain positive finite values.'));
asserts.checkerror('lognfit([1 Inf 2])', _('X must contain positive finite values.'));
asserts.checkerror('lognfit([1 2 3], {0.05})', sprintf(_('%s must be numeric.'), 'ALPHA'));
asserts.checkerror('lognfit([1 2 3], -0.1)', sprintf(_('%s must be a scalar in the range [0,1].'), 'ALPHA'));
asserts.checkerror('lognfit([1 2 3], 1.1)', sprintf(_('%s must be a scalar in the range [0,1].'), 'ALPHA'));
asserts.checkerror('lognfit([1 2 3], [], [0 2 0])', _('CENSORING must contain 0 or 1 values.'));
asserts.checkerror('lognfit([1 2 3], [], [], [1 -1 1])', sprintf(_('%s must contain nonnegative finite values.'), 'FREQ'));
asserts.checkerror('lognfit([1 2 3], [], ones(2, 2))', _('Size mismatch on input arguments'));
asserts.checkerror('lognfit([1 2 3], [], [], [], 1)', sprintf(_('%s must be a scalar structure.'), 'OPTIONS'));
asserts.checkerror('lognfit([1 2 3], [], [], [], statset(''MaxIter'', 0))', sprintf(_('%s must be a positive integer scalar.'), 'OPTIONS MaxIter'));
asserts.checkerror('lognfit([1 2 3], [], [], [], statset(''TolX'', 0))', sprintf(_('%s must be a positive scalar.'), 'OPTIONS TolX'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('logninv'), 5);
asserts.isequal(nargout('logninv'), 3);
%=============================================================================
p = [0 0.15865525393145707 0.5 0.8413447460685429 1];
R = logninv(p);
E = [0 exp(-1) 1 exp(1) Inf];
asserts.isapprox(R(1:4), E(1:4), 1e-14);
asserts.istrue(isinf(R(5)) && R(5) > 0);
%=============================================================================
R = logninv([0.15865525393145707 0.5 0.8413447460685429], 1, 2);
E = [exp(-1) exp(1) exp(3)];
asserts.isapprox(R, E, 1e-12);
%=============================================================================
[x, xLo, xUp] = logninv(0.8413447460685429, 0, 1, [0.01 0; 0 0.04]);
asserts.isapprox(x, exp(1), 1e-14);
asserts.isapprox(xLo, 1.7537190944221677, 1e-14);
asserts.isapprox(xUp, 4.213363544043105, 1e-14);
%=============================================================================
R = logninv(single([0.5 0.8413447460685429]), single(0), single(1));
asserts.isequal(class(R), 'single');
asserts.isapprox(double(R), [1 exp(1)], 1e-6);
%=============================================================================
R = logninv([-0.1 1.1 NaN 0.5 0.5], 0, 1);
asserts.istrue(all(isnan(R(1:3))));
asserts.isequal(R(4), 1);
asserts.isequal(R(5), 1);
R = logninv([0.5 0.5], [NaN 0], [1 0]);
asserts.istrue(all(isnan(R)));
%=============================================================================
R = logninv([], [], []);
asserts.isequal(size(R), [0 0]);
%=============================================================================
asserts.checkerror('logninv(ones(2), ones(3), 1)', _('Size mismatch on input arguments'));
asserts.checkerror('logninv({0.5}, 0, 1)', sprintf(_('%s must be real numeric.'), 'P'));
asserts.checkerror('logninv(0.5, {0}, 1)', sprintf(_('%s must be real numeric.'), 'MU'));
asserts.checkerror('logninv(0.5, 0, {1})', sprintf(_('%s must be real numeric.'), 'SIGMA'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--WEIGHT 2-->
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('lognlike'), 4);
asserts.isequal(nargout('lognlike'), 2);
%=============================================================================
x = [0.5 1 2 3 5 8];
params = [0.7979152904636743 0.9365014364963760];
[NLOGL, AVAR] = lognlike(params, x);
asserts.isapprox(NLOGL, 12.90749760280882, 1e-6);
asserts.isapprox(AVAR, [0.1461729287094217 -0.00000005066012583813165;
                       -0.00000005066012583813165 0.07308656356899881], 1e-6);
%=============================================================================
censor = [0 0 0 1 0 1];
freq = [1 2 1 1 2 1];
params = [0.9808752654800201 1.123582749374891];
[NLOGL, AVAR] = lognlike(params, x, censor, freq);
asserts.isapprox(NLOGL, 14.23694973737748, 1e-6);
asserts.isapprox(AVAR, [0.1741283149770794 0.02367443566992538;
                       0.02367443566992538 0.1158765986318134], 1e-6);
%=============================================================================
[NLOGL, AVAR] = lognlike(single([0.5 1.2]), single([1 2 3]));
asserts.isequal(class(NLOGL), 'double');
asserts.isequal(class(AVAR), 'double');
asserts.isapprox(NLOGL, 5.319721266138667, 1e-6);
asserts.istrue(all(isnan(AVAR(:))));
%=============================================================================
[NLOGL, AVAR] = lognlike([0 0], x);
asserts.istrue(isinf(NLOGL));
asserts.istrue(all(isnan(AVAR(:))));
[NLOGL, AVAR] = lognlike([NaN 1], x);
asserts.istrue(isnan(NLOGL));
asserts.istrue(all(isnan(AVAR(:))));
[NLOGL, AVAR] = lognlike([1 1], [1 NaN 3]);
asserts.istrue(isnan(NLOGL));
asserts.istrue(all(isnan(AVAR(:))));
%=============================================================================
asserts.checkerror('lognlike([1 2])', _('Not enough input arguments.'));
asserts.checkerror('lognlike({1 2}, [1 2 3])', sprintf(_('%s must be real numeric.'), 'PARAMS'));
asserts.checkerror('lognlike([1 2 3], [1 2 3])', sprintf(_('PARAMS must be a %s vector.'), 'two-element'));
asserts.checkerror('lognlike([1 2], {1 2 3})', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('lognlike([1 2], [])', sprintf(_('%s must be nonempty.'), 'X'));
asserts.checkerror('lognlike([1 2], [0 1 2])', _('X must contain positive finite values.'));
asserts.checkerror('lognlike([1 2], [1 Inf 2])', _('X must contain positive finite values.'));
asserts.checkerror('lognlike([1 2], [1 2 3], [0 2 0])', _('CENSORING must contain 0 or 1 values.'));
asserts.checkerror('lognlike([1 2], [1 2 3], [], [1 -1 1])', sprintf(_('%s must contain nonnegative finite values.'), 'FREQ'));
asserts.checkerror('lognlike([1 2], [1 2 3], ones(2, 2))', _('Size mismatch on input arguments'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('lognpdf'), 3);
asserts.isequal(nargout('lognpdf'), 1);
%=============================================================================
x = [0 1 exp(1)];
R = lognpdf(x);
E = [0 0.3989422804014327 0.0890160549159515];
asserts.isapprox(R, E, 1e-15);
%=============================================================================
R = lognpdf(exp([0 1 2]), 1, 2);
E = [0.17603266338214976 0.19947114020071635 0.17603266338214976] ./ exp([0 1 2]);
asserts.isapprox(R, E, 1e-15);
%=============================================================================
R = lognpdf(single([1 exp(1)]), single(0), single(1));
asserts.isequal(class(R), 'single');
asserts.isapprox(double(R), [0.3989422804014327 0.0890160549159515], 1e-7);
%=============================================================================
R = lognpdf([1 NaN 1 1], [0 0 NaN 0], [1 1 1 0]);
asserts.isapprox(R(1), 0.3989422804014327, 1e-15);
asserts.istrue(all(isnan(R(2:4))));
%=============================================================================
R = lognpdf([], [], []);
asserts.isequal(size(R), [0 0]);
%=============================================================================
asserts.checkerror('lognpdf(ones(2), ones(3), 1)', _('Size mismatch on input arguments'));
asserts.checkerror('lognpdf({1}, 0, 1)', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('lognpdf(1, {0}, 1)', sprintf(_('%s must be real numeric.'), 'MU'));
asserts.checkerror('lognpdf(1, 0, {1})', sprintf(_('%s must be real numeric.'), 'SIGMA'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('lognrnd'), -1);
asserts.isequal(nargout('lognrnd'), 1);
%=============================================================================
rng(0);
Z = randn(2, 4);
E = exp(1 + 2 .* Z);
rng(0);
R = lognrnd(1, 2, 2, 4);
asserts.isequal(size(R), [2 4]);
asserts.isapprox(R, E, 1e-14);
%=============================================================================
rng(0);
Z = randn(1, 3);
E = exp([0 1 2] + [1 0 2] .* Z);
rng(0);
R = lognrnd([0 1 2], [1 0 2]);
asserts.isapprox(R, E, 1e-14);
%=============================================================================
rng(0);
Z = randn(2, 3, 'single');
E = exp(single(2) .* Z);
rng(0);
R = lognrnd(single(0), single(2), [2 3]);
asserts.isequal(class(R), 'single');
asserts.isapprox(double(R), double(E), 1e-6);
%=============================================================================
R = lognrnd(1, 0, [1 3]);
asserts.isapprox(R, exp(ones(1, 3)), 1e-15);
R = lognrnd(0, -1, [1 3]);
asserts.istrue(all(isnan(R)));
%=============================================================================
R = lognrnd(0, 1, 0, 3);
asserts.isequal(size(R), [0 3]);
R = lognrnd(single(0), single(1), [2 0 3]);
asserts.isequal(class(R), 'single');
asserts.isequal(size(R), [2 0 3]);
R = lognrnd(0, 1, -1, 3);
asserts.isequal(size(R), [0 3]);
%=============================================================================
asserts.checkerror('lognrnd(0)', _('Not enough input arguments.'));
asserts.checkerror('lognrnd([0 1], 1, 2, 2)', _('Size mismatch on input arguments'));
asserts.checkerror('lognrnd(0, 1, 1.5, 2)', _('Size must contain integer values.'));
asserts.checkerror('lognrnd(0, 1, Inf, 2)', _('Size must contain integer values.'));
asserts.checkerror('lognrnd({0}, 1)', sprintf(_('%s must be real numeric.'), 'MU'));
asserts.checkerror('lognrnd(0, {1})', sprintf(_('%s must be real numeric.'), 'SIGMA'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('lognstat'), 2);
asserts.isequal(nargout('lognstat'), 2);
%=============================================================================
[m, v] = lognstat(0, 1);
asserts.isapprox(m, 1.6487212707001282, 1e-15);
asserts.isapprox(v, 4.670774270471604, 1e-14);
%=============================================================================
[m, v] = lognstat([0 1], [0 2]);
asserts.isapprox(m, [1 20.085536923187668], 1e-13);
asserts.isapprox(v, [0 21623.03700131398], 1e-9);
%=============================================================================
[m, v] = lognstat(single([0 1]), single([1 0]));
asserts.isequal(class(m), 'single');
asserts.isequal(class(v), 'single');
asserts.isapprox(double(m), [1.6487212707001282 exp(1)], 1e-6);
asserts.isapprox(double(v), [4.670774270471604 0], 1e-5);
%=============================================================================
[m, v] = lognstat([0 1 NaN], [1 -1 1]);
asserts.isapprox(m(1), 1.6487212707001282, 1e-15);
asserts.istrue(all(isnan(m(2:3))));
asserts.istrue(all(isnan(v(2:3))));
%=============================================================================
[m, v] = lognstat([], []);
asserts.isequal(size(m), [0 0]);
asserts.isequal(size(v), [0 0]);
%=============================================================================
asserts.checkerror('lognstat(ones(2), ones(3))', _('Size mismatch on input arguments'));
asserts.checkerror('lognstat({0}, 1)', sprintf(_('%s must be real numeric.'), 'MU'));
asserts.checkerror('lognstat(0, {1})', sprintf(_('%s must be real numeric.'), 'SIGMA'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('mad'), -2);
asserts.isequal(nargout('mad'), 1);
%=============================================================================
y1 = mad([1 2 3 4]);
asserts.isequal(y1, 1);
%=============================================================================
y2 = mad([1 2 100 4], 1);
asserts.isequal(y2, 1.5);
%=============================================================================
A = [1 2 3; 4 NaN 6; 7 8 9];
y3 = mad(A);
asserts.isapprox(y3, [2 3 2], 1e-12);
%=============================================================================
y4 = mad(A, 1, 2);
asserts.isapprox(y4, [1; 1; 1], 1e-12);
%=============================================================================
B = reshape(1:24, [4 3 2]);
y5 = mad(B, 0, [1 2]);
asserts.isequal(size(y5), [1 1 2]);
asserts.isapprox(y5(:), [3; 3], 1e-12);
%=============================================================================
y6 = mad(B, 1, 'all');
asserts.isequal(y6, 6);
%=============================================================================
y7 = mad(single([1 NaN 3]));
asserts.isequal(class(y7), 'double');
asserts.isequal(y7, 1);
%=============================================================================
y8 = mad(5);
asserts.isequal(y8, 0);
y9 = mad([]);
asserts.istrue(isnan(y9));
%=============================================================================
y10 = mad([1 2 3], 0, 3);
asserts.isequal(size(y10), [1 3]);
asserts.isequal(y10, [0 0 0]);
%=============================================================================
asserts.checkerror('mad({1})', sprintf(_('%s must be a real numeric array.'), 'X'));
asserts.checkerror('mad([1 2], 2)', sprintf(_('%s must be 0 or 1.'), 'FLAG'));
asserts.checkerror('mad([1 2], 0, 0)', _('Dimension argument must be a positive integer scalar, vector, or ''all''.'));
asserts.checkerror('mad([1 2], 0, ''bad'')', _('Dimension argument must be a positive integer scalar, vector, or ''all''.'));
asserts.checkerror('mad([1 2], 0, [1.5 2])', _('Dimension argument must be a positive integer scalar, vector, or ''all''.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('mahal'), 2);
asserts.isequal(nargout('mahal'), 1);
%=============================================================================
X = [1 2; 2 3; 3 5; 4 4; 5 7; 6 8];
Y = [3 4; 5 6; 8 10];
d2 = mahal(Y, X);
asserts.isapprox(d2, [0.180180180180180; 1.261261261261259; 5.805180180180180], 1e-12);
%=============================================================================
X1 = [1; 2; 4; 8];
Y1 = [2; 5; 10];
d2 = mahal(Y1, X1);
asserts.isapprox(d2, [0.319565217391304; 0.163043478260870; 4.076086956521740], 1e-12);
%=============================================================================
d2 = mahal([NaN 3; 3 4], X);
asserts.istrue(isnan(d2(1)));
asserts.isapprox(d2(2), 0.180180180180180, 1e-12);
%=============================================================================
d2 = mahal(zeros(0, 2), X);
asserts.isequal(size(d2), [0 1]);
%=============================================================================
S = mahal(single(Y), single(X));
asserts.isequal(class(S), 'single');
asserts.isapprox(double(S), [0.180180180180180; 1.261261261261259; 5.805180180180180], 1e-6);
%=============================================================================
asserts.checkerror('mahal()', _('Not enough input arguments.'));
asserts.checkerror('mahal([1 2], [1 2])', _('X must have more rows than columns.'));
asserts.checkerror('mahal({1}, [1; 2])', sprintf(_('%s must be a real numeric matrix.'), 'Y'));
asserts.checkerror('mahal([1; 2], {1})', sprintf(_('%s must be a real numeric matrix.'), 'X'));
asserts.checkerror('mahal([1 2], [1; 2; 3])', sprintf(_('X and Y must have %s.'), 'the same number of columns'));
asserts.checkerror('mahal([1 2], [1 2; 3 4])', _('X must have more rows than columns.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('mdscale'), -3);
asserts.isequal(nargout('mdscale'), 3);
%=============================================================================
X = [0 0; 1 0; 0 2; 2 2];
Dv = pdist(X);
D = squareform(Dv);
[Y, stress, disparities] = mdscale(Dv, 2);
Yexpected = [-1.238218880541527 0.171213328542168; ...
  -0.753450348148581 -0.703429152704649; ...
  0.511066081952108 1.140750393328058; ...
  1.480603146737999 -0.608534569165577];
asserts.isapprox(Y, Yexpected, 1e-12);
asserts.isapprox(stress, 0, 1e-6, 1e-3);
asserts.isapprox(disparities, D, 1e-12);
asserts.isapprox(pdist(Y), Dv, 1e-12);
%=============================================================================
[Ymetric, stressMetric, disparitiesMetric] = mdscale(D, 2, 'Criterion', 'metricstress');
asserts.isapprox(Ymetric, Yexpected, 1e-12);
asserts.isapprox(stressMetric, 0, 1e-6, 1e-3);
asserts.isapprox(disparitiesMetric, D, 1e-12);
%=============================================================================
criteria = {'strain', 'sammon', 'sstress', 'metricsstress'};
for k = 1:length(criteria)
  [Yc, sc, dc] = mdscale(D, 2, 'Criterion', criteria{k});
  asserts.isequal(size(Yc), [4 2]);
  asserts.isapprox(sc, 0, 1e-6, 1e-3);
  asserts.isapprox(dc, D, 1e-12);
end
%=============================================================================
Start = [0 0; 1 0; 0 1; 1 1];
[Ys, ss] = mdscale(D, [], 'Start', Start, 'Criterion', 'metricstress');
asserts.isequal(size(Ys), [4 2]);
asserts.isapprox(ss, 0, 1e-6, 1e-3);
%=============================================================================
S = 1 - D .^ 2 / 10;
S(1:size(S, 1) + 1:end) = 1;
[Ysim, stressSim] = mdscale(S, 2, 'Criterion', 'metricstress');
asserts.isapprox(Ysim, Yexpected / sqrt(10), 1e-12);
asserts.isapprox(stressSim, 0, 1e-6, 1e-3);
%=============================================================================
U = triu(D);
[Yu, stressU] = mdscale(U, 2, 'Criterion', 'metricstress');
asserts.isapprox(Yu, Yexpected, 1e-12);
asserts.isapprox(stressU, 0, 1e-6, 1e-3);
%=============================================================================
W = ones(4);
W(1, 2) = 0;
W(2, 1) = 0;
[Yw, sw, dw] = mdscale(D, 2, 'Weights', W, 'Start', 'random', ...
  'Options', statset('MaxIter', 5));
asserts.isequal(size(Yw), [4 2]);
asserts.istrue(isfinite(sw));
asserts.isequal(size(dw), [4 4]);
%=============================================================================
Dnan = D;
Dnan(1, 2) = NaN;
Dnan(2, 1) = NaN;
[Ynan, snan] = mdscale(Dnan, 2, 'Start', 'random', ...
  'Options', statset('MaxIter', 5));
asserts.isequal(size(Ynan), [4 2]);
asserts.istrue(isfinite(snan));
%=============================================================================
[Yr, sr] = mdscale(D, 2, 'Start', 'random', 'Replicates', 2, ...
  'Options', statset('MaxIter', 5, 'TolFun', 1e-6, 'TolX', 1e-4));
asserts.isequal(size(Yr), [4 2]);
asserts.istrue(isfinite(sr));
%=============================================================================
asserts.checkerror('mdscale()', _('Not enough input arguments.'));
asserts.checkerror('mdscale({1}, 2)', sprintf(_('%s must be a real numeric vector or matrix.'), 'D'));
asserts.checkerror('mdscale([0 Inf; Inf 0], 2)', _('D must contain nonnegative finite dissimilarities.'));
asserts.checkerror('mdscale([0 -1; -1 0], 2)', _('D must contain nonnegative finite dissimilarities.'));
asserts.checkerror('mdscale([0 1 2; 1 0 3], 2)', _('D must be square or a valid distance vector.'));
asserts.checkerror('mdscale([0 1; 2 0], 2)', _('D must be symmetric or upper triangular.'));
asserts.checkerror('mdscale(D, 0)', _('p must be an integer scalar between 1 and the number of points.'));
asserts.checkerror('mdscale(D, 5)', _('p must be an integer scalar between 1 and the number of points.'));
asserts.checkerror('mdscale(D, 2, ''Criterion'', ''bad'')', sprintf(_('Invalid %s value.'), 'Criterion'));
asserts.checkerror('mdscale(D, 2, ''Weights'', [1 2])', _('Weights must have the same size as D.'));
asserts.checkerror('mdscale(D, 2, ''Start'', ''bad'')', sprintf(_('%s has an invalid value.'), 'Start'));
asserts.checkerror('mdscale(D, 2, ''Replicates'', -1)', sprintf(_('%s must be a nonnegative integer scalar.'), 'Replicates'));
asserts.checkerror('mdscale(D, 2, ''Options'', 1)', sprintf(_('%s must be a scalar structure.'), 'Options'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--WEIGHT 2-->
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('mean'), 4)
asserts.isequal(nargout('mean'), 1)
%=============================================================================
R = mean([complex(1, NaN), complex(1, 2)], 'omitnan');
asserts.isequal(R, complex(1, 2));
%=============================================================================
R = mean([complex(1, NaN), complex(1, 2)], 'includenan');
asserts.isequal(R, complex(1, NaN));
%=============================================================================
R = mean([complex(1, NaN), complex(NaN, 2)], 'omitnan');
asserts.isequal(R, NaN);
%=============================================================================
R = mean([complex(1, NaN), complex(NaN, 2)], 'includenan');
asserts.isequal(R, complex(NaN, NaN));
%=============================================================================
R = mean([1 2], 1);
asserts.isequal(R, [1 2]);
%=============================================================================
R = mean([1 2], 2);
asserts.isequal(R, 1.5);
%=============================================================================
R = mean([1 2], 3);
asserts.isequal(R, [1 2]);
%=============================================================================
R = mean(single([1 0 1 1]));
asserts.isequal(R, single(0.75));
%=============================================================================
R = mean(logical([1 0 1 1]));
asserts.isequal(R, 0.75)
%=============================================================================
R = mean([4 4 2]);
asserts.isequal(R, 3 + 1 / 3);
%=============================================================================
R = mean([2 8]);
asserts.isequal(R, 5);
%=============================================================================
R = mean(repmat(0.1, 1, 10000));
asserts.isapprox(R, 0.1000, 1e-4);
%=============================================================================
X = -100:100;
R = mean(X);
asserts.isequal(R, 0);
%=============================================================================
Y = X';
R = mean(Y);
asserts.isequal(R, 0);
%=============================================================================
Z = [Y, Y + 100];
R = mean(Z);
asserts.isequal(R, [0 100]);
%=============================================================================
M = [0 1 1; 2 3 2; 1 3 2; 4 2 2];
R = mean(M);
REF = [1.7500 2.2500 1.7500];
asserts.isapprox(R, REF, 1e-4);
%=============================================================================
R = mean(M, 'all');
REF = 1.9167;
asserts.isapprox(R, REF, 1e-4);
%=============================================================================
R = mean(M, 1);
REF = [1.7500 2.2500 1.7500];
asserts.isapprox(R, REF, 1e-4);
%=============================================================================
R = mean(M, 2);
REF = [0.6667; 2.3333; 2.0000; 2.6667];
asserts.isapprox(R, REF, 1e-4);
%=============================================================================
R = mean(M, 3);
asserts.isequal(R, M);
%=============================================================================
M = [1:24];
M = reshape(M, 3, 2, 4);
R = mean(M, 1);
asserts.isequal(R(:, :, 1), [2, 5]);
asserts.isequal(R(:, :, 2), [8, 11]);
asserts.isequal(R(:, :, 3), [14, 17]);
asserts.isequal(R(:, :, 4), [20, 23]);
%=============================================================================
M = [1:24];
M = reshape(M, 3, 2, 4);
R = mean(M, 'all');
asserts.isequal(R, 12.5);
%=============================================================================
A = single(ones(10, 1));
R = mean(A, 'native');
asserts.isequal(R, single(1));
%=============================================================================
A = single(ones(10, 1));
R = mean(A, 'default');
asserts.isequal(R, single(1));
%=============================================================================
A = single(ones(10, 1));
R = mean(A, 'double');
asserts.isequal(R, double(1));
%=============================================================================
A = [1 0 0 1 NaN 1 NaN 0];
R = mean(A, 'omitnan');
asserts.isequal(R, 0.5);
%=============================================================================
A = [1 0 0 1 NaN 1 NaN 0];
R = mean(A, 'includenan');
asserts.isequal(R, NaN);
%=============================================================================
asserts.isequal(mean([1 NaN 3], 'omitnan'), 2);
asserts.isequal(size(mean(zeros(0, 3), 1)), [1 3]);
%=============================================================================
% mean of a complex array must equal sum(A, dim) ./ size(A, dim) (double and single, all dims, N-D)
Cd = reshape((1:24) + 1i * (24:-1:1), 3, 2, 4);
for d = [1 2 3]
  asserts.isapprox(mean(Cd, d), sum(Cd, d) ./ size(Cd, d), 1e-10);
end
asserts.isapprox(mean(Cd), sum(Cd, 1) ./ size(Cd, 1), 1e-10);
asserts.isapprox(mean(Cd, 'all'), sum(Cd(:)) ./ numel(Cd), 1e-10);
%=============================================================================
Cs = single(Cd);
for d = [1 2 3]
  asserts.isapprox(mean(Cs, d), sum(Cs, d) ./ single(size(Cs, d)), single(1e-4));
end
asserts.isequal(class(mean(Cs, 2)), 'single');
%=============================================================================
% column-vector complex mean along dim 1
Cv = (1:6)' + 1i * (6:-1:1)';
asserts.isapprox(mean(Cv, 1), sum(Cv, 1) ./ size(Cv, 1), 1e-10);
%=============================================================================
% vector of dimensions (vecdim)
A = reshape(1:24, 2, 3, 4);
assert_isequal(mean(A, [1 2]), reshape([3.5 9.5 15.5 21.5], 1, 1, 4));
assert_isequal(mean(A, [1 3]), [10.5 12.5 14.5]);
assert_isequal(mean(A, [1 2 3]), 12.5);
assert_isequal(mean([1 2 3; 4 5 6], [1 2]), 3.5);
assert_checkerror('mean(A, [1 2], ''omitnan'')', 'The ''omitnan'' option is not supported with a vector of dimensions.');
%=============================================================================
% an unknown option name
assert_checkerror('mean([1 2 3], ''foo'')', sprintf(_('Invalid %s argument.'), 'second'), 'Nelson:statistics:invalidValue:invalidArgument');
assert_checkerror('mean([1 2 3], 1, ''foo'')', sprintf(_('Invalid %s argument.'), 'third'), 'Nelson:statistics:invalidValue:invalidArgument');
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
% mean of an empty array reduces the working dimension to 1: the result keeps
% the other dimensions and is NaN (0/0) where it is not empty.
%=============================================================================
asserts.isequal(mean(zeros(0, 3)), NaN(1, 3));
asserts.isequal(mean(zeros(0, 3), 1), NaN(1, 3));
asserts.isequal(mean(zeros(0, 3), 2), zeros(0, 1));
asserts.isequal(mean(zeros(0, 3), 3), zeros(0, 3));
asserts.isequal(mean(zeros(3, 0)), zeros(1, 0));
asserts.isequal(mean(zeros(3, 0), 2), NaN(3, 1));
asserts.isequal(mean(zeros(1, 0)), NaN);
asserts.isequal(mean(zeros(0, 1)), NaN);
asserts.isequal(mean(zeros(0, 3, 2)), NaN(1, 3, 2));
asserts.isequal(mean(zeros(2, 0, 3), 2), NaN(2, 1, 3));
%=============================================================================
% [] (0x0) without dimension gives NaN, with a dimension it follows the rule
asserts.isequal(mean(zeros(0, 0)), NaN);
asserts.isequal(mean([], 1), zeros(1, 0));
asserts.isequal(mean([], 2), zeros(0, 1));
%=============================================================================
% nanflag
asserts.isequal(mean(zeros(0, 3), 'omitnan'), NaN(1, 3));
asserts.isequal(mean(zeros(0, 3), 'includenan'), NaN(1, 3));
asserts.isequal(mean(zeros(3, 0), 2, 'omitnan'), NaN(3, 1));
%=============================================================================
% vector of dimensions and 'all'
asserts.isequal(mean(zeros(0, 3), [1 2]), NaN);
asserts.isequal(mean(zeros(0, 3), 'all'), NaN);
%=============================================================================
% output classes
asserts.isequal(mean(single(zeros(0, 3))), single(NaN(1, 3)));
asserts.isequal(mean(single(zeros(0, 3)), 'double'), NaN(1, 3));
asserts.isequal(mean(single(zeros(0, 3)), 'native'), single(NaN(1, 3)));
asserts.isequal(mean(int8(zeros(0, 3))), NaN(1, 3));
asserts.isequal(mean(int8(zeros(0, 3)), 'double'), NaN(1, 3));
asserts.isequal(mean(int8(zeros(0, 3)), 'native'), int8([0 0 0]));
asserts.isequal(mean(uint16(zeros(3, 0)), 2, 'native'), uint16([0; 0; 0]));
asserts.isequal(mean(int32(zeros(0, 3)), 1, 'omitnan', 'native'), int32([0 0 0]));
asserts.isequal(mean(int8(zeros(0, 0)), 'native'), int8(0));
asserts.isequal(mean(int8(zeros(0, 3)), 'all', 'native'), int8(0));
asserts.isequal(mean(false(0, 3)), NaN(1, 3));
asserts.isequal(mean(char(zeros(0, 3))), NaN(1, 3));
asserts.isequal(mean(int8(zeros(0, 3)), 2, 'native'), int8(zeros(0, 1)));
