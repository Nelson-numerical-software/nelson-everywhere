  global ODE_OUTPUT_RECORDER_LOG;
  if isempty(ODE_OUTPUT_RECORDER_LOG)
    ODE_OUTPUT_RECORDER_LOG = {};
  end
  entry = struct();
  entry.flag = flag;
  entry.t = t;
  entry.y = y;
  ODE_OUTPUT_RECORDER_LOG{end + 1} = entry;
  stop = false;
end
