% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = ellip(varargin)
  narginchk(4, 5);
  nargoutchk(0, 3);
  n = varargin{1};
  rp = varargin{2};
  rs = varargin{3};
  wn = varargin{4};
  ftype = '';
  if nargin == 5
    ftype = varargin{5};
  end
  mustBeInteger(n);
  mustBePositive(n);
  [z, p] = signalEllipPrototype(n, rp, rs);
  [z, p, k, b, a] = signalIirPrototypeToDigital(z, p, n, rp, wn, ftype);
  if nargout <= 2
    varargout{1} = b;
    if nargout > 1
      varargout{2} = a;
    end
  else
    varargout{1} = z;
    varargout{2} = p;
    varargout{3} = k;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [n, wn] = ellipord(varargin)
  narginchk(4, 4);
  nargoutchk(0, 2);
  wp = varargin{1};
  ws = varargin{2};
  rp = varargin{3};
  rs = varargin{4};
  passband = tan(pi * wp(:).' / 2);
  stopband = tan(pi * ws(:).' / 2);
  if length(wp) == 1 && length(ws) == 1
    if ws > wp
      ratio = stopband / passband;
    else
      ratio = passband / stopband;
    end
  elseif length(wp) == 2 && length(ws) == 2
    if ws(1) < wp(1) && wp(2) < ws(2)
      bandwidth = passband(2) - passband(1);
      center2 = passband(1) * passband(2);
      ratio = min(abs((stopband .^ 2 - center2) ./ (bandwidth * stopband)));
    elseif wp(1) < ws(1) && ws(2) < wp(2)
      bandwidth = stopband(2) - stopband(1);
      center2 = stopband(1) * stopband(2);
      ratio = min(abs((passband .^ 2 - center2) ./ (bandwidth * passband)));
    else
      error('Nelson:signal:inconsistentFrequencies', 'Passband and stopband frequencies are inconsistent.');
    end
  else
    error('Nelson:dimagree:valueLength', '%s must have the same length.', 'Passband and stopband frequencies');
  end
  passbandFactor = 10 ^ (rp / 10) - 1;
  stopbandFactor = 10 ^ (rs / 10) - 1;
  k0 = 1 / ratio;
  k1 = sqrt(passbandFactor / stopbandFactor);
  d0a = signalEllipke(k0 ^ 2);
  d0b = signalEllipke(1 - k0 ^ 2);
  d1a = signalEllipke(k1 ^ 2);
  d1b = signalEllipke(1 - k1 ^ 2);
  n = ceil(d0a * d1b / (d0b * d1a));
  wn = wp;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
