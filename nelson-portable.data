% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% Convention used:
% Ts > 0: Discrete-time model.
% Ts = 0: Continuous-time model.
% Ts = -1: Discrete-time model with unspecified sampling time.
function res = isstatic(sys)
  res = isempty(sys.A);
end
%=============================================================================

%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = length(varargin)
  narginchk(1, 1);
  nargoutchk(0, 1);
  [m, n, p] = size(varargin{1});
  varargout{1} = m * n;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2017 October Daniel Mårtensson (Swedish Embedded Control Systems Toolbox)
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = lqr(varargin)
  % Compute the LQR gain matrix control law L with the weighing matrices Q and R
  % [K, S, e] = lqr(SYS, Q, R, N)
  narginchk(3, 5);
  nargoutchk(0, 3);
  sys = varargin{1};
  Q = varargin{2};
  R = varargin{3};
  [rB, cB] = size(sys.B);
  if nargin > 3
    N = varargin{4};
  else
    N = zeros(rB, cB);
  end

  if nargin > 4
    E = varargin{5};
  else
    E = eye(rB, rB);
  end
  Ts = sys.Ts;
  if (Ts > 0) || (Ts == -1)
    [S, e, K] = dare(sys.A, sys.B, Q, R, N, E);
  else
    [S, e, K] = care(sys.A, sys.B, Q, R, N, E);
  end

  varargout{1} = K;
  if nargout > 1
    varargout{2} = S;
  end

  if nargout > 2
    varargout{3} = e;
  end
end
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = lqry(varargin)
  % Form linear-quadratic (LQ) state-feedback regulator with output weighting
  % [K, S, e] = lqry(sys, Q, R)
  % [K, S, e] = lqry(sys, Q, R, N)
  narginchk(3, 4);
  nargoutchk(0, 3);

  sys = varargin{1};
  Q = varargin{2};
  R = varargin{3};

  mustBeNumeric(Q, 2);
  mustBeNumeric(R, 3);
  if nargin == 4
    N = varargin{4};
  else
    N = zeros(size(Q, 1), size(R, 1));
  end
  mustBeNumeric(R, 4);
  E = sys.E;
  if ~isempty(E) && rcond(E) < eps()
    error('Nelson:control_system:wrongValue:wrongValueArgument1SysEX', 'Wrong value for argument #1: sys.E must not be singular.');
  end

  rA = size(sys.A, 1);
  if isempty(E)
    E = eye(rA, rA);
  end

  nd = N' * sys.D;

  qmod = sys.C' * Q * sys.C;
  rmod = R + sys.D' * Q * sys.D + nd + nd';
  nmod = sys.C' * (Q * sys.D + N);

  qmod = symmetrize(qmod);
  rmod = symmetrize(rmod);
  [Veig, eigVals] = eig(rmod);
  vr = real(diag(eigVals));
  if min(vr) <= 0
    error('Nelson:control_system:wrongValue:wrongValueInputArguments56', 'Wrong value for input arguments #5 or #6: result must be positive definite.');
  end

  [Veig, eigVals] = eig([qmod, nmod; nmod', rmod]);
  vqnr = real(diag(eigVals));

  [K, S, e] = lqr(sys.A, sys.B, qmod, rmod, nmod, sys.E);
  varargout{1} = K;
  if nargout > 1
    varargout{2} = S;
  end
  if nargout > 2
    varargout{3} = e;
  end
end
%=============================================================================
function result = symmetrize(m)
  result = (m + m') / 2;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2017 October Daniel Mårtensson (Swedish Embedded Control Systems Toolbox)
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = minreal(varargin)
  % Minimal realization and pole-zero cancellation.
  % sysOut = minreal(sysIn)
  % sysOut = minreal(sysIn, tol)
  narginchk(1, 2);
  nargoutchk(0, 1);

  sysIn = varargin{1};

  if nargin < 2
    tol = 1e-6;
  else
    tol = varargin{2};
  end

  [am, bm, cm, dm] = minreal(sysIn.A, sysIn.B, sysIn.C, sysIn.D, tol);
  varargout{1} = ss(am, bm, cm, dm, sysIn.Ts);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function sys = minus(sys1, sys2)
  sysA = ss(sys1);
  sysB = ss(sys2);

  % smart version
  sys = sysA + (-sysB);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = mldivide(varargin)
  narginchk(2, 2),
  nargoutchk(0, 1);
  sysA = ss(varargin{1});
  sysB = ss(varargin{2});
  sys = inv(sysA) * sysB;
  varargout{1} = sys;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = mpower(varargin)
  narginchk(2, 2)
  nargoutchk(0, 1)
  sysA = ss(varargin{1});
  n = varargin{2};
  mustBeNumeric(n, 2);
  mustBeInteger(n, 2);
  mustBeScalarOrEmpty(n, 2);
  mustBeNonempty(n, 2);
  if (n == 0)
    varargout{1} = ss(1);
    return;
  end
  sys = sysA;
  for k = 2:abs(n)
    sys = sys * sysA;
  end
  if n < 0
    sys = inv(sys);
  end
  varargout{1} = sys;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = mrdivide(varargin)
  sys1 = ss(varargin{1});
  sys2 = ss(varargin{2});
  varargout{1} = sys1 * inv(sys2);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function sys = mtimes(sys1, sys2)
  sysA = ss(sys1);
  sysB = ss(sys2);

  Ts = ltiResolveSampleTime(sysA, sysB);
  if isempty(sysA.A) && isempty(sysA.B) && isempty(sysA.C) && isscalar(sysA.D)
    A = sysB.A;
    B = sysA.D * sysB.B;
    C = sysB.C;
    D = sysA.D * sysB.D;
  else
    if isempty(sysB.A) && isempty(sysB.B) && isempty(sysB.C) && isscalar(sysB.D)
      A = sysA.A;
      B = sysB.D * sysA.B;
      C = sysA.C;
      D = sysA.D * sysB.D;
    else
      [pA, mA] = size(sysA);
      [pB, mB] = size(sysB);
      if (mA ~= pA)
        error('Nelson:control_system:dimagree:matrixDimensionsAgree', 'Matrix dimensions must agree.');
      end
      A = [[sysA.A, sysA.B * sysB.C]; [zeros(size(sysB.A, 1), size(sysA.A, 2)), sysB.A]];
      B = [sysA.B * sysB.D; sysB.B];
      C = [sysA.C, sysA.D * sysB.C];
      D = sysA.D * sysB.D;
    end
  end

  sys = ss(A, B, C, D, Ts);
  sys.E = computesE(sysA.E, sysB.E, size(sysA.A, 1), size(sysB.A, 1));
  sys = ltiApplySeriesMetadata(sys, sysA, sysB);
  userData = ltiMergeUserData(sysA, sysB);
  if ~isempty(userData)
    sys.UserData = userData;
  end
end
%=============================================================================
function E = computesE(E1, E2, n1, n2)
  if ~isempty(E1) || ~isempty(E2)
    if isempty(E1)
      E1 = eye(n1, 'like', E2);
    elseif isempty(E2)
      E2 = eye(n2, 'like', E1);
    end
    E = zeros(n1 + n2, n1 + n2);
    E(1:n1, 1:n1) = E1;
    E(n1 + 1:n1 + n2, n1 + 1:n1 + n2) = E2;
  else
    E = [];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function sys = plus(sys1, sys2)
  sysA = ss(sys1);
  sysB = ss(sys2);

  % basic implementation could be replaced with slicot function.
  A = blkdiag(sysA.A, sysB.A);
  B = [sysA.B; sysB.B];
  C = [sysA.C, sysB.C];
  D = sysA.D + sysB.D;

  Ts = ltiResolveSampleTime(sysA, sysB);
  sys = ss(A, B, C, D, Ts);
  sys = ltiApplyCommonMetadata(sys, sysA, sysB);

  userData = ltiMergeUserData(sysA, sysB);
  if ~isempty(userData)
    sys.UserData = userData;
  end

end
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = properties(obj)
  props = ltiPropertyNames(class(obj));
  if (nargout == 0)
    currentFormat = format();
    if strcmp(currentFormat.LineSpacing, 'loose')
      disp(' ');
    end
    disp('Properties for class ss:');
    if strcmp(currentFormat.LineSpacing, 'loose')
      disp(' ');
    end
    for p = props'
      disp(['    ', p{1}]);
    end
    if strcmp(currentFormat.LineSpacing, 'loose')
      disp(' ');
    end
  else
    varargout{1} = props;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = size(varargin)
  narginchk(1, 2);
  nargoutchk(0, 2);

  sys = varargin{1};
  p = 0; % Number of outputs
  m = 0; % Number of inputs
  n = 0; % Number of states
  if isempty(sys.A) && isempty(sys.B) && isempty(sys.C) && ~isempty(sys.D)
    p = size(sys.D, 1);
    m = size(sys.D, 2);
    n = size(sys.A, 1);
  else
    p = size(sys.C, 1);
    m = size(sys.B, 2);
    n = size(sys.A, 1);
  end

  if (nargout == 0 && nargin == 1)
    disp(sprintf(_('State-space model with %d outputs, %d inputs, and %d states.'), p, m, n));
  else
    if (nargin == 2)
      pos = varargin{2};
      if (pos < 1)
        error('Nelson:validators:mustBePositiveInteger', '%s must be a positive integer.', 'Second argument');
      end
      switch pos
        case 1
          varargout{1} = p;
        case 2
          varargout{1} = m;
        case 3
          varargout{1} = n;
        otherwise
          varargout{1} = 1;
      end
    else
      varargout{1} = p;
      if nargout > 1
        varargout{2} = m;
      end
      if nargout > 2
        varargout{3} = n;
      end
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2017 September Daniel Mårtensson (Swedish Embedded Control Systems Toolbox)
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
classdef ss
  properties
    A = []
    B = []
    C = []
    D = []
    E = []
    Offsets = []
    Scaled = false
    StateName = {}
    StatePath = {}
    StateUnit = {}
    InternalDelay = []
    InputDelay = 0
    OutputDelay = 0
    InputName = {}
    InputUnit = {}
    InputGroup = []
    OutputName = {}
    OutputUnit = {}
    OutputGroup = []
    Notes = []
    UserData = []
    SamplingGrid = []
  end

  properties (Dependent)
    Name
    Ts
    TimeUnit
  end

  properties (Hidden)
    NameValue = ''
    TsValue = 0
    TimeUnitValue = 'seconds'
    Internal = []
  end

  methods
    function obj = ss(varargin)
      nargoutchk(0, 1);
      obj.Internal.Version = 1;
      obj.Internal.Ts = 0;
      obj.Internal.IsStatic = false;
      if nargin == 0
        return
      end
      [dataArgs, propertyArgs] = splitConstructorArguments(varargin);
      obj = constructStateSpace(obj, dataArgs);
      obj = applyPropertyPairs(obj, propertyArgs);
    end

    function value = get.Ts(obj)
      value = obj.TsValue;
    end

    function obj = set.Ts(obj, value)
      value = ltiValidateSampleTime(value);
      obj.TsValue = value;
      obj.Internal.Ts = value;
      obj.Internal.IsStatic = false;
    end

    function value = get.TimeUnit(obj)
      value = obj.TimeUnitValue;
    end

    function obj = set.TimeUnit(obj, value)
      value = ltiValidateTimeUnit(value);
      obj.TimeUnitValue = value;
    end

    function value = get.Name(obj)
      value = obj.NameValue;
    end

    function obj = set.Name(obj, value)
      obj.NameValue = ltiValidateTextScalar('Name', value);
    end

    function st = struct(obj)
      st = builtin('struct');
      names = ltiPropertyNames('ss');
      for k = 1:length(names)
        name = names{k};
        st.(name) = obj.(name);
      end
      st.Internal = obj.Internal;
    end
  end
end
%=============================================================================
function [dataArgs, propertyArgs] = splitConstructorArguments(args)
  propertyStart = length(args) + 1;
  for k = 1:length(args)
    if isTextScalar(args{k}) && ~(k == 2 && islti(args{1}))
      propertyStart = k;
      break
    end
  end
  dataArgs = args(1:propertyStart - 1);
  propertyArgs = args(propertyStart:end);
end
%=============================================================================
function obj = constructStateSpace(obj, args)
  switch length(args)
    case 0
      return
    case 1
      obj = ssOneArgument(obj, args{1});
    case 4
      obj = ssFromABCD(obj, args{1}, args{2}, args{3}, args{4}, 0);
    case 5
      obj = ssFromABCD(obj, args{1}, args{2}, args{3}, args{4}, args{5});
    otherwise
      error('Nelson:control_system:wrongNumberOfArguments', 'Wrong number of input arguments.');
  end
end
%=============================================================================
function obj = ssOneArgument(obj, value)
  if islti(value)
    if isa(value, 'ss')
      obj = value;
    elseif isa(value, 'tf')
      obj = tfToSs(value);
    else
      error('Nelson:control_system:invalidType', '%s expected.', 'Supported LTI model')
    end
    return
  end
  obj = ssStaticGain(obj, value);
end
%=============================================================================
function obj = ssFromABCD(obj, A, B, C, D, Ts)
  ltiValidateSampleTime(Ts);
  obj = ssABCD(obj, A, B, C, D, Ts);
end
%=============================================================================
function obj = ssStaticGain(obj, value)
  obj.B = zeros(0, size(value, 2));
  obj.C = zeros(size(value, 1), 0);
  obj.D = value;
  obj.Ts = 0;
  obj.Internal.Ts = -2;
  obj.Internal.IsStatic = true;
end
%=============================================================================
function obj = tfToSs(sysIn)
  if ~issiso(sysIn)
    error('Nelson:control_system:invalidType', '%s expected.', 'SISO LTI model');
  end
  Ts = sysIn.Ts;
  numerator = sysIn.Numerator{1};
  denominator = sysIn.Denominator{1};
  isemptytf = isempty(numerator) && isempty(denominator);
  A = [];
  B = [];
  C = [];
  D = [];
  if ~isemptytf
    [A, B, C, D] = compreal(numerator, denominator);
  end
  obj = ss(A, B, C, D, Ts);
  obj = ltiCopyModelMetadata(obj, sysIn);
end
%=============================================================================
function obj = ssABCD(obj, A, B, C, D, Ts)
  [A, B, C, D, Ts] = adaptABCD(A, B, C, D, Ts);
  msg = checkABCDELocal(A, B, C, D);
  if ~isempty(msg)
    error(msg.identifier, msg.message);
  end
  obj.A = A;
  obj.B = B;
  obj.C = C;
  obj.D = D;
  if isequal(Ts, -2)
    obj.Ts = 0;
    obj.Internal.Ts = -2;
    obj.Internal.IsStatic = true;
  else
    obj.Ts = Ts;
    obj.Internal.Ts = Ts;
    obj.Internal.IsStatic = false;
  end
end
%=============================================================================
function [A, B, C, D, Ts] = adaptABCD(A, B, C, D, Ts)
  isDZero = isscalar(D) && D(1) == 0;
  if isempty(A) && isempty(B) && isempty(C)
    [m, n] = size(D);
    A = [];
    B = zeros(0, n);
    C = zeros(m, 0);
    Ts = -2;
    return
  end
  newRowCount = max(size(C, 1), size(D, 1));
  if isempty(C)
    C = eye(newRowCount, size(A, 1));
  end
  if isempty(D) || isDZero
    D = zeros(newRowCount, size(B, 2));
  end
end
%=============================================================================
function msg = checkABCDELocal(varargin)
  if nargin == 5
    E = varargin{5};
  else
    E = [];
  end
  A = varargin{1};
  B = varargin{2};
  C = varargin{3};
  D = varargin{4};
  [mA, nA] = size(A);
  [mB, nB] = size(B);
  [mC, nC] = size(C);
  [mD, nD] = size(D);
  [mE, nE] = size(E);
  msg.message = '';
  msg.identifier = '';
  msg = msg(zeros(0, 1));
  if mA ~= nA
    msg.message = sprintf(_('%s must be square.'), 'Matrix A');
    msg.identifier = 'Nelson:expectedSquare';
    return
  end
  if mB ~= mA
    msg.message = sprintf(_('The number of rows in matrices %s and %s must be equal.'), 'A', 'B');
    msg.identifier = 'Nelson:control_system:AAndBNumRowsMismatch';
    return
  end
  if nC ~= nA
    msg.message = sprintf(_('Matrices %s and %s should have an identical number of columns.'), 'A', 'C');
    msg.identifier = 'Nelson:control_system:AAndCNumColumnsMismatch';
    return
  end
  if nB ~= nD
    msg.message = sprintf(_('Matrices %s and %s should have an identical number of columns.'), 'B', 'D');
    msg.identifier = 'Nelson:control_system:BAndDNumColumnsMismatch';
    return
  end
  if mC ~= mD
    msg.message = sprintf(_('The number of rows in matrices %s and %s must be equal.'), 'C', 'D');
    msg.identifier = 'Nelson:control_system:CAndDNumRowsMismatch';
    return
  end
  if ~isempty(E) && (mA ~= mE || nA ~= nE)
    msg.message = sprintf(_('Matrices %s and %s should have an identical size.'), 'A', 'E');
    msg.identifier = 'Nelson:control_system:AAndESizeMismatch';
  end
end
%=============================================================================
function obj = applyPropertyPairs(obj, args)
  if isempty(args)
    return
  end
  if mod(length(args), 2) ~= 0
    error('Nelson:control_system:nameValuePair', '%s expected.', 'Name-value arguments');
  end
  for k = 1:2:length(args)
    name = resolvePropertyName(args{k}, ltiPropertyNames('ss'));
    obj.(name) = args{k + 1};
  end
end
function tf = isTextScalar(value)
  tf = ischar(value) || isStringScalar(value);
end
function name = resolvePropertyName(value, supported)
  value = ltiValidateTextScalar('Name', value);
  matches = startsWith(upper(supported), upper(value));
  if sum(matches) == 0
    error('Nelson:control_system:unknownParameter', '"%s" is not a recognized parameter.', value);
  end
  if sum(matches) > 1
    error('Nelson:control_system:ambiguousParameter', '"%s" matches multiple parameters.', value);
  end
  name = supported{find(matches, 1)};
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = subsasgn(varargin)
  obj = varargin{1};
  s = varargin{2};
  value = varargin{3};
  if strcmp(s(1).type, '()')
    if length(s) > 1
      currentValue = subsref(obj, s(1));
      value = subsasgn(currentValue, s(2:end), value);
    end
    obj = assignSubsystem(obj, s(1).subs, value);
    varargout{1} = obj;
    return
  end
  if strcmp(s(1).type, '{}')
    error('Nelson:control_system:invalidSubscript:illegalIndexingStructureArgumentTypeValue', 'Illegal indexing structure argument: type %s expected.', "'.' or '()'");
  end
  if ~strcmp(s(1).type, '.')
    error('Nelson:control_system:invalidSubscript:notAValidIndexingExpression', 'Not a valid indexing expression');
  end
  name = s(1).subs;
  if ~isprop(obj, name)
    msg = _('No property of the class ''%s'' matches the identifier ''%s''.');
    error('Nelson:control_system:unknownProperty', sprintf(msg, 'ss', name));
  end
  if length(s) > 1
    currentValue = ltiSubscriptGet(obj, name);
    value = subsasgn(currentValue, s(2:end), value);
  end
  switch name
    case 'Ts'
      obj.Ts = ltiValidateSampleTime(value);
      obj.Internal.Ts = obj.Ts;
      obj.Internal.IsStatic = false;
    case 'TimeUnit'
      obj.TimeUnit = ltiValidateTimeUnit(value);
    case 'Name'
      obj.Name = ltiValidateTextScalar('Name', value);
    otherwise
      obj = ltiSubscriptSet(obj, name, value);
  end
  varargout{1} = obj;
end
%=============================================================================
function obj = assignSubsystem(obj, indices, value)
  if length(indices) ~= 2
    error('Nelson:control_system:invalidSubscript', '%s expected.', 'Two indices');
  end
  value = ss(value);
  ltiCheckSampleTimeCompatibility(obj, value);
  outputs = indices{1};
  inputs = indices{2};
  D = obj.D;
  D(outputs, inputs) = value.D;
  obj.D = D;
  if isempty(obj.A) && isempty(value.A)
    return
  end
  if ~isequal(obj.A, value.A)
    if isempty(value.A)
      return
    end
    error('Nelson:control_system:invalidAssignment', 'State-space assignment must preserve the state matrix.');
  end
  B = obj.B;
  C = obj.C;
  if ~isempty(B) && ~isempty(value.B)
    B(:, inputs) = value.B;
    obj.B = B;
  end
  if ~isempty(C) && ~isempty(value.C)
    C(outputs, :) = value.C;
    obj.C = C;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = subsref(varargin)
  obj = varargin{1};
  s = varargin{2};
  if strcmp(s(1).type, '()')
    if length(s) > 1
      partial = subsref(obj, s(1));
      [varargout{1:nargout}] = subsref(partial, s(2:end));
      return
    end
    indices = s(1).subs;
    if length(indices) ~= 2
      error('Nelson:control_system:invalidSubscript', '%s expected.', 'Two indices');
    end
    outputs = indices{1};
    inputs = indices{2};
    A = ltiSubscriptGet(obj, 'A');
    B = ltiSubscriptGet(obj, 'B');
    C = ltiSubscriptGet(obj, 'C');
    D = ltiSubscriptGet(obj, 'D');
    if ~isempty(B)
      B = B(:, inputs);
    end
    if ~isempty(C)
      C = C(outputs, :);
    end
    if ~isempty(D)
      D = D(outputs, inputs);
    end
    sys = ss(A, B, C, D, ltiSubscriptGet(obj, 'Ts'));
    sys.E = ltiSubscriptGet(obj, 'E');
    sys.Scaled = ltiSubscriptGet(obj, 'Scaled');
    sys.TimeUnit = ltiSubscriptGet(obj, 'TimeUnit');
    sys.UserData = ltiSubscriptGet(obj, 'UserData');
    sys.InputName = ltiSelectIOProperty(ltiSubscriptGet(obj, 'InputName'), inputs);
    sys.InputUnit = ltiSelectIOProperty(ltiSubscriptGet(obj, 'InputUnit'), inputs);
    sys.OutputName = ltiSelectIOProperty(ltiSubscriptGet(obj, 'OutputName'), outputs);
    sys.OutputUnit = ltiSelectIOProperty(ltiSubscriptGet(obj, 'OutputUnit'), outputs);
    varargout{1} = sys;
    return
  end
  if strcmp(s(1).type, '{}')
    error('Nelson:control_system:invalidSubscript:illegalIndexingStructureArgumentTypeValue', 'Illegal indexing structure argument: type %s expected.', "'.'");
  end
  if ~strcmp(s(1).type, '.')
    error('Nelson:control_system:invalidSubscript:notAValidIndexingExpression', 'Not a valid indexing expression');
  end
  value = ltiSubscriptGet(obj, s(1).subs);
  if length(s) > 1
    [varargout{1:nargout}] = subsref(value, s(2:end));
  else
    varargout{1} = value;
  end
end
