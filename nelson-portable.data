%=============================================================================
function packageInfo = nmm_latest(varargin)
  if length(varargin) < 1 || length(varargin) > 2
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  packageName = varargin{1};
  versionSpec = '';
  if length(varargin) == 2
    versionSpec = varargin{2};
  end
  if ~ischar(packageName)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 2);
  end
  if ~ischar(versionSpec)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 3);
  end
  versions = nmm_registry('versions', packageName);
  packageInfo = struct([]);
  for k = 1:length(versions)
    if ~isempty(versionSpec) && ~nmm_satisfies(versions{k}, versionSpec)
      continue
    end
    candidate = nmm_registry('info', packageName, versions{k});
    if packageIsCompatible(candidate)
      packageInfo = latestPackage(packageInfo, candidate);
    end
  end
  if isempty(packageInfo)
    nmm_error('NoCompatiblePackageFound', 'No compatible package found: %s', packageName);
  end
end
%=============================================================================
function tf = packageIsCompatible(packageInfo)
  tf = true;
  if isfield(packageInfo, 'platforms')
    [tf, ~] = nmm_is_supported_platform(packageInfo.platforms);
    if ~tf
      return
    end
  end
  if isfield(packageInfo, 'nelson')
    tf = nmm_satisfies(nelsonVersionString(), packageInfo.nelson);
  end
end
%=============================================================================
function selected = latestPackage(selected, candidate)
  if isempty(selected) || semver(candidate.version, selected.version) == 1
    selected = candidate;
  end
end
%=============================================================================
function s = nelsonVersionString()
  v = version('-number');
  s = sprintf('%d.%d.%d', v(1), v(2), v(3));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function st = nmm_list(varargin)
  [args, jsonOutput] = nmm_json_option(varargin);
  if ~isempty(args)
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  p = usermodulesdir();
  modules_json_path = [p, 'modules.json'];
  if isfile(modules_json_path)
    st = jsondecode(modules_json_path, '-file');
    if isempty(st) && isdouble(st)
      st = struct([]);
    end
  else
    st = struct([]);
  end
  st = nmm_json_output(st, jsonOutput);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function nmm_load(varargin)
  nbArguments = length(varargin);
  if nbArguments < 1 || nbArguments > 2
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  if nbArguments == 1
    [module_name, module_data] = nmm_find_installed_module(varargin{1});
  else
    if ~ischar(varargin{2})
      nmm_error('CharactersExpected', '#%d argument: characters expected.', 3);
    end
    [module_name, module_data] = nmm_find_installed_module(varargin{1}, varargin{2});
  end

  if isempty(module_data)
    nmm_error('ModuleNameExpected', 'module name or existing directory installed is expected.');
  end
  if ~isfile([module_data.path, 'loader.m'])
    nmm_error('LoaderMissing', 'loader.m is missing.');
  end
  if ~isfile([module_data.path, 'module.json'])
    nmm_error('ModuleJsonMissing', 'module.json is missing.');
  end
  if ismodule(module_name)
    if nbArguments == 1
      current = currentInstalledModule(module_name);
      if ~isempty(current) && isfield(current, 'path') && strcmp(current.path, module_data.path)
        warning('Nelson:module:alreadyLoaded', '%s already loaded.', module_name);
        return
      end
    end
    removemodule(module_name);
  end
  if nbArguments == 2
    activateInstalledVersion(module_name, module_data);
  end
  removeInstalledFunctionPaths(module_name);
  clear functions
  if ~ismodule(module_name)
    run([module_data.path, 'loader.m']);
  end
end
%=============================================================================
function module_data = currentInstalledModule(module_name)
  module_data = struct([]);
  modules = nmm_list();
  if isfield(modules, module_name)
    module_data = getfield(modules, module_name);
  end
end
%=============================================================================
function activateInstalledVersion(module_name, module_data)
  modules = nmm_list();
  if ~isfield(modules, module_name)
    return
  end
  current = getfield(modules, module_name);
  current.path = module_data.path;
  current.version = module_data.version;
  current.load = true;
  modules.(module_name) = current;
  filewrite([usermodulesdir(), 'modules.json'], jsonprettyprint(jsonencode(modules)));
end
%=============================================================================
function removeInstalledFunctionPaths(module_name)
  modules = nmm_list();
  if ~isfield(modules, module_name)
    return
  end
  module_data = getfield(modules, module_name);
  versions = installedVersions(module_data);
  currentPath = path();
  for k = 1:length(versions)
    functionsPath = [versions(k).path, 'functions'];
    if isdir(functionsPath) && contains(currentPath, functionsPath)
      rmpath(functionsPath);
    end
  end
end
%=============================================================================
function versions = installedVersions(module_data)
  versions = struct([]);
  if isfield(module_data, 'versions') && ~isempty(module_data.versions)
    versions = module_data.versions;
    return
  end
  if isfield(module_data, 'path') && isfield(module_data, 'version')
    versions = module_data;
    if isfield(versions, 'versions')
      versions = rmfield(versions, 'versions');
    end
    if isfield(versions, 'pinned_version')
      versions = rmfield(versions, 'pinned_version');
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function lock = nmm_lock(varargin)
  if length(varargin) < 1 || length(varargin) > 2
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  module_path = varargin{1};
  if ~ischar(module_path)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 2);
  end
  option = '';
  if length(varargin) == 2
    option = varargin{2};
    if ~ischar(option)
      nmm_error('CharactersExpected', '#%d argument: characters expected.', 3);
    end
  end
  module_path = ensureTrailingSlash(module_path);
  switch option
    case ''
      lock = writeModuleLock(module_path);
    case '-dry-run'
      lock = computeModuleLock(module_path);
    case {'-check', '-diff'}
      lock = lockReport(module_path, option);
    otherwise
      nmm_error('InvalidOptionExpected', '%s expected.', sprintf('#%d argument: ''-dry-run'', ''-check'' or ''-diff''', 3));
  end
end
%=============================================================================
function lock = writeModuleLock(module_path)
  nmm_validate(module_path);
  if isfile([module_path, 'builder.m'])
    run([module_path, 'builder.m']);
  end
  if ~isfile([module_path, 'loader.m'])
    nmm_error('LoaderMissing', 'loader.m is missing.');
  end
  lock = buildModuleLock(module_path);
  filewrite([module_path, 'module-lock.json'], jsonprettyprint(jsonencode(lock)));
end
%=============================================================================
function lock = computeModuleLock(module_path)
  nmm_validate(module_path);
  stagingPath = newTemporaryDirectory();
  try
    copyfile(module_path, stagingPath, 'f');
    if isfile([stagingPath, 'builder.m'])
      run([stagingPath, 'builder.m']);
    end
    if ~isfile([stagingPath, 'loader.m'])
      nmm_error('LoaderMissing', 'loader.m is missing.');
    end
    lock = buildModuleLock(stagingPath);
    cleanupDirectory(stagingPath);
  catch
    e = lasterror();
    cleanupDirectory(stagingPath);
    error(e);
  end
end
%=============================================================================
function report = lockReport(module_path, option)
  expected = computeModuleLock(module_path);
  current = readCurrentLock(module_path);
  differences = lockDifferences(current, expected);
  report = struct();
  report.ok = isempty(differences);
  report.up_to_date = report.ok;
  report.module = expected.module;
  report.version = expected.version;
  report.lockfile = [module_path, 'module-lock.json'];
  report.differences = differences;
  if strcmp(option, '-diff')
    report.current = current;
    report.expected = expected;
  end
end
%=============================================================================
function current = readCurrentLock(module_path)
  lockfile = [module_path, 'module-lock.json'];
  current = struct([]);
  if isfile(lockfile)
    current = jsondecode(lockfile, '-file');
  end
end
%=============================================================================
function differences = lockDifferences(current, expected)
  differences = {};
  if isempty(current)
    differences{end + 1} = _('module-lock.json is missing.');
    return
  end
  fields = unionFields(fieldnames(current), fieldnames(expected));
  for k = 1:length(fields)
    name = fields{k};
    if ~isfield(current, name)
      differences{end + 1} = ['missing field: ', name];
    elseif ~isfield(expected, name)
      differences{end + 1} = ['unexpected field: ', name];
    elseif ~strcmp(jsonencode(current.(name)), jsonencode(expected.(name)))
      differences{end + 1} = ['changed field: ', name];
    end
  end
end
%=============================================================================
function fields = unionFields(left, right)
  fields = left(:)';
  for k = 1:length(right)
    if ~any(strcmp(fields, right{k}))
      fields{end + 1} = right{k};
    end
  end
end
%=============================================================================
function lock = buildModuleLock(module_path)
  info = nmm_read_module_json(module_path);
  lock.module = info.module;
  lock.version = info.version;
  lock.lock = 2;
  lock.lock_format = 'nelson.nmm.lock/2';
  if info.builtin
    lock.platform = computer('arch');
  else
    lock.platform = 'all';
  end
  lock.builtin = info.builtin;
  lock.package_type = packageType(info);
  source = struct();
  source.type = 'source';
  source.reference = '';
  lock.source = source;
  nelson = struct();
  nelson.version = nelsonVersionString();
  nelson.arch = computer('arch');
  nelson.abi = nelsonAbiTag();
  lock.nelson = nelson;
  lock.checksums = lockChecksums(module_path);
  lock.dependencies = lockedDependencies(info);
end
%=============================================================================
function type = packageType(info)
  if info.builtin
    type = 'binary';
  else
    type = 'source';
  end
end
%=============================================================================
function dependencies = lockedDependencies(info)
  dependencies = struct();
  if ~isfield(info, 'dependencies')
    return
  end
  modules = nmm_list();
  for dependency = fieldnames(info.dependencies)'
    name = dependency{1};
    if ~isfield(modules, name)
      nmm_error('DependencyNotInstalled', '%s not installed.', name);
    end
    moduleInfo = getfield(modules, name);
    dependencies.(name) = moduleInfo.version;
  end
end
%=============================================================================
function checksums = lockChecksums(module_path)
  root = ensureTrailingSlash(module_path);
  checksums = struct();
  checksums = addFileChecksum(checksums, 'module_json', [root, 'module.json']);
  checksums = addFileChecksum(checksums, 'loader', [root, 'loader.m']);
  % builder.m is a build-only script excluded from the package (see
  % nmm_pack_default_excludes), so it is not part of the shipped checksums.
  checksums = addFileChecksum(checksums, 'etc_startup', [root, 'etc/startup.m']);
  checksums = addFileChecksum(checksums, 'etc_finish', [root, 'etc/finish.m']);
end
%=============================================================================
function checksums = addFileChecksum(checksums, field, filename)
  if isfile(filename)
    checksums.(field) = sha256(filename, '-file');
  end
end
%=============================================================================
function s = nelsonVersionString()
  v = version('-number');
  s = sprintf('%d.%d.%d', v(1), v(2), v(3));
end
%=============================================================================
function tag = nelsonAbiTag()
  compiler = version('-compiler');
  tag = [computer('arch'), '-', compiler{3}];
end
%=============================================================================
function path = newTemporaryDirectory()
  root = [usermodulesdir(), '.nmm-tmp/'];
  if ~isdir(root)
    mkdir(root);
  end
  path = [root, createGUID(), '/'];
  mkdir(path);
end
%=============================================================================
function cleanupDirectory(path)
  if ischar(path) && isdir(path)
    rmdir(path, 's');
  end
end
%=============================================================================
function path = ensureTrailingSlash(path)
  if ~endsWith(path, '/')
    path = [path, '/'];
  end
end
