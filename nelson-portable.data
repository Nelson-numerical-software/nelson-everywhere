% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function ip_validate_activecontour_mask(mask, imageSize)
  if ~(isnumeric(mask) || islogical(mask))
    error('Nelson:validators:mustBeNumericOrLogical', '%s must be numeric or logical.', 'Initial mask');
  end
  if issparse(mask)
    error('Nelson:image_processing:sparseMasksNotSupported', '%s are not supported.', 'Sparse masks');
  end
  if ~isreal(mask)
    error('Nelson:validators:mustBeReal', '%s must be real.', 'Initial mask');
  end
  if ~isequal(size(mask), imageSize)
    error('Nelson:image_processing:initialMaskSameSizeImage', '%s must have the same size as %s.', 'Initial mask', 'the image');
  end
  d = double(mask);
  if any(~isfinite(d(:)))
    error('Nelson:image_processing:initialMaskContainFiniteValues', '%s must contain finite values.', 'Initial mask');
  end
  values = unique(d(:));
  if any(values ~= 0 & values ~= 1)
    error('Nelson:image_processing:initialMaskContainBinaryValues', '%s must contain binary values.', 'Initial mask');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function ip_validate_adaptthresh_options(sensitivity, nhood, polarity, statistic)
  if ~(isscalar(sensitivity) && isfinite(sensitivity) && sensitivity >= 0 && sensitivity <= 1)
    error('Nelson:image_processing:sensitivityFiniteScalarRange', '%s must be a finite scalar in the range [%s].', 'Sensitivity', '0, 1');
  end
  if numel(nhood) == 1
    nhood = [nhood nhood];
  end
  if numel(nhood) ~= 2 || any(~isfinite(nhood(:))) || any(nhood(:) < 1) ...
      || any(nhood(:) ~= floor(nhood(:))) || any(mod(nhood(:), 2) == 0)
    error('Nelson:image_processing:neighborhoodSizeContainPositiveOddIntegers', '%s size must contain positive odd integers.', 'Neighborhood');
  end
  if ~(strcmp(polarity, 'bright') || strcmp(polarity, 'dark'))
    error('Nelson:image_processing:unsupportedForegroundPolarity', 'Unsupported "%s" option.', 'foreground polarity');
  end
  if ~(strcmp(statistic, 'mean') || strcmp(statistic, 'gaussian') || strcmp(statistic, 'median'))
    error('Nelson:image_processing:unsupportedAdaptiveStatistic', 'Unsupported "%s" option.', 'adaptive statistic');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function bw = ip_validate_binary_image_2d(img)
  if ~(isnumeric(img) || islogical(img))
    error('Nelson:validators:mustBeNumericOrLogical', '%s must be numeric or logical.', 'Image');
  end
  if issparse(img)
    error('Nelson:image_processing:sparseImagesNotSupported', '%s are not supported.', 'Sparse images');
  end
  if ~isreal(img)
    error('Nelson:validators:mustBeReal', '%s must be real.', 'Image');
  end
  if length(size(img)) > 2
    error('Nelson:image_processing:imageDArray', '%s must be a 2-D array.', 'Image');
  end
  values = double(img);
  if any(~isfinite(values(:)))
    error('Nelson:image_processing:imageValuesFinite', '%s values must be finite.', 'Image');
  end
  if any(values(:) ~= 0 & values(:) ~= 1)
    error('Nelson:image_processing:imageContainBinaryValues', '%s must contain binary values.', 'Image');
  end
  bw = ip_to_logical_mask(img);
end
