        },
        {
          "name": "b",
          "x": 100,
          "y": 40,
          "side": "right",
          "domain": "translational"
        }
      ],
      "inputs": [],
      "outputs": [],
      "defaultParams": {
        "ratio": 1
      },
      "icon": "Lever.svg",
      "render": {
        "type": "image",
        "src": "Lever.svg"
      },
      "help": "Lever (small-angle): s_a = ratio s_b, the arm ratio (structural merge)."
    },
    {
      "type": "Pulley",
      "label": "Pulley",
      "acausal": true,
      "domain": "translational",
      "width": 100,
      "height": 80,
      "physicalPins": [
        {
          "name": "a",
          "x": 0,
          "y": 40,
          "side": "left",
          "domain": "translational"
        },
        {
          "name": "b",
          "x": 100,
          "y": 40,
          "side": "right",
          "domain": "translational"
        }
      ],
      "inputs": [],
      "outputs": [],
      "defaultParams": {
        "ratio": 1
      },
      "icon": "Pulley.svg",
      "render": {
        "type": "image",
        "src": "Pulley.svg"
      },
      "help": "Ideal pulley: s_a = ratio s_b (structural merge; ratio = radius ratio)."
    }
  ]
}
