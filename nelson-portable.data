% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function n = run_countNormalizedOutcome(cases, outcome)
  n = 0;
  for k = 1:length(cases)
    n = n + strcmp(cases(k).outcome, outcome);
  end
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function count = run_countUnsuccessful(raw)
  count = 0;
  cases = run_resultCases(raw);
  for k = 1:length(cases)
    if ~strcmp(run_normalizeStatus(cases(k)), 'passed') && ~strcmp(run_normalizeStatus(cases(k)), 'skipped')
      count = count + 1;
    end
  end
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
