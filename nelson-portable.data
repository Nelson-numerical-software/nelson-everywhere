% LICENCE_BLOCK_END
%=============================================================================
function B = rmmissing(A, varargin)
  narginchk(1, Inf);
  dim = 1;
  if ~isempty(varargin)
    dim = varargin{1};
  end
  mask = ismissing(A);
  if isempty(varargin) && isvector(A) && ~istable(A) && ~istimetable(A)
    % genuine vectors are processed element by element, keeping the orientation
    % (tables/timetables always remove entire rows, handled below)
    B = A(~mask);
  elseif dim == 1
    B = A(~any(mask, 2), :);
  else
    B = A(:, ~any(mask, 1));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
