function varargout = categoricalHist(varargin)
  counts = countcats(varargin{end});
  varargout{1} = counts;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = categoricalHistogram(varargin)
  counts = countcats(varargin{end});
  if nargout > 0
    varargout{1} = counts;
  else
    disp(counts);
  end
end
