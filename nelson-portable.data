function varargout = parallelplot(varargin)
  narginchk(1, 1000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [parent, args] = parseParent(args);
  [data, labels, sourceTable, coordinateVariables, args] = parseParallelData(args);
  opts = parseParallelOptions(args, labels, sourceTable);
  [normalized, limits] = normalizeParallelData(data, opts.DataNormalization);
  ax = createParallelAxes(parent);
  chartArgs = parallelPlotProperties(data, sourceTable, coordinateVariables, opts);
  group = __parallelplot__('Parent', ax, chartArgs{:});
  [axisHandles, labelHandles, tickHandles, baselineHandle] = drawCoordinateAxes(group, opts.CoordinateTickLabels, limits);
  dataHandles = drawParallelRows(group, normalized, opts);
  legendHandles = drawParallelLegend(group, dataHandles, opts, size(data, 2));
  applyParallelAxesState(ax, size(data, 2), ~isempty(legendHandles));
  state = struct();
  state.ChartType = 'parallelplot';
  state.Data = data;
  state.NormalizedData = normalized;
  state.DataLimits = limits;
  state.CoordinateTickLabels = opts.CoordinateTickLabels;
  state.GroupData = opts.GroupData;
  state.DataNormalization = opts.DataNormalization;
  state.DataHandles = dataHandles;
  state.AxisHandles = axisHandles;
  state.BaselineHandle = baselineHandle;
  state.LabelHandles = labelHandles;
  state.TickHandles = tickHandles;
  state.LegendHandles = legendHandles;
  group.UserData = state;
  if nargout == 1
    varargout{1} = group;
  end
end
%=============================================================================
function [parent, args] = parseParent(args)
  parent = [];
  if ~isempty(args) && isscalar(args{1}) && isgraphics(args{1}, 'axes')
    error('Nelson:parallelplot:parallelCoordinatesPlotCannotBeA', 'ParallelCoordinatesPlot cannot be a child of Axes.');
  end
  if ~isempty(args) && isscalar(args{1}) && isgraphics(args{1}, 'figure')
    parent = args{1};
    args = args(2:end);
  end
end
%=============================================================================
function [data, labels, sourceTable, coordinateVariables, args] = parseParallelData(args)
  if isempty(args)
    error('Nelson:graphics:dataExpected', 'Data expected.');
  end
  source = args{1};
  args = args(2:end);
  labels = {};
  sourceTable = [];
  coordinateVariables = {};
  if istable(source) || istimetable(source)
    sourceTable = source;
    variables = {};
    if ~isempty(args) && isTableVariableSelector(args{1}) && ~isParallelPropertyName(args{1})
      error('Nelson:parallelplot:specifyTheGroupVariableUsing', 'Specify the ''GroupVariable'' using a property name and value pair.');
    end
    [variables, args] = extractCoordinateVariables(args, variables);
    coordinateVariables = variables;
    [data, labels] = tableData(source, variables);
  elseif isnumeric(source) || islogical(source)
    data = double(source);
    [data, labels, args] = extractCoordinateData(data, args);
    if isempty(labels)
      labels = defaultLabels(size(data, 2));
    end
  else
    error('Nelson:parallelplot:numericMatrixOrExpected', 'Numeric matrix or table expected.');
  end
  if ~ismatrix(data) || isempty(data)
    error('Nelson:parallelplot:invalidData', 'Data must be a nonempty matrix.');
  end
end
%=============================================================================
function opts = parseParallelOptions(args, labels, sourceTable)
  opts = struct('CoordinateTickLabels', {labels}, 'GroupData', [], ...
    'GroupVariable', [], ...
    'DataNormalization', 'range', 'LineWidth', 1, 'LineStyle', '-', ...
    'LineAlpha', 0.7, 'MarkerStyle', 'none', 'MarkerSize', 6, 'Jitter', 0.1, ...
    'LegendTitle', '', 'CoordinateLabel', '', 'DataLabel', '', ...
    'LegendVisible', 'off', 'Title', '', 'FontName', 'Helvetica', 'FontSize', 10, ...
    'Color', []);
  if rem(length(args), 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  for k = 1:2:length(args)
    name = lower(char(args{k}));
    value = args{k + 1};
    switch name
      case 'coordinateticklabels'
        opts.CoordinateTickLabels = normalizeLabels(value, numel(labels));
      case 'groupdata'
        opts.GroupData = value(:);
      case 'groupvariable'
        if isempty(sourceTable)
          error('Nelson:parallelplot:groupVariableIsSupportedOnly', 'GroupVariable is supported only for table input.');
        end
        [groupValues, groupName] = graphicsTableVariable(sourceTable, value);
        opts.GroupVariable = groupName;
        opts.GroupData = groupValues(:);
      case 'datanormalization'
        opts.DataNormalization = validateNormalization(value);
      case 'linewidth'
        opts.LineWidth = validateLineWidth(value);
      case 'linestyle'
        opts.LineStyle = convertTextValue(value);
      case 'linealpha'
        opts.LineAlpha = validateScalar(value, 'LineAlpha');
      case 'markerstyle'
        opts.MarkerStyle = convertTextValue(value);
      case 'markersize'
        opts.MarkerSize = validateScalar(value, 'MarkerSize');
      case 'jitter'
        opts.Jitter = validateScalar(value, 'Jitter');
      case 'legendtitle'
        opts.LegendTitle = convertTextValue(value);
      case 'coordinatelabel'
        opts.CoordinateLabel = convertTextValue(value);
      case 'datalabel'
        opts.DataLabel = convertTextValue(value);
      case 'legendvisible'
        opts.LegendVisible = validateOnOff(value);
      case 'title'
        opts.Title = convertTextValue(value);
      case 'fontname'
        opts.FontName = convertTextValue(value);
      case 'fontsize'
        opts.FontSize = validateScalar(value, 'FontSize');
      case 'color'
        opts.Color = value;
      otherwise
        error('Nelson:graphics:unsupportedProperty', 'Unsupported "%s" option.', 'parallelplot');
    end
  end
end
%=============================================================================
function ax = createParallelAxes(parent)
  if isempty(parent)
    ax = newplot();
  elseif isgraphics(parent, 'hggroup')
    ax = ancestor(parent, 'axes');
  else
    ax = newplot(parent);
  end
end
%=============================================================================
function args = parallelPlotProperties(data, sourceTable, coordinateVariables, opts)
  args = {'Data', data, ...
    'GroupData', opts.GroupData, ...
    'CoordinateData', data, ...
    'Color', plotColor(opts), ...
    'FontSize', opts.FontSize, ...
    'CoordinateTickLabels', opts.CoordinateTickLabels, ...
    'DataNormalization', opts.DataNormalization, ...
    'LineWidth', opts.LineWidth, ...
    'LineStyle', opts.LineStyle, ...
    'LineAlpha', opts.LineAlpha, ...
    'MarkerStyle', opts.MarkerStyle, ...
    'MarkerSize', opts.MarkerSize, ...
    'Jitter', opts.Jitter, ...
    'LegendTitle', opts.LegendTitle, ...
    'CoordinateLabel', opts.CoordinateLabel, ...
    'DataLabel', opts.DataLabel, ...
    'LegendVisible', opts.LegendVisible, ...
    'Title', opts.Title, ...
    'FontName', opts.FontName};
  if ~isempty(sourceTable)
    args = [args, {'SourceTable', sourceTable}];
  end
  if ~isempty(coordinateVariables)
    args = [args, {'CoordinateVariables', coordinateVariables}];
  end
  if ~isempty(opts.GroupVariable)
    args = [args, {'GroupVariable', opts.GroupVariable}];
  end
end
%=============================================================================
function [normalized, limits] = normalizeParallelData(data, method)
  limits = [min(data, [], 1); max(data, [], 1)];
  normalized = data;
  if strcmp(method, 'none')
    return
  end
  span = limits(2, :) - limits(1, :);
  span(span == 0) = 1;
  normalized = (data - repmat(limits(1, :), size(data, 1), 1)) ./ repmat(span, size(data, 1), 1);
end
%=============================================================================
function [axisHandles, labelHandles, tickHandles, baselineHandle] = drawCoordinateAxes(parent, labels, limits)
  n = numel(labels);
  axisHandles = gobjects(1, n);
  labelHandles = gobjects(1, n);
  tickHandles = gobjects(0, 1);
  axesColor = [0.25 0.25 0.25];
  baselineHandle = line('Parent', parent, 'XData', [0.5, n + 0.5], ...
    'YData', [-0.03, -0.03], 'Color', axesColor, 'LineWidth', 1, 'Clipping', 'off');
  for k = 1:n
    axisHandles(k) = line('Parent', parent, 'XData', [k k], 'YData', [0 1], ...
      'Color', axesColor, 'LineWidth', 1);
    tickHandles = [tickHandles; drawCoordinateTicks(parent, k, n, limits(:, k), axesColor)];
    labelHandles(k) = __text__('Parent', parent, 'Position', [k -0.08 0], 'String', labels{k}, ...
      'HorizontalAlignment', 'center', 'VerticalAlignment', 'top');
  end
end
%=============================================================================
function handles = drawCoordinateTicks(parent, coordinateIndex, coordinateCount, limits, axesColor)
  ticks = coordinateTicks(limits);
  handles = gobjects(0, 1);
  span = limits(2) - limits(1);
  if span == 0
    span = 1;
  end
  for k = 1:numel(ticks)
    y = (ticks(k) - limits(1)) / span;
    if coordinateIndex == coordinateCount
      tickX = [coordinateIndex - 0.03, coordinateIndex];
    else
      tickX = [coordinateIndex, coordinateIndex + 0.03];
    end
    handles(end + 1, 1) = line('Parent', parent, ...
      'XData', tickX, 'YData', [y y], 'Color', axesColor, 'LineWidth', 0.5);
    if coordinateIndex == coordinateCount
      labelX = coordinateIndex + 0.06;
      labelAlignment = 'left';
    else
      labelX = coordinateIndex - 0.06;
      labelAlignment = 'right';
    end
    handles(end + 1, 1) = __text__('Parent', parent, ...
      'Position', [labelX, y, 0], 'String', tickLabel(ticks(k)), ...
      'HorizontalAlignment', labelAlignment, 'VerticalAlignment', 'middle');
  end
end
%=============================================================================
function ticks = coordinateTicks(limits)
  span = limits(2) - limits(1);
  if ~isfinite(span) || span <= 0
    ticks = limits(1);
    return
  end
  rawStep = span / 10;
  magnitude = 10 ^ floor(log10(rawStep));
  scaled = rawStep / magnitude;
  if scaled <= 1
    multiplier = 1;
  elseif scaled <= 2
    multiplier = 2;
  elseif scaled <= 5
    multiplier = 5;
  else
    multiplier = 10;
  end
  step = multiplier * magnitude;
  first = ceil(limits(1) / step) * step;
  last = floor(limits(2) / step) * step;
  ticks = first:step:last;
end
%=============================================================================
function label = tickLabel(value)
  if abs(value - round(value)) < 1e-12
    label = sprintf('%d', round(value));
  else
    label = sprintf('%g', value);
  end
end
%=============================================================================
function dataHandles = drawParallelRows(parent, normalized, opts)
  n = size(normalized, 1);
  dataHandles = gobjects(n, 1);
  colors = colorsForRows(ancestor(parent, 'axes'), opts, n);
  x = 1:size(normalized, 2);
  for k = 1:n
    dataHandles(k) = line('Parent', parent, 'XData', x, 'YData', normalized(k, :), ...
      'Color', colors(k, :), 'LineWidth', opts.LineWidth, 'LineStyle', opts.LineStyle);
  end
end
%=============================================================================
function colors = colorsForRows(ax, opts, n)
  if ~isempty(opts.Color)
    colors = repmat(validatecolor(opts.Color), n, 1);
    return
  end
  order = ax.ColorOrder;
  colors = zeros(n, 3);
  groupIndex = groupIndices(opts.GroupData, n);
  for k = 1:n
    colors(k, :) = order(1 + mod(groupIndex(k) - 1, size(order, 1)), :);
  end
end
%=============================================================================
function legendHandles = drawParallelLegend(parent, dataHandles, opts, coordinateCount)
  legendHandles = gobjects(0, 1);
  if isempty(opts.GroupData) || strcmp(opts.LegendVisible, 'off')
    return
  end
  [levels, labels] = groupLevelsAndLabels(opts.GroupData);
  if numel(levels) <= 1
    return
  end
  x0 = coordinateCount + 0.28;
  x1 = coordinateCount + 0.5;
  yTop = 1.05;
  rowStep = 0.045;
  yBottom = yTop - rowStep * (numel(levels) + 1);
  legendHandles(end + 1, 1) = line('Parent', parent, ...
    'XData', [x0 x1 x1 x0 x0], 'YData', [yBottom yBottom yTop yTop yBottom], ...
    'Color', [0.25 0.25 0.25], 'LineWidth', 1, 'Clipping', 'off');
  titleText = opts.LegendTitle;
  if isempty(titleText)
    titleText = opts.GroupVariable;
  end
  if ~isempty(titleText)
    legendHandles(end + 1, 1) = __text__('Parent', parent, ...
      'Position', [(x0 + x1) / 2, yTop - rowStep / 2, 0], 'String', titleText, ...
      'HorizontalAlignment', 'center', 'VerticalAlignment', 'middle', ...
      'FontWeight', 'bold', 'Clipping', 'off');
  end
  for k = 1:numel(levels)
    sourceHandle = dataHandles(firstGroupIndex(opts.GroupData, levels{k}));
    y = yTop - rowStep * (k + 0.5);
    legendHandles(end + 1, 1) = line('Parent', parent, 'XData', [x0 + 0.04, x0 + 0.13], ...
      'YData', [y y], ...
      'Color', sourceHandle.Color, 'LineWidth', sourceHandle.LineWidth, ...
      'LineStyle', sourceHandle.LineStyle, 'Clipping', 'off');
    legendHandles(end + 1, 1) = __text__('Parent', parent, ...
      'Position', [x0 + 0.15, y, 0], 'String', labels{k}, ...
      'HorizontalAlignment', 'left', 'VerticalAlignment', 'middle', ...
      'Clipping', 'off');
  end
end
%=============================================================================
function idx = firstGroupIndex(groupData, level)
  idx = 1;
  for k = 1:numel(groupData)
    if isequal(groupData(k), level)
      idx = k;
      return
    end
  end
end
%=============================================================================
function [levels, labels] = groupLevelsAndLabels(groupData)
  levels = {};
  labels = {};
  for k = 1:numel(groupData)
    value = groupData(k);
    found = false;
    for j = 1:numel(levels)
      if isequal(value, levels{j})
        found = true;
      end
    end
    if ~found
      levels{end + 1} = value;
      labels{end + 1} = groupLabel(value);
    end
  end
end
%=============================================================================
function label = groupLabel(value)
  if iscell(value)
    label = value{1};
  elseif isstring(value)
    label = char(value);
  elseif ischar(value)
    label = value;
  elseif isnumeric(value) || islogical(value)
    label = num2str(value);
  else
    label = char(string(value));
  end
end
%=============================================================================
function color = plotColor(opts)
  if isempty(opts.Color)
    color = [0.066 0.443 0.745];
  else
    color = validatecolor(opts.Color);
  end
end
%=============================================================================
function index = groupIndices(groupData, n)
  index = ones(n, 1);
  if isempty(groupData)
    return
  end
  if numel(groupData) ~= n
    error('Nelson:parallelplot:invalidGroupData', 'GroupData must have one element per row.');
  end
  levels = {};
  for k = 1:n
    found = 0;
    for j = 1:numel(levels)
      if isequal(groupData(k), levels{j})
        found = j;
      end
    end
    if found == 0
      levels{end + 1} = groupData(k);
      found = numel(levels);
    end
    index(k) = found;
  end
end
%=============================================================================
function applyParallelAxesState(ax, n, hasLegend)
  ax.XLim = [0.5, n + 0.5];
  ax.YLim = [-0.04, 1.05];
  ax.XTick = 1:n;
  ax.XTickLabel = {};
  ax.YTick = [];
  ax.XColor = 'none';
  ax.YColor = 'none';
  ax.Visible = 'off';
  ax.Box = 'off';
end
%=============================================================================
function tf = isTableVariableSelector(value)
  tf = ischar(value) || iscellstr(value) || isstring(value);
  tf = tf && ~isempty(value);
end
%=============================================================================
function tf = isParallelPropertyName(value)
  if ~(ischar(value) || isStringScalar(value))
    tf = false;
    return
  end
  names = {'CoordinateVariables', 'CoordinateData', 'CoordinateTickLabels', ...
    'GroupData', 'GroupVariable', 'DataNormalization', 'LineWidth', ...
    'LineStyle', 'LineAlpha', 'MarkerStyle', 'MarkerSize', 'Jitter', ...
    'LegendTitle', 'CoordinateLabel', 'DataLabel', 'LegendVisible', ...
    'Title', 'FontName', 'FontSize', 'Color'};
  tf = any(strcmpi(char(value), names));
end
%=============================================================================
function [variables, args] = extractCoordinateVariables(args, variables)
  index = findPropertyIndex(args, 'CoordinateVariables');
  if index == 0
    return
  end
  variables = normalizeVariableNames(args{index + 1});
  args(index:index + 1) = [];
end
%=============================================================================
function [data, labels, args] = extractCoordinateData(data, args)
  labels = {};
  index = findPropertyIndex(args, 'CoordinateData');
  if index == 0
    return
  end
  columns = args{index + 1};
  if ~isnumeric(columns) && ~islogical(columns)
    error('Nelson:parallelplot:invalidCoordinateData', '%s must be a numeric vector.', 'CoordinateData');
  end
  columns = columns(:)';
  data = data(:, columns);
  labels = defaultLabels(size(data, 2));
  for k = 1:numel(columns)
    labels{k} = num2str(columns(k));
  end
  args(index:index + 1) = [];
end
%=============================================================================
function index = findPropertyIndex(args, name)
  index = 0;
  if rem(length(args), 2) ~= 0
    return
  end
  for k = 1:2:length(args)
    if ischar(args{k}) && strcmpi(args{k}, name)
      index = k;
    end
  end
end
%=============================================================================
function names = normalizeVariableNames(names)
  if ischar(names)
    names = {names};
  elseif isstring(names)
    names = cellstr(names(:)');
  elseif iscellstr(names)
    names = names(:)';
  else
    error('Nelson:graphics:invalidVariableNames', 'Variable names must be character vectors or strings.');
  end
end
%=============================================================================
function [data, labels] = tableData(tbl, variables)
  explicitVariables = ~isempty(variables);
  if isempty(variables)
    variables = tbl.Properties.VariableNames;
  end
  labels = {};
  data = [];
  for k = 1:numel(variables)
    name = variables{k};
    if ~any(strcmp(name, tbl.Properties.VariableNames))
      error('Nelson:graphics:unrecognizedTableVariable', 'Unrecognized table variable.');
    end
    value = tbl.(name);
    if isnumeric(value) || islogical(value)
      [data, labels] = appendColumnData(data, labels, name, double(value), height(tbl));
    elseif explicitVariables
      error('Nelson:graphics:numericTableVariableExpected', 'Numeric table variable expected.');
    end
  end
  if isempty(data)
    error('Nelson:parallelplot:invalidTable', 'Table must contain numeric variables.');
  end
end
%=============================================================================
function [data, labels] = appendColumnData(data, labels, name, value, expectedRows)
  if isvector(value)
    value = value(:);
  end
  if size(value, 1) ~= expectedRows
    error('Nelson:graphics:invalidTableVariables', 'Table variables must have compatible row counts.');
  end
  if isempty(data)
    data = value;
  else
    data = [data, value];
  end
  if size(value, 2) == 1
    labels{end + 1} = name;
  else
    for k = 1:size(value, 2)
      labels{end + 1} = [name, '_', num2str(k)];
    end
  end
end
%=============================================================================
function labels = defaultLabels(n)
  labels = cell(1, n);
  for k = 1:n
    labels{k} = num2str(k);
  end
end
%=============================================================================
function labels = normalizeLabels(value, expectedCount)
  if isstring(value)
    labels = cellstr(value(:)');
  elseif ischar(value)
    labels = cellstr(value);
  elseif iscellstr(value)
    labels = value(:)';
  else
    error('Nelson:parallelplot:invalidCoordinateLabels', 'Coordinate labels must be text.');
  end
  if numel(labels) ~= expectedCount
    error('Nelson:parallelplot:invalidNumberOfCoordinate', 'Number of coordinate labels must match the number of variables.');
  end
end
%=============================================================================
function value = convertTextValue(value)
  if isStringScalar(value)
    value = convertStringsToChars(value);
  end
  if ~ischar(value)
    error('Nelson:graphics:textValueExpected', 'Text value expected.');
  end
end
%=============================================================================
function value = validateNormalization(value)
  value = lower(char(value));
  if ~(strcmp(value, 'range') || strcmp(value, 'none'))
    error('Nelson:parallelplot:invalidDataNormalization', 'DataNormalization must be ''range'' or ''none''.');
  end
end
%=============================================================================
function value = validateLineWidth(value)
  if ~isnumeric(value) || ~isscalar(value) || value <= 0
    error('Nelson:graphics:mustBePositiveScalar', '%s must be a positive scalar.', 'LineWidth');
  end
end
%=============================================================================
function value = validateScalar(value, name)
  if ~isnumeric(value) || ~isscalar(value)
    error('Nelson:graphics:mustBeNumericScalar', '%s must be a numeric scalar.', name);
  end
end
%=============================================================================
function value = validateOnOff(value)
  value = convertTextValue(value);
  if ~(strcmp(value, 'on') || strcmp(value, 'off'))
    error('Nelson:graphics:invalidOnOffValue', 'Value must be ''on'' or ''off''.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = pareto(varargin)
  narginchk(1, 1000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [parent, args] = parseParent(args);
  if isempty(args) || ~isnumeric(args{1})
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Value');
  end
  values = double(args{1}(:));
  args = args(2:end);
  labels = [];
  threshold = 0.95;
  if ~isempty(args) && isParetoThresholdValue(args{1})
    threshold = paretoThreshold(args{1});
    args = args(2:end);
  elseif ~isempty(args) && ~isParetoPropertyName(args{1})
    labels = labelsFromValue(args{1});
    args = args(2:end);
  end
  if ~isempty(args) && isnumeric(args{1})
    threshold = paretoThreshold(args{1});
    args = args(2:end);
  end
  if rem(length(args), 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  if isempty(parent)
    ax = newplot();
  elseif isgraphics(parent, 'axes')
    ax = newplot(parent);
  else
    ax = ancestor(parent, 'axes');
  end
  [values, labels] = sortedParetoValues(values, labels);
  hBar = bar(ax, values, args{:});
  holdState = ishold(ax);
  hold(ax, 'on');
  cumulative = cumsum(values);
  hLine = plot(ax, 1:numel(values), cumulative, 'Color', [0.8660, 0.3290, 0], ...
    'LineStyle', '-', 'LineWidth', 0.5);
  if ~holdState
    hold(ax, 'off');
  end
  visibleLabels = paretoVisibleLabels(values, threshold);
  ax.XTick = 1:visibleLabels;
  ax.XTickLabel = labels(1:visibleLabels);
  ax.XLim = [0.5, numel(values) + 0.5];
  ax.YLim = paretoYLimits(cumulative);
  ax.YTick = paretoValueTicks(ax.YLim);
  createParetoPercentAxis(ax, cumulative);
  if nargout == 1
    varargout{1} = [hBar; hLine];
  end
end
%=============================================================================
function [parent, args] = parseParent(args)
  parent = [];
  if ~isempty(args) && isscalar(args{1}) && (isgraphics(args{1}, 'axes') || isgraphics(args{1}, 'hggroup'))
    parent = args{1};
    args = args(2:end);
  end
end
%=============================================================================
function [values, labels] = sortedParetoValues(values, labels)
  values = values(isfinite(values));
  if isempty(values)
    error('Nelson:pareto:invalidData', 'Data must contain at least one finite value.');
  end
  if any(values < 0)
    error('Nelson:pareto:invalidDataValues', 'Data values must be nonnegative.');
  end
  if isempty(labels)
    labels = defaultLabels(numel(values));
  end
  if numel(labels) ~= numel(values)
    error('Nelson:pareto:invalidNumberOfLabels', 'Number of labels must match number of values.');
  end
  [values, order] = sort(values, 'descend');
  labels = labels(order);
end
%=============================================================================
function tf = isParetoThresholdValue(value)
  tf = isnumeric(value) && isscalar(value);
end
%=============================================================================
function threshold = paretoThreshold(value)
  if ~isnumeric(value) || ~isscalar(value) || ~isreal(value) || ~isfinite(value) ...
      || value < 0 || value > 1
    error('Nelson:pareto:invalidThreshold', 'Threshold must be a scalar numeric value between 0 and 1.');
  end
  threshold = double(value);
end
%=============================================================================
function n = paretoVisibleLabels(values, threshold)
  total = sum(values);
  if total == 0
    n = numel(values);
    return
  end
  n = find(cumsum(values) / total >= threshold, 1);
  if isempty(n)
    n = numel(values);
  end
end
%=============================================================================
function limits = paretoYLimits(cumulative)
  if isempty(cumulative) || cumulative(end) == 0
    limits = [0, 1];
  else
    limits = [0, cumulative(end)];
  end
end
%=============================================================================
function ticks = paretoValueTicks(limits)
  lo = limits(1);
  hi = limits(2);
  if ~isfinite(lo) || ~isfinite(hi) || hi <= lo
    ticks = [lo, hi];
    return
  end
  step = paretoNiceStep(hi - lo, 10);
  ticks = lo:step:hi;
  tol = step * 1e-9;
  if isempty(ticks) || ticks(end) < hi - tol
    ticks = [ticks, ticks(end) + step];
  end
end
%=============================================================================
function step = paretoNiceStep(range, maxIntervals)
  raw = range / maxIntervals;
  magnitude = 10 ^ floor(log10(raw));
  normalized = raw / magnitude;
  if normalized <= 1
    multiplier = 1;
  elseif normalized <= 2
    multiplier = 2;
  elseif normalized <= 5
    multiplier = 5;
  else
    multiplier = 10;
  end
  step = multiplier * magnitude;
end
%=============================================================================
function percentAxis = createParetoPercentAxis(ax, cumulative)
  parent = ax.Parent;
  total = cumulative(end);
  percentAxis = axes('Parent', parent, 'Position', ax.Position, ...
    'Color', 'none', 'YAxisLocation', 'right', 'Box', 'off', ...
    'XLim', ax.XLim, 'YLim', ax.YLim, 'XTick', []);
  percentAxis.YTick = ax.YTick;
  percentAxis.YTickLabel = percentTickLabels(percentAxis.YTick, total);
  percentAxis.XColor = ax.XColor;
  percentAxis.YColor = ax.YColor;
  percentAxis.FontName = ax.FontName;
  percentAxis.FontSize = ax.FontSize;
  percentAxis.FontAngle = ax.FontAngle;
  percentAxis.FontWeight = ax.FontWeight;
  if isgraphics(parent, 'figure')
    parent.CurrentAxes = ax;
  end
end
%=============================================================================
function labels = percentTickLabels(ticks, total)
  labels = cell(numel(ticks), 1);
  for k = 1:numel(ticks)
    if total == 0
      percent = 0;
    else
      percent = ticks(k) / total * 100;
    end
    labels{k} = [num2str(round(percent)), '%'];
  end
end
%=============================================================================
function labels = labelsFromValue(value)
  if iscellstr(value)
    labels = value(:);
  elseif isstring(value)
    labels = cellstr(value(:));
  elseif ischar(value)
    labels = cellstr(value);
  elseif isnumeric(value) && isreal(value)
    labels = cellstr(num2str(value(:)));
  else
    error('Nelson:pareto:invalidLabels', 'Labels must be numeric, character, string, or cell string values.');
  end
end
%=============================================================================
function labels = defaultLabels(n)
  labels = cell(n, 1);
  for k = 1:n
    labels{k} = num2str(k);
  end
end
%=============================================================================
function tf = isParetoPropertyName(value)
  tf = false;
  if ~(ischar(value) || isStringScalar(value))
    return
  end
  tf = isValidGraphicsProperty('bar', char(value));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = patch(varargin)
  % h = patch(X, Y, C)
  % h = patch(X, Y, Z, C)
  % h = patch(ax, X, Y, C)
  % h = patch(ax, X, Y, Z, C)

  nargoutchk(0, 1);

  inputArguments = convertStringToCharArgs(varargin);
  [h, isFastPatch] = renderPatchFast(inputArguments);
  if ~isFastPatch
    [h, isFastPatch] = renderPatchPropertyFast(inputArguments);
  end
  if isFastPatch
    if (nargout > 0)
      varargout{1} = h;
    else
      varargout = {};
    end
    return
  end

  args = parsePatchArguments(inputArguments);
  h = renderPatch(args);
  updatePatchLimits(struct(args{:}));

  if (nargout > 0)
    varargout{1} = h;
  else
    varargout = {};
  end
end
%=============================================================================
function [h, isFastPatch] = renderPatchFast(inputArguments)
  h = [];
  isFastPatch = false;
  if isempty(inputArguments)
    return
  end
  if length(inputArguments) == 1 && isstruct(inputArguments{1})
    return
  end
  if isscalar(inputArguments{1}) && (isgraphics(inputArguments{1}, 'axes') || isgraphics(inputArguments{1}, 'hggroup'))
    return
  end
  if length(inputArguments) < 3
    return
  end
  if ~isnumeric(inputArguments{1}) || ~isnumeric(inputArguments{2})
    return
  end
  if ndims(inputArguments{1}) > 2 || ndims(inputArguments{2}) > 2
    return
  end
  [dataCount, propertyStart] = fastPatchDataCount(inputArguments);
  if dataCount == 0
    return
  end
  for k = 1:dataCount
    if isnumeric(inputArguments{k}) && ndims(inputArguments{k}) > 2
      return
    end
  end
  if hasFastPatchDataOverride(inputArguments, propertyStart)
    return
  end
  h = __patch__(inputArguments{:});
  isFastPatch = true;
end
%=============================================================================
function [h, isFastPatch] = renderPatchPropertyFast(inputArguments)
  h = [];
  isFastPatch = false;
  if isempty(inputArguments)
    return
  end
  if length(inputArguments) == 1 && isstruct(inputArguments{1})
    return
  end
  parent = [];
  if isscalar(inputArguments{1}) && (isgraphics(inputArguments{1}, 'axes') || isgraphics(inputArguments{1}, 'hggroup'))
    parent = inputArguments{1};
    inputArguments = inputArguments(2:end);
  end
  if isempty(inputArguments) || rem(length(inputArguments), 2) ~= 0
    return
  end
  for k = 1:2:length(inputArguments)
    if ~isFastPatchPropertyPairName(inputArguments{k})
      return
    end
  end
  if ~hasPatchProperty(inputArguments, 'Faces') || ~hasPatchProperty(inputArguments, 'Vertices')
    return
  end
  if ~isDirectPatchPropertyData(inputArguments)
    return
  end
  if ~isempty(parent) && ~hasPatchProperty(inputArguments, 'Parent')
    inputArguments = [{'Parent', parent}, inputArguments];
  end
  h = __patch__(inputArguments{:});
  isFastPatch = true;
end
%=============================================================================
function tf = isFastPatchPropertyPairName(value)
  if ~ischar(value)
    tf = false;
    return
  end
  persistent propertyNames
  if isempty(propertyNames)
    propertyNames = {'alignvertexcenters', 'alphadatamapping', 'ambientstrength', ...
      'annotation', 'backfacelighting', 'beingdeleted', 'busyaction', ...
      'buttondownfcn', 'children', 'clipping', 'contextmenu', 'createfcn', ...
      'cdatamapping', 'cdata', 'deletefcn', 'diffusestrength', 'displayname', ...
      'edgealpha', 'edgecolor', 'edgelighting', 'facelighting', 'facealpha', ...
      'facecolor', 'faces', 'facevertexalphadata', 'facevertexcdata', ...
      'handlevisibility', 'hittest', 'interruptible', 'linestyle', 'linewidth', ...
      'linejoin', 'marker', 'markeredgealpha', 'markeredgecolor', 'markerfacealpha', ...
      'markerfacecolor', 'markersize', 'parent', 'pickableparts', 'selected', ...
      'selectionhighlight', 'seriesindex', 'specularcolorreflectance', ...
      'specularexponent', 'specularstrength', 'tag', 'type', 'userdata', ...
      'vertices', 'visible', 'xdata', 'ydata', 'zdata'};
  end
  tf = any(strcmpi(value, propertyNames));
end
%=============================================================================
function tf = isDirectPatchPropertyData(propertiesList)
  tf = true;
  faces = getPatchPropertyValue(propertiesList, 'Faces');
  vertices = getPatchPropertyValue(propertiesList, 'Vertices');
  if ~isnumeric(faces) || ~isnumeric(vertices) || size(vertices, 2) ~= 3
    tf = false;
    return
  end
  cdata = getPatchPropertyValue(propertiesList, 'FaceVertexCData');
  if isempty(cdata) || ~isnumeric(cdata)
    return
  end
  faceColor = getPatchPropertyValue(propertiesList, 'FaceColor');
  if isempty(faceColor) || isnumeric(faceColor)
    return
  end
  if strcmpi(faceColor, 'flat')
    tf = ismatrix(cdata) && size(cdata, 2) == 3 && size(cdata, 1) == size(faces, 1);
    return
  end
  if strcmpi(faceColor, 'interp')
    tf = ismatrix(cdata) && size(cdata, 2) == 3 && size(cdata, 1) == size(vertices, 1);
  end
end
%=============================================================================
function value = getPatchPropertyValue(propertiesList, name)
  value = [];
  for k = 1:2:length(propertiesList)
    if ischar(propertiesList{k}) && strcmpi(propertiesList{k}, name)
      value = propertiesList{k + 1};
      return
    end
  end
end
%=============================================================================
function [dataCount, propertyStart] = fastPatchDataCount(inputArguments)
  dataCount = 0;
  propertyStart = length(inputArguments) + 1;
  nbInputArguments = length(inputArguments);
  if nbInputArguments < 3
    return
  end
  if isFastFaceColorSpec(inputArguments{3})
    dataCount = 2;
    propertyStart = 4;
    return
  end
  if isFastPatchPropertyName(inputArguments{3})
    return
  end
  if nbInputArguments == 3
    dataCount = 3;
    return
  end
  if isFastFaceColorSpec(inputArguments{4})
    dataCount = 3;
    propertyStart = 5;
    return
  end
  if isFastPatchPropertyName(inputArguments{4})
    dataCount = 3;
    propertyStart = 4;
    return
  end
  dataCount = 4;
  propertyStart = 5;
end
%=============================================================================
function tf = hasFastPatchDataOverride(inputArguments, propertyStart)
  tf = true;
  if propertyStart > length(inputArguments)
    tf = false;
    return
  end
  if rem(length(inputArguments) - propertyStart + 1, 2) ~= 0
    return
  end
  for k = propertyStart:2:length(inputArguments)
    if ~isFastPatchPropertyName(inputArguments{k})
      return
    end
    name = lower(inputArguments{k});
    if any(strcmp(name, {'parent', 'xdata', 'ydata', 'zdata', 'cdata', 'faces', 'vertices', 'facevertexcdata'}))
      return
    end
  end
  tf = false;
end
%=============================================================================
function tf = isFastFaceColorSpec(value)
  tf = (ischar(value) && ~isFastPatchPropertyName(value)) ...
    || (isnumeric(value) && isvector(value) && numel(value) == 3);
end
%=============================================================================
function tf = isFastPatchPropertyName(value)
  if ~ischar(value)
    tf = false;
    return
  end
  persistent propertyNames
  if isempty(propertyNames)
    propertyNames = {'alignvertexcenters', 'alphadatamapping', 'ambientstrength', ...
      'annotation', 'backfacelighting', 'beingdeleted', 'busyaction', ...
      'buttondownfcn', 'children', 'clipping', 'contextmenu', 'createfcn', ...
      'cdatamapping', 'deletefcn', 'diffusestrength', 'displayname', 'edgealpha', ...
      'edgecolor', 'edgelighting', 'facelighting', 'facealpha', 'facecolor', ...
      'handlevisibility', 'hittest', 'interruptible', 'linestyle', 'linewidth', ...
      'linejoin', 'marker', 'markeredgealpha', 'markeredgecolor', 'markerfacealpha', ...
      'markerfacecolor', 'markersize', 'pickableparts', 'selected', ...
      'selectionhighlight', 'seriesindex', 'specularcolorreflectance', ...
      'specularexponent', 'specularstrength', 'tag', 'type', 'userdata', 'visible'};
  end
  tf = any(strcmpi(value, propertyNames));
end
%=============================================================================
function updatePatchLimits(st)
  if ~isfield(st, 'Parent') || ~isgraphics(st.Parent, 'axes')
    return
  end
  if ~isfield(st, 'Vertices') || isempty(st.Vertices)
    return
  end
  ax = st.Parent;
  vertices = st.Vertices;
  expandLimits(ax, vertices(:, 1), 'X');
  expandLimits(ax, vertices(:, 2), 'Y');
  if size(vertices, 2) >= 3 && any(vertices(:, 3) ~= vertices(1, 3))
    expandLimits(ax, vertices(:, 3), 'Z');
  end
end
%=============================================================================
function expandLimits(ax, values, axisName)
  % When the axis limit mode is 'auto', the axis already recomputes padded
  % limits from all of its children. Overwriting the limits here would freeze
  % the mode to 'manual' and drop that padding, making the plotted data fill
  % the whole box (appearing larger than expected). Only adjust the limits
  % when the user has already fixed them ('manual'), so newly added data stays
  % visible without discarding an auto (padded) range.
  if strcmp(ax.([axisName, 'LimMode']), 'auto')
    return
  end
  values = values(isfinite(values));
  if isempty(values)
    return
  end
  dataRange = [min(values), max(values)];
  if dataRange(1) == dataRange(2)
    dataRange(2) = dataRange(1) + 1;
  end
  currentRange = ax.([axisName, 'Lim']);
  dataRange = [min(currentRange(1), dataRange(1)), max(currentRange(2), dataRange(2))];
  ax.([axisName, 'Lim']) = dataRange;
end
%=============================================================================
function h = renderPatch(args)
  st = struct(args{:});
  if requires3DNumericFlatColorConversion(st)
    st.FaceVertexCData = resolveFaceColors(st);
    st.FaceColor = 'flat';
    args = structToArgs(st);
    h = __patch__(args{:});
  elseif requires3DNumericColorFallback(st)
    h = render3DNumericColorFallback(st);
  else
    h = __patch__(args{:});
  end
end
%=============================================================================
function tf = requires3DNumericFlatColorConversion(st)
  tf = requires3DNumericColorFallback(st) && strcmpi(st.FaceColor, 'flat');
end
%=============================================================================
function tf = requires3DNumericColorFallback(st)
  tf = false;
  if ~isfield(st, 'Vertices') || isempty(st.Vertices) || size(st.Vertices, 2) < 3
    return
  end
  z = st.Vertices(:, 3);
  if isempty(z) || all(z == z(1))
    return
  end
  if ~isfield(st, 'FaceVertexCData') || isempty(st.FaceVertexCData) || ~isnumeric(st.FaceVertexCData)
    return
  end
  if ~isfield(st, 'FaceColor')
    return
  end
  if isnumeric(st.FaceColor)
    return
  end
  if strcmpi(st.FaceColor, 'flat') && isDirectFlatFaceColorData(st)
    return
  end
  if strcmpi(st.FaceColor, 'interp') && isDirectInterpVertexColorData(st)
    return
  end
  tf = strcmpi(st.FaceColor, 'flat') || strcmpi(st.FaceColor, 'interp');
end
%=============================================================================
function tf = isDirectFlatFaceColorData(st)
  c = st.FaceVertexCData;
  tf = ismatrix(c) && size(c, 2) == 3 && isfield(st, 'Faces') && size(c, 1) == size(st.Faces, 1);
end
%=============================================================================
function tf = isDirectInterpVertexColorData(st)
  c = st.FaceVertexCData;
  tf = ismatrix(c) && size(c, 2) == 3 && isfield(st, 'Vertices') && size(c, 1) == size(st.Vertices, 1);
end
%=============================================================================
function args = structToArgs(st)
  args = reshape([fieldnames(st)'; struct2cell(st)'], 1, []);
end
%=============================================================================
function h = render3DNumericColorFallback(st)
  faces = st.Faces;
  vertices = st.Vertices;
  colors = resolveFaceColors(st);
  base = stripPatchDataFields(st);
  h = [];
  for k = 1:size(faces, 1)
    ids = faces(k, :);
    triangle = vertices(ids, :);
    args = {'Parent', st.Parent, ...
      'XData', triangle(:, 1), ...
      'YData', triangle(:, 2), ...
      'ZData', triangle(:, 3), ...
      'FaceColor', colors(k, :)};
    args = [args, base];
    h = [h; __patch__(args{:})];
  end
end
%=============================================================================
function colors = resolveFaceColors(st)
  c = st.FaceVertexCData;
  faces = st.Faces;
  vertices = st.Vertices;
  if ndims(c) == 3 && size(c, 3) == 3
    rgb = reshape(c, [], 3);
    colors = zeros(size(faces, 1), 3);
    for k = 1:size(faces, 1)
      colors(k, :) = mean(rgb(faces(k, :), :), 1);
    end
    return
  end
  if ismatrix(c) && size(c, 2) == 3 && size(c, 1) == size(vertices, 1)
    colors = zeros(size(faces, 1), 3);
    for k = 1:size(faces, 1)
      colors(k, :) = mean(c(faces(k, :), :), 1);
    end
    return
  end
  values = faceScalarValues(st);
  colors = mapScalarsToColors(st.Parent, values);
end
%=============================================================================
function values = faceScalarValues(st)
  c = st.FaceVertexCData;
  faces = st.Faces;
  if isscalar(c)
    values = repmat(c, size(faces, 1), 1);
    return
  end
  if isvector(c)
    c = c(:);
    values = zeros(size(faces, 1), 1);
    for k = 1:size(faces, 1)
      values(k) = mean(c(faces(k, :)));
    end
    return
  end
  if isequal(size(c), size(st.XData))
    values = mean(c, 1).';
    return
  end
  if isequal(size(c), fliplr(size(st.XData)))
    values = mean(c.', 1).';
    return
  end
  values = mean(c, 1).';
end
%=============================================================================
function colors = mapScalarsToColors(parent, values)
  colors = colormap(parent);
  if isempty(colors)
    colors = colormap();
  end
  if isempty(colors)
    colors = jet(64);
  end
  values = values(:);
  minValue = min(values);
  maxValue = max(values);
  if minValue == maxValue
    maxValue = minValue + 1;
  end
  parent.CLim = [minValue, maxValue];
  nbColors = size(colors, 1);
  index = ceil((values - minValue) ./ (maxValue - minValue) .* nbColors);
  index(index < 1) = 1;
  index(index > nbColors) = nbColors;
  colors = colors(index, :);
end
%=============================================================================
function args = stripPatchDataFields(st)
  skip = {'Parent', 'XData', 'YData', 'ZData', 'CData', 'Faces', 'Vertices', 'FaceVertexCData', 'FaceColor'};
  args = {};
  names = fieldnames(st);
  for k = 1:length(names)
    if ~any(strcmp(names{k}, skip))
      args = [args, {names{k}, st.(names{k})}];
    end
  end
end
%=============================================================================
function args = parsePatchArguments(inputArguments)
  if length(inputArguments) == 1
    % patch(S)
    if isstruct(inputArguments{1})
      S = inputArguments{1};
      inputArguments = reshape([fieldnames(S)'; struct2cell(S)'], 1, []);
    else
      error('Nelson:patch:structTypeExpected', 'struct type expected.');
    end
  end

  ax = [];
  if (length(inputArguments) > 0 && isscalar(inputArguments{1}) && (isgraphics(inputArguments{1}, 'axes') || isgraphics(inputArguments{1}, 'hggroup')))
    ax = inputArguments{1};
    inputArguments = inputArguments(2:end);
  end

  nbInputArguments = length(inputArguments);
  if nbInputArguments == 0
    inputArguments = {'XData', [0; 1; 0], 'YData', [1; 1; 0]};
    nbInputArguments = length(inputArguments);
  end
  explicitFaceColor = [];

  propertyStart = nbInputArguments + 1;
  for k = 1:nbInputArguments
    if isPatchPropertyName(inputArguments{k})
      propertyStart = k;
      break
    end
  end
  propertiesList = inputArguments(propertyStart:end);
  inputArguments = inputArguments(1:propertyStart - 1);
  propertiesList = graphicsCollapseRepeatedProperties(propertiesList);

  if ~hasPatchProperty(propertiesList, 'FaceColor')
    if length(inputArguments) == 3 && isFaceColorSpec(inputArguments{3})
      explicitFaceColor = parseFaceColor(inputArguments{3});
      inputArguments = inputArguments(1:2);
    elseif length(inputArguments) == 4 && isFaceColorSpec(inputArguments{4})
      explicitFaceColor = parseFaceColor(inputArguments{4});
      inputArguments = inputArguments(1:3);
    end
  end
  if ~isempty(explicitFaceColor)
    propertiesList = [{'FaceColor', explicitFaceColor}, propertiesList];
  end

  nbInputArguments = length(inputArguments);
  XData = [];
  YData = [];
  ZData = [];
  CData = [];
  haveCData = false;
  Faces = [];
  Vertices = [];
  FaceVertexCData = [];
  % Default face/edge is the dark-gray axes foreground (33/255), matching the
  % reference factory patch defaults -- not pure black.
  FaceColorDefault = [0.129411764705882, 0.129411764705882, 0.129411764705882];
  EdgeColorDefault = [0.129411764705882, 0.129411764705882, 0.129411764705882];

  if (nbInputArguments == 2 && ~isempty(explicitFaceColor))
    XData = inputArguments{1};
    YData = inputArguments{2};
  elseif (nbInputArguments == 3 && isempty(explicitFaceColor))
    % h = patch(X, Y, C)
    XData = inputArguments{1};
    YData = inputArguments{2};
    CData = inputArguments{3};
    haveCData = true;
  elseif (nbInputArguments == 3 && ~isempty(explicitFaceColor))
    XData = inputArguments{1};
    YData = inputArguments{2};
    ZData = inputArguments{3};
  elseif (nbInputArguments == 4)
    % h = patch(X, Y, Z, C)
    XData = inputArguments{1};
    YData = inputArguments{2};
    ZData = inputArguments{3};
    CData = inputArguments{4};
    haveCData = true;
  elseif (nbInputArguments > 4)
    error('Nelson:tooManyInputs', 'Too many input arguments.');
  elseif (nbInputArguments > 0)
    error('Nelson:notEnoughInputs', 'Not enough input arguments.');
  end


  if (isvector(XData))
    XData = XData(:);
    YData = YData(:);
    ZData = ZData(:);
    if (haveCData && isnumeric(CData))
      if (isvector(CData) && numel(CData) == numel(XData))
        CData = CData(:);
      elseif (size(CData, 1) ~= numel(XData) && size(CData, 2) == numel(XData))
        CData = CData.';
      end
    end
  end

  args = struct(propertiesList{:});
  ParentAsProperty = getValueFromStruct(args, 'Parent');
  if isfield(args, 'Parent')
    rmfield(args, 'Parent');
  end

  XDataAsProperty = getValueFromStruct(args, 'XData');
  if isfield(args, 'XData')
    rmfield(args, 'XData');
  end

  YDataAsProperty = getValueFromStruct(args, 'YData');
  if isfield(args, 'YData')
    rmfield(args, 'YData');
  end

  ZDataAsProperty = getValueFromStruct(args, 'ZData');
  if isfield(args, 'ZData')
    rmfield(args, 'ZData');
  end

  CDataAsProperty = getValueFromStruct(args, 'CData');
  if isfield(args, 'CData')
    rmfield(args, 'CData');
  end

  FacesAsProperty = getValueFromStruct(args, 'Faces');
  if isfield(args, 'Faces')
    rmfield(args, 'Faces');
  end

  FaceAlphasAsProperty = getValueFromStruct(args, 'FaceAlpha');
  if isfield(args, 'FaceAlpha')
    rmfield(args, 'FaceAlpha');
  end

  VerticesAsProperty = getValueFromStruct(args, 'Vertices');
  if isfield(args, 'Vertices')
    rmfield(args, 'Vertices');
  end

  FaceVertexCDataAsProperty = getValueFromStruct(args, 'FaceVertexCData');
  if isfield(args, 'FaceVertexCData')
    rmfield(args, 'FaceVertexCData');
  end

  FaceColorAsProperty = getValueFromStruct(args, 'FaceColor');
  if isfield(args, 'FaceColor')
    rmfield(args, 'FaceColor');
  end

  EdgeColorAsProperty = getValueFromStruct(args, 'EdgeColor');
  if isfield(args, 'EdgeColor')
    rmfield(args, 'EdgeColor');
  end

  CDataMappingAsProperty = getValueFromStruct(args, 'CDataMapping');
  if isfield(args, 'CDataMapping')
    rmfield(args, 'CDataMapping');
  end

  if isempty(CDataMappingAsProperty)
    CDataMapping = 'scaled';
  else
    CDataMapping = CDataMappingAsProperty;
  end

  if isempty(ParentAsProperty)
    if isempty(ax)
      Parent = gca();
    else
      Parent = ax;
    end
  else
    Parent = ParentAsProperty;
  end

  if (haveCData && isvector(CData) && length(CData) ~= 3)
    colors = colormap(Parent);
    nbColors = size(colors, 1);
    if strcmp(CDataMapping, 'scaled')
      CLim = Parent.CLim;
      index = ceil((CData - CLim(1)) / (CLim(2) - CLim(1)) * (nbColors));
      wrap = mod(index(index > nbColors), nbColors) + 1;
      if ~isempty(wrap)
        index(index > nbColors) = wrap;
      end
      index(index < 1) = 1;
      CData = colors(index, :);
    elseif strcmp(CDataMapping, 'direct')
      CData = CData;
    else
      error('Nelson:patch:invalidCDataMapping', 'CDataMapping scaled or direct value expected.');
    end
  end

  if ~isempty(XDataAsProperty)
    XData = XDataAsProperty;
  end

  if ~isempty(YDataAsProperty)
    YData = YDataAsProperty;
  end

  if ~isempty(ZDataAsProperty)
    ZData = ZDataAsProperty;
  end

  if ~isempty(CDataAsProperty)
    CData = CDataAsProperty;
  end

  if isempty(VerticesAsProperty)
    if isempty(ZData)
      ZData = ones(size(XData));
    end
    if (size(XData) ~= size(YData) | size(XData) ~= size(ZData) | length(size(XData)) > 2)
      error('Nelson:dimagree:sizeDataMismatch', 'Size of data mismatch.');
    end
    Vertices = [XData(:), YData(:), ZData(:)];
  else
    Vertices = VerticesAsProperty;
    if isnumeric(Vertices)
      rows = size(Vertices, 1);
      cols = size(Vertices, 2);
      if (cols == 2)
        Vertices(:, 3) = ones(rows, 1);
      end
    end
  end

  if ~isempty(FacesAsProperty)
    Faces = FacesAsProperty;
  else
    [nx, ny] = size(XData);
    if (nx == 1)
      Faces = reshape(1:nx * ny, [ny, nx])';
    else
      Faces = reshape(1:nx * ny, size(XData))';
    end
  end

  if ~isempty(CDataAsProperty)
    CData = CDataAsProperty;
  else
    if ~haveCData
      CData = Parent.Color;
    end
  end

  if ~isempty(FaceVertexCDataAsProperty)
    FaceVertexCData = FaceVertexCDataAsProperty;
  else
    if isnumeric(CData)
      FaceVertexCData = CData;
    elseif ischar(CData)
      if strcmp(CData, 'none')
        FaceVertexCData = CData;
      else
        FaceVertexCData = validatecolor(CData);
      end
    else
      error('Nelson:patch:stringColorOrExpected', 'String color or numeric value expected.'),
    end
  end

  if ~isempty(FaceColorAsProperty)
    FaceColor = FaceColorAsProperty;
  else
    if ~haveCData
      FaceColor = FaceColorDefault;
    else
      FaceColor = 'flat';
    end
  end

  if ~isempty(EdgeColorAsProperty)
    EdgeColor = EdgeColorAsProperty;
  else
    EdgeColor = EdgeColorDefault;
  end

  if ~isempty(FaceAlphasAsProperty)
    FaceAlpha = FaceAlphasAsProperty;
  else
    FaceAlpha = 1;
  end

  if (isvector(XData) && (length(XData) == 3))
    XData = [XData(1), XData(:)']';
    YData = [YData(1), YData(:)']';
    ZData = [ZData(1), ZData(:)']';
  end

  args.Parent = Parent;
  args.XData = XData;
  args.YData = YData;
  args.ZData = ZData;
  args.CData = CData;
  args.Faces = Faces;
  args.Vertices = Vertices;
  args.FaceVertexCData = FaceVertexCData;
  args.FaceColor = FaceColor;
  args.EdgeColor = EdgeColor;
  args.FaceAlpha = FaceAlpha;

  args = reshape([fieldnames(args)'; struct2cell(args)'], 1, []);

end
%=============================================================================
function color = parseFaceColor(value)
  if isnumeric(value)
    color = value(:).';
  elseif strcmp(value, 'none')
    color = value;
  else
    color = validatecolor(value);
  end
end
%=============================================================================
function tf = isPatchPropertyName(value)
  tf = ischar(value) && isValidGraphicsProperty('patch', value);
end
%=============================================================================
function tf = isFaceColorSpec(value)
  tf = (ischar(value) && ~isValidGraphicsProperty('patch', value)) ...
    || (isnumeric(value) && isvector(value) && numel(value) == 3);
end
%=============================================================================
function tf = hasPatchProperty(propertiesList, name)
  tf = false;
  for k = 1:2:length(propertiesList)
    if ischar(propertiesList{k}) && strcmpi(propertiesList{k}, name)
      tf = true;
      return
    end
  end
end
%=============================================================================
function value = getValueFromStruct(st, name)
  value = [];
  if isfield(st, name)
    value = st.(name);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = pbaspect(varargin)
  narginchk(0, 2);
  nargoutchk(0, 1);

  % Handle zero input: return current axes PlotBoxAspectRatio
  if nargin == 0
    currentAxes = gca();
    varargout{1} = currentAxes.PlotBoxAspectRatio;
    return
  end

  % Parse first argument
  firstArg = varargin{1};
  firstArg = convertStringsToChars(firstArg);

  % Parse second argument if present
  if nargin > 1
    secondArg = varargin{2};
    secondArg = convertStringsToChars(secondArg);
  end

  % Determine axes and value to set/query
  if length(firstArg) == 1 && isgraphics(firstArg, 'axes')
    axesHandle = firstArg;
    if nargin == 2
      aspectValue = secondArg;
    else
      varargout{1} = axesHandle.PlotBoxAspectRatio;
      return
    end
  else
    axesHandle = gca();
    aspectValue = firstArg;
  end

  % Handle string value: mode query/set
  if ischar(aspectValue)
    if strcmp(aspectValue, 'mode')
      varargout{1} = axesHandle.PlotBoxAspectRatioMode;
    else
      axesHandle.PlotBoxAspectRatioMode = aspectValue;
    end
    return
  end

  % Otherwise, set PlotBoxAspectRatio
  axesHandle.PlotBoxAspectRatio = aspectValue;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
