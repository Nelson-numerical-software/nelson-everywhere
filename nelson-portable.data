%=============================================================================
function value = optimResolveMaxFunEvals(opts, numberOfVariables)
  value = opts.MaxFunEvals;
  if isempty(value) || ischar(value) || isstring(value)
    value = 100 * numberOfVariables;
  else
    value = double(value);
  end
end
