function [B, I] = mink(A, k, varargin)
  if ~A.isOrdinal
    error('Nelson:categorical:requiresOrdinal', '%s requires ordinal categorical arrays.', 'mink');
  end
  [S, order] = sort(A);
  I = order(1:k);
  B = S(1:k);
end
