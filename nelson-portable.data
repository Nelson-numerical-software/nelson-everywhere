function TF = isreal(TT)
  narginchk(1, 1);
  T = timetable2table(TT, 'ConvertRowTimes', false);
  TF = isreal(T);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
