% LICENCE_BLOCK_END
function [payload, stdoutText] = extractRunfilePayload(stdoutText)
  sentinel = '__NELSON_UNITTEST_RESULT__';
  payload = '';
  pos = strfind(stdoutText, sentinel);
  if isempty(pos)
    return
  end
  startPos = pos(end);
  payload = stdoutText(startPos + length(sentinel):end);
  eol = strfind(payload, newline);
  if ~isempty(eol)
    payload = payload(1:eol(1) - 1);
  end
  stdoutText = stdoutText(1:startPos - 1);
end
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function payload = extractRunfilePayloadAt(stdoutText, position, sentinel)
  payload = stdoutText(position + length(sentinel):end);
  eol = strfind(payload, newline);
  if ~isempty(eol)
    payload = payload(1:eol(1) - 1);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function payloads = extractRunfilePayloads(stdoutText)
  sentinel = '__NELSON_UNITTEST_RESULT__';
  payloads = struct([]);
  positions = strfind(stdoutText, sentinel);
  for k = 1:length(positions)
    payload = extractRunfilePayloadAt(stdoutText, positions(k), sentinel);
    if ~isempty(payload)
      payloads = [payloads; decode_runfile_payload(payload)];
    end
  end
end
