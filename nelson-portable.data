%=============================================================================
function A = compan(c)
  narginchk(1, 1);
  if ~isvector(c)
    error('Nelson:compan:vectorExpected', 'Input argument must be a vector.');
  end
  c = c(:).';
  n = length(c);
  if n <= 1
    A = [];
  else
    A = zeros(n - 1, n - 1, class(c));
    A(1, :) = -c(2:n) / c(1);
    if n > 2
      A(2:n - 1, 1:n - 2) = eye(n - 2, class(c));
    end
  end
end
