% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = vertcat(varargin)
  error('Nelson:dictionary:cannotCombine', 'Combining ''dictionary'' objects is not allowed as they are designed to be scalar.');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function d = configureDictionary(keyType, valueType)
  mustBeTextScalar(keyType, 1);
  mustBeTextScalar(valueType, 2);
  keyType = convertCharsToStrings(keyType);
  if (~checkIsType(keyType))
    msg = sprintf("Unknown type '%s'. Dictionary could not be created.", keyType);
    error('Nelson:configureDictionary:unknownType', msg);
  end
  valueType = convertCharsToStrings(valueType);
  if (~checkIsType(valueType))
    msg = sprintf("Unknown type '%s'. Dictionary could not be created.", valueType);
    error('Nelson:configureDictionary:unknownType', msg);
  end
  d = dictionary.fromState(struct(), {}, keyType, valueType, {});
end
%=============================================================================
function tf = checkIsType(nameType)
  tf = false;
  numericTypes = ["int8"; "uint8"; "int16"; "uint16"; "int32"; "uint32"; ...
    "int64"; "uint64"; "single"; "double"];
  if ismember(nameType, numericTypes)
    tf = true;
    return
  end
  charStringTypes = ["char"; "string"];
  if ismember(nameType, charStringTypes)
    tf = true;
    return
  end
  specializedTypes = ["logical", "function_handle"];
  if ismember(nameType, specializedTypes)
    tf = true;
    return
  end
  structuredTypes = ["struct"; "cell"];
  if ismember(nameType, structuredTypes)
    tf = true;
    return
  end

  [list_builtin, list_macro] = what();
  all_elements = [list_macro; list_builtin];
  all_elements = string(all_elements);
  all_elements(~startsWith(all_elements, '@')) = [];

  slashIndex = strfind(all_elements, "/");

  for k = 1:numel(slashIndex)
    element = convertStringsToChars(all_elements(k));
    idx = slashIndex{k};
    if ~isempty(idx)
      element = element(2:idx(1) - 1);
    else
      element = element(2:end);
    end
    element = string(element);
    if strcmp(element, nameType)
      tf = true;
      return
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = entries(varargin)
  narginchk(1, 2);
  nargoutchk(0, 1);
  obj = varargin{1};
  mustBeA(obj, 'dictionary', 1);
  if (nargin < 2)
    fmt = 'table';
  else
    fmt = varargin{2};
    mustBeTextScalar(fmt, 2);
  end
  k = keys(obj, 'cell');
  v = values(obj, 'cell');
  if (startsWith('cell', fmt, 'IgnoreCase', true))
    r = [k(:), v(:)];
  elseif (startsWith('struct', fmt, 'IgnoreCase', true))
    r = struct('Key', k(:), 'Value', v(:));
  elseif (startsWith('table', fmt, 'IgnoreCase', true))
    keyColumn = k(:);
    valueColumn = v(:);
    try
      keyColumn = [keyColumn{:}].';
    catch
    end
    if ~strcmp(obj.valueType, 'cell')
      try
        valueColumn = [valueColumn{:}].';
      catch
      end
    end
    r = table(keyColumn, valueColumn, 'VariableNames', {'Key', 'Value'});
  else
    error('Nelson:dictionary:invalidFormat', '%s expected.', 'Wrong value for ''format'' option. ''struct'', ''cell'' or ''table''');
  end
  varargout{1} = r;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function tf = isConfigured(obj)
  tf = ~isempty(obj.keyType);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function k = keys(varargin)
  obj = varargin{1};
  if (~isConfigured(obj))
    error('Nelson:dictionary:unablePerformADictionaryLookup3', 'Unable to perform a dictionary lookup when the key and value types are not set.');
  end

  if (nargin < 2)
    fmt = 'uniform';
  else
    fmt = varargin{2};
    if (~ischar(fmt) && ~isstring(fmt))
      error('Nelson:dictionary:invalidFormatOption', 'format option has to be a string.');
    end
  end

  if (startsWith('cell', fmt, 'IgnoreCase', true))
    k = obj.allKeys(:).';
    for idx = 1:numel(k)
      k{idx} = dictionary.normalizeStoredKey(obj, k{idx});
    end
  elseif (startsWith('uniform', fmt, 'IgnoreCase', true))
    try
      k = keys(obj, 'cell');
      k = [k{:}].';
    catch
      error('Nelson:dictionary:cannotConcatenate', 'Cannot concatenate %s. Use cell option.', 'keys');
    end
  else
    error('Nelson:dictionary:formatOptionCanOnlyCell', 'format option can only be cell.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function count = numEntries(obj)
  count = numel(obj.allKeys);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function d = readdictionary(varargin)
  narginchk(1, inf);
  nargoutchk(0, 1);
  filename = varargin{1};
  mustBeTextScalar(filename, 1);
  options = parseOptions(varargin(2:end));
  if ~strcmpi(options.FileType, 'auto') && ~strcmpi(options.FileType, 'json')
    error('Nelson:dictionary:onlyJsonSupported', 'Only JSON dictionary files are supported.');
  end

  txt = fileread(filename);
  if options.AllowComments
    txt = stripJsonComments(txt);
  end
  pairs = parseJsonObject(txt, options);
  keys = strings(size(pairs, 1), 1);
  values = cell(size(pairs, 1), 1);
  useCellValues = false;
  valueType = '';
  for k = 1:size(pairs, 1)
    keys(k) = string(pairs{k, 1});
    value = decodeJsonValue(pairs{k, 2}, options);
    if ischar(value)
      value = string(value);
    end
    if ~isempty(options.ValueType) && ~isa(value, options.ValueType)
      value = feval(options.ValueType, value);
    end
    values{k} = value;
    if ~isscalar(value)
      useCellValues = true;
    end
    if isempty(valueType)
      valueType = class(value);
    elseif ~strcmp(valueType, class(value))
      useCellValues = true;
    end
  end

  if isempty(keys)
    d = dictionary();
  elseif useCellValues
    d = dictionary(keys, values);
  else
    d = dictionary();
    for k = 1:numel(keys)
      d(keys(k)) = values{k};
    end
  end
end
%=============================================================================
function options = parseOptions(args)
  options = struct();
  options.FileType = 'auto';
  options.ValueType = '';
  options.DictionaryNodeName = '';
  options.DictionarySelector = '';
  options.AllowTrailingCommas = true;
  options.AllowComments = true;
  options.AllowInfAndNaN = true;
  options.DateLocale = '';

  if mod(numel(args), 2) ~= 0
    error('Nelson:dictionary:nameValueExpected', 'Name-value arguments expected.');
  end
  for k = 1:2:numel(args)
    name = convertStringsToChars(args{k});
    value = args{k + 1};
    switch lower(name)
      case 'filetype'
        options.FileType = convertStringsToChars(value);
      case 'valuetype'
        options.ValueType = convertStringsToChars(value);
      case 'dictionarynodename'
        options.DictionaryNodeName = convertStringsToChars(value);
      case 'dictionaryselector'
        options.DictionarySelector = convertStringsToChars(value);
      case 'allowtrailingcommas'
        mustBeLogicalScalar(value, k + 2);
        options.AllowTrailingCommas = value;
      case 'allowcomments'
        mustBeLogicalScalar(value, k + 2);
        options.AllowComments = value;
      case 'allowinfandnan'
        mustBeLogicalScalar(value, k + 2);
        options.AllowInfAndNaN = value;
      case 'datelocale'
        options.DateLocale = convertStringsToChars(value);
      otherwise
        error('Nelson:dictionary:unsupportedOption', 'Unsupported option.');
    end
  end
  if ~isempty(options.DictionaryNodeName) || ~isempty(options.DictionarySelector)
    error('Nelson:readdictionary:optionNotSupportedForJson', 'DictionaryNodeName and DictionarySelector are not supported for JSON dictionary files.');
  end
end
%=============================================================================
function pairs = parseJsonObject(txt, options)
  txt = strtrim(convertStringsToChars(txt));
  if length(txt) < 2 || txt(1) ~= '{' || txt(end) ~= '}'
    error('Nelson:readdictionary:jsonObjectExpected', 'JSON object expected.');
  end
  txt = strtrim(txt(2:end - 1));
  if isempty(txt)
    pairs = cell(0, 2);
    return
  end

  pairs = {};
  idx = 1;
  while idx <= length(txt)
    [key, idx] = parseJsonString(txt, idx);
    idx = skipBlanks(txt, idx);
    if idx > length(txt) || txt(idx) ~= ':'
      error('Nelson:readdictionary:jsonObjectExpected', 'JSON object expected.');
    end
    idx = idx + 1;
    valueStart = skipBlanks(txt, idx);
    [valueText, idx] = parseJsonValue(txt, valueStart);
    pairs(end + 1, :) = {key, valueText};
    idx = skipBlanks(txt, idx);
    if idx <= length(txt)
      if txt(idx) ~= ','
        error('Nelson:readdictionary:jsonObjectExpected', 'JSON object expected.');
      end
      idx = skipBlanks(txt, idx + 1);
      if idx > length(txt)
        if options.AllowTrailingCommas
          break
        else
          error('Nelson:readdictionary:jsonObjectExpected', 'JSON object expected.');
        end
      end
    end
  end
end
%=============================================================================
function [value, idx] = parseJsonString(txt, idx)
  idx = skipBlanks(txt, idx);
  if idx > length(txt) || txt(idx) ~= '"'
    error('Nelson:readdictionary:jsonStringExpected', 'JSON string expected.');
  end
  start = idx;
  idx = idx + 1;
  escaped = false;
  while idx <= length(txt)
    ch = txt(idx);
    if escaped
      escaped = false;
    elseif ch == '\'
      escaped = true;
    elseif ch == '"'
      value = jsondecode(txt(start:idx));
      idx = idx + 1;
      return
    end
    idx = idx + 1;
  end
  error('Nelson:readdictionary:unterminatedJsonString', 'Unterminated JSON string.');
end
%=============================================================================
function [valueText, idx] = parseJsonValue(txt, idx)
  start = idx;
  depth = 0;
  inString = false;
  escaped = false;
  while idx <= length(txt)
    ch = txt(idx);
    if inString
      if escaped
        escaped = false;
      elseif ch == '\'
        escaped = true;
      elseif ch == '"'
        inString = false;
      end
    else
      if ch == '"'
        inString = true;
      elseif ch == '{' || ch == '['
        depth = depth + 1;
      elseif ch == '}' || ch == ']'
        if depth == 0
          break
        end
        depth = depth - 1;
      elseif ch == ',' && depth == 0
        break
      end
    end
    idx = idx + 1;
  end
  valueText = strtrim(txt(start:idx - 1));
end
%=============================================================================
function idx = skipBlanks(txt, idx)
  while idx <= length(txt) && (isspace(txt(idx)) || any(double(txt(idx)) == [9 10 11 12 13 32]))
    idx = idx + 1;
  end
end
%=============================================================================
function value = decodeJsonValue(valueText, options)
  trimmed = strtrim(valueText);
  if startsWith(trimmed, '[')
    value = decodeJsonArrayValue(trimmed, options);
    return
  end
  if startsWith(trimmed, '{')
    value = decodeJsonObjectValue(trimmed, options);
    return
  end
  switch trimmed
    case 'NaN'
      if ~options.AllowInfAndNaN
        error('Nelson:readdictionary:jsonObjectExpected', 'JSON object expected.');
      end
      value = NaN;
      return
    case {'Infinity', 'Inf'}
      if ~options.AllowInfAndNaN
        error('Nelson:readdictionary:jsonObjectExpected', 'JSON object expected.');
      end
      value = Inf;
      return
    case {'-Infinity', '-Inf'}
      if ~options.AllowInfAndNaN
        error('Nelson:readdictionary:jsonObjectExpected', 'JSON object expected.');
      end
      value = -Inf;
      return
  end
  value = jsondecode(valueText);
  if ischar(value)
    value = string(value);
  end
end
%=============================================================================
function value = decodeJsonObjectValue(valueText, options)
  pairs = parseJsonObject(valueText, options);
  value = struct();
  for k = 1:size(pairs, 1)
    field = pairs{k, 1};
    value.(field) = decodeJsonValue(pairs{k, 2}, options);
  end
end
%=============================================================================
function value = decodeJsonArrayValue(valueText, options)
  if length(valueText) < 2 || valueText(1) ~= '[' || valueText(end) ~= ']'
    error('Nelson:readdictionary:jsonObjectExpected', 'JSON object expected.');
  end
  body = strtrim(valueText(2:end - 1));
  if isempty(body)
    value = [];
    return
  end
  parts = splitJsonList(body);
  values = cell(numel(parts), 1);
  for k = 1:numel(parts)
    values{k} = decodeJsonValue(parts{k}, options);
  end
  value = values;
end
%=============================================================================
function parts = splitJsonList(txt)
  parts = {};
  start = 1;
  idx = 1;
  depth = 0;
  inString = false;
  escaped = false;
  while idx <= length(txt)
    ch = txt(idx);
    if inString
      if escaped
        escaped = false;
      elseif ch == '\'
        escaped = true;
      elseif ch == '"'
        inString = false;
      end
    else
      if ch == '"'
        inString = true;
      elseif ch == '[' || ch == '{'
        depth = depth + 1;
      elseif ch == ']' || ch == '}'
        depth = depth - 1;
      elseif ch == ',' && depth == 0
        parts{end + 1} = strtrim(txt(start:idx - 1));
        start = idx + 1;
      end
    end
    idx = idx + 1;
  end
  parts{end + 1} = strtrim(txt(start:end));
end
%=============================================================================
function txt = stripJsonComments(txt)
  txt = convertStringsToChars(txt);
  out = '';
  idx = 1;
  inString = false;
  escaped = false;
  while idx <= length(txt)
    ch = txt(idx);
    if inString
      out(end + 1) = ch;
      if escaped
        escaped = false;
      elseif ch == '\'
        escaped = true;
      elseif ch == '"'
        inString = false;
      end
      idx = idx + 1;
    elseif ch == '"'
      inString = true;
      out(end + 1) = ch;
      idx = idx + 1;
    elseif ch == '/' && idx < length(txt) && txt(idx + 1) == '/'
      idx = idx + 2;
      while idx <= length(txt) && ~any(double(txt(idx)) == [10 13])
        idx = idx + 1;
      end
    elseif ch == '/' && idx < length(txt) && txt(idx + 1) == '*'
      idx = idx + 2;
      while idx < length(txt) && ~(txt(idx) == '*' && txt(idx + 1) == '/')
        idx = idx + 1;
      end
      idx = min(idx + 2, length(txt) + 1);
    else
      out(end + 1) = ch;
      idx = idx + 1;
    end
  end
  txt = out;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = types(varargin)
  narginchk(1, 1);
  nargoutchk(0, 2);
  obj = varargin{1};
  if (~isConfigured(obj))
    keyType = string(NaN);
    valueType = string(NaN);
  else
    keyType = convertCharsToStrings(obj.keyType);
    valueType = convertCharsToStrings(obj.valueType);
  end
  varargout{1} = keyType;
  if nargout > 1
    varargout{2} = valueType;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function v = values(varargin)
  narginchk(1, 2)
  obj = varargin{1};
  if (~isConfigured(obj))
    error('Nelson:dictionary:unablePerformADictionaryLookup3', 'Unable to perform a dictionary lookup when the key and value types are not set.');
  end

  if (nargin < 2)
    fmt = 'uniform';
  else
    fmt = varargin{2};
    if (~ischar(fmt) && ~isstring(fmt))
      error('Nelson:dictionary:invalidFormatOption', 'format option has to be a string.');
    end
  end
  if (startsWith('cell', fmt, 'IgnoreCase', true))
    v = obj.allValues(:);
    for idx = 1:numel(v)
      if strcmp(obj.valueType, 'cell') && iscell(v{idx}) && isscalar(v{idx})
        v{idx} = v{idx}{1};
      else
        v{idx} = dictionary.normalizeStoredValue(obj, v{idx});
      end
    end
  elseif (startsWith('uniform', fmt, 'IgnoreCase', true))
    v = values(obj, 'cell');
    if strcmp(obj.valueType, 'cell')
      return
    end
    try
      v = [v{:}].';
    catch
      error('Nelson:dictionary:cannotConcatenate', 'Cannot concatenate %s. Use cell option.', 'values');
    end
  else
    error('Nelson:dictionary:formatOptionCanOnlyCell', 'format option can only be cell.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function writedictionary(varargin)
  narginchk(2, inf);
  nargoutchk(0, 0);
  d = varargin{1};
  mustBeA(d, 'dictionary', 1);
  filename = varargin{2};
  mustBeTextScalar(filename, 2);

  options = parseOptions(varargin(3:end));
  if ~strcmpi(options.FileType, 'auto') && ~strcmpi(options.FileType, 'json')
    error('Nelson:dictionary:onlyJsonSupported', 'Only JSON dictionary files are supported.');
  end
  txt = dictionaryToJson(d, options.PrettyPrint, options.PreserveInfAndNaN);
  filewrite(filename, txt);
end
%=============================================================================
function options = parseOptions(args)
  options = struct();
  options.FileType = 'auto';
  options.PrettyPrint = true;
  options.PreserveInfAndNaN = true;

  if mod(numel(args), 2) ~= 0
    error('Nelson:dictionary:nameValueExpected', 'Name-value arguments expected.');
  end
  for k = 1:2:numel(args)
    name = convertStringsToChars(args{k});
    value = args{k + 1};
    switch lower(name)
      case 'filetype'
        options.FileType = convertStringsToChars(value);
      case 'prettyprint'
        mustBeLogicalScalar(value, k + 2);
        options.PrettyPrint = value;
      case 'preserveinfandnan'
        mustBeLogicalScalar(value, k + 2);
        options.PreserveInfAndNaN = value;
      otherwise
        error('Nelson:dictionary:unsupportedOption', 'Unsupported option.');
    end
  end
end
%=============================================================================
function txt = dictionaryToJson(d, pretty, preserveInfAndNaN)
  if ~isConfigured(d)
    error('Nelson:writedictionary:typesNotSet', 'Unable to write a dictionary when the key and value types are not set.');
  end

  allKeys = keys(d, 'cell');
  allValues = values(d, 'cell');
  if isempty(allKeys)
    txt = "{}";
    return
  end
  if pretty
    lines = strings(numel(allKeys) + 2, 1);
    lines(1) = "{";
    for k = 1:numel(allKeys)
      suffix = ",";
      if k == numel(allKeys)
        suffix = "";
      end
      value = dictionaryJsonValueText(allValues{k}, preserveInfAndNaN);
      lines(k + 1) = "    " + jsonencode(dictionaryJsonKey(allKeys{k})) + ": " + value + suffix;
    end
    lines(end) = "}";
    txt = join(lines, newline());
  else
    parts = strings(1, numel(allKeys));
    for k = 1:numel(allKeys)
      value = dictionaryJsonValueText(allValues{k}, preserveInfAndNaN);
      parts(k) = jsonencode(dictionaryJsonKey(allKeys{k})) + ":" + value;
    end
    txt = "{" + join(parts, ",") + "}";
  end
end
%=============================================================================
function value = dictionaryJsonValue(value)
  if iscell(value) && isscalar(value)
    value = value{1};
  end
end
%=============================================================================
function txt = dictionaryJsonValueText(value, preserveInfAndNaN)
  value = dictionaryJsonValue(value);
  if preserveInfAndNaN
    txt = jsonValueText(value);
  else
    txt = jsonencode(value);
  end
end
%=============================================================================
function txt = jsonValueText(value)
  if isstruct(value)
    txt = jsonStructText(value);
  elseif iscell(value)
    txt = jsonCellText(value);
  elseif isnumeric(value)
    txt = jsonNumericText(value);
  else
    txt = jsonencode(value);
  end
end
%=============================================================================
function txt = jsonStructText(value)
  if isempty(value)
    txt = "[]";
    return
  end
  if numel(value) > 1
    parts = strings(1, numel(value));
    for k = 1:numel(value)
      parts(k) = jsonStructText(value(k));
    end
    txt = "[" + join(parts, ",") + "]";
    return
  end
  names = fieldnames(value);
  parts = strings(1, numel(names));
  for k = 1:numel(names)
    name = names{k};
    parts(k) = jsonencode(name) + ":" + jsonValueText(value.(name));
  end
  txt = "{" + join(parts, ",") + "}";
end
%=============================================================================
function txt = jsonCellText(value)
  if isempty(value)
    txt = "[]";
    return
  end
  if isvector(value)
    parts = strings(1, numel(value));
    for k = 1:numel(value)
      parts(k) = jsonValueText(value{k});
    end
    txt = "[" + join(parts, ",") + "]";
    return
  end
  rows = strings(size(value, 1), 1);
  for r = 1:size(value, 1)
    rows(r) = jsonCellText(value(r, :));
  end
  txt = "[" + join(rows, ",") + "]";
end
%=============================================================================
function txt = jsonNumericText(value)
  if isempty(value) || all(isfinite(value(:)))
    txt = jsonencode(value);
    return
  end
  if isscalar(value)
    txt = jsonNonFiniteScalarText(value);
  elseif isvector(value)
    parts = strings(1, numel(value));
    for k = 1:numel(value)
      parts(k) = jsonNumericText(value(k));
    end
    txt = "[" + join(parts, ",") + "]";
  elseif ismatrix(value)
    rows = strings(size(value, 1), 1);
    for r = 1:size(value, 1)
      rows(r) = jsonNumericText(value(r, :));
    end
    txt = "[" + join(rows, ",") + "]";
  else
    txt = jsonencode(value);
  end
end
%=============================================================================
function txt = jsonNonFiniteScalarText(value)
  if isnan(value)
    txt = "NaN";
  elseif value > 0
    txt = "Infinity";
  else
    txt = "-Infinity";
  end
end
%=============================================================================
function key = dictionaryJsonKey(value)
  if isstring(value)
    if ~isscalar(value)
      error('Nelson:writedictionary:jsonKeysMustBeScalar', 'Dictionary JSON keys must be scalar values.');
    end
    key = char(value);
  elseif ischar(value)
    key = value;
  elseif islogical(value)
    if ~isscalar(value)
      error('Nelson:writedictionary:jsonKeysMustBeScalar', 'Dictionary JSON keys must be scalar values.');
    end
    if value
      key = 'true';
    else
      key = 'false';
    end
  elseif isnumeric(value)
    if ~isscalar(value)
      error('Nelson:writedictionary:jsonKeysMustBeScalar', 'Dictionary JSON keys must be scalar values.');
    end
    key = strtrim(num2str(value, 17));
  else
    error('Nelson:writedictionary:invalidJsonKeyType', 'Dictionary JSON keys must be text, numeric, or logical scalar values.');
  end
end
