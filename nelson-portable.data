function yq = makima(x, y, xq)
  narginchk(2, 3);
  nargoutchk(0, 1);
  if nargin == 2
    yq = interp1(x, y, 'makima', 'pp');
  else
    yq = interp1(x, y, xq, 'makima');
  end
end
