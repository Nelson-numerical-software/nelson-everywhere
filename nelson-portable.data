% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function opts = defaultOptions(solver)
  opts = struct();
  opts.Display = 'notify';
  opts.MaxFunEvals = [];
  opts.MaxFunctionEvaluations = [];
  opts.MaxIter = [];
  opts.MaxIterations = [];
  opts.TolX = 1e-4;
  opts.TolFun = 1e-4;
  opts.FunctionTolerance = [];
  opts.StepTolerance = [];
  opts.OptimalityTolerance = 1e-6;
  opts.ConstraintTolerance = 1e-6;
  opts.FiniteDifferenceType = 'forward';
  opts.FiniteDifferenceStepSize = [];
  opts.TypicalX = [];
  opts.FunValCheck = 'off';
  opts.OutputFcn = [];
  opts.PlotFcns = [];
  opts.Jacobian = 'off';
  opts.GradObj = 'off';
  opts.GradConstr = 'off';
  opts.HessianFcn = [];
  opts.HessianMultiplyFcn = [];
  opts.SpecifyObjectiveGradient = false;
  opts.SpecifyConstraintGradient = false;
  opts.Algorithm = defaultAlgorithm(solver);
  opts.BarrierParamUpdate = 'monotone';
  opts.EnableFeasibilityMode = false;
  opts.Hessian = [];
  opts.HessianApproximation = 'bfgs';
  opts.HessUpdate = 'bfgs';
  opts.SubproblemAlgorithm = 'cg';
  opts.ScaleProblem = 'none';
  opts.Diagnostics = 'off';
  opts.HonorBounds = true;
  opts.UseParallel = false;
  opts.UseCodegenSolver = false;
  opts.HessFcn = [];
  opts.HessMult = [];
  opts.MaxTime = Inf;
  opts.MaxNodes = [];
  opts.MaxFeasiblePoints = [];
  opts.MaxNumFeasPoints = [];
  opts.AbsoluteGapTolerance = 1e-6;
  opts.RelativeGapTolerance = 1e-4;
  opts.TolGapAbs = [];
  opts.TolGapRel = [];
  opts.IntegerTolerance = 1e-6;
  opts.TolInteger = [];
  opts.LPMaxIterations = [];
  opts.LPOptimalityTolerance = 1e-7;
  opts.LPPreprocess = 'basic';
  opts.NodeSelection = 'simplebestproj';
  opts.RootLPAlgorithm = 'dual-simplex';
  opts.Heuristics = 'basic';
  opts.CutGeneration = 'basic';
  opts.ObjectiveImprovementThreshold = 0;
  opts.MaxPCGIter = [];
  opts.MaxProjCGIter = [];
  opts.PrecondBandWidth = 0;
  opts.TolPCG = 0.1;
  opts.TolConSQP = 1e-6;
  opts.TolProjCG = 0.01;
  opts.TolProjCGAbs = 1e-10;
  switch lower(solver)
    case {'fminsearch', 'fminbnd', 'fzero'}
      opts.MaxFunEvals = 500;
      opts.MaxIter = 500;
      opts.FunctionTolerance = opts.TolFun;
      opts.StepTolerance = opts.TolX;
    case 'lsqnonneg'
      opts.MaxIter = [];
      opts.TolX = 10 * eps;
      opts.Display = 'off';
    case 'quadprog'
      opts.MaxIterations = 200;
      opts.MaxIter = 200;
      opts.StepTolerance = 1e-6;
      opts.Display = 'final';
    case 'fmincon'
      opts.Algorithm = 'interior-point';
      % Algorithm-dependent defaults (MaxIterations, MaxFunctionEvaluations,
      % StepTolerance, SubproblemAlgorithm) stay empty here and are resolved
      % against the selected algorithm by resolveAlgorithmDefaults.
      opts.MaxIterations = [];
      opts.MaxIter = [];
      opts.MaxFunctionEvaluations = [];
      opts.MaxFunEvals = [];
      opts.FunctionTolerance = 1e-6;
      opts.TolFun = 1e-6;
      opts.StepTolerance = [];
      opts.TolX = [];
      opts.SubproblemAlgorithm = [];
      opts.ObjectiveLimit = -1e20;
      opts.Display = 'final';
    case {'fsolve', 'lsqnonlin'}
      opts.MaxIterations = 400;
      opts.MaxIter = 400;
      opts.MaxFunctionEvaluations = '100*numberOfVariables';
      opts.MaxFunEvals = '100*numberOfVariables';
      opts.FunctionTolerance = 1e-6;
      opts.TolFun = 1e-6;
      opts.StepTolerance = 1e-6;
      opts.TolX = 1e-6;
      opts.InitDamping = 0.01;
      opts.Display = 'final';
    case 'fminunc'
      opts.Algorithm = 'quasi-newton';
      opts.MaxIterations = 400;
      opts.MaxIter = 400;
      opts.MaxFunctionEvaluations = 1000;
      opts.MaxFunEvals = 1000;
      opts.FunctionTolerance = 1e-6;
      opts.TolFun = 1e-6;
      opts.StepTolerance = 1e-6;
      opts.TolX = 1e-6;
      opts.ObjectiveLimit = -1e20;
      opts.Display = 'final';
    case 'intlinprog'
      opts.Algorithm = 'highs';
      opts.MaxNodes = 1e4;
      opts.MaxNumFeasPoints = Inf;
      opts.MaxFeasiblePoints = Inf;
      opts.MaxIterations = 30000;
      opts.MaxIter = 30000;
      opts.Display = 'final';
    case 'linprog'
      opts.Algorithm = 'highs';
      opts.MaxIterations = 30000;
      opts.MaxIter = 30000;
      opts.Display = 'final';
    case 'default'
      opts.Display = 'notify';
    otherwise
      opts.MaxIterations = 400;
      opts.MaxFunctionEvaluations = 1000;
      opts.MaxFunEvals = 1000;
      opts.FunctionTolerance = 1e-6;
      opts.StepTolerance = 1e-6;
      opts.Display = 'final';
  end
end
%=============================================================================
function algorithm = defaultAlgorithm(solver)
  switch lower(solver)
    case 'fminsearch'
      algorithm = 'nelder-mead';
    case 'fminbnd'
      algorithm = 'golden-section';
    case 'fzero'
      algorithm = 'brent';
    case 'lsqnonneg'
      algorithm = 'active-set';
    case 'quadprog'
      algorithm = 'active-set';
    case 'fmincon'
      algorithm = 'interior-point';
    case 'fminunc'
      algorithm = 'quasi-newton';
    case {'intlinprog', 'linprog'}
      algorithm = 'highs';
    case 'lsqnonlin'
      algorithm = 'trust-region-reflective';
    case 'fsolve'
      algorithm = 'trust-region-dogleg';
    otherwise
      algorithm = 'default';
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function opts = mergeOptions(solver, varargin)
  opts = defaultOptions(solver);
  for k = 1:nargin - 1
    arg = varargin{k};
    if isempty(arg)
      continue
    end
    alreadyValidated = false;
    if isobject(arg)
      arg = struct(arg);
      alreadyValidated = true;
    end
    if ~isstruct(arg) || ~isscalar(arg)
      error('Nelson:optimization:invalidOptions', 'Options must be a scalar structure or optimization options object.');
    end
    fields = fieldnames(arg);
    for i = 1:length(fields)
      value = arg.(fields{i});
      if isempty(value)
        continue
      end
      if alreadyValidated && isfield(opts, fields{i})
        opts.(fields{i}) = value;
      else
        name = fieldName(fields{i}, opts);
        opts.(name) = validateOption(name, value);
      end
    end
  end
  opts = normalizeAliases(opts);
end
%=============================================================================
function name = fieldName(inputName, opts)
  if isfield(opts, inputName)
    name = inputName;
  else
    name = canonicalName(inputName);
  end
end
%=============================================================================
function opts = normalizeAliases(opts)
  if ~isempty(opts.MaxFunctionEvaluations)
    opts.MaxFunEvals = opts.MaxFunctionEvaluations;
  elseif ~isempty(opts.MaxFunEvals)
    opts.MaxFunctionEvaluations = opts.MaxFunEvals;
  end
  if ~isempty(opts.MaxIterations)
    opts.MaxIter = opts.MaxIterations;
  elseif ~isempty(opts.MaxIter)
    opts.MaxIterations = opts.MaxIter;
  end
  if ~isempty(opts.FunctionTolerance)
    opts.TolFun = opts.FunctionTolerance;
  end
  if ~isempty(opts.StepTolerance)
    opts.TolX = opts.StepTolerance;
  end
  if isfield(opts, 'TolCon') && ~isempty(opts.TolCon)
    opts.ConstraintTolerance = opts.TolCon;
  end
  if isfield(opts, 'PlotFcn') && ~isempty(opts.PlotFcn)
    opts.PlotFcns = opts.PlotFcn;
  end
  if isfield(opts, 'HessFcn') && ~isempty(opts.HessFcn)
    opts.HessianFcn = opts.HessFcn;
  end
  if isfield(opts, 'HessMult') && ~isempty(opts.HessMult)
    opts.HessianMultiplyFcn = opts.HessMult;
  end
  if isfield(opts, 'Hessian') && (ischar(opts.Hessian) || isstring(opts.Hessian)) && ~isempty(opts.Hessian)
    opts.HessianApproximation = opts.Hessian;
  end
end
%=============================================================================
function value = validateOption(name, value)
  if strcmp(name, 'EnableFeasibilityMode')
    value = logicalScalar(value, name);
    return
  end
  if strcmp(name, 'HessianApproximation') || strcmp(name, 'HessUpdate')
    value = hessianApproximationValue(value, name);
    return
  end
  switch name
    case {'Display', 'FiniteDifferenceType', 'FunValCheck', 'Jacobian', ...
        'LargeScale', 'ScaleProblem', 'Diagnostics', 'Algorithm', ...
        'SubproblemAlgorithm', 'GradObj', 'GradConstr', 'HessUpdate', ...
        'CutGeneration', 'Heuristics', 'LPPreprocess', 'NodeSelection', 'RootLPAlgorithm', ...
        'BarrierParamUpdate', 'HessianApproximation'}
      value = textValue(value, name);
    case 'Hessian'
      if isnumeric(value) || ischar(value) || isstring(value)
        return
      end
      error('Nelson:optimization:mustBeNumericOrText', '%s must be a numeric matrix or text scalar.', name);
    case {'OutputFcn', 'PlotFcn', 'PlotFcns', 'HessianFcn', 'HessianMultiplyFcn', ...
        'HessFcn', 'HessMult', 'JacobMult', 'JacobPattern', 'HessPattern', 'TypicalX'}
      return
    case {'MaxFunEvals', 'MaxFunctionEvaluations'}
      if ischar(value) || isstring(value)
        value = char(value);
        return
      end
      if ~(isnumeric(value) && isscalar(value)) || isnan(value)
        error('Nelson:optimization:mustBeNumericScalar', '%s must be a numeric scalar.', name);
      end
      value = double(value);
    case {'UseParallel', 'SpecifyObjectiveGradient', 'SpecifyConstraintGradient', ...
        'CheckGradients', 'HonorBounds', 'UseCodegenSolver'}
      value = logicalScalar(value, name);
    otherwise
      if ~(isnumeric(value) && isscalar(value)) || isnan(value)
        error('Nelson:optimization:mustBeNumericScalar', '%s must be a numeric scalar.', name);
      end
      value = double(value);
  end
end
%=============================================================================
function value = hessianApproximationValue(value, name)
  if iscell(value)
    if isempty(value) || ~ischar(value{1}) || ~strcmpi(value{1}, 'lbfgs')
      error('Nelson:optimization:invalidValue', '%s must be a valid Hessian approximation.', name);
    end
    if numel(value) > 1 && (~isnumeric(value{2}) || ~isscalar(value{2}) || value{2} < 1)
      error('Nelson:optimization:mustBePositive', '%s memory value must be a positive scalar.', name);
    end
    return
  end
  value = textValue(value, name);
end
%=============================================================================
function value = logicalScalar(value, name)
  if ~(islogical(value) || isnumeric(value)) || ~isscalar(value)
    error('Nelson:validators:mustBeLogicalScalar', '%s must be a logical scalar.', name);
  end
  value = logical(value);
end
%=============================================================================
function txt = textValue(value, name)
  if isstring(value)
    if ~isscalar(value)
      error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', name);
    end
    value = char(value);
  end
  if ~ischar(value) || size(value, 1) ~= 1
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', name);
  end
  txt = value;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function opts = resolveAlgorithmDefaults(solver, opts)
  % Fill algorithm-dependent fmincon defaults that the user did not set.
  if ~strcmpi(solver, 'fmincon')
    return
  end
  isInteriorPoint = strcmpi(char(opts.Algorithm), 'interior-point');
  if isempty(opts.MaxIterations) && isempty(opts.MaxIter)
    if isInteriorPoint
      value = 1000;
    else
      value = 400;
    end
    opts.MaxIterations = value;
    opts.MaxIter = value;
  end
  if isempty(opts.MaxFunctionEvaluations) && isempty(opts.MaxFunEvals)
    if isInteriorPoint
      value = 3000;
    else
      value = '100*numberOfVariables';
    end
    opts.MaxFunctionEvaluations = value;
    opts.MaxFunEvals = value;
  end
  if isempty(opts.StepTolerance) && isempty(opts.TolX)
    if isInteriorPoint
      value = 1e-10;
    else
      value = 1e-6;
    end
    opts.StepTolerance = value;
    opts.TolX = value;
  end
  if isempty(opts.SubproblemAlgorithm)
    if isInteriorPoint
      opts.SubproblemAlgorithm = 'factorization';
    else
      opts.SubproblemAlgorithm = 'cg';
    end
  end
end
