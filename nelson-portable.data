% LICENCE_BLOCK_END
%=============================================================================
function TF = isreal(T)
  narginchk(1, 1);
  names = T.Properties.VariableNames;
  TF = true;
  for k = 1:length(names)
    if ~isreal(T.(names{k}))
      TF = false;
      return
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function T = join(left, right, varargin)
  narginchk(2, Inf);
  mustBeA(left, 'table', 1);
  mustBeA(right, 'table', 2);
  % A simple join matches every row of the left table to a single row of the
  % right table by key. It therefore requires the right key values to be unique
  % and to cover every left key value; otherwise it errors. When both hold, the
  % result is exactly the inner join (merged keys, one row per left row, in left
  % order), so the assembly is delegated to innerjoin.
  leftSt = struct(left);
  rightSt = struct(right);
  leftNames = leftSt.Properties.VariableNames;
  rightNames = rightSt.Properties.VariableNames;
  [leftKeyNames, rightKeyNames] = resolveKeyNames(leftNames, rightNames, varargin);
  if ~isempty(rightKeyNames)
    leftKeyIdx = keyNamesToIndices(leftKeyNames, leftNames);
    rightKeyIdx = keyNamesToIndices(rightKeyNames, rightNames);
    rightRowKeys = tableRowKeys(rightSt, height(right), rightKeyIdx);
    if numel(unique(rightRowKeys)) ~= numel(rightRowKeys)
      error('Nelson:table:invalidKey', 'Right-table key values must be unique.');
    end
    leftRowKeys = tableRowKeys(leftSt, height(left), leftKeyIdx);
    tf = tableIsmemberKeys(leftRowKeys, rightRowKeys);
    if ~all(tf)
      error('Nelson:table:keyValuesNotCovered', 'Right-table key values must cover every left-table key value.');
    end
  end
  T = innerjoin(left, right, varargin{:});
end
%=============================================================================
function [leftKeyNames, rightKeyNames] = resolveKeyNames(leftNames, rightNames, args)
  leftKeyNames = {};
  rightKeyNames = {};
  k = 1;
  while k + 1 <= numel(args)
    name = args{k};
    if ischar(name) || (isstring(name) && isscalar(name))
      value = args{k + 1};
      switch lower(char(name))
        case 'keys'
          leftKeyNames = toNameCell(value);
          rightKeyNames = leftKeyNames;
        case 'leftkeys'
          leftKeyNames = toNameCell(value);
        case 'rightkeys'
          rightKeyNames = toNameCell(value);
      end
    end
    k = k + 2;
  end
  if isempty(leftKeyNames) && isempty(rightKeyNames)
    common = leftNames(ismember(leftNames, rightNames));
    leftKeyNames = common;
    rightKeyNames = common;
  elseif isempty(rightKeyNames)
    rightKeyNames = leftKeyNames;
  elseif isempty(leftKeyNames)
    leftKeyNames = rightKeyNames;
  end
end
%=============================================================================
function names = toNameCell(value)
  if ischar(value)
    names = {value};
  elseif isstring(value)
    names = cellstr(value(:)');
  elseif iscell(value)
    names = value(:)';
  else
    names = value;
  end
end
%=============================================================================
function idx = keyNamesToIndices(keyNames, allNames)
  if isnumeric(keyNames)
    idx = keyNames(:)';
    return
  end
  if islogical(keyNames)
    idx = find(keyNames(:)');
    return
  end
  idx = zeros(1, numel(keyNames));
  for k = 1:numel(keyNames)
    found = find(strcmp(allNames, keyNames{k}), 1);
    if isempty(found)
      error('Nelson:table:unrecognizedVariable', _('Unrecognized table variable name ''%s''.'), keyNames{k});
    end
    idx(k) = found;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [st, rows] = tableAppendVariables(st, names, isNew, rows, nRows, samples, rowSub)
  % Appends names(isNew) as columns of the default value of the class of
  % their sample (what growing an array of that class fills in), with the
  % width of the sample. The caller assigns the selected rows; the other
  % rows keep the default value, with a warning when the row subscript
  % rowSub is not given by row names.
  if isempty(st.Properties.VariableNames)
    st.data = struct();
    if nRows == 0
      nRows = size(samples{find(isNew, 1)}, 1);
      rows = 1:nRows;
    end
  end
  for k = find(isNew)
    sample = samples{k};
    nSample = size(sample, 1);
    if (nSample ~= numel(rows) && nSample ~= 1) || (nSample == 0 && nRows > 0)
      error('Nelson:table:dimagree:valueAssignmentNumberRowsTable', 'Value assignment must have the same number of rows as the table.');
    end
    st.data.(names{k}) = tableDefaultColumn(sample, nRows);
    st.Properties.VariableNames{end + 1} = names{k};
  end
  isRowNames = isstring(rowSub) || iscellstr(rowSub) || (ischar(rowSub) && ~strcmp(rowSub, ':'));
  if ~isRowNames && ~isempty(rows) && max(rows) <= nRows && numel(unique(rows)) < nRows
    warning('Nelson:table:rowsAddedNewVars', 'The new variables being added to the table have fewer rows than the table. They have been extended with rows containing default values.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function col = tableAssignVariableRows(col, rows, data, name)
  % T(rows, vars) = value: a variable of value replaces the indexed rows of
  % the variable name; it must have their size, or be a scalar.
  leftSize = size(col);
  leftSize(1) = numel(rows);
  isScalarData = isscalar(data); % not inlined: an if on isscalar(object) ignores its overload
  if ~isScalarData && ~isequal(size(data), leftSize)
    error('Nelson:table:AssignmentDimensionMismatch', 'Unable to perform assignment for table variable ''%s'' because its size on the left side is %s and the size of the corresponding variable on the right side is %s.', ...
      name, sizeText(leftSize), sizeText(size(data)));
  end
  col(rows, :) = data;
end
%=============================================================================
function txt = sizeText(sz)
  txt = char(strjoin(string(sz), '-by-'));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [st, rows] = tableBraceNewVariables(st, names, rows, nRows, value, rowSub)
  % T{rows, names} = value: the names that are not variables yet are
  % appended, typed after value (one column of value per name when several
  % names are given). The caller then assigns the selected rows.
  isNew = ~ismember(names, st.Properties.VariableNames);
  if ~any(isNew)
    return
  end
  samples = cell(1, length(names));
  for k = find(isNew)
    if length(names) == 1
      samples{k} = value;
    else
      samples{k} = value(:, k);
    end
  end
  [st, rows] = tableAppendVariables(st, names, isNew, rows, nRows, samples, rowSub);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function tableCheckRowIndex(rows, nRows)
  % A row subscript that reads beyond the height of the table.
  if ~isempty(rows) && max(rows) > nRows
    error('Nelson:table:rowIndexOutOfRange', _('Row index exceeds table dimensions.'));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function tableCheckRowNamesCount(props, data)
  % Nonempty (already validated) RowNames name every row. The height is
  % read from the data of the first variable; without variables, from the
  % n-by-0 data struct (a scalar field-less struct is an unset height, as
  % in table()).
  nNames = numel(props.RowNames);
  if nNames == 0
    return
  end
  names = props.VariableNames;
  if isempty(names)
    if ~isempty(data)
      return
    end
    nRows = size(data, 1);
  elseif iscell(names) && isfield(data, names{1})
    nRows = size(data.(names{1}), 1);
  else
    return
  end
  if nNames ~= nRows
    error('Nelson:table:incorrectNumberOfRowNames', _('The RowNames property must contain one name for each row in the table.'));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function value = tableColumnRows(value, rows)
  if isvector(value)
    value = value(rows, :);
  else
    idx = repmat({':'}, 1, ndims(value) - 1);
    value = value(rows, idx{:});
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function column = tableDefaultColumn(sample, nRows)
  % nRows rows of the default value of the class of sample (what growing an
  % array of that class fills in: 0, false, <missing>, NaT, <undefined>, an
  % empty cell, ...), as wide as sample.
  column = sample([], :);
  if nRows > 0
    column(nRows + 1, :) = sample(1, :);
    column = column(1:nRows, :);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function names = tableDefaultRowNames(rows, takenNames)
  % Row<k> for each row number k in rows, with a _<n> suffix when that name
  % is already in takenNames or given to an earlier row.
  if isempty(rows)
    names = cell(0, 1);
    return
  end
  names = reshape(cellstr(compose('Row%d', rows(:))), [], 1);
  clash = find(ismember(names, takenNames));
  for k = reshape(clash, 1, [])
    base = names{k};
    suffix = 1;
    while any(strcmp(takenNames, names{k})) || any(strcmp(names([1:k - 1, k + 1:end]), names{k}))
      names{k} = sprintf('%s_%d', base, suffix);
      suffix = suffix + 1;
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function value = tableDefaultValue(sample, nRows)
  if nargin < 2
    nRows = 1;
  end
  sz = size(sample);
  sz(1) = nRows;
  if isnumeric(sample)
    if isfloat(sample)
      value = NaN(sz);
      value = cast(value, class(sample));
    else
      value = zeros(sz, class(sample));
    end
  elseif islogical(sample)
    value = false(sz);
  elseif isstring(sample)
    value = strings(sz);
  elseif iscell(sample)
    value = cell(sz);
  else
    value = cell(nRows, 1);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function st = tableDeleteVariables(st, vars)
  % Removes the variables vars (indices) with their per-variable metadata.
  % Metadata left unset (not one entry per variable) is kept as it is.
  vars = unique(vars);
  names = st.Properties.VariableNames;
  st.Properties.CustomProperties = table.variableCustomPropertiesSubset(st, setdiff(1:length(names), vars));
  for k = vars(:)'
    st.data = rmfield(st.data, names{k});
  end
  nVars = length(names);
  perVariable = {'VariableNames', 'VariableTypes', 'VariableDescriptions', 'VariableUnits', 'VariableContinuity'};
  for k = 1:length(perVariable)
    field = perVariable{k};
    if isfield(st.Properties, field) && numel(st.Properties.(field)) == nVars
      st.Properties.(field)(vars) = [];
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function value = tableDisplayCellText(value)
  % One-line text of one row of a table variable. Longer than 15 characters,
  % or N-D, it is replaced by its size and class, except a text or a time.
  originalValue = value;
  if ndims(value) > 2
    value = sizeAsString(value);
    return
  end
  isString = isa(value, 'string');
  if isString && isscalar(value) && ismissing(value)
    value = '<missing>';
    return
  end
  usedCompact = false;
  if ~isString && isscalar(value) && isobject(value) ...
      && isa(value, 'nelson.mixin.CustomCompactDisplayProvider')
    [compactText, usedCompact] = compactObjectText(value);
  end
  if usedCompact
    value = compactText;
  elseif islogical(value) && isrow(value) && ~issparse(value) && ~isempty(value)
    value = logicalText(value);
  else
    value = formattedDisplayText(value);
    if isString
      value = """" + strip(value, 'right', newline) + """";
    end
  end
  value = char(value);
  value = strtrim(value(1:end));
  if length(value) > 15 && ~showsFullText(originalValue)
    value = sizeAsString(originalValue);
  end
end
%=============================================================================
function tf = showsFullText(value)
  % A char row, or a single string, categorical, datetime, duration or
  % calendarDuration, always shows its text.
  tf = (ischar(value) && isrow(value)) || (isscalar(value) && (isstring(value) ...
      || iscategorical(value) || isa(value, 'datetime') || isa(value, 'duration') ...
      || isa(value, 'calendarDuration')));
end
%=============================================================================
function s = logicalText(value)
  % A table shows logical values as words: "true   false".
  words = ["false", "true"];
  s = join(pad(words(double(value) + 1), 5, 'right'), "  ");
end
%=============================================================================
function [s, ok] = compactObjectText(obj)
  % Ask a nelson.mixin.CustomCompactDisplayProvider object for its one-line
  % compact representation, constrained to the table cell budget. Falls back
  % (ok = false) when the method is not overridden or errors.
  s = '';
  ok = false;
  try
    config = nelson.display.DisplayConfiguration();
    rep = obj.compactRepresentationForSingleLine(config, 15);
    if isa(rep, 'nelson.display.CompactDisplayRepresentation')
      s = char(rep.PaddedDisplayOutput);
    else
      s = char(rep);
    end
    ok = true;
  catch
    ok = false;
  end
end
%=============================================================================
function s = sizeAsString(value)
  % Size and class, the size written with the times sign as in a cell.
  sizeStr = sprintf(['%d', char(215)], size(value));
  s = [sizeStr(1:end - 1), ' ', class(value)];
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function texts = tableDisplayColumnText(values, rows)
  % Display text (string column) of the rows 'rows' of the table variable
  % 'values'. Each column of a cell or string variable is padded to its own
  % width, as the cells of a cell array are.
  nRows = numel(rows);
  texts = strings(nRows, 1);
  nCols = size(values, 2);
  if nRows == 0
    return
  end
  if (iscell(values) || isstring(values)) && ismatrix(values) && nCols > 0
    for k = 1:nCols
      if iscell(values)
        column = cellColumnText(values(rows, k));
      else
        column = stringColumnText(values(rows, k));
      end
      if k == 1
        texts = column;
      else
        texts = texts + "    " + column;
      end
    end
    return
  end
  if isnumeric(values) && ismatrix(values)
    [cells, ok] = tableDisplayNumberText(values(rows, :));
    if ~ok
      cells = elementsText(values(rows, :));
    end
    texts = numericColumnsText(cells);
    return
  end
  if isa(values, 'datetime') && ismatrix(values)
    % One format for the whole variable, as for a datetime array: a
    % midnight row keeps its time when another row, displayed or not, has
    % one. Only the displayed rows are formatted.
    texts = numericColumnsText(string(cellstr(values(rows, :), values.Format)));
    return
  end
  colons = repmat({':'}, 1, ndims(values) - 1);
  for i = 1:nRows
    texts(i) = tableDisplayCellText(values(rows(i), colons{:}));
  end
  % Real numbers and times are right-aligned in their block, texts (and
  % complex numbers) left-aligned.
  side = 'right';
  if (isnumeric(values) && isreal(values)) || isa(values, 'duration') ...
      || isa(values, 'datetime') || isa(values, 'calendarDuration')
    side = 'left';
  end
  texts = pad(texts, max(strlength(texts)), side);
end
%=============================================================================
function cells = elementsText(values)
  cells = strings(size(values));
  for k = 1:numel(values)
    cells(k) = tableDisplayCellText(values(k));
  end
end
%=============================================================================
function texts = numericColumnsText(cells)
  % All the elements right-aligned to one common width, columns separated by
  % four blanks, then the leading blanks common to every row removed.
  cells = pad(cells, max(strlength(cells(:))), 'left');
  texts = join(cells, "    ", 2);
  leading = min(strlength(texts) - strlength(strip(texts, 'left')));
  texts = extractAfter(texts, leading);
end
%=============================================================================
function texts = stringColumnText(values)
  n = numel(values);
  texts = strings(n, 1);
  for i = 1:n
    texts(i) = tableDisplayCellText(values(i));
  end
  texts = pad(texts, max(strlength(texts)), 'right');
end
%=============================================================================
function texts = cellColumnText(values)
  % {'a'   }, {[  1]}, {0x0 double}: the contents of the cells padded to a
  % common width, numbers right-aligned between their brackets.
  n = numel(values);
  inner = strings(n, 1);
  rightAligned = false(n, 1);
  bracketed = false(n, 1);
  for i = 1:n
    content = values{i};
    text = strtrim(char(formattedDisplayText({content})));
    if length(text) >= 2 && text(1) == '{' && text(end) == '}' && ~any(text == newline)
      text = text(2:end - 1);
    else
      text = sprintf(['%d', char(215)], size(content));
      text = [text(1:end - 1), ' ', class(content)];
    end
    bracketed(i) = length(text) >= 2 && text(1) == '[' && text(end) == ']';
    if bracketed(i)
      text = text(2:end - 1);
      rightAligned(i) = isnumeric(content) || islogical(content);
    end
    inner(i) = text;
  end
  width = max(strlength(inner) + 2 * bracketed);
  for i = 1:n
    if bracketed(i)
      side = 'right';
      if rightAligned(i)
        side = 'left';
      end
      inner(i) = "[" + pad(inner(i), width - 2, side) + "]";
    else
      inner(i) = pad(inner(i), width, 'right');
    end
  end
  texts = "{" + inner + "}";
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function lines = tableDisplayLines(strs, showRowLabels)
  % Display lines of a table body. strs(1, :) holds the headers, strs(:, 1)
  % the row labels (row names or row times), shown when showRowLabels is true.
  % Each column is as wide as its header or its widest text. Headers are
  % centered, row labels left-aligned, and the text block of a variable
  % (already justified by tableDisplayColumnText) is centered as a whole.
  % Columns are separated by four blanks, with no trailing separator.
  % Loose format adds an empty line after the underline and at the end of the
  % body; compact format has none.
  if ~showRowLabels
    strs = strs(:, 2:end);
  end
  nCols = size(strs, 2);
  B = strings(size(strs, 1) + 1, nCols);
  for j = 1:nCols
    header = strs(1, j);
    texts = strs(2:end, j);
    blockWidth = max([0; strlength(texts(:))]);
    width = max(strlength(header), blockWidth);
    B(1, j) = centerText(header, width);
    if strlength(header) > 0
      B(2, j) = string(repmat('_', 1, width));
    else
      B(2, j) = string(blanks(width));
    end
    if showRowLabels && j == 1
      B(3:end, j) = pad(texts, width, 'right');
    else
      offset = string(blanks(floor((width - blockWidth) / 2)));
      B(3:end, j) = pad(offset + texts, width, 'right');
    end
  end
  lines = "    " + join(B, "    ", 2);
  currentFormat = format();
  if strcmp(currentFormat.LineSpacing, 'loose')
    lines = [lines(1:2); ""; lines(3:end); ""];
  end
end
%=============================================================================
function text = centerText(text, width)
  left = floor((width - strlength(text)) / 2);
  text = pad(string(blanks(left)) + text, width, 'right');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [texts, ok] = tableDisplayNumberText(values)
  % Text of each element of a numeric matrix shown in a table, same size as
  % values: the shortest form with 5 significant digits (15 in format long,
  % 7 for single), integers in full; complex numbers get real and imaginary
  % parts aligned. ok is false for the fixed-point formats
  % (shortE, longE, bank, longEng), which keep the matrix element display.
  texts = strings(size(values));
  ok = true;
  if isinteger(values)
    texts = string(values);
    return
  end
  currentFormat = format();
  switch currentFormat.NumericFormat
    case {'shortE', 'longE', 'bank', 'longEng'}
      ok = false;
      return
    case {'long', 'longG'}
      digits = 15;
      if isa(values, 'single')
        digits = 7;
      end
    otherwise
      digits = 5;
  end
  if isempty(values)
    return
  end
  values = full(values);
  % -0 is shown as 0.
  values(values == 0) = 0;
  spec = sprintf('%%.%dg', digits);
  texts = reshape(compose(spec, real(values)), size(values));
  if ~isreal(values)
    % Real parts right-aligned, imaginary parts left-aligned.
    imagTexts = reshape(compose(sprintf('%%+.%dg', digits), imag(values)), size(values));
    texts = pad(texts, max(strlength(texts(:))), 'left') ...
      + pad(imagTexts + "i", max(strlength(imagTexts(:))) + 1, 'right');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function obj = tableDotIndexSubsasgn(obj, sasgn, value)
  % T.name(indices) = value and T.name{indices} = value, T.(n) naming the
  % variable number n. The variable is indexed as an array: a name that is
  % not a variable yet starts as a column of the default value of the class
  % of value (an empty cell for braces), and rows assigned past the height
  % are added to the table.
  % Properties and the dimension names are read, indexed and assigned back.
  st = struct(obj);
  names = st.Properties.VariableNames;
  if ~ischar(sasgn(1).subs)
    sasgn = tableNumberedDot(names, sasgn, true);
  end
  field = sasgn(1).subs;
  isVariable = any(strcmp(names, field));
  if ~isVariable && (strcmp(field, 'Properties') || any(strcmp(st.Properties.DimensionNames, field)))
    obj = subsasgn(obj, sasgn(1), subsasgn(subsref(obj, sasgn(1)), sasgn(2), value));
    return
  end
  nRows = height(obj);
  if isVariable
    column = st.data.(field);
  elseif strcmp(sasgn(2).type, '{}')
    column = tableDefaultColumn({[]}, nRows);
  elseif isempty(value)
    error('Nelson:table:unrecognizedVariable', _('Unrecognized table variable name ''%s''.'), field);
  else
    column = tableDefaultColumn(value(1), nRows);
  end
  column = subsasgn(column, sasgn(2), value);
  if size(column, 1) <= nRows
    obj = subsasgn(obj, sasgn(1), column);
    return
  end
  if isempty(names)
    st.data = struct();
  end
  st.data.(field) = column;
  if ~isVariable
    st.Properties.VariableNames{end + 1} = field;
  end
  st.Properties.VariableTypes = string([]);
  obj = table.fromStruct(tableGrowRows(st, nRows, {field}, {}));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function names = tableFirstVariableRowNames(st, nRows)
  % Row names implied by the first variable when it holds text: a table
  % without RowNames can be indexed by these names.
  names = {};
  if isempty(st.Properties.VariableNames)
    return
  end
  value = st.data.(st.Properties.VariableNames{1});
  if isstring(value) && isvector(value)
    names = cellstr(value(:))';
  elseif iscellstr(value)
    names = value(:)';
  elseif ischar(value) && size(value, 1) == nRows
    names = cellstr(value)';
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function st = tableGrowRows(st, nRows, assignedNames, newRowNames)
  % After an assignment to rows past the height nRows of the table: the
  % variables that were not assigned grow to the new height with their
  % default value (with a warning when they existed before), and the new
  % rows get names when the table has row names: newRowNames, the names
  % given in the row subscript, then Row<k>.
  names = st.Properties.VariableNames;
  heights = zeros(1, length(names));
  for k = 1:length(names)
    heights(k) = size(st.data.(names{k}), 1);
  end
  newHeight = max([heights, nRows + length(newRowNames)]);
  if newHeight <= nRows
    return
  end
  isShort = heights < newHeight;
  for k = find(isShort)
    st.data.(names{k}) = tableGrowColumn(st.data.(names{k}), newHeight);
  end
  if any(isShort & ~ismember(names, assignedNames))
    warning('Nelson:table:rowsAddedExistingVars', _('The assignment added rows to the table, but did not assign values to all of the table''s existing variables. Those variables are extended with rows containing default values.'));
  end
  rowNames = st.Properties.RowNames;
  if isempty(rowNames) && isempty(newRowNames)
    return
  end
  rowNames = rowNames(:);
  newRowNames = newRowNames(:);
  first = tableDefaultRowNames(length(rowNames) + 1:nRows, [rowNames; newRowNames]);
  rowNames = [rowNames; first; newRowNames];
  last = tableDefaultRowNames(length(rowNames) + 1:newHeight, rowNames);
  st.Properties.RowNames = [rowNames; last];
end
%=============================================================================
function column = tableGrowColumn(column, nRows)
  % The rows added fill in as growing an array of that class does: 0,
  % false, {[]}, <missing>, <undefined>, NaT, 0 sec.
  idx = repmat({':'}, 1, ndims(column) - 1);
  if size(column, 1) > 0
    column(nRows + 1, idx{:}) = column(1, idx{:});
    column = column(1:nRows, idx{:});
  elseif isa(column, 'duration')
    column(nRows, idx{:}) = seconds(0);
  elseif iscell(column)
    column(nRows, idx{:}) = {[]};
  elseif isnumeric(column) || islogical(column) || ischar(column)
    column(nRows, idx{:}) = cast(0, class(column));
  else
    column(nRows, idx{:}) = missing;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function tf = tableHasRowNames(rowNames, nRows)
  % A table without rows keeps the marker of its row names in a 0-by-1
  % RowNames; on a table with rows only a nonempty RowNames counts.
  tf = ~isempty(rowNames) || (nRows == 0 && iscolumn(rowNames));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [names, rows] = tableHorzcatRowNames(names, namesB, nRows)
  % Row names of [A, B], where names are the row names of A: B gives them
  % when A has none. When both have row names, rows is the order of the
  % rows of B matching the row names of A ([] when B is already in order).
  rows = [];
  if ~tableHasRowNames(namesB, nRows)
    return
  end
  if ~tableHasRowNames(names, nRows)
    names = reshape(namesB, [], 1);
    return
  end
  [isFound, rows] = ismember(names, namesB);
  if ~all(isFound)
    error('Nelson:table:horzcatRowNamesMismatch', _('All tables being horizontally concatenated must have the same row names.'));
  end
  if isequal(reshape(rows, [], 1), (1:nRows)')
    rows = [];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function st = tableHorzcatStructs(st, stB, nRows)
  % [A, B] on the structures of two tables of nRows rows: the variables of
  % B are appended, its rows matched to the row names of A.
  [st.Properties.RowNames, rows] = tableHorzcatRowNames(st.Properties.RowNames, stB.Properties.RowNames, nRows);
  for j = 1:length(stB.Properties.VariableNames)
    name = stB.Properties.VariableNames{j};
    if any(strcmp(st.Properties.VariableNames, name))
      error('Nelson:table:duplicateVariableNames', 'Duplicate table variable name.');
    end
    value = stB.data.(name);
    if ~isempty(rows)
      value = tableColumnRows(value, rows);
    end
    st.data.(name) = value;
    st.Properties.VariableNames{end + 1} = name;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
