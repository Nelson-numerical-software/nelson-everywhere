% LICENCE_BLOCK_END
%=============================================================================
function [C, ia, ib] = union(A, B, varargin)
  [codesA, codesB, B, options] = tableSetInputs(A, B, varargin);
  [codesC, ia, ib] = union(codesA, codesB, 'rows', options{:});
  ia = reshape(ia, [], 1);
  ib = reshape(ib, [], 1);
  C = tableMergeSetRows(A, B, ia, ib, [codesA(ia, :); codesB(ib, :)], codesC);
end
