function varargout = xticklabels(varargin)
  narginchk(0, 2);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [ax, args] = parseAxis(args);
  if isempty(args)
    varargout{1} = ax.XTickLabel;
    return
  end
  value = args{1};
  if ischar(value)
    switch lower(value)
      case 'mode'
        varargout{1} = ax.XTickLabelMode;
        return
      case 'auto'
        ax.XTickLabelMode = 'auto';
      case 'manual'
        ax.XTickLabelMode = 'manual';
      otherwise
        ax.XTickLabel = {value};
        ax.XTickLabelMode = 'manual';
    end
  else
    ax.XTickLabel = normalizeTickLabels(value);
    ax.XTickLabelMode = 'manual';
  end
  if nargout == 1
    error('Nelson:graphics:invalidOutputArgument', 'Invalid output argument.');
  end
end
%=============================================================================
function [ax, args] = parseAxis(args)
  if ~isempty(args) && isscalar(args{1}) && isgraphics(args{1}, 'axes')
    ax = args{1};
    args = args(2:end);
  else
    ax = gca();
  end
end
%=============================================================================
function labels = normalizeTickLabels(value)
  if isstring(value)
    labels = cellstr(value(:));
  elseif iscellstr(value)
    labels = value(:);
  elseif iscell(value)
    labels = cell(size(value(:)));
    flat = value(:);
    for k = 1:numel(flat)
      labels{k} = char(flat{k});
    end
  else
    error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
  end
end
