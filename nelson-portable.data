function scriptFile = worker_pool_write_script(chunk, privateDir)
  scriptFile = [unittest_tempdir(), 'nelson_unittest_worker_', createGUID(), '.m'];
  filewrite(scriptFile, worker_pool_script_content(chunk, privateDir));
end
