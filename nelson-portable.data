classdef complexObj
  properties
    r
    i
  end

  methods
    function obj = complexObj(a, b)
      if nargin == 0
        a = [];
        b = [];
      elseif nargin ~= 2
        error('Nelson:complexObj:twoInputsExpected', 'Two input arguments expected.');
      end
      obj.r = a;
      obj.i = b;
    end
  end
end
