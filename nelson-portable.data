% LICENCE_BLOCK_END
%=============================================================================
function [tf, loc] = ismember(A, B, varargin)
  % Rows are compared by value (row names are ignored); loc is the lowest
  % matching row of B.
  [codesA, codesB, ~, options] = tableSetInputs(A, B, varargin);
  [tf, loc] = ismember(codesA, codesB, 'rows', options{:});
  tf = reshape(tf, [], 1);
  loc = reshape(loc, [], 1);
end
