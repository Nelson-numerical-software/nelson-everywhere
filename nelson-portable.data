% LICENCE_BLOCK_END
function timeout = launcherTimeout(testTimeout, runtimeOptions)
  timeout = testTimeout;
  if isempty(testTimeout) || testTimeout <= 0
    return
  end
  timeout = testTimeout + runtimeOptions.LauncherGrace;
end
