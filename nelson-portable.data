% isstr is the deprecated MATLAB name for ischar. It is kept for
% compatibility with legacy toolboxes (e.g. the Bayes Net Toolbox).
function tf = isstr(x)
  narginchk(1, 1);
  nargoutchk(0, 1);
  tf = ischar(x);
end
