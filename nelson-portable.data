% LICENCE_BLOCK_END
function tags = discover_tagNames(options)
  names = fieldnames(options);
  tags = {};
  for k = 1:length(names)
    if ~strcmp(names{k}, 'weight') && ~strcmp(names{k}, 'timeout') && options.(names{k})
      tags = [tags; names{k}];
    end
  end
end
