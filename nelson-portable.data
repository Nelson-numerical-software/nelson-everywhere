%=============================================================================
function expr = stringPrivatePatternRegex(value)
  if isa(value, 'pattern')
    expr = value.Expression;
  elseif ischar(value)
    expr = regexptranslate('escape', value);
  elseif isstring(value) && isscalar(value)
    expr = regexptranslate('escape', char(value));
  else
    error('Nelson:string:patternStringScalarCharacterVector', 'Pattern, string scalar, or character vector expected.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [items, shape, kind] = stringPrivateToCellstr(value)
  shape = size(value);
  if ischar(value)
    items = {value};
    shape = [1 1];
    kind = 'char';
  elseif isstring(value)
    items = cellstr(value);
    kind = 'string';
  elseif iscellstr(value)
    items = value;
    kind = 'cell';
  else
    error('Nelson:string:stringCharacterVectorCellArray', 'String, character vector, or cell array of character vectors expected.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function pat = regexpPattern(expression, varargin)
  narginchk(1, Inf);
  nargoutchk(0, 1);
  if isstring(expression)
    expression = char(expression);
  end
  k = 1;
  while k <= numel(varargin)
    name = char(varargin{k});
    switch lower(name)
      case 'ignorecase'
        value = logical(varargin{k + 1});
        if value
          expression = ['(?i:', expression, ')'];
        end
      case 'freespacing'
        value = logical(varargin{k + 1});
        if value
          expression = ['(?x:', expression, ')'];
        end
      case 'dotexceptnewline'
        value = logical(varargin{k + 1});
        if value
          expression = ['(?-s:', expression, ')'];
        end
      case 'anchors'
        mode = lower(char(varargin{k + 1}));
        if strcmp(mode, 'line')
          expression = ['(?m:', expression, ')'];
        end
      otherwise
        error('Nelson:string:unsupportedOption', 'Unsupported option.');
    end
    k = k + 2;
  end
  pat = pattern(expression);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function out = replaceBetween(str, start, stop, replacement, varargin)
  narginchk(4, 6);
  nargoutchk(0, 1);
  boundaries = '';
  if nargin >= 6 && strcmpi(char(varargin{1}), 'Boundaries')
    boundaries = char(varargin{2});
  end
  hasMissing = false;
  if isstring(str)
    missingMask = ismissing(str);
    hasMissing = any(missingMask(:));
    str(missingMask) = "";
  end
  [items, ~, kind] = stringPrivateToCellstr(str);
  for k = 1:numel(items)
    if hasMissing && missingMask(k)
      continue;
    end
    items{k} = replaceBetweenOne(items{k}, selectElement(start, k), selectElement(stop, k), textElement(replacement, k), boundaries);
  end
  out = stringPrivateFromCellstr(items, kind);
  if hasMissing
    out(missingMask) = missing;
  end
end
%=============================================================================
function txt = textElement(value, k)
  if isstring(value)
    if isscalar(value)
      txt = char(value);
    else
      txt = char(value(k));
    end
  elseif iscell(value)
    if isscalar(value)
      txt = value{1};
    else
      txt = value{k};
    end
  else
    txt = value;
  end
end
%=============================================================================
function value = selectElement(value, k)
  if isnumeric(value) && numel(value) > 1
    value = value(k);
  elseif isstring(value) && numel(value) > 1
    value = value(k);
  elseif iscell(value) && numel(value) > 1
    value = value{k};
  end
end
%=============================================================================
function txt = replaceBetweenOne(txt, start, stop, replacement, boundaries)
  if isnumeric(start) && isnumeric(stop)
    s = start;
    e = stop;
    if strcmpi(boundaries, 'exclusive')
      s = s + 1;
      e = e - 1;
    end
    txt = [txt(1:s - 1), replacement, txt(e + 1:end)];
    return
  end
  startExpr = stringPrivatePatternRegex(start);
  stopExpr = stringPrivatePatternRegex(stop);
  inclusive = strcmpi(boundaries, 'inclusive');
  result = '';
  rest = txt;
  % Process every non-overlapping start/stop pair, not only the first.
  while true
    [s1, e1] = regexp(rest, startExpr, 'start', 'end', 'once');
    if isempty(s1)
      result = [result, rest];
      break
    end
    [s2, e2] = regexp(rest(e1 + 1:end), stopExpr, 'start', 'end', 'once');
    if isempty(s2)
      result = [result, rest];
      break
    end
    s2 = s2 + e1;
    e2 = e2 + e1;
    if inclusive
      result = [result, rest(1:s1 - 1), replacement];
    else
      result = [result, rest(1:e1), replacement, rest(s2:e2)];
    end
    rest = rest(e2 + 1:end);
  end
  txt = result;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
