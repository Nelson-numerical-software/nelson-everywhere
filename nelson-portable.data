function options = odeDefaultOptions()
  options = struct(...
    'AbsTol', [], ...
    'BDF', [], ...
    'Events', [], ...
    'InitialStep', [], ...
    'Jacobian', [], ...
    'JConstant', [], ...
    'JPattern', [], ...
    'LinearSolver', [], ...
    'Mass', [], ...
    'MassSingular', [], ...
    'MaxOrder', [], ...
    'MaxStep', [], ...
    'MinStep', [], ...
    'NonNegative', [], ...
    'NormControl', [], ...
    'OutputFcn', [], ...
    'OutputSel', [], ...
    'Refine', [], ...
    'RelTol', [], ...
    'Stats', [], ...
    'Preconditioner', [], ...
    'Vectorized', [], ...
    'MStateDependence', [], ...
    'MvPattern', [], ...
    'InitialSlope', []);
end
