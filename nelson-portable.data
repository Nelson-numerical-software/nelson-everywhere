% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function ref = ip_make_imref2d(imageSize, xWorldLimits, yWorldLimits)
  if ~isnumeric(imageSize) || ~isreal(imageSize) || numel(imageSize) < 2
    error('Nelson:image_processing:imageSizeContainLeastTwoDimensions', '%s must contain at least two dimensions.', 'Image size');
  end
  imageSize = double(imageSize(:).');
  imageSize = imageSize(1:2);
  if any(~isfinite(imageSize)) || any(imageSize < 1) || any(imageSize ~= floor(imageSize))
    error('Nelson:image_processing:imageSizeContainPositiveIntegerValues', '%s must contain positive integer values.', 'Image size');
  end
  if isempty(xWorldLimits)
    xWorldLimits = [0.5 imageSize(2) + 0.5];
  end
  if isempty(yWorldLimits)
    yWorldLimits = [0.5 imageSize(1) + 0.5];
  end
  if isscalar(xWorldLimits) && isscalar(yWorldLimits)
    xWorldLimits = ip_world_limits_from_pixel_extent(xWorldLimits, imageSize(2), ...
      'PixelExtentInWorldX');
    yWorldLimits = ip_world_limits_from_pixel_extent(yWorldLimits, imageSize(1), ...
      'PixelExtentInWorldY');
  else
    xWorldLimits = ip_validate_world_limits(xWorldLimits, 'XWorldLimits');
    yWorldLimits = ip_validate_world_limits(yWorldLimits, 'YWorldLimits');
  end
  pixelExtentX = diff(xWorldLimits) / imageSize(2);
  pixelExtentY = diff(yWorldLimits) / imageSize(1);
  ref = struct('Type', 'imref2d', 'ImageSize', imageSize, ...
    'XWorldLimits', xWorldLimits, 'YWorldLimits', yWorldLimits, ...
    'PixelExtentInWorldX', pixelExtentX, 'PixelExtentInWorldY', pixelExtentY, ...
    'ImageExtentInWorldX', diff(xWorldLimits), 'ImageExtentInWorldY', diff(yWorldLimits), ...
    'XIntrinsicLimits', [0.5 imageSize(2) + 0.5], ...
    'YIntrinsicLimits', [0.5 imageSize(1) + 0.5]);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function ref = ip_make_imref3d(imageSize, xWorldLimits, yWorldLimits, zWorldLimits)
  if ~isnumeric(imageSize) || ~isreal(imageSize) || numel(imageSize) < 3
    error('Nelson:image_processing:imageSizeContainLeastThreeDimensions', '%s must contain at least three dimensions.', 'Image size');
  end
  imageSize = double(imageSize(:).');
  imageSize = imageSize(1:3);
  if any(~isfinite(imageSize)) || any(imageSize < 1) || any(imageSize ~= floor(imageSize))
    error('Nelson:image_processing:imageSizeContainPositiveIntegerValues', '%s must contain positive integer values.', 'Image size');
  end
  if isempty(xWorldLimits)
    xWorldLimits = [0.5 imageSize(2) + 0.5];
  end
  if isempty(yWorldLimits)
    yWorldLimits = [0.5 imageSize(1) + 0.5];
  end
  if isempty(zWorldLimits)
    zWorldLimits = [0.5 imageSize(3) + 0.5];
  end
  if isscalar(xWorldLimits) && isscalar(yWorldLimits) && isscalar(zWorldLimits)
    xWorldLimits = ip_world_limits_from_pixel_extent(xWorldLimits, imageSize(2), ...
      'PixelExtentInWorldX');
    yWorldLimits = ip_world_limits_from_pixel_extent(yWorldLimits, imageSize(1), ...
      'PixelExtentInWorldY');
    zWorldLimits = ip_world_limits_from_pixel_extent(zWorldLimits, imageSize(3), ...
      'PixelExtentInWorldZ');
  else
    xWorldLimits = ip_validate_world_limits(xWorldLimits, 'XWorldLimits');
    yWorldLimits = ip_validate_world_limits(yWorldLimits, 'YWorldLimits');
    zWorldLimits = ip_validate_world_limits(zWorldLimits, 'ZWorldLimits');
  end
  pixelExtentX = diff(xWorldLimits) / imageSize(2);
  pixelExtentY = diff(yWorldLimits) / imageSize(1);
  pixelExtentZ = diff(zWorldLimits) / imageSize(3);
  ref = struct('Type', 'imref3d', 'ImageSize', imageSize, ...
    'XWorldLimits', xWorldLimits, 'YWorldLimits', yWorldLimits, ...
    'ZWorldLimits', zWorldLimits, ...
    'PixelExtentInWorldX', pixelExtentX, 'PixelExtentInWorldY', pixelExtentY, ...
    'PixelExtentInWorldZ', pixelExtentZ, ...
    'ImageExtentInWorldX', diff(xWorldLimits), 'ImageExtentInWorldY', diff(yWorldLimits), ...
    'ImageExtentInWorldZ', diff(zWorldLimits), ...
    'XIntrinsicLimits', [0.5 imageSize(2) + 0.5], ...
    'YIntrinsicLimits', [0.5 imageSize(1) + 0.5], ...
    'ZIntrinsicLimits', [0.5 imageSize(3) + 0.5]);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% Minimum-variance colormap by median-cut over the unique colors of P.
% P is N-by-3 in [0, 1]. Returns a K-by-3 colormap with K <= n. When the image
% has n or fewer distinct colors the palette is lossless.
function map = ip_median_cut_map(P, n)
  [U, ~, ic] = unique(P, 'rows');
  counts = accumarray(ic, 1);
  M = size(U, 1);
  if M <= n
    map = U;
    return;
  end
  boxes = {(1:M)'};
  while numel(boxes) < n
    bestBox = 0;
    bestExtent = -1;
    bestDim = 1;
    for i = 1:numel(boxes)
      ids = boxes{i};
      if numel(ids) < 2
        continue;
      end
      colors = U(ids, :);
      extent = max(colors, [], 1) - min(colors, [], 1);
      [mx, dim] = max(extent);
      if mx > bestExtent
        bestExtent = mx;
        bestBox = i;
        bestDim = dim;
      end
    end
    if bestBox == 0
      break;
    end
    ids = boxes{bestBox};
    [~, order] = sort(U(ids, bestDim));
    ids = ids(order);
    w = counts(ids);
    total = sum(w);
    splitPos = find(cumsum(w) >= total / 2, 1, 'first');
    if isempty(splitPos) || splitPos >= numel(ids)
      splitPos = numel(ids) - 1;
    end
    if splitPos < 1
      splitPos = 1;
    end
    boxes{bestBox} = ids(1:splitPos);
    boxes{end + 1} = ids(splitPos + 1:end);
  end
  K = numel(boxes);
  map = zeros(K, 3);
  for i = 1:K
    ids = boxes{i};
    w = counts(ids);
    map(i, :) = sum(U(ids, :) .* w, 1) / sum(w);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% Assign each pixel to the nearest colormap entry (squared Euclidean distance).
% P is N-by-3 in [0, 1]; map is K-by-3. Returns N-by-1 zero-based indices.
function idx = ip_nearest_assign(P, map)
  N = size(P, 1);
  K = size(map, 1);
  best = inf(N, 1);
  idx = zeros(N, 1);
  for k = 1:K
    d = (P(:, 1) - map(k, 1)) .^ 2 + (P(:, 2) - map(k, 2)) .^ 2 + (P(:, 3) - map(k, 3)) .^ 2;
    upd = d < best;
    best(upd) = d(upd);
    idx(upd) = k - 1;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
