function run_impl_print_module_header(index, total, moduleName)
  fmt = [newline, '%0', int2str(length(int2str(total))), ...
    'd/%0', int2str(length(int2str(total))), 'd [%s]:', newline];
  fprintf(stdout, fmt, index, total, moduleName);
end
