function varargout = clf(varargin)
  narginchk(0, 1);
  nargoutchk(0, 1);
  if nargin == 1
    f = varargin{1};
  else
    f = gcf();
  end
  f.Children = [];
  f.CurrentAxes = [];
  if isprop(f, 'CurrentObject')
    f.CurrentObject = [];
  end
  refresh(f);
  if nargout == 1
    varargout{1} = f;
  else
    varargout = {};
  end
end
