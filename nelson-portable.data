function C = cellstr(obj, fmt)
  % Display text of each element, 'NaN' for a NaN duration.
  if nargin > 1
    obj.Format = fmt;
  end
  C = cellstr(durationFormatText(obj));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
