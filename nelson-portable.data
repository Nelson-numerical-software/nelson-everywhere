%=============================================================================
classdef vartype
  properties (Hidden)
    TypeName
  end
  methods
    function obj = vartype(typeName)
      narginchk(1, 1);
      obj.TypeName = char(typeName);
    end
    function idx = resolve(obj, T)
      st = struct(T);
      types = st.Properties.VariableTypes;
      idx = find(strcmp(types, obj.TypeName));
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
classdef withtol
  % Row subscript of a timetable: the rows whose times are within a
  % tolerance of the subscript times.
  properties (Hidden)
    Times = NaT
    Tolerance = NaN
  end

  methods
    function obj = withtol(times, tolerance)
      if nargin == 0
        return
      end
      narginchk(2, 2);
      obj.Times = checkedTimes(times);
      obj.Tolerance = checkedTolerance(tolerance);
      checkIntervals(obj.Times, obj.Tolerance);
    end

    function display(obj, varargin)
      if nargin == 1
        name = inputname(1);
      else
        name = varargin{1};
      end
      if ~isempty(name)
        looseBlankLine();
        fprintf('%s = \n', name);
        looseBlankLine();
      end
      disp(obj);
    end

    function disp(obj)
      fprintf('\ttimetable withtol subscript:\n');
      looseBlankLine();
      fprintf('\t\tSelect timetable rows matching the following times:\n');
      looseBlankLine();
      for k = 1:numel(obj.Times)
        fprintf('\t\t%s\n', char(obj.Times(k)));
      end
      if isa(obj.Tolerance, 'duration')
        fprintf('\t\twith tolerance of +/- %s\n', char(obj.Tolerance));
      else
        fprintf('\t\twith tolerance of +/- %s\n', num2str(obj.Tolerance));
      end
      looseBlankLine();
    end
  end

  methods (Static, Hidden)
    function rows = rows(obj, rowTimes)
      % Row numbers of the row times within the tolerance of each subscript
      % time, subscript time by subscript time. Distances are compared to
      % the nanosecond, a zero tolerance selects the rows at the times.
      if ~strcmp(class(obj.Times), class(rowTimes))
        error('Nelson:withtol:MismatchRowTimesType', _('A timetable with %s row times cannot be subscripted using %s values.'), ...
          class(rowTimes), class(obj.Times));
      end
      tolerance = round(milliseconds(obj.Tolerance) * 1e6);
      matched = cell(1, numel(obj.Times));
      for k = 1:numel(matched)
        found = find(round(abs(milliseconds(rowTimes - obj.Times(k))) * 1e6) <= tolerance);
        matched{k} = found(:)';
      end
      rows = [zeros(1, 0), matched{:}];
    end
  end
end
%=============================================================================
function times = checkedTimes(times)
  if ischar(times) || isstring(times) || iscellstr(times)
    times = datetime(times);
  end
  if ~(isa(times, 'datetime') || isa(times, 'duration'))
    error('Nelson:timetable:InvalidTimes', _('Specify times for subscripting as datetime or duration.'));
  end
  times = times(:);
end
%=============================================================================
function tolerance = checkedTolerance(tolerance)
  if ~isa(tolerance, 'duration') || ~isscalar(tolerance) || tolerance < seconds(0)
    error('Nelson:withtol:InvalidTolerance', _('Tolerance value must be a nonnegative scalar duration.'));
  end
end
%=============================================================================
function checkIntervals(times, tolerance)
  % A tolerance of half the smallest interval between distinct subscript
  % times could select a row twice.
  if numel(times) < 2 || isnan(milliseconds(tolerance))
    return
  end
  gaps = abs(diff(sort(milliseconds(times - times(1)))));
  gaps = gaps(gaps > 0);
  if isempty(gaps) || milliseconds(tolerance) < min(gaps) / 2
    return
  end
  limit = milliseconds(min(gaps) / 2);
  limit.Format = tolerance.Format;
  error('Nelson:withtol:LargeTolerance', _('Tolerance exceeds half the smallest interval between subscript times and might result in selecting duplicate rows. Tolerance must be less than %s.'), ...
    char(string(limit)));
end
%=============================================================================
function looseBlankLine()
  % Separator line of the loose line spacing, absent from the compact one.
  currentFormat = format();
  if strcmp(currentFormat.LineSpacing, 'loose')
    fprintf('\n');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function Tout = addprop(T, name, propertyType)
  if nargin == 2 && isa(T, 'handle')
    if isstring(name)
      name = char(name);
    end
    Tout = __classdef_add_dynamic_property__(T, name);
    return
  end
  narginchk(3, 3);
  mustBeA(T, 'table', 1);
  names = localCellstr(name);
  propertyTypes = localCellstr(propertyType);
  if length(propertyTypes) == 1 && length(names) > 1
    propertyTypes = repmat(propertyTypes, 1, length(names));
  end
  if length(propertyTypes) ~= length(names)
    error('Nelson:table:dimagree:propertyTypesMatchPropertyNames', 'Property types must match property names.');
  end
  st = struct(T);
  if ~isfield(st.Properties, 'CustomProperties') || isempty(st.Properties.CustomProperties)
    st.Properties.CustomProperties = struct();
  end
  if ~isfield(st, 'VariableCustomProperties')
    st.VariableCustomProperties = {};
  end
  for k = 1:length(names)
    if isfield(st.Properties.CustomProperties, names{k})
      error('Nelson:table:propertyExists', 'Custom property already exists.');
    end
    if ~any(strcmpi(propertyTypes{k}, {'table', 'variable'}))
      error('Nelson:table:invalidValue:propertyTypeTableVariable', 'Property type must be ''table'' or ''variable''.');
    end
    st.Properties.CustomProperties.(names{k}) = [];
    if strcmpi(propertyTypes{k}, 'variable')
      st.VariableCustomProperties{end + 1} = names{k};
    end
  end
  Tout = table.fromStruct(st);
end
%=============================================================================
function names = localCellstr(names)
  if ischar(names)
    names = {names};
  elseif isstring(names)
    names = cellstr(names);
  end
  names = names(:)';
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function Tout = addvars(T, varargin)
  narginchk(1, Inf);
  mustBeA(T, {'table', 'timetable'}, 1);
  % A variable passed by name keeps that name: the input names are only
  % known in this call, so timetables and eventtables are handled here too.
  argNames = cell(1, length(varargin));
  for k = 1:length(varargin)
    argNames{k} = inputname(k + 1);
  end
  Tout = localAddvars(T, varargin, argNames, T.Properties.DimensionNames);
end
%=============================================================================
function Tout = localAddvars(T, args, argNames, dimensionNames)
  if isa(T, 'eventtable')
    TT = localAddvars(eventtable.toTimetable(T), args, argNames, dimensionNames);
    Tout = eventtable.fromTimetable(TT, eventtable.variables(T));
    return
  end
  if istimetable(T)
    % The variables are added to the table storage; the row times and the
    % timetable properties are kept.
    st = struct(T);
    R = localAddvars(table.fromStruct(st.Table), args, argNames, dimensionNames);
    Tout = timetable.fromTableAndTimes(R, T.Properties.RowTimes, T.Properties);
    return
  end
  % The name-value arguments start at the first character vector, a string
  % is always a value to add.
  nValues = length(args);
  for k = 1:length(args)
    if ischar(args{k}) && size(args{k}, 1) <= 1
      nValues = k - 1;
      break
    end
  end
  values = args(1:nValues);
  st = struct(T);
  names = st.Properties.VariableNames;
  [insertAt, newNames] = tableAddMoveOptions(names, args(nValues + 1:end), true);
  if iscell(newNames)
    localCheckNewNames(names, newNames, nValues);
  else
    newNames = localDefaultNames([names, dimensionNames], argNames(1:nValues), length(names));
  end

  if isempty(st.data)
    st.data = struct();
  end
  for k = 1:length(newNames)
    st.data.(newNames{k}) = values{k};
  end
  st.Properties.VariableNames = [names(1:insertAt - 1), newNames, names(insertAt:end)];
  st.data = localReorderData(st.data, st.Properties.VariableNames);
  Tout = table.fromStruct(st);
end
%=============================================================================
function newNames = localDefaultNames(usedNames, argNames, width)
  % The input name, or Var<N> numbered after the existing variables for an
  % expression; a name already used by the table or by another new variable
  % is suffixed _1, _2, ...
  nValues = length(argNames);
  baseNames = argNames;
  for k = 1:nValues
    if isempty(baseNames{k})
      baseNames{k} = ['Var', num2str(width + k)];
    end
  end
  newNames = cell(1, nValues);
  for k = 1:nValues
    candidate = baseNames{k};
    if any(strcmp([usedNames, newNames(1:k - 1)], candidate))
      reserved = [usedNames, baseNames, newNames(1:k - 1)];
      suffix = 1;
      candidate = [baseNames{k}, '_', num2str(suffix)];
      while any(strcmp(reserved, candidate))
        suffix = suffix + 1;
        candidate = [baseNames{k}, '_', num2str(suffix)];
      end
    end
    newNames{k} = candidate;
  end
end
%=============================================================================
function localCheckNewNames(names, newNames, nValues)
  if length(newNames) ~= nValues
    error('Nelson:table:incorrectNumberOfVarNames', _('Specify one new variable name for each variable being added to the table.'));
  end
  if any(cellfun('isempty', newNames))
    error('Nelson:table:zeroLengthVarname', _('Table variable names must be nonempty text.'));
  end
  allNames = [names, newNames];
  for k = 1:nValues
    if sum(strcmp(allNames, newNames{k})) > 1
      error('Nelson:table:duplicateVariableNames', _('Duplicate table variable name: ''%s''.'), newNames{k});
    end
  end
end
%=============================================================================
function data = localReorderData(data, variableNames)
  reordered = struct();
  for k = 1:length(variableNames)
    reordered.(variableNames{k}) = data.(variableNames{k});
  end
  data = reordered;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = array2table(varargin)
  narginchk(1, inf);
  nargoutchk(0, 1);
  X = varargin{1};
  if ~ismatrix(X)
    error('Nelson:table:invalidType:xA2DMatrix', 'X must be a 2-D matrix.');
  end
  if mod(nargin - 1, 2) ~= 0
    error('Nelson:table:nameValuePair:nameValueArgumentsComePairs', 'Name-value arguments must come in pairs.');
  end
  varNames = {};
  rowNames = {};
  dimNames = {};
  hasVarNames = false;
  for k = 2:2:nargin
    name = varargin{k};
    if ~(ischar(name) && isrow(name)) && ~(isstring(name) && isscalar(name))
      error('Nelson:table:invalidType:parameterNameACharacterVectorString', 'Parameter name must be a character vector or string scalar.');
    end
    value = varargin{k + 1};
    switch lower(char(name))
      case 'variablenames'
        varNames = value;
        hasVarNames = true;
      case 'rownames'
        rowNames = value;
      case 'dimensionnames'
        dimNames = value;
      otherwise
        error('Nelson:table:unknownParameter', 'Unknown parameter name.');
    end
  end
  nCols = size(X, 2);
  values = cell(1, nCols);
  for iCol = 1:nCols
    values{iCol} = X(:, iCol);
  end
  if ~hasVarNames
    prefix = inputname(1);
    if isempty(prefix)
      prefix = 'Var';
    end
    varNames = cell(1, nCols);
    for iCol = 1:nCols
      varNames{iCol} = sprintf('%s%d', prefix, iCol);
    end
  end
  args = [values, {'VariableNames', varNames}];
  if nCols == 0
    args = [args, {'Size', [size(X, 1), 0], 'VariableTypes', {}}];
  end
  if ~isempty(rowNames)
    args = [args, {'RowNames', rowNames}];
  end
  if ~isempty(dimNames)
    args = [args, {'DimensionNames', dimNames}];
  end
  varargout{1} = table(args{:});
end
