function y = nanmedian(x, varargin)
  narginchk(1, 2);
  nargoutchk(0, 1);
  y = __nan_statistics__(x, 'median', [], varargin{:});
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
