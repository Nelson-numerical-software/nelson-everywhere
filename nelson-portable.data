%=============================================================================
% report = NFlow.internal.acausalParityReport()
%
% Acausal palette N8: the Coselica-parity checklist, computed from the
% single-source catalog. Cross-references the implemented components
% (NFlow.internal.acausalCatalog) against the Coselica palette target per domain and
% reports coverage. Prints a readable table and returns a struct with the
% per-domain counts, so the parity status is a queryable fact, not a stale
% hand-maintained list.
%
% The `target` counts are the sizes of the Coselica palette groups (extracted
% from Coselica.mo, used as a factual catalog only). Coverage counts curated,
% engine-backed components; the remaining are the smooth-only / event-tier /
% planar items tracked in acausal_palette_plan.md.
%=============================================================================
function report = acausalParityReport()
  catalog = NFlow.internal.acausalCatalog();
  % Coselica palette group sizes (target), per physical domain.
  domains = {'electrical', 'thermal', 'translational', 'rotational', 'planar'};
  targets = [54, 16, 41, 50, 46];

  report = struct();
  report.domains = {};
  disp('nflow acausal palette - Coselica parity (from NFlow.internal.acausalCatalog):');
  disp('  domain          implemented   target   note');
  totalImpl = 0; totalTarget = 0;
  for i = 1:numel(domains)
    d = domains{i};
    n = 0; names = {};
    for k = 1:numel(catalog)
      if strcmp(catalog(k).domain, d)
        n = n + 1; names{end + 1} = catalog(k).name; %#ok<AGROW>
      end
    end
    note = '';
    if strcmp(d, 'planar')
      % Planar blocks live in the native planarMechanicalIsland engine and the
      % frame-diagram expansion (NFlow.internal.planarExpand), sourced from the planar
      % catalog (not the scalar-node acausal catalog), plus CutForce joint
      % reaction outputs. Closed kinematic loops (e.g. four-bar linkages) need
      % no special loop joint; they are consistent Revolute constraints.
      pcat = NFlow.internal.planarCatalog();
      names = {pcat.name};
      names{end + 1} = 'CutForce';
      n = numel(names);
      note = 'N7 engine + frame expansion + closed loops (core joints/sensors/forces)';
    elseif n < targets(i)
      note = 'tier-A/B done; events + variants remain';
    else
      note = 'core covered';
    end
    disp(sprintf('  %-14s  %6d       %6d   %s', d, n, targets(i), note));
    e = struct('domain', d, 'implemented', n, 'target', targets(i), 'names', {names});
    report.domains{end + 1} = e; %#ok<AGROW>
    totalImpl = totalImpl + n;
    totalTarget = totalTarget + targets(i);
  end
  % Causal signal blocks (Coselica Blocks.*): tracked separately (they are
  % ordinary nflow blocks, not acausal islands).
  report.signalParity = 'complete (mathFunction, pulse/sawTooth/expSine/trapezoid/exponentials, hysteresis, vector sum/dot/cross; LimPID via pid)';
  report.totalImplemented = totalImpl;
  report.totalTarget = totalTarget;
  disp(sprintf('  %-14s  %6d       %6d', 'TOTAL (phys)', totalImpl, totalTarget));
  disp(['  signal blocks : ', report.signalParity]);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% dirs = NFlow.internal.acausalWriteLibraries([libRoot])
%
% Acausal palette N5: materialise the acausal palettes in the CANONICAL nflow
% layout: one library per domain under
%   <nflow_blocks>/libraries/acausal_<domain>/library.json
%   <nflow_blocks>/libraries/acausal_<domain>/exports/<Name>.svg
% exactly like the builtin libraries (continuous, math, ...). The manifest
% (id "builtin.acausal_<domain>") comes from NFlow.internal.acausalGenerateLibrary and
% the icons from NFlow.internal.acausalGenerateIcon. Register the ids in the GUI loader
% + config to enable the palettes. Regenerable; re-run after catalog/icon edits.
%
% libRoot defaults to <nflow_blocks>/libraries.
%=============================================================================
function dirs = acausalWriteLibraries(libRoot)
  if nargin < 1 || isempty(libRoot)
    libRoot = [modulepath('nflow_blocks', 'root'), '/libraries'];
  end
  catalog = NFlow.internal.acausalCatalog();
  domains = unique({catalog.domain});
  dirs = {};
  for i = 1:numel(domains)
    domain = domains{i};
    libDir = [libRoot, '/acausal_', domain];
    expDir = [libDir, '/exports'];
    if ~isdir(expDir)
      mkdir(expDir);
    end
    % Manifest.
    manifest = NFlow.internal.acausalGenerateLibrary(domain);
    p = [libDir, '/library.json'];
    fid = fopen(p, 'w');
    if fid < 0
      error('Nelson:nflow:acausalWriteLib', 'Cannot write ''%s''.', p);
    end
    fwrite(fid, manifest);
    fclose(fid);
    % Icons, one per block of this domain, into exports/.
    for k = 1:numel(catalog)
      if ~strcmp(catalog(k).domain, domain)
        continue
      end
      svg = NFlow.internal.acausalGenerateIcon(catalog(k).name);
      ip = [expDir, '/', catalog(k).name, '.svg'];
      fid = fopen(ip, 'w');
      fwrite(fid, svg);
      fclose(fid);
    end
    dirs{end + 1} = libDir; %#ok<AGROW>
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% documentJson = NFlow.internal.expandAcausalDoc(documentJson)
%
% GUI Run bridge: lower every acausal (physical-pin) and planar component of a
% diagram into the engine's native island blocks, so the C++ Run path can hand
% the C++ engine a document it already understands. Runs the electrical /
% thermal / translational / rotational lowering (NFlow.internal.acausalExpand) then the
% planar lowering (NFlow.internal.planarExpand). Both are zero-cost when the diagram has
% no physical wires, so a purely causal model returns unchanged.
%=============================================================================
function documentJson = expandAcausalDoc(documentJson)
  documentJson = NFlow.internal.acausalExpand(documentJson);
  documentJson = NFlow.internal.planarExpand(documentJson);
end
