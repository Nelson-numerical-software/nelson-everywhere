% LICENCE_BLOCK_END
%=============================================================================
function [value, isterminal, direction] = ddeTestEventThreshold(t, y)
  value = y(1) - 0.9;
  isterminal = 1;
  direction = -1;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function odeAssertFinalValue(t, y, expectedTime, expectedValue, timeTolerance, valueTolerance)
  asserts.istrue(abs(t(length(t)) - expectedTime) < timeTolerance);
  asserts.istrue(abs(y(length(y)) - expectedValue) < valueTolerance);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function odeCheckSolverForTest(solver)
  [t, y] = solver(@(tt, yy) - yy, [0 1], 1, odeset('MaxStep', 0.1));
  asserts.istrue(abs(t(length(t)) - 1) < 1e-12);
  asserts.istrue(abs(y(size(y, 1), 1) - exp(-1)) < 1e-3);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [stop, y] = odeComplexCallbackState(t, y, index)
  asserts.isfalse(isreal(y));
  stop = true;
  y = y + 0.1 + 0.25i;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function value = odeComplexImplicitEvent(t, y, yp)
  asserts.isfalse(isreal(y));
  asserts.isfalse(isreal(yp));
  value = real(y) - exp(-0.25);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function stop = odeComplexOutputCheck(t, y, flag)
  stop = false;
  if isempty(flag)
    asserts.isequal(size(y, 1), 1);
    asserts.isfalse(isreal(y));
  elseif strcmp(flag, 'init')
    asserts.isequal(size(y, 1), 2);
    asserts.isfalse(isreal(y));
  elseif strcmp(flag, 'done')
    asserts.istrue(isempty(y));
  end
end
