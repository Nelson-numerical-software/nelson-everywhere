% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [B, C, S] = normalize(A, varargin)
  narginchk(1, 5);
  nargoutchk(0, 3);
  if ~isnumeric(A) && ~islogical(A)
    error('Nelson:validators:mustBeNumericOrLogical', '%s must be numeric or logical.', 'Input');
  end
  A = double(A);

  args = varargin;
  % optional leading dimension
  if ~isempty(args) && isnumeric(args{1})
    dim = args{1};
    args(1) = [];
  else
    dim = find(size(A) ~= 1, 1, 'first');
    if isempty(dim)
      dim = 1;
    end
  end

  method = 'zscore';
  if ~isempty(args)
    method = lower(char(args{1}));
    args(1) = [];
  end
  param = [];
  if ~isempty(args)
    param = args{1};
  end

  C = 0;
  S = 1;
  switch method
    case 'zscore'
      kind = 'std';
      if ~isempty(param)
        kind = lower(char(param));
      end
      if strcmp(kind, 'robust')
        C = median(A, dim);
        S = local_mad(A, dim);
      else
        C = mean(A, dim);
        S = std(A, 0, dim);
      end
    case 'center'
      C = local_center(A, dim, param);
      S = 1;
    case 'scale'
      C = 0;
      S = local_scale(A, dim, param);
    case 'norm'
      p = 2;
      if ~isempty(param)
        p = param;
      end
      C = 0;
      S = vecnorm(A, p, dim);
    case 'range'
      lohi = [0 1];
      if ~isempty(param)
        lohi = param;
      end
      mn = min(A, [], dim);
      mx = max(A, [], dim);
      S = mx - mn;
      S(S == 0) = 1;
      B = lohi(1) + (A - mn) ./ S .* (lohi(2) - lohi(1));
      C = mn;
      return;
    case 'medianiqr'
      C = median(A, dim);
      S = local_iqr(A, dim);
    otherwise
      error('Nelson:normalize:invalidMethod', 'Unsupported "%s" option.', method);
  end
  S(S == 0) = 1;
  B = (A - C) ./ S;
end
%=============================================================================
function C = local_center(A, dim, param)
  if isempty(param)
    C = mean(A, dim);
  elseif isnumeric(param)
    C = param;
  else
    switch lower(char(param))
      case 'mean'
        C = mean(A, dim);
      case 'median'
        C = median(A, dim);
      otherwise
        error('Nelson:normalize:invalidCenter', 'Unsupported "%s" option.', char(param));
    end
  end
end
%=============================================================================
function S = local_scale(A, dim, param)
  if isempty(param)
    S = std(A, 0, dim);
  elseif isnumeric(param)
    S = param;
  else
    switch lower(char(param))
      case 'std'
        S = std(A, 0, dim);
      case 'mad'
        S = local_mad(A, dim);
      case 'iqr'
        S = local_iqr(A, dim);
      case 'first'
        idx = repmat({':'}, 1, ndims(A));
        idx{dim} = 1;
        S = A(idx{:});
      otherwise
        error('Nelson:normalize:invalidScale', 'Unsupported "%s" option.', char(param));
    end
  end
  S(S == 0) = 1;
end
%=============================================================================
function m = local_mad(A, dim)
  m = median(abs(A - median(A, dim)), dim);
end
%=============================================================================
function q = local_iqr(A, dim)
  q = prctile(A, 75, dim) - prctile(A, 25, dim);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [Fm, fm] = fillmissingKnn(X, M, loc, k, distance)
  % Each missing entry takes the mean of the values of the k nearest rows
  % holding one. The distance is measured on the nonmissing coordinates of
  % the row; a row missing one of them is no neighbor. Ties keep the row
  % order. The rows with missing entries are processed by blocks, the
  % candidate rows running along the columns of the distance matrices.
  [n, p] = size(X);
  count = length(loc.miss);
  Fm = NaN(count, 1);
  fm = false(count, 1);
  U = double(X);
  V = U;
  V(M) = NaN;
  scale = [];
  if ischar(distance) && strcmp(distance, 'seuclidean')
    scale = std(V, 0, 1, 'omitnan');
  end
  % Coordinates for the distances: missing ones are zero, masked by M.
  V(M) = 0;
  [rows, order] = sort(loc.row);
  targets = rows([true; diff(rows) ~= 0]);
  blockPosition = zeros(n, 1);
  % Blocks of about 1 MB distance matrices: larger allocations are slower and gain nothing.
  blockSize = max(1, floor(131072 / n));
  for first = 1:blockSize:length(targets)
    T = targets(first:min(end, first + blockSize - 1));
    t = length(T);
    d = knnDistances(X, V, M, T, distance, scale);
    d(T + (0:t - 1)' * n) = NaN;
    inBlock = rows >= T(1) & rows <= T(end);
    entries = order(inBlock);
    blockPosition(T) = 1:t;
    % One column per missing entry: the distances of the rows holding its value.
    dE = d(:, blockPosition(rows(inBlock)));
    cols = loc.col(entries);
    dE(M(:, cols)) = NaN;
    [total, found] = knnSelect(dE, U, cols, k);
    Fm(entries) = total ./ found;
    fm(entries) = found > 0;
  end
end
%=============================================================================
function [total, found] = knnSelect(dE, U, cols, k)
  % Sum and count of the values of the k smallest distances of each column
  % of dE (NaN: no neighbor), the first row winning ties. Small k: k
  % passes of min, which also returns the first index; otherwise a stable sort.
  [n, E] = size(dE);
  offsets = (cols(:)' - 1) * n;
  if k < log2(n)
    total = zeros(1, E);
    found = zeros(1, E);
    columns = (0:E - 1) * n;
    for q = 1:k
      [m, r] = min(dE, [], 1);
      valid = ~isnan(m);
      if ~any(valid)
        break
      end
      % reshape: indexing a single-column U would return a column.
      total(valid) = total(valid) + reshape(U(r(valid) + offsets(valid)), 1, []);
      found = found + valid;
      dE(r(valid) + columns(valid)) = NaN;
    end
  else
    [dE, r] = sort(dE, 1);
    kk = min(k, n);
    valid = ~isnan(dE(1:kk, :));
    values = reshape(U(r(1:kk, :) + offsets), kk, E);
    values(~valid) = 0;
    total = sum(values, 1);
    found = sum(valid, 1);
  end
end
%=============================================================================
function d = knnDistances(X, V, M, T, distance, scale)
  % Squared distances (built-in metrics) from every row (rows of d) to the
  % rows T (columns of d), NaN for the rows that cannot be compared.
  n = size(X, 1);
  t = length(T);
  if isa(distance, 'function_handle')
    d = NaN(n, t);
    for a = 1:t
      i = T(a);
      for r = [1:i - 1, i + 1:n]
        d(r, a) = double(distance([X(i, :); X(r, :)], [M(i, :); M(r, :)]));
      end
    end
    return
  end
  % Squares are accumulated coordinate by coordinate over the coordinates
  % of each target row; a row missing one of them gets NaN. The squared
  % distance is kept: a square root could merge distinct sums into false
  % ties and change the neighbors.
  VT = V(T, :)';
  P = ~M(T, :)';
  d = zeros(n, t);
  for j = 1:size(V, 2)
    delta = V(:, j) - VT(j, :);
    if ~isempty(scale)
      % 'seuclidean': each difference is divided by the standard deviation of its coordinate.
      delta = delta / scale(j);
    end
    delta = delta .* delta;
    if ~all(P(j, :))
      delta(:, ~P(j, :)) = 0;
    end
    d = d + delta;
  end
  d((double(M) * double(P)) > 0) = NaN;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [x, maxGap, window] = fillmissingSamplePoints(samplePoints, n, maxGap, window, isGapWindow)
  % Validates the sample points (n of them) and returns them as a numeric
  % column x ([] when absent), datetime and duration values in seconds.
  % maxGap and window (a moving window, or the gap window of a function
  % handle when isGapWindow; [] when unused) must have a compatible type
  % and are converted to the same unit.
  x = [];
  timeBased = false;
  if ~isempty(samplePoints)
    [x, timeBased] = samplePointsSeconds(samplePoints, n);
  end
  if ~isempty(maxGap)
    isDuration = isduration(maxGap);
    if ~(isscalar(maxGap) && (isDuration || (isnumeric(maxGap) && isreal(maxGap))) && toSeconds(maxGap) > 0)
      error('Nelson:data_analysis:fillmissingInvalidMaxGap', '''MaxGap'' must be a positive numeric or duration scalar.');
    end
    if isDuration ~= timeBased
      error('Nelson:data_analysis:fillmissingMaxGapType', '''MaxGap'' data type must be compatible with ''SamplePoints'' data type.');
    end
    maxGap = toSeconds(maxGap);
  end
  if ~isempty(window)
    if isduration(window) ~= timeBased
      windowTypeError(timeBased, isGapWindow);
    end
    window = toSeconds(window);
  end
end
%=============================================================================
function [x, timeBased] = samplePointsSeconds(samplePoints, n)
  timeBased = isdatetime(samplePoints) || isduration(samplePoints);
  if ~(isvector(samplePoints) && (timeBased || (isfloat(samplePoints) && isreal(samplePoints))))
    error('Nelson:data_analysis:fillmissingSamplePointsType', '''SamplePoints'' value must be a vector of type double, single, duration, or datetime.');
  end
  if numel(samplePoints) ~= n
    error('Nelson:data_analysis:fillmissingSamplePointsLength', 'The sample points vector length must be %d, the same as the size of the input data in the operating dimension.', n);
  end
  if isdatetime(samplePoints)
    x = seconds(samplePoints(:) - samplePoints(1));
  else
    x = double(toSeconds(samplePoints(:)));
  end
  if ~all(isfinite(x))
    error('Nelson:data_analysis:fillmissingSamplePointsNonFinite', '''SamplePoints'' value must not contain Inf or NaN.');
  end
  steps = diff(x);
  if any(steps < 0)
    error('Nelson:data_analysis:fillmissingSamplePointsSorted', '''SamplePoints'' value must be sorted in ascending order.');
  end
  if any(steps == 0)
    error('Nelson:data_analysis:fillmissingSamplePointsDuplicate', '''SamplePoints'' value contains duplicates.');
  end
end
%=============================================================================
function windowTypeError(timeBased, isGapWindow)
  if isGapWindow && timeBased
    error('Nelson:data_analysis:fillmissingInvalidGapWindowDuration', 'Window length must be a finite positive scalar or 2-element vector of finite nonnegative scalars of type duration.');
  elseif isGapWindow
    error('Nelson:data_analysis:fillmissingInvalidGapWindow', 'Window length must be a finite positive scalar or 2-element vector of finite nonnegative scalars.');
  elseif timeBased
    error('Nelson:data_analysis:fillmissingWindowDuration', 'Invalid data type. Window size must be a duration if ''SamplePoints'' value is a duration or a datetime.');
  end
  error('Nelson:data_analysis:fillmissingWindowType', 'Window size data type must be compatible with ''SamplePoints'' data type.');
end
%=============================================================================
function value = toSeconds(value)
  if isduration(value)
    value = seconds(value);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [TF, P] = isLocalExtrema(A, isMaximum, wantProminence, varargin)
  % Shared implementation of islocalmax and islocalmin.
  opts = parseLocalExtremaOptions(A, varargin{:});
  if opts.isTabular
    [TF, P] = tabularExtrema(A, isMaximum, wantProminence, opts);
  else
    [TF, P] = arrayExtrema(A, isMaximum, wantProminence, opts);
  end
end
%=============================================================================
function [TF, P] = arrayExtrema(A, isMaximum, wantProminence, opts)
  [x, minSeparation, window] = resolveSamplePoints(opts, opts.SamplePoints, size(A, opts.dim), false);
  isSparse = issparse(A);
  if isSparse
    A = full(A);
  end
  [TF, P] = callBuiltin(A, isMaximum, wantProminence, opts, x, minSeparation, window, opts.dim);
  if isSparse
    TF = sparse(TF);
    if wantProminence
      P = sparse(P);
    end
  end
end
%=============================================================================
function [TF, P] = callBuiltin(A, isMaximum, wantProminence, opts, x, minSeparation, window, dim)
  P = [];
  if wantProminence
    [TF, P] = __islocalextrema__(A, isMaximum, dim, opts.FlatSelection, opts.MinProminence, minSeparation, opts.MaxNumExtrema, x, window);
  else
    TF = __islocalextrema__(A, isMaximum, dim, opts.FlatSelection, opts.MinProminence, minSeparation, opts.MaxNumExtrema, x, window);
  end
end
%=============================================================================
function [TF, P] = tabularExtrema(A, isMaximum, wantProminence, opts)
  names = A.Properties.VariableNames;
  stA = struct(A);
  dataVars = 1:width(A);
  if ~isempty(opts.DataVariables)
    dataVars = tableResolveVariables(stA.Properties.VariableNames, opts.DataVariables, stA.Properties.VariableTypes, stA.data);
  end
  samplePoints = opts.SamplePoints;
  if istimetable(A)
    samplePoints = A.Properties.RowTimes;
  elseif opts.hasSamplePoints && isTableVariableReference(samplePoints, height(A))
    spVar = tableResolveVariables(names, samplePoints);
    samplePoints = A.(names{spVar});
    dataVars(dataVars == spVar) = [];
  end
  [x, minSeparation, window] = resolveSamplePoints(opts, samplePoints, height(A), istimetable(A));
  for v = dataVars
    checkTableVariable(A.(names{v}));
  end
  tabular = strcmp(opts.OutputFormat, 'tabular');
  if tabular
    TF = A(:, dataVars);
  else
    TF = false(height(A), width(A));
  end
  P = [];
  if wantProminence
    P = A(:, dataVars);
  end
  for v = dataVars
    [tfv, pv] = callBuiltin(A.(names{v}), isMaximum, wantProminence, opts, x, minSeparation, window, 1);
    if tabular
      TF.(names{v}) = tfv;
    else
      TF(:, v) = tfv;
    end
    if wantProminence
      P.(names{v}) = pv;
    end
  end
end
%=============================================================================
function tf = isTableVariableReference(value, nRows)
  tf = ischar(value) || isstring(value) || iscellstr(value) || isa(value, 'function_handle') || strcmp(class(value), 'vartype') || islogical(value) || (isnumeric(value) && isscalar(value) && nRows ~= 1);
end
%=============================================================================
function checkTableVariable(value)
  if ~(isnumeric(value) || islogical(value))
    error('Nelson:isLocalExtrema:NonNumericTableVar', 'Table variables must be numeric.');
  end
  if ~isreal(value)
    error('Nelson:isLocalExtrema:ComplexInputArray', 'Complex input arguments are not supported.');
  end
  if ~(iscolumn(value) || (isempty(value) && ismatrix(value) && all(size(value) <= [0 1])))
    error('Nelson:isLocalExtrema:NonVectorTableVariable', 'Table variables must be column vectors.');
  end
end
%=============================================================================
function [x, minSeparation, window] = resolveSamplePoints(opts, samplePoints, n, isTimetable)
  % Numeric sample points (milliseconds for times), separation and window in
  % the same units; separation and window are dropped when they cannot act.
  minSeparation = opts.MinSeparation;
  window = opts.ProminenceWindow;
  isTime = isdatetime(samplePoints) || isduration(samplePoints);
  if isTime
    if ~isduration(minSeparation)
      if opts.hasMinSeparation
        if isTimetable
          error('Nelson:isLocalExtrema:SeparationMustBeDurationTimetable', '''MinSeparation'' value must be a duration scalar when the first input argument is a timetable.');
        end
        error('Nelson:isLocalExtrema:SeparationMustBeDuration', '''MinSeparation'' value must be a duration scalar if the ''SamplePoints'' values are datetimes or durations.');
      end
      minSeparation = 0;
    else
      minSeparation = milliseconds(minSeparation);
    end
    if ~isempty(window)
      if ~isduration(window)
        if isTimetable
          error('Nelson:isLocalExtrema:ProminenceWindowMustBeDurationTimetable', '''ProminenceWindow'' value must be a duration when the first input argument is a timetable.');
        end
        error('Nelson:isLocalExtrema:ProminenceWindowMustBeDuration', '''ProminenceWindow'' value must be a duration if the ''SamplePoints'' values are datetimes or durations.');
      end
      window = milliseconds(window);
    end
  else
    if isduration(minSeparation)
      error('Nelson:isLocalExtrema:SeparationCannotBeDuration', '''MinSeparation'' value must be a numeric scalar if the ''SamplePoints'' values are numeric.');
    end
    if isduration(window)
      error('Nelson:isLocalExtrema:ProminenceWindowCannotBeDuration', '''ProminenceWindow'' value must be numeric if the ''SamplePoints'' values are numeric.');
    end
  end
  x = checkSamplePoints(samplePoints, n, isTime);
  minSeparation = double(minSeparation);
  window = double(window);
  if isempty(x)
    bounds = [1, n];
  else
    bounds = [x(1), x(end)];
  end
  if ~isempty(window) && all(window ./ (1 + isscalar(window)) > (bounds(2) - bounds(1)))
    window = [];
  end
  minimumDistance = 1;
  if numel(x) >= 2
    minimumDistance = min(diff(x));
  end
  if minSeparation < minimumDistance
    minSeparation = 0;
  end
  if (minSeparation == 0) && isempty(window)
    x = [];
  end
end
%=============================================================================
function x = checkSamplePoints(samplePoints, n, isTime)
  x = [];
  if isempty(samplePoints) && ~isTime
    return
  end
  if ~(isTime || isfloat(samplePoints)) || issparse(samplePoints) || ~(isvector(samplePoints) || isempty(samplePoints))
    error('Nelson:isLocalExtrema:SamplePointsInvalidDatatype', '''SamplePoints'' value must be a vector of type double, single, duration, or datetime.');
  end
  if numel(samplePoints) ~= n
    error('Nelson:isLocalExtrema:SamplePointsLength', 'The sample points vector length must be %d, the same as the size of the input data in the operating dimension.', n);
  end
  if n == 0
    return
  end
  if isTime
    x = milliseconds(samplePoints - samplePoints(1));
  else
    if ~isreal(samplePoints)
      error('Nelson:isLocalExtrema:SamplePointsComplex', '''SamplePoints'' value must be real.');
    end
    x = double(samplePoints);
  end
  x = reshape(x, 1, []);
  if ~all(isfinite(x))
    error('Nelson:isLocalExtrema:SamplePointsNonFinite', '''SamplePoints'' value must not contain Inf or NaN.');
  end
  steps = diff(x);
  if any(steps < 0)
    error('Nelson:isLocalExtrema:SamplePointsSorted', '''SamplePoints'' value must be sorted in ascending order.');
  end
  if any(steps == 0)
    error('Nelson:isLocalExtrema:SamplePointsDuplicate', '''SamplePoints'' value contains duplicates.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = movingWindowApply(x, window, operation, fun, varargin)
  % common engine for mov* functions.
  % supported syntaxes forwarded by the wrappers:
  %   mov*(x, k)
  %   mov*(x, [kb kf])
  %   mov*(x, ..., dim)
  %   mov*(x, ..., nanflag)            with 'omitnan' | 'includenan'
  %   mov*(x, ..., 'Endpoints', ep)    with 'shrink' | 'discard' | 'fill'
  % operation names the native sliding statistic ('median', 'mad', 'sum',
  % 'mean', 'min', 'max') or is empty; fun(block, nanflag) reduces the first
  % dimension of a block whose columns are the windows, and is used when the
  % native statistic does not apply.
  narginchk(4, Inf);
  [dim, nanflag, endpoints] = parseMovingOptions(size(x), varargin{:});
  [before, after] = movingWindowSizes(window);
  perm = 1:ndims(x);
  perm([1 dim]) = [dim 1];
  xp = permute(x, perm);
  sz = size(xp);
  n = sz(1);
  cols = prod(sz(2:end));
  xr = reshape(xp, n, cols);
  if strcmp(endpoints, 'discard')
    rows = (1 + before):(n - after);
    sz(1) = length(rows);
  else
    % 'fill' pads incomplete windows with NaN values which are then
    % processed by the aggregation ('omitnan' ignores them, so 'fill'
    % behaves as 'shrink'; 'includenan' propagates them).
    numericFill = isnumeric(endpoints);
    if numericFill
      padValue = endpoints;
    else
      padValue = NaN;
    end
    if numericFill || (strcmp(endpoints, 'fill') && isfloat(x))
      xr = [repmat(padValue, before, cols); xr; repmat(padValue, after, cols)];
      rows = (1 + before):(n + before);
    else
      rows = 1:n;
    end
  end
  if movingWindowIsNative(xr, operation, nanflag)
    yr = movingWindowNative(xr, before, after, rows, operation, nanflag);
  else
    yr = movingWindowRows(xr, before, after, rows, fun, nanflag);
  end
  y = ipermute(reshape(yr, sz), perm);
end
%=============================================================================
function native = movingWindowIsNative(xr, operation, nanflag)
  % the native kernel covers full real arrays of numeric, logical or char
  % values. The mean of single values without their NaN values is
  % accumulated in single precision by the reduction, not by the kernel.
  native = ~isempty(operation) && isreal(xr) && ~issparse(xr) && (isnumeric(xr) || islogical(xr) || ischar(xr));
  if native && strcmp(operation, 'mean') && strcmp(nanflag, 'omitnan') && isa(xr, 'single')
    native = false;
  end
end
%=============================================================================
function yr = movingWindowNative(xr, before, after, rows, operation, nanflag)
  % the native kernel slides over every column at once.
  cols = size(xr, 2);
  if isempty(rows)
    yr = zeros(0, cols);
    return
  end
  if strcmp(operation, 'min') || strcmp(operation, 'max')
    % min and max skip NaN values unless 'includenan' is requested
    omitNaN = ~strcmp(nanflag, 'includenan');
  else
    omitNaN = strcmp(nanflag, 'omitnan') && isfloat(xr);
  end
  if ~isfloat(xr) && ~isinteger(xr)
    xr = double(xr);
  end
  yr = __movwindow__(xr, before, after, rows(1), rows(end), omitNaN, operation);
end
%=============================================================================
function yr = movingWindowRows(xr, before, after, rows, fun, nanflag)
  % row k of yr reduces the window of row rows(k), clipped to the array.
  [n, cols] = size(xr);
  m = length(rows);
  yr = zeros(m, cols);
  complete = (rows - before >= 1) & (rows + after <= n);
  for k = find(~complete)
    r = rows(k);
    yr(k, :) = fun(xr(max(1, r - before):min(n, r + after), :), nanflag);
  end
  first = find(complete, 1);
  last = find(complete, 1, 'last');
  if isempty(first)
    return
  end
  % complete windows form a contiguous range of rows: they are gathered as
  % the columns of a block and reduced at once, chunk by chunk to bound the
  % memory of the block.
  w = before + after + 1;
  offsets = (-before:after)';
  perChunk = max(1, floor(2097152 / w));
  count = last - first + 1;
  if count <= perChunk
    step = max(1, floor(perChunk / count));
    for c1 = 1:step:cols
      c2 = min(cols, c1 + step - 1);
      centers = rows(first:last)' + n * ((c1:c2) - 1);
      block = reshape(xr(offsets + reshape(centers, 1, [])), w, []);
      yr(first:last, c1:c2) = reshape(double(fun(block, nanflag)), count, []);
    end
  else
    for c = 1:cols
      for r1 = first:perChunk:last
        r2 = min(last, r1 + perChunk - 1);
        centers = rows(r1:r2) + n * (c - 1);
        block = reshape(xr(offsets + centers), w, []);
        yr(r1:r2, c) = reshape(double(fun(block, nanflag)), [], 1);
      end
    end
  end
end
%=============================================================================
function [before, after] = movingWindowSizes(window)
  if ~isnumeric(window) || isempty(window) || numel(window) > 2
    error('Nelson:data_analysis:windowPositiveScalarTwoElement', 'Window must be a positive scalar or a two-element vector.');
  end
  if isscalar(window)
    if window < 1
      error('Nelson:data_analysis:windowLengthPositiveScalar', '%s must be a positive scalar.', 'Window length');
    end
    % the window [k - window/2, k + window/2) is centered on element k,
    % also for a noninteger length.
    before = floor(window / 2);
    after = ceil(window / 2) - 1;
  else
    before = window(1);
    after = window(2);
    if before < 0 || after < 0
      error('Nelson:validators:mustBeNonnegative', '%s must be nonnegative.', 'Window values');
    end
    before = floor(before);
    after = floor(after);
  end
end
%=============================================================================
function [dim, nanflag, endpoints] = parseMovingOptions(szx, varargin)
  dim = movingFirstNonsingleton(szx);
  nanflag = '';
  endpoints = 'shrink';
  args = varargin;
  if ~isempty(args) && isnumeric(args{1}) && isscalar(args{1})
    dim = args{1};
    args = args(2:end);
  end
  k = 1;
  while k <= length(args)
    arg = args{k};
    if isstring(arg) && isscalar(arg)
      arg = char(arg);
    end
    if ~ischar(arg)
      error('Nelson:data_analysis:unsupportedOption', 'Unsupported option.');
    end
    if strcmpi(arg, 'omitnan') || strcmpi(arg, 'includenan')
      nanflag = lower(arg);
      k = k + 1;
    elseif strcmpi(arg, 'Endpoints')
      if k + 1 > length(args)
        error('Nelson:data_analysis:valueExpectedAfterEndpoints', 'Value expected after ''Endpoints''.');
      end
      value = args{k + 1};
      if isstring(value) && isscalar(value)
        value = char(value);
      end
      if ischar(value) && any(strcmpi(value, {'shrink', 'discard', 'fill'}))
        endpoints = lower(value);
      elseif isnumeric(value) && isscalar(value)
        % Numeric fill value: incomplete windows are padded with it.
        endpoints = value;
      else
        error('Nelson:data_analysis:unsupportedEndpointsValue', 'Unsupported ''Endpoints'' value.');
      end
      k = k + 2;
    else
      error('Nelson:data_analysis:unsupportedOption', 'Unsupported option.');
    end
  end
end
%=============================================================================
function dim = movingFirstNonsingleton(sz)
  dim = 1;
  for k = 1:length(sz)
    if sz(k) ~= 1
      dim = k;
      return
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function opts = parseLocalExtremaOptions(A, varargin)
  % Validates the arguments of islocalmax and islocalmin.
  isTabular = istable(A) || istimetable(A);
  if ~isTabular
    if ~(isnumeric(A) || islogical(A))
      error('Nelson:isLocalExtrema:FirstInputInvalid', 'First argument must be a numeric or logical array, a table, or a timetable.');
    end
    if ~isreal(A)
      error('Nelson:isLocalExtrema:ComplexInputArray', 'Complex input arguments are not supported.');
    end
  end
  opts = struct('dim', 1, 'MaxNumExtrema', Inf, 'MinSeparation', 0, ...
    'MinProminence', 0, 'FlatSelection', 'center', 'SamplePoints', [], ...
    'ProminenceWindow', [], 'DataVariables', [], 'OutputFormat', 'logical', ...
    'hasSamplePoints', false, 'hasMinSeparation', false, 'isTabular', isTabular);
  if ~isTabular
    opts.dim = find(size(A) ~= 1, 1);
    if isempty(opts.dim)
      opts.dim = 1;
    end
  end
  first = 1;
  if ~isempty(varargin) && (isnumeric(varargin{1}) || islogical(varargin{1}))
    if isTabular
      error('Nelson:isLocalExtrema:DimensionTable', 'Dimension is not supported when the first argument is a table or timetable.');
    end
    opts.dim = parseDimension(varargin{1});
    first = 2;
  end
  if mod(numel(varargin) - first + 1, 2) ~= 0
    error('Nelson:isLocalExtrema:NameValuePairs', 'Incorrect number of input arguments. Parameter names and values must occur in pairs.');
  end
  names = {'MaxNumExtrema', 'MinSeparation', 'MinProminence', 'FlatSelection', ...
    'SamplePoints', 'ProminenceWindow', 'DataVariables', 'OutputFormat'};
  for k = first:2:numel(varargin)
    index = matchOptionName(varargin{k}, names);
    if isempty(index)
      invalidName(isTabular);
    end
    opts = parseOption(opts, names{index}, varargin{k + 1}, A);
  end
end
%=============================================================================
function opts = parseOption(opts, name, value, A)
  switch name
    case 'MaxNumExtrema'
      if ~(isnumeric(value) || islogical(value)) || ~isscalar(value) || ~isreal(value) || ~(value > 0) || (fix(value) ~= value)
        error('Nelson:isLocalExtrema:MaxNumInvalid', '''MaxNumExtrema'' value must be a positive integer.');
      end
      opts.MaxNumExtrema = double(value);
    case 'MinSeparation'
      if ~isNonnegativeFiniteScalar(value, true)
        error('Nelson:isLocalExtrema:MinSeparationInvalid', '''MinSeparation'' value must be a nonnegative, real, finite scalar.');
      end
      opts.MinSeparation = value;
      opts.hasMinSeparation = true;
    case 'MinProminence'
      if ~(isnumeric(value) || islogical(value)) || ~isNonnegativeFiniteScalar(value, false)
        error('Nelson:isLocalExtrema:MinProminenceInvalid', '''MinProminence'' value must be a nonnegative numeric scalar.');
      end
      opts.MinProminence = double(value);
    case 'FlatSelection'
      flatOptions = {'all', 'first', 'center', 'last'};
      index = matchOptionName(value, flatOptions);
      if isempty(index)
        error('Nelson:isLocalExtrema:FlatSelectionInvalid', '''FlatSelection'' must be ''first'', ''center'', ''last'', or ''all''.');
      end
      opts.FlatSelection = flatOptions{index};
    case 'SamplePoints'
      if istimetable(A)
        error('Nelson:isLocalExtrema:SamplePointsTimeTable', '''SamplePoints'' parameter not supported when first argument is a timetable.');
      end
      opts.SamplePoints = value;
      opts.hasSamplePoints = true;
    case 'ProminenceWindow'
      if ~isValidProminenceWindow(value)
        error('Nelson:isLocalExtrema:ProminenceWindowLengthInvalid', '''ProminenceWindow'' value must be a positive scalar or 2-element vector of nonnegative scalars.');
      end
      opts.ProminenceWindow = value;
    case 'DataVariables'
      if ~opts.isTabular
        error('Nelson:isLocalExtrema:DataVariablesArray', '''DataVariables'' parameter is only supported when the first input argument is a table or timetable.');
      end
      opts.DataVariables = value;
    otherwise
      if ~opts.isTabular
        error('Nelson:isLocalExtrema:OutputFormatArray', '''OutputFormat'' parameter is only supported when the first input argument is a table or timetable.');
      end
      formats = {'logical', 'tabular'};
      index = matchOptionName(value, formats);
      if isempty(index)
        error('Nelson:isLocalExtrema:OutputFormatInvalid', '''OutputFormat'' value must be ''logical'' or ''tabular''.');
      end
      opts.OutputFormat = formats{index};
  end
end
%=============================================================================
function dim = parseDimension(value)
  if ~isscalar(value) || ~isreal(value) || ~(value > 0) || ~isfinite(value) || (fix(value) ~= value)
    error('Nelson:isLocalExtrema:DimensionInvalid', 'Dimension must be a positive integer.');
  end
  dim = double(value);
end
%=============================================================================
function index = matchOptionName(value, names)
  % unique case-insensitive prefix match, [] otherwise.
  index = [];
  if ~((ischar(value) && (isrow(value) || isempty(value))) || (isstring(value) && isscalar(value)))
    return
  end
  value = char(value);
  if isempty(value)
    return
  end
  matches = find(strncmpi(value, names, length(value)));
  if isscalar(matches)
    index = matches;
  end
end
%=============================================================================
function invalidName(isTabular)
  if isTabular
    error('Nelson:isLocalExtrema:InvalidNameTable', 'Parameter name must be ''MaxNumExtrema'', ''MinSeparation'', ''MinProminence'', ''FlatSelection'', ''SamplePoints'', ''ProminenceWindow'', ''DataVariables'', or ''OutputFormat''.');
  end
  error('Nelson:isLocalExtrema:InvalidNameArray', 'Parameter name must be ''MaxNumExtrema'', ''MinSeparation'', ''MinProminence'', ''FlatSelection'', ''SamplePoints'', or ''ProminenceWindow''.');
end
%=============================================================================
function tf = isNonnegativeFiniteScalar(value, allowDuration)
  if allowDuration && isduration(value)
    tf = isscalar(value) && (milliseconds(value) >= 0) && isfinite(milliseconds(value));
    return
  end
  tf = (isnumeric(value) || islogical(value)) && isscalar(value) && isreal(value) && (value >= 0) && isfinite(value);
end
%=============================================================================
function tf = isValidProminenceWindow(value)
  if isduration(value)
    value = milliseconds(value);
  elseif ~(isnumeric(value) && isreal(value))
    tf = false;
    return
  end
  if isscalar(value)
    tf = ~isnan(value) && (value > 0);
  else
    tf = isvector(value) && (numel(value) == 2) && all(~isnan(value)) && all(value >= 0);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = setOperation(op, A, B, varargin)
  [stable, byRows] = parseSetOptions(varargin{:});
  if byRows
    [varargout{1:max(1, nargout)}] = setOperationRows(op, A, B, stable);
    return
  end
  a = A(:);
  b = B(:);
  if issparse(a)
    a = full(a);
  end
  if issparse(b)
    b = full(b);
  end
  useKeys = ~(isComparableByValueLocal(a) && isComparableByValueLocal(b));
  if useKeys
    keysA = valuesToKeys(a);
    keysB = valuesToKeys(b);
    [uaVals, uaIdx] = uniqueByKeysLocal(a, keysA, stable);
    [ubVals, ubIdx] = uniqueByKeysLocal(b, keysB, stable);
    [tfA, locB] = ismemberKeys(valuesToKeys(uaVals), keysB);
    [tfB, ~] = ismemberKeys(valuesToKeys(ubVals), keysA);
  else
    [uaVals, uaIdx] = uniqueValuesLocal(a, stable);
    [ubVals, ubIdx] = uniqueValuesLocal(b, stable);
    [tfA, locB] = memberValuesLocal(uaVals, b);
    [tfB, ~] = memberValuesLocal(ubVals, a);
  end
  switch op
    case 'intersect'
      C = uaVals(tfA);
      ia = uaIdx(tfA);
      ib = locB(tfA);
      values = {reshapeLikeInputs(C, A, B), ia(:), ib(:)};
    case 'setdiff'
      keep = ~tfA;
      C = uaVals(keep);
      ia = uaIdx(keep);
      % setdiff result orientation only depends on A (compatible with the reference implementation)
      values = {reshapeLikeInputs(C, A, A), ia(:)};
    case 'union'
      onlyB = ~tfB;
      cA = uaVals;
      cB = ubVals(onlyB);
      iaAll = uaIdx;
      ibAll = ubIdx(onlyB);
      [C, ia, ib] = mergePartsLocal(cA, cB, iaAll, ibAll, stable, useKeys);
      values = {reshapeLikeInputs(C, A, B), ia(:), ib(:)};
    case 'setxor'
      keepA = ~tfA;
      keepB = ~tfB;
      cA = uaVals(keepA);
      cB = ubVals(keepB);
      iaAll = uaIdx(keepA);
      ibAll = ubIdx(keepB);
      [C, ia, ib] = mergePartsLocal(cA, cB, iaAll, ibAll, stable, useKeys);
      values = {reshapeLikeInputs(C, A, B), ia(:), ib(:)};
    otherwise
      error('Nelson:data_analysis:unsupportedSetOperation', 'Unsupported set operation.');
  end
  varargout = values(1:max(1, nargout));
end
%=============================================================================
function [stable, byRows] = parseSetOptions(varargin)
  stable = false;
  byRows = false;
  for k = 1:length(varargin)
    option = varargin{k};
    if isstring(option)
      if ~isscalar(option)
        error('Nelson:data_analysis:unsupportedOption', 'Unsupported option.');
      end
      option = char(option);
    end
    if ischar(option) && strcmpi(option, 'stable')
      stable = true;
    elseif ischar(option) && strcmpi(option, 'sorted')
      stable = false;
    elseif ischar(option) && strcmpi(option, 'rows')
      byRows = true;
    else
      error('Nelson:data_analysis:unsupportedOption', 'Unsupported option.');
    end
  end
end
%=============================================================================
function varargout = setOperationRows(op, A, B, stable)
  if ~isempty(A) && ~isempty(B) && (size(A, 2) ~= size(B, 2))
    error('Nelson:data_analysis:inputsSameNumberColumns', 'Inputs must have the same number of columns.');
  end
  [uaVals, uaIdx] = uniqueRowsLocal(A, stable);
  [ubVals, ubIdx] = uniqueRowsLocal(B, stable);
  [tfA, locB] = ismemberRowsLocal(uaVals, B);
  [tfB, ~] = ismemberRowsLocal(ubVals, A);
  switch op
    case 'intersect'
      C = uaVals(tfA, :);
      values = {C, uaIdx(tfA), locB(tfA)};
    case 'setdiff'
      keep = ~tfA;
      values = {uaVals(keep, :), uaIdx(keep)};
    case 'union'
      onlyB = ~tfB;
      [C, ia, ib] = mergeRowsLocal(uaVals, ubVals(onlyB, :), uaIdx, ubIdx(onlyB), stable);
      values = {C, ia, ib};
    case 'setxor'
      keepA = ~tfA;
      keepB = ~tfB;
      [C, ia, ib] = mergeRowsLocal(uaVals(keepA, :), ubVals(keepB, :), ...
        uaIdx(keepA), ubIdx(keepB), stable);
      values = {C, ia, ib};
    otherwise
      error('Nelson:data_analysis:unsupportedSetOperation', 'Unsupported set operation.');
  end
  varargout = values(1:max(1, nargout));
end
%=============================================================================
function [U, idx] = uniqueRowsLocal(M, stable)
  % U = unique rows of M; idx = row index of the first occurrence in M.
  n = size(M, 1);
  if n == 0
    U = M;
    idx = zeros(0, 1);
    return
  end
  [Ms, si] = sortrows(M);
  newRun = true(n, 1);
  for k = 2:n
    newRun(k) = ~isequal(Ms(k, :), Ms(k - 1, :));
  end
  idxSorted = zeros(sum(newRun), 1);
  r = 0;
  for k = 1:n
    if newRun(k)
      r = r + 1;
      idxSorted(r) = si(k);
    elseif si(k) < idxSorted(r)
      idxSorted(r) = si(k);
    end
  end
  if stable
    idx = sort(idxSorted);
  else
    idx = idxSorted;
  end
  U = M(idx, :);
end
%=============================================================================
function [tf, loc] = ismemberRowsLocal(Q, S)
  % tf(i) true if row Q(i,:) equals a row of S; loc(i) = first match (0 if none).
  nq = size(Q, 1);
  ns = size(S, 1);
  tf = false(nq, 1);
  loc = zeros(nq, 1);
  if nq == 0 || ns == 0
    return
  end
  for i = 1:nq
    for j = 1:ns
      if isequal(Q(i, :), S(j, :))
        tf(i) = true;
        loc(i) = j;
        break
      end
    end
  end
end
%=============================================================================
function [C, ia, ib] = mergeRowsLocal(cA, cB, iaAll, ibAll, stable)
  nA = size(cA, 1);
  C0 = [cA; cB];
  if stable || isempty(C0)
    C = C0;
    ia = iaAll;
    ib = ibAll;
    return
  end
  [C, p] = sortrows(C0);
  fromA = (p <= nA);
  ia = iaAll(p(fromA));
  ib = ibAll(p(~fromA) - nA);
end
%=============================================================================
function tf = isComparableByValueLocal(x)
  tf = isnumeric(x) || islogical(x) || ischar(x);
end
%=============================================================================
function [C, ia, ib] = mergePartsLocal(cA, cB, iaAll, ibAll, stable, useKeys)
  % combines the part coming from A and the part coming only from B,
  % keeping track of which output indices refer to A and which to B.
  nA = numel(cA);
  C0 = [cA; cB];
  if stable || isempty(C0)
    C = C0;
    ia = iaAll;
    ib = ibAll;
    return
  end
  if useKeys
    [C, p] = sortByKeysLocal(C0);
  else
    [C, p] = sort(C0);
    C = C0(p);
  end
  fromA = (p <= nA);
  ia = iaAll(p(fromA));
  ib = ibAll(p(~fromA) - nA);
end
%=============================================================================
function [C, ic] = uniqueValuesLocal(x, stable)
  % unique for numeric/logical/char values based on sort + strict equality:
  % NaN never equals NaN (each NaN is kept), -0 == 0, no precision loss.
  % ic contains the index of the first occurrence in x.
  x = x(:);
  n = numel(x);
  if n == 0
    C = x;
    ic = zeros(0, 1);
    return
  end
  [xs, si] = sort(x);
  newRun = true(n, 1);
  for k = 2:n
    newRun(k) = ~(xs(k) == xs(k - 1));
  end
  nRuns = sum(newRun);
  ic = zeros(nRuns, 1);
  r = 0;
  for k = 1:n
    if newRun(k)
      r = r + 1;
      ic(r) = si(k);
    elseif si(k) < ic(r)
      ic(r) = si(k);
    end
  end
  if stable
    ic = sort(ic);
  end
  C = x(ic);
end
%=============================================================================
function [tf, loc] = memberValuesLocal(vals, source)
  % tf(k) true if vals(k) is equal (==) to an element of source.
  % loc(k) is the index of the first occurrence in source (0 if none).
  % NaN never matches. O(n log n).
  vals = vals(:);
  source = source(:);
  n = numel(vals);
  tf = false(n, 1);
  loc = zeros(n, 1);
  if n == 0 || isempty(source)
    return
  end
  if ~isreal(vals) || ~isreal(source)
    for k = 1:n
      f = find(source == vals(k), 1);
      if ~isempty(f)
        tf(k) = true;
        loc(k) = f;
      end
    end
    return
  end
  [ss, si] = sort(source);
  m = numel(ss);
  runMin = si;
  for k = 2:m
    if ss(k) == ss(k - 1) && runMin(k - 1) < runMin(k)
      runMin(k) = runMin(k - 1);
    end
  end
  for k = m - 1:-1:1
    if ss(k) == ss(k + 1)
      runMin(k) = runMin(k + 1);
    end
  end
  [vs, vi] = sort(vals);
  j = 1;
  for k = 1:n
    v = vs(k);
    while j <= m && ss(j) < v
      j = j + 1;
    end
    if j <= m && ss(j) == v
      tf(vi(k)) = true;
      loc(vi(k)) = runMin(j);
    end
  end
end
%=============================================================================
function [C, ic] = uniqueByKeysLocal(vals, keys, stable)
  % unique for cell/string values compared through their keys.
  % ic contains the index of the first occurrence in vals.
  firstIdx = [];
  seen = {};
  for k = 1:length(keys)
    if ~any(strcmp(seen, keys{k}))
      seen{end + 1} = keys{k};
      firstIdx(end + 1) = k;
    end
  end
  ic = firstIdx(:);
  C = vals(ic);
  if ~stable && ~isempty(ic)
    [C, p] = sortByKeysLocal(C);
    ic = ic(p);
  end
end
%=============================================================================
function [C, p] = sortByKeysLocal(vals)
  % returns vals sorted (using the builtin unique ordering) and the
  % permutation p such that C = vals(p). vals must not contain duplicates.
  sortedVals = unique(vals);
  if numel(sortedVals) ~= numel(vals)
    % cannot establish a one to one mapping: keep current order.
    C = vals;
    p = (1:numel(vals))';
    return
  end
  keys0 = valuesToKeys(vals);
  keysS = valuesToKeys(sortedVals);
  p = zeros(numel(vals), 1);
  for k = 1:numel(vals)
    p(k) = find(strcmp(keys0, keysS{k}), 1);
  end
  C = vals(p);
end
%=============================================================================
function C = reshapeLikeInputs(C, A, B)
  if isrow(A) && isrow(B)
    C = C(:).';
  else
    C = C(:);
  end
end
%=============================================================================
function keys = valuesToKeys(values)
  keys = cell(numel(values), 1);
  for k = 1:numel(values)
    keys{k} = valueKey(values(k));
  end
end
%=============================================================================
function key = valueKey(value)
  if iscell(value)
    if isempty(value)
      key = 'cell:[]';
    else
      key = ['cell:', valueKey(value{1})];
    end
  elseif isstring(value)
    key = ['string:', char(value)];
  elseif ischar(value)
    key = ['char:', value];
  elseif isnumeric(value) || islogical(value)
    key = [class(value), ':', mat2str(value)];
  else
    key = [class(value), ':', char(string(value))];
  end
end
%=============================================================================
function [tf, loc] = ismemberKeys(keysA, keysB)
  tf = false(length(keysA), 1);
  loc = zeros(length(keysA), 1);
  for k = 1:length(keysA)
    found = find(strcmp(keysB, keysA{k}), 1);
    if ~isempty(found)
      tf(k) = true;
      loc(k) = found;
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
