      "render": {
        "type": "image",
        "src": "PlanarPositionSensor.svg"
      },
      "help": "Absolute position of the frame-a point along the chosen axis (x, y) or the body angle (phi)."
    },
    {
      "type": "PlanarVelocitySensor",
      "label": "PlanarVelocitySensor",
      "acausal": true,
      "domain": "planar",
      "width": 90,
      "height": 70,
      "physicalPins": [
        {
          "name": "a",
