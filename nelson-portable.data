function opts = __detectImportOptions_json__(filename, varargin)
  % JSON backend of detectImportOptions (called by the builtin).
  args = jsonTableArgs(varargin);
  [root, rootIsArray, columns] = jsonTableDecode(convertStringsToChars(filename), args.Options, ...
    jsonTableColumnar(args.Options, args.TableNodeName, any(strcmp(args.Set, 'TableSelector'))));
  opts = jsonTableDetect(root, rootIsArray, args, columns);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function T = __readtable_json__(filename, varargin)
  % JSON backend of readtable and readtimetable (called by the builtins).
  if ~isempty(varargin) && isa(varargin{1}, 'nelson.io.json.JSONImportOptions')
    if numel(varargin) > 1
      error('Nelson:spreadsheet:importOptionsExpected', 'Import options object expected.');
    end
    opts = varargin{1};
    [root, rootIsArray, columns] = jsonTableDecode(convertStringsToChars(filename), opts, ...
      jsonTableColumnar(opts, '', true));
    T = jsonTableRead(root, opts, jsonTableCache(root, rootIsArray, opts.TableSelector, columns));
    return
  end
  args = jsonTableArgs(varargin);
  [root, rootIsArray, columns] = jsonTableDecode(convertStringsToChars(filename), args.Options, ...
    jsonTableColumnar(args.Options, args.TableNodeName, any(strcmp(args.Set, 'TableSelector'))));
  [opts, cache] = jsonTableDetect(root, rootIsArray, args, columns);
  T = jsonTableRead(root, opts, cache);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function __writetable_json__(T, filename, varargin)
  % JSON backend of writetable and writetimetable (called by the builtins).
  % Each table row is written as a JSON object, keys are the variable names.
  options = parseOptions(varargin);
  [keys, values] = tableEntries(T, options.WriteRowNames);
  for k = 1:numel(values)
    values{k} = jsonTableWriteColumn(values{k}, options.PreserveInfAndNaN);
  end
  __write_json_table__(convertStringsToChars(filename), keys, values, ...
    options.PrettyPrint, options.PreserveInfAndNaN);
end
%=============================================================================
function options = parseOptions(nameValues)
  options.WriteRowNames = false;
  options.PrettyPrint = true;
  options.PreserveInfAndNaN = true;
  if mod(numel(nameValues), 2) ~= 0
    error('Nelson:spreadsheet:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  supported = {'FileType', 'WriteRowNames', 'PrettyPrint', 'PreserveInfAndNaN', 'DateLocale'};
  for k = 1:2:numel(nameValues)
    match = strcmpi(supported, convertStringsToChars(nameValues{k}));
    if ~any(match)
      error('Nelson:spreadsheet:propertyNotSupported', 'Property name not supported.');
    end
    name = supported{match};
    value = nameValues{k + 1};
    switch name
      case {'WriteRowNames', 'PrettyPrint', 'PreserveInfAndNaN'}
        if ~(islogical(value) || isnumeric(value)) || ~isscalar(value)
          error('Nelson:spreadsheet:logicalScalarExpected', 'Logical scalar expected.');
        end
        options.(name) = logical(value);
      otherwise
        % FileType is 'json' here; DateLocale is accepted, dates are written in English.
    end
  end
end
%=============================================================================
function [keys, values] = tableEntries(T, writeRowNames)
  keys = T.Properties.VariableNames;
  values = cell(1, numel(keys));
  for k = 1:numel(keys)
    values{k} = T.(keys{k});
  end
  if istimetable(T)
    rowKey = T.Properties.DimensionNames{1};
    rowValues = T.Properties.RowTimes;
  elseif writeRowNames && ~isempty(T.Properties.RowNames)
    rowKey = T.Properties.DimensionNames{1};
    rowValues = T.Properties.RowNames(:);
  else
    return
  end
  keys = [{rowKey}, keys];
  values = [{rowValues}, values];
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = csvread(varargin)
  narginchk(1, 4);
  nargoutchk(0, 1);
  filename = varargin{1};
  mustBeTextScalar(filename, 1);

  filename = convertStringsToChars(filename);
  if ~isfile(filename)
    error('Nelson:FileNotFound', 'File ''%s'' not found.', filename);
  end
  if (nargin < 2)
    R = 0;
  else
    R = varargin{2};
  end
  if (nargin < 3)
    C = 0;
  else
    C = varargin{3};
  end
  separator = ',';
  if (nargin < 4)
    M = dlmread(filename, separator, R, C);
  else
    RNG = varargin{4};
    mustBeVector(RNG, 4);
    assert(numel(RNG) == 4, 'RNG must be a 4 elements vector.');
    assert(RNG(1) == R, 'RNG(1) must be equal to R.');
    assert(RNG(2) == C, 'RNG(2) must be equal to C.');
    M = dlmread(filename, separator, RNG);
  end
  varargout{1} = M;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = csvwrite(varargin)
  nargoutchk(0, 0);
  narginchk(1, 4);
  filename = varargin{1};
  mustBeTextScalar(filename, 1);

  M = varargin{2};
  if (nargin < 3)
    R = 0;
  else
    R = varargin{3};
  end
  if (nargin < 4)
    C = 0;
  else
    C = varargin{4};
  end
  try
    dlmwrite(filename, M, ',', R, C);
  catch e
    throw(e);
  end
end
