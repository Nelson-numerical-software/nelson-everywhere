function tf = isprime(x)
  narginchk(1, 1);
  nargoutchk(0, 1);
  if ~isnumeric(x) && ~islogical(x)
    error('Nelson:isprime:nonNumericInput', 'Input must be numeric or logical.');
  end
  if ~isreal(x) || any(x(:) < 0) || any(x(:) ~= fix(x(:)))
    error('Nelson:isprime:nonNonnegativeInteger', 'Input must contain nonnegative integers.');
  end
  d = double(x);
  tf = (d >= 2);
  if ~any(tf(:))
    return;
  end
  mx = max(d(:));
  p = primes(floor(sqrt(mx)));
  for k = 1:numel(p)
    pk = p(k);
    tf = tf & ((mod(d, pk) ~= 0) | (d == pk));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
