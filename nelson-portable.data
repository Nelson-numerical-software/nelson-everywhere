% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function R = mldivide(A, B)
  % Element-wise operation on a table or timetable combined with a scalar.
  checkTabularScalarOperand(A, B, 'mldivide');
  R = ldivide(A, B);
end
