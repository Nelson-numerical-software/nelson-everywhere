function out = eraseBetween(str, start, stop, varargin)
  narginchk(3, 5);
  nargoutchk(0, 1);
  replacement = '';
  out = replaceBetween(str, start, stop, replacement, varargin{:});
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function out = extractBetween(str, start, stop, varargin)
  narginchk(3, 5);
  nargoutchk(0, 1);
  boundaries = '';
  if nargin >= 5 && strcmpi(char(varargin{1}), 'Boundaries')
    boundaries = char(varargin{2});
  end
  hasMissing = false;
  if isstring(str)
    missingMask = ismissing(str);
    hasMissing = any(missingMask(:));
    str(missingMask) = "";
  end
  [items, ~, kind] = stringPrivateToCellstr(str);
  result = cell(size(items));
  for k = 1:numel(items)
    extracted = extractBetweenOne(items{k}, selectElement(start, k), selectElement(stop, k), boundaries);
    if iscell(extracted)
      if numel(items) == 1
        result = extracted(:);
        break
      elseif isempty(extracted)
        result{k} = '';
      else
        result{k} = extracted{1};
      end
    else
      result{k} = extracted;
    end
  end
  out = stringPrivateFromCellstr(result, kind, strcmp(kind, 'char'));
  if hasMissing
    if isscalar(str)
      out = string(missing);
    else
      out(missingMask) = missing;
    end
  end
end
%=============================================================================
function value = selectElement(value, k)
  if isnumeric(value) && numel(value) > 1
    value = value(k);
  elseif isstring(value) && numel(value) > 1
    value = value(k);
  elseif iscell(value) && numel(value) > 1
    value = value{k};
  end
end
%=============================================================================
function value = extractBetweenOne(txt, start, stop, boundaries)
  if isnumeric(start) && isnumeric(stop)
    s = start;
    e = stop;
    if strcmpi(boundaries, 'exclusive')
      s = s + 1;
      e = e - 1;
    end
    value = txt(max(1, s):min(length(txt), e));
    return
  end
  startExpr = stringPrivatePatternRegex(start);
  stopExpr = stringPrivatePatternRegex(stop);
  value = {};
  offset = 1;
  while offset <= length(txt)
    [s1, e1] = regexp(txt(offset:end), startExpr, 'start', 'end', 'once');
    if isempty(s1)
      break
    end
    s1 = s1 + offset - 1;
    e1 = e1 + offset - 1;
    [s2, e2] = regexp(txt(e1 + 1:end), stopExpr, 'start', 'end', 'once');
    if isempty(s2)
      break
    end
    s2 = s2 + e1;
    e2 = e2 + e1;
    if strcmpi(boundaries, 'inclusive')
      value{end + 1, 1} = txt(s1:e2);
    else
      value{end + 1, 1} = txt(e1 + 1:s2 - 1);
    end
    offset = e2 + 1;
  end
end
