function ret = convertDataType(type, data)
  if isa(data, type)
    ret = data;
    return;
  end
  if strcmp(type, '')
    ret = data;
    return;
  end
  if strcmp(type, 'cell') || strcmp(type, 'struct')
    msg = sprintf("Unable to use '%s' as key for dictionary with '%s' key type.", class(data), type);
    error('Nelson:dictionary:CannotSliceKeys', msg);
  end
  if strcmp(type, 'cell') && isnumeric(data)
    ret = num2str(data);
    return
  end
  ret = feval(type, data);
end
