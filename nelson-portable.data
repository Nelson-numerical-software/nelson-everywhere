%=============================================================================
function varargout = skip_impl(varargin)
  narginchk(0, 2);
  nargoutchk(0, 0);

  varargout = {};
  condition = false;
  reason = '';

  if nargin == 0
    condition = true;
  elseif nargin == 1
    if islogical(varargin{1})
      condition = varargin{1};
    else
      reason = varargin{1};
      condition = true;
    end
  else
    condition = varargin{1};
    reason = varargin{2};
  end

  if condition
    if isempty(reason)
      reason = _('Testsuite skipped');
    end
    error('Nelson:tests_manager:testsuite_skipped', reason);
  end
end
