% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function name = jsonFieldName(value, key)
  % Returns the field of the decoded object 'value' (or of its list of
  % field names) matching the JSON key, or '' when absent. Decoded field
  % names are valid identifiers.
  name = '';
  if iscellstr(value)
    value = cell2struct(cell(numel(value), 1), value(:), 1);
  end
  if ~isstruct(value)
    return
  end
  if isfield(value, key)
    name = key;
    return
  end
  candidate = regexprep(key, '[^a-zA-Z_0-9]', '_');
  if isempty(candidate)
    candidate = 'x';
  elseif candidate(1) == '_'
    candidate = ['x', candidate];
  elseif any(candidate(1) == '0123456789')
    candidate = ['x_', candidate];
  end
  if isfield(value, candidate)
    name = candidate;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [value, found] = jsonPointerGet(value, pointer)
  % Resolves a JSON Pointer (text or token list) on a decoded JSON value.
  % Returns [] and found = false when the node does not exist.
  if iscell(pointer)
    tokens = pointer;
  else
    tokens = jsonPointerTokens(pointer);
  end
  found = true;
  for k = 1:numel(tokens)
    token = tokens{k};
    if isstruct(value) && isscalar(value)
      name = jsonFieldName(value, token);
      if isempty(name)
        value = [];
        found = false;
        return
      end
      value = value.(name);
    elseif ~isempty(regexp(token, '^\d+$', 'once')) && str2double(token) < numel(value)
      index = str2double(token) + 1;
      if iscell(value)
        value = value{index};
      else
        value = value(index);
      end
    else
      value = [];
      found = false;
      return
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function tokens = jsonPointerTokens(pointer)
  % Splits an RFC 6901 JSON Pointer into unescaped reference tokens.
  if isstring(pointer)
    pointer = char(pointer);
  end
  if isempty(pointer)
    tokens = {};
    return
  end
  if pointer(1) ~= '/'
    error('Nelson:spreadsheet:invalidJsonPointer', 'Invalid JSON Pointer: %s', pointer);
  end
  tokens = strsplit(pointer(2:end), '/', 'CollapseDelimiters', false);
  tokens = strrep(strrep(tokens, '~1', '/'), '~0', '~');
end
