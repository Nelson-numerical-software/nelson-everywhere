% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function out = ip_filter_along_dim3(data, kernel, dim, padding)
  s = size(data);
  out = zeros(s);
  radius = (numel(kernel) - 1) / 2;
  for k = 1:numel(kernel)
    shift = k - radius - 1;
    out = out + kernel(k) * ip_shift_volume_dim3(data, dim, shift, padding);
  end
end
%=============================================================================
function shifted = ip_shift_volume_dim3(data, dim, shift, padding)
  s = size(data);
  if ischar(padding)
    shifted = ip_shift_volume_indexed(data, dim, shift, padding, s);
  else
    shifted = zeros(s) + padding;
    shifted = ip_shift_volume_constant(data, shifted, dim, shift, s);
  end
end
%=============================================================================
function shifted = ip_shift_volume_indexed(data, dim, shift, padding, s)
  if dim == 1
    idx = ip_pad_index((1:s(1)) + shift, s(1), padding);
    shifted = data(idx, :, :);
  elseif dim == 2
    idx = ip_pad_index((1:s(2)) + shift, s(2), padding);
    shifted = data(:, idx, :);
  else
    idx = ip_pad_index((1:s(3)) + shift, s(3), padding);
    shifted = data(:, :, idx);
  end
end
%=============================================================================
function shifted = ip_shift_volume_constant(data, shifted, dim, shift, s)
  if dim == 1
    idx = (1:s(1)) + shift;
    valid = idx >= 1 & idx <= s(1);
    shifted(valid, :, :) = data(idx(valid), :, :);
  elseif dim == 2
    idx = (1:s(2)) + shift;
    valid = idx >= 1 & idx <= s(2);
    shifted(:, valid, :) = data(:, idx(valid), :);
  else
    idx = (1:s(3)) + shift;
    valid = idx >= 1 & idx <= s(3);
    shifted(:, :, valid) = data(:, :, idx(valid));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function T = ip_fit_affine_transform(movingPoints, fixedPoints)
  if size(movingPoints, 1) < 3
    error('Nelson:image_processing:leastThreePointPairsRequiredAffine', 'At least three point pairs are required for an affine transform.');
  end
  x = movingPoints(:, 1);
  y = movingPoints(:, 2);
  u = fixedPoints(:, 1);
  v = fixedPoints(:, 2);
  A = [x y ones(size(x))];
  if rank(A) < 3
    error('Nelson:image_processing:controlPointsNotDefineUniqueTransformation', 'Control points do not define a unique transformation.');
  end
  paramsU = A \ u;
  paramsV = A \ v;
  T = [paramsU(1) paramsV(1) 0; paramsU(2) paramsV(2) 0; paramsU(3) paramsV(3) 1];
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function T = ip_fit_projective_transform(movingPoints, fixedPoints)
  n = size(movingPoints, 1);
  if n < 4
    error('Nelson:image_processing:leastFourPointPairsRequiredProjective', 'At least four point pairs are required for a projective transform.');
  end
  x = movingPoints(:, 1);
  y = movingPoints(:, 2);
  u = fixedPoints(:, 1);
  v = fixedPoints(:, 2);
  A = zeros(2 * n, 8);
  b = zeros(2 * n, 1);
  A(1:2:end, :) = [x zeros(n, 1) -u .* x y zeros(n, 1) -u .* y ones(n, 1) zeros(n, 1)];
  A(2:2:end, :) = [zeros(n, 1) x -v .* x zeros(n, 1) y -v .* y zeros(n, 1) ones(n, 1)];
  b(1:2:end) = u;
  b(2:2:end) = v;
  if rank(A) < 8
    error('Nelson:image_processing:controlPointsNotDefineUniqueTransformation', 'Control points do not define a unique transformation.');
  end
  p = A \ b;
  T = [p(1) p(2) p(3); p(4) p(5) p(6); p(7) p(8) 1];
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function kernel = ip_gaussian_kernel1d(filterSize, sigma)
  radius = (filterSize - 1) / 2;
  x = -radius:radius;
  kernel = exp(-(x .^ 2) / (2 * sigma ^ 2));
  kernel = kernel / sum(kernel);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function bw = ip_grayconnected_region(values, row, col, tolerance, conn)
  [rows, cols] = size(values);
  seed = values(row, col);
  allowed = abs(values - seed) <= tolerance;
  bw = false(rows, cols);
  if ~allowed(row, col)
    return
  end
  offsets = ip_connectivity_offsets(conn);
  queue = zeros(numel(values), 1);
  head = 1;
  tail = 1;
  queue(tail) = row + (col - 1) * rows;
  bw(row, col) = true;
  while head <= tail
    idx = queue(head);
    head = head + 1;
    r = mod(idx - 1, rows) + 1;
    c = floor((idx - 1) / rows) + 1;
    for k = 1:size(offsets, 1)
      rr = r + offsets(k, 1);
      cc = c + offsets(k, 2);
      if rr >= 1 && rr <= rows && cc >= 1 && cc <= cols && allowed(rr, cc) && ~bw(rr, cc)
        bw(rr, cc) = true;
        tail = tail + 1;
        queue(tail) = rr + (cc - 1) * rows;
      end
    end
  end
end
%=============================================================================
%=============================================================================
