%=============================================================================
function varargout = bubblelim(varargin)
  varargin = convertStringToCharArgs(varargin);
  narginchk(0, 2);
  nargoutchk(0, 1);
  [ax, args] = parseBubbleAxes(varargin);
  if isempty(args)
    varargout{1} = currentBubbleLimits(ax);
    return
  end
  value = args{1};
  if ischar(value)
    switch lower(value)
      case 'mode'
        varargout{1} = ax.BubbleLimitsMode_I;
        return
      case 'auto'
        ax.BubbleLimitsMode_I = 'auto';
        rejectOutput(nargout);
        return
      case 'manual'
        ax.BubbleLimits_I = currentBubbleLimits(ax);
        ax.BubbleLimitsMode_I = 'manual';
        rejectOutput(nargout);
        return
      otherwise
        error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
    end
  end
  validateBubbleLimits(value);
  ax.BubbleLimits_I = double(value(:).');
  ax.BubbleLimitsMode_I = 'manual';
  rejectOutput(nargout);
end
%=============================================================================
function [ax, args] = parseBubbleAxes(args)
  if ~isempty(args) && isscalar(args{1}) && isgraphics(args{1}, 'axes')
    ax = args{1};
    args = args(2:end);
  else
    ax = gca();
  end
end
%=============================================================================
function limits = currentBubbleLimits(ax)
  if strcmp(ax.BubbleLimitsMode_I, 'manual')
    limits = ax.BubbleLimits_I;
  else
    limits = autoBubbleLimits(ax);
    ax.BubbleLimits_I = limits;
  end
end
%=============================================================================
function limits = autoBubbleLimits(ax)
  values = [];
  children = ax.Children;
  for k = 1:numel(children)
    child = children(k);
    if isgraphics(child, 'bubblechart')
      values = [values, double(child.SizeData(:).')];
    end
  end
  values = values(isfinite(values));
  values(values < 0) = 0;
  if isempty(values)
    limits = [0 1];
  else
    limits = [min(values), max(values)];
    if limits(1) == limits(2)
      if limits(2) > 0
        limits(1) = limits(2) * 0.9;
      else
        limits(2) = 1;
      end
    end
  end
end
%=============================================================================
function validateBubbleLimits(value)
  if ~(isnumeric(value) && isreal(value) && numel(value) == 2 && ...
      all(isfinite(value)) && value(2) > value(1))
    error('Nelson:bubblelim:invalidValue', 'Value must be a 1x2 vector of numeric type in which the second element is larger than the first.');
  end
end
%=============================================================================
function rejectOutput(nout)
  if nout > 0
    error('Nelson:tooManyOutputs', 'Too many output arguments.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = bubblesize(varargin)
  varargin = convertStringToCharArgs(varargin);
  narginchk(0, 2);
  nargoutchk(0, 1);
  [ax, args] = parseBubbleAxes(varargin);
  if isempty(args)
    varargout{1} = ax.BubbleSizeRange_I;
    return
  end
  value = args{1};
  validateBubbleSize(value);
  ax.BubbleSizeRange_I = double(value(:).');
  rejectOutput(nargout);
end
%=============================================================================
function [ax, args] = parseBubbleAxes(args)
  if ~isempty(args) && isscalar(args{1}) && isgraphics(args{1}, 'axes')
    ax = args{1};
    args = args(2:end);
  else
    ax = gca();
  end
end
%=============================================================================
function validateBubbleSize(value)
  if ~(isnumeric(value) && isreal(value) && numel(value) == 2 && ...
      all(isfinite(value)) && all(value > 0) && value(2) > value(1))
    error('Nelson:bubblesize:invalidValue', 'Value must be a 1x2 vector of positive numbers in which the second element is larger than the first.');
  end
end
%=============================================================================
function rejectOutput(nout)
  if nout > 0
    error('Nelson:tooManyOutputs', 'Too many output arguments.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = camlight(varargin)
  nargoutchk(0, 1);
  inputArguments = convertStringToCharArgs(varargin);
  [ax, h, mode, az, el] = parseCamlightInputs(inputArguments);
  if strcmp(mode, 'left')
    h = lightangleForCam(ax, h, -30, 30);
  elseif strcmp(mode, 'right')
    h = lightangleForCam(ax, h, 30, 30);
  elseif strcmp(mode, 'angle')
    h = lightangleForCam(ax, h, az, el);
  elseif strcmp(mode, 'headlight')
    pos = ax.CameraPosition;
    if isempty(h)
      h = light(ax, 'Position', pos, 'Style', 'infinite');
    else
      set(h, 'Position', pos, 'Style', 'infinite');
    end
  else
    error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
  end
  if nargout > 0
    varargout{1} = h;
  end
end
%=============================================================================
function [ax, h, mode, az, el] = parseCamlightInputs(args)
  ax = gca();
  h = [];
  mode = 'headlight';
  az = 0;
  el = 0;
  if ~isempty(args) && isscalar(args{1}) && isgraphics(args{1}, 'axes')
    ax = args{1};
    args = args(2:end);
  elseif ~isempty(args) && isscalar(args{1}) && isgraphics(args{1}, 'light')
    h = args{1};
    ax = ancestor(h, 'axes');
    args = args(2:end);
  end
  if ~isempty(args)
    if length(args) == 1 && ischar(args{1})
      mode = lower(args{1});
    elseif length(args) == 2 && isnumeric(args{1}) && isscalar(args{1}) ...
        && isnumeric(args{2}) && isscalar(args{2})
      az = args{1};
      el = args{2};
      mode = 'angle';
    else
      error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
    end
  end
end
%=============================================================================
function h = lightangleForCam(ax, h, az, el)
  if isempty(h)
    h = lightangle(ax, az, el);
  else
    lightangle(h, az, el);
  end
end
