% <--ADV-CLI MODE-->
%=============================================================================
f = figure();
A = [-1.5 -3;
      3 -1];
B = [1.3; 0];
C = [1.15 2.3];
D = 0;

sys = ss(A, B, C, D);
x0 = [-0.2 0.3];
t = 0:0.05:8;
u = zeros(length(t), 1);
u(t >= 2) = 1;
lsim(sys, u, t, x0)
grid on
close(f);
