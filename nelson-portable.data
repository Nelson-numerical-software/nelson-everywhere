% LICENCE_BLOCK_END
%=============================================================================
function bw = ip_regional_minima_2d(values, conn)
  bw = builtin('__ip_regional_minima_2d__', values, conn);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [components, imageSize, intensity, propertyArgs] = ip_regionprops3_components(args)
  input = args{1};
  [components, imageSize] = ip_regionprops3_components_from_input(input);
  intensity = [];
  propertyArgs = args(2:end);
  if numel(args) >= 2 && ip_regionprops3_is_intensity_argument(args{2})
    intensity = args{2};
    ip_regionprops3_validate_intensity(intensity, imageSize);
    propertyArgs = args(3:end);
  end
end
%=============================================================================
function tf = ip_regionprops3_is_intensity_argument(value)
  tf = (isnumeric(value) || islogical(value)) && ~issparse(value) && ~ischar(value) ...
    && ~isStringScalar(value) && length(size(value)) == 3;
end
%=============================================================================
function [components, imageSize] = ip_regionprops3_components_from_input(input)
  if isstruct(input)
    [components, imageSize] = ip_regionprops3_components_from_cc(input);
  elseif islogical(input)
    ip_regionprops3_validate_volume(input, false);
    cc = bwconncomp(input);
    [components, imageSize] = ip_regionprops3_components_from_cc(cc);
  else
    [components, imageSize] = ip_regionprops3_components_from_labels(input);
  end
end
%=============================================================================
function [components, imageSize] = ip_regionprops3_components_from_cc(cc)
  if ~isfield(cc, 'ImageSize') || ~isfield(cc, 'PixelIdxList')
    error('Nelson:image_processing:connectedComponentStructureContainImagesizePixelidxlist', 'Connected-component structure must contain ImageSize and PixelIdxList fields.');
  end
  imageSize = double(cc.ImageSize(:).');
  if numel(imageSize) ~= 3 || any(imageSize <= 0) || any(imageSize ~= floor(imageSize))
    error('Nelson:image_processing:connectedComponentImagesizeDescribeDVolume', 'Connected-component ImageSize must describe a 3-D volume.');
  end
  pixelIdxList = cc.PixelIdxList;
  if ~iscell(pixelIdxList)
    error('Nelson:image_processing:connectedComponentPixelidxlistCellArray', 'Connected-component PixelIdxList must be a cell array.');
  end
  components = cell(1, numel(pixelIdxList));
  maxIndex = prod(imageSize);
  for k = 1:numel(pixelIdxList)
    idx = double(pixelIdxList{k}(:));
    if any(~isfinite(idx)) || any(idx < 1) || any(idx > maxIndex) || any(idx ~= floor(idx))
      error('Nelson:image_processing:connectedComponentPixelIndicesInvalid', 'Connected-component pixel indices are invalid.');
    end
    components{k} = sort(idx);
  end
end
%=============================================================================
function [components, imageSize] = ip_regionprops3_components_from_labels(labels)
  ip_regionprops3_validate_volume(labels, true);
  values = double(labels);
  if any(~isfinite(values(:))) || any(values(:) < 0) || any(values(:) ~= floor(values(:)))
    error('Nelson:image_processing:labelVolumeValuesNonnegativeFiniteIntegers', '%s values must be nonnegative finite integers.', 'Label volume');
  end
  labelValues = unique(values(:));
  labelValues = labelValues(labelValues > 0);
  components = cell(1, numel(labelValues));
  for k = 1:numel(labelValues)
    components{k} = find(values == labelValues(k));
  end
  imageSize = [size(labels, 1), size(labels, 2), size(labels, 3)];
end
%=============================================================================
function ip_regionprops3_validate_volume(value, allowNumeric)
  if ~(islogical(value) || (allowNumeric && isnumeric(value)))
    error('Nelson:validators:mustBeNumericOrLogical', '%s must be numeric or logical.', 'Volume');
  end
  if issparse(value)
    error('Nelson:image_processing:sparseVolumesNotSupported', '%s are not supported.', 'Sparse volumes');
  end
  if ~isreal(value)
    error('Nelson:validators:mustBeReal', '%s must be real.', 'Volume');
  end
  if length(size(value)) ~= 3
    error('Nelson:image_processing:volumeDArray', '%s must be a 3-D array.', 'Volume');
  end
end
%=============================================================================
function ip_regionprops3_validate_intensity(intensity, imageSize)
  ip_regionprops3_validate_volume(intensity, true);
  if ~isequal([size(intensity, 1), size(intensity, 2), size(intensity, 3)], imageSize)
    error('Nelson:image_processing:intensityVolumeSameSizeRegionVolume', '%s must have the same size as %s.', 'Intensity volume', 'the region volume');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function stats = ip_regionprops3_measure(components, imageSize, intensity, properties)
  template = struct();
  for p = 1:numel(properties)
    template.(properties{p}) = [];
  end
  stats = repmat(template, numel(components), 1);
  intensityValues = [];
  if ~isempty(intensity)
    intensityValues = double(intensity);
  end
  for k = 1:numel(components)
    idx = components{k}(:);
    [r, c, z] = ind2sub(imageSize, idx);
    geom = ip_regionprops3_geometry(r, c, z);
    for p = 1:numel(properties)
      prop = properties{p};
      stats(k).(prop) = ip_regionprops3_value(prop, idx, r, c, z, geom, ...
        imageSize, intensityValues);
    end
  end
end
%=============================================================================
function geom = ip_regionprops3_geometry(r, c, z)
  minR = min(r);
  maxR = max(r);
  minC = min(c);
  maxC = max(c);
  minZ = min(z);
  maxZ = max(z);
  geom = struct('MinR', minR, 'MaxR', maxR, 'MinC', minC, 'MaxC', maxC, ...
    'MinZ', minZ, 'MaxZ', maxZ, 'Height', maxR - minR + 1, ...
    'Width', maxC - minC + 1, 'Depth', maxZ - minZ + 1);
end
%=============================================================================
function value = ip_regionprops3_value(prop, idx, r, c, z, geom, imageSize, intensityValues)
  switch prop
    case 'Volume'
      value = numel(idx);
    case 'Centroid'
      value = [mean(c), mean(r), mean(z)];
    case 'BoundingBox'
      value = [geom.MinC - 0.5, geom.MinR - 0.5, geom.MinZ - 0.5, ...
        geom.Width, geom.Height, geom.Depth];
    case 'VoxelIdxList'
      value = idx(:);
    case 'VoxelList'
      value = [c(:), r(:), z(:)];
    case 'Image'
      value = ip_regionprops3_local_image(r, c, z, geom);
    case 'SubarrayIdx'
      value = {geom.MinR:geom.MaxR, geom.MinC:geom.MaxC, geom.MinZ:geom.MaxZ};
    case 'Extent'
      value = numel(idx) / (geom.Width * geom.Height * geom.Depth);
    case 'EquivDiameter'
      value = 2 * ((3 * numel(idx)) / (4 * pi)) ^ (1 / 3);
    case 'MeanIntensity'
      value = mean(intensityValues(idx));
    case 'MinIntensity'
      value = min(intensityValues(idx));
    case 'MaxIntensity'
      value = max(intensityValues(idx));
    case 'VoxelValues'
      value = intensityValues(idx);
      value = value(:);
    case 'WeightedCentroid'
      value = ip_regionprops3_weighted_centroid(r, c, z, intensityValues(idx));
    otherwise
      error('Nelson:image_processing:unsupportedRegionProperty', 'Unsupported "%s" option.', 'region property');
  end
end
%=============================================================================
function image = ip_regionprops3_local_image(r, c, z, geom)
  image = false(geom.Height, geom.Width, geom.Depth);
  local = sub2ind(size(image), r - geom.MinR + 1, c - geom.MinC + 1, z - geom.MinZ + 1);
  image(local) = true;
end
%=============================================================================
function centroid = ip_regionprops3_weighted_centroid(r, c, z, values)
  total = sum(values);
  if total == 0
    centroid = [NaN NaN NaN];
  else
    centroid = [sum(c .* values) / total, sum(r .* values) / total, sum(z .* values) / total];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function tf = ip_regionprops3_needs_intensity(properties)
  needs = {'MeanIntensity', 'MinIntensity', 'MaxIntensity', 'VoxelValues', 'WeightedCentroid'};
  tf = false;
  for k = 1:numel(properties)
    tf = tf || any(strcmp(needs, properties{k}));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function properties = ip_regionprops3_properties(args)
  basic = {'Volume', 'Centroid', 'BoundingBox'};
  allProps = {'Volume', 'Centroid', 'BoundingBox', 'VoxelIdxList', 'VoxelList', 'Image', ...
    'SubarrayIdx', 'Extent', 'EquivDiameter', 'MeanIntensity', 'MinIntensity', ...
    'MaxIntensity', 'VoxelValues', 'WeightedCentroid'};
  if isempty(args)
    properties = basic;
    return
  end
  properties = {};
  for k = 1:numel(args)
    item = args{k};
    if iscell(item)
      for j = 1:numel(item)
        properties = ip_regionprops3_append(properties, item{j}, basic, allProps);
      end
    else
      properties = ip_regionprops3_append(properties, item, basic, allProps);
    end
  end
end
%=============================================================================
function properties = ip_regionprops3_append(properties, value, basic, allProps)
  if ~(ischar(value) || isStringScalar(value))
    error('Nelson:image_processing:unsupportedRegionProperty', 'Unsupported "%s" option.', 'region property');
  end
  name = lower(convertStringsToChars(value));
  if strcmp(name, 'basic')
    properties = ip_regionprops3_append_many(properties, basic);
  elseif strcmp(name, 'all')
    properties = ip_regionprops3_append_many(properties, allProps);
  else
    properties{end + 1} = ip_regionprops3_canonical(name, allProps);
  end
end
%=============================================================================
function properties = ip_regionprops3_append_many(properties, names)
  for k = 1:numel(names)
    if ~any(strcmp(properties, names{k}))
      properties{end + 1} = names{k};
    end
  end
end
%=============================================================================
function prop = ip_regionprops3_canonical(name, allProps)
  aliases = {'VoxelIndices', 'VoxelIdxList'; 'VoxelValues', 'VoxelValues'};
  for k = 1:size(aliases, 1)
    if strcmp(name, lower(aliases{k, 1}))
      prop = aliases{k, 2};
      return
    end
  end
  for k = 1:numel(allProps)
    if strcmp(name, lower(allProps{k}))
      prop = allProps{k};
      return
    end
  end
  error('Nelson:image_processing:unsupportedRegionProperty', 'Unsupported "%s" option.', 'region property');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function name = ip_regionprops_canonical_name(name, supportedProps)
  name = convertStringsToChars(name);
  matches = strcmpi(name, supportedProps);
  if any(matches)
    name = supportedProps{find(matches, 1)};
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function T = ip_registration_affine_matrix(imgSize, angleDegrees, scaleX, scaleY, shear)
  rows = imgSize(1);
  cols = imgSize(2);
  cx = (cols + 1) / 2;
  cy = (rows + 1) / 2;
  theta = angleDegrees * pi / 180;
  c = cos(theta);
  s = sin(theta);
  toOrigin = [1 0 0; 0 1 0; -cx -cy 1];
  fromOrigin = [1 0 0; 0 1 0; cx cy 1];
  affinePart = [scaleX 0 0; shear scaleY 0; 0 0 1] ...
    * [c s 0; -s c 0; 0 0 1];
  T = toOrigin * affinePart * fromOrigin;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [bestT, bestAngle, bestScaleX, bestScaleY, bestShear] = ...
  ip_registration_affine_search(moving, fixed, angles, options, metricType, varargin)
  if nargin == 5
    scalesX = unique([1 - options.ScaleSearch, 1, 1 + options.ScaleSearch]);
    scalesY = scalesX;
    shears = unique([-options.ShearSearch, 0, options.ShearSearch]);
  else
    scalesX = varargin{1};
    scalesY = varargin{2};
    shears = varargin{3};
  end
  bestScore = -Inf;
  bestT = options.InitialTransformation;
  bestAngle = 0;
  bestScaleX = 1;
  bestScaleY = 1;
  bestShear = 0;
  for a = angles
    for sx = scalesX
      for sy = scalesY
        for sh = shears
          [score, candidateT] = ip_score_affine_candidate(...
            moving, fixed, a, sx, sy, sh, metricType, options);
          if score > bestScore
            bestScore = score;
            bestT = candidateT;
            bestAngle = a;
            bestScaleX = sx;
            bestScaleY = sy;
            bestShear = sh;
          end
        end
      end
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
