% LICENCE_BLOCK_END
%=============================================================================
function tuneWeights_rewriteFile(filename, weight)
  pattern = '^[ \t]*%[ \t]*<--WEIGHT[ \t]+[0-9]+-->[ \t]*$';
  replacement = '';
  if weight > 1
    replacement = ['% <--WEIGHT ', int2str(weight), '-->'];
  end
  tuneHeaderTag_rewrite(filename, pattern, replacement); %#ok<NLS0004>
end
