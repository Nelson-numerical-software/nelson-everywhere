% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function ref = ip_resolve_output_ref(outputView, srcRef, tform)
  if ischar(outputView) || isstring(outputView)
    mode = lower(convertStringsToChars(outputView));
    if strcmp(mode, 'same')
      ref = srcRef;
    elseif strcmp(mode, 'full')
      ref = ip_full_output_ref(srcRef, tform);
    else
      error('Nelson:image_processing:unsupportedOutputView', 'Unsupported "%s" option.', 'output view');
    end
  elseif isstruct(outputView)
    ref = ip_validate_imref2d(outputView);
  else
    ref = ip_make_imref2d(outputView, [], []);
  end
end
%=============================================================================
function ref = ip_full_output_ref(srcRef, tform)
  xlim = srcRef.XWorldLimits;
  ylim = srcRef.YWorldLimits;
  dx = srcRef.PixelExtentInWorldX;
  dy = srcRef.PixelExtentInWorldY;
  xCenters = [xlim(1) + dx / 2, xlim(2) - dx / 2];
  yCenters = [ylim(1) + dy / 2, ylim(2) - dy / 2];
  corners = [xCenters(1) yCenters(1) 1; xCenters(2) yCenters(1) 1; ...
    xCenters(1) yCenters(2) 1; xCenters(2) yCenters(2) 1] * tform;
  x = corners(:, 1) ./ corners(:, 3);
  y = corners(:, 2) ./ corners(:, 3);
  xLimits = [min(x) - dx / 2, max(x) + dx / 2];
  yLimits = [min(y) - dy / 2, max(y) + dy / 2];
  imageSize = [max(1, ceil(diff(yLimits) / dy)) max(1, ceil(diff(xLimits) / dx))];
  xLimits(2) = xLimits(1) + imageSize(2) * dx;
  yLimits(2) = yLimits(1) + imageSize(1) * dy;
  ref = ip_make_imref2d(imageSize, xLimits, yLimits);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function ref = ip_resolve_output_ref3d(outputView, srcRef, tform)
  if ischar(outputView) || isStringScalar(outputView)
    mode = lower(convertStringsToChars(outputView));
    if strcmp(mode, 'same')
      ref = srcRef;
    elseif strcmp(mode, 'full')
      ref = ip_full_output_ref3d(srcRef, tform);
    else
      error('Nelson:image_processing:unsupportedOutputView', 'Unsupported "%s" option.', 'output view');
    end
  elseif isstruct(outputView)
    ref = ip_validate_imref3d(outputView);
  else
    ref = ip_make_imref3d(outputView, [], [], []);
  end
end
%=============================================================================
function ref = ip_full_output_ref3d(srcRef, tform)
  dx = srcRef.PixelExtentInWorldX;
  dy = srcRef.PixelExtentInWorldY;
  dz = srcRef.PixelExtentInWorldZ;
  xCenters = [srcRef.XWorldLimits(1) + dx / 2, srcRef.XWorldLimits(2) - dx / 2];
  yCenters = [srcRef.YWorldLimits(1) + dy / 2, srcRef.YWorldLimits(2) - dy / 2];
  zCenters = [srcRef.ZWorldLimits(1) + dz / 2, srcRef.ZWorldLimits(2) - dz / 2];
  [X, Y, Z] = ndgrid(xCenters, yCenters, zCenters);
  corners = [X(:), Y(:), Z(:), ones(numel(X), 1)] * tform;
  xLimits = [min(corners(:, 1)) - dx / 2, max(corners(:, 1)) + dx / 2];
  yLimits = [min(corners(:, 2)) - dy / 2, max(corners(:, 2)) + dy / 2];
  zLimits = [min(corners(:, 3)) - dz / 2, max(corners(:, 3)) + dz / 2];
  imageSize = [max(1, ceil(diff(yLimits) / dy)), max(1, ceil(diff(xLimits) / dx)), ...
    max(1, ceil(diff(zLimits) / dz))];
  xLimits(2) = xLimits(1) + imageSize(2) * dx;
  yLimits(2) = yLimits(1) + imageSize(1) * dy;
  zLimits(2) = zLimits(1) + imageSize(3) * dz;
  ref = ip_make_imref3d(imageSize, xLimits, yLimits, zLimits);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [score, candidateT] = ip_score_affine_candidate(moving, fixed, angle, scaleX, scaleY, shear, metricType, options)
  candidateBase = options.InitialTransformation ...
    * ip_registration_affine_matrix(size(moving), angle, scaleX, scaleY, shear);
  candidateWarped = imwarp(moving, candidateBase, 'Interpolation', options.Interpolation, ...
    'OutputView', [size(fixed, 1), size(fixed, 2)]);
  delta = imregcorr(candidateWarped, fixed);
  candidateT = candidateBase * delta.T;
  score = ip_registration_score(moving, fixed, candidateT, metricType, options.Interpolation);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [dim, ref] = ip_spatial_ref_dimension(ref)
  if ~isstruct(ref) || ~isfield(ref, 'ImageSize') || ~isfield(ref, 'XWorldLimits') ...
      || ~isfield(ref, 'YWorldLimits')
    error('Nelson:image_processing:spatialReferenceContainImagesizeXworldlimitsYworldlimits', 'Spatial reference must contain ImageSize, XWorldLimits and YWorldLimits fields.');
  end
  if isfield(ref, 'ZWorldLimits')
    ref = ip_validate_imref3d(ref);
    dim = 3;
  else
    ref = ip_validate_imref2d(ref);
    dim = 2;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function T = ip_tform_matrix(value)
  if isstruct(value)
    if ~isfield(value, 'T')
      error('Nelson:image_processing:transformationStructureContainTField', 'Transformation structure must contain a T field.');
    end
    value = value.T;
  end
  if ~isnumeric(value) || ~isreal(value)
    error('Nelson:image_processing:transformationMatrixNumericReal', 'Transformation matrix must be numeric and real.');
  end
  T = double(value);
  if size(T, 1) == 2 && size(T, 2) == 3
    T = [T; 0 0 1];
  end
  if ~isequal(size(T), [3 3])
    error('Nelson:image_processing:transformationMatrix', '%s must be %d-by-%d or %d-by-%d.', 'Transformation matrix', 3, 3, 2, 3);
  end
  if any(~isfinite(T(:))) || abs(det(T)) <= eps
    error('Nelson:image_processing:transformationMatrixFiniteNonsingular', 'Transformation matrix must be finite and nonsingular.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function T = ip_tform_matrix3d(value)
  if isstruct(value)
    if ~isfield(value, 'T')
      error('Nelson:image_processing:transformationStructureContainTField', 'Transformation structure must contain a T field.');
    end
    value = value.T;
  end
  if ~isnumeric(value) || ~isreal(value)
    error('Nelson:image_processing:transformationMatrixNumericReal', 'Transformation matrix must be numeric and real.');
  end
  T = double(value);
  if size(T, 1) == 3 && size(T, 2) == 4
    T = [T; 0 0 0 1];
  end
  if ~isequal(size(T), [4 4])
    error('Nelson:image_processing:transformationMatrix', '%s must be %d-by-%d or %d-by-%d.', 'Transformation matrix', 4, 4, 3, 4);
  end
  if any(~isfinite(T(:))) || abs(det(T)) <= eps
    error('Nelson:image_processing:transformationMatrixFiniteNonsingular', 'Transformation matrix must be finite and nonsingular.');
  end
  if any(abs(T(:, 4) - [0; 0; 0; 1]) > sqrt(eps))
    error('Nelson:image_processing:affineTransformationMatrixLastColumn', 'Affine transformation matrix must have [0 0 0 1] as its last column.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [T, dim, isProjective] = ip_tform_points_parse(tform)
  if ~isstruct(tform) || ~isscalar(tform) || ~isfield(tform, 'T') ...
      || ~isfield(tform, 'Dimensionality')
    error('Nelson:image_processing:firstArgumentGeometricTransformationStructure', 'First argument must be a geometric transformation structure.');
  end
  T = tform.T;
  if ~isnumeric(T) || ~isreal(T)
    error('Nelson:image_processing:transformationMatrixNumericReal', 'Transformation matrix must be numeric and real.');
  end
  T = double(T);
  dim = double(tform.Dimensionality);
  if ~isequal(size(T), [dim + 1, dim + 1])
    error('Nelson:image_processing:transformationMatrixSizeNotConsistentDimensionality', 'Transformation matrix size is not consistent with its dimensionality.');
  end
  if any(~isfinite(T(:))) || abs(det(T)) <= eps
    error('Nelson:image_processing:transformationMatrixFiniteNonsingular', 'Transformation matrix must be finite and nonsingular.');
  end
  isProjective = isfield(tform, 'Type') && strcmp(tform.Type, 'projective');
end
