function [TR, fileformat, attributes, solidID] = stlread(filename)
  narginchk(1, 1);
  nargoutchk(0, 4);
  [connectivity, points, fileformat, attributes, solidID] = __stlread__(filename);
  TR = triangulation(connectivity, points);
end
