function options = plan_parsePlanOptions(args)
  options = struct('Workers', maxNumCompThreads(), 'Shuffle', false, 'Seed', 0, ...
    'ShardIndex', 1, 'ShardCount', 1);
  k = 1;
  while k <= length(args)
    if k == length(args)
      error('Nelson:tests_manager:optionValueExpected', 'Option value expected.');
    end
    name = args{k};
    value = args{k + 1};
    if isfield(options, name)
      options.(name) = value;
    else
      error('Nelson:tests_manager:unsupportedOption', 'Unsupported option.');
    end
    k = k + 2;
  end
end
