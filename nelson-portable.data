%=============================================================================
function calibration = tuneReuse_calibrate(targets, runArguments, options)
  runOptions = run_parseRunOptions(runArguments);
  runOptions.Workers = 1;
  runOptions.StopOnFail = false;
  runOptions.Retry = 0;
  runOptions.Shuffle = false;
  runOptions.ShardIndex = 1;
  runOptions.ShardCount = 1;
  sourcePlan = run_ensurePlan(targets, runOptions);
  sourceCases = tuneReuse_uniqueCases(sourcePlan.cases);
  [cases, counts] = tuneReuse_selectCases(sourceCases, options.AllowAdd); %#ok<NLS0024>
  calibration = tuneReuse_emptyCalibration(cases, counts, options);
  if isempty(cases)
    return
  end
  previousForceNative = getenv('NELSON_UNITTEST_FORCE_NATIVE_RUNNER');
  cleanupForceNative = onCleanup(... %#ok<NLS0004>
    @() setenv('NELSON_UNITTEST_FORCE_NATIVE_RUNNER', previousForceNative));
  setenv('NELSON_UNITTEST_FORCE_NATIVE_RUNNER', 'TRUE');
  disp([newline, _('Reuse calibration: isolated baseline.')]);
  baselinePlan = tuneReuse_campaignPlan(sourcePlan, cases, false, 1);
  calibration.baseline = tuneReuse_runCampaign(baselinePlan, runOptions.Timeout);
  for trial = 1:options.Trials
    fprintf('\n%s %d/%d.\n', _('Reuse calibration: trial'), trial, options.Trials);
    trialPlan = tuneReuse_campaignPlan(sourcePlan, cases, true, trial);
    calibration.reuse_trials{trial} = tuneReuse_runCampaign(trialPlan, runOptions.Timeout);
  end
  calibration.duration = tuneReuse_calibrationDuration(calibration);
  clear cleanupForceNative
end
%=============================================================================
function cases = tuneReuse_uniqueCases(sourceCases)
  cases = struct([]);
  filenames = {};
  for k = 1:length(sourceCases)
    filename = sourceCases(k).file;
    if ~any(strcmp(filenames, filename))
      cases = [cases; sourceCases(k)];
      filenames = [filenames; {filename}];
    end
  end
end
%=============================================================================
function [selected, counts] = tuneReuse_selectCases(cases, allowAdd)
  selected = struct([]);
  counts = struct('selected', length(cases), 'eligible', 0, 'excluded', 0, 'deferred', 0);
  for k = 1:length(cases)
    eligible = tuneReuse_isEligible(cases(k));
    tagged = tuneReuse_hasTag(cases(k));
    if ~eligible
      counts.excluded = counts.excluded + 1;
    else
      counts.eligible = counts.eligible + 1;
      if tagged || allowAdd
        selected = [selected; cases(k)];
      else
        counts.deferred = counts.deferred + 1;
      end
    end
  end
end
%=============================================================================
function tf = tuneReuse_isEligible(planCase)
  tagOptions = run_tagOptionsFromPlanCase(planCase);
  tagOptions.reuse_process = true;
  tf = can_pool_test_case_mode(tagOptions) ...
    && can_pool_test_case_resources(tagOptions);
end
%=============================================================================
function tf = tuneReuse_hasTag(planCase)
  tf = tuneReuse_hasValue(planCase, 'tags') ...
    || tuneReuse_hasValue(planCase, 'resources');
end
%=============================================================================
function tf = tuneReuse_hasValue(planCase, field)
  tf = isfield(planCase, field) ...
    && any(strcmp(planCase.(field), 'reuse_process'));
end
%=============================================================================
function calibration = tuneReuse_emptyCalibration(cases, counts, options)
  calibration = struct();
  calibration.type = 'ReuseCalibration';
  calibration.cases = cases;
  calibration.selected = counts.selected;
  calibration.eligible = counts.eligible;
  calibration.excluded = counts.excluded;
  calibration.deferred = counts.deferred;
  calibration.trials = options.Trials;
  calibration.baseline = [];
  calibration.reuse_trials = cell(1, options.Trials);
  calibration.duration = struct('isolated', 0, 'reuse_trials', [], ...
    'reuse_median', 0, 'gain', 0);
end
%=============================================================================
function plan = tuneReuse_campaignPlan(sourcePlan, cases, reuseProcess, trial)
  ordered = tuneReuse_orderCases(cases, trial);
  campaignCases = [ordered; ordered];
  for k = 1:length(campaignCases)
    campaignCases(k) = tuneReuse_setTag(campaignCases(k), reuseProcess);
    campaignCases(k).id = createGUID();
  end
  plan = sourcePlan;
  plan.cases = campaignCases;
  plan.workers = 1;
  plan.shard = [1, 1];
  plan.groups = plan_groupCases(campaignCases);
  plan.filtered = 0;
end
%=============================================================================
function ordered = tuneReuse_orderCases(cases, trial)
  nbCases = length(cases);
  indices = 1:nbCases;
  if trial == 2
    indices = nbCases:-1:1;
  elseif trial > 2 && nbCases > 1
    shift = mod(trial - 2, nbCases);
    indices = [shift + 1:nbCases, 1:shift];
  end
  ordered = cases(indices);
end
%=============================================================================
function planCase = tuneReuse_setTag(planCase, enabled)
  planCase.tags = tuneReuse_withoutTag(planCase.tags);
  planCase.resources = tuneReuse_withoutTag(planCase.resources);
  if enabled
    planCase.tags = [planCase.tags(:); {'reuse_process'}];
  end
end
%=============================================================================
function values = tuneReuse_withoutTag(values)
  values = values(:);
  values(strcmp(values, 'reuse_process')) = [];
end
%=============================================================================
function results = tuneReuse_runCampaign(plan, timeoutValue)
  runArgs = {'StopOnFail', false, 'Retry', 0, 'Timeout', timeoutValue};
  results = nelson.unittest.run(plan, runArgs{:});
end
%=============================================================================
function duration = tuneReuse_calibrationDuration(calibration)
  isolated = calibration.baseline.summary.duration;
  reuseDurations = zeros(1, length(calibration.reuse_trials));
  for k = 1:length(calibration.reuse_trials)
    reuseDurations(k) = calibration.reuse_trials{k}.summary.duration;
  end
  reuseMedian = median(reuseDurations);
  gain = tuneReuse_gain(isolated, reuseMedian);
  duration = struct('isolated', isolated, 'reuse_trials', reuseDurations, ...
    'reuse_median', reuseMedian, 'gain', gain);
end
%=============================================================================
function gain = tuneReuse_gain(isolated, reused)
  gain = 0;
  if isolated > 0
    gain = (isolated - reused) / isolated;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function evidence = tuneReuse_caseEvidence(results, filename, kind, expected, requireReuse)
  selected = tuneReuse_resultCases(results, filename);
  durations = [];
  ok = length(selected) == expected;
  for k = 1:length(selected)
    testCase = selected(k);
    ok = ok && tuneReuse_successfulOutcome(testCase.outcome, kind);
    if requireReuse
      ok = ok && tuneReuse_cleanWorkerResult(testCase);
    end
    if testCase.duration >= 0
      durations = [durations, testCase.duration];
    end
  end
  duration = 0;
  if ~isempty(durations)
    duration = median(durations);
  end
  evidence = struct('ok', logical(ok), 'runs', length(selected), ...
    'duration', duration);
end
%=============================================================================
function selected = tuneReuse_resultCases(results, filename)
  selected = struct([]);
  if ~isstruct(results) || ~isfield(results, 'cases')
    return
  end
  for k = 1:length(results.cases)
    if strcmp(results.cases(k).file, filename)
      selected = [selected; results.cases(k)];
    end
  end
end
%=============================================================================
function tf = tuneReuse_successfulOutcome(outcome, kind)
  if strcmp(kind, 'bench')
    tf = strcmp(outcome, 'bench');
  else
    tf = strcmp(outcome, 'passed');
  end
end
%=============================================================================
function tf = tuneReuse_cleanWorkerResult(testCase)
  tf = false;
  if ~isfield(testCase, 'diagnostics') ...
    || ~isfield(testCase.diagnostics, 'worker_pool')
    return
  end
  worker = testCase.diagnostics.worker_pool;
  required = {'used', 'fallback', 'missing_result'};
  if ~all(isfield(worker, required))
    return
  end
  tf = worker.used && ~worker.fallback && ~worker.missing_result;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function tuneReuse_display(report)
  disp(_('Process-reuse proposal:'));
  displayed = 0;
  for k = 1:length(report.cases)
    testCase = report.cases(k);
    if strcmp(testCase.action, 'unchanged') && strcmp(testCase.reason, 'certified')
      continue
    end
    label = testCase.name;
    if ~isempty(testCase.module)
      label = [testCase.module, '/', label];
    end
    fprintf('  %-44s [%7.2f%%] %-9s %s\n', label, ...
      testCase.gain * 100, testCase.action, testCase.reason);
    displayed = displayed + 1;
  end
  if displayed == 0
    disp(['  ', _('No process-reuse change proposed.')]);
  end
  summary = report.summary;
  fprintf(_('Selected: %d, eligible: %d, calibrated: %d, excluded: %d, deferred: %d.\n'), ...
    summary.selected, summary.eligible, summary.calibrated, ...
    summary.excluded, summary.deferred);
  fprintf(_('Add: %d, remove: %d, unchanged: %d, written: %d.\n'), ...
    summary.added, summary.removed, summary.unchanged, summary.written);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [options, runArguments] = tuneReuse_parseOptions(args)
  options = struct('Apply', false, 'AllowAdd', false, 'Trials', 3, 'MinGain', 0.1);
  runArguments = {};
  allowedRunOptions = {'Name', 'Module', 'File', 'Kind', 'Tags', ...
    'ExcludeTags', 'Match', 'Exclude', 'Timeout'};
  if mod(length(args), 2) ~= 0
    error('Nelson:tests_manager:optionValueExpected', 'Option value expected.');
  end
  for k = 1:2:length(args)
    name = args{k};
    value = args{k + 1};
    if isfield(options, name)
      options.(name) = value;
    elseif any(strcmp(allowedRunOptions, name))
      runArguments = [runArguments, {name, value}];
    else
      error('Nelson:tests_manager:unsupportedOption', 'Unsupported option.');
    end
  end
  tuneReuse_validateLogical(options.Apply, 'Apply');
  tuneReuse_validateLogical(options.AllowAdd, 'AllowAdd');
  tuneReuse_validateTrials(options.Trials);
  tuneReuse_validateMinGain(options.MinGain);
  options.Trials = double(options.Trials);
  options.MinGain = double(options.MinGain);
end
%=============================================================================
function tuneReuse_validateLogical(value, name)
  if ~(islogical(value) && isscalar(value))
    error('Nelson:validators:mustBeLogicalScalar', '%s must be a logical scalar.', name);
  end
end
%=============================================================================
function tuneReuse_validateTrials(value)
  if ~(isnumeric(value) && isscalar(value) && isfinite(value) ...
    && value >= 1 && fix(value) == value)
    error('Nelson:tests_manager:invalidTrials', 'Trials must be a positive integer.');
  end
end
%=============================================================================
function tuneReuse_validateMinGain(value)
  if ~(isnumeric(value) && isscalar(value) && isfinite(value) ...
    && value >= -1 && value <= 1)
    error('Nelson:tests_manager:invalidMinGain', 'MinGain must be between -1 and 1.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function tuneReuse_rewriteFile(filename, enabled)
  pattern = '^[ \t]*%[ \t]*<--REUSE[ \t]+PROCESS-->[ \t]*$';
  replacement = '';
  if enabled
    replacement = '% <--REUSE PROCESS-->';
  end
  tuneHeaderTag_rewrite(filename, pattern, replacement); %#ok<NLS0004>
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function report = tuneWeights_buildReport(results, options)
  measuredCases = tuneWeights_resultCases(results); %#ok<NLS0004>
  reportCases = struct([]);
  for k = 1:length(measuredCases)
    testCase = measuredCases(k);
    reference = tuneWeights_referenceDuration(measuredCases, testCase);
    proposed = tuneWeights_quantize(testCase.duration, reference, options.MaxWeight);
    state = tuneWeights_fileState(testCase.file); %#ok<NLS0004>
    action = tuneWeights_action(state.has_tag, state.weight, proposed);
    item = struct('file', testCase.file, 'name', testCase.name, ...
      'module', testCase.module, 'kind', testCase.kind, 'mode', testCase.mode, ...
      'duration', testCase.duration, 'reference_duration', reference, ...
      'old_weight', state.weight, 'new_weight', proposed, ...
      'action', action, 'applied', false);
    reportCases = [reportCases; item];
  end
  if options.Apply
    for k = 1:length(reportCases)
      if ~strcmp(reportCases(k).action, 'unchanged')
        tuneWeights_rewriteFile(reportCases(k).file, reportCases(k).new_weight); %#ok<NLS0004>
        reportCases(k).applied = true;
      end
    end
  end
  report = struct();
  report.type = 'WeightTuningResult';
  report.applied = logical(options.Apply);
  report.max_weight = options.MaxWeight;
  report.strategy = 'median-relative-powers-of-two';
  report.cases = reportCases;
  report.summary = tuneWeights_reportSummary(reportCases);
end
%=============================================================================
function reference = tuneWeights_referenceDuration(cases, selected)
  durations = [];
  selectedBench = strcmp(selected.kind, 'bench');
  for k = 1:length(cases)
    sameCategory = strcmp(cases(k).kind, 'bench') == selectedBench;
    if strcmp(cases(k).module, selected.module) && sameCategory && cases(k).duration > 0
      durations = [durations, cases(k).duration];
    end
  end
  if isempty(durations)
    reference = 1;
  else
    reference = max(0.001, median(durations));
  end
end
%=============================================================================
function weight = tuneWeights_quantize(duration, reference, maxWeight)
  weight = 1;
  ratio = duration / reference;
  threshold = sqrt(2);
  while weight < maxWeight && ratio > weight * threshold
    weight = min(maxWeight, weight * 2);
  end
end
%=============================================================================
function action = tuneWeights_action(hasTag, oldWeight, newWeight)
  if ~hasTag && newWeight == 1
    action = 'unchanged';
  elseif ~hasTag
    action = 'add';
  elseif newWeight == 1
    action = 'remove';
  elseif oldWeight ~= newWeight
    action = 'update';
  else
    action = 'unchanged';
  end
end
%=============================================================================
function summary = tuneWeights_reportSummary(cases)
  summary = struct('eligible', length(cases), 'added', 0, 'updated', 0, ...
    'removed', 0, 'unchanged', 0, 'written', 0);
  for k = 1:length(cases)
    field = tuneWeights_summaryField(cases(k).action);
    summary.(field) = summary.(field) + 1;
    if cases(k).applied
      summary.written = summary.written + 1;
    end
  end
end
%=============================================================================
function field = tuneWeights_summaryField(action)
  field = [action, 'd'];
  if strcmp(action, 'add')
    field = 'added';
  elseif strcmp(action, 'remove')
    field = 'removed';
  elseif strcmp(action, 'unchanged')
    field = 'unchanged';
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function tuneWeights_display(report)
  disp(_('Test weight proposal:'));
  displayed = 0;
  for k = 1:length(report.cases)
    testCase = report.cases(k);
    if strcmp(testCase.action, 'unchanged')
      continue
    end
    label = testCase.name;
    if ~isempty(testCase.module)
      label = [testCase.module, '/', label];
    end
    fprintf('  %-48s [%8.3fs] %4d -> %-4d %s\n', label, testCase.duration, ...
      testCase.old_weight, testCase.new_weight, testCase.action);
    displayed = displayed + 1;
  end
  if displayed == 0
    disp(['  ', _('No weight change proposed.')]);
  end
  summary = report.summary;
  fprintf(_('Eligible: %d, add: %d, update: %d, remove: %d, unchanged: %d, written: %d.\n'), ...
    summary.eligible, summary.added, summary.updated, summary.removed, ...
    summary.unchanged, summary.written);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function state = tuneWeights_fileState(filename)
  if ~isfile(filename)
    error('Nelson:tests_manager:fileDoesNotExist', 'An existing filename expected.');
  end
  options = parsetags(filename); %#ok<NLS0004>
  lines = tuneWeights_sourceLines(fileread(filename));
  state = struct('has_tag', tuneWeights_tagIndex(lines) > 0, ...
    'weight', double(options.weight));
end
%=============================================================================
function lines = tuneWeights_sourceLines(content)
  sourceText = replace(content, char([13 10]), char(10));
  sourceText = replace(sourceText, char(13), char(10));
  lines = strsplit(sourceText, char(10), 'CollapseDelimiters', false);
end
%=============================================================================
function index = tuneWeights_tagIndex(lines)
  index = 0;
  pattern = '^[ \t]*%[ \t]*<--WEIGHT[ \t]+[0-9]+-->[ \t]*$';
  for k = 1:length(lines)
    line = strtrim(lines{k});
    if ~isempty(line) && ~startsWith(line, '%')
      return
    end
    if ~isempty(regexp(lines{k}, pattern, 'once'))
      index = k;
      return
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function tf = tuneWeights_isResult(value)
  tf = isstruct(value) && isfield(value, 'type') && strcmp(value.type, 'TestRunResult');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function [options, runArguments] = tuneWeights_parseOptions(args)
  options = struct('Apply', false, 'MaxWeight', 64);
  runArguments = {};
  if mod(length(args), 2) ~= 0
    error('Nelson:tests_manager:optionValueExpected', 'Option value expected.');
  end
  for k = 1:2:length(args)
    name = args{k};
    value = args{k + 1};
    if isfield(options, name)
      options.(name) = value;
    else
      runArguments = [runArguments, {name, value}];
    end
  end
  tuneWeights_validateApply(options.Apply);
  tuneWeights_validateMaxWeight(options.MaxWeight);
  options.MaxWeight = double(options.MaxWeight);
end
%=============================================================================
function tuneWeights_validateApply(value)
  if ~(islogical(value) && isscalar(value))
    error('Nelson:tests_manager:invalidApply', 'Apply must be a logical scalar.');
  end
end
%=============================================================================
function tuneWeights_validateMaxWeight(value)
  if ~(isnumeric(value) && isscalar(value) && isfinite(value) ...
    && value >= 1 && fix(value) == value)
    error('Nelson:tests_manager:invalidMaxWeight', 'MaxWeight must be a positive integer.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function cases = tuneWeights_resultCases(results)
  if ~tuneWeights_isResult(results) || ~isfield(results, 'cases') %#ok<NLS0004>
    error('Nelson:tests_manager:testRunResultExpected', 'TestRunResult expected.');
  end
  normalized = results.cases;
  raw = run_resultCases(results); %#ok<NLS0004>
  planCases = struct([]);
  if isfield(results, 'plan') && isfield(results.plan, 'cases')
    planCases = results.plan.cases;
  end
  cases = struct([]);
  for k = 1:length(normalized)
    item = tuneWeights_measuredCase(normalized(k), raw, planCases, k);
    if isempty(item)
      continue
    end
    cases = tuneWeights_mergeMeasuredCase(cases, item);
  end
end
%=============================================================================
function item = tuneWeights_measuredCase(testCase, raw, planCases, index)
  item = struct([]);
  if ~tuneWeights_isMeasuredOutcome(testCase)
    return
  end
  candidate = tuneWeights_caseMetadata(testCase, raw, planCases, index);
  if isempty(candidate.file) || ~isfile(candidate.file)
    return
  end
  item = candidate;
end
%=============================================================================
function cases = tuneWeights_mergeMeasuredCase(cases, item)
  duplicate = tuneWeights_findFile(cases, item.file);
  if duplicate == 0
    cases = [cases; item];
  elseif item.duration > cases(duplicate).duration
    cases(duplicate) = item;
  end
end
%=============================================================================
function tf = tuneWeights_isMeasuredOutcome(testCase)
  tf = isfield(testCase, 'outcome') ...
    && (strcmp(testCase.outcome, 'passed') || strcmp(testCase.outcome, 'bench')) ...
    && isfield(testCase, 'duration') && isnumeric(testCase.duration) ...
    && isscalar(testCase.duration) && isfinite(testCase.duration) ...
    && testCase.duration >= 0;
end
%=============================================================================
function item = tuneWeights_caseMetadata(testCase, raw, planCases, index)
  rawCase = struct();
  planCase = struct();
  if index <= length(raw)
    rawCase = raw(index);
  end
  if index <= length(planCases)
    planCase = planCases(index);
  end
  file = tuneWeights_firstField(testCase, rawCase, planCase, {'file', 'filename'}, '');
  name = tuneWeights_firstField(testCase, rawCase, planCase, {'name', 'id'}, '');
  if isempty(name) && ~isempty(file)
    [~, name, ~] = fileparts(file); %#ok<NLS0004>
  end
  moduleName = tuneWeights_firstField(testCase, rawCase, planCase, {'module'}, '');
  if isempty(moduleName)
    moduleName = discover_moduleNameFromFile(file); %#ok<NLS0004>
  end
  kind = tuneWeights_firstField(testCase, rawCase, planCase, {'kind'}, '');
  if isempty(kind)
    kind = discover_caseKind(name); %#ok<NLS0004>
  end
  mode = tuneWeights_firstField(testCase, rawCase, planCase, {'mode'}, 'cli');
  item = struct('file', file, 'name', name, 'module', moduleName, 'kind', kind, ...
    'mode', mode, 'duration', double(testCase.duration));
end
%=============================================================================
function value = tuneWeights_firstField(first, second, third, names, defaultValue)
  value = tuneWeights_structField(first, names);
  if isempty(value)
    value = tuneWeights_structField(second, names);
  end
  if isempty(value)
    value = tuneWeights_structField(third, names);
  end
  if isempty(value)
    value = defaultValue;
  end
end
%=============================================================================
function value = tuneWeights_structField(source, names)
  value = [];
  for n = 1:length(names)
    if isfield(source, names{n}) && ~isempty(source.(names{n}))
      value = source.(names{n});
      return
    end
  end
end
%=============================================================================
function index = tuneWeights_findFile(cases, filename)
  index = 0;
  for k = 1:length(cases)
    if strcmp(cases(k).file, filename)
      index = k;
      return
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function tuneWeights_rewriteFile(filename, weight)
  pattern = '^[ \t]*%[ \t]*<--WEIGHT[ \t]+[0-9]+-->[ \t]*$';
  replacement = '';
  if weight > 1
    replacement = ['% <--WEIGHT ', int2str(weight), '-->'];
  end
  tuneHeaderTag_rewrite(filename, pattern, replacement); %#ok<NLS0004>
end
