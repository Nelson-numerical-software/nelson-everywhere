% <--WEIGHT 2-->
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('unifit'), 2);
asserts.isequal(nargout('unifit'), 4);
%=============================================================================
[aHat, bHat] = unifit([2 5 3 4]);
asserts.isequal(aHat, 2);
asserts.isequal(bHat, 5);
%=============================================================================
[aHat, bHat, aCI, bCI] = unifit([2; 5; 3; 4]);
asserts.isequal(aHat, 2);
asserts.isequal(bHat, 5);
asserts.isapprox(aCI, [-1.3442275806433845; 2], 1e-14);
asserts.isapprox(bCI, [5; 8.3442275806433845], 1e-14);
%=============================================================================
[aHat, bHat, aCI, bCI] = unifit([2 5 3 4], 0.01);
asserts.isequal(aHat, 2);
asserts.isequal(bHat, 5);
asserts.isapprox(aCI, [-4.486832980505138; 2], 1e-14);
asserts.isapprox(bCI, [5; 11.486832980505138], 1e-14);
%=============================================================================
[aHat, bHat, aCI, bCI] = unifit([1 2; 3 4; 4 9]);
asserts.isequal(aHat, [1 2]);
asserts.isequal(bHat, [4 9]);
asserts.isapprox(aCI, [-4.143252849784719 -10.000923316164345; 1 2], 1e-14);
asserts.isapprox(bCI, [4 9; 9.143252849784719 21.000923316164345], 1e-14);
%=============================================================================
[aHat, bHat, aCI, bCI] = unifit([2 5 3 4], []);
asserts.isequal(aHat, 2);
asserts.isequal(bHat, 5);
asserts.isapprox(aCI, [-1.3442275806433845; 2], 1e-14);
asserts.isapprox(bCI, [5; 8.3442275806433845], 1e-14);
%=============================================================================
[aHat, bHat, aCI, bCI] = unifit([2 5 3 4], 1);
asserts.isequal(aHat, 2);
asserts.isequal(bHat, 5);
asserts.isequal(aCI, [2; 2]);
asserts.isequal(bCI, [5; 5]);
%=============================================================================
[aHat, bHat, aCI, bCI] = unifit([2 5 3 4], 0);
asserts.isequal(aHat, 2);
asserts.isequal(bHat, 5);
asserts.istrue(isinf(aCI(1)) && aCI(1) < 0);
asserts.isequal(aCI(2), 2);
asserts.isequal(bCI(1), 5);
asserts.istrue(isinf(bCI(2)) && bCI(2) > 0);
%=============================================================================
[aHat, bHat] = unifit(single([2 5 3 4]));
asserts.isequal(class(aHat), 'double');
asserts.isequal(class(bHat), 'double');
asserts.isequal(aHat, 2);
asserts.isequal(bHat, 5);
%=============================================================================
[aHat, bHat, aCI, bCI] = unifit([1 NaN 3]);
asserts.istrue(isnan(aHat));
asserts.istrue(isnan(bHat));
asserts.istrue(all(isnan(aCI)));
asserts.istrue(all(isnan(bCI)));
%=============================================================================
asserts.checkerror('unifit()', _('Not enough input arguments.'));
asserts.checkerror('unifit([], 0.05)', _('X must be a nonempty vector or matrix.'));
asserts.checkerror('unifit(ones(1, 1, 2))', _('X must be a nonempty vector or matrix.'));
asserts.checkerror('unifit({1 2 3})', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('unifit([1 2 3], {0.05})', sprintf(_('%s must be numeric.'), 'ALPHA'));
asserts.checkerror('unifit([1 2 3], -0.1)', sprintf(_('%s must be a scalar in the range [0,1].'), 'ALPHA'));
asserts.checkerror('unifit([1 2 3], 1.1)', sprintf(_('%s must be a scalar in the range [0,1].'), 'ALPHA'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--WEIGHT 2-->
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('uniflike'), 4);
asserts.isequal(nargout('uniflike'), 2);
%=============================================================================
x = [2 5 3 4];
[NLOGL, AVAR] = uniflike([1 6], x);
asserts.isapprox(NLOGL, 6.437751649736401, 1e-12);
asserts.istrue(all(isnan(AVAR(:))));
%=============================================================================
[NLOGL, AVAR] = uniflike(single([1 6]), single([2 3 4]));
asserts.isequal(class(NLOGL), 'double');
asserts.isequal(class(AVAR), 'double');
asserts.isapprox(NLOGL, 4.828313737302301, 1e-12);
asserts.istrue(all(isnan(AVAR(:))));
%=============================================================================
censor = [0 0 1 0];
freq = [1 2 1 1];
[NLOGL, AVAR] = uniflike([1 6], x, censor, freq);
asserts.isapprox(NLOGL, 6.948577273502392, 1e-12);
asserts.istrue(all(isnan(AVAR(:))));
%=============================================================================
[NLOGL, AVAR] = uniflike([2 5], x);
asserts.isapprox(NLOGL, 4.394449154672439, 1e-12);
asserts.istrue(all(isnan(AVAR(:))));
[NLOGL, AVAR] = uniflike([3 5], x);
asserts.istrue(isinf(NLOGL));
asserts.istrue(all(isnan(AVAR(:))));
[NLOGL, AVAR] = uniflike([1 1], x);
asserts.istrue(isinf(NLOGL));
asserts.istrue(all(isnan(AVAR(:))));
[NLOGL, AVAR] = uniflike([NaN 6], x);
asserts.istrue(isnan(NLOGL));
asserts.istrue(all(isnan(AVAR(:))));
[NLOGL, AVAR] = uniflike([1 6], [1 NaN 2]);
asserts.istrue(isnan(NLOGL));
asserts.istrue(all(isnan(AVAR(:))));
%=============================================================================
asserts.checkerror('uniflike([1 2])', _('Not enough input arguments.'));
asserts.checkerror('uniflike({1 2}, [1 2 3])', sprintf(_('%s must be real numeric.'), 'PARAMS'));
asserts.checkerror('uniflike([1 2 3], [1 2 3])', sprintf(_('PARAMS must be a %s vector.'), 'two-element'));
asserts.checkerror('uniflike([1 2], {1 2 3})', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('uniflike([1 2], [])', sprintf(_('%s must be nonempty.'), 'X'));
asserts.checkerror('uniflike([1 2], [1 2 3], [0 2 0])', _('CENSORING must contain 0 or 1 values.'));
asserts.checkerror('uniflike([1 2], [1 2 3], [], [1 -1 1])', sprintf(_('%s must contain nonnegative finite values.'), 'FREQ'));
asserts.checkerror('uniflike([1 2], [1 2 3], ones(2, 2))', _('Size mismatch on input arguments'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('unifpdf'), 3);
asserts.isequal(nargout('unifpdf'), 1);
%=============================================================================
x = [0 0.25 0.5 0.75 1];
R = unifpdf(x);
asserts.isequal(R, ones(size(x)));
%=============================================================================
x = 0.2:0.2:1;
R = unifpdf(x);
asserts.isequal(R, [1 1 1 1 1]);
R = unifpdf(1:5, 2, 4);
asserts.isequal(R, [0 0.5 0.5 0.5 0]);
R = unifpdf(5, 10, 1);
asserts.istrue(isnan(R));
%=============================================================================
x = [-2 -1 0 1 2 3];
R = unifpdf(x, -1, 3);
asserts.isequal(R, [0 0.25 0.25 0.25 0.25 0.25]);
%=============================================================================
R = unifpdf([-2 0 3], [-1 -1 1], [1 1 3]);
asserts.isequal(R, [0 0.5 0.5]);
%=============================================================================
R = unifpdf(single([0 0.5 1]), single(0), single(2));
asserts.isequal(class(R), 'single');
asserts.isequal(R, single([0.5 0.5 0.5]));
%=============================================================================
R = unifpdf([0 NaN 1 1], [0 0 2 1], [1 1 1 NaN]);
asserts.isequal(R(1), 1);
asserts.istrue(all(isnan(R(2:4))));
%=============================================================================
R = unifpdf([], [], []);
asserts.isequal(size(R), [0 0]);
%=============================================================================
asserts.checkerror('unifpdf(ones(2), ones(3), 1)', _('Size mismatch on input arguments'));
asserts.checkerror('unifpdf(1, 0)', _('Not enough input arguments.'));
asserts.checkerror('unifpdf({1}, 0, 1)', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('unifpdf(1, {0}, 1)', sprintf(_('%s must be real numeric.'), 'A'));
asserts.checkerror('unifpdf(1, 0, {1})', sprintf(_('%s must be real numeric.'), 'B'));
%=============================================================================
asserts.isequal(unifpdf(0.5, 0, 2), 0.5);
asserts.istrue(isnan(unifpdf(1, 2, 1)));
asserts.checkerror('unifpdf(1, ''a'', 2)', sprintf(_('%s must be real numeric.'), 'A'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--WEIGHT 2-->
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('unifrnd'), -1);
asserts.isequal(nargout('unifrnd'), 1);
%=============================================================================
rng(0);
U = rand(1, 1);
E = U;
rng(0);
R = unifrnd(0, 1);
asserts.isequal(R, E);
asserts.istrue(R >= 0 && R < 1);
%=============================================================================
rng(0);
U = rand(1, 5);
E = (1:5) .* U;
rng(0);
R = unifrnd(0, 1:5);
asserts.isequal(R, E);
asserts.isequal(size(R), [1 5]);
%=============================================================================
rng(0);
U = rand(2, 3);
E = -1 + 2 .* U;
rng(0);
R = unifrnd(-1, 1, [2 3]);
asserts.isequal(R, E);
asserts.isequal(size(R), [2 3]);
asserts.istrue(all(R(:) >= -1 & R(:) < 1));
%=============================================================================
rng(0);
U = rand(1, 6);
E = (0:5) + U;
rng(0);
R = unifrnd(0:5, 1:6, 1, 6);
asserts.isequal(R, E);
%=============================================================================
rng(0);
U = rand(2, 3, 'single');
E = single(2) .* U;
rng(0);
R = unifrnd(single(0), single(2), [2 3]);
asserts.isequal(class(R), 'single');
asserts.isequal(R, E);
%=============================================================================
R = unifrnd([0 1 NaN], [1 1 2]);
asserts.istrue(R(1) >= 0 && R(1) < 1);
asserts.istrue(all(isnan(R(2:3))));
%=============================================================================
R = unifrnd(0, 1, 0, 3);
asserts.isequal(size(R), [0 3]);
R = unifrnd(single(0), single(1), [2 0 3]);
asserts.isequal(class(R), 'single');
asserts.isequal(size(R), [2 0 3]);
R = unifrnd(0, 1, -1, 3);
asserts.isequal(size(R), [0 3]);
%=============================================================================
asserts.checkerror('unifrnd(0)', _('Not enough input arguments.'));
asserts.checkerror('unifrnd([0 1], 2, 2, 2)', _('Size mismatch on input arguments'));
asserts.checkerror('unifrnd(0, 1, 1.5, 2)', _('Size must contain integer values.'));
asserts.checkerror('unifrnd(0, 1, Inf, 2)', _('Size must contain integer values.'));
asserts.checkerror('unifrnd({0}, 1)', sprintf(_('%s must be real numeric.'), 'A'));
asserts.checkerror('unifrnd(0, {1})', sprintf(_('%s must be real numeric.'), 'B'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('unifstat'), 2);
asserts.isequal(nargout('unifstat'), 2);
%=============================================================================
[m, v] = unifstat(0, 1);
asserts.isequal(m, 0.5);
asserts.isequal(v, 1 / 12);
%=============================================================================
a = 1:6;
b = 2 * a;
[m, v] = unifstat(a, b);
asserts.isequal(m, [1.5 3 4.5 6 7.5 9]);
asserts.isequal(v, [1 4 9 16 25 36] / 12);
%=============================================================================
[m, v] = unifstat([1 2 3], [3 2 1]);
asserts.isequal(m(1), 2);
asserts.isequal(v(1), 1 / 3);
asserts.istrue(all(isnan(m(2:3))));
asserts.istrue(all(isnan(v(2:3))));
%=============================================================================
[m, v] = unifstat(single([0 1]), single([2 5]));
asserts.isequal(class(m), 'single');
asserts.isequal(class(v), 'single');
asserts.isequal(m, single([1 3]));
asserts.isequal(v, single([1 / 3 4 / 3]));
%=============================================================================
m = unifstat(0, [1 2 3]);
asserts.isequal(m, [0.5 1 1.5]);
%=============================================================================
[m, v] = unifstat([], []);
asserts.isequal(size(m), [0 0]);
asserts.isequal(size(v), [0 0]);
%=============================================================================
asserts.checkerror('unifstat(0)', _('Not enough input arguments.'));
asserts.checkerror('unifstat(0, 1, 2)', _('Too many input arguments.'));
asserts.checkerror('unifstat(ones(2), ones(3))', _('Size mismatch on input arguments'));
asserts.checkerror('unifstat({0}, 1)', sprintf(_('%s must be real numeric.'), 'A'));
asserts.checkerror('unifstat(0, {1})', sprintf(_('%s must be real numeric.'), 'B'));
%=============================================================================
[unifMean, unifVariance] = unifstat(0, 2);
asserts.isequal(unifMean, 1);
asserts.isapprox(unifVariance, 1 / 3, 1e-12);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('var'), 4);
asserts.isequal(nargout('var'), 2);
%=============================================================================
R = var([1, 2, 3], 0, 1);
REF = [0 0 0];
asserts.isequal(R, REF);
%=============================================================================
A = [4 -7 3; 1 4 -2; 10 7 9];
R = var(A);
REF = [21.0000 54.3333 30.3333];
asserts.isapprox(R, REF, 1e-4);
%=============================================================================
A = [4 -2 1; 9 5 7];
R = var(A, 0, 1);
REF = [12.5000 24.5000 18.0000];
asserts.isapprox(R, REF, 1e-4);
%=============================================================================
A = [4 -2 1; 9 5 7];
R = var(A, 0, 2);
REF = [9; 4];
asserts.isapprox(R, REF, 1e-4);
%=============================================================================
asserts.checkerror('var()', _('Not enough input arguments.'))
%=============================================================================
asserts.isequal(var(36), 0);
%=============================================================================
asserts.isequal(var([1 2 3]), 1);
%=============================================================================
% 'all' option
assert_isequal(var([1 2 3; 4 5 6], 0, 'all'), 3.5);
assert_isapprox(var([1 2 3; 4 5 6], 1, 'all'), 35 / 12, 1e-10);
assert_isapprox(var([1 NaN; 3 4], 0, 'all', 'omitnan'), 7 / 3, 1e-10);
%=============================================================================
% var of a matrix with no rows must not crash and returns NaN per column
assert_isequal(var(zeros(0, 3)), [NaN NaN NaN]);
assert_isequal(size(var(zeros(0, 3))), [1 3]);
R = var(single(zeros(0, 2)));
assert_isequal(class(R), 'single');
assert_isequal(R, single([NaN NaN]));
assert_isequal(std(zeros(0, 3)), [NaN NaN NaN]);
%=============================================================================
% vector of dimensions (vecdim)
A = reshape(1:24, [2 3 4]);
assert_isequal(size(var(A, 0, [1 2])), [1 1 4]);
assert_isapprox(var(A, 0, [1 2]), reshape([3.5 3.5 3.5 3.5], [1 1 4]), 1e-10);
assert_isequal(size(var(A, 0, [1 3])), [1 3]);
assert_isapprox(var(A, 0, [1 3]), [362 / 7 362 / 7 362 / 7], 1e-10);
assert_isequal(size(var(A, 0, [2 3])), [2 1]);
assert_isapprox(var(A, 0, [2 3]), [52; 52], 1e-10);
assert_isapprox(var(A, 1, [1 2]), reshape([35 / 12 35 / 12 35 / 12 35 / 12], [1 1 4]), 1e-10);
assert_isapprox(var(A, 0, [1 2 3]), 50, 1e-10);
assert_isequal(var(A, 0, [1 2 3]), var(A, 0, 'all'));
% omitnan combined with a vector of dimensions
C = [1 NaN; 3 4];
assert_isapprox(var(C, 0, [1 2], 'omitnan'), 7 / 3, 1e-10);
% a vector that lists a single effective dimension behaves like a scalar dim
assert_isequal(var(A, 0, [2]), var(A, 0, 2));
% a weight vector cannot be combined with a vector of dimensions
asserts.checkerror('var(reshape(1:24, [2 3 4]), [1 1], [1 2])', _('A weight vector is not supported with a vector of dimensions.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% variance of complex data uses |z - mean|^2: result is real and >= 0
asserts.isapprox(var([1i 2i 3i]), 1, 1e-12);
asserts.isapprox(var([1 + 1i 2 + 2i 3 + 3i]), 2, 1e-12);
asserts.isapprox(std([1i 2i 3i]), 1, 1e-12);
asserts.isapprox(cov([1i; 2i; 3i]), 1, 1e-12);
asserts.isapprox(cov([1 + 1i 2 + 2i 3 + 3i]), 2, 1e-12);
%=============================================================================
% cov normalization argument
asserts.isapprox(cov([1 2 3], [4 8 16], 1), [2 / 3 4; 4 224 / 9], 1e-10);
asserts.isapprox(cov([1 2 3], [4 8 16]), [1 6; 6 112 / 3], 1e-10);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% [V, M] = var(...): M is the mean used to compute the variance
A = [4 -7 3; 1 4 -2; 10 7 9];
[V, M] = var(A);
assert_isapprox(V, [21 54.3333 30.3333], 1e-4);
assert_isapprox(M, [5 4 / 3 10 / 3], 1e-12);
%=============================================================================
% normalization and dim
[V, M] = var(A, 1, 2);
assert_isapprox(V, [24.6667; 6; 1.5556], 1e-4);
assert_isapprox(M, [0; 1; 26 / 3], 1e-12);
%=============================================================================
% weights: M is the weighted mean
[V, M] = var(A, [1 2 3]);
assert_isapprox(V, [17 24.5556 24.5556], 1e-4);
assert_isapprox(M, [6 11 / 3 13 / 3], 1e-12);
[V, M] = var(A, [1 2 3], 2);
assert_isapprox(V, [23.4722; 7.25; 1.25], 1e-4);
assert_isapprox(M, [-1 / 6; 0.5; 8.5], 1e-12);
%=============================================================================
% 'all' and vecdim
[V, M] = var(A, 0, 'all');
assert_isapprox(V, 28.9444, 1e-4);
assert_isapprox(M, 29 / 9, 1e-12);
[V, M] = var(A, 0, [1 2]);
assert_isapprox(V, 28.9444, 1e-4);
assert_isapprox(M, 29 / 9, 1e-12);
X = reshape(1:24, [2 3 4]);
[V, M] = var(X, 0, [1 3]);
assert_isequal(size(V), [1 3]);
assert_isequal(M, [10.5 12.5 14.5]);
%=============================================================================
% nanflag
B = [1 NaN 3; 4 5 6];
[V, M] = var(B, 'omitnan');
assert_isequal(V, [4.5 0 4.5]);
assert_isequal(M, [2.5 5 4.5]);
[V, M] = var(B);
assert_isequal(V, [4.5 NaN 4.5]);
assert_isequal(M, [2.5 NaN 4.5]);
[V, M] = var(B, [1 2], 'omitnan');
assert_isequal(V, [2 0 2]);
assert_isequal(M, [3 5 5]);
[V, M] = var([1 NaN 3; 4 5 NaN], 0, [1 2], 'omitnan');
assert_isapprox(V, 2.9167, 1e-4);
assert_isequal(M, 3.25);
%=============================================================================
% classes, empty, scalar, complex, sparse
[V, M] = var(single([1 2 4]));
assert_isequal(class(V), 'single');
assert_isequal(class(M), 'single');
assert_isapprox(M, single(7 / 3), 1e-6);
[V, M] = var(single([1 2 4]), [1 1 2]);
assert_isequal(class(M), 'single');
assert_isequal(M, single(2.75));
[V, M] = var([]);
assert_isequal(V, NaN);
assert_isequal(M, NaN);
[V, M] = var(zeros(0, 3));
assert_isequal(V, NaN(1, 3));
assert_isequal(M, NaN(1, 3));
[V, M] = var(5);
assert_isequal(V, 0);
assert_isequal(M, 5);
[V, M] = var([1 + 2i 3 - 1i]);
assert_isequal(V, 6.5);
assert_isequal(M, 2 + 0.5i);
[V, M] = var(sparse([1 0 2]));
assert_istrue(issparse(V));
assert_istrue(issparse(M));
assert_isequal(full(V), 1);
assert_isequal(full(M), 1);
[V, M] = var(int8([1 2 4]));
assert_isequal(class(M), 'double');
assert_isequal(M, 7 / 3);
%=============================================================================
% std shares the same mean
[S, M] = std(B, [1 2], 'omitnan');
assert_isapprox(S, [sqrt(2) 0 sqrt(2)], 1e-12);
assert_isequal(M, [3 5 5]);
[S, M] = std(zeros(0, 3));
assert_isequal(M, NaN(1, 3));
[S, M] = std([1 NaN 3; 4 5 NaN], 0, [1 2], 'omitnan');
assert_isequal(M, 3.25);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% var: integer input data is computed in double
V = var(int8([1 2 3 4]));
assert_isequal(class(V), 'double');
assert_isapprox(V, 5 / 3, 1e-12);
%=============================================================================
% no saturation of the integer class
assert_isequal(var(int8([-128 127])), 32512.5);
assert_isequal(var(uint8([0 255])), 32512.5);
assert_isequal(var(uint32([0 4294967295])), 4294967295 ^ 2 / 2);
assert_isequal(var(int32([-2147483648 2147483647])), 4294967295 ^ 2 / 2);
%=============================================================================
% every supported integer class
classes = {'int8', 'int16', 'int32', 'int64', 'uint8', 'uint16', 'uint32', 'uint64'};
for k = 1:numel(classes)
  X = cast([4 1 10; 7 4 7; 3 2 9], classes{k});
  Xd = double(X);
  assert_isequal(var(X), var(Xd));
  assert_isequal(std(X), std(Xd));
  assert_isequal(class(var(X)), 'double');
  assert_isequal(class(std(X)), 'double');
end
%=============================================================================
% options: normalization, weights, dim, vecdim, 'all', nanflag
X = int16([4 -7 3; 1 4 -2; 10 7 9]);
Xd = double(X);
assert_isequal(var(X, 1), var(Xd, 1));
assert_isequal(var(X, 0, 2), var(Xd, 0, 2));
assert_isequal(var(X, [1 2 3]), var(Xd, [1 2 3]));
assert_isequal(var(X, [], 'all'), var(Xd, [], 'all'));
assert_isequal(var(X, 0, [1 2]), var(Xd, 0, [1 2]));
assert_isequal(var(X, 'omitnan'), var(Xd, 'omitnan'));
assert_isequal(std(X, 1, 2), std(Xd, 1, 2));
assert_isequal(std(X, [3 2 1]), std(Xd, [3 2 1]));
assert_isequal(std(X, 0, 'all'), std(Xd, 0, 'all'));
assert_isequal(std(X, 0, [1 2]), std(Xd, 0, [1 2]));
%=============================================================================
% std: second output (mean) is double
[S, M] = std(uint8([10 20 255]));
assert_isequal(class(S), 'double');
assert_isequal(class(M), 'double');
assert_isapprox(S, sqrt(19225), 1e-12);
assert_isapprox(M, 95, 1e-12);
[S, M] = std(int8([1 2; 3 5]), [1 3]);
[Sd, Md] = std([1 2; 3 5], [1 3]);
assert_isequal(S, Sd);
assert_isequal(M, Md);
assert_isequal(class(M), 'double');
%=============================================================================
% scalar and empty integer input
assert_isequal(var(int8(5)), 0);
assert_isequal(std(uint16(5)), 0);
assert_isequal(var(int8([])), NaN);
%=============================================================================
% int64 and uint64 data is converted to double
assert_isequal(var(int64([1 2 3])), 1);
assert_isequal(class(var(int64([1 2 3]))), 'double');
assert_isequal(std(uint64([1 2 3])), 1);
assert_isequal(class(std(uint64([1 2 3]))), 'double');
v = 2 ^ 53;
assert_isequal(var(int64([-v v])), 2 ^ 107);
assert_isequal(var(uint64([0 intmax('uint64')])), 2 ^ 127);
[S, M] = std(uint64([0 intmax('uint64')]));
assert_isapprox(S, sqrt(2) * 2 ^ 63, 1e-15);
assert_isequal(M, 2 ^ 63);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% w = 1: normalization by N
asserts.isapprox(var([1 2 3], 1), 2 / 3, 1e-12);
asserts.isapprox(var([1 2 3 4], 1), 1.25, 1e-12);
asserts.isapprox(std([1 2 3], 1), sqrt(2 / 3), 1e-12);
%=============================================================================
% omitnan / includenan
asserts.isequal(var([1 NaN 3], 'omitnan'), 2);
asserts.isapprox(std([1 NaN 3], 'omitnan'), sqrt(2), 1e-12);
asserts.isequal(var([1 NaN 3]), NaN);
asserts.isapprox(var([1 NaN 3], 1, 'omitnan'), 1, 1e-12);
asserts.isequal(var([NaN NaN], 'omitnan'), NaN);
%=============================================================================
% regular behavior kept
asserts.isequal(var([1 2 3]), 1);
asserts.isequal(var(5), 0);
asserts.isequal(var([1 2; 3 4]), [2 2]);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% var(X, w) and std(X, w) with a weight vector compute weighted variance,
% normalized by sum(w). All expected values are the reference behaviour.
%=============================================================================
assert_isapprox(var([1 2 3], [1 1 2]), 0.6875, 1e-10);
assert_isapprox(std([1 2 3], [1 1 2]), sqrt(0.6875), 1e-10);
%=============================================================================
% equal weights match the population variance var(X, 1)
assert_isapprox(var([1 2 3 4], [1 1 1 1]), var([1 2 3 4], 1), 1e-12);
assert_isapprox(var([1 2 3], [0.5 0.5 0.5]), var([1 2 3], 1), 1e-12);
%=============================================================================
% weighting along the default (first non-singleton) dimension of a matrix
assert_isapprox(var([1 2; 3 4; 5 6], [1 2 3]), [20 / 9 20 / 9], 1e-10);
%=============================================================================
% weighting along an explicit dimension
assert_isapprox(var([1 2 3; 4 5 6], [1 1 1], 2), [2 / 3; 2 / 3], 1e-10);
%=============================================================================
% the scalar normalization flags are unchanged
assert_isapprox(var([1 2 3], 0), 1, 1e-12);
assert_isapprox(var([1 2 3], 1), 2 / 3, 1e-12);
%=============================================================================
% a weight length that does not match the operating dimension errors
assert_checkerror('var([1 2 3], [1 2])', 'The length of W must be compatible with X.');
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--WEIGHT 2-->
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('vartest'), -1);
asserts.isequal(nargout('vartest'), 4);
%=============================================================================
v = [4.5 4.8 5.1 5.4 5.7 6.0];
[h, p, ci, stats] = vartest(v, 0.4);
asserts.isequal(h, false);
asserts.isapprox(p, 0.883101737846991, 1e-12);
asserts.isapprox(ci, [0.122735223476507; 1.89482434369920], 1e-12);
asserts.isapprox(stats.chisqstat, 3.93750000000004, 1e-12);
asserts.isequal(stats.df, 5);
%=============================================================================
[h, p, ci, stats] = vartest(v, 0.2, 'Tail', 'right', 'Alpha', 0.1);
asserts.isequal(h, false);
asserts.isapprox(p, 0.163260506206144, 1e-12);
asserts.isapprox(ci(1), 0.170521777914119, 1e-12);
asserts.istrue(isinf(ci(2)) && ci(2) > 0);
asserts.isapprox(stats.chisqstat, 7.87500000000009, 1e-12);
asserts.isequal(stats.df, 5);
%=============================================================================
V = [1 2 3; 2 NaN 4; 3 5 5; 4 6 6];
[h, p, ci, stats] = vartest(V, 1.5, 'Dim', 1);
asserts.isequal(h, [false false false]);
asserts.isapprox(p, [0.686060292276489 0.111275996555686 0.686060292276489], 1e-12);
asserts.isapprox(ci, [0.534850677349353 1.17470179962120 0.534850677349353; ...
                     23.1701079801375 171.157524222565 23.1701079801375], 1e-12);
asserts.isapprox(stats.chisqstat, [3.33333333333333 5.77777777777778 3.33333333333333], 1e-12);
asserts.isequal(stats.df, [3 2 3]);
%=============================================================================
A = reshape(1:24, [2 3 4]);
[h, p, ci, stats] = vartest(A, 20, 'Dim', 3, 'Tail', 'left');
asserts.isequal(size(h), [2 3]);
asserts.isequal(size(p), [2 3]);
asserts.isequal(size(ci), [2 6]);
asserts.isequal(size(stats.chisqstat), [2 3]);
asserts.isequal(size(stats.df), [2 3]);
asserts.isequal(h, false(2, 3));
asserts.isapprox(p, 0.970709113465106 * ones(2, 3), 1e-12);
asserts.isequal(ci(1, :), zeros(1, 6));
asserts.isapprox(ci(2, :), 511.586993865513 * ones(1, 6), 1e-12);
asserts.isequal(stats.chisqstat, 9 * ones(2, 3));
asserts.isequal(stats.df, 3 * ones(2, 3));
%=============================================================================
[h, p, ci, stats] = vartest([1 1 1], 0);
asserts.isequal(h, false);
asserts.isequal(p, 1);
asserts.isequal(ci, [0; 0]);
asserts.istrue(isnan(stats.chisqstat));
asserts.isequal(stats.df, 2);
%=============================================================================
[h, p, ci, stats] = vartest([1 NaN], 1);
asserts.isequal(h, false);
asserts.istrue(isnan(p));
asserts.istrue(all(isnan(ci)));
asserts.istrue(isnan(stats.chisqstat));
asserts.istrue(isnan(stats.df));
%=============================================================================
asserts.checkerror('vartest([1 2 3])', _('Not enough input arguments.'));
asserts.checkerror('vartest([1 2 3], -1)', sprintf(_('%s must be nonnegative.'), 'V'));
asserts.checkerror('vartest([1 2 3], 1, ''Alpha'')', _('Name-value arguments must be paired.'));
asserts.checkerror('vartest([1 2 3], 1, ''Unknown'', 1)', _('Invalid name-value argument name.'));
asserts.checkerror('vartest([1 2 3], 1, ''Alpha'', 2)', sprintf(_('%s must be a scalar in the range (0,1).'), 'ALPHA'));
asserts.checkerror('vartest([1 2 3], 1, ''Tail'', ''bad'')', _('TAIL must be ''both'', ''right'', or ''left''.'));
asserts.checkerror('vartest([1 2 3], 1, ''Dim'', 0)', sprintf(_('Dimension argument must be %s.'), 'a positive integer scalar within indexing range'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--WEIGHT 2-->
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('vartest2'), -1);
asserts.isequal(nargout('vartest2'), 4);
%=============================================================================
x = [4.5 4.8 5.1 5.4 5.7 6.0];
y = [3.9 4.1 4.2 4.4 4.5];
[h, p, ci, stats] = vartest2(x, y);
asserts.isequal(h, false);
asserts.isapprox(p, 0.122655020131751, 1e-12);
asserts.isapprox(ci, [0.590136474144896; 40.8277896780601], 1e-12);
asserts.isapprox(stats.fstat, 5.52631578947388, 1e-12);
asserts.isequal(stats.df1, 5);
asserts.isequal(stats.df2, 4);
%=============================================================================
[h, p, ci, stats] = vartest2(x, y, 'Tail', 'right', 'Alpha', 0.1);
asserts.isequal(h, true);
asserts.isapprox(p, 0.061327510065875, 1e-12);
asserts.isapprox(ci(1), 1.36432734563439, 1e-12);
asserts.istrue(isinf(ci(2)) && ci(2) > 0);
asserts.isapprox(stats.fstat, 5.52631578947388, 1e-12);
asserts.isequal(stats.df1, 5);
asserts.isequal(stats.df2, 4);
%=============================================================================
X = [1 2 3; 2 NaN 4; 3 5 5; 4 6 6];
Y = [1 1 2; 1 2 3; 2 3 4; 2 4 5; 3 5 6];
[h, p, ci, stats] = vartest2(X, Y, 'Dim', 1);
asserts.isequal(h, [false false false]);
asserts.isapprox(p, [0.420826885551409 0.573979591836735 0.769800358919501], 1e-12);
asserts.isapprox(ci, [0.238591543525191 0.162767896007484 0.066805632187053; ...
                     35.9547117429665 68.0305906074280 10.0673192880306], 1e-12);
asserts.isapprox(stats.fstat, [2.38095238095238 1.73333333333333 0.666666666666667], 1e-12);
asserts.isequal(stats.df1, [3 2 3]);
asserts.isequal(stats.df2, [4 4 4]);
%=============================================================================
A = reshape(1:24, [2 3 4]);
B = A + reshape(mod(1:24, 5), [2 3 4]);
[h, p, ci, stats] = vartest2(A, B, 'Dim', 3, 'Tail', 'left');
asserts.isequal(size(h), [2 3]);
asserts.isequal(size(p), [2 3]);
asserts.isequal(size(ci), [2 6]);
asserts.isequal(size(stats.fstat), [2 3]);
asserts.isequal(h, false(2, 3));
asserts.isapprox(p, [0.403015545091910 0.602233656236609 0.403015545091910; ...
                    0.539909350248268 0.539909350248268 0.403015545091910], 1e-12);
asserts.isequal(ci(1, :), zeros(1, 6));
asserts.isapprox(ci(2, :), [6.81548190843292 10.5183815279752 12.8445620582005 ...
                           10.5183815279752 6.81548190843292 6.81548190843292], 1e-12);
asserts.isapprox(stats.fstat, [0.734693877551020 1.38461538461538 0.734693877551020; ...
                              1.13385826771654 1.13385826771654 0.734693877551020], 1e-12);
asserts.isequal(stats.df1, 3 * ones(2, 3));
asserts.isequal(stats.df2, 3 * ones(2, 3));
%=============================================================================
[h, p, ci, stats] = vartest2([1 1 1], [1 1 1]);
asserts.isequal(h, false);
asserts.isequal(p, 1);
asserts.istrue(all(isnan(ci)));
asserts.istrue(isnan(stats.fstat));
asserts.isequal(stats.df1, 2);
asserts.isequal(stats.df2, 2);
%=============================================================================
[h, p, ci, stats] = vartest2([1 NaN], [1 2 3]);
asserts.isequal(h, false);
asserts.istrue(isnan(p));
asserts.istrue(all(isnan(ci)));
asserts.istrue(isnan(stats.fstat));
asserts.isequal(stats.df1, 0);
asserts.isequal(stats.df2, 2);
%=============================================================================
asserts.checkerror('vartest2([1 2; 3 4], [1 2 3], ''Dim'', 1)', sprintf(_('X and Y must have %s.'), 'compatible sizes'));
asserts.checkerror('vartest2([1 2 3], [1 2 3], ''Alpha'')', _('Name-value arguments must be paired.'));
asserts.checkerror('vartest2([1 2 3], [1 2 3], ''Unknown'', 1)', _('Invalid name-value argument name.'));
asserts.checkerror('vartest2([1 2 3], [1 2 3], ''Alpha'', 2)', sprintf(_('%s must be a scalar in the range (0,1).'), 'ALPHA'));
asserts.checkerror('vartest2([1 2 3], [1 2 3], ''Tail'', ''bad'')', _('TAIL must be ''both'', ''right'', or ''left''.'));
asserts.checkerror('vartest2([1 2 3], [1 2 3], ''Dim'', 0)', sprintf(_('Dimension argument must be %s.'), 'a positive integer scalar within indexing range'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('wblcdf'), 4);
asserts.isequal(nargout('wblcdf'), 1);
%=============================================================================
asserts.isapprox(wblcdf(3), 0.950212931632136, 1e-15);
R = wblcdf([0 2 4 Inf], 2, 3);
E = [0 0.6321205588285577 0.9996645373720975 1];
asserts.isapprox(R, E, 1e-15);
R = wblcdf([0 2 4 Inf], 2, 3, 'upper');
E = [1 0.36787944117144233 0.00033546262790251185 0];
asserts.isapprox(R, E, 1e-15);
%=============================================================================
R = wblcdf(0.2:0.2:1, 1:5);
E = 1 - exp(-(0.2:0.2:1) ./ (1:5));
asserts.isapprox(R, E, 1e-15);
%=============================================================================
R = wblcdf(single([0 2 4]), single(2), single(3));
asserts.isequal(class(R), 'single');
asserts.isapprox(double(R), [0 0.6321205588285577 0.9996645373720975], 1e-7);
%=============================================================================
R = wblcdf([1 NaN 1 1], [1 1 NaN 0], [1 1 1 1]);
asserts.isapprox(R(1), 0.6321205588285577, 1e-15);
asserts.istrue(all(isnan(R(2:4))));
%=============================================================================
R = wblcdf([], [], []);
asserts.isequal(size(R), [0 0]);
%=============================================================================
asserts.checkerror('wblcdf(ones(2), ones(3), 1)', _('Size mismatch on input arguments'));
asserts.checkerror('wblcdf(1, 1, 1, ''bad'')', sprintf(_('Invalid %s distribution option.'), 'Weibull'));
asserts.checkerror('wblcdf({1}, 1, 1)', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('wblcdf(1, {1}, 1)', sprintf(_('%s must be real numeric.'), 'A'));
asserts.checkerror('wblcdf(1, 1, {1})', sprintf(_('%s must be real numeric.'), 'B'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--WEIGHT 2-->
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('wblfit'), 5);
asserts.isequal(nargout('wblfit'), 2);
%=============================================================================
x = [0.5 1 2 3 5 8];
[PHAT, PCI] = wblfit(x);
asserts.isapprox(PHAT, [3.499523978509226 1.254115126547431], 1e-4);
asserts.isapprox(PCI, [1.783517048721508 0.6649907100699163;
                      6.866583128509990 2.365152966527481], 1e-4);
%=============================================================================
[PHAT, PCI] = wblfit(x, 0.01);
asserts.isapprox(PHAT, [3.499523978509226 1.254115126547431], 1e-4);
asserts.isapprox(PCI, [1.443092919067591 0.5448040723689486;
                      8.486402998965470 2.886918124154465], 1e-4);
%=============================================================================
censor = [0 0 0 1 0 1];
freq = [1 2 1 1 2 1];
[PHAT, PCI] = wblfit(x, 0.05, censor, freq);
asserts.isapprox(PHAT, [4.254789570500730 1.060085049217854], 1e-4);
asserts.isapprox(PCI, [1.999623603103103 0.5489073266910343;
                      9.053320965579921 2.047304266003660], 1e-4);
%=============================================================================
opts = statset('MaxIter', 120, 'TolX', 1e-4);
[PHAT2, PCI2] = wblfit(x, [], [], [], opts);
asserts.isapprox(PHAT2, [3.499523978509226 1.254115126547431], 1e-4);
asserts.isapprox(PCI2, [1.783517048721508 0.6649907100699163;
                       6.866583128509990 2.365152966527481], 1e-4);
%=============================================================================
xm = [0.5 1; 1 2; 2 3; 3 4; 5 7];
[PHATM, PCIM] = wblfit(xm);
asserts.isequal(size(PHATM), [2 2]);
asserts.isapprox(PHATM, [2.546813461412184 1.460964597843973;
                        3.836440034457059 1.745688644345655], 1e-4);
asserts.isequal(size(PCIM), [2 2 2]);
asserts.isapprox(PCIM(:, :, 1), [1.351567517127800 0.7260825585588124;
                                4.799063846262137 2.939634799092222], 1e-4);
asserts.isapprox(PCIM(:, :, 2), [2.255864510332375 0.8819362131118006;
                                6.524448640674929 3.455384638583897], 1e-4);
%=============================================================================
[PHAT, PCI] = wblfit(single(x));
asserts.isequal(class(PHAT), 'double');
asserts.isequal(class(PCI), 'double');
asserts.isapprox(PHAT, [3.499523978509226 1.254115126547431], 1e-4);
%=============================================================================
[PHAT, PCI] = wblfit([1 NaN 3]);
asserts.istrue(all(isnan(PHAT)));
asserts.istrue(all(isnan(PCI(:))));
[PHAT, PCI] = wblfit([1 2 3], [], [1 1 1], []);
asserts.istrue(all(isnan(PHAT)));
asserts.istrue(all(isnan(PCI(:))));
[PHAT, PCI] = wblfit([1 2 3], [], [], [0 0 0]);
asserts.istrue(all(isnan(PHAT)));
asserts.istrue(all(isnan(PCI(:))));
%=============================================================================
asserts.checkerror('wblfit()', _('Not enough input arguments.'));
asserts.checkerror('wblfit([])', _('X must be a nonempty vector or matrix.'));
asserts.checkerror('wblfit(ones(1, 1, 2))', _('X must be a nonempty vector or matrix.'));
asserts.checkerror('wblfit({1 2 3})', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('wblfit([0 1 2])', _('X must contain positive finite values.'));
asserts.checkerror('wblfit([1 Inf 2])', _('X must contain positive finite values.'));
asserts.checkerror('wblfit([1 2 3], {0.05})', sprintf(_('%s must be numeric.'), 'ALPHA'));
asserts.checkerror('wblfit([1 2 3], -0.1)', sprintf(_('%s must be a scalar in the range [0,1].'), 'ALPHA'));
asserts.checkerror('wblfit([1 2 3], 1.1)', sprintf(_('%s must be a scalar in the range [0,1].'), 'ALPHA'));
asserts.checkerror('wblfit([1 2 3], [], [0 2 0])', _('CENSORING must contain 0 or 1 values.'));
asserts.checkerror('wblfit([1 2 3], [], [], [1 -1 1])', sprintf(_('%s must contain nonnegative finite values.'), 'FREQ'));
asserts.checkerror('wblfit([1 2 3], [], ones(2, 2))', _('Size mismatch on input arguments'));
asserts.checkerror('wblfit([1 2 3], [], [], [], 1)', sprintf(_('%s must be a scalar structure.'), 'OPTIONS'));
asserts.checkerror('wblfit([1 2 3], [], [], [], statset(''MaxIter'', 0))', sprintf(_('%s must be a positive integer scalar.'), 'OPTIONS MaxIter'));
asserts.checkerror('wblfit([1 2 3], [], [], [], statset(''TolX'', 0))', sprintf(_('%s must be a positive scalar.'), 'OPTIONS TolX'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
