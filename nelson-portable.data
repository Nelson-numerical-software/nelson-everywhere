B_REF = [0; 0.001];
C_REF = [0 1];
D_REF = 0;

asserts.isapprox(R.A, A_REF, 1e-4);
asserts.isapprox(R.B, B_REF, 1e-4);
asserts.isapprox(R.C, C_REF, 1e-4);
asserts.isapprox(R.D, D_REF, 1e-4);
