%=============================================================================
function varargout = mink(varargin)
  narginchk(2, 3);
  nargoutchk(0, 2);
  A = varargin{1};
  k = varargin{2};

  % Determine dimension argument if provided, otherwise compute default
  if nargin >= 3
    dim = varargin{3};
  else
    if min(size(A)) != 1
      % For matrices (both dims > 1) keep original behavior: work along columns
      dim = 1;
    else
      % For vectors use the vector's non-singleton dimension
      dim = find(size(A) != 1, 1);
      if isempty(dim)
        dim = 1;
      end
    end
  end

  % Validate dim
  if dim < 1 || floor(dim) != dim || dim > ndims(A)
    error('Nelson:mink:dimensionArgumentOutRange2', 'Dimension argument out of range.');
  end

  sz = size(A);
  if k > sz(dim)
    % k larger than the dimension: return all elements sorted (reference-implementation semantics)
    k = sz(dim);
  end

  % Sort along requested dimension in ascending order and take first k entries
  [s, ind] = sort(A, dim, 'ascend');

  subs = repmat({':'}, 1, ndims(A));
  subs{dim} = 1:k;
  val = s(subs{:});
  idx = ind(subs{:});

  % Assign outputs via varargout
  varargout{1} = val;
  if nargout > 1
    varargout{2} = idx;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function C = nchoosek(v, k)
  narginchk(2, 2);
  nargoutchk(0, 1);
  if ~isscalar(k) || ~isreal(k) || (double(k) ~= fix(double(k))) || (double(k) < 0)
    error('Nelson:elementary_functions:kNonNegativeInteger', 'K must be a nonnegative integer.');
  end
  k = double(k);
  if isscalar(v) && isreal(v) && (double(v) == fix(double(v))) && (double(v) >= 0)
    % scalar nonnegative integer: binomial coefficient
    n = double(v);
    if k > n
      error('Nelson:elementary_functions:kIntegerBetween0N', 'K must be an integer between 0 and N.');
    end
    % exact via iterative product
    kk = min(k, n - k);
    if kk == 0
      c = 1;
    else
      c = round(prod((n - kk + 1:n) ./ (1:kk)));
    end
    C = cast(c, class(v));
  else
    % vector (or non-integer scalar treated as a one-element vector):
    % matrix of all k-combinations, rows in the reference implementation's (lexicographic) order
    if ~isvector(v) && ~isempty(v)
      error('Nelson:elementary_functions:firstInputScalarVector', 'First input must be a scalar or a vector.');
    end
    n = numel(v);
    v = reshape(v, 1, n);
    if k > n
      C = reshape(v([]), 0, k);
    elseif k == 0
      C = reshape(v([]), 1, 0);
    elseif k == n
      C = v;
    else
      idx = local_combinations_indices(n, k);
      C = reshape(v(idx), size(idx));
    end
  end
end
%=============================================================================
function idx = local_combinations_indices(n, k)
  % all k-combinations of 1:n in lexicographic order (the reference implementation's order)
  m = round(prod((n - k + 1:n) ./ (1:k)));
  idx = zeros(m, k);
  c = 1:k;
  for r = 1:m
    idx(r, :) = c;
    j = k;
    while (j >= 1) && (c(j) == n - k + j)
      j = j - 1;
    end
    if j >= 1
      c(j) = c(j) + 1;
      c(j + 1:k) = c(j) + (1:(k - j));
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
