A = [1 2; 3 4];
B = [1 0; 0 1];
C = [1 1; 1 1];
D = [1 2; 3 4];
sys = ss(A, B, C, D);
R = sys * sys
REF_A = [1 2 1 1;
  3 4 1 1;
  0 0 1 2;
  0 0 3 4];
REF_B = [1 2;
  3 4;
  1 0;
  0 1];
