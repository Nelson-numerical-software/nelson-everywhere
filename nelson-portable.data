function [y, m, d] = ymd(t)
  narginchk(1, 1);
  nargoutchk(0, 3);
  v = datevec(datenum(t));
  y = reshape(v(:, 1), size(datenum(t)));
  m = reshape(v(:, 2), size(datenum(t)));
  d = reshape(v(:, 3), size(datenum(t)));
end
