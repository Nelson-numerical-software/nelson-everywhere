  f, 'motion', [100 80], 'web');
drawnow();
assert_istrue(delivered);
assert_istrue(listensToMotion);
assert_isapprox(f.CurrentPoint, [100 80], 1e-12);

button = uicontrol('Parent', f, 'Style', 'pushbutton', 'String', 'Apply', ...
  'Callback', @(source, event) set(f, 'UserData', 42));
