% LICENCE_BLOCK_END
%=============================================================================
function tf = isenum(x)
  narginchk(1, 1);
  nargoutchk(0, 1);
  tf = false;
  try
    mc = metaclass(x);
    tf = ~isempty(mc) && ~isempty(mc.EnumerationMemberList);
  catch
    tf = false;
  end
end
