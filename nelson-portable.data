end
%=============================================================================
function D = designMatrixLocal(X, terms, intercept)
  D = zeros(size(X, 1), 0);
  if intercept
    D = ones(size(X, 1), 1);
  end
  for k = 1:size(terms, 1)
    col = ones(size(X, 1), 1);
    for j = 1:size(X, 2)
