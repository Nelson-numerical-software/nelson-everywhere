function [TF, L, U, C] = isoutlier(A, varargin)
  narginchk(1, Inf);
  nargoutchk(0, 4);
  if ~(isnumeric(A) && isreal(A) && ~issparse(A))
    error('Nelson:statistics:aMustBeRealArray', '%s must be a real numeric array.', 'A');
  end
  opts = parseInputsLocal(convertStringToCharArgs(varargin), size(A));
  [TF, L, U, C] = applyAlongDimensionLocal(double(A), opts);
end
%=============================================================================
function opts = parseInputsLocal(args, sz)
  opts = struct('Method', 'median', 'Dim', firstNonsingletonLocal(sz), ...
    'ThresholdFactor', [], 'MaxNumOutliers', [], 'Percentiles', [], ...
    'Window', [], 'Moving', false, 'SamplePoints', []);
  idx = 1;
  if idx <= length(args)
    value = args{idx};
    if isTextScalarLocal(value)
      if ~isLeadingNameValueLocal(value)
        method = parseMethodLocal(value);
        opts.Method = method;
        idx = idx + 1;
        if strcmp(method, 'percentiles')
          if idx > length(args)
            error('Nelson:statistics:percentileThresholdsSpecified', '%s must be specified.', 'Percentile thresholds');
          end
          opts.Percentiles = parsePercentilesLocal(args{idx});
          idx = idx + 1;
        elseif startsWith(method, 'mov')
          if idx > length(args)
            error('Nelson:statistics:windowLengthSpecified', '%s must be specified.', 'Window length');
          end
          opts.Window = parseWindowLocal(args{idx});
          opts.Moving = true;
          idx = idx + 1;
        end
      end
    elseif isDimScalarLocal(value)
      opts.Dim = double(value);
      idx = idx + 1;
    end
  end
  if idx <= length(args) && isDimScalarLocal(args{idx})
    opts.Dim = double(args{idx});
    idx = idx + 1;
  end
  opts = parseNameValuesLocal(opts, args(idx:end));
  opts = setDefaultsLocal(opts);
end
%=============================================================================
function opts = parseNameValuesLocal(opts, args)
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  names = {'thresholdfactor', 'maxnumoutliers', 'samplepoints', 'datavariables', 'outputformat'};
  for k = 1:2:length(args)
    name = matchedNameLocal(args{k}, names);
    switch name
      case 'thresholdfactor'
        if strcmp(opts.Method, 'percentiles')
          error('Nelson:statistics:thresholdFactorSupportedPercentilesMethod', 'ThresholdFactor is not supported with the percentiles method.');
        end
        opts.ThresholdFactor = parseThresholdFactorLocal(args{k + 1}, opts.Method);
      case 'maxnumoutliers'
        opts.MaxNumOutliers = parsePositiveIntegerLocal(args{k + 1}, 'MaxNumOutliers');
      case 'samplepoints'
        opts.SamplePoints = parseSamplePointsLocal(args{k + 1});
      case {'datavariables', 'outputformat'}
        error('Nelson:statistics:invalidUsage', '%s is not supported for numeric array input.', canonicalNameLocal(name));
    end
  end
end
%=============================================================================
function opts = setDefaultsLocal(opts)
  if isempty(opts.ThresholdFactor)
    switch opts.Method
      case {'median', 'mean', 'movmedian', 'movmean'}
        opts.ThresholdFactor = 3;
      case 'quartiles'
        opts.ThresholdFactor = 1.5;
      case {'grubbs', 'gesd'}
        opts.ThresholdFactor = 0.05;
      otherwise
        opts.ThresholdFactor = NaN;
    end
  end
end
%=============================================================================
function [TF, L, U, C] = applyAlongDimensionLocal(A, opts)
  sz = size(A);
  originalRank = max(2, length(sz));
  nd = max(originalRank, opts.Dim);
  sz(end + 1:nd) = 1;
  opts = validateSamplePointsLocal(opts, sz(opts.Dim));
  perm = [opts.Dim, setdiff(1:nd, opts.Dim, 'stable')];
  Ap = permute(reshape(A, sz), perm);
  psize = size(Ap);
  psize(end + 1:nd) = 1;
  n = psize(1);
  cols = prod(psize(2:end));
  [TFr, lr, ur, cr] = processColumnsLocal(reshape(Ap, n, cols), opts);
  TF = reshape(ipermute(reshape(TFr, psize), perm), sz(1:originalRank));
  if opts.Moving
    L = reshape(ipermute(reshape(lr, psize), perm), sz(1:originalRank));
    U = reshape(ipermute(reshape(ur, psize), perm), sz(1:originalRank));
    C = reshape(ipermute(reshape(cr, psize), perm), sz(1:originalRank));
  else
    outSize = sz;
    outSize(opts.Dim) = 1;
    outSize = outSize(1:originalRank);
    tailSize = psize(2:end);
    L = reshape(ipermute(reshape(lr, [1, tailSize]), perm), outSize);
    U = reshape(ipermute(reshape(ur, [1, tailSize]), perm), outSize);
    C = reshape(ipermute(reshape(cr, [1, tailSize]), perm), outSize);
  end
end
%=============================================================================
function [TF, L, U, C] = processColumnsLocal(X, opts)
  [n, cols] = size(X);
  TF = false(n, cols);
  if opts.Moving
    L = NaN(n, cols);
    U = NaN(n, cols);
    C = NaN(n, cols);
  else
    L = NaN(1, cols);
    U = NaN(1, cols);
    C = NaN(1, cols);
  end
  if n == 0
    return
  end
  for col = 1:cols
    [tfCol, lCol, uCol, cCol] = processVectorLocal(X(:, col), opts);
    TF(:, col) = tfCol;
    L(:, min(col, size(L, 2))) = lCol;
    U(:, min(col, size(U, 2))) = uCol;
    C(:, min(col, size(C, 2))) = cCol;
  end
end
%=============================================================================
function [tf, L, U, C] = processVectorLocal(x, opts)
  if opts.Moving
    [tf, L, U, C] = movingVectorLocal(x, opts);
    return
  end
  switch opts.Method
    case 'median'
      [tf, L, U, C] = medianVectorLocal(x, opts.ThresholdFactor);
    case 'mean'
      [tf, L, U, C] = meanVectorLocal(x, opts.ThresholdFactor);
    case 'quartiles'
      [tf, L, U, C] = quartilesVectorLocal(x, opts.ThresholdFactor);
    case 'percentiles'
      [tf, L, U, C] = percentilesVectorLocal(x, opts.Percentiles);
    case 'grubbs'
      [tf, L, U, C] = grubbsVectorLocal(x, opts.ThresholdFactor);
    otherwise
      [tf, L, U, C] = gesdVectorLocal(x, opts.ThresholdFactor, opts.MaxNumOutliers);
  end
end
%=============================================================================
function [tf, L, U, C] = medianVectorLocal(x, factor)
  good = ~isnan(x);
  values = x(good);
  if isempty(values)
    [tf, L, U, C] = emptyThresholdLocal(x);
    return
  end
  C = median(values);
  scale = scaledMadLocal(values, C);
  L = C - factor * scale;
  U = C + factor * scale;
  tf = false(size(x));
  tf(good) = values < L | values > U;
end
%=============================================================================
function [tf, L, U, C] = meanVectorLocal(x, factor)
  good = ~isnan(x);
  values = x(good);
  if isempty(values)
    [tf, L, U, C] = emptyThresholdLocal(x);
    return
  end
  C = mean(values);
  scale = std(values, 0);
  L = C - factor * scale;
  U = C + factor * scale;
  tf = false(size(x));
  tf(good) = values < L | values > U;
end
%=============================================================================
function [tf, L, U, C] = quartilesVectorLocal(x, factor)
  good = ~isnan(x);
  values = x(good);
  if isempty(values)
    [tf, L, U, C] = emptyThresholdLocal(x);
    return
  end
  q = quantile(values, [0.25 0.75]);
  C = median(values);
  spread = q(2) - q(1);
  L = q(1) - factor * spread;
  U = q(2) + factor * spread;
  tf = false(size(x));
  tf(good) = values < L | values > U;
end
%=============================================================================
function [tf, L, U, C] = percentilesVectorLocal(x, percentiles)
  good = ~isnan(x);
  values = x(good);
  if isempty(values)
    [tf, L, U, C] = emptyThresholdLocal(x);
    return
  end
  bounds = quantile(values, percentiles / 100);
  L = bounds(1);
  U = bounds(2);
  C = median(values);
  tf = false(size(x));
  tf(good) = values < L | values > U;
end
%=============================================================================
function [tf, L, U, C] = grubbsVectorLocal(x, alpha)
  tf = false(size(x));
  [values, positions] = nonNanValuesLocal(x);
  if isempty(values)
    L = NaN;
    U = NaN;
    C = NaN;
    return
  end
  [L, U, C] = meanThresholdLocal(values, grubbsCriticalLocal(length(values), alpha));
  while length(values) >= 3
    [R, pos] = studentizedExtremeLocal(values);
    if R <= grubbsCriticalLocal(length(values), alpha)
      break
    end
    tf(positions(pos)) = true;
    values(pos) = [];
    positions(pos) = [];
  end
end
%=============================================================================
function [tf, L, U, C] = gesdVectorLocal(x, alpha, maxOutliers)
  tf = false(size(x));
  [values, positions] = nonNanValuesLocal(x);
  n = length(values);
  if n == 0
    L = NaN;
    U = NaN;
    C = NaN;
    return
  end
  if isempty(maxOutliers)
    maxOutliers = max(1, round(0.1 * n));
  end
  maxOutliers = min([maxOutliers, max(n - 2, 0)]);
  if maxOutliers == 0
    [L, U, C] = meanThresholdLocal(values, Inf);
    return
  end
  removed = zeros(1, maxOutliers);
  ratios = zeros(1, maxOutliers);
  lambdas = zeros(1, maxOutliers);
  work = values;
  workPositions = positions;
  for k = 1:maxOutliers
    [ratios(k), pos] = studentizedExtremeLocal(work);
    removed(k) = workPositions(pos);
    lambdas(k) = grubbsCriticalLocal(length(work), alpha);
    work(pos) = [];
    workPositions(pos) = [];
  end
  count = find(ratios > lambdas, 1, 'last');
  if ~isempty(count)
    tf(removed(1:count)) = true;
  end
  [L, U, C] = meanThresholdLocal(values, lambdas(1));
end
%=============================================================================
function [tf, L, U, C] = emptyThresholdLocal(x)
  tf = false(size(x));
  L = NaN;
  U = NaN;
  C = NaN;
end
%=============================================================================
function [tf, L, U, C] = movingVectorLocal(x, opts)
  n = length(x);
  tf = false(size(x));
  L = NaN(size(x));
  U = NaN(size(x));
  C = NaN(size(x));
  for k = 1:n
    rows = movingRowsLocal(k, n, opts);
    values = x(rows);
    switch opts.Method
      case 'movmedian'
        [~, lk, uk, ck] = medianVectorLocal(values, opts.ThresholdFactor);
      otherwise
        [~, lk, uk, ck] = meanVectorLocal(values, opts.ThresholdFactor);
    end
    L(k) = lk;
    U(k) = uk;
    C(k) = ck;
    tf(k) = ~isnan(x(k)) && (x(k) < lk || x(k) > uk);
  end
end
%=============================================================================
function scale = scaledMadLocal(values, center)
  if isempty(values)
    scale = NaN;
  else
    scale = -median(abs(values - center)) / (sqrt(2) * erfcinv(1.5));
  end
end
%=============================================================================
function [values, positions] = nonNanValuesLocal(x)
  positions = find(~isnan(x));
  values = x(positions);
end
%=============================================================================
function [R, pos] = studentizedExtremeLocal(values)
  center = mean(values);
  scale = std(values, 0);
  if scale == 0 || isnan(scale)
    R = 0;
    pos = 1;
  else
    [R, pos] = max(abs(values - center) / scale);
  end
end
%=============================================================================
function crit = grubbsCriticalLocal(n, alpha)
  if n < 3
    crit = Inf;
    return
  end
  t = tinv(1 - alpha / (2 * n), n - 2);
  crit = ((n - 1) / sqrt(n)) * sqrt((t ^ 2) / (n - 2 + t ^ 2));
end
%=============================================================================
function [L, U, C] = meanThresholdLocal(values, factor)
  C = mean(values);
  scale = std(values, 0);
  L = C - factor * scale;
  U = C + factor * scale;
end
%=============================================================================
function method = parseMethodLocal(value)
  choices = {'median', 'mean', 'quartiles', 'grubbs', 'gesd', ...
    'percentiles', 'movmedian', 'movmean'};
  method = parseChoiceLocal(value, choices, 'METHOD');
end
%=============================================================================
function threshold = parseThresholdFactorLocal(value, method)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value))
    error('Nelson:statistics:thresholdFactorFiniteScalar', 'ThresholdFactor must be a finite scalar.');
  end
  threshold = double(value);
  if any(strcmp(method, {'grubbs', 'gesd'}))
    if threshold <= 0 || threshold >= 1
      error('Nelson:statistics:thresholdFactorScalarRange01', 'ThresholdFactor must be a scalar in the range (0,1) for this method.');
    end
  elseif threshold < 0
    error('Nelson:statistics:thresholdFactorNonnegativeScalar', '%s must be a nonnegative scalar.', 'ThresholdFactor');
  end
end
%=============================================================================
function percentiles = parsePercentilesLocal(value)
  if ~(isnumeric(value) && isreal(value) && isequal(size(value), [1 2]) ...
      && all(isfinite(value)) && value(1) >= 0 && value(2) <= 100 && value(1) < value(2))
    error('Nelson:statistics:percentileThresholdsTwoElementRow', 'Percentile thresholds must be a two-element row vector in increasing order.');
  end
  percentiles = double(value);
end
%=============================================================================
function window = parseWindowLocal(value)
  if ~(isnumeric(value) && isreal(value) && isvector(value) && (length(value) == 1 || length(value) == 2) ...
      && all(isfinite(value)) && all(value > 0))
    error('Nelson:statistics:windowLengthPositiveNumericScalar', 'Window length must be a positive numeric scalar or two-element vector.');
  end
  window = double(value(:).');
end
%=============================================================================
function samplePoints = parseSamplePointsLocal(value)
  if ~(isnumeric(value) && isreal(value) && isvector(value) && all(isfinite(value)))
    error('Nelson:statistics:samplePointsFiniteRealNumericVector', 'SamplePoints must be a finite real numeric vector.');
  end
  samplePoints = double(value(:));
end
%=============================================================================
function value = parsePositiveIntegerLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) ...
      && value == fix(value) && value > 0)
    error('Nelson:statistics:mustBePositiveInteger', '%s must be a positive integer scalar.', name);
  end
  value = double(value);
end
%=============================================================================
function opts = validateSamplePointsLocal(opts, n)
  if isempty(opts.SamplePoints)
    if opts.Moving && any(opts.Window ~= fix(opts.Window))
      error('Nelson:statistics:windowLengthPositiveIntegerScalar', 'Window length must be a positive integer scalar or two-element vector.');
    end
    return
  end
  if length(opts.SamplePoints) ~= n
    error('Nelson:statistics:samplePointsOneElementInputElement', 'SamplePoints must have one element for each input element along the operating dimension.');
  end
  if any(diff(opts.SamplePoints) <= 0)
    error('Nelson:statistics:samplePointsSortedContainUniqueValues', 'SamplePoints must be sorted and contain unique values.');
  end
end
%=============================================================================
function rows = movingRowsLocal(k, n, opts)
  if isempty(opts.SamplePoints)
    if length(opts.Window) == 1
      back = floor(opts.Window / 2);
      forward = opts.Window - back - 1;
    else
      back = opts.Window(1);
      forward = opts.Window(2);
    end
    rows = max(1, k - back):min(n, k + forward);
  else
    if length(opts.Window) == 1
      lower = opts.SamplePoints(k) - opts.Window / 2;
      upper = opts.SamplePoints(k) + opts.Window / 2;
    else
      lower = opts.SamplePoints(k) - opts.Window(1);
      upper = opts.SamplePoints(k) + opts.Window(2);
    end
    rows = find(opts.SamplePoints >= lower & opts.SamplePoints <= upper);
  end
end
%=============================================================================
function dim = firstNonsingletonLocal(sz)
  dim = 1;
  for k = 1:length(sz)
    if sz(k) ~= 1
      dim = k;
      return
    end
  end
end
%=============================================================================
function tf = isDimScalarLocal(value)
  tf = isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) ...
    && value == fix(value) && value >= 1;
end
%=============================================================================
function value = parseChoiceLocal(value, choices, name)
  if ~isTextScalarLocal(value)
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', name);
  end
  text = lower(char(value));
  matches = choices(startsWith(choices, text));
  if length(matches) ~= 1
    error('Nelson:statistics:invalidValue:valueHasUnsupportedValue', '%s has an unsupported value.', name);
  end
  value = matches{1};
end
%=============================================================================
function name = matchedNameLocal(value, names)
  if ~isTextScalarLocal(value)
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Name');
  end
  text = lower(char(value));
  matches = names(startsWith(names, text));
  if length(matches) ~= 1
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
  name = matches{1};
end
%=============================================================================
function name = canonicalNameLocal(name)
  switch name
    case 'samplepoints'
      name = 'SamplePoints';
    case 'datavariables'
      name = 'DataVariables';
    otherwise
      name = 'OutputFormat';
  end
end
%=============================================================================
function tf = isLeadingNameValueLocal(value)
  names = {'thresholdfactor', 'maxnumoutliers', 'samplepoints', 'datavariables', 'outputformat'};
  text = lower(char(value));
  matches = names(startsWith(names, text));
  tf = length(matches) == 1;
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function jackstat = jackknife(varargin)
  narginchk(2, Inf);
  nargoutchk(0, 1);

  jackfun = varargin{1};
  if ~isa(jackfun, 'function_handle')
    error('Nelson:statistics:JACKFUNFunctionHandle', '%s must be a function handle.', 'JACKFUN');
  end
  args = varargin(2:end);
  firstNameValue = findFirstNameValue(args);
  dataArgs = args(1:firstNameValue - 1);
  nv = args(firstNameValue:end);
  if isempty(dataArgs)
    error('Nelson:statistics:leastOneDataArgumentRequired', 'At least one %s is required.', 'data argument');
  end
  if rem(length(nv), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  parseOptions(nv);

  [n, sampleMask, dataArgs] = validateData(dataArgs);
  first = statisticRow(jackfun, deleteRows(dataArgs, sampleMask, 1));
  jackstat = zeros(n, length(first));
  jackstat(1, :) = first;
  for i = 2:n
    jackstat(i, :) = statisticRow(jackfun, deleteRows(dataArgs, sampleMask, i));
  end
end
%=============================================================================
function idx = findFirstNameValue(args)
  idx = length(args) + 1;
  for k = 1:length(args)
    if isTextScalar(args{k})
      idx = k;
      return
    end
  end
end
%=============================================================================
function parseOptions(nv)
  for k = 1:2:length(nv)
    name = optionName(nv{k});
    if strcmp(name, 'options') && ~isempty(nv{k + 1}) && ~isstruct(nv{k + 1})
      error('Nelson:statistics:optionsStructure', 'Options must be a structure.');
    end
  end
end
%=============================================================================
function name = optionName(value)
  if ~isTextScalar(value)
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
  text = lower(char(value));
  if strncmp('options', text, length(text))
    name = 'options';
  else
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
end
%=============================================================================
function [n, sampleMask, dataArgs] = validateData(dataArgs)
  n = [];
  sampleMask = false(1, length(dataArgs));
  for k = 1:length(dataArgs)
    value = dataArgs{k};
    if length(dataArgs) == 1 && isvector(value) && ~isscalar(value)
      dataArgs{k} = value(:);
    end
    if ~isscalar(dataArgs{k})
      rows = size(dataArgs{k}, 1);
      if isempty(n)
        n = rows;
      elseif rows ~= n
        error('Nelson:statistics:nonscalarDataArgumentsSameNumber', '%s must have the same number of rows.', 'Nonscalar data arguments');
      end
      sampleMask(k) = true;
    end
  end
  if isempty(n)
    error('Nelson:statistics:leastOneNonscalarDataArgument', 'At least one %s is required.', 'nonscalar data argument');
  end
end
%=============================================================================
function args = deleteRows(dataArgs, sampleMask, row)
  args = dataArgs;
  for k = 1:length(args)
    if sampleMask(k)
      mask = true(size(args{k}, 1), 1);
      mask(row) = false;
      args{k} = args{k}(mask, :);
    end
  end
end
%=============================================================================
function row = statisticRow(jackfun, args)
  value = feval(jackfun, args{:});
  row = value(:)';
end
%=============================================================================
function tf = isTextScalar(value)
  tf = ischar(value) || isStringScalar(value);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [h, p, jbstat, critval] = jbtest(x, varargin)
  narginchk(1, 3);
  nargoutchk(0, 4);
  [alpha, mctol] = parseInputsLocal(varargin);
  values = validateSampleLocal(x);
  [jbstat, n] = statisticLocal(values);
  p = chi2cdf(jbstat, 2, 'upper');
  critval = chi2inv(1 - alpha, 2);
  h = p <= alpha;
  if n < 3 || isnan(jbstat)
    p = NaN;
    critval = NaN;
    h = false;
  end
  mctol;
end
%=============================================================================
function [alpha, mctol] = parseInputsLocal(args)
  alpha = 0.05;
  mctol = [];
  if length(args) >= 1 && ~isempty(args{1})
    alpha = scalarInRangeLocal(args{1}, 'ALPHA');
  end
  if length(args) >= 2
    mctol = nonnegativeScalarLocal(args{2}, 'MCTOL');
  end
end
%=============================================================================
function values = validateSampleLocal(x)
  if ~(isnumeric(x) && isreal(x) && ~issparse(x) && isvector(x))
    error('Nelson:statistics:xRealNumericVector', '%s must be a real numeric vector.', 'X');
  end
  values = double(x(:));
  values = values(~isnan(values));
  if isempty(values)
    error('Nelson:statistics:xContainLeastOneNon', '%s must contain at least one non-NaN observation.', 'X');
  end
end
%=============================================================================
function [jbstat, n] = statisticLocal(values)
  n = length(values);
  mu = mean(values);
  centered = values - mu;
  m2 = mean(centered .^ 2);
  if m2 <= 0
    jbstat = 0;
    return
  end
  skewnessValue = mean(centered .^ 3) / (m2 ^ 1.5);
  kurtosisValue = mean(centered .^ 4) / (m2 ^ 2);
  jbstat = n / 6 * (skewnessValue ^ 2 + (kurtosisValue - 3) ^ 2 / 4);
end
%=============================================================================
function value = scalarInRangeLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && value > 0 && value < 1)
    error('Nelson:statistics:mustBeInRange', '%s must be a scalar in the range (0,1).', name);
  end
  value = double(value);
end
%=============================================================================
function value = nonnegativeScalarLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && value >= 0)
    error('Nelson:statistics:mustBeNonnegative', '%s must be a nonnegative scalar.', name);
  end
  value = double(value);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [idx, C, sumd, D, midx, info] = kmedoids(varargin)
  narginchk(2, Inf);
  nargoutchk(0, 6);

  X = varargin{1};
  k = positiveInteger(varargin{2}, sprintf(_('%s must be a positive integer scalar.'), 'K'));
  if ~isnumeric(X) || ndims(X) ~= 2 || isempty(X)
    error('Nelson:statistics:xNonemptyNumericMatrix', '%s must be a nonempty numeric matrix.', 'X');
  end
  if k > size(X, 1)
    error('Nelson:statistics:kTooLarge', 'K must not exceed the number of rows in X.');
  end
  if rem(nargin - 2, 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  opts = parseOptions(varargin(3:end));
  allD = pdist2(X, X, opts.Distance);
  best = struct('idx', [], 'midx', [], 'sumd', [], 'D', [], 'total', Inf, 'iterations', 0);
  for r = 1:opts.Replicates
    start = initialMedoids(X, k, opts, r);
    result = runPam(allD, start, opts.MaxIter);
    if result.total < best.total
      best = result;
    end
  end
  idx = best.idx;
  midx = best.midx(:);
  C = X(midx, :);
  D = best.D;
  sumd = best.sumd(:);
  info = struct('Iterations', best.iterations, 'BestSum', best.total);
  if strcmp(opts.Display, 'final') || strcmp(opts.Display, 'iter')
    disp(['Best total sum of distances: ', num2str(best.total)]);
  end
end
%=============================================================================
function opts = parseOptions(args)
  opts = struct('Distance', 'sqeuclidean', 'Start', 'sample', 'Replicates', 1, 'MaxIter', 100, 'Display', 'off', 'Options', []);
  for k = 1:2:length(args)
    name = optionName(args{k});
    value = args{k + 1};
    switch name
      case 'distance'
        opts.Distance = value;
      case 'start'
        opts.Start = value;
      case 'replicates'
        opts.Replicates = positiveInteger(value, sprintf(_('%s must be a positive integer scalar.'), 'Replicates'));
      case 'maxiter'
        opts.MaxIter = positiveInteger(value, sprintf(_('%s must be a positive integer scalar.'), 'MaxIter'));
      case 'display'
        opts.Display = displayValue(value);
      case 'options'
        if ~isempty(value) && ~isstruct(value)
          error('Nelson:statistics:optionsStructure', 'Options must be a structure.');
        end
        opts.Options = value;
      otherwise
        error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
    end
  end
end
%=============================================================================
function result = runPam(allD, midx, maxIter)
  idx = [];
  for iter = 1:maxIter
    [newIdx, D] = assignMedoids(allD, midx);
    newMidx = updateMedoids(allD, newIdx, midx);
    if isequal(newMidx(:), midx(:)) && isequal(newIdx(:), idx(:))
      break
    end
    idx = newIdx;
    midx = newMidx;
  end
  [idx, D] = assignMedoids(allD, midx);
  sumd = clusterSums(idx, D, length(midx));
  result = struct('idx', idx, 'midx', midx, 'sumd', sumd, 'D', D, 'total', sum(sumd), 'iterations', iter);
end
%=============================================================================
function [idx, D] = assignMedoids(allD, midx)
  D = allD(:, midx);
  [~, idx] = min(D, [], 2);
  idx = idx(:);
end
%=============================================================================
function midx = updateMedoids(allD, idx, midx)
  for c = 1:length(midx)
    members = find(idx == c);
    if isempty(members)
      candidate = 1:size(allD, 1);
      candidate(midx) = [];
      midx(c) = candidate(randi(length(candidate)));
    else
      subD = allD(members, members);
      totals = sum(subD, 2);
      [~, pos] = min(totals);
      midx(c) = members(pos);
    end
  end
  if length(unique(midx)) < length(midx)
    midx = repairDuplicates(allD, midx);
  end
end
%=============================================================================
function midx = repairDuplicates(allD, midx)
  used = [];
  for i = 1:length(midx)
    if any(used == midx(i))
      candidates = 1:size(allD, 1);
      candidates(midx) = [];
      midx(i) = candidates(randi(length(candidates)));
    end
    used(end + 1) = midx(i);
  end
end
%=============================================================================
function sumd = clusterSums(idx, D, k)
  sumd = zeros(k, 1);
  for c = 1:k
    sumd(c) = sum(D(idx == c, c));
  end
end
%=============================================================================
function midx = initialMedoids(X, k, opts, replicate)
  start = opts.Start;
  if isnumeric(start)
    midx = numericStart(X, k, start, replicate);
  else
    if ~(ischar(start) || isStringScalar(start))
      error('Nelson:statistics:invalidStartValue', 'Invalid %s value.', 'Start');
    end
    text = lower(char(start));
    if strncmp('sample', text, length(text)) || strncmp('plus', text, length(text))
      midx = randsample(size(X, 1), k);
    else
      error('Nelson:statistics:invalidStartValue', 'Invalid %s value.', 'Start');
    end
  end
end
%=============================================================================
function midx = numericStart(X, k, start, replicate)
  if isvector(start) && length(start) == k
    midx = start(:);
  elseif ndims(start) == 2 && isequal(size(start), [k size(X, 2)])
    midx = rowsInX(X, start);
  elseif ndims(start) == 3 && size(start, 1) == k && size(start, 2) == size(X, 2)
    page = min(replicate, size(start, 3));
    midx = rowsInX(X, start(:, :, page));
  else
    error('Nelson:statistics:invalidStartValue', 'Invalid %s value.', 'Start');
  end
  if any(midx < 1) || any(midx > size(X, 1)) || any(floor(midx) ~= midx)
    error('Nelson:statistics:invalidStartValue', 'Invalid %s value.', 'Start');
  end
end
%=============================================================================
function midx = rowsInX(X, centers)
  midx = zeros(size(centers, 1), 1);
  for i = 1:size(centers, 1)
    found = 0;
    for j = 1:size(X, 1)
      if isequal(X(j, :), centers(i, :))
        found = j;
        break
      end
    end
    if found == 0
      error('Nelson:statistics:startRowsRowsX', 'Start rows must be rows from X.');
    end
    midx(i) = found;
  end
end
%=============================================================================
function name = optionName(value)
  if ~(ischar(value) || isStringScalar(value))
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
  text = lower(char(value));
  names = {'distance', 'start', 'replicates', 'maxiter', 'display', 'options'};
  matches = {};
  for k = 1:length(names)
    if strncmp(names{k}, text, length(text))
      matches{end + 1} = names{k};
    end
  end
  if isempty(matches)
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
  if length(matches) > 1
    error('Nelson:statistics:ambiguousNameValue', 'Ambiguous name-value argument name.');
  end
  name = matches{1};
end
%=============================================================================
function value = displayValue(value)
  if ~(ischar(value) || isStringScalar(value))
    error('Nelson:statistics:displayOffFinalIter', 'Display must be off, final, or iter.');
  end
  text = lower(char(value));
  names = {'off', 'final', 'iter'};
  for k = 1:length(names)
    if strncmp(names{k}, text, length(text))
      value = names{k};
      return
    end
  end
  error('Nelson:statistics:displayOffFinalIter', 'Display must be off, final, or iter.');
end
%=============================================================================
function value = positiveInteger(value, message)
  if ~isscalar(value) || value <= 0 || floor(value) ~= value
    error('Nelson:statistics:mustBePositiveInteger', message);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [p, tbl, stats] = kruskalwallis(X, group, displayopt)
  narginchk(1, 3);
  nargoutchk(0, 3);
  hasDisplay = nargin >= 3;
  if nargin < 2
    group = [];
  elseif nargin == 2 && isDisplayOptionLocal(group)
    displayopt = group;
    group = [];
    hasDisplay = true;
  end
  if ~hasDisplay
    displayopt = 'on';
  end
  displayopt = parseDisplayLocal(displayopt);
  [values, codes, labels] = groupedValuesLocal(X, group);
  result = kruskalTableLocal(values, codes, labels);
  p = result.p;
  tbl = result.tbl;
  stats = result.stats;
  if strcmp(displayopt, 'on')
    disp(tbl);
  end
end
%=============================================================================
function [values, codes, labels] = groupedValuesLocal(X, group)
  if ~(isnumeric(X) && isreal(X) && ~issparse(X) && ndims(X) == 2)
    error('Nelson:statistics:xRealNumericVectorMatrix', '%s must be a real numeric vector or matrix.', 'X');
  end
  X = double(X);
  if isempty(group)
    [values, codes, labels] = matrixGroupsLocal(X);
  else
    [values, codes, labels] = explicitGroupsLocal(X, group);
  end
end
%=============================================================================
function [values, codes, labels] = matrixGroupsLocal(X)
  ncols = size(X, 2);
  values = X(:);
  codes = reshape(repmat(1:ncols, size(X, 1), 1), [], 1);
  labels = cell(ncols, 1);
  for k = 1:ncols
    labels{k} = int2str(k);
  end
  keep = ~isnan(values);
  [values, codes, labels] = compactGroupsLocal(values(keep), codes(keep), labels);
end
%=============================================================================
function [values, codes, labels] = explicitGroupsLocal(X, group)
  if isvector(X)
    values = X(:);
    [codes, labels, keep] = groupCodesLocal(group, numel(values));
  else
    labelsByColumn = inputLabelsLocal(group, size(X, 2));
    values = X(:);
    columnCodes = reshape(repmat(1:size(X, 2), size(X, 1), 1), [], 1);
    groupValues = labelsByColumn(columnCodes);
    [codes, labels, keep] = groupCodesFromLabelsLocal(groupValues);
  end
  keep = keep & ~isnan(values);
  [values, codes, labels] = compactGroupsLocal(values(keep), codes(keep), labels);
end
%=============================================================================
function [values, codes, labels] = compactGroupsLocal(values, codes, labels)
  counts = zeros(length(labels), 1);
  for k = 1:length(labels)
    counts(k) = sum(codes == k);
  end
  keepGroups = counts > 0;
  map = zeros(length(labels), 1);
  map(keepGroups) = 1:sum(keepGroups);
  labels = labels(keepGroups);
  codes = map(codes);
  values = values(:);
  codes = codes(:);
end
%=============================================================================
function [codes, labels, keep] = groupCodesLocal(group, n)
  rawLabels = inputLabelsLocal(group, n);
  [codes, labels, keep] = groupCodesFromLabelsLocal(rawLabels);
end
%=============================================================================
function [codes, labels, keep] = groupCodesFromLabelsLocal(rawLabels)
  keep = ~strcmp(rawLabels(:), '#<missing>');
  [labels, ~, ic] = unique(rawLabels(keep));
  codes = zeros(length(rawLabels), 1);
  codes(keep) = ic(:);
end
%=============================================================================
function labels = inputLabelsLocal(group, n)
  if iscategorical(group)
    labels = cellstr(group(:));
    labels(strcmp(labels, '<undefined>')) = {'#<missing>'};
  elseif isstring(group)
    labels = cellstr(group(:));
  elseif ischar(group)
    labels = cellstr(group);
  elseif iscellstr(group)
    labels = group(:);
  elseif isnumeric(group) || islogical(group)
    flat = group(:);
    labels = cell(length(flat), 1);
    for k = 1:length(flat)
      if isnumeric(flat) && isnan(flat(k))
        labels{k} = '#<missing>';
      else
        labels{k} = mat2str(flat(k));
      end
    end
  else
    error('Nelson:statistics:GROUPVectorTextArray', '%s must be a vector or text array.', 'GROUP');
  end
  if length(labels) ~= n
    error('Nelson:statistics:GROUPExpectedNumberLabels', 'GROUP must have the expected number of labels.');
  end
end
%=============================================================================
function result = kruskalTableLocal(values, codes, labels)
  ngroups = length(labels);
  n = length(values);
  if ngroups < 2 || n <= ngroups
    error('Nelson:statistics:leastTwoGroupsMoreObservations', 'At least two groups with more observations than groups are required.');
  end
  [ranks, tieCorrection] = tiedRanksLocal(values);
  [counts, rankSums, meanRanks] = rankSummaryLocal(ranks, codes, ngroups);
  [h, p] = kruskalStatisticLocal(rankSums, counts, n, ngroups, tieCorrection);
  [ssGroups, ssError, ssTotal] = rankSumsOfSquaresLocal(rankSums, counts, n);
  tbl = cellTableLocal(ssGroups, ssError, ssTotal, ngroups, n, h, p);
  result.p = p;
  result.tbl = tbl;
  result.stats = struct('gnames', {labels(:)}, 'n', counts(:)', 'source', 'kruskalwallis', ...
    'meanranks', meanRanks(:)', 'sumranks', rankSums(:)', 'df', ngroups - 1);
end
%=============================================================================
function [h, p] = kruskalStatisticLocal(rankSums, counts, n, ngroups, tieCorrection)
  h = 12 / (n * (n + 1)) * sum((rankSums .^ 2) ./ counts) - 3 * (n + 1);
  if tieCorrection == 0
    h = 0;
  else
    h = h / tieCorrection;
  end
  p = chi2cdf(h, ngroups - 1, 'upper');
end
%=============================================================================
function [ssGroups, ssError, ssTotal] = rankSumsOfSquaresLocal(rankSums, counts, n)
  ssGroups = sum((rankSums .^ 2) ./ counts) - n * (n + 1) ^ 2 / 4;
  ssTotal = n * (n + 1) * (n - 1) / 12;
  ssError = ssTotal - ssGroups;
end
%=============================================================================
function tbl = cellTableLocal(ssGroups, ssError, ssTotal, ngroups, n, h, p)
  tbl = {'Source', 'SS', 'df', 'Chi-sq', 'Prob>Chi-sq'; ...
         'Groups', ssGroups, ngroups - 1, h, p; ...
         'Error', ssError, n - ngroups, [], []; ...
         'Total', ssTotal, n - 1, [], []};
end
%=============================================================================
function [ranks, tieCorrection] = tiedRanksLocal(values)
  [sortedValues, order] = sort(values(:));
  n = length(sortedValues);
  ranks = zeros(n, 1);
  tieSum = 0;
  starts = [1; find(diff(sortedValues) ~= 0) + 1];
  stops = [starts(2:end) - 1; n];
  for k = 1:length(starts)
    rows = starts(k):stops(k);
    ranks(order(rows)) = (starts(k) + stops(k)) / 2;
    tieLength = stops(k) - starts(k) + 1;
    tieSum = tieSum + tieLength ^ 3 - tieLength;
  end
  tieCorrection = 1 - tieSum / (n ^ 3 - n);
end
%=============================================================================
function [counts, rankSums, meanRanks] = rankSummaryLocal(ranks, codes, ngroups)
  counts = zeros(ngroups, 1);
  rankSums = zeros(ngroups, 1);
  for k = 1:ngroups
    rows = codes == k;
    counts(k) = sum(rows);
    rankSums(k) = sum(ranks(rows));
  end
  meanRanks = rankSums ./ counts;
end
%=============================================================================
function opt = parseDisplayLocal(value)
  if ~isDisplayOptionLocal(value)
    error('Nelson:statistics:displayOptionOff', 'Display option must be ''on'' or ''off''.');
  end
  opt = lower(char(value));
end
%=============================================================================
function tf = isDisplayOptionLocal(value)
  tf = false;
  if isTextScalarLocal(value)
    text = lower(char(value));
    tf = strcmp(text, 'on') || strcmp(text, 'off');
  end
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [f, xi, bw] = ksdensity(x, pts, varargin)
  narginchk(1, Inf);
  nargoutchk(0, 3);
  if nargin >= 2 && isOptionNameLocal(pts)
    varargin = [{pts}, varargin];
    pts = [];
  elseif nargin < 2
    pts = [];
  end
  opts = parseOptionsLocal(varargin);
  [x, weights] = prepareDataLocal(x, opts);
  bw = bandwidthLocal(x, weights, opts.Bandwidth);
  xi = pointsLocal(x, pts, bw, opts);
  f = estimateLocal(x, weights, xi, bw, opts);
  if nargout == 0
    plot(xi, f);
  end
end
%=============================================================================
function tf = isOptionNameLocal(value)
  tf = (ischar(value) || (isstring(value) && isscalar(value))) && any(strcmpi(char(value), ...
    {'Bandwidth', 'Width', 'Function', 'NumPoints', 'Support', 'Weights', 'Frequency', ...
    'Censoring', 'Kernel', 'BoundaryCorrection'}));
end
%=============================================================================
function opts = parseOptionsLocal(args)
  opts = struct('Bandwidth', [], 'Function', 'pdf', 'NumPoints', 100, ...
    'Support', 'unbounded', 'Weights', [], 'Censoring', [], 'Kernel', 'normal');
  k = 1;
  while k <= length(args)
    if k == length(args)
      error('Nelson:statistics:nameValueArgumentFollowedValue', 'Name-value argument must be followed by a value.');
    end
    name = lower(char(args{k}));
    switch name
      case {'bandwidth', 'width'}
        opts.Bandwidth = args{k + 1};
      case 'function'
        opts.Function = normalizeFunctionLocal(args{k + 1});
      case 'numpoints'
        opts.NumPoints = args{k + 1};
      case 'support'
        opts.Support = args{k + 1};
      case {'weights', 'frequency'}
        opts.Weights = args{k + 1};
      case 'censoring'
        opts.Censoring = args{k + 1};
      case 'kernel'
        opts.Kernel = lower(char(args{k + 1}));
      case 'boundarycorrection'
        args{k + 1};
      otherwise
        error('Nelson:statistics:unknownOption', 'Unknown option.');
    end
    k = k + 2;
  end
  if ~(isnumeric(opts.NumPoints) && isscalar(opts.NumPoints) && opts.NumPoints >= 1)
    error('Nelson:statistics:numPointsPositiveScalar', '%s must be a positive scalar.', 'NumPoints');
  end
  if ~strcmp(opts.Kernel, 'normal')
    error('Nelson:statistics:normalKernelSupported', 'Only normal kernel is supported.');
  end
end
%=============================================================================
function name = normalizeFunctionLocal(value)
  name = strtrim(lower(char(value)));
  if any(strcmp(name, {'pdf', 'density'}))
    name = 'pdf';
  elseif strcmp(name, 'cdf')
    name = 'cdf';
  elseif any(strcmp(name, {'survivor', 'survival'}))
    name = 'survivor';
  elseif any(strcmp(name, {'cumhazard', 'cumulative hazard', 'hazard'}))
    name = 'cumhazard';
  elseif any(strcmp(name, {'icdf', 'inverse cdf'}))
    name = 'icdf';
  else
    error('Nelson:statistics:unsupportedFunctionType', 'Unsupported %s.', 'function type');
  end
end
%=============================================================================
function [x, weights] = prepareDataLocal(x, opts)
  if ~(isnumeric(x) && isreal(x) && ~issparse(x) && isvector(x))
    error('Nelson:statistics:xRealNumericVector', '%s must be a real numeric vector.', 'X');
  end
  x = double(x(:));
  weights = ones(size(x));
  if ~isempty(opts.Weights)
    weights = double(opts.Weights(:));
  end
  if length(weights) ~= length(x)
    error('Nelson:statistics:weightsMatchX', '%s must match X.', 'Weights');
  end
  keep = ~isnan(x) & ~isnan(weights) & weights > 0;
  if ~isempty(opts.Censoring)
    censoring = opts.Censoring(:);
    if length(censoring) ~= length(x)
      error('Nelson:statistics:censoringMatchX', '%s must match X.', 'Censoring');
    end
    keep = keep & ~logical(censoring);
  end
  x = x(keep);
  weights = weights(keep);
  if isempty(x)
    error('Nelson:statistics:xContainLeastOneValid', 'X must contain at least one valid observation.');
  end
end
%=============================================================================
function bw = bandwidthLocal(x, weights, value)
  if isempty(value) || (ischar(value) && strcmpi(value, 'normal-approx')) ...
      || (isstring(value) && strcmpi(char(value), 'normal-approx'))
    n = sum(weights);
    sx = std(x, 0, 1);
    iq = iqr(x);
    scale = min(sx, iq / 1.349);
    if scale <= 0 || isnan(scale)
      scale = sx;
    end
    if scale <= 0 || isnan(scale)
      scale = max(x) - min(x);
    end
    if scale <= 0 || isnan(scale)
      scale = 1;
    end
    bw = 1.06 * scale * n ^ (-1 / 5);
  elseif ischar(value) || isstring(value)
    error('Nelson:statistics:unsupportedBandwidthMethod', 'Unsupported %s.', 'bandwidth method');
  else
    bw = double(value);
  end
  if ~(isscalar(bw) && isfinite(bw) && bw > 0)
    error('Nelson:statistics:bandwidthPositiveScalar', '%s must be a positive scalar.', 'Bandwidth');
  end
end
%=============================================================================
function xi = pointsLocal(x, pts, bw, opts)
  if isempty(pts)
    support = supportBoundsLocal(opts.Support);
    lo = max(min(x) - 3 * bw, support(1));
    hi = min(max(x) + 3 * bw, support(2));
    if ~isfinite(lo)
      lo = min(x) - 3 * bw;
    end
    if ~isfinite(hi)
      hi = max(x) + 3 * bw;
    end
    if lo == hi
      lo = lo - bw;
      hi = hi + bw;
    end
    xi = linspace(lo, hi, opts.NumPoints)';
  else
    if ~(isnumeric(pts) && isreal(pts) && isvector(pts))
      error('Nelson:statistics:pointsRealNumericVector', '%s must be a real numeric vector.', 'Points');
    end
    xi = double(pts(:));
  end
end
%=============================================================================
function bounds = supportBoundsLocal(support)
  if ischar(support) || isstring(support)
    switch lower(char(support))
      case 'unbounded'
        bounds = [-Inf, Inf];
      case {'positive', 'nonnegative'}
        bounds = [0, Inf];
      case 'negative'
        bounds = [-Inf, 0];
      otherwise
        error('Nelson:statistics:unsupportedSupport', 'Unsupported %s.', 'support');
    end
  else
    bounds = double(support(:)');
    if length(bounds) ~= 2 || bounds(1) >= bounds(2)
      error('Nelson:statistics:supportTwoElementIncreasingVector', 'Support must be a two-element increasing vector.');
    end
  end
end
%=============================================================================
function f = estimateLocal(x, weights, xi, bw, opts)
  totalWeight = sum(weights);
  f = zeros(size(xi));
  switch opts.Function
    case 'icdf'
      f = inverseCdfLocal(x, weights, xi, bw, opts);
      return
  end
  support = supportBoundsLocal(opts.Support);
  for k = 1:length(xi)
    z = (xi(k) - x) / bw;
    switch opts.Function
      case 'pdf'
        value = sum(weights .* normalPdfLocal(z)) / (totalWeight * bw);
      otherwise
        value = sum(weights .* normcdf(z, 0, 1)) / totalWeight;
    end
    f(k) = value;
  end
  f = applyFunctionAndSupportLocal(f, xi, support, opts.Function);
end
%=============================================================================
function f = applyFunctionAndSupportLocal(f, xi, support, functionName)
  below = xi < support(1);
  above = xi > support(2);
  switch functionName
    case 'pdf'
      f(below | above) = 0;
    case 'cdf'
      f(below) = 0;
      f(above) = 1;
    case 'survivor'
      f = 1 - f;
      f(below) = 1;
      f(above) = 0;
    case 'cumhazard'
      f = -log(max(1 - f, realmin));
      f(below) = 0;
      f(above) = Inf;
  end
end
%=============================================================================
function q = inverseCdfLocal(x, weights, p, bw, opts)
  if any(p < 0 | p > 1 | isnan(p))
    error('Nelson:statistics:probabilitiesBetween01', 'Probabilities must be between 0 and 1.');
  end
  oldFunction = opts.Function;
  opts.Function = 'cdf';
  grid = pointsLocal(x, [], bw, opts);
  cdfValues = estimateLocal(x, weights, grid, bw, opts);
  opts.Function = oldFunction;
  q = interp1(cdfValues, grid, p, 'linear');
end
%=============================================================================
function y = normalPdfLocal(x)
  y = exp(-0.5 * x .^ 2) / sqrt(2 * pi);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = kurtosis(x, varargin)
  narginchk(1, 3);
  nargoutchk(0, 1);
  y = __moment_stats__(x, 4, varargin{:});
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [B, FitInfo] = lasso(X, y, varargin)
  narginchk(2, Inf);
  nargoutchk(0, 2);
  opts = parseOptionsLocal(size(X, 1), convertStringToCharArgs(varargin));
  [X, y, opts] = validateInputsLocal(X, y, opts);
  keep = ~isnan(y) & all(~isnan(X), 2) & ~isnan(opts.Weights);
  [B, FitInfo] = lassoFitLocal(X(keep, :), y(keep), opts, opts.Weights(keep));
end
%=============================================================================
function opts = parseOptionsLocal(n, args)
  opts = struct('Alpha', 1, 'Lambda', [], 'LambdaRatio', 1e-4, ...
    'NumLambda', 100, 'Standardize', true, 'Intercept', true, ...
    'MaxIter', 1000, 'RelTol', 1e-4, 'Weights', ones(n, 1));
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  for k = 1:2:length(args)
    if ~isTextScalarLocal(args{k})
      error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Name');
    end
    name = lower(char(args{k}));
    switch name
      case 'alpha'
        opts.Alpha = parsePositiveScalarLocal(args{k + 1}, 'ALPHA');
        if opts.Alpha > 1
          error('Nelson:statistics:ALPHARange01', 'ALPHA must be in the range (0,1].');
        end
      case 'lambda'
        opts.Lambda = parseLambdaLocal(args{k + 1});
      case 'lambdaratio'
        opts.LambdaRatio = parseLambdaRatioLocal(args{k + 1});
      case 'numlambda'
        opts.NumLambda = parsePositiveIntegerLocal(args{k + 1}, 'NUMLAMBDA');
      case 'standardize'
        opts.Standardize = parseLogicalScalarLocal(args{k + 1}, 'STANDARDIZE');
      case 'intercept'
        opts.Intercept = parseLogicalScalarLocal(args{k + 1}, 'INTERCEPT');
      case 'maxiter'
        opts.MaxIter = parsePositiveIntegerLocal(args{k + 1}, 'MAXITER');
      case 'reltol'
        opts.RelTol = parsePositiveScalarLocal(args{k + 1}, 'RELTOL');
      case 'weights'
        opts.Weights = parseWeightsLocal(args{k + 1}, n);
      otherwise
        error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
    end
  end
  if ~opts.Intercept
    opts.Standardize = false;
  end
end
%=============================================================================
function [X, y, opts] = validateInputsLocal(X, y, opts)
  if ~(isnumeric(X) && isreal(X) && ismatrix(X) && ~issparse(X))
    error('Nelson:statistics:xRealNumericMatrix', '%s must be a real numeric matrix.', 'X');
  end
  if ~(isnumeric(y) && isreal(y) && isvector(y) && ~issparse(y))
    error('Nelson:statistics:yRealNumericVector', '%s must be a real numeric vector.', 'Y');
  end
  X = double(X);
  y = double(y(:));
  if size(X, 1) ~= length(y)
    error('Nelson:statistics:xYSameNumberRows', '%s must have the same number of rows.', 'X and Y');
  end
  opts.Weights = double(opts.Weights(:));
end
%=============================================================================
function [B, FitInfo] = lassoFitLocal(X, y, opts, weights)
  n = length(y);
  p = size(X, 2);
  if n == 0 || p == 0
    lambda = lambdaValuesLocal(zeros(0, p), zeros(0, 1), opts);
    B = NaN(p, length(lambda));
    FitInfo = fitInfoLocal(B, y, X, lambda, zeros(length(lambda), 1), opts, zeros(1, length(lambda)));
    return
  end
  weights = weights * n / sum(weights);
  [Xs, yc, xmean, xscale, ymean] = prepareDataLocal(X, y, weights, opts);
  lambda = lambdaValuesLocal(Xs, yc, opts, weights);
  Bwork = zeros(p, length(lambda));
  intercept = zeros(1, length(lambda));
  iterations = zeros(1, length(lambda));
  beta = zeros(p, 1);
  for j = 1:length(lambda)
    [beta, iterations(j)] = coordinateDescentLocal(Xs, yc, weights, lambda(j), opts, beta);
    Bwork(:, j) = beta;
    [Bwork(:, j), intercept(j)] = restoreScaleLocal(beta, xmean, xscale, ymean, opts);
  end
  B = Bwork;
  FitInfo = fitInfoLocal(B, y, X, lambda, intercept, opts, iterations);
end
%=============================================================================
function [Xs, yc, xmean, xscale, ymean] = prepareDataLocal(X, y, weights, opts)
  if opts.Intercept
    xmean = sum(X .* weights, 1) / sum(weights);
    ymean = sum(y .* weights) / sum(weights);
  else
    xmean = zeros(1, size(X, 2));
    ymean = 0;
  end
  Xs = X - xmean;
  yc = y - ymean;
  if opts.Standardize
    xscale = sqrt(sum((Xs .^ 2) .* weights, 1) / max(sum(weights) - 1, 1));
    xscale(xscale == 0 | isnan(xscale)) = 1;
    Xs = Xs ./ xscale;
  else
    xscale = ones(1, size(X, 2));
  end
end
%=============================================================================
function lambda = lambdaValuesLocal(X, y, opts, weights)
  if ~isempty(opts.Lambda)
    lambda = opts.Lambda;
    return
  end
  if isempty(y)
    lambda = NaN(1, opts.NumLambda);
    return
  end
  n = length(y);
  lambdaMax = max(abs(X' * (weights .* y))) / (n * opts.Alpha);
  if lambdaMax == 0 || isnan(lambdaMax)
    lambdaMax = 1;
  end
  if opts.LambdaRatio == 0
    if opts.NumLambda == 1
      lambda = 0;
    else
      lambda = [logspace(log10(lambdaMax), log10(lambdaMax * 1e-4), opts.NumLambda - 1), 0];
    end
  else
    lambda = logspace(log10(lambdaMax), log10(lambdaMax * opts.LambdaRatio), opts.NumLambda);
  end
end
%=============================================================================
function [beta, iter] = coordinateDescentLocal(X, y, weights, lambda, opts, beta)
  n = length(y);
  xnorm = sum((X .^ 2) .* weights, 1)' / n;
  xnorm(xnorm == 0) = 1;
  residual = y - X * beta;
  for iter = 1:opts.MaxIter
    old = beta;
    for j = 1:length(beta)
      residual = residual + X(:, j) * beta(j);
      rho = sum(weights .* X(:, j) .* residual) / n;
      beta(j) = softThresholdLocal(rho, lambda * opts.Alpha) ...
        / (xnorm(j) + lambda * (1 - opts.Alpha));
      residual = residual - X(:, j) * beta(j);
    end
    if norm(beta - old) <= opts.RelTol * max(norm(old), 1)
      return
    end
  end
end
%=============================================================================
function value = softThresholdLocal(value, threshold)
  value = sign(value) .* max(abs(value) - threshold, 0);
end
%=============================================================================
function [beta, intercept] = restoreScaleLocal(beta, xmean, xscale, ymean, opts)
  beta = beta ./ xscale(:);
  if opts.Intercept
    intercept = ymean - xmean * beta;
  else
    intercept = 0;
  end
end
%=============================================================================
function FitInfo = fitInfoLocal(B, y, X, lambda, intercept, opts, iterations)
  FitInfo = struct();
  FitInfo.Intercept = intercept;
  FitInfo.Lambda = lambda;
  FitInfo.Alpha = opts.Alpha;
  FitInfo.DF = sum(B ~= 0, 1);
  yhat = X * B + repmat(intercept, length(y), 1);
  FitInfo.MSE = mean((repmat(y, 1, size(B, 2)) - yhat) .^ 2, 1);
  FitInfo.NumIterations = iterations;
end
%=============================================================================
function value = parseLambdaLocal(value)
  if ~(isnumeric(value) && isreal(value) && (isvector(value) || isempty(value)) ...
      && all(isfinite(value)) && all(value >= 0))
    error('Nelson:statistics:LAMBDANonnegativeNumericVector', '%s must be a nonnegative numeric vector.', 'LAMBDA');
  end
  value = double(value(:).');
end
%=============================================================================
function value = parseLambdaRatioLocal(value)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) ...
      && value >= 0 && value < 1)
    error('Nelson:statistics:LAMBDARATIORange01', 'LAMBDARATIO must be in the range [0,1).');
  end
  value = double(value);
end
%=============================================================================
function value = parsePositiveScalarLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) && value > 0)
    error('Nelson:statistics:mustBePositive', '%s must be a positive scalar.', name);
  end
  value = double(value);
end
%=============================================================================
function value = parsePositiveIntegerLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) ...
      && value == fix(value) && value > 0)
    error('Nelson:statistics:mustBePositiveInteger', '%s must be a positive integer scalar.', name);
  end
  value = double(value);
end
%=============================================================================
function value = parseLogicalScalarLocal(value, name)
  if ~((isnumeric(value) || islogical(value)) && isreal(value) && isscalar(value) ...
      && (value == 0 || value == 1))
    error('Nelson:validators:mustBeLogicalScalar', '%s must be a logical scalar.', name);
  end
  value = logical(value);
end
%=============================================================================
function weights = parseWeightsLocal(value, n)
  if ~(isnumeric(value) && isreal(value) && isvector(value) && length(value) == n)
    error('Nelson:statistics:weightsNumericVectorOneValue', '%s must be a numeric vector with one value per observation.', 'WEIGHTS');
  end
  weights = double(value(:));
  if any(isnan(weights)) || any(weights < 0) || all(weights == 0)
    error('Nelson:statistics:WEIGHTSContainNonnegativeValuesLeast', 'WEIGHTS must contain nonnegative values with at least one positive value.');
  end
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [h, p, kstat, critval] = lillietest(x, varargin)
  narginchk(1, Inf);
  nargoutchk(0, 4);
  opts = parseOptionsLocal(convertStringToCharArgs(varargin));
  values = validateSampleLocal(x);
  [probabilities, n] = fittedProbabilitiesLocal(values, opts.Distribution);
  kstat = kolmogorovStatisticLocal(probabilities);
  p = lilliePValueLocal(kstat, n);
  critval = criticalValueLocal(opts.Alpha, n);
  h = kstat > critval;
  opts.MCTol;
end
%=============================================================================
function opts = parseOptionsLocal(args)
  opts = struct('Alpha', 0.05, 'Distribution', 'normal', 'MCTol', []);
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  names = {'alpha', 'distribution', 'mctol'};
  k = 1;
  while k <= length(args)
    name = matchedNameLocal(args{k}, names);
    switch name
      case 'alpha'
        opts.Alpha = scalarInRangeLocal(args{k + 1}, 'ALPHA');
      case 'distribution'
        opts.Distribution = distributionNameLocal(args{k + 1});
      case 'mctol'
        opts.MCTol = scalarInRangeLocal(args{k + 1}, 'MCTOL');
    end
    k = k + 2;
  end
  if isempty(opts.MCTol) && (opts.Alpha < 0.001 || opts.Alpha > 0.5)
    error('Nelson:statistics:ALPHARange00010', 'ALPHA must be in the range [0.001,0.5] when MCTOL is not specified.');
  end
end
%=============================================================================
function name = matchedNameLocal(value, names)
  if ~(ischar(value) || (isstring(value) && isscalar(value)))
    error('Nelson:statistics:nameValueArgumentNameText', 'Name-value argument name must be text.');
  end
  text = lower(char(value));
  matches = names(startsWith(names, text));
  if length(matches) ~= 1
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
  name = matches{1};
end
%=============================================================================
function name = distributionNameLocal(value)
  if ~(ischar(value) || (isstring(value) && isscalar(value)))
    error('Nelson:statistics:DISTRIBUTIONText', 'DISTRIBUTION must be text.');
  end
  text = lower(char(value));
  switch text
    case {'normal', 'norm'}
      name = 'normal';
    case {'exponential', 'exp'}
      name = 'exponential';
    case {'extreme value', 'ev', 'extremevalue'}
      name = 'extreme value';
    otherwise
      error('Nelson:statistics:DISTRIBUTIONUnsupportedValue', '%s has an unsupported value.', 'DISTRIBUTION');
  end
end
%=============================================================================
function values = validateSampleLocal(x)
  if ~(isnumeric(x) && isreal(x) && ~issparse(x) && isvector(x))
    error('Nelson:statistics:xRealNumericVector', '%s must be a real numeric vector.', 'X');
  end
  values = double(x(:));
  values = values(~isnan(values));
  if length(values) < 4
    error('Nelson:statistics:xContainLeastFourNon', 'X must contain at least four non-NaN observations.');
  end
end
%=============================================================================
function [probabilities, n] = fittedProbabilitiesLocal(values, distribution)
  values = sort(values(:));
  n = length(values);
  switch distribution
    case 'normal'
      sigma = std(values, 0);
      if sigma <= 0
        probabilities = zeros(size(values));
      else
        probabilities = normcdf((values - mean(values)) / sigma);
      end
    case 'exponential'
      if any(values < 0)
        error('Nelson:statistics:xNonnegativeExponentialDistribution', 'X must be nonnegative for the exponential distribution.');
      end
      mu = mean(values);
      probabilities = 1 - exp(-values / mu);
    otherwise
      sigma = std(values, 0) * sqrt(6) / pi;
      if sigma <= 0
        probabilities = zeros(size(values));
      else
        mu = mean(values) - 0.577215664901533 * sigma;
        probabilities = 1 - exp(-exp((values - mu) / sigma));
      end
  end
  probabilities = min(max(probabilities, 0), 1);
end
%=============================================================================
function kstat = kolmogorovStatisticLocal(probabilities)
  n = length(probabilities);
  upper = (1:n)' / n - probabilities;
  lower = probabilities - (0:n - 1)' / n;
  kstat = max(max(upper), max(lower));
end
%=============================================================================
function p = lilliePValueLocal(kstat, n)
  z = kstat * (sqrt(n) - 0.01 + 0.85 / sqrt(n));
  if z <= 0.302
    p = 1;
  elseif z <= 0.5
    p = polyval([81.218052 -138.55152 80.709644 -19.828315 2.76773], z);
  elseif z <= 0.9
    p = polyval([-32.355711 94.029866 -97.490286 40.662806 -4.901232], z);
  elseif z <= 1.31
    p = polyval([2.423045 -12.234627 23.186922 -19.558097 6.198765], z);
  else
    p = 0;
  end
  p = min(max(p, 0.001), 0.5);
end
%=============================================================================
function critval = criticalValueLocal(alpha, n)
  lo = 0;
  hi = 1;
  for k = 1:60
    mid = (lo + hi) / 2;
    if lilliePValueLocal(mid, n) > alpha
      lo = mid;
    else
      hi = mid;
    end
  end
  critval = hi;
end
%=============================================================================
function value = scalarInRangeLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && value > 0 && value < 1)
    error('Nelson:statistics:mustBeInRange', '%s must be a scalar in the range (0,1).', name);
  end
  value = double(value);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = mad(x, varargin)
  narginchk(1, 3);
  nargoutchk(0, 1);
  if isempty(x)
    y = NaN;
    return
  end
  [flag, dims, allValues] = parseInputsLocal(x, varargin);
  if allValues
    y = madVectorLocal(double(x(:)), flag);
  else
    y = madAlongDimensionsLocal(double(x), flag, dims);
  end
end
%=============================================================================
function [flag, dims, allValues] = parseInputsLocal(x, args)
  if ~(isnumeric(x) && isreal(x) && ~issparse(x))
    error('Nelson:statistics:xMustBeRealArray', '%s must be a real numeric array.', 'X');
  end
  flag = 0;
  dims = firstNonsingletonLocal(size(x));
  allValues = false;
  if isempty(args)
    return
  end
  first = args{1};
  if isTextScalarLocal(first) || (isnumeric(first) && ~isscalar(first))
    [dims, allValues] = parseDimensionLocal(first);
  else
    flag = parseFlagLocal(first);
  end
  if length(args) >= 2
    [dims, allValues] = parseDimensionLocal(args{2});
  end
end
%=============================================================================
function flag = parseFlagLocal(value)
  if ~(isnumeric(value) || islogical(value)) || ~isscalar(value) || ~(value == 0 || value == 1)
    error('Nelson:statistics:invalidFlag', '%s must be 0 or 1.', 'FLAG');
  end
  flag = double(value);
end
%=============================================================================
function [dims, allValues] = parseDimensionLocal(value)
  allValues = false;
  if isTextScalarLocal(value)
    if strcmpi(char(value), 'all')
      dims = [];
      allValues = true;
      return
    end
    error('Nelson:statistics:invalidDimensionArg:dimensionArgumentAPositiveIntegerScalar', 'Dimension argument must be a positive integer scalar, vector, or ''all''.');
  end
  if ~(isnumeric(value) && isreal(value) && isvector(value) && all(value == fix(value)) ...
      && all(value >= 1))
    error('Nelson:statistics:invalidDimensionArg:dimensionArgumentAPositiveIntegerScalar', 'Dimension argument must be a positive integer scalar, vector, or ''all''.');
  end
  dims = unique(double(value(:).'), 'stable');
end
%=============================================================================
function y = madAlongDimensionsLocal(x, flag, dims)
  originalRank = max(2, length(size(x)));
  sz = size(x);
  nd = max([length(sz), max(dims)]);
  sz(end + 1:nd) = 1;
  keepDims = setdiff(1:nd, dims, 'stable');
  perm = [dims, keepDims];
  xp = permute(reshape(x, sz), perm);
  psize = size(xp);
  psize(end + 1:nd) = 1;
  n = prod(psize(1:length(dims)));
  cols = prod(psize(length(dims) + 1:end));
  xr = reshape(xp, n, cols);
  values = NaN(1, cols);
  for k = 1:cols
    values(k) = madVectorLocal(xr(:, k), flag);
  end
  outSize = sz;
  outSize(dims) = 1;
  outSize = outSize(1:originalRank);
  permutedOutSize = [ones(1, length(dims)), psize(length(dims) + 1:end)];
  y = ipermute(reshape(values, permutedOutSize), perm);
  y = reshape(y, outSize);
end
%=============================================================================
function value = madVectorLocal(values, flag)
  values = values(~isnan(values));
  if isempty(values)
    value = NaN;
    return
  end
  if flag == 0
    center = mean(values);
    value = mean(abs(values - center));
  else
    center = median(values);
    value = median(abs(values - center));
  end
end
%=============================================================================
function dim = firstNonsingletonLocal(sz)
  dim = 1;
  for k = 1:length(sz)
    if sz(k) ~= 1
      dim = k;
      return
    end
  end
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function d2 = mahal(Y, X)
  narginchk(2, 2);
  nargoutchk(0, 1);
  [Y, X, castSingle] = validateInputsLocal(Y, X);
  if size(Y, 1) == 0
    d2 = zeros(0, 1);
    if castSingle
      d2 = single(d2);
    end
    return
  end
  center = mean(X, 1);
  C = cov(X);
  D = Y - repmat(center, size(Y, 1), 1);
  solved = D / C;
  d2 = sum(solved .* D, 2);
  if castSingle
    d2 = single(d2);
  end
end
%=============================================================================
function [Y, X, castSingle] = validateInputsLocal(Y, X)
  if ~(isnumeric(Y) && isreal(Y) && ~issparse(Y) && ndims(Y) == 2)
    error('Nelson:statistics:yRealNumericMatrix', '%s must be a real numeric matrix.', 'Y');
  end
  if ~(isnumeric(X) && isreal(X) && ~issparse(X) && ndims(X) == 2)
    error('Nelson:statistics:xRealNumericMatrix', '%s must be a real numeric matrix.', 'X');
  end
  if isempty(X)
    error('Nelson:statistics:xYNonemptyMatrices', 'X and Y must be nonempty matrices.');
  end
  if size(Y, 2) ~= size(X, 2)
    error('Nelson:statistics:xyColumnMismatch', 'X and Y must have the same number of columns.');
  end
  if size(X, 1) <= size(X, 2)
    error('Nelson:statistics:xMoreRowsColumns', 'X must have more rows than columns.');
  end
  castSingle = isa(Y, 'single') && isa(X, 'single');
  Y = double(Y);
  X = double(X);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [Y, stress, disparities] = mdscale(D, p, varargin)
  narginchk(2, Inf);
  nargoutchk(0, 3);
  [D, opts] = parseInputsLocal(D, p, convertStringToCharArgs(varargin));
  [bestY, bestStress, bestDisparities] = runReplicatesLocal(D, opts);
  Y = bestY;
  stress = bestStress;
  disparities = bestDisparities;
end
%=============================================================================
function [D, opts] = parseInputsLocal(D, p, args)
  D = parseDissimilaritiesLocal(D);
  opts = defaultOptionsLocal(size(D, 1));
  opts = parseNameValuesLocal(opts, args);
  opts.p = parseDimensionLocal(p, opts.Start, size(D, 1));
  opts.Weights = parseWeightsLocal(opts.Weights, D);
  opts.Replicates = parseReplicatesLocal(opts.Replicates, opts.Start);
  opts.Options = parseOptionsLocal(opts.Options);
  D = similarityToDissimilarityLocal(D);
  if any(isnan(D(:)))
    opts.Weights(isnan(D)) = 0;
    D(isnan(D)) = 0;
  end
  validateStartLocal(opts.Start, size(D, 1), opts.p, opts.Replicates);
  zeroWeights = opts.Weights == 0;
  zeroWeights(1:size(D, 1) + 1:end) = false;
  if isTextScalarLocal(opts.Start) && strcmpi(char(opts.Start), 'cmdscale') ...
      && any(zeroWeights(:))
    error('Nelson:statistics:startCmdscaleValidZeroWeights', 'Start cmdscale is not valid with zero weights.');
  end
end
%=============================================================================
function opts = defaultOptionsLocal(n)
  opts = struct('Criterion', 'stress', 'Weights', ones(n), ...
    'Start', 'cmdscale', 'Replicates', [], ...
    'Options', statset('Display', 'off', 'MaxIter', 200, ...
    'TolFun', 1e-4, 'TolX', 1e-4), 'p', []);
end
%=============================================================================
function opts = parseNameValuesLocal(opts, args)
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  for k = 1:2:length(args)
    if ~isTextScalarLocal(args{k})
      error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Name');
    end
    name = lower(char(args{k}));
    switch name
      case 'criterion'
        opts.Criterion = parseCriterionLocal(args{k + 1});
      case 'weights'
        opts.Weights = args{k + 1};
      case 'start'
        opts.Start = args{k + 1};
      case 'replicates'
        opts.Replicates = args{k + 1};
      case 'options'
        opts.Options = args{k + 1};
      otherwise
        error('Nelson:statistics:unknownOption', 'Unknown option.');
    end
  end
end
%=============================================================================
function value = parseCriterionLocal(value)
  choices = {'stress', 'sstress', 'metricstress', 'metricsstress', 'sammon', 'strain'};
  if ~isTextScalarLocal(value)
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Criterion');
  end
  value = lower(char(value));
  matches = choices(strncmp(choices, value, length(value)));
  if isempty(matches)
    error('Nelson:statistics:invalidCriterionValue', 'Invalid %s value.', 'Criterion');
  end
  if length(matches) > 1
    error('Nelson:statistics:ambiguousValue', 'Ambiguous %s value.', 'Criterion');
  end
  value = matches{1};
end
%=============================================================================
function D = parseDissimilaritiesLocal(D)
  if ~(isnumeric(D) && isreal(D) && ~issparse(D) && ndims(D) == 2)
    error('Nelson:statistics:dRealNumericVectorMatrix', '%s must be a real numeric vector or matrix.', 'D');
  end
  D = double(D);
  if any(isinf(D(:))) || any(D(:) < 0)
    error('Nelson:statistics:dContainNonnegativeFiniteDissimilarities', 'D must contain nonnegative finite dissimilarities.');
  end
  if isvector(D) && ~(size(D, 1) == size(D, 2))
    D = vectorToSquareLocal(D(:)', _('D must be square or a valid distance vector.'));
  elseif size(D, 1) ~= size(D, 2)
    error('Nelson:statistics:dSquareValidDistanceVector', 'D must be square or a valid distance vector.');
  end
  validateDMatrixLocal(D);
end
%=============================================================================
function D = vectorToSquareLocal(v, message)
  m = length(v);
  n = (1 + sqrt(1 + 8 * m)) / 2;
  if floor(n) ~= n
    error('Nelson:statistics:sizeMismatch', message);
  end
  D = zeros(n, n);
  idx = 1;
  for j = 2:n
    for i = 1:j - 1
      D(i, j) = v(idx);
      D(j, i) = v(idx);
      idx = idx + 1;
    end
  end
end
%=============================================================================
function validateDMatrixLocal(D)
  if isempty(D)
    error('Nelson:statistics:dContainLeastOnePoint', 'D must contain at least one point.');
  end
  if isSimilarityLocal(D) || isUpperTriangularLocal(D)
    return
  end
  if ~isSymmetricWithNaNLocal(D)
    error('Nelson:statistics:dSymmetricUpperTriangular', 'D must be symmetric or upper triangular.');
  end
  diagonal = diag(D);
  if any(~isnan(diagonal) & abs(diagonal) > 100 * eps)
    error('Nelson:statistics:dZerosDiagonal', 'D must have zeros on the diagonal.');
  end
end
%=============================================================================
function D = similarityToDissimilarityLocal(D)
  if isSimilarityLocal(D)
    D = sqrt(max(0, 1 - D));
    D(1:size(D, 1) + 1:end) = 0;
  elseif isUpperTriangularLocal(D)
    D = D + D';
  end
end
%=============================================================================
function tf = isSimilarityLocal(D)
  diagonal = diag(D);
  offDiagonal = D - diag(diagonal);
  finiteOff = offDiagonal(~isnan(offDiagonal));
  tf = all(abs(diagonal - 1) <= 100 * eps) && isSymmetricWithNaNLocal(D) ...
    && all(finiteOff(:) >= 0) && all(finiteOff(:) <= 1 + 100 * eps);
end
%=============================================================================
function tf = isUpperTriangularLocal(D)
  diagonal = diag(D);
  lower = tril(D, -1);
  upper = triu(D, 1);
  tf = all(abs(diagonal(~isnan(diagonal))) <= 100 * eps) ...
    && all(abs(lower(~isnan(lower))) <= 100 * eps) ...
    && any(upper(~isnan(upper)) > 0);
end
%=============================================================================
function tf = isSymmetricWithNaNLocal(D)
  tolerance = 100 * eps(max(1, max(abs(D(~isnan(D))))));
  difference = abs(D - D');
  missing = isnan(D) & isnan(D');
  tf = all(difference(~missing) <= tolerance | isnan(difference(~missing)));
end
%=============================================================================
function p = parseDimensionLocal(p, start, n)
  if isempty(p)
    if isnumeric(start) && ndims(start) >= 2
      p = size(start, 2);
      return
    end
    error('Nelson:statistics:pSpecifiedUnlessStartNumeric', 'p must be specified unless Start is a numeric matrix.');
  end
  if ~(isnumeric(p) && isreal(p) && isscalar(p) && isfinite(p) ...
      && floor(p) == p && p >= 1 && p <= n)
    error('Nelson:statistics:pIntegerScalarBetween1', 'p must be an integer scalar between 1 and the number of points.');
  end
  p = double(p);
end
%=============================================================================
function W = parseWeightsLocal(W, D)
  if ~(isnumeric(W) && isreal(W) && ~issparse(W) && ndims(W) == 2)
    error('Nelson:statistics:weightsRealNumericVectorMatrix', '%s must be a real numeric vector or matrix.', 'Weights');
  end
  W = double(W);
  if isvector(W) && ~(size(W, 1) == size(W, 2))
    W = vectorToSquareLocal(W(:)', _('Weights must have the same size as D.'));
  elseif ~isequal(size(W), size(D))
    error('Nelson:statistics:weightsSameSizeD', 'Weights must have the same size as D.');
  end
  if any(~isfinite(W(:))) || any(W(:) < 0)
    error('Nelson:statistics:weightsContainNonnegativeFiniteValues', '%s must contain nonnegative finite values.', 'Weights');
  end
  if ~isSymmetricWithNaNLocal(W)
    error('Nelson:statistics:weightsSymmetric', '%s must be symmetric.', 'Weights');
  end
  W(1:size(W, 1) + 1:end) = 0;
end
%=============================================================================
function replicates = parseReplicatesLocal(replicates, start)
  if isempty(replicates)
    if isnumeric(start) && ndims(start) == 3
      replicates = size(start, 3);
    else
      replicates = 1;
    end
    return
  end
  if ~(isnumeric(replicates) && isreal(replicates) && isscalar(replicates) ...
      && isfinite(replicates) && floor(replicates) == replicates && replicates >= 0)
    error('Nelson:statistics:replicatesNonnegativeIntegerScalar', '%s must be a nonnegative integer scalar.', 'Replicates');
  end
  replicates = double(replicates);
end
%=============================================================================
function options = parseOptionsLocal(options)
  if ~(isstruct(options) && isscalar(options))
    error('Nelson:statistics:invalidOptions', '%s must be a scalar structure.', 'Options');
  end
  displayValue = statget(options, 'Display', 'off');
  if ~isTextScalarLocal(displayValue)
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Options Display');
  end
  options.Display = lower(char(displayValue));
  options.MaxIter = statget(options, 'MaxIter', 200);
  options.TolFun = statget(options, 'TolFun', 1e-4);
  options.TolX = statget(options, 'TolX', 1e-4);
  if ~any(strcmp(options.Display, {'off', 'final', 'iter'}))
    error('Nelson:statistics:optionsDisplayInvalidValue', '%s has an invalid value.', 'Options Display');
  end
  if ~isPositiveIntegerLocal(options.MaxIter)
    error('Nelson:statistics:optionsMaxIterPositiveIntegerScalar', '%s must be a positive integer scalar.', 'Options MaxIter');
  end
  if ~isPositiveScalarLocal(options.TolFun) || ~isPositiveScalarLocal(options.TolX)
    error('Nelson:statistics:optionsTolerancesPositiveScalarValues', 'Options tolerances must be %s scalar values.', 'positive');
  end
end
%=============================================================================
function validateStartLocal(start, n, p, replicates)
  if isTextScalarLocal(start)
    value = lower(char(start));
    if ~any(strcmp(value, {'cmdscale', 'random'}))
      error('Nelson:statistics:startInvalidValue', '%s has an invalid value.', 'Start');
    end
    return
  end
  if ~(isnumeric(start) && isreal(start) && ~issparse(start) && (ndims(start) == 2 || ndims(start) == 3))
    error('Nelson:statistics:startCharacterVectorStringScalar', 'Start must be a character vector, string scalar, matrix, or 3-D array.');
  end
  if size(start, 1) ~= n || size(start, 2) ~= p || any(~isfinite(start(:)))
    error('Nelson:statistics:startCompatibleFiniteNumericValues', 'Start must have compatible finite numeric values.');
  end
  if ndims(start) == 3 && replicates ~= size(start, 3)
    error('Nelson:statistics:replicatesMatchNumberStartPages', 'Replicates must match the number of Start pages.');
  end
end
%=============================================================================
function [bestY, bestStress, bestDisparities] = runReplicatesLocal(D, opts)
  bestStress = Inf;
  bestY = zeros(size(D, 1), opts.p);
  bestDisparities = D;
  if opts.Replicates == 0
    return
  end
  for r = 1:opts.Replicates
    startY = startConfigurationLocal(D, opts, r);
    [Y, stress, disparities, iterations] = fitOneLocal(D, opts, startY);
    if stress < bestStress
      bestStress = stress;
      bestY = Y;
      bestDisparities = disparities;
    end
    displayProgressLocal(opts.Options.Display, 'final', iterations, stress);
  end
end
%=============================================================================
function Y = startConfigurationLocal(D, opts, replicate)
  n = size(D, 1);
  if isnumeric(opts.Start)
    if ndims(opts.Start) == 3
      Y = opts.Start(:, :, replicate);
    else
      Y = opts.Start;
    end
  elseif strcmpi(char(opts.Start), 'random')
    scale = max(D(:));
    if scale == 0
      scale = 1;
    end
    Y = randn(n, opts.p) * scale / sqrt(opts.p);
  else
    Y = cmdscale(D, opts.p);
    if size(Y, 2) < opts.p
      Y(:, end + 1:opts.p) = 0;
    end
  end
  Y = centerConfigurationLocal(Y);
end
%=============================================================================
function [Y, stress, disparities, iterations] = fitOneLocal(D, opts, Y)
  W = opts.Weights;
  disparities = initialDisparitiesLocal(D, opts.Criterion, W);
  stress = stressLocal(D, Y, W, disparities, opts.Criterion);
  for iterations = 1:opts.Options.MaxIter
    distances = distancesLocal(Y);
    if isNonmetricLocal(opts.Criterion)
      disparities = disparitiesLocal(D, distances, W);
    end
    Ynew = smacofStepLocal(Y, W, disparities);
    Ynew = centerConfigurationLocal(Ynew);
    newStress = stressLocal(D, Ynew, W, disparities, opts.Criterion);
    displayProgressLocal(opts.Options.Display, 'iter', iterations, newStress);
    if newStress > stress
      break
    end
    if shouldStopLocal(Y, Ynew, stress, newStress, opts.Options)
      Y = Ynew;
      stress = newStress;
      break
    end
    Y = Ynew;
    stress = newStress;
  end
end
%=============================================================================
function disparities = initialDisparitiesLocal(D, criterion, W)
  if isNonmetricLocal(criterion)
    distances = D;
    disparities = disparitiesLocal(D, distances, W);
  else
    disparities = D;
  end
end
%=============================================================================
function tf = isNonmetricLocal(criterion)
  tf = strcmp(criterion, 'stress') || strcmp(criterion, 'sstress');
end
%=============================================================================
function distances = distancesLocal(Y)
  n = size(Y, 1);
  gram = sum(Y .^ 2, 2);
  D2 = repmat(gram, 1, n) + repmat(gram', n, 1) - 2 * (Y * Y');
  distances = sqrt(max(D2, 0));
  distances(1:n + 1:end) = 0;
end
%=============================================================================
function Ynew = smacofStepLocal(Y, W, disparities)
  distances = distancesLocal(Y);
  ratio = zeros(size(distances));
  valid = distances > eps & W > 0;
  ratio(valid) = W(valid) .* disparities(valid) ./ distances(valid);
  B = -ratio;
  B(1:size(B, 1) + 1:end) = -sum(B, 2);
  rowWeights = sum(W, 2) + max(W, [], 2);
  Ynew = zeros(size(Y));
  active = rowWeights > 0;
  Ynew(active, :) = (B(active, :) * Y) ./ repmat(rowWeights(active), 1, size(Y, 2));
end
%=============================================================================
function disparities = disparitiesLocal(D, distances, W)
  n = size(D, 1);
  mask = triu(W > 0 & ~isnan(D), 1);
  delta = D(mask);
  dist = distances(mask);
  weights = W(mask);
  [delta, order] = sort(delta);
  dist = dist(order);
  weights = weights(order);
  fitted = isotonicLocal(dist(:), weights(:));
  scale = sqrt(sum(weights .* dist(:) .^ 2) / max(sum(weights .* fitted(:) .^ 2), realmin));
  fitted = fitted * scale;
  disparities = zeros(n);
  linear = find(mask);
  inverseOrder(order) = 1:length(order);
  disparities(linear) = fitted(inverseOrder);
  disparities = disparities + disparities';
end
%=============================================================================
function y = isotonicLocal(x, w)
  values = zeros(0, 1);
  weights = zeros(0, 1);
  counts = zeros(0, 1);
  for i = 1:length(x)
    values(end + 1, 1) = x(i);
    weights(end + 1, 1) = w(i);
    counts(end + 1, 1) = 1;
    while length(values) > 1 && values(end - 1) > values(end)
      totalWeight = weights(end - 1) + weights(end);
      values(end - 1) = (values(end - 1) * weights(end - 1) + values(end) * weights(end)) / totalWeight;
      weights(end - 1) = totalWeight;
      counts(end - 1) = counts(end - 1) + counts(end);
      values(end) = [];
      weights(end) = [];
      counts(end) = [];
    end
  end
  y = zeros(length(x), 1);
  pos = 1;
  for i = 1:length(values)
    y(pos:pos + counts(i) - 1) = values(i);
    pos = pos + counts(i);
  end
end
%=============================================================================
function stress = stressLocal(D, Y, W, disparities, criterion)
  distances = distancesLocal(Y);
  mask = triu(W > 0, 1);
  d = distances(mask);
  delta = D(mask);
  dispv = disparities(mask);
  w = W(mask);
  switch criterion
    case {'stress', 'metricstress'}
      target = metricTargetLocal(criterion, delta, dispv);
      stress = sqrt(sum(w .* (d - target) .^ 2) / max(sum(w .* d .^ 2), realmin));
    case {'sstress', 'metricsstress'}
      target = metricTargetLocal(criterion, delta, dispv);
      stress = sqrt(sum(w .* (d .^ 2 - target .^ 2) .^ 2) / max(sum(w .* d .^ 4), realmin));
    case 'sammon'
      valid = delta > 0;
      stress = sum(w(valid) .* ((d(valid) - delta(valid)) .^ 2) ./ delta(valid)) ...
        / max(sum(w(valid) .* delta(valid)), realmin);
    case 'strain'
      stress = strainStressLocal(D, Y, W);
  end
end
%=============================================================================
function target = metricTargetLocal(criterion, delta, disparities)
  if strcmp(criterion, 'stress') || strcmp(criterion, 'sstress')
    target = disparities;
  else
    target = delta;
  end
end
%=============================================================================
function stress = strainStressLocal(D, Y, W)
  B = -0.5 * centerMatrixLocal(D .^ 2);
  G = Y * Y';
  mask = W > 0;
  stress = sum((B(mask) - G(mask)) .^ 2) / max(sum(B(mask) .^ 2), realmin);
end
%=============================================================================
function B = centerMatrixLocal(A)
  n = size(A, 1);
  rowMean = mean(A, 2);
  colMean = mean(A, 1);
  totalMean = mean(A(:));
  B = A - repmat(rowMean, 1, n) - repmat(colMean, n, 1) + totalMean;
end
%=============================================================================
function tf = shouldStopLocal(Y, Ynew, stress, newStress, options)
  stressStep = abs(stress - newStress) <= options.TolFun * max(1, abs(stress));
  locationStep = max(abs(Ynew(:) - Y(:))) <= options.TolX * max(1, max(abs(Y(:))));
  tf = stressStep || locationStep;
end
%=============================================================================
function Y = centerConfigurationLocal(Y)
  Y = Y - repmat(mean(Y, 1), size(Y, 1), 1);
end
%=============================================================================
function displayProgressLocal(displayValue, stage, iterations, stress)
  if strcmp(displayValue, 'iter') && strcmp(stage, 'iter')
    disp([int2str(iterations), ' iterations, stress criterion = ', num2str(stress)]);
  elseif strcmp(displayValue, 'final') && strcmp(stage, 'final')
    disp([int2str(iterations), ' iterations, Final stress criterion = ', num2str(stress)]);
  end
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || isStringScalar(value);
end
%=============================================================================
function tf = isPositiveIntegerLocal(value)
  tf = isnumeric(value) && isreal(value) && isscalar(value) ...
    && isfinite(value) && floor(value) == value && value > 0;
end
%=============================================================================
function tf = isPositiveScalarLocal(value)
  tf = isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) && value > 0;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function r = median(x, dim, nanflag, varargin)
  narginchk(1, 3);
  args = {};
  if nargin >= 2
    args{end + 1} = dim;
  end
  if nargin >= 3
    args{end + 1} = nanflag;
  end
  [dim, allValues, omitNaN, hasDim] = medianParseInputs(x, args);
  if isequal(size(x), [0 0]) && ~hasDim
    % median([]) is NaN (with a dimension, [] follows the reduction rule);
    % the class of the input is preserved
    % (integer classes give 0, since NaN cannot be represented).
    r = medianCastResult(NaN, x);
    return
  end
  if allValues
    r = medianCastResult(medianVector(x(:), omitNaN), x);
    return
  end
  if isscalar(dim)
    r = medianAlongDimension(x, dim, omitNaN);
  else
    r = medianAlongDimensions(x, dim, omitNaN);
  end
end
%=============================================================================
function r = medianCastResult(r, x)
  % preserve the class of the input: integer classes are rounded
  % (half away from zero), single stays single.
  if isinteger(x)
    r = cast(round(r), class(x));
  elseif isa(x, 'single')
    r = single(r);
  end
end
%=============================================================================
function [dim, allValues, omitNaN, hasDim] = medianParseInputs(x, args)
  dim = medianFirstNonsingleton(size(x));
  hasDim = false;
  allValues = false;
  omitNaN = false;
  for k = 1:length(args)
    arg = args{k};
    if ischar(arg) || isstring(arg)
      value = char(arg);
      if strcmp(value, 'all')
        allValues = true;
      elseif strcmp(value, 'omitnan')
        omitNaN = true;
      elseif strcmp(value, 'includenan')
        omitNaN = false;
      else
        error('Nelson:statistics:unsupportedMedianOption', 'Unsupported %s.', 'median option');
      end
    elseif isnumeric(arg) && isscalar(arg)
      dim = arg;
      hasDim = true;
    elseif isnumeric(arg) && isvector(arg) && ~isempty(arg)
      if any(arg < 1) || any(arg ~= floor(arg))
        error('Nelson:statistics:dimensionArgumentPositiveIntegerScalar', 'Dimension argument must be %s.', 'a positive integer scalar or vector of positive integers');
      end
      dim = arg;
      hasDim = true;
    else
      error('Nelson:statistics:unsupportedMedianOption', 'Unsupported %s.', 'median option');
    end
  end
end
%=============================================================================
function dim = medianFirstNonsingleton(sz)
  dim = 1;
  for k = 1:length(sz)
    if sz(k) ~= 1
      dim = k;
      return
    end
  end
end
%=============================================================================
function r = medianAlongDimension(x, dim, omitNaN)
  sz = size(x);
  if dim > length(sz)
    r = x;
    return
  end
  perm = 1:length(sz);
  perm([1 dim]) = [dim 1];
  xp = permute(x, perm);
  psz = size(xp);
  n = psz(1);
  cols = prod(psz(2:end));
  xr = reshape(xp, n, cols);
  values = zeros(1, cols);
  for k = 1:cols
    values(k) = medianVector(xr(:, k), omitNaN);
  end
  outSize = psz;
  outSize(1) = 1;
  r = ipermute(reshape(values, outSize), perm);
  r = medianCastResult(r, x);
end
%=============================================================================
function r = medianAlongDimensions(x, dims, omitNaN)
  % median over a vector of dimensions: gather every element spanning the
  % listed dimensions, then take a single median over them. This is not the
  % same as successive single-dimension medians, so the elements are collected
  % by permuting the reduced dimensions to the front and collapsing them.
  sz = size(x);
  nd = numel(sz);
  isReduced = false(1, nd);
  for d = dims(:)'
    if d >= 1 && d <= nd
      isReduced(d) = true;
    end
  end
  reduced = find(isReduced);
  kept = find(~isReduced);
  if numel(reduced) <= 1
    if isempty(reduced)
      dsel = dims(1);
    else
      dsel = reduced(1);
    end
    r = medianAlongDimension(x, dsel, omitNaN);
    return
  end
  perm = [reduced, kept];
  xp = permute(x, perm);
  reducedCount = prod(sz(reduced));
  keptCount = prod(sz(kept));
  xr = reshape(xp, reducedCount, keptCount);
  values = zeros(1, keptCount);
  for k = 1:keptCount
    values(k) = medianVector(xr(:, k), omitNaN);
  end
  outSize = sz;
  outSize(reduced) = 1;
  r = reshape(values, outSize);
  r = medianCastResult(r, x);
end
%=============================================================================
function value = medianVector(values, omitNaN)
  values = values(:);
  if omitNaN
    values = values(~isnan(values));
  elseif any(isnan(values))
    value = NaN;
    return
  end
  n = length(values);
  if n == 0
    value = NaN;
    return
  end
  values = sort(values);
  if mod(n, 2) == 1
    value = values((n + 1) / 2);
  else
    value = (double(values(n / 2)) + double(values(n / 2 + 1))) / 2;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [M, F, C] = mode(A, dim)
  narginchk(1, 2);
  nargoutchk(0, 3);
  hasDim = nargin == 2;
  if ~hasDim
    dim = firstNonsingletonLocal(size(A));
  end
  if isequal(size(A), [0 0]) && ~hasDim
    % mode([]) is NaN (with a dimension, [] follows the reduction rule)
    M = modeClassLocal(NaN, A);
    F = 0;
    C = {reshape(A([]), 0, 1)};
    return
  end
  [M, F, C] = modeAlongDimensionLocal(A, dim);
end
%=============================================================================
function [M, F, C] = modeAlongDimensionLocal(A, dim)
  perm = 1:ndims(A);
  perm([1 dim]) = [dim 1];
  Ap = permute(A, perm);
  sz = size(Ap);
  n = sz(1);
  cols = prod(sz(2:end));
  Ar = reshape(Ap, n, cols);
  Mv = modeClassLocal(zeros(1, cols), A);
  Fv = zeros(1, cols);
  Cv = cell(1, cols);
  for k = 1:cols
    [Mv(k), Fv(k), Cv{k}] = modeVectorLocal(Ar(:, k));
  end
  outSize = sz;
  outSize(1) = 1;
  M = ipermute(reshape(Mv, outSize), perm);
  F = ipermute(reshape(Fv, outSize), perm);
  C = ipermute(reshape(Cv, outSize), perm);
end
%=============================================================================
function [m, f, c] = modeVectorLocal(values)
  values = values(:);
  if isempty(values)
    m = NaN;
    f = 0;
    c = reshape(values, 0, 1);
    return
  end
  sortedValues = sort(values);
  runStarts = [1; find(diff(sortedValues) ~= 0) + 1];
  runLengths = diff([runStarts; length(sortedValues) + 1]);
  [f, idx] = max(runLengths);
  m = sortedValues(runStarts(idx));
  % C contains all values with the maximum frequency (compatible with the reference implementation)
  c = sortedValues(runStarts(runLengths == f));
  c = c(:);
end
%=============================================================================
function M = modeClassLocal(M, A)
  % M keeps the class of single and integer inputs (integer classes give 0
  % for an empty set, since NaN cannot be represented).
  if isinteger(A) || isa(A, 'single')
    M = cast(M, class(A));
  end
end
%=============================================================================
function dim = firstNonsingletonLocal(sz)
  dim = 1;
  for k = 1:length(sz)
    if sz(k) ~= 1
      dim = k;
      return
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function m = moment(x, order, varargin)
  narginchk(2, 3);
  nargoutchk(0, 1);
  if ~(isnumeric(x) && isreal(x) && ~issparse(x))
    error('Nelson:statistics:xMustBeRealArray', '%s must be a real numeric array.', 'X');
  end
  order = parseOrderLocal(order);
  if isempty(x)
    m = cast(NaN, class(x));
    return
  end
  [dims, allValues] = parseDimensionLocal(x, varargin);
  if allValues
    m = momentVectorLocal(double(x(:)), order);
  else
    m = momentAlongDimensionsLocal(double(x), order, dims);
  end
  if isa(x, 'single')
    m = single(m);
  end
end
%=============================================================================
function order = parseOrderLocal(value)
  if ~(isnumeric(value) && isreal(value) && isscalar(value)) ...
      || ~isfinite(value) || value < 1 || value ~= fix(value)
    error('Nelson:statistics:ORDERPositiveIntegerScalar', '%s must be a positive integer scalar.', 'ORDER');
  end
  order = double(value);
end
%=============================================================================
function [dims, allValues] = parseDimensionLocal(x, args)
  allValues = false;
  dims = firstNonsingletonLocal(size(x));
  if isempty(args)
    return
  end
  value = args{1};
  if isTextScalarLocal(value)
    if strcmpi(char(value), 'all')
      dims = [];
      allValues = true;
      return
    end
    error('Nelson:statistics:dimensionPositiveIntegerScalarVector', 'Dimension must be a positive integer scalar, vector, or ''all''.');
  end
  if ~(isnumeric(value) && isreal(value) && isvector(value) && ~isempty(value) ...
      && all(value == fix(value)) && all(value >= 1))
    error('Nelson:statistics:dimensionPositiveIntegerScalarVector', 'Dimension must be a positive integer scalar, vector, or ''all''.');
  end
  dims = unique(double(value(:).'), 'stable');
end
%=============================================================================
function m = momentAlongDimensionsLocal(x, order, dims)
  originalRank = max(2, length(size(x)));
  sz = size(x);
  nd = max([length(sz), max(dims)]);
  sz(end + 1:nd) = 1;
  keepDims = setdiff(1:nd, dims, 'stable');
  perm = [dims, keepDims];
  xp = permute(reshape(x, sz), perm);
  psize = size(xp);
  psize(end + 1:nd) = 1;
  n = prod(psize(1:length(dims)));
  cols = prod(psize(length(dims) + 1:end));
  xr = reshape(xp, n, cols);
  values = NaN(1, cols);
  for k = 1:cols
    values(k) = momentVectorLocal(xr(:, k), order);
  end
  outSize = sz;
  outSize(dims) = 1;
  outSize = outSize(1:originalRank);
  permutedOutSize = [ones(1, length(dims)), psize(length(dims) + 1:end)];
  m = ipermute(reshape(values, permutedOutSize), perm);
  m = reshape(m, outSize);
end
%=============================================================================
function value = momentVectorLocal(values, order)
  center = mean(values);
  value = mean((values - center) .^ order);
end
%=============================================================================
function dim = firstNonsingletonLocal(sz)
  dim = 1;
  for k = 1:length(sz)
    if sz(k) ~= 1
      dim = k;
      return
    end
  end
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
