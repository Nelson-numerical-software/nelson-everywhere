function L = labelmatrix(cc)
  narginchk(1, 1);
  nargoutchk(0, 1);
  L = zeros(cc.ImageSize);
  for k = 1:cc.NumObjects
    L(cc.PixelIdxList{k}) = k;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
