function files = discover_discoverModuleFiles(moduleName, kind)
  try
    testsDir = [modulepath(moduleName), '/tests/'];
  catch
    testsDir = [nelsonroot(), '/modules/', moduleName, '/tests/'];
  end
  files = discover_discoverDirectoryFiles(testsDir, kind);
end
