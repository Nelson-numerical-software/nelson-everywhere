requiremodule('core');
%=============================================================================
missingModule = ['nelson_missing_', strrep(createGUID(), '-', '_')];
asserts.checkerror(['requiremodule(''', missingModule, ''');'], ...
  sprintf(_('%s is not installed.'), ['''', missingModule, ''' ']));
%=============================================================================
% Generated portable test module boundary.
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% catalog = NFlow.internal.acausalCatalog()
%
% Acausal palette N0.2: the single-source component registry. Each entry is a
% curated palette component (a Coselica-parity block) described declaratively:
% its palette name and group, its physical domain, the island block + `kind` it
% lowers to, its physical pins (with the node param each occupies), its
% parameters (palette name -> island param + default + unit), and a one-line
% description for the help pages. Everything downstream is generated from this
% table: the GUI palette manifests (library.json), the help-page skeletons
% (en/fr), the per-block unit-test scaffolds, and the netlist->island lowering.
%
% This is a *catalog* (facts about which components exist and how they map),
% authored clean-room from textbook physics; no Coselica source is copied.
%
% Fields per entry:
%   name        palette display name (Coselica-parity)
%   group       palette group ('Electrical' | 'Thermal' | 'Translational' |
%               'Rotational')
%   domain      physical domain ('electrical'|'thermal'|'translational'|
%               'rotational')
%   island      target island block type ('physicalIsland' |
%               'mechanicalTranslationalIsland')
%   kind        island component `kind`
%   pins        cell of {pinName, nodeField}: the physical pins and which island
%               component node field ('a'|'b'|'c'|'d'|'node') each maps to
%   params      cell of {paletteName, islandName, default, unit}: parameter map
%   signalIn    input-port param name driving a source ('' = none)
%   signalOut   output-port kind for a sensor ('' = none)
%   desc        one-line help description
%=============================================================================
function catalog = acausalCatalog()
  c = {};

  % ---------------------------------------------------------------- Electrical
  c{end + 1} = entry('Ground', 'Electrical', 'electrical', 'physicalIsland', ...
    'ground', {{'p', 'a'}}, {}, '', '', ...
    'Reference node (0 V) for an electrical island.');
  c{end + 1} = entry('Resistor', 'Electrical', 'electrical', 'physicalIsland', ...
    'resistor', {{'p', 'a'}, {'n', 'b'}}, {{'R', 'R', 1000, 'ohm'}}, '', '', ...
    'Ideal linear resistor: i = (v_p - v_n) / R.');
  % Cross-domain: expanded (NFlow.internal.acausalExpand) into an electrical resistor plus
  % a thermal heat-flow source carrying P = v^2 / R; island/kind are placeholders.
  c{end + 1} = entry('HeatingResistor', 'Electrical', 'electrical', 'physicalIsland', ...
    'resistor', {{'p', 'a'}, {'n', 'b'}, {'heatPort', 'a', 'thermal'}}, {{'R', 'R', 1000, 'ohm'}}, '', '', ...
    'Resistor that dissipates its power P = v^2 / R as heat into a thermal port.');
  % Cross-domain electro-mechanical converters (expanded in NFlow.internal.acausalExpand
  % into an electrical back-emf source + ammeter bridged to a rotational/linear
  % flange via the causal signal layer); island/kind are placeholders. Use the DAE
  % solver: the electrical DAE island sits next to a mechanical ODE island.
  c{end + 1} = entry('EMF', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'force', {{'p', 'a'}, {'n', 'b'}, {'flange', 'node'}}, {{'k', 'k', 1, 'N.m/A'}}, '', '', ...
    'Electro-mechanical converter (motor/generator): back-emf v = k w, torque tau = k i.');
  c{end + 1} = entry('TranslationalEMF', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'force', {{'p', 'a'}, {'n', 'b'}, {'flange', 'node'}}, {{'k', 'k', 1, 'N/A'}}, '', '', ...
    'Linear electro-mechanical converter: back-emf v = k v_flange, force F = k i.');
  c{end + 1} = entry('Conductor', 'Electrical', 'electrical', 'physicalIsland', ...
    'conductor', {{'p', 'a'}, {'n', 'b'}}, {{'G', 'G', 1e-3, 'S'}}, '', '', ...
    'Ideal linear conductor: i = G (v_p - v_n).');
  c{end + 1} = entry('VariableResistor', 'Electrical', 'electrical', 'physicalIsland', ...
    'variableResistor', {{'p', 'a'}, {'n', 'b'}}, {}, 'R', '', ...
    'Resistor whose resistance R is set by the input signal.');
