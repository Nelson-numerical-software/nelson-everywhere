%=============================================================================
function value = timeseriesText(value, name)
  if isstring(value)
    value = char(value);
  end
  if ~ischar(value)
    error('Nelson:time:mustBeText', '%s must be text.', name);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function scale = timeseriesUnitDays(units)
  switch lower(units)
    case {'second', 'seconds', 'sec', 'secs'}
      scale = 1 / 86400;
    case {'minute', 'minutes', 'min', 'mins'}
      scale = 1 / 1440;
    case {'hour', 'hours', 'hr', 'hrs'}
      scale = 1 / 24;
    case {'day', 'days'}
      scale = 1;
    otherwise
      scale = 1 / 86400;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function timeseriesValidate(obj)
  dataLength = timeseriesLengthFromData(obj.Data_, obj.IsTimeFirst_);
  timeLength = length(obj.Time_);
  if dataLength ~= timeLength
    error('Nelson:time:dataTimeLengthsMatch', '%s and time lengths must match.', 'Data');
  end
  if ~isempty(obj.Quality_) && numel(obj.Quality_) ~= timeLength
    error('Nelson:time:qualityTimeLengthsMatch', '%s and time lengths must match.', 'Quality');
  end
end
