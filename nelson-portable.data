%=============================================================================
function test_file = resolveModuleTest(tests_dir, test_name)
  test_file = '';
  if ~ischar(test_name) || isempty(test_name)
    return
  end
  [p, f, e] = fileparts(test_name); %#ok<NLS0004>
  if ~isempty(p)
    return
  end
  if isempty(e)
    test_file = [tests_dir, f, '.m'];
  elseif strcmp(e, '.m')
    test_file = [tests_dir, f, e];
  end
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function [status, message, nativeResults] = run_accumulator(accumulator, nbWorkers)
  nbAccumulator = length(accumulator);
  status = zeros(1, nbAccumulator);
  message = cell(1, nbAccumulator);
  nativeResults = emptyNativeResults(nbAccumulator);
  if use_inline_unittest_runner()
    [status, message, nativeResults] = run_accumulator_inline(accumulator);
    return
  end
  if ~canUseNativeRunner()
    error('Nelson:tests_manager:supervisorUnavailable', 'Native test process supervisor unavailable.');
  end
  [executables, processArguments, nativeTimeout, nativeIndex, message] = ...
    collectNativeRunInputs(accumulator, message);
  if ~isempty(nativeIndex)
    nativeJobs = run_process_jobs(executables, processArguments, nativeTimeout, ...
      run_accumulator_job_kind(nativeIndex), nativeIndex, ...
      run_accumulator_job_metadata(accumulator, nativeIndex));
    nativeSubset = run_processes(nativeJobs, nbWorkers);
    for i = 1:length(nativeSubset)
      nativeResults(nativeIndex(i)) = nativeSubset(i);
      status(nativeIndex(i)) = nativeSubset(i).exit_code;
      message{nativeIndex(i)} = nativeRunMessage(nativeSubset(i));
    end
  end
  message = fillEmptyRunMessages(message);
end
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function [status, message, nativeResults] = run_accumulator_inline(accumulator)
  nbAccumulator = length(accumulator);
  status = zeros(1, nbAccumulator);
  message = cell(1, nbAccumulator);
  nativeResults = emptyNativeResults(nbAccumulator);
  [nativeResults.runfile_result] = deal([]);
  for i = 1:nbAccumulator
    if strcmp(accumulator(i).command, 'echo skip')
      message{i} = '';
      continue
    end
    if ~isfile(accumulator(i).filename)
      error('Nelson:tests_manager:fileDoesNotExist', [_('An existing filename expected.'), ' ', accumulator(i).filename]);
    end
    tests_manager_trace('inline', ['run ', accumulator(i).filename]);
    result = runfile_nested(accumulator(i).filename, accumulator(i).options.mpi_mode);
    resetGraphicsIfRequested();
    tests_manager_trace('inline', ['complete ', accumulator(i).filename]);
    nativeResults(i).exit_code = result.r;
    nativeResults(i).timed_out = false;
    nativeResults(i).duration = result.timing;
    nativeResults(i).stdout = result.stdout;
    nativeResults(i).stderr = '';
    nativeResults(i).kind = 'inline';
    nativeResults(i).index = i;
    nativeResults(i).metadata = accumulator(i).filename;
    nativeResults(i).job_id = ['inline_', int2str(i)];
    nativeResults(i).timeout = accumulator(i).launcher_timeout;
    nativeResults(i).reason = inline_reason(result.r);
    nativeResults(i).process_policy = 'inline-runfile';
    nativeResults(i).process_arguments = ...
      '--nousermodules --noipc --withoutfilewatcher -- --noaudio --without_python --without_julia --inline';
    nativeResults(i).runfile_result = result;
    status(i) = result.r;
    message{i} = nativeRunMessage(nativeResults(i));
  end
end
%=============================================================================
function resetGraphicsIfRequested()
  if isTruthyEnvironmentValue('NELSON_UNITTEST_RESET_GRAPHICS') ...
      && exist('close', 'builtin') ~= 0
    close('all');
  end
end
%=============================================================================
function reason = inline_reason(status)
  if status == 0
    reason = 'ok';
  else
    reason = 'exit';
  end
end
