%=============================================================================
function [gx, gy, gz] = volumeGradient(V, x, y, z)
  gx = derivativeAlongDimension(V, x, 2);
  gy = derivativeAlongDimension(V, y, 1);
  gz = derivativeAlongDimension(V, z, 3);
end
%=============================================================================
function d = derivativeAlongDimension(V, coordinates, dim)
  d = zeros(size(V));
  n = size(V, dim);
  for k = 1:n
    [first, second] = derivativeStencil(k, n);
    d = assignDerivativeSlice(d, V, coordinates, dim, k, first, second);
  end
end
%=============================================================================
function [first, second] = derivativeStencil(k, n)
  if k == 1
    first = 1;
    second = 2;
  elseif k == n
    first = n - 1;
    second = n;
  else
    first = k - 1;
    second = k + 1;
  end
end
%=============================================================================
function d = assignDerivativeSlice(d, V, coordinates, dim, k, first, second)
  target = repmat({':'}, 1, ndims(V));
  lower = target;
  upper = target;
  if dim == 1
    target{1} = k;
    lower{1} = first;
    upper{1} = second;
  elseif dim == 2
    target{2} = k;
    lower{2} = first;
    upper{2} = second;
  else
    target{3} = k;
    lower{3} = first;
    upper{3} = second;
  end
  denominator = coordinates(second) - coordinates(first);
  d(target{:}) = (V(upper{:}) - V(lower{:})) / denominator;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [x, y, z] = volumeGridVectors(X, Y, Z, V)
  if nargin == 1
    V = X;
    x = 1:size(V, 2);
    y = 1:size(V, 1);
    z = 1:size(V, 3);
    return
  end
  if isvector(X) && isvector(Y) && isvector(Z)
    x = double(X(:).');
    y = double(Y(:).');
    z = double(Z(:).');
    return
  end
  if ~isequal(size(X), size(Y)) || ~isequal(size(X), size(Z)) || ~isequal(size(X), size(V))
    error('Nelson:volumeGridVectors:invalidGridArrays', 'Grid arrays must have the same size as V.');
  end
  x = double(squeeze(X(1, :, 1))).';
  y = double(squeeze(Y(:, 1, 1))).';
  z = double(squeeze(Z(1, 1, :))).';
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function handles = volumeSliceSurfaces(parent, x, y, z, V, xs, ys, zs, method, surfaceArgs)
  if ~areAxisSlices(xs, ys, zs)
    C = interp3(x, y, z, V, xs, ys, zs, method, NaN);
    handles = surface(parent, xs, ys, zs, C, surfaceArgs{:});
    return
  end
  handles = gobjects(0, 1);
  for k = 1:numel(xs)
    [Xq, Yq, Zq] = xSliceGrid(x, y, z, xs(k));
    C = interp3(x, y, z, V, Xq, Yq, Zq, method, NaN);
    handles(end + 1, 1) = surface(parent, Xq, Yq, Zq, C, surfaceArgs{:});
  end
  for k = 1:numel(ys)
    [Xq, Yq, Zq] = ySliceGrid(x, y, z, ys(k));
    C = interp3(x, y, z, V, Xq, Yq, Zq, method, NaN);
    handles(end + 1, 1) = surface(parent, Xq, Yq, Zq, C, surfaceArgs{:});
  end
  for k = 1:numel(zs)
    [Xq, Yq, Zq] = zSliceGrid(x, y, z, zs(k));
    C = interp3(x, y, z, V, Xq, Yq, Zq, method, NaN);
    handles(end + 1, 1) = surface(parent, Xq, Yq, Zq, C, surfaceArgs{:});
  end
end
%=============================================================================
function [Xq, Yq, Zq] = xSliceGrid(x, y, z, value)
  [Yq, Zq] = ndgrid(y, z);
  Xq = value * ones(size(Yq));
end
%=============================================================================
function [Xq, Yq, Zq] = ySliceGrid(x, y, z, value)
  [Xq, Zq] = ndgrid(x, z);
  Yq = value * ones(size(Xq));
end
%=============================================================================
function [Xq, Yq, Zq] = zSliceGrid(x, y, z, value)
  [Xq, Yq] = meshgrid(x, y);
  Zq = value * ones(size(Xq));
end
%=============================================================================
function tf = areAxisSlices(xs, ys, zs)
  tf = min(size(xs)) <= 1 && min(size(ys)) <= 1 && min(size(zs)) <= 1;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function warnContourNotRendered(Z)
  % A surface with no relief carries no contour line to draw. The two ways that
  % happens do not read alike and each keeps its own warning: data whose finite
  % values are all equal is constant, data holding no finite value at all is
  % not. Only the plotting functions warn; contourc is silent.
  finiteZ = Z(isfinite(Z));
  if isempty(finiteZ)
    warning('Nelson:contour:nonFiniteData', 'Contour not rendered for non-finite ZData.');
  elseif min(finiteZ(:)) == max(finiteZ(:))
    warning('Nelson:contour:constantData', 'Contour not rendered for constant ZData.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = quiver(varargin)
  narginchk(2, 10000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [parent, args] = parseQuiverParent(args);
  [x, y, u, v, args, autoXY] = parseQuiverData(args);
  [scaleArgs, lineArgs, propertyPairs] = parseQuiverTail(args);
  keepBox = quiverKeepBox(parent);
  ax = targetAxes(parent);
  if ~keepBox
    ax.Box = 'on';
  end
  constructorArgs = {'Parent', parentForObject(parent, ax), 'XData', x, 'YData', y, ...
    'UData', u, 'VData', v, 'XDataMode', autoMode(autoXY), 'YDataMode', autoMode(autoXY)};
  constructorArgs = [constructorArgs, scaleArgs, lineArgs];
  if isempty(lineColor(lineArgs)) && ~hasProperty(propertyPairs, 'Color')
    color = getColorAndUpdateIndex(ax);
    constructorArgs = [constructorArgs, {'Color', color}];
  end
  h = __quiver__(constructorArgs{:}, propertyPairs{:});
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [parent, args] = parseQuiverParent(args)
  if ~isempty(args) && isscalar(args{1}) && (isgraphics(args{1}, 'axes') || isgraphics(args{1}, 'hggroup'))
    parent = args{1};
    args = args(2:end);
  else
    [parent, args] = graphicsExtractParentProperty(args);
  end
end
%=============================================================================
function keepBox = quiverKeepBox(parent)
  keepBox = false;
  if isempty(parent)
    fig = groot().CurrentFigure;
    if ~isempty(fig) && ~isempty(fig.CurrentAxes)
      keepBox = strcmp(fig.CurrentAxes.NextPlot, 'add');
    end
  elseif isgraphics(parent, 'axes')
    keepBox = strcmp(parent.NextPlot, 'add');
  elseif isgraphics(parent, 'hggroup')
    ax = ancestor(parent, 'axes');
    keepBox = strcmp(ax.NextPlot, 'add');
  end
end
%=============================================================================
function [x, y, u, v, args, autoXY] = parseQuiverData(args)
  firstTail = firstTailArgument(args);
  if firstTail >= 5
    x = args{1};
    y = args{2};
    u = args{3};
    v = args{4};
    args = args(5:end);
    autoXY = false;
  elseif firstTail >= 3
    u = args{1};
    v = args{2};
    [x, y] = defaultGrid(u);
    args = args(3:end);
    autoXY = true;
  else
    error('Nelson:notEnoughInputs', 'Not enough input arguments.');
  end
  validateQuiverData(x, y, u, v);
end
%=============================================================================
function index = firstTailArgument(args)
  index = length(args) + 1;
  for k = 1:length(args)
    if ~(isnumeric(args{k}) || islogical(args{k}))
      index = k;
      return
    end
  end
end
%=============================================================================
function [x, y] = defaultGrid(u)
  x = 1:size(u, 2);
  y = 1:size(u, 1);
end
%=============================================================================
function validateQuiverData(x, y, u, v)
  values = {x, y, u, v};
  for k = 1:numel(values)
    if ~((isnumeric(values{k}) || islogical(values{k})) && isreal(values{k}))
      error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Value');
    end
  end
  if ~isequal(size(u), size(v))
    error('Nelson:dimagree:vectorComponentSizesMatch', 'Vector component sizes must match.');
  end
  validateCoordinateSize(x, size(u), 'X');
  validateCoordinateSize(y, size(u), 'Y');
end
%=============================================================================
function validateCoordinateSize(value, targetSize, name)
  if isscalar(value) || isequal(size(value), targetSize)
    return
  end
  if isvector(value) && (numel(value) == targetSize(1) || numel(value) == targetSize(2) || numel(value) == prod(targetSize))
    return
  end
  error('Nelson:graphics:componentDataSizeMismatch', '%s must match vector component size.', name);
end
%=============================================================================
function [scaleArgs, lineArgs, propertyPairs] = parseQuiverTail(args)
  scaleArgs = {};
  if ~isempty(args) && isnumeric(args{1}) && isscalar(args{1})
    scale = double(args{1});
    if scale == 0
      scaleArgs = {'AutoScale', 'off'};
    else
      scaleArgs = {'AutoScale', 'on', 'AutoScaleFactor', scale};
    end
    args = args(2:end);
  end
  lineArgs = parseLineSpec(args);
  if ~isempty(lineArgs)
    args = args(2:end);
  end
  if mod(length(args), 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  propertyPairs = args;
end
%=============================================================================
function lineArgs = parseLineSpec(args)
  lineArgs = {};
  if isempty(args) || ~isTextScalar(args{1}) || isValidGraphicsProperty('quiver', args{1})
    return
  end
  [lineStyle, colorSpec, markerSpec, msg] = colstyle(convertStringsToChars(args{1}), 'plot');
  if ~isempty(msg)
    error('Nelson:quiver:invalidLineSpec', msg);
  end
  if ~isempty(lineStyle)
    lineArgs = [lineArgs, {'LineStyle', lineStyle}];
  end
  if ~isempty(colorSpec)
    lineArgs = [lineArgs, {'Color', colorSpec}];
  end
  if ~isempty(markerSpec)
    lineArgs = [lineArgs, {'Marker', markerSpec}];
  end
end
%=============================================================================
function tf = isTextScalar(value)
  tf = ischar(value) || isStringScalar(value);
end
%=============================================================================
function value = autoMode(tf)
  if tf
    value = 'auto';
  else
    value = 'manual';
  end
end
%=============================================================================
function ax = targetAxes(parent)
  if isempty(parent)
    ax = newplot();
  elseif isgraphics(parent, 'hggroup')
    ax = ancestor(parent, 'axes');
  else
    ax = newplot(parent);
  end
end
%=============================================================================
function parent = parentForObject(parent, ax)
  if isempty(parent)
    parent = ax;
  end
end
%=============================================================================
function tf = hasProperty(args, name)
  tf = false;
  for k = 1:2:length(args)
    if isTextScalar(args{k}) && strcmpi(convertStringsToChars(args{k}), name)
      tf = true;
      return
    end
  end
end
%=============================================================================
function value = lineColor(args)
  value = [];
  for k = 1:2:length(args)
    if strcmp(args{k}, 'Color')
      value = args{k + 1};
      return
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = quiver3(varargin)
  narginchk(4, 10000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [parent, args] = parseQuiver3Parent(args);
  [x, y, z, u, v, w, args, autoXY] = parseQuiver3Data(args);
  [scaleArgs, lineArgs, propertyPairs] = parseQuiver3Tail(args);
  ax = targetAxes(parent);
  constructorArgs = {'Parent', parentForObject(parent, ax), 'XData', x, 'YData', y, ...
    'ZData', z, 'UData', u, 'VData', v, 'WData', w, ...
    'XDataMode', autoMode(autoXY), 'YDataMode', autoMode(autoXY)};
  constructorArgs = [constructorArgs, scaleArgs, lineArgs];
  if isempty(lineColor(lineArgs)) && ~hasProperty(propertyPairs, 'Color')
    constructorArgs = [constructorArgs, {'Color', getColorAndUpdateIndex(ax)}];
  end
  h = __quiver__(constructorArgs{:}, propertyPairs{:});
  view(ax, 3);
  grid(ax, 'on');
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [parent, args] = parseQuiver3Parent(args)
  if ~isempty(args) && isscalar(args{1}) && (isgraphics(args{1}, 'axes') || isgraphics(args{1}, 'hggroup'))
    parent = args{1};
    args = args(2:end);
  else
    parent = [];
  end
end
%=============================================================================
function [x, y, z, u, v, w, args, autoXY] = parseQuiver3Data(args)
  firstTail = firstTailArgument(args);
  if firstTail >= 7
    x = args{1};
    y = args{2};
    z = args{3};
    u = args{4};
    v = args{5};
    w = args{6};
    args = args(7:end);
    autoXY = false;
  elseif firstTail >= 5
    z = args{1};
    u = args{2};
    v = args{3};
    w = args{4};
    [x, y] = defaultGrid(u);
    args = args(5:end);
    autoXY = true;
  else
    error('Nelson:notEnoughInputs', 'Not enough input arguments.');
  end
  validateQuiver3Data(x, y, z, u, v, w);
end
%=============================================================================
function index = firstTailArgument(args)
  index = length(args) + 1;
  for k = 1:length(args)
    if ~(isnumeric(args{k}) || islogical(args{k}))
      index = k;
      return
    end
  end
end
%=============================================================================
function [x, y] = defaultGrid(u)
  x = 1:size(u, 2);
  y = 1:size(u, 1);
end
%=============================================================================
function validateQuiver3Data(x, y, z, u, v, w)
  values = {x, y, z, u, v, w};
  for k = 1:numel(values)
    if ~((isnumeric(values{k}) || islogical(values{k})) && isreal(values{k}))
      error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Value');
    end
  end
  if ~isequal(size(u), size(v)) || ~isequal(size(u), size(w))
    error('Nelson:dimagree:vectorComponentSizesMatch', 'Vector component sizes must match.');
  end
  validateCoordinateSize(x, size(u), 'X');
  validateCoordinateSize(y, size(u), 'Y');
  validateCoordinateSize(z, size(u), 'Z');
end
%=============================================================================
function validateCoordinateSize(value, targetSize, name)
  if isscalar(value) || isequal(size(value), targetSize)
    return
  end
  if isvector(value) && (numel(value) == targetSize(1) || numel(value) == targetSize(2) || numel(value) == prod(targetSize))
    return
  end
  error('Nelson:graphics:componentDataSizeMismatch', '%s must match vector component size.', name);
end
%=============================================================================
function [scaleArgs, lineArgs, propertyPairs] = parseQuiver3Tail(args)
  scaleArgs = {};
  if ~isempty(args) && isnumeric(args{1}) && isscalar(args{1})
    scale = double(args{1});
    if scale == 0
      scaleArgs = {'AutoScale', 'off'};
    else
      scaleArgs = {'AutoScale', 'on', 'AutoScaleFactor', scale};
    end
    args = args(2:end);
  end
  lineArgs = parseLineSpec(args);
  if ~isempty(lineArgs)
    args = args(2:end);
  end
  if mod(length(args), 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  propertyPairs = args;
end
%=============================================================================
function lineArgs = parseLineSpec(args)
  lineArgs = {};
  if isempty(args) || ~isTextScalar(args{1}) || isValidGraphicsProperty('quiver', args{1})
    return
  end
  [lineStyle, colorSpec, markerSpec, msg] = colstyle(convertStringsToChars(args{1}), 'plot');
  if ~isempty(msg)
    error('Nelson:quiver3:invalidLineSpec', msg);
  end
  if ~isempty(lineStyle)
    lineArgs = [lineArgs, {'LineStyle', lineStyle}];
  end
  if ~isempty(colorSpec)
    lineArgs = [lineArgs, {'Color', colorSpec}];
  end
  if ~isempty(markerSpec)
    lineArgs = [lineArgs, {'Marker', markerSpec}];
  end
end
%=============================================================================
function tf = isTextScalar(value)
  tf = ischar(value) || isStringScalar(value);
end
%=============================================================================
function value = autoMode(tf)
  if tf
    value = 'auto';
  else
    value = 'manual';
  end
end
%=============================================================================
function ax = targetAxes(parent)
  if isempty(parent)
    ax = newplot();
  elseif isgraphics(parent, 'hggroup')
    ax = ancestor(parent, 'axes');
  else
    ax = newplot(parent);
  end
end
%=============================================================================
function parent = parentForObject(parent, ax)
  if isempty(parent)
    parent = ax;
  end
end
%=============================================================================
function tf = hasProperty(args, name)
  tf = false;
  for k = 1:2:length(args)
    if isTextScalar(args{k}) && strcmpi(convertStringsToChars(args{k}), name)
      tf = true;
      return
    end
  end
end
%=============================================================================
function value = lineColor(args)
  value = [];
  for k = 1:2:length(args)
    if strcmp(args{k}, 'Color')
      value = args{k + 1};
      return
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = raincloudplot(varargin)
  narginchk(1, 10000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [parent, args] = graphicsParseParent(args);
  [posArgs, optionArgs] = splitDataAndOptions(args);
  [series, labels] = parseRainCloudData(posArgs);
  ax = graphicsTargetAxes(parent);
  if isempty(parent)
    target = ax;
  else
    target = parent;
  end
  firstIndex = countRainClouds(target) + 1;
  handles = [];
  for k = 1:numel(series)
    s = series(k);
    ctorArgs = {'Parent', target, 'XData', s.XData, 'YData', s.YData, ...
      'SeriesIndex', firstIndex + k - 1};
    if ~isempty(s.SourceTable)
      ctorArgs = [ctorArgs, {'SourceTable', s.SourceTable, ...
        'XVariable', s.XVariable, 'YVariable', s.YVariable}];
    end
    h = __raincloudplot__(ctorArgs{:}, optionArgs{:});
    set(h, 'XDataMode', s.XDataMode, 'YDataMode', s.YDataMode);
    handles = [handles; h];
  end
  applyPositionTicks(ax, handles, labels);
  if nargout == 1
    varargout{1} = handles;
  end
end
%=============================================================================
function [posArgs, optionArgs] = splitDataAndOptions(args)
  if isempty(args)
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Value');
  end
  if istable(args{1}) || istimetable(args{1})
    % name-value arguments come in pairs: the parity gives the selector count.
    if numel(args) >= 3 && rem(numel(args), 2) == 1
      nPos = 3;
    else
      nPos = 2;
    end
    nPos = min(nPos, numel(args));
  else
    nPos = 1;
    while nPos < numel(args) && ~(ischar(args{nPos + 1}) || isStringScalar(args{nPos + 1}))
      nPos = nPos + 1;
    end
  end
  posArgs = args(1:nPos);
  optionArgs = args(nPos + 1:end);
  if rem(numel(optionArgs), 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  for k = 1:2:numel(optionArgs)
    optionArgs{k} = canonicalOptionName(optionArgs{k});
  end
end
%=============================================================================
function [series, labels] = parseRainCloudData(posArgs)
  labels = {};
  if istable(posArgs{1}) || istimetable(posArgs{1})
    [series, labels] = tableSeries(posArgs);
    return
  end
  if numel(posArgs) > 2
    error('Nelson:graphics:tooManyDataArguments', 'Too many data arguments.');
  end
  y = posArgs{end};
  mustBeNumericData(y, 'ydata');
  if numel(posArgs) == 1
    series = matrixSeries(y);
    return
  end
  x = posArgs{1};
  if isvector(y) || isempty(y)
    xs = {x};
    ys = {y};
  elseif isequal(size(x), size(y))
    xs = num2cell(x, 1);
    ys = num2cell(y, 1);
  else
    error('Nelson:graphics:invalidGroupData', 'Group data must have the same number of elements as data.');
  end
  [positions, labels] = groupPositions(xs, ys);
  series = repmat(makeSeries([], [], 'manual', 'manual'), numel(ys), 1);
  for k = 1:numel(ys)
    series(k) = makeSeries(positions{k}, ys{k}, 'manual', 'manual');
  end
end
%=============================================================================
function series = matrixSeries(y)
  if isvector(y) || isempty(y)
    series = makeSeries(ones(numel(y), 1), y, 'auto', 'manual');
    return
  end
  series = repmat(makeSeries([], [], 'auto', 'manual'), size(y, 2), 1);
  for k = 1:size(y, 2)
    series(k) = makeSeries(k * ones(size(y, 1), 1), y(:, k), 'auto', 'manual');
  end
end
%=============================================================================
function [series, labels] = tableSeries(posArgs)
  tbl = posArgs{1};
  yNames = graphicsTableVariableNames(tbl, posArgs{end});
  if numel(posArgs) == 2
    xNames = {};
  else
    xNames = graphicsTableVariableNames(tbl, posArgs{2});
  end
  count = max(numel(xNames), numel(yNames));
  if ~isempty(xNames) && numel(xNames) ~= count && numel(xNames) ~= 1
    error('Nelson:dimagree:tableVariableCountsMatch', 'Table variable counts must match.');
  end
  if numel(yNames) ~= count && numel(yNames) ~= 1
    error('Nelson:dimagree:tableVariableCountsMatch', 'Table variable counts must match.');
  end
  ys = cell(1, count);
  xs = cell(1, count);
  for k = 1:count
    ys{k} = tbl.(yNames{min(k, numel(yNames))});
    mustBeNumericData(ys{k}, yNames{min(k, numel(yNames))});
    if ~isempty(xNames)
      xs{k} = tbl.(xNames{min(k, numel(xNames))});
    end
  end
  labels = {};
  if ~isempty(xNames)
    [xs, labels] = groupPositions(xs, ys);
  end
  series = repmat(makeSeries([], [], 'auto', 'auto'), count, 1);
  for k = 1:count
    if isempty(xNames)
      x = ones(numel(ys{k}), 1);
      xName = '';
    else
      x = xs{k};
      xName = xNames{min(k, numel(xNames))};
    end
    series(k) = makeSeries(x, ys{k}, 'auto', 'auto');
    series(k).SourceTable = tbl;
    series(k).XVariable = xName;
    series(k).YVariable = yNames{min(k, numel(yNames))};
  end
end
%=============================================================================
function s = makeSeries(x, y, xMode, yMode)
  s = struct('XData', double(x(:)), 'YData', y(:), 'XDataMode', xMode, ...
    'YDataMode', yMode, 'SourceTable', [], 'XVariable', '', 'YVariable', '');
end
%=============================================================================
function mustBeNumericData(value, name)
  if ~isnumeric(value) || ~isreal(value)
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', name);
  end
end
%=============================================================================
function [positions, labels] = groupPositions(xs, ys)
  % Categorical groups of every series share one position per category name,
  % so that series grouped by different variables line up or stack.
  labels = {};
  positions = cell(size(xs));
  for k = 1:numel(xs)
    x = xs{k};
    if numel(x) ~= numel(ys{k})
      error('Nelson:graphics:invalidGroupData', 'Group data must have the same number of elements as data.');
    end
    if iscategorical(x)
      cats = categories(x);
      labels = [labels; cats(~ismember(cats, labels))];
      [~, index] = ismember(cellstr(x(:)), labels);
      index(isundefined(x(:))) = NaN;
      positions{k} = double(index);
    elseif (isnumeric(x) && isreal(x)) || islogical(x)
      positions{k} = double(x(:));
    else
      error('Nelson:raincloudplot:invalidGroupData', 'Group data must be numeric or categorical.');
    end
  end
end
%=============================================================================
function count = countRainClouds(target)
  children = target.Children;
  count = 0;
  for k = 1:numel(children)
    count = count + double(isgraphics(children(k), 'raincloudplot'));
  end
end
%=============================================================================
function applyPositionTicks(ax, handles, labels)
  if isempty(handles)
    return
  end
  if strcmp(handles(1).Orientation, 'horizontal')
    axisName = 'Y';
  else
    axisName = 'X';
  end
  if ~isempty(labels)
    set(ax, [axisName, 'Tick'], 1:numel(labels), [axisName, 'TickLabel'], labels);
    return
  end
  positions = [];
  for k = 1:numel(handles)
    positions = [positions; handles(k).XData(:)];
  end
  positions = unique(positions(isfinite(positions)));
  if ~isempty(positions)
    set(ax, [axisName, 'Tick'], positions(:).');
  end
end
%=============================================================================
function name = canonicalOptionName(value)
  valid = {'DensityWidth', 'Orientation', 'FaceColor', 'FaceColorMode', 'FaceAlpha', ...
    'EdgeColor', 'EdgeColorMode', 'LineWidth', 'SeriesIndex', 'Marker', 'MarkerSize', ...
    'MarkerFaceColor', 'MarkerFaceColorMode', 'MarkerEdgeColor', 'MarkerEdgeColorMode', ...
    'DisplayName', 'Visible', 'Clipping', 'HandleVisibility', 'Tag', 'UserData', ...
    'ButtonDownFcn', 'CreateFcn', 'DeleteFcn', 'Interruptible', 'BusyAction', ...
    'PickableParts', 'HitTest', 'Selected', 'SelectionHighlight', 'ContextMenu'};
  if ~(ischar(value) || isStringScalar(value))
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  matches = find(strcmpi(char(value), valid));
  if isempty(matches)
    matches = find(strncmpi(char(value), valid, length(char(value))));
  end
  if numel(matches) ~= 1
    error('Nelson:graphics:unsupportedProperty', 'Unsupported "%s" option.', 'raincloudplot');
  end
  name = valid{matches};
end
