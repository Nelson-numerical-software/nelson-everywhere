%=============================================================================
function varargout = surf(varargin)
  narginchk(1, 1000);
  nargoutchk(0, 1);

  inputArguments = convertStringToCharArgs(varargin);
  validateSurfacePropertySyntax(inputArguments);
  nbInputArguments = length(inputArguments);
  if (nargout == 0 && nbInputArguments >= 4 && ~ischar(inputArguments{1}))
    go = gca();
    if strcmp(lower(go.NextPlot), 'replace') && ~isempty(go.Children)
      children = go.Children;
      surfaceHandle = [];
      for k = 1:numel(children)
        if isgraphics(children(k), 'surface')
          surfaceHandle = children(k);
          break;
        end
      end
      if ~isempty(surfaceHandle)
        firstString = find(cellfun('isclass', inputArguments, 'char'), 1);
        if isempty(firstString)
          firstString = nbInputArguments + 1;
        end
        if (firstString == 5)
          set(surfaceHandle, 'XData', inputArguments{1}, 'YData', inputArguments{2}, ...
            'ZData', inputArguments{3}, 'CData', inputArguments{4}, inputArguments{5:end});
          return
        end
      end
    end
  end
  if (nbInputArguments >= 2) && (length(inputArguments{1}) == 1) && isgraphics(inputArguments{1}, 'axes')
    go = newplotTarget(inputArguments{1}(1));
  else
    go = newplotTarget(graphicsParentProperty(inputArguments));
  end
  nextplot = go.NextPlot;

  h = surface(inputArguments{:});

  if strcmp(nextplot, 'replaceall') || strcmp(nextplot, 'replace')
    view(go, 3);
    grid(go, 'on');
    box(go, 'off');
    applySurfSubplotYAxis(go, h.YData);
  elseif strcmp(nextplot, 'replacechildren')
    view(go, 3);
    box(go, 'off');
  end

  if nargout > 0
    varargout{1} = h;
  end
end
%=============================================================================
function applySurfSubplotYAxis(ax, yData)
  if ~strcmp(ax.YLimMode, 'auto') || ~strcmp(ax.YTickMode, 'auto')
    return
  end
  position = ax.Position;
  if numel(position) < 4 || position(3) >= 0.5
    return
  end
  values = yData(isfinite(yData));
  if isempty(values)
    return
  end
  limits = [min(values(:)) max(values(:))];
  span = limits(2) - limits(1);
  if ~isfinite(span) || span < 40 || span > 60
    return
  end
  step = surfNiceStep(span / 3);
  startValue = floor(limits(1) / step) * step;
  stopValue = ceil(limits(2) / step) * step;
  ax.YLim = [startValue stopValue];
  ax.YTick = startValue:step:stopValue;
end
%=============================================================================
function step = surfNiceStep(rawStep)
  magnitude = 10 ^ floor(log10(rawStep));
  scaled = rawStep / magnitude;
  if scaled <= 1.2
    multiplier = 1;
  elseif scaled <= 2.5
    multiplier = 2;
  elseif scaled <= 5
    multiplier = 5;
  else
    multiplier = 10;
  end
  step = multiplier * magnitude;
end
%=============================================================================%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = surface(varargin)
  % surface(X, Y, Z)
  % surface(X, Y, Z, C)
  % surface(Z)
  % surface(Z, C)
  % surface(ax, ...)
  nargoutchk(0, 1);

  inputArguments = convertStringToCharArgs(varargin);
  validateSurfacePropertySyntax(inputArguments);
  nbInputArguments = nargin;
  if (nbInputArguments >= 2)
    if (isscalar(inputArguments{1}) && (isgraphics(inputArguments{1}, 'axes') || isgraphics(inputArguments{1}, 'hggroup')))
      go = inputArguments{1}(1);
      inputArguments = inputArguments(2:end);
      nbInputArguments = length(inputArguments);
    else
      go = gca();
    end
  else
    go = gca();
  end
  propertiesList = {};
  firstString = find(cellfun('isclass', inputArguments, 'char'), 1);
  if (isempty(firstString))
    firstString = nbInputArguments + 1;
  end
  propertiesList = inputArguments(firstString:end);
  if ~hasSurfaceProperty(propertiesList, 'EdgeColor')
    propertiesList = [{'EdgeColor', graphicsDefaultEdgeColor()}, propertiesList];
  end
  inputArguments = inputArguments(1:firstString - 1);
  if (length(inputArguments) == 0)
    h = surfaceNoRhs(go, propertiesList);
  elseif (length(inputArguments) == 1)
    h = surfaceOneRhs(go, inputArguments, propertiesList);
  elseif (length(inputArguments) == 2)
    h = surfaceTwoRhs(go, inputArguments, propertiesList);
  elseif (length(inputArguments) == 3)
    h = surfaceThreeRhs(go, inputArguments, propertiesList);
  elseif (length(inputArguments) == 4)
    h = surfaceFourRhs(go, inputArguments, propertiesList);
  else
    error('Nelson:graphics:invalidNameValueArguments', 'Invalid parameter/value pair arguments.');
  end
  if nargout > 0
    varargout{1} = h;
  end
end
%=============================================================================
function h = surfaceNoRhs(go, propertiesList)
  Z = eye(3, 2);
  h = __surf__('Parent', go, 'ZData', Z, propertiesList{:});
  xlim(go, [1 3]);
  ylim(go, [1 3]);
end
%=============================================================================
function h = surfaceOneRhs(go, inputArguments, propertiesList)
  Z = inputArguments{1};
  validateZData(Z);
  h = __surf__('Parent', go, 'ZData', Z, propertiesList{:});
end
%=============================================================================
function h = surfaceTwoRhs(go, inputArguments, propertiesList)
  Z = inputArguments{1};
  C = inputArguments{2};
  if (~isreal(Z) || ~isreal(C))
    error('Nelson:surface:invalidZCArguments', 'Z, C arguments must be real.');
  end
  validateZData(Z);
  validateColorData(Z, C);
  h = __surf__('Parent', go, 'ZData', Z, 'CData', C, propertiesList{:});
end
%=============================================================================
function h = surfaceThreeRhs(go, inputArguments, propertiesList)
  X = inputArguments{1};
  Y = inputArguments{2};
  Z = inputArguments{3};
  if (~isreal(X) || ~isreal(Y) || ~isreal(Z))
    error('Nelson:surface:invalidXYZ', 'X, Y, Z arguments must be real.');
  end

  validateZData(Z);
  if (isvector(X) && isvector(Y) && ismatrix(Z))
    if (size(Z, 1) == length(Y) && size(Z, 2) == length(X))
      X = X(:)';
      Y = Y(:);
    else
      error('Nelson:surface:invalidSizeZ1', 'size(Z, 1) must be the same as length(Y) and size(Z, 2) must be the same as length(X).');
    end
  elseif (ismatrix(X) && ismatrix(Y) && ismatrix(Z))
    [X_nr, X_nc] = size(X);
    [Y_nr, Y_nc] = size(Y);
    [Z_nr, Z_nc] = size(Z);
    isSameSize = ((X_nr == Y_nr) && (Y_nr == Z_nr) && (X_nc == Y_nc) && (Y_nc == Z_nc));
    if (~isSameSize)
      error('Nelson:surface:invalidXYAnd', 'X, Y, and Z must have the same dimensions.');
    end
  else
    error('Nelson:surface:invalidXAndY', 'X and Y must be vectors and Z must be a matrix.');
  end
  h = __surf__('Parent', go, 'XData', X, 'YData', Y, 'ZData', Z, propertiesList{:});
end
%=============================================================================
function h = surfaceFourRhs(go, inputArguments, propertiesList)
  X = inputArguments{1};
  Y = inputArguments{2};
  Z = inputArguments{3};
  C = inputArguments{4};
  if (~isreal(X) || ~isreal(Y) || ~isreal(Z) || ~isreal(C))
    error('Nelson:surface:invalidXYZC', 'X, Y, Z, C arguments must be real.');
  end
  validateZData(Z);
  validateColorData(Z, C);
  if (isvector(X) && isvector(Y) && ismatrix(Z))
    if (size(Z, 1) == length(Y) && size(Z, 2) == length(X))
      X = X(:)';
      Y = Y(:);
    else
      error('Nelson:surface:invalidSizeZ1', 'size(Z, 1) must be the same as length(Y) and size(Z, 2) must be the same as length(X).');
    end
  elseif (ismatrix(X) && ismatrix(Y) && ismatrix(Z))
    [X_nr, X_nc] = size(X);
    [Y_nr, Y_nc] = size(Y);
    [Z_nr, Z_nc] = size(Z);
    isSameSize = ((X_nr == Y_nr) && (Y_nr == Z_nr) && (X_nc == Y_nc) && (Y_nc == Z_nc));
    if (~isSameSize)
      error('Nelson:surface:invalidXYAnd', 'X, Y, and Z must have the same dimensions.');
    end
  else
    error('Nelson:surface:invalidXAndY', 'X and Y must be vectors and Z must be a matrix.');
  end
  h = __surf__('Parent', go, 'XData', X, 'YData', Y, 'ZData', Z, 'CData', C, propertiesList{:});
end
%=============================================================================
function validateZData(Z)
  if ~ismatrix(Z) || isvector(Z) || isscalar(Z) || any(size(Z) < 2)
    error('Nelson:surface:invalidZArgument', 'Z argument must be a matrix.');
  end
end
%=============================================================================
function validateColorData(Z, C)
  [Z_nr, Z_nc] = size(Z);
  [C_nr, C_nc, C_np] = size(C);
  sameVertexSize = (Z_nr == C_nr && Z_nc == C_nc);
  sameFaceSize = (Z_nr > 1 && Z_nc > 1 && C_nr == Z_nr - 1 && C_nc == Z_nc - 1);
  if ~((sameVertexSize || sameFaceSize) && (C_np == 1 || C_np == 3))
    error('Nelson:dimagree:zCSize', 'Z and C must have the same size.');
  end
end
%=============================================================================
function tf = hasSurfaceProperty(propertiesList, propertyName)
  tf = false;
  for k = 1:2:length(propertiesList)
    if ischar(propertiesList{k}) && strcmpi(propertiesList{k}, propertyName)
      tf = true;
      return
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = surfc(varargin)
  narginchk(1, 1000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [ax, args] = parseSurfaceParent(args);
  saveHold = ishold(ax);
  s = surf(ax, args{:});
  hold(ax, 'on');
  [~, c] = contour(ax, s.XData, s.YData, s.ZData, 'ZLocation', 'zmin');
  applySurfaceContourZLimits(ax, s.ZData);
  if ~saveHold
    hold(ax, 'off');
  end
  view(ax, 3);
  grid(ax, 'on');
  if nargout == 1
    varargout{1} = [s; c];
  end
end
%=============================================================================
function [ax, args] = parseSurfaceParent(args)
  if ~isempty(args) && isscalar(args{1}) && isgraphics(args{1}, 'axes')
    ax = newplot(args{1});
    args = args(2:end);
  else
    [parent, args] = graphicsExtractParentProperty(args);
    ax = newplotTarget(parent);
  end
end
%=============================================================================
%=============================================================================
function applySurfaceContourZLimits(ax, zData)
  zValues = zData(isfinite(zData));
  if isempty(zValues)
    return
  end
  limits = [min(zValues(:)) max(zValues(:))];
  if limits(1) == limits(2)
    limits = limits + [-0.5 0.5];
  end
  zlim(ax, limits);
  ticks = surfaceContourZTicks(limits);
  if ~isempty(ticks)
    ax.ZTick = ticks;
  end
end
%=============================================================================
function ticks = surfaceContourZTicks(limits)
  span = limits(2) - limits(1);
  if ~isfinite(span) || span <= 0
    ticks = [];
    return
  end
  rawStep = span / 10;
  magnitude = 10 ^ floor(log10(rawStep));
  scaled = rawStep / magnitude;
  if scaled <= 1.2
    multiplier = 1;
  elseif scaled <= 2.5
    multiplier = 2;
  elseif scaled <= 5
    multiplier = 5;
  else
    multiplier = 10;
  end
  step = multiplier * magnitude;
  first = ceil(limits(1) / step) * step;
  last = floor(limits(2) / step) * step;
  if first > last
    ticks = [];
  else
    ticks = first:step:last;
  end
end%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = surfl(varargin)
  narginchk(1, 1000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [ax, args] = parseSurfaceParent(args);
  [args, useLight] = parseSurflMode(args);
  [surfaceArgs, lightSpec, coefficients] = parseSurflData(args);
  % The light and reflectance geometry depend on the view direction, so the
  % 3-D view must be established before it is computed.
  if ~strcmp(ax.NextPlot, 'add')
    view(ax, 3);
  end
  lightVector = resolveLightVector(lightSpec, ax);
  if useLight
    s = surf(ax, surfaceArgs{:}, 'AmbientStrength', coefficients(1), ...
      'DiffuseStrength', coefficients(2), 'SpecularStrength', coefficients(3), ...
      'SpecularExponent', coefficients(4));
    s.FaceLighting = 'flat';
    l = light(ax, 'Position', lightVector, 'Color', [1 1 1], 'Style', 'infinite');
    h = [s; l];
  else
    s = surf(ax, surfaceArgs{:});
    if strcmp(s.CDataMode, 'auto')
      s.CData = surfaceReflectance(ax, s, lightVector, coefficients);
    end
    clim(ax, [0 1]);
    h = s;
  end
  view(ax, 3);
  grid(ax, 'on');
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [args, useLight] = parseSurflMode(args)
  useLight = false;
  if ~isempty(args) && ischar(args{end}) && strcmpi(args{end}, 'light')
    useLight = true;
    args = args(1:end - 1);
  end
end
%=============================================================================
function [ax, args] = parseSurfaceParent(args)
  if ~isempty(args) && isscalar(args{1}) && isgraphics(args{1}, 'axes')
    ax = newplot(args{1});
    args = args(2:end);
  else
    [parent, args] = graphicsExtractParentProperty(args);
    ax = newplotTarget(parent);
  end
end
%=============================================================================
function [surfaceArgs, lightSpec, coefficients] = parseSurflData(args)
  coefficients = [0.55 0.6 0.4 10];
  lightSpec = [];
  surfaceArgs = args;
  if numel(args) == 2 && isnumeric(args{2})
    lightSpec = args{2};
    surfaceArgs = args(1);
  elseif numel(args) == 4 && isnumeric(args{4})
    lightSpec = args{4};
    surfaceArgs = args(1:3);
  elseif numel(args) == 5 && isnumeric(args{5})
    lightSpec = args{4};
    coefficients = validateLightingCoefficients(args{5});
    surfaceArgs = args(1:3);
  end
end
%=============================================================================
function vector = resolveLightVector(lightSpec, ax)
  if isempty(lightSpec)
    vector = defaultLightVector(ax);
  else
    vector = lightVectorFromInput(lightSpec);
  end
end
%=============================================================================
function coefficients = validateLightingCoefficients(coefficients)
  if ~isnumeric(coefficients) || numel(coefficients) ~= 4
    error('Nelson:surfl:invalidLightingCoefficients', 'Lighting coefficients must have four elements.');
  end
  coefficients = double(coefficients(:).');
end
%=============================================================================
function vector = lightVectorFromInput(value)
  if ~isnumeric(value) || ~(numel(value) == 2 || numel(value) == 3)
    error('Nelson:surfl:invalidLightDirection', 'Light direction must have two or three elements.');
  end
  value = double(value(:).');
  if numel(value) == 2
    az = value(1) * pi / 180;
    el = value(2) * pi / 180;
    vector = [sin(az) * cos(el), -cos(az) * cos(el), sin(el)];
  else
    vector = value;
  end
end
%=============================================================================
function vector = defaultLightVector(ax)
  viewAngles = ax.View * pi / 180;
  az = viewAngles(1);
  el = viewAngles(2);
  phi = 45 * pi / 180;
  vector = [cos(az) * sin(phi) + sin(az) * cos(el) * cos(phi), ...
    sin(phi) * sin(az) - cos(az) * cos(el) * cos(phi), ...
    sin(phi) * sin(el)];
end
%=============================================================================
function cdata = surfaceReflectance(ax, h, lightVector, coefficients)
  % Reflectance-based shading: combine ambient, Lambertian (diffuse) and
  % specular terms evaluated from the surface normals, the light direction
  % and the viewing direction. This shades the surface as if lit, which is
  % the defining behaviour of surfl.
  [x, y, z] = surfaceGrid(h);
  % Scale the coordinates to a cube-like domain so the normals are not
  % dominated by the largest axis span before they are computed.
  limits = [ax.XLim, ax.YLim, ax.ZLim];
  sx = limits(2) - limits(1);
  sy = limits(4) - limits(3);
  sz = limits(6) - limits(5);
  scale = max([sx, sy, sz]);
  if scale > 0
    sx = nonZeroScale(sx / scale);
    sy = nonZeroScale(sy / scale);
    sz = nonZeroScale(sz / scale);
  else
    sx = 1; sy = 1; sz = 1;
  end
  [nx, ny, nz] = surfnorm(x ./ sx, y ./ sy, z ./ sz);
  s = lightVector(:).' / norm(lightVector);
  viewAngles = ax.View;
  ambient = coefficients(1);
  diffuseWeight = coefficients(2);
  specularWeight = coefficients(3);
  spread = coefficients(4);
  reflectance = ambient ...
    + diffuseWeight .* diffuseReflectance(nx, ny, nz, s) ...
    + specularWeight .* specularReflectance(nx, ny, nz, s, viewAngles, spread);
  cdata = reflectance ./ sum(coefficients(1:3));
end
%=============================================================================
function value = nonZeroScale(value)
  if value == 0
    value = 1;
  end
end
%=============================================================================
function [x, y, z] = surfaceGrid(h)
  z = double(h.ZData);
  x = double(h.XData);
  y = double(h.YData);
  if isvector(x) && isvector(y) && ~isvector(z)
    [x, y] = meshgrid(x, y);
  end
end
%=============================================================================
function r = diffuseReflectance(nx, ny, nz, s)
  s = s(:).' / norm(s);
  magnitude = sqrt(nx .* nx + ny .* ny + nz .* nz);
  magnitude(magnitude == 0) = eps;
  r = max(0, (s(1) .* nx + s(2) .* ny + s(3) .* nz) ./ magnitude);
end
%=============================================================================
function r = specularReflectance(nx, ny, nz, s, v, spread)
  s = s(:) / norm(s);
  if numel(v) == 2
    az = v(1) * pi / 180;
    el = v(2) * pi / 180;
    v = [sin(az) * cos(el); -cos(az) * cos(el); sin(el)];
  else
    v = v(:) / norm(v);
  end
  magnitude = nx .* nx + ny .* ny + nz .* nz;
  magnitude(magnitude == 0) = eps;
  sDotN = s(1) .* nx + s(2) .* ny + s(3) .* nz;
  vDotN = v(1) .* nx + v(2) .* ny + v(3) .* nz;
  r = max(0, 2 .* (sDotN .* vDotN) ./ magnitude - (v.' * s));
  r = r .^ spread;
end
%=============================================================================
ï»¿%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
