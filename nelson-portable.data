%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('gaminv'), 3);
asserts.isequal(nargout('gaminv'), 1);
%=============================================================================
p = [0 0.025 0.5 0.975 1];
a = [0.5 1 2 3 5];
b = [1 2 2 4 1];
R = gaminv(p, a, b);
REF = [0 0.0506356159685797 3.35669398003332 28.8987506708958 Inf];
asserts.isapprox(R(1:4), REF(1:4), 1e-11);
asserts.istrue(isinf(R(5)) && R(5) > 0);
%=============================================================================
R = gaminv([0.025 0.5 0.975], [1 2 3]);
asserts.isapprox(R, [0.0253178079842899 1.67834699001666 7.22468766772351], 1e-11);
%=============================================================================
R = gaminv(single([0.025 0.5 0.975]), single([1 2 3]), single([1 2 4]));
asserts.isequal(class(R), 'single');
asserts.isapprox(R, single([0.0253178079842899 3.35669398003332 28.8987506708958]), 1e-5);
%=============================================================================
R = gaminv([-0.1 1.1 NaN 0 1], 2, 1);
asserts.istrue(all(isnan(R(1:3))));
asserts.isequal(R(4), 0);
asserts.istrue(isinf(R(5)) && R(5) > 0);
%=============================================================================
R = gaminv([], [], []);
asserts.isequal(size(R), [0 0]);
%=============================================================================
asserts.checkerror('gaminv(ones(2), ones(3), 1)', _('Size mismatch on input arguments'));
asserts.checkerror('gaminv({0.5}, 2, 1)', sprintf(_('%s must be real numeric.'), 'P'));
asserts.checkerror('gaminv(0.5, {2}, 1)', sprintf(_('%s must be real numeric.'), 'A'));
asserts.checkerror('gaminv(0.5, 2, {1})', sprintf(_('%s must be real numeric.'), 'B'));
%=============================================================================
asserts.isapprox(gaminv(gamcdf(2, 3, 2), 3, 2), 2, 1e-12);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('gamlike'), 4);
asserts.isequal(nargout('gamlike'), 2);
%=============================================================================
x = [0.5 1 2 3 5 8];
params = [1.457461695639626 2.229904229883514];
[NLOGL, AVAR] = gamlike(params, x);
asserts.isapprox(NLOGL, 12.83875287654343, 1e-4);
asserts.isapprox(AVAR, [0.5842678900554542 -0.8939240873659653;
                       -0.8939240873659653 1.936317244873048], 1e-4);
%=============================================================================
censor = [0 0 0 1 0 1];
freq = [1 2 1 1 2 1];
params = [1.164302008282069 3.543364968242789];
[NLOGL, AVAR] = gamlike(params, x, censor, freq);
asserts.isapprox(NLOGL, 14.63762457131714, 1e-4);
asserts.isapprox(AVAR, [0.3442145196619660 -1.240714592816863;
                       -1.240714592816863 6.231792452555158], 1e-4);
%=============================================================================
[NLOGL, AVAR] = gamlike(single([2 3]), single([1 2 3]));
asserts.isequal(class(NLOGL), 'double');
asserts.isequal(class(AVAR), 'double');
asserts.isapprox(NLOGL, 6.799914262780604, 1e-4);
asserts.istrue(all(isnan(AVAR(:))));
%=============================================================================
[NLOGL, AVAR] = gamlike([0 1], x);
asserts.istrue(isinf(NLOGL));
asserts.istrue(all(isnan(AVAR(:))));
[NLOGL, AVAR] = gamlike([NaN 1], x);
asserts.istrue(isnan(NLOGL));
asserts.istrue(all(isnan(AVAR(:))));
[NLOGL, AVAR] = gamlike([1 1], [1 NaN 3]);
asserts.istrue(isnan(NLOGL));
asserts.istrue(all(isnan(AVAR(:))));
%=============================================================================
asserts.checkerror('gamlike([1 2])', _('Not enough input arguments.'));
asserts.checkerror('gamlike({1 2}, [1 2 3])', sprintf(_('%s must be real numeric.'), 'PARAMS'));
asserts.checkerror('gamlike([1 2 3], [1 2 3])', sprintf(_('PARAMS must be a %s vector.'), 'two-element'));
asserts.checkerror('gamlike([1 2], {1 2 3})', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('gamlike([1 2], [])', sprintf(_('%s must be nonempty.'), 'X'));
asserts.checkerror('gamlike([1 2], [0 1 2])', _('X must contain positive finite values.'));
asserts.checkerror('gamlike([1 2], [1 Inf 2])', _('X must contain positive finite values.'));
asserts.checkerror('gamlike([1 2], [1 2 3], [0 2 0])', _('CENSORING must contain 0 or 1 values.'));
asserts.checkerror('gamlike([1 2], [1 2 3], [], [1 -1 1])', sprintf(_('%s must contain nonnegative finite values.'), 'FREQ'));
asserts.checkerror('gamlike([1 2], [1 2 3], ones(2, 2))', _('Size mismatch on input arguments'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('gampdf'), 3);
asserts.isequal(nargout('gampdf'), 1);
%=============================================================================
x = [0 0.5 1 2 5];
a = [0.5 1 2 3 5];
b = [1 2 2 4 1];
R = gampdf(x, a, b);
REF = [Inf 0.389400391535702 0.151632664928158 ...
       0.0189540831160198 0.175467369767851];
asserts.istrue(isinf(R(1)) && R(1) > 0);
asserts.isapprox(R(2:5), REF(2:5), 1e-12);
%=============================================================================
R = gampdf([0 1 2], [1 2 3]);
asserts.isapprox(R, [1 0.367879441171442 0.270670566473225], 1e-12);
%=============================================================================
R = gampdf(single(x), single(a), single(b));
asserts.isequal(class(R), 'single');
asserts.istrue(isinf(R(1)) && R(1) > 0);
asserts.isapprox(R(2:5), single(REF(2:5)), 1e-6);
%=============================================================================
R = gampdf([-1 Inf NaN 1 1], [2 2 2 -1 2], [1 1 1 1 NaN]);
asserts.isequal(R(1), 0);
asserts.isequal(R(2), 0);
asserts.istrue(all(isnan(R(3:5))));
%=============================================================================
R = gampdf([], [], []);
asserts.isequal(size(R), [0 0]);
%=============================================================================
asserts.checkerror('gampdf(ones(2), ones(3), 1)', _('Size mismatch on input arguments'));
asserts.checkerror('gampdf({1}, 2, 1)', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('gampdf(1, {2}, 1)', sprintf(_('%s must be real numeric.'), 'A'));
asserts.checkerror('gampdf(1, 2, {1})', sprintf(_('%s must be real numeric.'), 'B'));
%=============================================================================
asserts.isapprox(gampdf(2, 3, 2), exp(-1) / 4, 1e-12);
asserts.istrue(isnan(gampdf(1, -1, 2)));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('gamrnd'), -1);
asserts.isequal(nargout('gamrnd'), 1);
%=============================================================================
rng(0);
R = gamrnd(2, 3, 2, 3);
REF = [9.287674020780702 1.846099402023371 6.441433781255375;
       11.89373327234888 12.20819690635428 1.571736634172027];
asserts.isapprox(R, REF, 1e-12);
%=============================================================================
rng(0);
U = rand(2, 3);
E = gaminv(U, 2, 3);
rng(0);
R = gamrnd(2, 3, 2, 3);
asserts.isequal(size(R), [2 3]);
asserts.isapprox(R, E, 1e-12);
%=============================================================================
rng(0);
U = rand(1, 3);
E = gaminv(U, [1 2 3], [1 2 4]);
rng(0);
R = gamrnd([1 2 3], [1 2 4]);
asserts.isapprox(R, E, 1e-12);
%=============================================================================
rng(0);
R = gamrnd(single(2), single(3), [2 3]);
asserts.isequal(class(R), 'single');
asserts.isequal(size(R), [2 3]);
R = gamrnd(2, 3, single([2 3]));
asserts.isequal(class(R), 'double');
asserts.isequal(size(R), [2 3]);
%=============================================================================
R = gamrnd([0 -1 NaN], [3 3 3], [1 3]);
asserts.istrue(all(isnan(R)));
R = gamrnd(2, [0 -1 NaN], [1 3]);
asserts.istrue(all(isnan(R)));
R = gamrnd(2, 3, 0, 3);
asserts.isequal(size(R), [0 3]);
%=============================================================================
asserts.checkerror('gamrnd(1)', _('Not enough input arguments.'));
asserts.checkerror('gamrnd([1 2], 1, 2, 2)', _('Size mismatch on input arguments'));
asserts.checkerror('gamrnd(1, 1, 1.5, 2)', _('Size must contain integer values.'));
asserts.checkerror('gamrnd({1}, 1)', sprintf(_('%s must be real numeric.'), 'A'));
asserts.checkerror('gamrnd(1, {1})', sprintf(_('%s must be real numeric.'), 'B'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('gamstat'), 2);
asserts.isequal(nargout('gamstat'), 2);
%=============================================================================
[m, v] = gamstat([1 2 3], [4 5 6]);
asserts.isapprox(m, [4 10 18], 1e-15);
asserts.isapprox(v, [16 50 108], 1e-15);
%=============================================================================
[m, v] = gamstat(single([1 2]), single([4 5]));
asserts.isequal(class(m), 'single');
asserts.isequal(class(v), 'single');
asserts.isapprox(double(m), [4 10], 1e-6);
asserts.isapprox(double(v), [16 50], 1e-5);
%=============================================================================
[m, v] = gamstat([1 0 -1 NaN], [1 1 1 1]);
asserts.isequal(m(1), 1);
asserts.isequal(v(1), 1);
asserts.istrue(all(isnan(m(2:4))));
asserts.istrue(all(isnan(v(2:4))));
%=============================================================================
[m, v] = gamstat([], []);
asserts.isequal(size(m), [0 0]);
asserts.isequal(size(v), [0 0]);
%=============================================================================
asserts.checkerror('gamstat(ones(2), ones(3))', _('Size mismatch on input arguments'));
asserts.checkerror('gamstat({1}, 1)', sprintf(_('%s must be real numeric.'), 'A'));
asserts.checkerror('gamstat(1, {1})', sprintf(_('%s must be real numeric.'), 'B'));
%=============================================================================
[gammaMean, gammaVariance] = gamstat(3, 2);
asserts.isequal(gammaMean, 6);
asserts.isequal(gammaVariance, 12);
