function message = nativeRunMessage(result)
  if result.timed_out
    message = 'ABORTED';
  elseif result.exit_code == 0
    message = result.stdout;
  elseif ~isempty(result.stderr)
    message = result.stderr;
  else
    message = result.stdout;
  end
end
