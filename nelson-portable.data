% LICENCE_BLOCK_END
%=============================================================================
function tf = isbetween(t, lowerBound, upperBound, intervalType)
  narginchk(3, 4);
  if nargin < 4
    intervalType = 'closed';
  end
  x = datenum(t);
  lo = datenum(lowerBound);
  hi = datenum(upperBound);
  intervalType = lower(char(intervalType));
  switch intervalType
    case {'closed', '[]'}
      tf = x >= lo & x <= hi;
    case {'open', '()'}
      tf = x > lo & x < hi;
    case {'openleft', '(]'}
      tf = x > lo & x <= hi;
    case {'openright', '[)'}
      tf = x >= lo & x < hi;
    otherwise
      error('Nelson:time:invalidIntervalType', 'Invalid %s.', 'interval type');
  end
end
