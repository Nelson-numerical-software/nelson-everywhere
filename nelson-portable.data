%=============================================================================
function TF = istimetable(varargin)
  narginchk(1, 1);
  TF = isa(varargin{1}, 'timetable');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function T = mergevars(T, vars, varargin)
  narginchk(2, Inf);
  mustBeA(T, 'table', 1);
  names = T.Properties.VariableNames;
  newName = '';
  mergeAsTable = false;
  k = 1;
  while k <= length(varargin)
    option = char(varargin{k});
    switch lower(option)
      case 'newvariablename'
        newName = varargin{k + 1};
        if ~((ischar(newName) && isrow(newName)) || (isstring(newName) && isscalar(newName)))
          error('Nelson:table:mergevars:InvalidNewVarName', 'Specify the new variable name as a string or a character vector.');
        end
        newName = char(newName);
      case 'mergeastable'
        mergeAsTable = logical(varargin{k + 1});
      otherwise
        error('Nelson:table:unknownOption', 'Unknown option.');
    end
    k = k + 2;
  end
  if isempty(vars) && ~ischar(vars)
    return
  end
  idx = tableResolveVariables(names, vars);
  if mergeAsTable
    merged = T(:, idx);
  else
    merged = T{:, idx};
  end
  % The merged variable takes the place of the first variable listed.
  position = idx(1) - nnz(unique(idx) < idx(1));
  T(:, unique(idx)) = [];
  if isempty(newName)
    newName = nelson.lang.makeUniqueStrings(sprintf('Var%d', position), T.Properties.VariableNames);
  end
  if position > width(T)
    T = addvars(T, merged, 'NewVariableNames', {newName});
  else
    T = addvars(T, merged, 'NewVariableNames', {newName}, 'Before', position);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function Tout = movevars(T, vars, varargin)
  narginchk(2, Inf);
  mustBeA(T, 'table', 1);
  st = struct(T);
  origNames = st.Properties.VariableNames;
  nvars = length(origNames);
  insertAt = tableAddMoveOptions(origNames, varargin, false);
  moveIdx = tableResolveVariableSubscript(origNames, vars, 'Nelson:table:vartypeInvalidVars', ...
    _('Using a vartype subscripter to specify variables to move is not supported. Use a character vector, string array, cell array of character vectors, or numeric or logical indices.'));

  % The location refers to the input table: the variables left in place
  % keep their side of it, the moved ones go in between in the given order.
  remainingIdx = setdiff(1:nvars, moveIdx, 'stable');
  newOrder = [remainingIdx(remainingIdx < insertAt), moveIdx, remainingIdx(remainingIdx >= insertAt)];
  newNames = localUniqueCopyNames(origNames(newOrder), newOrder);

  % Reorder every per-variable property array (not just the names) so they
  % stay aligned with the moved data.
  perVarFields = {'VariableTypes', 'VariableDescriptions', 'VariableUnits', 'VariableContinuity'};
  for f = 1:length(perVarFields)
    field = perVarFields{f};
    if isfield(st.Properties, field) && length(st.Properties.(field)) == nvars
      st.Properties.(field) = st.Properties.(field)(newOrder);
    end
  end
  st.Properties.CustomProperties = table.variableCustomPropertiesSubset(st, newOrder);
  st.Properties.VariableNames = newNames;
  data = struct();
  for k = 1:length(newOrder)
    data.(newNames{k}) = st.data.(origNames{newOrder(k)});
  end
  st.data = data;
  Tout = table.fromStruct(st);
end
%=============================================================================
function names = localUniqueCopyNames(names, order)
  % A variable moved twice is copied under the name suffixed _1, _2, ...
  for k = 1:length(order)
    if any(order(1:k - 1) == order(k))
      base = names{k};
      suffix = 1;
      while any(strcmp(names, [base, '_', num2str(suffix)]))
        suffix = suffix + 1;
      end
      names{k} = [base, '_', num2str(suffix)];
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function T = outerjoin(left, right, varargin)
  narginchk(2, Inf);
  joinType = 'full';
  args = varargin;
  k = 1;
  while k <= length(args)
    name = args{k};
    if isstring(name)
      name = char(name);
    end
    if ischar(name) && strcmpi(name, 'Type')
      joinType = lower(char(args{k + 1}));
      args(k:k + 1) = [];
    else
      k = k + 2;
    end
  end
  switch joinType
    case {'full', 'left', 'right'}
      T = tableJoin(left, right, joinType, args{:});
    otherwise
      error('Nelson:table:invalidValue:typeFullLeftRight', 'Type must be ''full'', ''left'', or ''right''.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [insertAt, newVariableNames] = tableAddMoveOptions(names, args, acceptNewVariableNames)
  % Name-value arguments of addvars and movevars: Before/After, plus
  % NewVariableNames when accepted. Names are case-insensitive and
  % abbreviable, the last occurrence wins.
  % insertAt: position in the input table in front of which the variables
  % go (width + 1 without a location).
  % newVariableNames: [] when not given, otherwise a 1xN cell of names.
  params = {'Before', 'After'};
  if acceptNewVariableNames
    params{end + 1} = 'NewVariableNames';
  end
  if mod(length(args), 2) ~= 0
    error('Nelson:table:wrongNumberArgs', _('Incorrect number of arguments.'));
  end
  position = '';
  location = [];
  newVariableNames = [];
  for k = 1:2:length(args)
    param = localParamName(args{k}, params);
    switch param
      case 'NewVariableNames'
        newVariableNames = localNewVariableNames(args{k + 1});
      otherwise
        if ~isempty(position) && ~strcmp(position, param)
          error('Nelson:table:beforeAndAfter', _('Specify either ''Before'' or ''After'', but not both.'));
        end
        position = param;
        location = args{k + 1};
    end
  end
  insertAt = localInsertionPoint(names, position, location);
end
%=============================================================================
function param = localParamName(name, params)
  if ~((ischar(name) && isrow(name)) || (isstring(name) && isscalar(name) && ~ismissing(name) && strlength(name) > 0))
    error('Nelson:table:illegalParamName', _('Invalid parameter name. Parameter name must be a nonempty string or character vector.'));
  end
  name = char(name);
  for k = 1:length(params)
    if length(name) <= length(params{k}) && strncmpi(name, params{k}, length(name))
      param = params{k};
      return
    end
  end
  error('Nelson:table:badParamName', _('Invalid parameter name: %s.'), name);
end
%=============================================================================
function names = localNewVariableNames(names)
  if ischar(names) && (isrow(names) || isempty(names))
    names = {names};
  elseif isstring(names)
    names = cellstr(names);
  elseif ~iscellstr(names)
    error('Nelson:table:invalidVarNames', _('New variable names must be a character vector, string array, or cell array of character vectors.'));
  end
  names = reshape(names, 1, []);
end
%=============================================================================
function insertAt = localInsertionPoint(names, position, location)
  nvars = length(names);
  if isempty(position)
    insertAt = nvars + 1;
    return
  end
  isAfter = strcmp(position, 'After');
  if isnumeric(location) && isscalar(location)
    % 'After', 0 is the first slot and 'Before', width + 1 the last one:
    % a slot index is checked like a variable index of a width + 1 table.
    insertAt = real(double(tableResolveVariables(cell(1, nvars + 1), double(location) + isAfter)));
    return
  end
  idx = tableResolveVariableSubscript(names, location, 'Nelson:table:invalidLocation', ...
    _('Using a vartype subscripter as a location is not supported. Specify a location as a variable name, a positive integer, or a logical vector containing a single true value.'));
  if length(idx) ~= 1
    error('Nelson:table:nonscalarPosition', _('Specify a single location as a positive integer, a variable name, or a logical vector containing a single true value.'));
  end
  insertAt = idx + isAfter;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
