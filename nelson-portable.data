function tf = report_isErrorStatus(testCase)
  outcome = report_caseOutcome(testCase);
  tf = strcmp(outcome, 'error') || strcmp(outcome, 'timeout');
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function tf = report_isSkippedStatus(testCase)
  outcome = report_caseOutcome(testCase);
  tf = strcmp(outcome, 'skipped') || strcmp(outcome, 'filtered');
end
