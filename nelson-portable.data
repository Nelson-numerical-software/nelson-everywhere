% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function selected = select_casesNotByName(cases, names)
  selected = struct([]);
  for k = 1:length(cases)
    if ~any(strcmp(names, cases(k).name))
      selected = [selected; cases(k)];
    end
  end
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function tf = select_hasTags(actual, expected)
  tf = false;
  if isempty(expected)
    return
  end
  expected = cellstr(string(expected));
  for k = 1:length(expected)
    tf = tf || any(strcmp(actual, expected{k}));
  end
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function tf = select_isSelected(testCase, options)
  tf = select_matchesText(testCase.name, options.Name) ...
    && select_matchesText(testCase.module, options.Module) ...
    && select_matchesText(testCase.file, options.File) ...
    && select_matchesKind(testCase.kind, options.Kind) ...
    && select_matchesIncludePattern(testCase.name, options.Match) ...
    && ~select_matchesExcludePattern(testCase.name, options.Exclude) ...
    && select_matchesRequiredTags(testCase.tags, options.Tags) ...
    && ~select_hasTags(testCase.tags, options.ExcludeTags);
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function tf = select_matchesExcludePattern(value, pattern)
  tf = false;
  if ~isempty(pattern)
    tf = contains(value, pattern);
  end
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function tf = select_matchesIncludePattern(value, pattern)
  tf = isempty(pattern);
  if ~tf
    tf = contains(value, pattern);
  end
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function tf = select_matchesKind(value, expected)
  tf = isempty(expected);
  if tf
    return
  end
  expected = cellstr(string(expected));
  value = char(string(value));
  tf = false;
  for k = 1:length(expected)
    kind = expected{k};
    tf = tf || strcmp(kind, 'all') ...
      || (strcmp(kind, 'all_tests') && (strcmp(value, 'test') || strcmp(value, 'bug'))) ...
      || strcmp(kind, value);
  end
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function tf = select_matchesRequiredTags(actual, expected)
  tf = isempty(expected) || select_hasTags(actual, expected);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function tf = select_matchesText(value, expected)
  tf = isempty(expected);
  if ~tf
    expected = cellstr(string(expected));
    value = char(string(value));
    tf = any(strcmp(expected, value));
  end
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function options = select_parseSelectOptions(args)
  options = struct('Name', [], 'Module', [], 'File', [], 'Kind', [], ...
    'Tags', [], 'ExcludeTags', [], 'Match', [], 'Exclude', []);
  k = 1;
  while k <= length(args)
    if k == length(args)
      error('Nelson:tests_manager:optionValueExpected', 'Option value expected.');
    end
    name = args{k};
    value = args{k + 1};
    if isfield(options, name)
      options.(name) = value;
    else
      error('Nelson:tests_manager:unsupportedOption', 'Unsupported option.');
    end
    k = k + 2;
  end
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function tf = should_disable_audio(test_case)
  % The audio module (its file-I/O builtins audioread/audiowrite/audioinfo, and
  % the device functions) is disabled with --noaudio in every non-audio test
  % child. A test that needs the module must declare it: AUDIO INPUT/OUTPUT
  % REQUIRED (device needed) or AUDIO REQUIRED (builtins only, no device).
  audio_required = test_case.options.audio_input_required ...
    || test_case.options.audio_output_required ...
    || test_case.options.audio_required;
  tf = ~audio_required && ~endsWith(test_case.classname, '.audio');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = skip_impl(varargin)
  narginchk(0, 2);
  nargoutchk(0, 0);

  varargout = {};
  condition = false;
  reason = '';

  if nargin == 0
    condition = true;
  elseif nargin == 1
    if islogical(varargin{1})
      condition = varargin{1};
    else
      reason = varargin{1};
      condition = true;
    end
  else
    condition = varargin{1};
    reason = varargin{2};
  end

  if condition
    if isempty(reason)
      reason = _('Testsuite skipped');
    end
    error('Nelson:tests_manager:testsuite_skipped', reason);
  end
end
