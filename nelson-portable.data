%=============================================================================
function [B, I] = sortrows(A, varargin)
  sortable = A.codes;
  sortable(sortable == 0) = Inf;
  I = (1:size(sortable, 1))';
  for col = size(sortable, 2):-1:1
    [~, order] = sort(sortable(I, col), varargin{:});
    I = I(order);
  end
  B = A(I, :);
end
