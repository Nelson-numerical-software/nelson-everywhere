% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function optimFminconDiagnostics(data, opts)
  if ~strcmpi(opts.Diagnostics, 'on')
    return
  end
  disp('____________________________________________________________')
  disp('   Diagnostic Information')
  disp(' ')
  disp(['Number of variables: ', int2str(length(data.x0))])
  disp(' ')
  disp('Functions')
  disp(['Objective:                            ', functionName(data.fun)])
  disp(['Gradient:                             ', gradientMode(opts)])
  disp(['Hessian:                              ', hessianMode(opts)])
  disp(' ')
  disp('Constraints')
  disp(['Nonlinear constraints:                ', nonlinearMode(data)])
  disp(' ')
  disp(['Number of linear inequality constraints:    ', int2str(size(data.A, 1))])
  disp(['Number of linear equality constraints:      ', int2str(size(data.Aeq, 1))])
  disp(['Number of lower bound constraints:          ', int2str(sum(isfinite(data.lb)))])
  disp(['Number of upper bound constraints:          ', int2str(sum(isfinite(data.ub)))])
  disp(' ')
  disp('Algorithm selected')
  disp(['   ', data.algorithm])
  disp(' ')
  disp('____________________________________________________________')
  disp('   End diagnostic information')
end
%=============================================================================
function name = functionName(fun)
  if isa(fun, 'function_handle')
    name = func2str(fun);
  elseif isstring(fun)
    name = char(fun);
  else
    name = fun;
  end
end
%=============================================================================
function mode = gradientMode(opts)
  if opts.SpecifyObjectiveGradient || strcmpi(opts.GradObj, 'on')
    mode = 'user-supplied';
  else
    mode = 'finite-differencing';
  end
end
%=============================================================================
function mode = hessianMode(opts)
  if ~isempty(opts.HessianFcn) || ~isempty(opts.HessFcn)
    mode = 'user-supplied';
  elseif ~isempty(opts.HessianMultiplyFcn) || ~isempty(opts.HessMult)
    mode = 'user-supplied multiply function';
  elseif isnumeric(opts.Hessian) && ~isempty(opts.Hessian)
    mode = 'user-supplied matrix';
  else
    mode = opts.HessianApproximation;
  end
end
%=============================================================================
function mode = nonlinearMode(data)
  if isempty(data.nonlcon)
    mode = 'do not exist';
  else
    mode = 'exist';
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function H = optimFminconInitialHessian(x, opts)
  n = length(x);
  if strcmpi(opts.ScaleProblem, 'none')
    H = eye(n);
    return
  end
  if isempty(opts.TypicalX)
    scale = max(1, abs(x(:)));
  elseif isscalar(opts.TypicalX)
    scale = abs(double(opts.TypicalX)) * ones(n, 1);
  else
    scale = abs(double(opts.TypicalX(:)));
  end
  if length(scale) ~= n
    scale = ones(n, 1);
  end
  scale(~isfinite(scale) | scale < sqrt(eps)) = 1;
  diagonal = 2 ./ (scale(:) .^ 2);
  diagonal = min(max(diagonal, 1e-12), 1e12);
  H = diag(diagonal);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function result = optimFminconInteriorPoint(data, opts, coreSolver)
  interior = data;
  weights = barrierSchedule(opts);
  warm = data.x0;
  barrierIterations = 0;
  for k = 1:length(weights)
    warm = interiorStart(data, opts, warm, weights(k));
    barrierIterations = barrierIterations + 1;
  end
  interior.x0 = warm;
  result = coreSolver(interior, opts);
  result.output.algorithm = 'interior-point';
  result.output.barrieriterations = barrierIterations;
  result = acceptFeasibleStationary(result, opts);
end
%=============================================================================
function result = acceptFeasibleStationary(result, opts)
  if result.exitflag ~= 0
    return
  end
  feasible = result.output.constrviolation <= max(opts.ConstraintTolerance, 1e-5);
  stationary = result.output.firstorderopt <= max(2e-1, 10 * sqrt(opts.OptimalityTolerance));
  if feasible && stationary
    result.exitflag = 1;
    result.output.message = _('Local minimum found that satisfies the constraints.');
  end
end
%=============================================================================
function weights = barrierSchedule(opts)
  first = barrierWeight(opts);
  weights = first * [1, 0.1, 0.01];
  weights = weights(weights > 0);
end
%=============================================================================
function x = interiorStart(data, opts, x0, weight)
  x = min(max(x0, data.lb), data.ub);
  x = shiftBounds(x, data.lb, data.ub);
  if isempty(data.A) && isempty(data.Aeq)
    return
  end
  barrier = @(z) barrierObjective(data, z, opts, weight);
  searchOpts = optimset('Display', 'off', 'MaxIter', min(80, opts.MaxIter), ...
    'MaxFunEvals', min(800, opts.MaxFunEvals), 'TolX', opts.StepTolerance, ...
    'TolFun', opts.FunctionTolerance);
  [candidate, ~, exitflag] = fminsearch(barrier, x, searchOpts);
  if exitflag >= 0
    x = min(max(candidate(:), data.lb), data.ub);
  end
end
%=============================================================================
function x = shiftBounds(x, lb, ub)
  both = find(isfinite(lb) & isfinite(ub) & ub > lb);
  for k = both(:)'
    margin = min(1e-3 * max(1, ub(k) - lb(k)), 0.25 * (ub(k) - lb(k)));
    x(k) = min(max(x(k), lb(k) + margin), ub(k) - margin);
  end
  lowerOnly = find(isfinite(lb) & ~isfinite(ub));
  x(lowerOnly) = max(x(lowerOnly), lb(lowerOnly) + 1e-3);
  upperOnly = find(~isfinite(lb) & isfinite(ub));
  x(upperOnly) = min(x(upperOnly), ub(upperOnly) - 1e-3);
end
%=============================================================================
function value = barrierObjective(data, z, opts, weight)
  z = min(max(z(:), data.lb), data.ub);
  f = optimCheckFunValue(optimCall(data.fun, z), opts);
  if ~isnumeric(f) || ~isscalar(f)
    error('Nelson:optimization:invalidObjectiveScalar', '%s must return a numeric scalar.', 'Objective function');
  end
  slack = [data.b - data.A * z; z - data.lb; data.ub - z];
  finiteSlack = slack(isfinite(slack));
  bad = finiteSlack <= 0;
  penalty = sum(max(0, data.A * z - data.b) .^ 2) + sum((data.Aeq * z - data.beq) .^ 2);
  if any(bad)
    value = double(f) + 1e6 * (1 + sum(abs(finiteSlack(bad)))) + 1e8 * penalty;
  else
    value = double(f) - weight * sum(log(max(finiteSlack, realmin))) + 1e6 * penalty;
  end
end
%=============================================================================
function weight = barrierWeight(opts)
  if isfield(opts, 'InitBarrierParam') && ~isempty(opts.InitBarrierParam) && opts.InitBarrierParam > 0
    weight = opts.InitBarrierParam;
  else
    weight = 1e-3;
  end
  if isfield(opts, 'BarrierParamUpdate') && strcmpi(opts.BarrierParamUpdate, 'predictor-corrector')
    weight = 0.1 * weight;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function result = optimFminconNonlinearSQP(data, opts, coreSolver)
  trialOpts = quietOptions(opts);
  sqpResult = coreSolver(data, trialOpts);
  if acceptSQP(sqpResult, opts)
    result = sqpResult;
    result.output.algorithm = data.algorithm;
    return
  end
  penaltyResult = optimFminconPenaltySearch(data, opts);
  polishedResult = polishPenaltyPoint(data, opts, coreSolver, penaltyResult);
  result = chooseNonlinearResult(sqpResult, chooseNonlinearResult(penaltyResult, polishedResult, opts), opts);
end
%=============================================================================
function opts = quietOptions(opts)
  opts.Display = 'off';
  opts.OutputFcn = [];
  opts.MaxIter = min(opts.MaxIter, 80);
  opts.MaxIterations = opts.MaxIter;
  opts.MaxFunEvals = min(opts.MaxFunEvals, 1200);
  opts.MaxFunctionEvaluations = opts.MaxFunEvals;
end
%=============================================================================
function tf = acceptSQP(result, opts)
  feasible = result.output.constrviolation <= max(opts.ConstraintTolerance, 1e-5);
  stationary = result.output.firstorderopt <= max(1e-3, 20 * sqrt(opts.OptimalityTolerance));
  tf = result.exitflag > 0 && feasible && stationary;
end
%=============================================================================
function result = polishPenaltyPoint(data, opts, coreSolver, penaltyResult)
  if isempty(penaltyResult.x)
    result = penaltyResult;
    return
  end
  localData = data;
  localData.x0 = penaltyResult.x;
  localOpts = quietOptions(opts);
  localOpts.MaxIter = min(opts.MaxIter, 60);
  localOpts.MaxIterations = localOpts.MaxIter;
  result = coreSolver(localData, localOpts);
  result.output.algorithm = data.algorithm;
end
%=============================================================================
function result = chooseNonlinearResult(sqpResult, penaltyResult, opts)
  sqpFeasible = sqpResult.output.constrviolation <= max(opts.ConstraintTolerance, 1e-5);
  penaltyFeasible = penaltyResult.output.constrviolation <= max(opts.ConstraintTolerance, 1e-5);
  if sqpFeasible && (~penaltyFeasible || sqpResult.fval <= penaltyResult.fval)
    result = sqpResult;
  else
    result = penaltyResult;
  end
  if result.exitflag == 0 && result.output.constrviolation <= max(opts.ConstraintTolerance, 1e-5)
    result.exitflag = 1;
    result.output.message = _('Local minimum found that satisfies the constraints.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function result = optimFminconPenaltySearch(data, opts)
  penalties = [1e4, 1e6, 1e8];
  starts = startPoints(data);
  bestPenalty = Inf;
  bestF = Inf;
  bestFeasible = false;
  totalIterations = 0;
  totalFuncCount = 0;
  exitflag = 0;
  x = data.x0;
  [state, initCount] = optimFminconState(data, x, opts);
  totalFuncCount = totalFuncCount + initCount;
  displayHeader(opts);
  if optimOutputStop(opts.OutputFcn, x, makeValues(state, 0, totalFuncCount, 0), 'init')
    result = makeResult(data, opts, x, state, eye(length(x)), -1, 0, totalFuncCount, _('Stopped by output function.'));
    return
  end
  for p = 1:length(penalties)
    objective = @(z) penaltyObjective(data, z, opts, penalties(p));
    searchOpts = penaltyOptions(opts, p == length(penalties));
    for k = 1:size(starts, 2)
      [candidate, penaltyValue, localExit, searchOutput] = fminsearch(objective, starts(:, k), searchOpts);
      candidate = min(max(candidate(:), data.lb), data.ub);
      [candidateState, ~] = optimFminconState(data, candidate, opts);
      feasible = candidateState.violation <= max(opts.ConstraintTolerance, 1e-5);
      take = (feasible && (~bestFeasible || candidateState.f < bestF)) || (~bestFeasible && penaltyValue < bestPenalty);
      if take
        x = candidate;
        bestPenalty = penaltyValue;
        bestF = candidateState.f;
        bestFeasible = feasible;
        exitflag = localExit;
      end
      totalIterations = totalIterations + searchOutput.iterations;
      totalFuncCount = totalFuncCount + searchOutput.funcCount;
      values = makeValues(candidateState, totalIterations, totalFuncCount, norm(candidate - data.x0, Inf));
      displayIter(opts, values);
      if optimOutputStop(opts.OutputFcn, candidate, values, 'iter')
        x = candidate;
        state = candidateState;
        exitflag = -1;
        break
      end
    end
    starts = [x, starts(:, 1)];
    if exitflag < 0
      break
    end
  end
  [state, funcCount] = optimFminconState(data, x, opts);
  H = eye(length(x));
  exitflag = positiveExitflag(exitflag, state, opts);
  result = makeResult(data, opts, x, state, H, exitflag, totalIterations, totalFuncCount + funcCount, exitMessage(exitflag));
  optimOutputStop(opts.OutputFcn, x, makeValues(state, totalIterations, result.output.funcCount, 0), 'done');
  displayFinal(opts, result.output.message);
end
%=============================================================================
function searchOpts = penaltyOptions(opts, finalPass)
  if finalPass
    maxIter = opts.MaxIter;
    maxFunEvals = opts.MaxFunEvals;
  else
    maxIter = min(40, opts.MaxIter);
    maxFunEvals = min(400, opts.MaxFunEvals);
  end
  searchOpts = optimset('Display', 'off', 'MaxIter', maxIter, 'MaxFunEvals', maxFunEvals, ...
    'TolX', opts.StepTolerance, 'TolFun', opts.FunctionTolerance);
end
%=============================================================================
function result = makeResult(data, opts, x, state, H, exitflag, iterations, funcCount, message)
  lambda = estimateLambda(data, opts, state);
  result.x = x;
  result.fval = state.f;
  result.exitflag = exitflag;
  result.lambda = lambda;
  result.grad = state.grad;
  result.hessian = H;
  result.output = struct();
  result.output.iterations = iterations;
  result.output.funcCount = funcCount;
  result.output.constrviolation = state.violation;
  result.output.stepsize = norm(x - data.x0, Inf);
  result.output.algorithm = data.algorithm;
  result.output.firstorderopt = norm(state.grad, Inf);
  result.output.cgiterations = 0;
  result.output.message = message;
  result.output.bestfeasible = bestFeasible(state, x, opts);
end
%=============================================================================
function lambda = estimateLambda(data, opts, state)
  lambda = emptyLambda(data, state);
  active = find(state.cineq >= -opts.ConstraintTolerance);
  W = [state.Jeq; state.Jineq(active, :)];
  if isempty(W)
    return
  end
  multipliers = solveMultipliers(W, state.grad);
  neq = size(state.Jeq, 1);
  eqMultipliers = sliceVector(multipliers, 1, neq);
  ineqMultipliers = zeros(size(state.cineq));
  ineqMultipliers(active) = max(0, sliceVector(multipliers, neq + 1, length(multipliers)));
  nEqLin = size(data.Aeq, 1);
  nLin = size(data.A, 1);
  nNon = length(state.cnonlin);
  n = length(data.x0);
  lambda.eqlin = sliceVector(eqMultipliers, 1, nEqLin);
  lambda.eqnonlin = sliceVector(eqMultipliers, nEqLin + 1, length(eqMultipliers));
  lambda.ineqlin = sliceVector(ineqMultipliers, 1, nLin);
  lambda.ineqnonlin = sliceVector(ineqMultipliers, nLin + 1, nLin + nNon);
  lowerStart = nLin + nNon + 1;
  lowerCount = length(data.lowerIndex);
  upperCount = length(data.upperIndex);
  lowerValues = sliceVector(ineqMultipliers, lowerStart, lowerStart + lowerCount - 1);
  upperValues = sliceVector(ineqMultipliers, lowerStart + lowerCount, ...
    lowerStart + lowerCount + upperCount - 1);
  lambda.lower = zeros(n, 1);
  lambda.upper = zeros(n, 1);
  lambda.lower(data.lowerIndex) = lowerValues;
  lambda.upper(data.upperIndex) = upperValues;
end
%=============================================================================
function multipliers = solveMultipliers(W, grad)
  rhs = -grad(:);
  system = W * W';
  target = W * rhs;
  try
    multipliers = system \ target;
    if all(isfinite(multipliers))
      return
    end
  catch
  end
  multipliers = pinv(W') * rhs;
end
%=============================================================================
function value = sliceVector(x, first, last)
  if last < first
    value = zeros(0, 1);
  else
    value = x(first:last);
  end
end
%=============================================================================
function best = bestFeasible(state, x, opts)
  if state.violation > opts.ConstraintTolerance
    best = [];
    return
  end
  best.x = x;
  best.fval = state.f;
  best.firstorderopt = norm(state.grad, Inf);
  best.constrviolation = state.violation;
end
%=============================================================================
function values = makeValues(state, iter, funcCount, stepSize)
  values = struct();
  values.fval = state.f;
  values.iteration = iter;
  values.funccount = funcCount;
  values.constrviolation = state.violation;
  values.stepsize = stepSize;
  values.firstorderopt = norm(state.grad, Inf);
end
%=============================================================================
function starts = startPoints(data)
  starts = data.x0(:);
  n = length(data.x0);
  finiteBoth = isfinite(data.lb) & isfinite(data.ub);
  if n <= 5 && any(finiteBoth)
    middle = starts(:, 1);
    middle(finiteBoth) = (data.lb(finiteBoth) + data.ub(finiteBoth)) / 2;
    lower = starts(:, 1);
    lower(isfinite(data.lb)) = data.lb(isfinite(data.lb));
    upper = starts(:, 1);
    upper(isfinite(data.ub)) = data.ub(isfinite(data.ub));
    starts = [starts, middle, lower, upper];
  end
end
%=============================================================================
function value = penaltyObjective(data, z, opts, penalty)
  z = min(max(z(:), data.lb), data.ub);
  f = optimCheckFunValue(optimCall(data.fun, z), opts);
  if ~isnumeric(f) || ~isscalar(f)
    error('Nelson:optimization:invalidObjectiveScalar', '%s must return a numeric scalar.', 'Objective function');
  end
  cineq = [data.A * z - data.b; data.lb - z; z - data.ub];
  ceq = data.Aeq * z - data.beq;
  if ~isempty(data.nonlcon)
    [c, ceqNonlin] = optimCall(data.nonlcon, z);
    cineq = [cineq; double(c(:))];
    ceq = [ceq; double(ceqNonlin(:))];
  end
  value = double(f) + penalty * (sum(max(0, cineq) .^ 2) + sum(ceq .^ 2));
end
%=============================================================================
function lambda = emptyLambda(data, state)
  n = length(data.x0);
  lambda.lower = zeros(n, 1);
  lambda.upper = zeros(n, 1);
  lambda.ineqlin = zeros(size(data.A, 1), 1);
  lambda.eqlin = zeros(size(data.Aeq, 1), 1);
  lambda.ineqnonlin = zeros(length(state.cnonlin), 1);
  lambda.eqnonlin = zeros(length(state.ceqnonlin), 1);
end
%=============================================================================
function flag = positiveExitflag(searchFlag, state, opts)
  if searchFlag < 0
    flag = searchFlag;
  elseif state.violation <= max(opts.ConstraintTolerance, 1e-5)
    flag = 1;
  else
    flag = searchFlag;
  end
end
%=============================================================================
function msg = exitMessage(exitflag)
  if exitflag > 0
    msg = _('Local minimum found that satisfies the constraints.');
  elseif exitflag < 0
    msg = _('Stopped by output function.');
  else
    msg = _('Maximum number of iterations or function evaluations reached.');
  end
end
%=============================================================================
function displayHeader(opts)
  if isIterDisplay(opts)
    disp(' Iteration   Func-count         Fval   Feasibility   First-order opt')
  end
end
%=============================================================================
function displayIter(opts, values)
  if ~isIterDisplay(opts)
    return
  end
  disp([int2str(values.iteration), '           ', int2str(values.funccount), '        ', ...
    num2str(values.fval, 12), '    ', num2str(values.constrviolation, 6), ...
    '       ', num2str(values.firstorderopt, 6)])
end
%=============================================================================
function displayFinal(opts, message)
  if isNoDisplay(opts)
    return
  end
  if isIterDisplay(opts)
    disp(' ')
  end
  if isFinalDisplay(opts) || isIterDisplay(opts) || isNotifyDisplay(opts)
    disp(message)
  end
end
%=============================================================================
function tf = isIterDisplay(opts)
  tf = strcmpi(opts.Display, 'iter') || strcmpi(opts.Display, 'iter-detailed');
end
%=============================================================================
function tf = isFinalDisplay(opts)
  tf = strcmpi(opts.Display, 'final') || strcmpi(opts.Display, 'final-detailed');
end
%=============================================================================
function tf = isNoDisplay(opts)
  tf = strcmpi(opts.Display, 'off') || strcmpi(opts.Display, 'none');
end
%=============================================================================
function tf = isNotifyDisplay(opts)
  tf = strcmpi(opts.Display, 'notify') || strcmpi(opts.Display, 'notify-detailed');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function data = optimFminconPrepare(fun, x0, A, b, Aeq, beq, lb, ub, nonlcon, opts)
  if isempty(x0)
    error('Nelson:validators:mustBeNonempty', '%s must be nonempty.', 'Initial point');
  end
  if ~isnumeric(x0) || ~isreal(x0)
    error('Nelson:optimization:invalidInitialPoint', '%s must be a real numeric array.', 'Initial point');
  end
  if ~(isa(fun, 'function_handle') || ischar(fun) || isstring(fun))
    error('Nelson:optimization:invalidObjective', 'Objective must be a function handle or a function name.');
  end
  x = double(x0(:));
  n = length(x);
  [A, b] = normalizeLinear(A, b, n, 'A');
  [Aeq, beq] = normalizeLinear(Aeq, beq, n, 'Aeq');
  lb = normalizeBound(lb, n, -Inf);
  ub = normalizeBound(ub, n, Inf);
  if any(lb > ub)
    error('Nelson:optimization:boundsInconsistent', 'Lower bounds must not exceed upper bounds.');
  end
  algorithm = lower(char(opts.Algorithm));
  valid = {'interior-point', 'sqp', 'sqp-legacy', 'active-set', 'trust-region-reflective'};
  if ~any(strcmp(algorithm, valid))
    error('Nelson:optim:invalidOptionValue', 'Invalid value for "%s".', 'Algorithm');
  end
  validateTextChoice(opts.Display, {'off', 'none', 'final', 'final-detailed', 'notify', ...
    'notify-detailed', 'iter', 'iter-detailed'}, sprintf(_('Invalid value for "%s".'), 'Display'));
  validateTextChoice(opts.Diagnostics, {'on', 'off'}, sprintf(_('Invalid value for "%s".'), 'Diagnostics'));
  validateTextChoice(opts.FiniteDifferenceType, {'forward', 'central'}, sprintf(_('Invalid value for "%s".'), 'FiniteDifferenceType'));
  if strcmp(algorithm, 'trust-region-reflective')
    if ~isempty(nonlcon) || ~isempty(A)
      error('Nelson:fmincon:trustRegionConstraints', 'Trust-region-reflective requires bound constraints or linear equalities only.');
    end
    if ~opts.SpecifyObjectiveGradient
      error('Nelson:fmincon:trustRegionGradient', 'Trust-region-reflective requires SpecifyObjectiveGradient set to true.');
    end
  end
  data.fun = fun;
  data.x0 = prepareInitialPoint(x, lb, ub, algorithm);
  data.xShape = size(x0);
  data.A = A;
  data.b = b;
  data.Aeq = Aeq;
  data.beq = beq;
  data.lb = lb;
  data.ub = ub;
  data.lowerIndex = find(isfinite(lb));
  data.upperIndex = find(isfinite(ub));
  data.Jlower = boundJacobian(data.lowerIndex, n, -1);
  data.Jupper = boundJacobian(data.upperIndex, n, 1);
  data.nonlcon = nonlcon;
  data.algorithm = algorithm;
end
%=============================================================================
function validateTextChoice(value, choices, message)
  value = lower(char(value));
  if ~any(strcmp(value, choices))
    error('Nelson:optimization:invalidValue', message);
  end
end
%=============================================================================
function [A, b] = normalizeLinear(A, b, n, name)
  if isempty(A)
    A = zeros(0, n);
    b = zeros(0, 1);
    return
  end
  A = double(A);
  b = double(b(:));
  if size(A, 2) ~= n
    error('Nelson:optimization:columnPerVariable', '%s must have one column for each variable.', name);
  end
  if size(A, 1) ~= length(b)
    error('Nelson:optimization:sizeMismatch', '%s and right hand side dimensions must agree.', name);
  end
end
%=============================================================================
function bound = normalizeBound(bound, n, defaultValue)
  if isempty(bound)
    bound = defaultValue * ones(n, 1);
  elseif isscalar(bound)
    bound = double(bound) * ones(n, 1);
  else
    bound = double(bound(:));
  end
  if length(bound) ~= n
    error('Nelson:dimagree:boundsNumberElementsX0', 'Bounds must have the same number of elements as x0.');
  end
end
%=============================================================================
function x = prepareInitialPoint(x, lb, ub, algorithm)
  x = min(max(x, lb), ub);
  if strcmp(algorithm, 'interior-point')
    both = find(isfinite(lb) & isfinite(ub) & (ub > lb));
    for k = both(:)'
      delta = 0.5 * min(1, ub(k) - lb(k));
      if x(k) <= lb(k)
        x(k) = lb(k) + delta;
      elseif x(k) >= ub(k)
        x(k) = ub(k) - delta;
      end
    end
  end
end
%=============================================================================
function J = boundJacobian(indices, n, signValue)
  m = length(indices);
  J = zeros(m, n);
  if m > 0
    rows = (1:m)';
    cols = indices(:);
    J(rows + (cols - 1) * m) = signValue;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [fun, x0, A, b, Aeq, beq, lb, ub, nonlcon, options] = optimFminconProblem(problem)
  if ~isfield(problem, 'objective') || ~isfield(problem, 'x0')
    error('Nelson:optimization:problemMissingObjective', 'Problem structure must contain %s fields.', 'objective and x0');
  end
  if ~isfield(problem, 'solver') || ~isfield(problem, 'options')
    error('Nelson:optimization:invalidProblemStructure', 'Problem structure must contain %s fields.', 'solver and options');
  end
  if ~strcmpi(char(problem.solver), 'fmincon')
    error('Nelson:optimization:invalidProblemSolver', 'Problem solver must be %s.', 'fmincon');
  end
  fun = problem.objective;
  x0 = problem.x0;
  A = getField(problem, 'Aineq', getField(problem, 'A', []));
  b = getField(problem, 'bineq', getField(problem, 'b', []));
  Aeq = getField(problem, 'Aeq', []);
  beq = getField(problem, 'beq', []);
  lb = getField(problem, 'lb', []);
  ub = getField(problem, 'ub', []);
  nonlcon = getField(problem, 'nonlcon', []);
  options = getField(problem, 'options', []);
end
%=============================================================================
function value = getField(st, name, defaultValue)
  if isfield(st, name)
    value = st.(name);
  else
    value = defaultValue;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function result = optimFminconSQP(data, opts)
  if strcmp(data.algorithm, 'trust-region-reflective')
    result = optimFminconTRR(data, opts);
    return
  end
  if strcmp(data.algorithm, 'interior-point')
    result = optimFminconInteriorPoint(data, opts, @optimFminconSQPCore);
  elseif strcmp(data.algorithm, 'active-set')
    result = optimFminconActiveSet(data, opts);
  elseif strcmp(data.algorithm, 'sqp-legacy')
    result = optimFminconSQPLegacy(data, opts);
  else
    result = optimFminconSQPCore(data, opts);
  end
  result = restoreNonlinearFeasibility(data, opts, result);
  result = flagInfeasibleResult(result, opts);
end
%=============================================================================
function result = flagInfeasibleResult(result, opts)
  % A stopped solver whose final point still violates the constraints must
  % report exitflag -2.
  if result.exitflag < 0
    return
  end
  if result.output.constrviolation > max(opts.ConstraintTolerance, 1e-5)
    result.exitflag = -2;
    result.output.message = sprintf(_('Converged to an infeasible point.\n\nfmincon stopped because the size of the current step is less than\nthe value of the step size tolerance but constraints are not\nsatisfied to within the value of the constraint tolerance.'));
  end
end
%=============================================================================
function result = restoreNonlinearFeasibility(data, opts, result)
  if isempty(data.nonlcon)
    return
  end
  if result.output.constrviolation <= max(opts.ConstraintTolerance, 1e-5)
    if result.exitflag == 0 && result.output.firstorderopt <= max(2e-2, 20 * sqrt(opts.OptimalityTolerance))
      result.exitflag = 1;
      result.output.message = localMinimumMessage();
    end
    return
  end
  restoreData = data;
  restoreData.x0 = result.x;
  restoreOpts = opts;
  restoreOpts.Display = 'off';
  penaltyResult = optimFminconPenaltySearch(restoreData, restoreOpts);
  if isBetterNonlinearResult(penaltyResult, result, opts)
    result = penaltyResult;
    result.output.algorithm = data.algorithm;
    result.output.restoration = true;
  else
    result.output.restoration = false;
  end
end
%=============================================================================
function tf = isBetterNonlinearResult(candidate, current, opts)
  cFeasible = candidate.output.constrviolation <= max(opts.ConstraintTolerance, 1e-5);
  rFeasible = current.output.constrviolation <= max(opts.ConstraintTolerance, 1e-5);
  tf = (cFeasible && ~rFeasible) || (cFeasible && rFeasible && candidate.fval < current.fval) ...
    || (~cFeasible && candidate.output.constrviolation < current.output.constrviolation);
end
%=============================================================================
function result = optimFminconSQPCore(data, opts)
  x = data.x0;
  n = length(x);
  H = optimFminconInitialHessian(x, opts);
  funcCount = 0;
  exitflag = 0;
  best = [];
  message = sprintf(_('Solver stopped prematurely.\n\nfmincon stopped because it exceeded the iteration limit,\noptions.MaxIterations = %e.'), sqpIterationLimit(opts));
  [state, added] = optimFminconState(data, x, opts);
  funcCount = funcCount + added;
  displayHeader(opts);
  if optimOutputStop(opts.OutputFcn, x, makeValues(state, 0, funcCount, 0), 'init')
    result = stoppedResult(data, opts, x, state, H, funcCount);
    return
  end
  iter = 0;
  maxIter = sqpIterationLimit(opts);
  for iter = 1:maxIter
    best = updateBest(best, x, state, opts);
    if state.violation <= opts.ConstraintTolerance && state.f <= opts.ObjectiveLimit
      exitflag = -3; message = sprintf(_('Problem appears unbounded.\n\nfmincon stopped because the objective function value is less than\nthe value of the objective function limit.')); break
    end
    [step, qpLambda] = sqpStep(H, state, opts);
    if state.violation <= opts.ConstraintTolerance && norm(step, Inf) <= opts.StepTolerance
      exitflag = 2; message = stepToleranceMessage(); break
    end
    [trial, trialState, accepted, alpha, used] = lineSearch(data, opts, x, state, step, qpLambda);
    funcCount = funcCount + used;
    if accepted
      s = trial - x;
      y = trialState.grad - state.grad;
      H = updateHessian(H, s, y);
      if abs(state.f - trialState.f) <= opts.FunctionTolerance && trialState.violation <= opts.ConstraintTolerance
        % The reference reserves exitflag 3 for trust-region-reflective; the
        % other algorithms report a small step as exitflag 2.
        x = trial; state = trialState; exitflag = 2; message = stepToleranceMessage(); break
      end
      x = trial; state = trialState;
    else
      exitflag = 0; message = 'Line search failed to find a lower merit value.'; break
    end
    values = makeValues(state, iter, funcCount, norm(alpha * step, Inf));
    if optimOutputStop(opts.OutputFcn, x, values, 'iter')
      exitflag = -1; message = _('Solver stopped by an output function or plot function.'); break
    end
    displayIter(opts, values);
    if state.violation <= opts.ConstraintTolerance && firstOrderEstimate(state, qpLambda) <= opts.OptimalityTolerance
      exitflag = 1; message = localMinimumMessage(); break
    end
    if funcCount >= opts.MaxFunEvals
      break
    end
  end
  best = updateBest(best, x, state, opts);
  lambda = finalMultipliers(H, state, data, opts);
  firstorderopt = optimalityFromLambda(state, data, lambda);
  if exitflag == 0 && state.violation <= opts.ConstraintTolerance && firstorderopt <= max(2e-2, sqrt(opts.OptimalityTolerance))
    exitflag = 1;
    message = localMinimumMessage();
  end
  result.x = x;
  result.fval = state.f;
  result.exitflag = exitflag;
  result.lambda = lambda;
  result.grad = state.grad;
  result.hessian = H;
  result.output = makeOutput(iter, funcCount, state, data, message, best, normStepValue(x, data.x0), firstorderopt);
  optimOutputStop(opts.OutputFcn, x, makeValues(state, iter, funcCount, 0), 'done');
  displayFinal(opts, result.output.message);
end
%=============================================================================
function message = localMinimumMessage()
  message = sprintf(_('Local minimum found that satisfies the constraints.\n\nOptimization completed because the objective function is non-decreasing in\nfeasible directions, to within the value of the optimality tolerance,\nand constraints are satisfied to within the value of the constraint tolerance.'));
end
%=============================================================================
function message = stepToleranceMessage()
  message = sprintf(_('Local minimum possible.\n\nfmincon stopped because the size of the current step is less than\nthe value of the step size tolerance and constraints are\nsatisfied to within the value of the constraint tolerance.'));
end
%=============================================================================
function [step, lambda] = sqpStep(H, state, opts)
  n = length(state.grad);
  maxIter = max(20, 5 * n + size(state.Jineq, 1) + size(state.Jeq, 1));
  [step, lambda] = optimFminconScaledQP(H, state, opts, maxIter);
end
%=============================================================================
function result = stoppedResult(data, opts, x, state, H, funcCount)
  lambda = finalMultipliers(H, state, data, opts);
  firstorderopt = optimalityFromLambda(state, data, lambda);
  result.x = x;
  result.fval = state.f;
  result.exitflag = -1;
  result.lambda = lambda;
  result.grad = state.grad;
  result.hessian = H;
  result.output = makeOutput(0, funcCount, state, data, _('Solver stopped by an output function or plot function.'), [], 0, firstorderopt);
end
%=============================================================================
function displayHeader(opts)
  if ~isIterDisplay(opts)
    return
  end
  disp(' Iteration   Func-count         Fval   Feasibility   First-order opt')
end
%=============================================================================
function displayIter(opts, values)
  if ~isIterDisplay(opts)
    return
  end
  disp([int2str(values.iteration), '           ', int2str(values.funccount), '        ', ...
    num2str(values.fval, 12), '    ', num2str(values.constrviolation, 6), ...
    '       ', num2str(values.firstorderopt, 6)])
end
%=============================================================================
function displayFinal(opts, message)
  if isNoDisplay(opts)
    return
  end
  if isIterDisplay(opts)
    disp(' ')
  end
  if isFinalDisplay(opts) || isIterDisplay(opts) || isNotifyDisplay(opts)
    disp(message)
  end
end
%=============================================================================
function tf = isIterDisplay(opts)
  tf = strcmpi(opts.Display, 'iter') || strcmpi(opts.Display, 'iter-detailed');
end
%=============================================================================
function tf = isFinalDisplay(opts)
  tf = strcmpi(opts.Display, 'final') || strcmpi(opts.Display, 'final-detailed');
end
%=============================================================================
function tf = isNoDisplay(opts)
  tf = strcmpi(opts.Display, 'off') || strcmpi(opts.Display, 'none');
end
%=============================================================================
function tf = isNotifyDisplay(opts)
  tf = strcmpi(opts.Display, 'notify') || strcmpi(opts.Display, 'notify-detailed');
end
%=============================================================================
function [trial, trialState, accepted, alpha, count] = lineSearch(data, opts, x, state, step, qpLambda)
  alpha = 1;
  step = boundedLineSearchStep(x, step, opts);
  rho = meritPenalty(state, qpLambda);
  base = meritValue(state, rho);
  accepted = false;
  count = 0;
  trial = x;
  trialState = state;
  for k = 1:25
    candidate = min(max(x + alpha * step, data.lb), data.ub);
    [candidateState, added] = optimFminconState(data, candidate, opts);
    count = count + added;
    if ~isempty(data.nonlcon) && meritValue(candidateState, rho) > base
      [candidate, candidateState, correctedCount] = feasibilityCorrection(data, opts, candidate, candidateState);
      count = count + correctedCount;
    end
    if meritValue(candidateState, rho) <= base - 1e-4 * alpha * max(1, scaledStepNorm(step, x, opts) ^ 2)
      trial = candidate; trialState = candidateState; accepted = true; return
    end
    alpha = alpha / 2;
  end
end
%=============================================================================
function value = scaledStepNorm(step, x, opts)
  if strcmpi(opts.ScaleProblem, 'none')
    value = norm(step);
    return
  end
  if isempty(opts.TypicalX)
    scale = max(1, abs(x(:)));
  elseif isscalar(opts.TypicalX)
    scale = max(1, abs(double(opts.TypicalX))) * ones(length(step), 1);
  else
    scale = max(1, abs(double(opts.TypicalX(:))));
  end
  if length(scale) ~= length(step)
    scale = ones(length(step), 1);
  end
  value = norm(step(:) ./ scale(:));
end
%=============================================================================
function [x, state, count] = feasibilityCorrection(data, opts, x, state)
  count = 0;
  active = find(state.cineq >= -max(opts.ConstraintTolerance, sqrt(eps)));
  residual = state.ceq;
  W = state.Jeq;
  % Appending the inequality block only when it is non-empty avoids relying on
  % max(0, emptyVector), which in Nelson collapses to a scalar 0 and would add
  % a spurious residual row (mismatching W on equality-only problems).
  if ~isempty(active)
    residual = [residual; max(state.cineq(active), 0)];
    W = [W; state.Jineq(active, :)];
  end
  if isempty(W) || isempty(residual)
    return
  end
  correction = W' * solveLinearSystem(W * W' + sqrt(eps) * eye(size(W, 1)), residual);
  trial = min(max(x - correction, data.lb), data.ub);
  [trialState, added] = optimFminconState(data, trial, opts);
  count = count + added;
  if trialState.violation <= state.violation || trialState.merit <= state.merit
    x = trial;
    state = trialState;
  end
end
%=============================================================================
function maxIter = sqpIterationLimit(opts)
  maxIter = opts.MaxIter;
  if isfield(opts, 'MaxSQPIter') && ~isempty(opts.MaxSQPIter)
    maxIter = min(maxIter, opts.MaxSQPIter);
  end
end
%=============================================================================
function step = boundedLineSearchStep(x, step, opts)
  if ~isfield(opts, 'RelLineSrchBnd') || isempty(opts.RelLineSrchBnd)
    return
  end
  if opts.RelLineSrchBnd <= 0 || ~isfinite(opts.RelLineSrchBnd)
    return
  end
  limit = opts.RelLineSrchBnd * max(1, abs(x(:)));
  scale = max(abs(step(:)) ./ max(limit, eps));
  if scale > 1
    step = step / scale;
  end
end
%=============================================================================
function value = meritValue(state, rho)
  value = state.f + rho * (sum(max(0, state.cineq)) + sum(abs(state.ceq)));
end
%=============================================================================
function rho = meritPenalty(state, qpLambda)
  % For the L1 exact-penalty merit function to make the full QP (Newton) step a
  % descent direction, the penalty weight must dominate the constraint
  % multipliers (Nocedal & Wright, eq. 18.36). A fixed weight stalls whenever
  % the multipliers are large, e.g. equality-heavy collocation NLPs.
  floorRho = 10 + norm(state.grad, Inf);
  maxLambda = 0;
  if nargin > 1 && isstruct(qpLambda)
    names = {'eqlin', 'ineqlin', 'eqnonlin', 'ineqnonlin', 'lower', 'upper'};
    for k = 1:numel(names)
      if isfield(qpLambda, names{k})
        component = qpLambda.(names{k});
        if ~isempty(component)
          maxLambda = max(maxLambda, max(abs(double(component(:)))));
        end
      end
    end
  end
  rho = max(floorRho, 1.1 * maxLambda + 1);
end
%=============================================================================
function H = updateHessian(H, s, y)
  if s' * y <= 1e-12 * max(1, norm(s) * norm(y))
    H = H + 1e-8 * eye(size(H));
    return
  end
  Hs = H * s;
  H = H - (Hs * Hs') / max(s' * Hs, eps) + (y * y') / (s' * y);
  H = (H + H') / 2;
end
%=============================================================================
function value = firstOrderEstimate(state, lambda)
  value = norm(state.grad, Inf);
  if isfield(lambda, 'eqlin') && isfield(lambda, 'ineqlin')
    m = size(state.Jineq, 1);
    if m == 0
      return
    end
    active = state.cineq(:) >= -sqrt(eps);
    active = active(1:min(length(active), m));
    multipliers = zeros(m, 1);
    multipliers(active) = 1;
    value = min(value, norm(state.grad + state.Jineq' * multipliers, Inf));
  end
end
%=============================================================================
function best = updateBest(best, x, state, opts)
  if state.violation > opts.ConstraintTolerance
    return
  end
  if isempty(best) || state.f < best.fval
    best.x = x; best.fval = state.f;
    best.firstorderopt = norm(state.grad, Inf);
    best.constrviolation = state.violation;
  end
end
%=============================================================================
function values = makeValues(state, iter, funcCount, stepSize)
  values = struct();
  values.fval = state.f;
  values.iteration = iter;
  values.funccount = funcCount;
  values.constrviolation = state.violation;
  values.stepsize = stepSize;
  values.firstorderopt = norm(state.grad, Inf);
end
%=============================================================================
function output = makeOutput(iter, funcCount, state, data, message, best, stepSize, firstorderopt)
  output.iterations = iter;
  output.funcCount = funcCount;
  output.constrviolation = state.violation;
  output.stepsize = stepSize;
  output.algorithm = data.algorithm;
  output.firstorderopt = firstorderopt;
  output.cgiterations = 0;
  output.message = message;
  if isempty(best)
    output.bestfeasible = [];
  else
    output.bestfeasible = best;
  end
end
%=============================================================================
function value = optimalityFromLambda(state, data, lambda)
  lagGrad = state.grad;
  lagGrad = lagGrad + data.A' * lambda.ineqlin + data.Aeq' * lambda.eqlin;
  lagGrad = lagGrad + state.Jcnonlin' * lambda.ineqnonlin + state.Jceqnonlin' * lambda.eqnonlin;
  lagGrad = lagGrad - lambda.lower + lambda.upper;
  value = norm(lagGrad, Inf);
end
%=============================================================================
function lambda = finalMultipliers(H, state, data, opts)
  n = length(state.grad);
  mLin = size(data.A, 1);
  mNon = length(state.cnonlin);
  % Interior-point iterates stop within a small distance of the active
  % constraints, so activity detection needs a looser tolerance than
  % ConstraintTolerance alone.
  activeTolerance = max(opts.ConstraintTolerance, sqrt(max(opts.StepTolerance, eps)));
  active = find(state.cineq >= -activeTolerance);
  W = [state.Jeq; state.Jineq(active, :)];
  if isempty(W)
    multipliers = zeros(0, 1);
  else
    K = [H, W'; W, zeros(size(W, 1))];
    rhs = -[state.grad; zeros(size(W, 1), 1)];
    sol = solveLinearSystem(K, rhs);
    multipliers = sol(n + 1:end);
  end
  neq = size(state.Jeq, 1);
  eqMultipliers = sliceVector(multipliers, 1, neq);
  ineqMultipliers = zeros(size(state.cineq));
  ineqMultipliers(active) = max(0, multipliers(neq + 1:end));
  nEqLin = size(data.Aeq, 1);
  lambda.eqlin = sliceVector(eqMultipliers, 1, nEqLin);
  lambda.eqnonlin = sliceVector(eqMultipliers, nEqLin + 1, length(eqMultipliers));
  lambda.ineqlin = sliceVector(ineqMultipliers, 1, mLin);
  lambda.ineqnonlin = sliceVector(ineqMultipliers, mLin + 1, mLin + mNon);
  lowerStart = mLin + mNon + 1;
  lowerCount = length(data.lowerIndex);
  upperCount = length(data.upperIndex);
  lowerValues = sliceVector(ineqMultipliers, lowerStart, lowerStart + lowerCount - 1);
  upperValues = sliceVector(ineqMultipliers, lowerStart + lowerCount, ...
    lowerStart + lowerCount + upperCount - 1);
  lambda.lower = zeros(n, 1);
  lambda.upper = zeros(n, 1);
  lambda.lower(data.lowerIndex) = lowerValues;
  lambda.upper(data.upperIndex) = upperValues;
end
%=============================================================================
function value = sliceVector(x, first, last)
  if last < first
    value = zeros(0, 1);
  else
    value = x(first:last);
  end
end
%=============================================================================
function value = normStepValue(x, x0)
  value = norm(x - x0, Inf);
end
%=============================================================================
function x = solveLinearSystem(A, b)
  try
    x = A \ b;
    if all(isfinite(x))
      return
    end
  catch
  end
  x = pinv(A) * b;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function result = optimFminconSQPLegacy(data, opts)
  opts = legacyOptions(opts);
  result = legacyCore(data, opts);
  result.output.algorithm = 'sqp-legacy';
end
%=============================================================================
function opts = legacyOptions(opts)
  opts.SubproblemAlgorithm = 'active-set';
  opts.HessUpdate = 'bfgs';
  opts.EnableFeasibilityMode = false;
  opts.FiniteDifferenceType = 'forward';
  opts.MaxIter = max(1, min(opts.MaxIter, 200));
  opts.MaxIterations = opts.MaxIter;
end
%=============================================================================
function result = legacyCore(data, opts)
  x = min(max(data.x0, data.lb), data.ub);
  H = optimFminconInitialHessian(x, opts);
  [state, funcCount] = optimFminconState(data, x, opts);
  best = legacyBest([], x, state, opts);
  exitflag = 0;
  message = _('Maximum number of iterations or function evaluations reached.');
  iter = 0;
  for iter = 1:opts.MaxIter
    [step, qpLambda] = legacyStep(H, state, opts);
    if norm(step, Inf) <= opts.StepTolerance
      exitflag = 2; message = _('Step size tolerance reached.'); break
    end
    [trial, trialState, accepted, alpha, added] = legacyLineSearch(data, opts, x, state, step);
    funcCount = funcCount + added;
    if ~accepted
      exitflag = 0; message = 'Line search failed to find a lower merit value.'; break
    end
    s = trial - x;
    y = trialState.grad - state.grad;
    H = legacyHessian(H, s, y);
    x = trial;
    state = trialState;
    best = legacyBest(best, x, state, opts);
    if state.violation <= opts.ConstraintTolerance && legacyOptimality(state, qpLambda) <= opts.OptimalityTolerance
      exitflag = 1; message = _('Local minimum found that satisfies the constraints.'); break
    end
    if alpha * norm(step, Inf) <= opts.StepTolerance
      exitflag = 2; message = _('Step size tolerance reached.'); break
    end
    if funcCount >= opts.MaxFunEvals
      break
    end
  end
  lambda = legacyLambda(data, state, H, opts);
  if exitflag == 0 && state.violation <= opts.ConstraintTolerance && ~isempty(best)
    exitflag = 1;
    message = _('Local minimum found that satisfies the constraints.');
  end
  result.x = x;
  result.fval = state.f;
  result.exitflag = exitflag;
  result.lambda = lambda;
  result.grad = state.grad;
  result.hessian = H;
  result.output = legacyOutput(iter, funcCount, state, data, message, best, norm(x - data.x0, Inf));
end
%=============================================================================
function [step, lambda] = legacyStep(H, state, opts)
  n = length(state.grad);
  maxIter = max(10, 3 * n + size(state.Jineq, 1) + size(state.Jeq, 1));
  localOpts = opts;
  localOpts.ScaleProblem = 'obj-and-constr';
  [step, lambda] = optimFminconScaledQP(H + 1e-8 * eye(n), state, localOpts, maxIter);
  limit = max(1, norm(state.grad, Inf));
  scale = max(abs(step) / limit);
  if scale > 1
    step = step / scale;
  end
end
%=============================================================================
function [trial, trialState, accepted, alpha, count] = legacyLineSearch(data, opts, x, state, step)
  accepted = false;
  alpha = 1;
  count = 0;
  trial = x;
  trialState = state;
  base = legacyMerit(state);
  for k = 1:30
    candidate = min(max(x + alpha * step, data.lb), data.ub);
    [candidateState, added] = optimFminconState(data, candidate, opts);
    count = count + added;
    if legacyMerit(candidateState) <= base - 1e-5 * alpha * max(1, norm(step) ^ 2)
      trial = candidate;
      trialState = candidateState;
      accepted = true;
      return
    end
    alpha = alpha / 2;
  end
end
%=============================================================================
function H = legacyHessian(H, s, y)
  if s' * y <= 1e-10 * max(1, norm(s) * norm(y))
    H = 0.5 * H + 0.5 * eye(size(H));
    return
  end
  Hs = H * s;
  H = H - (Hs * Hs') / max(s' * Hs, eps) + (y * y') / (s' * y);
  H = (H + H') / 2;
end
%=============================================================================
function value = legacyMerit(state)
  value = state.f + (25 + norm(state.grad, Inf)) * (sum(max(0, state.cineq)) + sum(abs(state.ceq)));
end
%=============================================================================
function value = legacyOptimality(state, lambda)
  value = norm(state.grad, Inf);
  if isfield(lambda, 'ineqlin')
    active = state.cineq >= -sqrt(eps);
    if any(active)
      value = min(value, norm(state.grad + state.Jineq(active, :)' * ones(nnz(active), 1), Inf));
    end
  end
end
%=============================================================================
function lambda = legacyLambda(data, state, H, opts)
  active = find(state.cineq >= -opts.ConstraintTolerance);
  W = [state.Jeq; state.Jineq(active, :)];
  if isempty(W)
    multipliers = zeros(0, 1);
  else
    K = [H, W'; W, zeros(size(W, 1))];
    sol = legacySolve(K, -[state.grad; zeros(size(W, 1), 1)]);
    multipliers = sol(length(state.grad) + 1:end);
  end
  lambda = splitLambda(data, state, active, multipliers);
end
%=============================================================================
function lambda = splitLambda(data, state, active, multipliers)
  n = length(state.grad);
  neq = size(state.Jeq, 1);
  eq = slice(multipliers, 1, neq);
  ineq = zeros(size(state.cineq));
  ineq(active) = max(0, slice(multipliers, neq + 1, length(multipliers)));
  nLin = size(data.A, 1);
  nEqLin = size(data.Aeq, 1);
  nNon = length(state.cnonlin);
  lambda.eqlin = slice(eq, 1, nEqLin);
  lambda.eqnonlin = slice(eq, nEqLin + 1, length(eq));
  lambda.ineqlin = slice(ineq, 1, nLin);
  lambda.ineqnonlin = slice(ineq, nLin + 1, nLin + nNon);
  lowerStart = nLin + nNon + 1;
  lambda.lower = zeros(n, 1);
  lambda.upper = zeros(n, 1);
  lambda.lower(data.lowerIndex) = slice(ineq, lowerStart, lowerStart + length(data.lowerIndex) - 1);
  lambda.upper(data.upperIndex) = slice(ineq, lowerStart + length(data.lowerIndex), ...
    lowerStart + length(data.lowerIndex) + length(data.upperIndex) - 1);
end
%=============================================================================
function value = slice(x, first, last)
  if last < first
    value = zeros(0, 1);
  else
    value = x(first:last);
  end
end
%=============================================================================
function best = legacyBest(best, x, state, opts)
  if state.violation > opts.ConstraintTolerance
    return
  end
  if isempty(best) || state.f < best.fval
    best.x = x;
    best.fval = state.f;
    best.firstorderopt = norm(state.grad, Inf);
    best.constrviolation = state.violation;
  end
end
%=============================================================================
function output = legacyOutput(iter, funcCount, state, data, message, best, stepSize)
  output.iterations = iter;
  output.funcCount = funcCount;
  output.constrviolation = state.violation;
  output.stepsize = stepSize;
  output.algorithm = data.algorithm;
  output.firstorderopt = norm(state.grad, Inf);
  output.cgiterations = 0;
  output.message = message;
  output.bestfeasible = best;
end
%=============================================================================
function x = legacySolve(A, b)
  try
    x = A \ b;
    if all(isfinite(x))
      return
    end
  catch
  end
  x = pinv(A) * b;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [step, lambda] = optimFminconScaledQP(H, state, opts, maxIter)
  n = length(state.grad);
  qpopts = opts;
  qpopts.MaxIter = maxIter;
  H = regularizedHessian(H);
  scale = variableScale(H, state, opts);
  Hs = diagScale(H, scale);
  gs = scale(:) .* state.grad(:);
  Jineq = shapedJacobian(state.Jineq, n);
  Jeq = shapedJacobian(state.Jeq, n);
  JsIneq = Jineq * diag(scale);
  JsEq = Jeq * diag(scale);
  [scaledStep, ~, ~, lambda] = optimActiveSetQP(Hs, gs, JsIneq, -state.cineq, ...
    JsEq, -state.ceq, [], [], zeros(n, 1), qpopts);
  step = scale(:) .* scaledStep(:);
  if any(~isfinite(step))
    step = -state.grad;
  end
end
%=============================================================================
function J = shapedJacobian(J, n)
  if isempty(J)
    J = zeros(0, n);
  end
end
%=============================================================================
function H = regularizedHessian(H)
  H = (H + H') / 2;
  diagonal = abs(diag(H));
  diagonal(diagonal < sqrt(eps)) = 1;
  shift = 0;
  for k = 1:6
    try
      chol(H + shift * eye(size(H)));
      H = H + shift * eye(size(H));
      return
    catch
      shift = max(1e-10, 10 ^ (k - 10) * max(diagonal));
    end
  end
  H = H + shift * eye(size(H));
end
%=============================================================================
function scale = variableScale(H, state, opts)
  n = length(state.grad);
  scale = typicalScale(opts, state.x, n);
  if strcmpi(opts.ScaleProblem, 'none') && conditionEstimate(H, state) < 1e8
    scale(:) = 1;
    return
  end
  colNorms = sqrt(columnEnergy(state.Jineq, n) + columnEnergy(state.Jeq, n))';
  curvature = sqrt(abs(diag(H)));
  weight = max([ones(n, 1), colNorms, curvature], [], 2);
  scale = max(scale(:), 1 ./ weight);
  scale(~isfinite(scale) | scale <= 0) = 1;
end
%=============================================================================
function e = columnEnergy(J, n)
  % Sum of squares per column, always returned as a 1-by-n row so that an
  % empty Jacobian (which Nelson collapses to 0-by-0 on concatenation) keeps
  % one entry per variable instead of folding to a scalar.
  if isempty(J)
    e = zeros(1, n);
  else
    e = sum(J .^ 2, 1);
  end
end
%=============================================================================
function value = conditionEstimate(H, state)
  n = length(state.grad);
  d = abs(diag(H));
  j = sqrt(columnEnergy(state.Jineq, n) + columnEnergy(state.Jeq, n))';
  values = [d(:); j(:)];
  values = values(isfinite(values) & values > 0);
  if isempty(values)
    value = 1;
  else
    value = max(values) / max(min(values), eps);
  end
end
%=============================================================================
function scale = typicalScale(opts, x, n)
  if isempty(opts.TypicalX)
    scale = max(1, abs(x(:)));
  elseif isscalar(opts.TypicalX)
    scale = max(1, abs(double(opts.TypicalX))) * ones(n, 1);
  else
    scale = max(1, abs(double(opts.TypicalX(:))));
  end
  if length(scale) ~= n
    scale = ones(n, 1);
  end
end
%=============================================================================
function Hs = diagScale(H, scale)
  s = scale(:);
  Hs = H .* (s * s');
  Hs = (Hs + Hs') / 2;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [state, count] = optimFminconState(data, x, opts)
  state.x = x(:);
  [state.f, state.grad, objectiveCount] = objectiveState(data.fun, x, opts);
  [c, ceq, Jc, Jceq, constraintCount] = constraintState(data.nonlcon, x, opts);
  state.cnonlin = c;
  state.ceqnonlin = ceq;
  state.Jcnonlin = Jc;
  state.Jceqnonlin = Jceq;
  lower = data.lb(data.lowerIndex) - x(data.lowerIndex); lower = lower(:);
  upper = x(data.upperIndex) - data.ub(data.upperIndex); upper = upper(:);
  state.cineq = [data.A * x - data.b; c; lower; upper];
  state.Jineq = [data.A; Jc; data.Jlower; data.Jupper];
  state.ceq = [data.Aeq * x - data.beq; ceq];
  state.Jeq = [data.Aeq; Jceq];
  state.violation = max([0; state.cineq(:); abs(state.ceq(:))]);
  state.merit = state.f + 10 * (sum(max(0, state.cineq)) + sum(abs(state.ceq)));
  count = objectiveCount + constraintCount;
end
%=============================================================================
function [f, g, count] = objectiveState(fun, x, opts)
  if opts.SpecifyObjectiveGradient || strcmpi(opts.GradObj, 'on')
    [f, g] = optimCall(fun, x);
    f = scalarValue(f, opts);
    g = double(g(:));
    count = 1;
    return
  end
  f = scalarValue(optimCall(fun, x), opts);
  g = zeros(length(x), 1);
  step = finiteStep(x, opts);
  count = 1;
  useCentral = strcmpi(opts.FiniteDifferenceType, 'central');
  for k = 1:length(x)
    if useCentral
      xp = x; xm = x;
      xp(k) = xp(k) + step(k); xm(k) = xm(k) - step(k);
      fp = scalarValue(optimCall(fun, xp), opts);
      fm = scalarValue(optimCall(fun, xm), opts);
      g(k) = (fp - fm) / (2 * step(k));
      count = count + 2;
    else
      xp = x; xp(k) = xp(k) + step(k);
      fp = scalarValue(optimCall(fun, xp), opts);
      g(k) = (fp - f) / step(k);
      count = count + 1;
    end
  end
end
%=============================================================================
function [c, ceq, Jc, Jceq, count] = constraintState(nonlcon, x, opts)
  if isempty(nonlcon)
    c = zeros(0, 1); ceq = zeros(0, 1);
    Jc = zeros(0, length(x)); Jceq = zeros(0, length(x));
    count = 0;
    return
  end
  if opts.SpecifyConstraintGradient || strcmpi(opts.GradConstr, 'on')
    [c, ceq, gc, gceq] = optimCall(nonlcon, x);
    [c, ceq] = constraintValues(c, ceq);
    Jc = double(gc)'; Jceq = double(gceq)';
    validateJacobian(Jc, length(c), length(x), sprintf('Nonlinear %s gradient has invalid dimensions.', 'inequality'));
    validateJacobian(Jceq, length(ceq), length(x), sprintf('Nonlinear %s gradient has invalid dimensions.', 'equality'));
    count = 1;
    return
  end
  [c, ceq] = optimCall(nonlcon, x);
  [c, ceq] = constraintValues(c, ceq);
  mIneq = length(c); mEq = length(ceq);
  Jc = zeros(mIneq, length(x)); Jceq = zeros(mEq, length(x));
  step = finiteStep(x, opts);
  count = 1;
  useCentral = strcmpi(opts.FiniteDifferenceType, 'central');
  for k = 1:length(x)
    if useCentral
      xp = x; xm = x;
      xp(k) = xp(k) + step(k); xm(k) = xm(k) - step(k);
      [cp, ceqp] = optimCall(nonlcon, xp);
      [cm, ceqm] = optimCall(nonlcon, xm);
      if mIneq > 0
        Jc(:, k) = (double(cp(:)) - double(cm(:))) / (2 * step(k));
      end
      if mEq > 0
        Jceq(:, k) = (double(ceqp(:)) - double(ceqm(:))) / (2 * step(k));
      end
      count = count + 2;
    else
      xp = x; xp(k) = xp(k) + step(k);
      [cp, ceqp] = optimCall(nonlcon, xp);
      if mIneq > 0
        Jc(:, k) = (double(cp(:)) - c) / step(k);
      end
      if mEq > 0
        Jceq(:, k) = (double(ceqp(:)) - ceq) / step(k);
      end
      count = count + 1;
    end
  end
end
%=============================================================================
function [c, ceq] = constraintValues(c, ceq)
  if isempty(c)
    c = zeros(0, 1);
  elseif isnumeric(c) && isreal(c)
    c = double(c(:));
  else
    error('Nelson:optimization:invalidConstraintValue', 'Nonlinear constraint function must return real numeric values.');
  end
  if isempty(ceq)
    ceq = zeros(0, 1);
  elseif isnumeric(ceq) && isreal(ceq)
    ceq = double(ceq(:));
  else
    error('Nelson:optimization:invalidConstraintValue', 'Nonlinear constraint function must return real numeric values.');
  end
end
%=============================================================================
function validateJacobian(J, rows, cols, message)
  if ~isequal(size(J), [rows, cols])
    error('Nelson:optimization:sizeMismatch', message);
  end
end
%=============================================================================
function f = scalarValue(value, opts)
  value = optimCheckFunValue(value, opts);
  if ~isnumeric(value) || ~isscalar(value)
    error('Nelson:optimization:invalidObjectiveScalar', '%s must return a numeric scalar.', 'Objective function');
  end
  f = double(value);
end
%=============================================================================
function step = finiteStep(x, opts)
  n = length(x);
  scale = finiteScale(x, opts);
  if isempty(opts.FiniteDifferenceStepSize)
    if strcmpi(opts.FiniteDifferenceType, 'central')
      base = eps ^ (1 / 3);
    else
      base = sqrt(eps);
    end
    step = base * scale;
  elseif isscalar(opts.FiniteDifferenceStepSize)
    step = double(opts.FiniteDifferenceStepSize) * scale;
  else
    step = double(opts.FiniteDifferenceStepSize(:)) .* scale;
  end
  step(step == 0) = sqrt(eps);
end
%=============================================================================
function scale = finiteScale(x, opts)
  scale = abs(x(:));
  t = typicalX(opts, length(scale));
  t = t(:);
  mask = scale < t;
  scale(mask) = t(mask);
end
%=============================================================================
function t = typicalX(opts, n)
  if isempty(opts.TypicalX)
    t = ones(n, 1);
  elseif isscalar(opts.TypicalX)
    t = double(opts.TypicalX) * ones(n, 1);
  else
    t = double(opts.TypicalX(:));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function result = optimFminconTRR(data, opts)
  x = projectEquality(min(max(data.x0, data.lb), data.ub), data.Aeq, data.beq);
  radius = max(1, norm(x, Inf));
  H = eye(length(x));
  [state, funcCount] = optimFminconState(data, x, opts);
  displayHeader(opts);
  if optimOutputStop(opts.OutputFcn, x, makeValues(state, 0, funcCount, 0), 'init')
    result = makeResult(data, opts, x, state, -1, 0, funcCount, _('Stopped by output function.'), eye(length(x)), 0);
    return
  end
  exitflag = 0;
  message = _('Maximum number of iterations or function evaluations reached.');
  iter = 0;
  totalCgIterations = 0;
  pcgFlag = 0;
  pcgResidual = norm(state.grad);
  for iter = 1:opts.MaxIter
    H = hessianMatrix(data, opts, x, state, H);
    [direction, cgInfo] = projectedDirection(state.grad, x, data, H, radius, opts);
    cgIterations = cgInfo.iterations;
    pcgFlag = cgInfo.flag;
    pcgResidual = cgInfo.residual;
    totalCgIterations = totalCgIterations + cgIterations;
    if norm(direction, Inf) <= opts.OptimalityTolerance && state.violation <= opts.ConstraintTolerance
      exitflag = 1; message = _('Local minimum found that satisfies the constraints.'); break
    end
    [trial, trialState, accepted, stepNorm, count] = trustStep(data, opts, x, state, direction, radius);
    funcCount = funcCount + count;
    if accepted
      x = trial; state = trialState;
      radius = min(100 * max(1, norm(x, Inf)), max(2 * radius, stepNorm));
    else
      radius = radius / 2;
    end
    values = makeValues(state, iter, funcCount, stepNorm);
    displayIter(opts, values);
    if optimOutputStop(opts.OutputFcn, x, values, 'iter')
      exitflag = -1; message = _('Stopped by output function.'); break
    end
    if stepNorm <= opts.StepTolerance
      exitflag = 2; message = _('Step size tolerance reached.'); break
    end
    if funcCount >= opts.MaxFunEvals
      break
    end
  end
  result = makeResult(data, opts, x, state, exitflag, iter, funcCount, message, H, totalCgIterations);
  result.output.pcgflag = pcgFlag;
  result.output.pcgresidual = pcgResidual;
  result.output.trustregionradius = radius;
  optimOutputStop(opts.OutputFcn, x, makeValues(state, iter, funcCount, 0), 'done');
  displayFinal(opts, message);
end
%=============================================================================
function [direction, cgInfo] = projectedDirection(grad, x, data, H, radius, opts)
  g = projectNull(grad, data.Aeq);
  [direction, cgInfo] = truncatedPCG(H, g, radius, opts);
  atLower = abs(x - data.lb) <= sqrt(eps);
  atUpper = abs(x - data.ub) <= sqrt(eps);
  direction(atLower & direction < 0) = 0;
  direction(atUpper & direction > 0) = 0;
end
%=============================================================================
function H = hessianMatrix(data, opts, x, state, fallback)
  if ~isempty(opts.HessianFcn)
    H = feval(opts.HessianFcn, x, hessianLambda(data, x));
  elseif ~isempty(opts.HessFcn)
    H = feval(opts.HessFcn, x, hessianLambda(data, x));
  elseif ~isempty(opts.HessianMultiplyFcn)
    H = buildHessianFromMultiply(opts.HessianMultiplyFcn, x);
  elseif ~isempty(opts.HessMult)
    H = buildHessianFromMultiply(opts.HessMult, x);
  elseif isnumeric(opts.Hessian) && ~isempty(opts.Hessian)
    H = opts.Hessian;
  else
    H = fallback;
  end
  H = double(H);
  if ~isequal(size(H), [length(x), length(x)]) || any(any(~isfinite(H)))
    H = eye(length(x));
  end
  H = (H + H') / 2;
end
%=============================================================================
function H = buildHessianFromMultiply(fun, x)
  n = length(x);
  H = zeros(n, n);
  for k = 1:n
    basis = zeros(n, 1);
    basis(k) = 1;
    try
      column = feval(fun, x, basis);
    catch
      column = feval(fun, basis);
    end
    H(:, k) = double(column(:));
  end
end
%=============================================================================
function lambda = hessianLambda(data, x)
  n = length(x);
  lambda.lower = zeros(n, 1);
  lambda.upper = zeros(n, 1);
  lambda.ineqlin = zeros(0, 1);
  lambda.ineqnonlin = zeros(0, 1);
  lambda.eqnonlin = zeros(0, 1);
  lambda.eqlin = zeros(size(data.Aeq, 1), 1);
end
%=============================================================================
function [p, info] = truncatedPCG(H, g, radius, opts)
  maxCg = projectionCgLimit(opts);
  if isempty(maxCg)
    maxIter = max(20, 5 * length(g));
  else
    maxIter = maxCg;
  end
  p = zeros(length(g), 1);
  info.iterations = 0;
  info.flag = 0;
  info.residual = norm(g);
  if norm(g) == 0
    return
  end
  r = -g(:);
  z = preconditionResidual(H, r, opts);
  d = z;
  rz = r' * z;
  tol = max(opts.TolProjCGAbs, opts.TolProjCG * norm(g));
  for k = 1:maxIter
    info.iterations = k;
    Hd = H * d;
    dHd = d' * Hd;
    if dHd <= eps
      p = boundaryStep(p, d, radius);
      info.flag = 2;
      info.residual = norm(r);
      return
    end
    alpha = rz / dHd;
    candidate = p + alpha * d;
    if norm(candidate) >= radius
      p = boundaryStep(p, d, radius);
      info.flag = 3;
      info.residual = norm(r);
      return
    end
    p = candidate;
    r = r - alpha * Hd;
    if norm(r) <= tol
      info.flag = 0;
      info.residual = norm(r);
      return
    end
    z = preconditionResidual(H, r, opts);
    oldrz = rz;
    rz = r' * z;
    d = z + (rz / max(oldrz, eps)) * d;
  end
  info.flag = 1;
  info.residual = norm(r);
end
%=============================================================================
function z = preconditionResidual(H, r, opts)
  if isempty(opts.PrecondBandWidth) || opts.PrecondBandWidth < 0
    z = r;
    return
  end
  if isfinite(opts.PrecondBandWidth) && opts.PrecondBandWidth > 0
    width = min(size(H, 1) - 1, round(opts.PrecondBandWidth));
    M = bandMatrix(H, width);
    z = solveSystem(M, r);
    if all(isfinite(z))
      return
    end
  end
  diagonal = abs(diag(H));
  diagonal(diagonal < sqrt(eps)) = 1;
  z = r ./ diagonal;
end
%=============================================================================
function M = bandMatrix(H, width)
  M = zeros(size(H));
  for k = -width:width
    M = M + diag(diag(H, k), k);
  end
  d = abs(diag(M));
  d(d < sqrt(eps)) = 1;
  M(1:size(M, 1) + 1:end) = d;
end
%=============================================================================
function maxIter = projectionCgLimit(opts)
  if ~isempty(opts.MaxProjCGIter)
    maxIter = opts.MaxProjCGIter;
  else
    maxIter = opts.MaxPCGIter;
  end
end
%=============================================================================
function p = boundaryStep(p, d, radius)
  a = d' * d;
  b = 2 * (p' * d);
  c = p' * p - radius ^ 2;
  tau = (-b + sqrt(max(0, b ^ 2 - 4 * a * c))) / max(2 * a, eps);
  p = p + tau * d;
end
%=============================================================================
function [trial, trialState, accepted, stepNorm, count] = trustStep(data, opts, x, state, direction, radius)
  accepted = false; count = 0; trial = x; trialState = state; stepNorm = 0;
  if norm(direction) > radius
    direction = direction * (radius / norm(direction));
  end
  alpha = 1;
  for k = 1:25
    candidate = projectEquality(min(max(x + alpha * direction, data.lb), data.ub), data.Aeq, data.beq);
    candidate = min(max(candidate, data.lb), data.ub);
    [candidateState, added] = optimFminconState(data, candidate, opts);
    count = count + added;
    if candidateState.f <= state.f - 1e-4 * alpha * max(1, norm(direction) ^ 2) ...
        && candidateState.violation <= max(opts.ConstraintTolerance, state.violation)
      trial = candidate; trialState = candidateState; accepted = true;
      stepNorm = norm(trial - x, Inf);
      return
    end
    alpha = alpha / 2;
  end
end
%=============================================================================
function x = projectEquality(x, Aeq, beq)
  if isempty(Aeq)
    return
  end
  residual = Aeq * x - beq;
  x = x - Aeq' * solveSystem(Aeq * Aeq', residual);
end
%=============================================================================
function y = projectNull(x, Aeq)
  if isempty(Aeq)
    y = x;
    return
  end
  y = x - Aeq' * solveSystem(Aeq * Aeq', Aeq * x);
end
%=============================================================================
function x = solveSystem(A, b)
  try
    x = A \ b;
    if all(isfinite(x))
      return
    end
  catch
  end
  x = pinv(A) * b;
end
%=============================================================================
function result = makeResult(data, opts, x, state, exitflag, iter, funcCount, message, H, cgIterations)
  lambda = multipliers(data, opts, x, state);
  result.x = x; result.fval = state.f; result.exitflag = positiveExit(exitflag, state, opts);
  result.lambda = lambda; result.grad = state.grad; result.hessian = H;
  result.output = struct();
  result.output.iterations = iter; result.output.funcCount = funcCount;
  result.output.constrviolation = state.violation; result.output.stepsize = norm(x - data.x0, Inf);
  result.output.algorithm = data.algorithm; result.output.firstorderopt = norm(state.grad, Inf);
  result.output.cgiterations = cgIterations; result.output.message = exitMessage(result.exitflag, message);
  result.output.bestfeasible = bestFeasible(state, x, opts);
end
%=============================================================================
function lambda = multipliers(data, opts, x, state)
  n = length(x);
  lambda.lower = zeros(n, 1);
  lambda.upper = zeros(n, 1);
  lambda.ineqlin = zeros(0, 1);
  lambda.ineqnonlin = zeros(0, 1);
  lambda.eqnonlin = zeros(0, 1);
  lambda.eqlin = equalityMultiplier(data.Aeq, state.grad);
  lagGrad = state.grad + data.Aeq' * lambda.eqlin;
  lower = find(abs(x - data.lb) <= opts.ConstraintTolerance & isfinite(data.lb));
  upper = find(abs(x - data.ub) <= opts.ConstraintTolerance & isfinite(data.ub));
  lambda.lower(lower) = max(0, lagGrad(lower));
  lambda.upper(upper) = max(0, -lagGrad(upper));
end
%=============================================================================
function lambda = equalityMultiplier(Aeq, grad)
  if isempty(Aeq)
    lambda = zeros(0, 1);
    return
  end
  lambda = -solveSystem(Aeq * Aeq', Aeq * grad);
end
%=============================================================================
function flag = positiveExit(flag, state, opts)
  if flag == 0 && state.violation <= opts.ConstraintTolerance
    flag = 1;
  end
end
%=============================================================================
function msg = exitMessage(exitflag, defaultMessage)
  if exitflag > 0
    msg = _('Local minimum found that satisfies the constraints.');
  elseif exitflag < 0
    msg = _('Stopped by output function.');
  else
    msg = defaultMessage;
  end
end
%=============================================================================
function best = bestFeasible(state, x, opts)
  if state.violation > opts.ConstraintTolerance
    best = [];
    return
  end
  best.x = x;
  best.fval = state.f;
  best.firstorderopt = norm(state.grad, Inf);
  best.constrviolation = state.violation;
end
%=============================================================================
function values = makeValues(state, iter, funcCount, stepSize)
  values = struct();
  values.fval = state.f;
  values.iteration = iter;
  values.funccount = funcCount;
  values.constrviolation = state.violation;
  values.stepsize = stepSize;
  values.firstorderopt = norm(state.grad, Inf);
end
%=============================================================================
function displayHeader(opts)
  if isIterDisplay(opts)
    disp(' Iteration   Func-count         Fval   Feasibility   First-order opt')
  end
end
%=============================================================================
function displayIter(opts, values)
  if ~isIterDisplay(opts)
    return
  end
  disp([int2str(values.iteration), '           ', int2str(values.funccount), '        ', ...
    num2str(values.fval, 12), '    ', num2str(values.constrviolation, 6), ...
    '       ', num2str(values.firstorderopt, 6)])
end
%=============================================================================
function displayFinal(opts, message)
  if isNoDisplay(opts)
    return
  end
  if isIterDisplay(opts)
    disp(' ')
  end
  if isFinalDisplay(opts) || isIterDisplay(opts) || isNotifyDisplay(opts)
    disp(message)
  end
end
%=============================================================================
function tf = isIterDisplay(opts)
  tf = strcmpi(opts.Display, 'iter') || strcmpi(opts.Display, 'iter-detailed');
end
%=============================================================================
function tf = isFinalDisplay(opts)
  tf = strcmpi(opts.Display, 'final') || strcmpi(opts.Display, 'final-detailed');
end
%=============================================================================
function tf = isNoDisplay(opts)
  tf = strcmpi(opts.Display, 'off') || strcmpi(opts.Display, 'none');
end
%=============================================================================
function tf = isNotifyDisplay(opts)
  tf = strcmpi(opts.Display, 'notify') || strcmpi(opts.Display, 'notify-detailed');
end
