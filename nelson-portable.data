function h = ip_validate_h_minima_height(h)
  if ~(isnumeric(h) || islogical(h)) || ~isreal(h) || ~isscalar(h)
    error('Nelson:image_processing:heightNonnegativeFiniteScalar', '%s must be a nonnegative finite scalar.', 'Height');
  end
  h = double(h);
  if ~(isfinite(h) && h >= 0)
    error('Nelson:image_processing:heightNonnegativeFiniteScalar', '%s must be a nonnegative finite scalar.', 'Height');
  end
end
