% LICENCE_BLOCK_END
%=============================================================================
% Default CustomDisplay rendering for a non-scalar (array) object: dimensions,
% class name and the list of property names (without values). In .m so the
% formatting can evolve without rebuilding the interpreter.
%=============================================================================
function renderCustomDisplayArray(obj)
  dims = sprintf('%dx', size(obj));
  dims(end) = [];
  names = properties(obj);
  if isempty(names)
    disp(['  ', dims, ' ', class(obj), ' array with no properties.']);
  else
    disp(['  ', dims, ' ', class(obj), ' array with properties:']);
    fprintf('\n');
    for k = 1:numel(names)
      disp(['    ', names{k}]);
    end
  end
  fprintf('\n');
end
