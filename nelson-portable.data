%=============================================================================
classdef OptimizationConstraint
  properties
    Left = []
    Relation = '<='
    Right = []
  end

  methods
    function obj = OptimizationConstraint(left, relation, right)
      if nargin == 0
        return
      end
      obj.Left = optim.problemdef.OptimizationExpression.fromAny(left);
      obj.Relation = relation;
      obj.Right = optim.problemdef.OptimizationExpression.fromAny(right);
    end

    function value = evaluate(obj, values)
      lhs = evaluate(obj.Left, values);
      rhs = evaluate(obj.Right, values);
      if strcmp(obj.Relation, '<=')
        value = lhs <= rhs;
      elseif strcmp(obj.Relation, '>=')
        value = lhs >= rhs;
      else
        value = lhs == rhs;
      end
    end

    function residual = residual(obj, values)
      residual = evaluate(obj.Left, values) - evaluate(obj.Right, values);
      if strcmp(obj.Relation, '>=')
        residual = -residual;
      end
    end

    function disp(obj)
      builtin('disp', ['OptimizationConstraint: ', obj.Relation])
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
classdef OptimizationExpression
  properties
    EvalFcn = []
    Display = ''
    Variables = {}
    VarMap = struct()
    VarLowerBound = struct()
    VarUpperBound = struct()
    VarType = struct()
  end

  methods
    function obj = OptimizationExpression(value, displayText, variables, varMap)
      if nargin == 0
        value = 0;
        displayText = '0';
        variables = {};
      end
      if nargin < 2
        displayText = 'expression';
      end
      if nargin < 3
        variables = {};
      end
      if nargin < 4
        varMap = struct();
      end
      if isa(value, 'function_handle')
        obj.EvalFcn = value;
      else
        obj.EvalFcn = @(values) value;
      end
      obj.Display = displayText;
      obj.Variables = variables(:)';
      obj.VarMap = varMap;
      obj.VarLowerBound = struct();
      obj.VarUpperBound = struct();
      obj.VarType = struct();
    end

    function value = evaluate(obj, values)
      if nargin < 2
        values = struct();
      end
      evalFcn = obj.EvalFcn;
      value = evalFcn(values);
    end

    function c = plus(a, b)
      c = binary(a, b, '+', @(x, y) x + y);
    end

    function c = minus(a, b)
      c = binary(a, b, '-', @(x, y) x - y);
    end

    function c = times(a, b)
      c = binary(a, b, '.*', @(x, y) x .* y);
    end

    function c = rdivide(a, b)
      c = binary(a, b, './', @(x, y) x ./ y);
    end

    function c = mtimes(a, b)
      c = binary(a, b, mtimesDisplayOperator(a, b), @(x, y) x * y);
    end

    function c = power(a, b)
      c = powerExpression(a, b, @(x, y) x .^ y);
    end

    function c = mpower(a, b)
      c = powerExpression(a, b, @(x, y) x ^ y);
    end

    function c = uminus(a)
      a = optim.problemdef.OptimizationExpression.fromAny(a);
      c = optim.problemdef.OptimizationExpression(@(v) - evaluate(a, v), ['-', a.Display], a.Variables);
      c.VarMap = a.VarMap;
      c.VarLowerBound = a.VarLowerBound;
      c.VarUpperBound = a.VarUpperBound;
      c.VarType = a.VarType;
    end

    function c = sum(a, varargin)
      a = optim.problemdef.OptimizationExpression.fromAny(a);
      c = optim.problemdef.OptimizationExpression(@(v) sum(evaluate(a, v), varargin{:}), ...
        sumDisplay(a, varargin), a.Variables);
      c.VarMap = a.VarMap;
      c.VarLowerBound = a.VarLowerBound;
      c.VarUpperBound = a.VarUpperBound;
      c.VarType = a.VarType;
    end

    function c = norm(a)
      a = optim.problemdef.OptimizationExpression.fromAny(a);
      c = optim.problemdef.OptimizationExpression(@(v) norm(evaluate(a, v)), ['norm(', a.Display, ')'], a.Variables);
      c.VarMap = a.VarMap;
      c.VarLowerBound = a.VarLowerBound;
      c.VarUpperBound = a.VarUpperBound;
      c.VarType = a.VarType;
    end

    function c = log(a)
      a = optim.problemdef.OptimizationExpression.fromAny(a);
      c = optim.problemdef.OptimizationExpression(@(v) log(evaluate(a, v)), ['log(', a.Display, ')'], a.Variables);
      c.VarMap = a.VarMap;
      c.VarLowerBound = a.VarLowerBound;
      c.VarUpperBound = a.VarUpperBound;
      c.VarType = a.VarType;
    end

    function c = le(a, b)
      c = optim.problemdef.OptimizationConstraint(a, '<=', b);
    end

    function c = ge(a, b)
      c = optim.problemdef.OptimizationConstraint(a, '>=', b);
    end

    function c = eq(a, b)
      c = optim.problemdef.OptimizationConstraint(a, '==', b);
    end

    function disp(obj)
      builtin('disp', obj.Display)
    end

    function value = subsref(obj, s)
      if strcmp(s(1).type, '.')
        value = builtin('subsref', obj, s);
        return
      end
      if ~strcmp(s(1).type, '()')
        error('Nelson:OptimizationExpression:unsupportedIndexing', 'Unsupported expression indexing.');
      end
      subs = s(1).subs;
      value = optim.problemdef.OptimizationExpression(@(values) indexValue(evaluate(obj, values), subs), ...
        [obj.Display, subscriptText(subs)], obj.Variables, obj.VarMap);
      value.VarLowerBound = obj.VarLowerBound;
      value.VarUpperBound = obj.VarUpperBound;
      value.VarType = obj.VarType;
      if length(s) > 1
        value = subsref(value, s(2:end));
      end
    end
  end

  methods (Static)
    function obj = fromAny(value)
      if isa(value, 'optim.problemdef.OptimizationExpression')
        obj = value;
      elseif isa(value, 'optim.problemdef.OptimizationVariable')
        obj = toExpression(value);
      else
        obj = optim.problemdef.OptimizationExpression(value, valueDisplay(value), {});
      end
    end
  end
end
%=============================================================================
function c = binary(a, b, op, f)
  a = optim.problemdef.OptimizationExpression.fromAny(a);
  b = optim.problemdef.OptimizationExpression.fromAny(b);
  vars = unique([a.Variables, b.Variables], 'stable');
  varMap = mergeVarMaps(a.VarMap, b.VarMap);
  lowerMap = mergeVarMaps(a.VarLowerBound, b.VarLowerBound);
  upperMap = mergeVarMaps(a.VarUpperBound, b.VarUpperBound);
  typeMap = mergeVarMaps(a.VarType, b.VarType);
  c = optim.problemdef.OptimizationExpression(@(v) f(evaluate(a, v), evaluate(b, v)), ...
    ['(', a.Display, ' ', op, ' ', b.Display, ')'], vars, varMap);
  c.VarLowerBound = lowerMap;
  c.VarUpperBound = upperMap;
  c.VarType = typeMap;
end
%=============================================================================
function c = powerExpression(a, b, f)
  a = optim.problemdef.OptimizationExpression.fromAny(a);
  b = optim.problemdef.OptimizationExpression.fromAny(b);
  vars = unique([a.Variables, b.Variables], 'stable');
  varMap = mergeVarMaps(a.VarMap, b.VarMap);
  lowerMap = mergeVarMaps(a.VarLowerBound, b.VarLowerBound);
  upperMap = mergeVarMaps(a.VarUpperBound, b.VarUpperBound);
  typeMap = mergeVarMaps(a.VarType, b.VarType);
  c = optim.problemdef.OptimizationExpression(@(v) f(evaluate(a, v), evaluate(b, v)), ...
    [a.Display, '.^', b.Display], vars, varMap);
  c.VarLowerBound = lowerMap;
  c.VarUpperBound = upperMap;
  c.VarType = typeMap;
end
%=============================================================================
function varMap = mergeVarMaps(a, b)
  varMap = a;
  names = fieldnames(b);
  for k = 1:length(names)
    varMap.(names{k}) = b.(names{k});
  end
end
%=============================================================================
function txt = valueDisplay(value)
  if isnumeric(value) && isscalar(value)
    txt = num2str(value);
  else
    txt = 'constant';
  end
end
%=============================================================================
function op = mtimesDisplayOperator(a, b)
  if (isnumeric(a) && isscalar(a)) || (isnumeric(b) && isscalar(b))
    op = '.*';
  else
    op = '*';
  end
end
%=============================================================================
function txt = sumDisplay(a, args)
  if isempty(args)
    txt = ['sum(', a.Display, ')'];
  elseif length(args) == 1 && isnumeric(args{1}) && isscalar(args{1})
    txt = ['sum(', a.Display, ',', int2str(args{1}), ')'];
  elseif length(args) == 1 && (ischar(args{1}) || isstring(args{1}))
    txt = ['sum(', a.Display, ',', char(args{1}), ')'];
  else
    txt = ['sum(', a.Display, ',...)'];
  end
end
%=============================================================================
function value = indexValue(data, subs)
  value = data(subs{:});
end
%=============================================================================
function txt = subscriptText(subs)
  parts = cell(1, length(subs));
  for k = 1:length(subs)
    value = subs{k};
    if isnumeric(value) && isscalar(value)
      parts{k} = int2str(value);
    elseif ischar(value)
      parts{k} = value;
    else
      parts{k} = '...';
    end
  end
  body = parts{1};
  for k = 2:length(parts)
    body = [body, ',', parts{k}];
  end
  txt = ['(', body, ')'];
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
classdef OptimizationProblem
  properties
    Objective = []
    Constraints = struct()
    Variables = struct()
    ObjectiveSense = 'minimize'
    Description = ''
  end

  methods
    function obj = OptimizationProblem(varargin)
      if mod(length(varargin), 2) ~= 0
        error('Nelson:optimization:nameValueExpected', 'Name-value arguments expected.');
      end
      for k = 1:2:length(varargin)
        optionName = lower(char(varargin{k}));
        optionValue = varargin{k + 1};
        if strcmp(optionName, 'objective')
          objective = optim.problemdef.OptimizationExpression.fromAny(optionValue);
          obj.Objective = objective;
        elseif strcmp(optionName, 'constraints')
          obj.Constraints = optionValue;
        elseif strcmp(optionName, 'objectivesense')
          obj.ObjectiveSense = char(optionValue);
        elseif strcmp(optionName, 'description')
          obj.Description = char(optionValue);
        else
          error('Nelson:optimization:unsupportedOption', 'Unsupported "%s" option.', optionName);
        end
      end
    end

    function st = prob2struct(obj, varargin)
      st = struct();
      st.solver = 'fminsearch';
      st.objective = @(x) evaluateWithVector(obj, x);
      st.x0 = zeros(variableCount(obj), 1);
      st.options = [];
      if nargin >= 2 && isstruct(varargin{1})
        st.x0 = packValues(obj, varargin{1});
      end
      st = addLinearFields(st, obj);
    end

    function [sol, fval, exitflag, output] = solve(obj, x0, varargin)
      if nargin < 2
        x0 = struct();
      end
      st = prob2struct(obj, x0);
      if isempty(varargin)
        options = [];
      else
        options = varargin{1};
      end
      st.options = options;
      if strcmp(st.solver, 'linprog')
        [x, fval, exitflag, output] = linprog(st);
      elseif strcmp(st.solver, 'intlinprog')
        [x, fval, exitflag, output] = intlinprog(st);
      elseif strcmp(st.solver, 'quadprog')
        [x, fval, exitflag, output] = quadprog(st);
      elseif strcmp(st.solver, 'fmincon')
        [x, fval, exitflag, output] = fmincon(st);
      else
        objective = st.objective;
        [x, fval, exitflag, output] = fminsearch(objective, st.x0, options);
      end
      addOffset = isfield(st, 'objectiveOffset') ...
        && (strcmp(st.solver, 'linprog') || strcmp(st.solver, 'intlinprog') ...
        || strcmp(st.solver, 'quadprog'));
      if strcmpi(obj.ObjectiveSense, 'maximize') && ~isempty(fval)
        if addOffset
          fval = fval + st.objectiveOffset;
        end
        fval = -fval;
      elseif addOffset && ~isempty(fval)
        fval = fval + st.objectiveOffset;
      end
      if isempty(x)
        sol = emptySolution(obj);
      else
        sol = unpackValues(obj, x);
      end
    end

    function value = evaluateWithVector(obj, x)
      values = unpackValues(obj, x);
      value = evaluate(obj.Objective, values);
      if strcmpi(obj.ObjectiveSense, 'maximize')
        value = -value;
      end
      value = double(value) + 1e8 * (constraintPenalty(obj, values) + variablePenalty(obj, values));
    end

    function n = variableCount(obj)
      sizes = variableSizes(obj);
      names = variableNames(obj, sizes);
      n = 0;
      for k = 1:length(names)
        n = n + prod(sizes.(names{k}));
      end
    end

    function names = objectiveVariables(obj)
      if isempty(obj.Objective)
        names = {};
      else
        names = obj.Objective.Variables;
      end
      names = unique([names, constraintVariables(obj)], 'stable');
    end

    function names = constraintVariables(obj)
      names = {};
      constraints = constraintList(obj);
      for k = 1:length(constraints)
        c = constraints{k};
        names = unique([names, c.Left.Variables, c.Right.Variables], 'stable');
      end
    end

    function sizes = variableSizes(obj)
      sizes = struct();
      if ~isempty(obj.Objective) && isfield(struct(obj.Objective), 'VarMap')
        sizes = obj.Objective.VarMap;
      end
      constraints = constraintList(obj);
      for k = 1:length(constraints)
        c = constraints{k};
        if isfield(struct(c.Left), 'VarMap')
          sizes = mergeVarMaps(sizes, c.Left.VarMap);
        end
        if isfield(struct(c.Right), 'VarMap')
          sizes = mergeVarMaps(sizes, c.Right.VarMap);
        end
      end
      names = objectiveVariables(obj);
      for k = 1:length(names)
        if ~isfield(sizes, names{k})
          sizes.(names{k}) = [1 1];
        end
      end
    end

    function x = packValues(obj, values)
      sizes = variableSizes(obj);
      names = variableNames(obj, sizes);
      x = zeros(variableCount(obj), 1);
      offset = 0;
      for k = 1:length(names)
        if isstruct(values) && isfield(values, names{k})
          value = values.(names{k});
        else
          value = zeros(sizes.(names{k}));
        end
        count = prod(sizes.(names{k}));
        x(offset + 1:offset + count) = value(:);
        offset = offset + count;
      end
    end

    function values = unpackValues(obj, x)
      sizes = variableSizes(obj);
      names = variableNames(obj, sizes);
      values = struct();
      offset = 0;
      for k = 1:length(names)
        count = prod(sizes.(names{k}));
        values.(names{k}) = reshape(x(offset + 1:offset + count), sizes.(names{k}));
        offset = offset + count;
      end
    end

    function penalty = constraintPenalty(obj, values)
      penalty = 0;
      constraints = constraintList(obj);
      for k = 1:length(constraints)
        c = constraints{k};
        r = residual(c, values);
        if strcmp(c.Relation, '==')
          penalty = penalty + sum(r(:) .^ 2);
        else
          penalty = penalty + sum(max(0, r(:)) .^ 2);
        end
      end
    end

    function penalty = variablePenalty(obj, values)
      penalty = 0;
      if isempty(obj.Objective)
        return
      end
      expr = obj.Objective;
      names = objectiveVariables(obj);
      for k = 1:length(names)
        name = names{k};
        if ~isfield(values, name)
          continue
        end
        x = values.(name);
        if isfield(expr.VarLowerBound, name)
          lb = expr.VarLowerBound.(name);
          penalty = penalty + sum(max(0, lb - x) .^ 2);
        end
        if isfield(expr.VarUpperBound, name)
          ub = expr.VarUpperBound.(name);
          penalty = penalty + sum(max(0, x - ub) .^ 2);
        end
        if isfield(expr.VarType, name)
          type = lower(expr.VarType.(name));
          if strcmp(type, 'integer')
            penalty = penalty + sum((x - round(x)) .^ 2);
          elseif strcmp(type, 'binary')
            penalty = penalty + sum(max(0, -x) .^ 2 + max(0, x - 1) .^ 2 + (x .* (1 - x)) .^ 2);
          end
        end
      end
    end

    function constraints = constraintList(obj)
      constraints = flattenConstraints(obj.Constraints);
    end

    function disp(obj)
      builtin('disp', ['OptimizationProblem: ', obj.ObjectiveSense])
    end
  end
end
%=============================================================================
function constraints = flattenConstraints(value)
  constraints = {};
  if isempty(value)
    return
  end
  if isa(value, 'optim.problemdef.OptimizationConstraint')
    for k = 1:numel(value)
      item = value(k);
      if ~isempty(item.Left) && ~isempty(item.Right)
        constraints{end + 1} = item;
      end
    end
  elseif isstruct(value)
    fields = fieldnames(value);
    for n = 1:numel(value)
      for k = 1:length(fields)
        constraints = appendConstraints(constraints, flattenConstraints(value(n).(fields{k})));
      end
    end
  elseif iscell(value)
    for k = 1:numel(value)
      constraints = appendConstraints(constraints, flattenConstraints(value{k}));
    end
  end
end
%=============================================================================
function constraints = appendConstraints(constraints, extra)
  for k = 1:length(extra)
    constraints{end + 1} = extra{k};
  end
end
%=============================================================================
function sol = emptySolution(prob)
  sizes = variableSizes(prob);
  names = variableNames(prob, sizes);
  sol = struct();
  for k = 1:length(names)
    sol.(names{k}) = [];
  end
end
%=============================================================================
function problem = addLinearFields(problem, prob)
  n = variableCount(prob);
  zeroValues = unpackValues(prob, zeros(n, 1));
  isLinear = true;
  if ~isempty(prob.Objective)
    [f, constant, isObjectiveLinear] = linearCoefficients(@(values) evaluate(prob.Objective, values), prob, zeroValues);
    if strcmpi(prob.ObjectiveSense, 'maximize')
      f = -f;
      constant = -constant;
    end
    problem.f = f(:);
    problem.objectiveOffset = constant;
    isLinear = isLinear && isObjectiveLinear;
  end
  [A, b, Aeq, beq, areConstraintsLinear] = linearConstraints(prob, zeroValues);
  isLinear = isLinear && areConstraintsLinear;
  problem.A = sparse(A);
  problem.b = b;
  problem.Aeq = sparse(Aeq);
  problem.beq = beq;
  [lb, ub, intcon] = variableBoundsAndTypes(prob);
  problem.lb = lb;
  problem.ub = ub;
  problem.intcon = intcon;
  if isLinear && isfield(problem, 'f')
    if isempty(intcon)
      problem.solver = 'linprog';
    else
      problem.solver = 'intlinprog';
    end
  elseif ~isempty(intcon)
    error('Nelson:OptimizationProblem:integerNonlinearNotSupported', 'Nonlinear problems with integer variables are not supported.');
  elseif isempty(intcon) && areConstraintsLinear && ~isempty(prob.Objective)
    [H, qf, qconstant, isQuadratic] = quadraticCoefficients(prob);
    if isQuadratic
      problem.solver = 'quadprog';
      problem.H = sparse(H);
      problem.f = qf(:);
      problem.objectiveOffset = qconstant;
    end
  end
  if strcmp(problem.solver, 'fminsearch') && isempty(intcon) && ~isempty(prob.Objective) ...
      && hasContinuousConstraints(prob, lb, ub)
    problem.solver = 'fmincon';
    problem.objective = @(x) evaluateObjectiveOnly(prob, x);
    if areConstraintsLinear
      problem.nonlcon = [];
    else
      problem.A = sparse([]);
      problem.b = [];
      problem.Aeq = sparse([]);
      problem.beq = [];
      problem.nonlcon = @(x) nonlinearConstraints(prob, x);
    end
  end
end
%=============================================================================
function [H, f, constant, isQuadratic] = quadraticCoefficients(prob)
  n = variableCount(prob);
  objective = @(x) double(evaluate(prob.Objective, unpackValues(prob, x)));
  constant = objective(zeros(n, 1));
  if ~isscalar(constant)
    H = []; f = []; isQuadratic = false; return
  end
  H = zeros(n, n);
  f = zeros(n, 1);
  for i = 1:n
    ei = zeros(n, 1); ei(i) = 1;
    v1 = objective(ei);
    v2 = objective(2 * ei);
    H(i, i) = v2 - 2 * v1 + constant;
    f(i) = v1 - constant - 0.5 * H(i, i);
  end
  for i = 1:n
    ei = zeros(n, 1); ei(i) = 1;
    for j = i + 1:n
      ej = zeros(n, 1); ej(j) = 1;
      vij = objective(ei + ej);
      H(i, j) = vij - constant - f(i) - f(j) - 0.5 * H(i, i) - 0.5 * H(j, j);
      H(j, i) = H(i, j);
    end
  end
  isQuadratic = validateQuadratic(objective, H, f, constant);
  if strcmpi(prob.ObjectiveSense, 'maximize')
    H = -H; f = -f; constant = -constant;
  end
  H = (H + H') / 2;
end
%=============================================================================
function tf = validateQuadratic(objective, H, f, constant)
  n = length(f);
  points = [2 * ones(n, 1), -ones(n, 1), (1:n)'];
  tf = true;
  for k = 1:size(points, 2)
    x = points(:, k);
    actual = objective(x);
    expected = 0.5 * x' * H * x + f' * x + constant;
    if ~isscalar(actual) || abs(actual - expected) > 1e-8 * max(1, abs(actual))
      tf = false; return
    end
  end
end
%=============================================================================
function [coefficients, constant, isLinear] = linearCoefficients(fun, prob, zeroValues)
  n = variableCount(prob);
  constant = double(fun(zeroValues));
  m = numel(constant);
  coefficients = zeros(m, n);
  for k = 1:n
    x = zeros(n, 1);
    x(k) = 1;
    values = unpackValues(prob, x);
    value = double(fun(values));
    coefficients(:, k) = value(:) - constant(:);
  end
  isLinear = isLinearApproximation(fun, prob, coefficients, constant);
end
%=============================================================================
function [A, b, Aeq, beq, isLinear] = linearConstraints(prob, zeroValues)
  A = [];
  b = [];
  Aeq = [];
  beq = [];
  isLinear = true;
  constraints = constraintList(prob);
  for k = 1:length(constraints)
    c = constraints{k};
    residualFcn = @(values) evaluate(c.Left, values) - evaluate(c.Right, values);
    [row, constant, isConstraintLinear] = linearCoefficients(residualFcn, prob, zeroValues);
    isLinear = isLinear && isConstraintLinear;
    if strcmp(c.Relation, '==')
      Aeq = [Aeq; row];
      beq = [beq; -constant(:)];
    elseif strcmp(c.Relation, '<=')
      A = [A; row];
      b = [b; -constant(:)];
    else
      A = [A; -row];
      b = [b; constant(:)];
    end
  end
end
%=============================================================================
function tf = isLinearApproximation(fun, prob, coefficients, constant)
  n = variableCount(prob);
  points = [2 * ones(n, 1), -ones(n, 1)];
  tf = true;
  for k = 1:size(points, 2)
    x = points(:, k);
    values = unpackValues(prob, x);
    actual = double(fun(values));
    expected = constant(:) + coefficients * x;
    if numel(actual) ~= numel(expected) || max(abs(actual(:) - expected(:))) > 1e-10
      tf = false;
      return
    end
  end
end
%=============================================================================
function [lb, ub, intcon] = variableBoundsAndTypes(prob)
  sizes = variableSizes(prob);
  names = variableNames(prob, sizes);
  n = variableCount(prob);
  lb = -Inf(n, 1);
  ub = Inf(n, 1);
  intcon = [];
  metadata = variableMetadata(prob);
  offset = 0;
  for k = 1:length(names)
    name = names{k};
    count = prod(sizes.(name));
    range = offset + (1:count);
    if isfield(metadata.lower, name)
      lb(range) = expandBound(metadata.lower.(name), count);
    end
    if isfield(metadata.upper, name)
      ub(range) = expandBound(metadata.upper.(name), count);
    end
    if isfield(metadata.type, name)
      type = lower(metadata.type.(name));
      if strcmp(type, 'integer') || strcmp(type, 'binary')
        intcon = [intcon, range];
      end
    end
    offset = offset + count;
  end
end
%=============================================================================
function metadata = variableMetadata(prob)
  metadata.lower = struct();
  metadata.upper = struct();
  metadata.type = struct();
  expressions = {};
  if ~isempty(prob.Objective)
    expressions{end + 1} = prob.Objective;
  end
  constraints = constraintList(prob);
  for k = 1:length(constraints)
    expressions{end + 1} = constraints{k}.Left;
    expressions{end + 1} = constraints{k}.Right;
  end
  for k = 1:length(expressions)
    metadata.lower = mergeVarMaps(metadata.lower, expressions{k}.VarLowerBound);
    metadata.upper = mergeVarMaps(metadata.upper, expressions{k}.VarUpperBound);
    metadata.type = mergeVarMaps(metadata.type, expressions{k}.VarType);
  end
end
%=============================================================================
function names = variableNames(prob, sizes)
  names = objectiveVariables(prob);
  extraNames = fieldnames(sizes);
  names = unique([names, extraNames(:)'], 'stable');
end
%=============================================================================
function varMap = mergeVarMaps(a, b)
  varMap = a;
  names = fieldnames(b);
  for k = 1:length(names)
    varMap.(names{k}) = b.(names{k});
  end
end
%=============================================================================
function value = expandBound(bound, count)
  if isscalar(bound)
    value = repmat(bound, count, 1);
  else
    value = bound(:);
  end
end
%=============================================================================
function tf = hasContinuousConstraints(prob, lb, ub)
  tf = ~isempty(constraintList(prob)) || any(isfinite(lb)) || any(isfinite(ub));
end
%=============================================================================
function value = evaluateObjectiveOnly(prob, x)
  values = unpackValues(prob, x);
  value = evaluate(prob.Objective, values);
  if strcmpi(prob.ObjectiveSense, 'maximize')
    value = -value;
  end
  value = double(value);
end
%=============================================================================
function [c, ceq] = nonlinearConstraints(prob, x)
  values = unpackValues(prob, x);
  c = [];
  ceq = [];
  constraints = constraintList(prob);
  for k = 1:length(constraints)
    item = constraints{k};
    residualValue = double(residual(item, values));
    if strcmp(item.Relation, '==')
      ceq = [ceq; residualValue(:)];
    elseif strcmp(item.Relation, '<=')
      c = [c; residualValue(:)];
    else
      c = [c; -residualValue(:)];
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
classdef OptimizationVariable
  properties
    Name = ''
    Size = [1 1]
    Type = 'continuous'
    LowerBound = -Inf
    UpperBound = Inf
  end

  methods
    function obj = OptimizationVariable(name, varargin)
      if nargin == 0
        return
      end
      obj.Name = char(name);
      dims = [];
      while ~isempty(varargin) && isnumeric(varargin{1})
        value = double(varargin{1});
        if isscalar(value)
          dims = [dims, value];
        else
          dims = value(:).';
        end
        varargin(1) = [];
      end
      if ~isempty(dims)
        if numel(dims) == 1
          dims = [dims, 1];
        end
        validateDimensions(dims);
        obj.Size = dims;
      end
      if mod(length(varargin), 2) ~= 0
        error('Nelson:optimization:nameValueExpected', 'Name-value arguments expected.');
      end
      for k = 1:2:length(varargin)
        pname = lower(char(varargin{k}));
        value = varargin{k + 1};
        switch pname
          case 'lowerbound'
            obj.LowerBound = value;
          case 'upperbound'
            obj.UpperBound = value;
          case 'type'
            obj.Type = char(value);
          otherwise
            error('Nelson:optimization:unsupportedOption', 'Unsupported "%s" option.', pname);
        end
      end
      obj.Type = validateType(obj.Type);
      validateBounds(obj.LowerBound, obj.UpperBound, obj.Size);
      if strcmpi(obj.Type, 'binary')
        if isequal(obj.LowerBound, -Inf)
          obj.LowerBound = 0;
        end
        if isequal(obj.UpperBound, Inf)
          obj.UpperBound = 1;
        end
      end
    end

    function value = evaluate(obj, values)
      if ~isstruct(values) || ~isfield(values, obj.Name)
        error('Nelson:optimization:variableValueMissing', 'Value for optimization variable is missing.');
      end
      value = values.(obj.Name);
    end

    function expr = toExpression(obj)
      varMap = struct();
      varMap.(obj.Name) = obj.Size;
      expr = optim.problemdef.OptimizationExpression(@(values) evaluate(obj, values), obj.Name, {obj.Name}, varMap);
      expr.VarLowerBound.(obj.Name) = obj.LowerBound;
      expr.VarUpperBound.(obj.Name) = obj.UpperBound;
      expr.VarType.(obj.Name) = obj.Type;
    end

    function c = plus(a, b)
      c = optim.problemdef.OptimizationExpression.fromAny(a) + b;
    end

    function c = minus(a, b)
      c = optim.problemdef.OptimizationExpression.fromAny(a) - b;
    end

    function c = times(a, b)
      c = optim.problemdef.OptimizationExpression.fromAny(a) .* b;
    end

    function c = rdivide(a, b)
      c = optim.problemdef.OptimizationExpression.fromAny(a) ./ b;
    end

    function c = mtimes(a, b)
      c = optim.problemdef.OptimizationExpression.fromAny(a) * b;
    end

    function c = power(a, b)
      c = optim.problemdef.OptimizationExpression.fromAny(a) .^ b;
    end

    function c = mpower(a, b)
      c = optim.problemdef.OptimizationExpression.fromAny(a) ^ b;
    end

    function c = uminus(a)
      c = -toExpression(a);
    end

    function c = sum(a, varargin)
      c = sum(toExpression(a), varargin{:});
    end

    function c = norm(a)
      c = norm(toExpression(a));
    end

    function c = log(a)
      c = log(toExpression(a));
    end

    function c = le(a, b)
      c = toExpression(a) <= b;
    end

    function c = ge(a, b)
      c = toExpression(a) >= b;
    end

    function c = eq(a, b)
      c = toExpression(a) == b;
    end

    function value = subsref(obj, s)
      if strcmp(s(1).type, '.')
        value = builtin('subsref', obj, s);
        return
      end
      if ~strcmp(s(1).type, '()')
        error('Nelson:OptimizationVariable:unsupportedIndexing', 'Unsupported variable indexing.');
      end
      base = toExpression(obj);
      subs = s(1).subs;
      displayText = [obj.Name, subscriptText(subs)];
      value = optim.problemdef.OptimizationExpression(@(values) indexValue(evaluate(base, values), subs), ...
        displayText, base.Variables, base.VarMap);
      value.VarLowerBound = base.VarLowerBound;
      value.VarUpperBound = base.VarUpperBound;
      value.VarType = base.VarType;
      if length(s) > 1
        value = subsref(value, s(2:end));
      end
    end

    function index = end(obj, k, n)
      if k < n
        index = obj.Size(k);
      else
        index = prod(obj.Size(k:end));
      end
    end

    function disp(obj)
      builtin('disp', ['OptimizationVariable: ', obj.Name])
    end
  end
end
%=============================================================================
function validateDimensions(dims)
  if any(~isfinite(dims)) || any(dims < 1) || any(abs(dims - round(dims)) > eps)
    error('Nelson:OptimizationVariable:invalidDimensions', 'Optimization variable dimensions must be positive integers.');
  end
end
%=============================================================================
function type = validateType(type)
  valid = {'continuous', 'integer', 'binary'};
  type = lower(char(type));
  if ~any(strcmp(type, valid))
    error('Nelson:optim:invalidOptionValue', 'Invalid value for "%s".', 'Type');
  end
end
%=============================================================================
function validateBounds(lb, ub, sz)
  count = prod(sz);
  validateBoundSize(lb, count);
  validateBoundSize(ub, count);
  if isscalar(lb) && isscalar(ub)
    if lb > ub
      error('Nelson:optimization:boundsInconsistent', 'Lower bounds must not exceed upper bounds.');
    end
  elseif numel(lb) == numel(ub)
    if any(lb(:) > ub(:))
      error('Nelson:optimization:boundsInconsistent', 'Lower bounds must not exceed upper bounds.');
    end
  end
end
%=============================================================================
function validateBoundSize(bound, count)
  if ~(isscalar(bound) || numel(bound) == count)
    error('Nelson:OptimizationVariable:invalidBoundsSize', 'Variable bounds must be scalar or match the variable size.');
  end
end
%=============================================================================
function value = indexValue(data, subs)
  value = data(subs{:});
end
%=============================================================================
function txt = subscriptText(subs)
  parts = cell(1, length(subs));
  for k = 1:length(subs)
    value = subs{k};
    if isnumeric(value) && isscalar(value)
      parts{k} = int2str(value);
    elseif ischar(value)
      parts{k} = value;
    else
      parts{k} = '...';
    end
  end
  body = parts{1};
  for k = 2:length(parts)
    body = [body, ',', parts{k}];
  end
  txt = ['(', body, ')'];
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function value = evaluate(expr, values)
  if nargin < 2
    values = struct();
  end
  if isa(expr, 'optim.problemdef.OptimizationExpression')
    value = expr.EvalFcn(values);
  elseif isa(expr, 'optim.problemdef.OptimizationConstraint')
    lhs = evaluate(expr.Left, values);
    rhs = evaluate(expr.Right, values);
    switch expr.Relation
      case '<='
        value = lhs <= rhs;
      case '>='
        value = lhs >= rhs;
      otherwise
        value = lhs == rhs;
    end
  elseif isa(expr, 'optim.problemdef.OptimizationVariable')
    if ~isstruct(values) || ~isfield(values, expr.Name)
      error('Nelson:optimization:variableValueMissing', 'Value for optimization variable is missing.');
    end
    value = values.(expr.Name);
  else
    value = expr;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function expr = fcn2optimexpr(fcn, varargin)
  if nargin < 1 || ~isa(fcn, 'function_handle')
    error('Nelson:fcn2optimexpr:functionHandleExpected', '%s must be a function handle.', 'First argument');
  end
  [inputs, ~] = splitInputsAndOptions(varargin);
  argExprs = cell(1, numel(inputs));
  vars = {};
  varMap = struct();
  lowerMap = struct();
  upperMap = struct();
  typeMap = struct();
  displays = cell(1, numel(inputs));
  for k = 1:numel(inputs)
    e = optim.problemdef.OptimizationExpression.fromAny(inputs{k});
    argExprs{k} = e;
    vars = unique([vars, e.Variables], 'stable');
    varMap = mergeVarMaps(varMap, e.VarMap);
    lowerMap = mergeVarMaps(lowerMap, e.VarLowerBound);
    upperMap = mergeVarMaps(upperMap, e.VarUpperBound);
    typeMap = mergeVarMaps(typeMap, e.VarType);
    displays{k} = e.Display;
  end
  displayText = [functionName(fcn), '(', joinDisplays(displays), ')'];
  expr = optim.problemdef.OptimizationExpression(@(values) applyFcn(fcn, argExprs, values), ...
    displayText, vars, varMap);
  expr.VarLowerBound = lowerMap;
  expr.VarUpperBound = upperMap;
  expr.VarType = typeMap;
end
%=============================================================================
function value = applyFcn(fcn, argExprs, values)
  args = cell(1, numel(argExprs));
  for k = 1:numel(argExprs)
    args{k} = evaluate(argExprs{k}, values);
  end
  value = fcn(args{:});
end
%=============================================================================
function [inputs, options] = splitInputsAndOptions(args)
  knownOptions = {'outputsize', 'reuseevaluation', 'analysis'};
  splitIndex = numel(args) + 1;
  for k = 1:numel(args)
    item = args{k};
    if (ischar(item) || (isstring(item) && isscalar(item))) ...
        && any(strcmp(lower(char(item)), knownOptions))
      splitIndex = k;
      break
    end
  end
  inputs = args(1:splitIndex - 1);
  options = args(splitIndex:end);
  if mod(numel(options), 2) ~= 0
    error('Nelson:optimization:nameValueExpected', 'Name-value arguments expected.');
  end
end
%=============================================================================
function name = functionName(fcn)
  name = func2str(fcn);
  if ~isempty(name) && name(1) == '@'
    name = 'fcn';
  end
end
%=============================================================================
function txt = joinDisplays(displays)
  if isempty(displays)
    txt = '';
    return
  end
  txt = displays{1};
  for k = 2:numel(displays)
    txt = [txt, ', ', displays{k}];
  end
end
%=============================================================================
function varMap = mergeVarMaps(a, b)
  varMap = a;
  names = fieldnames(b);
  for k = 1:length(names)
    varMap.(names{k}) = b.(names{k});
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [x, fval, exitflag, output] = fminbnd(fun, x1, x2, options)
  fromProblem = false;
  if nargin == 1 && isstruct(fun)
    problem = fun;
    fun = problem.objective;
    x1 = problem.x1;
    x2 = problem.x2;
    if isfield(problem, 'options')
      options = problem.options;
    else
      options = [];
    end
    fromProblem = true;
  end
  if ~fromProblem && nargin < 3
    error('Nelson:notEnoughInputs', 'Not enough input arguments.');
  end
  if ~fromProblem && nargin > 4
    error('Nelson:tooManyInputs', 'Too many input arguments.');
  end
  if ~fromProblem && nargin < 4, options = []; end
  opts = optimMergeOptions('fminbnd', options);
  if ~isscalar(x1) || ~isscalar(x2) || ~(x1 < x2)
    error('Nelson:fminbnd:invalidBounds', 'Bounds must be finite scalars with x1 < x2.');
  end
  a = double(x1); b = double(x2);
  c = 0.5 * (3 - sqrt(5));
  x = a + c * (b - a); w = x; v = x;
  e = 0; fx = scalarObjective(fun, x, opts); fw = fx; fv = fx;
  funcCount = 1; exitflag = 0; message = _('Maximum number of iterations or function evaluations reached.');
  for iter = 1:opts.MaxIter
    xm = 0.5 * (a + b);
    tol1 = opts.TolX * abs(x) + eps;
    tol2 = 2 * tol1;
    if abs(x - xm) <= (tol2 - 0.5 * (b - a))
      exitflag = 1; message = _('Optimization converged.'); break
    end
    if abs(e) > tol1
      r = (x - w) * (fx - fv);
      q = (x - v) * (fx - fw);
      p = (x - v) * q - (x - w) * r;
      q = 2 * (q - r);
      if q > 0, p = -p; end
      q = abs(q);
      olde = e; e = 0;
      if abs(p) < abs(0.5 * q * olde) && p > q * (a - x) && p < q * (b - x)
        d = p / q;
        u = x + d;
        if (u - a) < tol2 || (b - u) < tol2
          d = sign(xm - x) * tol1;
        end
      else
        e = chooseInterval(x, xm, a, b);
        d = c * e;
      end
    else
      e = chooseInterval(x, xm, a, b);
      d = c * e;
    end
    u = x + signedMax(d, tol1);
    fu = scalarObjective(fun, u, opts); funcCount = funcCount + 1;
    if fu <= fx
      if u < x, b = x; else, a = x; end
      v = w; fv = fw; w = x; fw = fx; x = u; fx = fu;
    else
      if u < x, a = u; else, b = u; end
      if fu <= fw || w == x
        v = w; fv = fw; w = u; fw = fu;
      elseif fu <= fv || v == x || v == w
        v = u; fv = fu;
      end
    end
    if funcCount >= opts.MaxFunEvals || optimOutputStop(opts.OutputFcn, x, makeValues(fx, iter, funcCount), 'iter')
      if funcCount < opts.MaxFunEvals
        exitflag = -1;
        message = _('Stopped by output function.');
      end
      break
    end
  end
  fval = fx;
  output.iterations = iter;
  output.funcCount = funcCount;
  output.algorithm = 'bounded scalar minimization';
  output.message = message;
end
%=============================================================================
function e = chooseInterval(x, xm, a, b)
  if x >= xm, e = a - x; else, e = b - x; end
end
%=============================================================================
function y = signedMax(d, tol)
  if d >= 0, y = max(d, tol); else, y = -max(abs(d), tol); end
end
%=============================================================================
function f = scalarObjective(fun, x, opts)
  f = optimCall(fun, x);
  f = optimCheckFunValue(f, opts);
  if ~isnumeric(f) || ~isscalar(f), error('Nelson:optimization:invalidObjectiveScalar', '%s must return a numeric scalar.', 'Objective function'); end
  f = double(f);
end
%=============================================================================
function values = makeValues(fval, iter, funcCount)
  values = struct();
  values.fval = fval; values.iteration = iter; values.funccount = funcCount;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
