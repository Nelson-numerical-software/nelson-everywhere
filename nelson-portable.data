function varargout = colororder(varargin)
  narginchk(0, 2);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [ax, args] = parseAxis(args);
  if isempty(args)
    varargout{1} = ax.ColorOrder;
    return
  end
  colors = colorOrderValue(args{1});
  ax.ColorOrder = colors;
  ax.ColorOrderIndex = 1;
  updateAutomaticBarColors(ax, colors);
  if nargout == 1
    error('Nelson:graphics:invalidOutputArgument', 'Invalid output argument.');
  end
end
%=============================================================================
function [ax, args] = parseAxis(args)
  if ~isempty(args) && isscalar(args{1}) && isgraphics(args{1}, 'axes')
    ax = args{1};
    args = args(2:end);
  else
    ax = gca();
  end
end
%=============================================================================
function colors = colorOrderValue(value)
  if ischar(value) || isStringScalar(value)
    colors = namedColorOrder(char(value));
  elseif isnumeric(value) && isreal(value) && size(value, 2) == 3
    colors = double(value);
  else
    error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
  end
end
%=============================================================================
function colors = namedColorOrder(name)
  switch lower(name)
    case {'default', 'gem'}
      colors = [0.066 0.443 0.745; 0.866 0.329 0; 0.929 0.694 0.125; ...
        0.521 0.086 0.819; 0.231 0.666 0.196; 0.184 0.745 0.937; ...
        0.819 0.015 0.545];
    case 'glow'
      colors = [0.149 0.549 0.866; 0.96 0.466 0.16; 1 0.909 0.392; ...
        0.752 0.36 0.984; 0.286 0.858 0.25; 0.423 0.956 1; ...
        0.949 0.403 0.772];
    case 'sail'
      colors = [0.062 0.258 0.501; 0.329 0.713 1; 1 0.27 0.227; ...
        0.564 0.149 0.133; 0.066 0.443 0.745];
    case 'reef'
      colors = [0.866 0.329 0; 0.329 0.713 1; 0.066 0.443 0.745; ...
        0.996 0.564 0.262; 0.454 0.921 0.854; 0 0.639 0.639];
    case 'meadow'
      colors = [0.007 0.345 0.054; 0.227 0.784 0.192; 1 0.839 0.039; ...
        0.96 0.466 0.16; 0.752 0.298 0.043; 0.98 0.541 0.831; ...
        0.49 0.662 1];
    case 'dye'
      colors = [0.717 0.192 0.172; 0.231 0.666 0.196; 0.368 0.133 0.588; ...
        0.066 0.443 0.745; 0.866 0.329 0; 0.007 0.47 0.501; ...
        0.913 0.317 0.721];
    case 'earth'
      colors = [0.062 0.258 0.501; 0.717 0.192 0.172; 0.611 0.466 0.125; ...
        0.007 0.345 0.054; 0.862 0.6 0.423; 0.372 0.105 0.031; ...
        1 0.819 0.619];
    otherwise
      error('Nelson:colororder:unknownColorOrder', 'Unknown color order.');
  end
end
%=============================================================================
function updateAutomaticBarColors(ax, colors)
  bars = findobj(ax, 'Type', 'bar');
  for k = 1:numel(bars)
    if strcmp(bars(k).FaceColorMode, 'auto')
      index = bars(k).SeriesIndex;
      if isnumeric(index) && isscalar(index)
        row = mod(double(index) - 1, size(colors, 1)) + 1;
        bars(k).FaceColor = colors(row, :);
        bars(k).FaceColorMode = 'auto';
      end
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [linespec, colorspec, markerspec, msg] = colstyle(varargin)
  narginchk(1, 3);
  nargoutchk(0, 4);
  style = varargin{1};
  emptyAsNone = false;
  raiseError = true;
  if nargin == 2
    if ~(ischar(varargin{2}) || isStringScalar(varargin{2}))
      error('Nelson:colstyle:plotArgumentExpected', '"plot" argument expected.');
    end
    option = convertStringsToChars(varargin{2});

    if strcmp('plot', option) || strcmp('', option)
      emptyAsNone = strcmp('plot', option);
    else
      error('Nelson:colstyle:plotArgumentExpected', '"plot" argument expected.');
    end
  elseif nargin == 3
    raiseError = varargin{3};
  end
  if ~ischar(style) && ~isStringScalar(style)
    if raiseError
      error('Nelson:colstyle:requiresAStringScalar', 'Requires a string scalar or a character vector argument.');
    else
      colorspec = '';
      markerspec = '';
      linespec = '';
      msg.message = 'Invalid LineSpec string.';
      msg.Identifier = 'Nelson:colstyle:InvalidLinespec';
      return
    end
  end
  style = convertStringsToChars(style);
  giveup = 0;
  colorspec = '';
  markerspec = '';
  linespec = '';
  msg = [];
  if isempty(style)
    return;
  end
  orig_t = style;
  while (~giveup && length(style) > 0)
    giveup = 1;
    if (matchit(getColorShortName(style), getColorShortNameList()))
      [colorspec, style] = parseit(getColorShortName(style), getColorShortNameList());
      giveup = 0;
    end;
    if (matchit(style, getMarkerNameList()))
      [markerspec, style] = parseit(style, getMarkerNameList());
      giveup = 0;
    end
    if (matchit(style, styleset()))
      [linespec, style] = parseit(style, styleset());
      giveup = 0;
    end
  end
  if (strcmp(markerspec, '') && strcmp(linespec, ''))
    linespec = '-';
  end
  if giveup
    colorspec = '';
    markerspec = '';
    linespec = '';
    msg.message = 'Invalid LineSpec string.';
    msg.Identifier = 'Nelson:colstyle:InvalidLinespec';
    return
  end
  if isempty(linespec)
    if emptyAsNone
      linespec = 'none';
    else
      linespec = '';
    end
  end
end
%=============================================================================
function b = matchit(t, dictionary)
  b = any(stcmp(dictionary, t));
end
%=============================================================================
function [b, t] = parseit(t, dictionary)
  n = stcmp(dictionary, t);
  b = dictionary{min(find(n))};
  t(1:length(b)) = [];
end
%=============================================================================
function c = styleset()
  c = {'--', ':', '-.', '-'};
end
%=============================================================================
function b = stcmp(source, pattern)
  b = zeros(size(source), 'logical');
  for i = 1:numel(source)
    b(i) = strncmp(source{i}, pattern, length(source{i}));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function comet(varargin)
  narginchk(1, 4);
  nargoutchk(0, 0);
  args = convertStringToCharArgs(varargin);
  [ax, args] = parseCometParent(args);
  [x, y, p] = parseCometData(args);
  cometAnimate(ax, x, y, [], p);
end
%=============================================================================
function [ax, args] = parseCometParent(args)
  if ~isempty(args) && isscalar(args{1}) && isgraphics(args{1}, 'axes')
    ax = args{1};
    args = args(2:end);
  else
    ax = [];
  end
end
%=============================================================================
function [x, y, p] = parseCometData(args)
  p = 0.1;
  if numel(args) == 1
    y = args{1};
    x = 1:numel(y);
  elseif numel(args) == 2
    x = args{1};
    y = args{2};
  elseif numel(args) == 3
    x = args{1};
    y = args{2};
    p = args{3};
  else
    error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
  end
  if ~isnumeric(x) || ~isnumeric(y) || ~isvector(x) || ~isvector(y) || numel(x) ~= numel(y) || isempty(x)
    error('Nelson:comet:invalidXAndY', 'X and Y must be nonempty numeric vectors with the same number of elements.');
  end
  if ~isnumeric(p) || ~isscalar(p) || ~isfinite(p) || p < 0 || p >= 1
    error('Nelson:comet:invalidP', 'P must be a scalar value in the interval [0, 1).');
  end
  x = x(:).';
  y = y(:).';
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function comet3(varargin)
  narginchk(1, 5);
  nargoutchk(0, 0);
  args = convertStringToCharArgs(varargin);
  [ax, args] = parseComet3Parent(args);
  [x, y, z, p] = parseComet3Data(args);
  cometAnimate(ax, x, y, z, p);
end
%=============================================================================
function [ax, args] = parseComet3Parent(args)
  if ~isempty(args) && isscalar(args{1}) && isgraphics(args{1}, 'axes')
    ax = args{1};
    args = args(2:end);
  else
    ax = [];
  end
end
%=============================================================================
function [x, y, z, p] = parseComet3Data(args)
  p = 0.1;
  if numel(args) == 1
    z = args{1};
    x = 1:numel(z);
    y = 1:numel(z);
  elseif numel(args) == 3
    x = args{1};
    y = args{2};
    z = args{3};
  elseif numel(args) == 4
    x = args{1};
    y = args{2};
    z = args{3};
    p = args{4};
  else
    error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
  end
  if ~isnumeric(x) || ~isnumeric(y) || ~isnumeric(z) || ~isvector(x) || ...
      ~ isvector(y) || ~isvector(z) || numel(x) ~= numel(y) || ...
      numel(x) ~= numel(z) || isempty(x)
    error('Nelson:comet3:invalidXYAnd', 'X, Y, and Z must be nonempty numeric vectors with the same number of elements.');
  end
  if ~isnumeric(p) || ~isscalar(p) || ~isfinite(p) || p < 0 || p >= 1
    error('Nelson:comet:invalidP', 'P must be a scalar value in the interval [0, 1).');
  end
  x = x(:).';
  y = y(:).';
  z = z(:).';
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
