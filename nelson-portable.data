function varargout = light(varargin)
  nargoutchk(0, 1);
  inputArguments = convertStringToCharArgs(varargin);
  if ~isempty(inputArguments) && isscalar(inputArguments{1}) && isgraphics(inputArguments{1}, 'axes')
    ax = inputArguments{1};
    inputArguments = inputArguments(2:end);
  else
    ax = gca();
  end
  if rem(length(inputArguments), 2) ~= 0
    error('Nelson:graphics:invalidNameValueArguments', 'Invalid parameter/value pair arguments.');
  end
  h = __light__('Parent', ax, inputArguments{:});
  if nargout > 0
    varargout{1} = h;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = lightangle(varargin)
  nargoutchk(0, 1);
  inputArguments = convertStringToCharArgs(varargin);
  [ax, h, az, el] = parseLightAngleInputs(inputArguments);
  pos = angleToPosition(ax, az, el);
  if isempty(h)
    h = light(ax, 'Position', pos, 'Style', 'infinite');
  else
    set(h, 'Position', pos);
  end
  if nargout > 0
    varargout{1} = h;
  end
end
%=============================================================================
function [ax, h, az, el] = parseLightAngleInputs(args)
  ax = gca();
  h = [];
  if ~isempty(args) && isscalar(args{1}) && isgraphics(args{1}, 'axes')
    ax = args{1};
    args = args(2:end);
  elseif ~isempty(args) && isscalar(args{1}) && isgraphics(args{1}, 'light')
    h = args{1};
    ax = ancestor(h, 'axes');
    args = args(2:end);
  end
  if length(args) ~= 2 || ~isnumeric(args{1}) || ~isscalar(args{1}) ...
      || ~isnumeric(args{2}) || ~isscalar(args{2})
    error('Nelson:lightangle:azimuthAndElevationExpected', 'Azimuth and elevation expected.');
  end
  az = args{1};
  el = args{2};
end
%=============================================================================
function pos = angleToPosition(ax, az, el)
  az = az * pi / 180;
  el = el * pi / 180;
  dataAspectRatio = ax.DataAspectRatio;
  if numel(dataAspectRatio) ~= 3 || any(~isfinite(dataAspectRatio)) || any(dataAspectRatio <= 0)
    dataAspectRatio = [1 1 1];
  end
  xScale = hypot(dataAspectRatio(1), dataAspectRatio(3));
  yScale = hypot(dataAspectRatio(2), dataAspectRatio(3));
  zScale = xScale / dataAspectRatio(1);
  pos = [xScale * cos(el) * sin(az), -yScale * cos(el) * cos(az), zScale * sin(el)];
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function lighting(varargin)
  nargoutchk(0, 0);
  inputArguments = convertStringToCharArgs(varargin);
  if isempty(inputArguments)
    error('Nelson:notEnoughInputs', 'Not enough input arguments.');
  end
  if isscalar(inputArguments{1}) && isgraphics(inputArguments{1}, 'axes')
    ax = inputArguments{1};
    inputArguments = inputArguments(2:end);
  else
    ax = gca();
  end
  if length(inputArguments) ~= 1 || ~ischar(inputArguments{1})
    error('Nelson:lighting:lightingModeExpected', 'A lighting mode expected.');
  end
  mode = lower(inputArguments{1});
  if strcmp(mode, 'phong')
    error('Nelson:lighting:invalidPropertyValue', 'Illegal selection for property.');
  end
  if ~any(strcmp(mode, {'none', 'flat', 'gouraud'}))
    error('Nelson:lighting:invalidPropertyValue', 'Illegal selection for property.');
  end
  h = surfacePatchChildren(ax);
  if ~isempty(h)
    set(h, 'FaceLighting', mode, 'EdgeLighting', mode);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = line(varargin)
  nargoutchk(0, 1);
  inputArguments = convertStringToCharArgs(varargin);
  if (nargin == 0)
    ax = gca();
    handle = line(ax, [0 1], [0 1]);
    ax.XLim = [0 inf];
    ax.YLim = [0 inf];
    if (nargout > 0)
      varargout{1} = handle;
    end
    return
  end
  if (length(inputArguments) > 0 && isscalar(inputArguments{1}) && (isgraphics(inputArguments{1}, 'axes') || isgraphics(inputArguments{1}, 'hggroup')))
    ax = inputArguments{1};
    inputArguments = inputArguments(2:end);
  else
    ax = gca();
  end
  [ax, inputArguments] = extractParentProperty(ax, inputArguments);

  % When the caller does not pin an explicit Color, line() draws with the next
  % color of the axes ColorOrder and advances the shared color index, matching
  % the reference (plot then line -> next color; two lines -> two colors). The
  % ColorOrder lives on the axes, so an hggroup parent resolves to its ancestor.
  colorAxes = ax;
  if isgraphics(ax, 'hggroup')
    colorAxes = ancestor(ax, 'axes');
  end
  if hasColorProperty(inputArguments) || isempty(colorAxes) || ~isgraphics(colorAxes, 'axes')
    colorArgs = {};
  else
    colorArgs = {'Color', getColorAndUpdateIndex(colorAxes)};
  end

  xIsDate = false;
  yIsDate = false;
  if isempty(inputArguments)
    handle = __line__('Parent', ax, colorArgs{:});
  elseif (ischar(inputArguments{1}))
    handle = __line__('Parent', ax, colorArgs{:}, inputArguments{:});
  elseif (numel(inputArguments) == 2)
    [x, xIsDate] = datetimeToSerial(inputArguments{1});
    [y, yIsDate] = datetimeToSerial(inputArguments{2});
    handle = __line__('Parent', ax, 'XData', x, 'YData', y, colorArgs{:});
  elseif (numel(inputArguments) >= 3)
    [x, xIsDate] = datetimeToSerial(inputArguments{1});
    [y, yIsDate] = datetimeToSerial(inputArguments{2});
    inputArguments = inputArguments(3:end);
    if isnumeric(inputArguments{1})
      z = inputArguments{1};
      inputArguments = inputArguments(2:end);
    else
      z = ones(0, 1);
    end
    if isempty(inputArguments)
      handle = __line__('Parent', ax, 'XData', x, 'YData', y, 'ZData', z, colorArgs{:});
    else
      handle = __line__('Parent', ax, 'XData', x, 'YData', y, 'ZData', z, ...
        colorArgs{:}, inputArguments{:});
    end
  else
    error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
  end
  if xIsDate
    applyDatetimeAxis(ax, 'x');
  end
  if yIsDate
    applyDatetimeAxis(ax, 'y');
  end
  if (nargout > 0)
    varargout{1} = handle;
  end
end
%=============================================================================

function tf = hasColorProperty(inputArguments)
  tf = false;
  for k = 1:length(inputArguments)
    if ischar(inputArguments{k}) && strcmpi(inputArguments{k}, 'Color')
      tf = true;
      return
    end
  end
end
%=============================================================================
function [parent, inputArguments] = extractParentProperty(parent, inputArguments)
  parentIndex = [];
  for k = 1:(length(inputArguments) - 1)
    if ischar(inputArguments{k}) && strcmpi(inputArguments{k}, 'Parent')
      parentIndex = k;
    end
  end
  if ~isempty(parentIndex)
    parent = inputArguments{parentIndex + 1};
    inputArguments(parentIndex:parentIndex + 1) = [];
  end
end
