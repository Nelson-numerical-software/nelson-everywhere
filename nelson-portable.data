function obj = ltiSubscriptSet(obj, name, value)
  switch class(obj)
    case 'tf'
      obj = setTfProperty(obj, name, value);
    case 'ss'
      obj = setSsProperty(obj, name, value);
    otherwise
      error('Nelson:control_system:unknownProperty', 'No property of the class ''%s'' matches the identifier ''%s''.', class(obj), name);
  end
end
%=============================================================================
function obj = setTfProperty(obj, name, value)
  switch name
    case 'IODelay'
      obj.IODelay = value;
    case 'InputDelay'
      obj.InputDelay = value;
    case 'OutputDelay'
      obj.OutputDelay = value;
    case 'InputName'
      obj.InputName = value;
    case 'InputUnit'
      obj.InputUnit = value;
    case 'InputGroup'
      obj.InputGroup = value;
    case 'OutputName'
      obj.OutputName = value;
    case 'OutputUnit'
      obj.OutputUnit = value;
    case 'OutputGroup'
      obj.OutputGroup = value;
    case 'Notes'
      obj.Notes = value;
    case 'UserData'
      obj.UserData = value;
    case 'SamplingGrid'
      obj.SamplingGrid = value;
    case 'Internal'
      obj.Internal = value;
    otherwise
      error('Nelson:control_system:unknownProperty', 'No property of the class ''%s'' matches the identifier ''%s''.', 'tf', name);
  end
end
%=============================================================================
function obj = setSsProperty(obj, name, value)
  switch name
    case 'A'
      obj.A = value;
    case 'B'
      obj.B = value;
    case 'C'
      obj.C = value;
    case 'D'
      obj.D = value;
    case 'E'
      obj.E = value;
    case 'Offsets'
      obj.Offsets = value;
    case 'Scaled'
      obj.Scaled = value;
    case 'StateName'
      obj.StateName = value;
    case 'StatePath'
      obj.StatePath = value;
    case 'StateUnit'
      obj.StateUnit = value;
    case 'InternalDelay'
      obj.InternalDelay = value;
    case 'InputDelay'
      obj.InputDelay = value;
    case 'OutputDelay'
      obj.OutputDelay = value;
    case 'InputName'
      obj.InputName = value;
    case 'InputUnit'
      obj.InputUnit = value;
    case 'InputGroup'
      obj.InputGroup = value;
    case 'OutputName'
      obj.OutputName = value;
    case 'OutputUnit'
      obj.OutputUnit = value;
    case 'OutputGroup'
      obj.OutputGroup = value;
    case 'Notes'
      obj.Notes = value;
    case 'UserData'
      obj.UserData = value;
    case 'SamplingGrid'
      obj.SamplingGrid = value;
    case 'Internal'
      obj.Internal = value;
    otherwise
      error('Nelson:control_system:unknownProperty', 'No property of the class ''%s'' matches the identifier ''%s''.', 'ss', name);
  end
end
