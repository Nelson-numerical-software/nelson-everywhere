%=============================================================================
function [M, I] = min(A, varargin)
  if ~A.isOrdinal
    error('Nelson:categorical:requiresOrdinal', '%s requires ordinal categorical arrays.', 'Minimum');
  end
  sortable = A.codes;
  sortable(sortable == 0) = Inf;
  flat = sortable(:);
  minValue = Inf;
  I = 0;
  for k = 1:length(flat)
    if flat(k) < minValue
      minValue = flat(k);
      I = k;
    end
  end
  M = A(I);
end
