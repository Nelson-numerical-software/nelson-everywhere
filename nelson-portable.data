%=============================================================================
asserts.isequal(nargin('quantile'), -1);
asserts.isequal(nargout('quantile'), 1);
%=============================================================================
A = [2 5 6 10 11 13];
Q = quantile(A, [0.25 0.5 0.75]);
asserts.isequal(Q, [5 8 11]);
asserts.isequal(quantile(A, 3), [5 8 11]);
%=============================================================================
B = [1 NaN 5 10 20];
Q = quantile(B, [0 0.25 0.5 0.75 1]);
asserts.isapprox(Q, [1 3 7.5 15 20], 1e-12);
%=============================================================================
D = reshape(1:30, [3 5 2]);
Qall = quantile(D, [0.25 0.75], 'all');
asserts.isequal(size(Qall), [2 1]);
asserts.isequal(Qall, [8; 23]);
Qpage = quantile(D, [0.25 0.75], [1 2]);
asserts.isequal(size(Qpage), [2 1 2]);
asserts.isapprox(Qpage(:), [4.25; 11.75; 19.25; 26.75], 1e-12);
Qslice = quantile(D, [0.25 0.75], [2 3]);
asserts.isequal(size(Qslice), [3 2]);
asserts.isapprox(Qslice(:), [7; 8; 9; 22; 23; 24], 1e-12);
%=============================================================================
methods = [quantile(1:5, 0.25, 'Method', 'midpoint'), ...
           quantile(1:5, 0.25, 'Method', 'inclusive'), ...
           quantile(1:5, 0.25, 'Method', 'exclusive'), ...
           quantile(1:5, 0.25, 'Method', 'exact'), ...
           quantile(1:5, 0.25, 'Method', 'approximate')];
asserts.isapprox(methods, [1.75 2 1.5 1.75 1.75], 1e-12);
%=============================================================================
S = single([1 2 3]);
Qsingle = quantile(S, [0.25 0.5 0.75]);
asserts.isequal(class(Qsingle), 'single');
asserts.isapprox(double(Qsingle), [1.25 2 2.75], 1e-6);
Qinteger = quantile(int32([1 2 3]), 0.5);
asserts.isequal(class(Qinteger), 'double');
asserts.isequal(Qinteger, 2);
%=============================================================================
asserts.checkerror('quantile()', _('Not enough input arguments.'));
asserts.checkerror('quantile({1}, 0.5)', sprintf(_('%s must be a real numeric array.'), 'A'));
asserts.checkerror('quantile([1 2], -0.1)', sprintf(_('%s must be in the range [0,1].'), 'Probabilities'));
asserts.checkerror('quantile([1 2], -0.1)', sprintf(_('%s must be in the range [0,1].'), 'Probabilities'), 'Nelson:statistics:probabilityOutOfRange');
asserts.checkerror('quantile([1 2], 1.5)', sprintf(_('%s must be in the range [0,1].'), 'Probabilities'));
asserts.checkerror('quantile([1 2], [0.5 NaN])', sprintf(_('%s must be in the range [0,1].'), 'Probabilities'));
asserts.checkerror('quantile([1 2], 0.5, 0)', _('Dimension argument must be a positive integer scalar, vector, or ''all''.'));
asserts.checkerror('quantile([1 2], 0.5, ''bad'')', _('Invalid quantile option.'));
asserts.checkerror('quantile([1 2], 0.5, ''Method'')', _('Method option requires a value.'));
asserts.checkerror('quantile([1 2], 0.5, ''Method'', ''bad'')', _('Invalid quantile method.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('randsample'), -1);
asserts.isequal(nargout('randsample'), 1);
%=============================================================================
rng(10);
y1 = randsample(10, 4);
rng(10);
y2 = randsample(10, 4);
asserts.isequal(y1, y2);
asserts.isequal(length(unique(y1)), 4);
asserts.istrue(all(y1 >= 1));
asserts.istrue(all(y1 <= 10));
%=============================================================================
y = randsample([10 20 30], 5, true, [0 0 1]);
asserts.isequal(y, 30 * ones(5, 1));
%=============================================================================
rng(3);
y = randsample([4; 5], 6, true);
asserts.isequal(size(y), [6 1]);
asserts.istrue(all((y == 4) | (y == 5)));
%=============================================================================
y = randsample('abcd', 2, false);
asserts.isequal(size(y), [2 1]);
asserts.istrue(all((y == 'a') | (y == 'b') | (y == 'c') | (y == 'd')));
%=============================================================================
asserts.checkerror('randsample()', _('Not enough input arguments.'));
asserts.checkerror('randsample(0, 1)', sprintf(_('%s must be a positive integer scalar.'), 'N'));
asserts.checkerror('randsample(3, 0)', sprintf(_('%s must be a positive integer scalar.'), 'K'));
asserts.checkerror('randsample([], 1)', _('Population must not be empty.'));
asserts.checkerror('randsample(3, 4)', _('K must not exceed the population size without replacement.'));
asserts.checkerror('randsample(3, 2, 2)', sprintf(_('%s must be a scalar logical value.'), 'Replacement'));
asserts.checkerror('randsample(3, 2, false, ones(3, 1))', _('Weighted sampling requires replacement.'));
asserts.checkerror('randsample(3, 2, true, ones(2, 1))', _('Weights must be a nonnegative vector with one value per population element.'));
asserts.checkerror('randsample(3, 2, true, [1 -1 1])', _('Weights must be a nonnegative vector with one value per population element.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
asserts.isequal(nargin('range'), 2);
asserts.isequal(nargout('range'), 1);
%=============================================================================
asserts.isequal(range([3 1 8 4]), 7);
asserts.isequal(range([1 2; 5 4]), [4 2]);
asserts.isequal(range([1 2; 5 4], 2), [1; 1]);
asserts.isequal(range([1 2; 5 4], 1), [4 2]);
asserts.isequal(range(-5), 0);
asserts.isapprox(range([1.5 2.5 -3.0]), 5.5, 1e-12);
% ignores NaN like max/min
asserts.isequal(range([1 NaN 5]), 4);
% column vector
asserts.isequal(range([2; 9; 4]), 7);
%=============================================================================
asserts.checkerror('range(''abc'')', sprintf(_('%s must be numeric or logical.'), 'Input'), 'Nelson:validators:mustBeNumericOrLogical');
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--WEIGHT 2-->
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('rangesearch'), -1);
asserts.isequal(nargout('rangesearch'), 2);
%=============================================================================
X = [0 0; 1 0; 0 2; 4 4];
Y = [0 1; 3 4; 10 10];
[idx, D] = rangesearch(X, Y, 1.1);
asserts.isequal(size(idx), [3 1]);
asserts.isequal(idx{1}, [1 3]);
asserts.isequal(idx{2}, 4);
asserts.isequal(idx{3}, zeros(1, 0));
asserts.isequal(D{1}, [1 1]);
asserts.isequal(D{2}, 1);
asserts.isequal(D{3}, zeros(1, 0));
%=============================================================================
[idx, D] = rangesearch(X, Y(1:2, :), 5, 'Distance', 'cityblock');
asserts.isequal(idx{1}, [1 3 2]);
asserts.isequal(idx{2}, [4 3]);
asserts.isequal(D{1}, [1 1 2]);
asserts.isequal(D{2}, [1 5]);
%=============================================================================
[idx, D] = rangesearch(X, Y(1, :), 1.1, 'Distance', 'minkowski', 'P', 1);
asserts.isequal(idx{1}, [1 3]);
asserts.isequal(D{1}, [1 1]);
%=============================================================================
[idx, D] = rangesearch(X, Y(1, :), 0.5, 'Distance', 'seuclidean', 'Scale', [1 2]);
asserts.isequal(idx{1}, [1 3]);
asserts.isequal(D{1}, [0.5 0.5]);
%=============================================================================
[idx, D] = rangesearch([0; 1; 2], [1], 1, 'SortIndices', false, 'NSMethod', 'exhaustive');
asserts.isequal(idx{1}, [1 2 3]);
asserts.isequal(D{1}, [1 0 1]);
%=============================================================================
asserts.checkerror('rangesearch()', _('Not enough input arguments.'));
asserts.checkerror('rangesearch([1; 2], [1], 1, ''Distance'')', _('Name-value arguments must be paired.'));
asserts.checkerror('rangesearch({1}, [1], 1)', sprintf(_('%s must be a real numeric matrix.'), 'X'));
asserts.checkerror('rangesearch([1 2], [1], 1)', sprintf(_('X and Y must have %s.'), 'the same number of columns'));
asserts.checkerror('rangesearch([1; 2], [1], -1)', sprintf(_('%s must be a nonnegative scalar.'), 'R'));
asserts.checkerror('rangesearch([1; 2], [1], Inf)', sprintf(_('%s must be a nonnegative scalar.'), 'R'));
asserts.checkerror('rangesearch([1; 2], [1], 1, ''Distance'', ''bad'')', sprintf(_('Invalid %s value.'), 'Distance'));
asserts.checkerror('rangesearch([1; 2], [1], 1, ''Distance'', ''minkowski'', ''P'', 0)', sprintf(_('%s must be a positive scalar.'), 'P'));
asserts.checkerror('rangesearch([1; 2], [1], 1, ''NSMethod'', ''bad'')', sprintf(_('Invalid %s value.'), 'NSMethod'));
asserts.checkerror('rangesearch([1; 2], [1], 1, ''SortIndices'', 2)', sprintf(_('%s must be true or false.'), 'SortIndices'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('ranksum'), -3);
asserts.isequal(nargout('ranksum'), 3);
%=============================================================================
[p, h, stats] = ranksum([1 3 5], [2 4 6]);
asserts.isapprox(p, 0.700000000000000, 1e-12);
asserts.isequal(h, false);
asserts.isequal(stats.ranksum, 9);
asserts.isfalse(isfield(stats, 'zval'));
%=============================================================================
[p2, h2, stats2] = ranksum([1 2 2 3 4], [2 3 4 4 5], 'Method', 'approximate');
asserts.isapprox(p2, 0.162586850726355, 1e-12);
asserts.isequal(h2, false);
asserts.isapprox(stats2.ranksum, 20.500000000000000, 1e-12);
asserts.isapprox(stats2.zval, 1.396424004376894, 1e-12);
%=============================================================================
[p3, h3, stats3] = ranksum([5 6 7 8], [1 2 3 4], 'Tail', 'right', 'Alpha', 0.1);
asserts.isapprox(p3, 0.014285714285714, 1e-12);
asserts.isequal(h3, true);
asserts.isequal(stats3.ranksum, 26);
%=============================================================================
[p4, h4, stats4] = ranksum([1 2 NaN 3], [3 4 5], 'Tail', 'left');
asserts.isapprox(p4, 0.060591636418732, 1e-12);
asserts.isequal(h4, false);
asserts.isapprox(stats4.ranksum, 6.500000000000000, 1e-12);
asserts.isapprox(stats4.zval, -1.549826049695167, 1e-12);
%=============================================================================
[p5, h5, stats5] = ranksum([1 1 1], [1 1 1]);
asserts.isequal(p5, 1);
asserts.isequal(h5, false);
asserts.isapprox(stats5.ranksum, 10.500000000000000, 1e-12);
asserts.isequal(stats5.zval, 0);
%=============================================================================
[ps, hs, statss] = ranksum(single([1 3 5]), single([2 4 6]));
asserts.isequal(class(ps), 'double');
asserts.isequal(hs, false);
asserts.isequal(statss.ranksum, stats.ranksum);
%=============================================================================
asserts.checkerror('ranksum()', _('Not enough input arguments.'));
asserts.checkerror('ranksum({1}, [1 2])', sprintf(_('%s must be a real numeric vector.'), 'X'));
asserts.checkerror('ranksum([1 2], {1})', sprintf(_('%s must be a real numeric vector.'), 'Y'));
asserts.checkerror('ranksum([NaN], [1])', sprintf(_('%s must contain at least one non-NaN observation.'), 'X and Y'));
asserts.checkerror('ranksum([1], [1], ''Alpha'')', _('Name-value arguments must be paired.'));
asserts.checkerror('ranksum([1], [1], ''Unknown'', 1)', _('Invalid name-value argument name.'));
asserts.checkerror('ranksum([1], [1], ''Alpha'', 2)', sprintf(_('%s must be a scalar in the range (0,1).'), 'ALPHA'));
asserts.checkerror('ranksum([1], [1], ''Tail'', ''bad'')', sprintf(_('%s has an unsupported value.'), 'TAIL'));
asserts.checkerror('ranksum([1 1], [1 1], ''Method'', ''exact'')', _('Exact method is not supported when ties are present.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('raylcdf'), 3);
asserts.isequal(nargout('raylcdf'), 1);
%=============================================================================
x = [-1 0 2 4 Inf];
R = raylcdf(x, 2);
E = [0 0 0.3934693402873666 0.8646647167633873 1];
asserts.isapprox(R, E, 1e-15);
R = raylcdf(x, 2, 'upper');
E = [1 1 0.6065306597126334 0.1353352832366127 0];
asserts.isapprox(R, E, 1e-15);
%=============================================================================
R = raylcdf([1 2 3], [1 2 3]);
E = [0.3934693402873666 0.3934693402873666 0.3934693402873666];
asserts.isapprox(R, E, 1e-15);
%=============================================================================
R = raylcdf(single([0 2 4]), single(2));
asserts.isequal(class(R), 'single');
asserts.isapprox(double(R), [0 0.3934693402873666 0.8646647167633873], 1e-7);
%=============================================================================
R = raylcdf([1 NaN 1 1], [1 1 NaN 0]);
asserts.isapprox(R(1), 0.3934693402873666, 1e-15);
asserts.istrue(all(isnan(R(2:4))));
%=============================================================================
R = raylcdf([], []);
asserts.isequal(size(R), [0 0]);
%=============================================================================
asserts.checkerror('raylcdf(1)', _('Not enough input arguments.'));
asserts.checkerror('raylcdf(ones(2), ones(3))', _('Size mismatch on input arguments'));
asserts.checkerror('raylcdf(1, 1, ''bad'')', sprintf(_('Invalid %s distribution option.'), 'Rayleigh'));
asserts.checkerror('raylcdf({1}, 1)', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('raylcdf(1, {1})', sprintf(_('%s must be real numeric.'), 'B'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('raylfit'), 4);
asserts.isequal(nargout('raylfit'), 2);
%=============================================================================
x = [0.5 1 2 3 5 8];
[PHAT, PCI] = raylfit(x);
asserts.isapprox(PHAT, 2.933285984466340, 1e-12);
asserts.isapprox(PCI, [1.966091053118864; 4.376280871131397], 1e-12);
%=============================================================================
[PHAT, PCI] = raylfit(x, 0.01);
asserts.isapprox(PHAT, 2.933285984466340, 1e-12);
asserts.isapprox(PCI, [1.733832641651132; 4.962512793895091], 1e-12);
%=============================================================================
censor = [0 0 0 1 0 1];
freq = [1 2 1 1 2 1];
[PHAT, PCI] = raylfit(x, 0.05, censor, freq);
asserts.isapprox(PHAT, 3.281894777919203, 1e-12);
asserts.isapprox(PCI, [2.199754069559662; 4.896380682904884], 1e-12);
%=============================================================================
xm = [0.5 1; 1 2; 2 3; 3 4; 5 7];
[PHATM, PCIM] = raylfit(xm);
asserts.isequal(size(PHATM), [2 1]);
asserts.isapprox(PHATM, [1.981161275615895; 2.810693864511039], 1e-12);
asserts.isequal(size(PCIM), [2 2]);
asserts.isapprox(PCIM, [1.278160734110911 1.813339417764860;
                       3.070818790823075 4.356603028978224], 1e-12);
%=============================================================================
[PHAT, PCI] = raylfit(single(x));
asserts.isequal(class(PHAT), 'double');
asserts.isequal(class(PCI), 'double');
asserts.isapprox(PHAT, 2.933285984466340, 1e-12);
%=============================================================================
[PHAT, PCI] = raylfit([1 NaN 3]);
asserts.istrue(isnan(PHAT));
asserts.istrue(all(isnan(PCI(:))));
[PHAT, PCI] = raylfit([1 2 3], [], [1 1 1], []);
asserts.istrue(isnan(PHAT));
asserts.istrue(all(isnan(PCI(:))));
[PHAT, PCI] = raylfit([1 2 3], [], [], [0 0 0]);
asserts.istrue(isnan(PHAT));
asserts.istrue(all(isnan(PCI(:))));
%=============================================================================
asserts.checkerror('raylfit()', _('Not enough input arguments.'));
asserts.checkerror('raylfit([])', _('X must be a nonempty vector or matrix.'));
asserts.checkerror('raylfit(ones(1, 1, 2))', _('X must be a nonempty vector or matrix.'));
asserts.checkerror('raylfit({1 2 3})', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('raylfit([-1 1 2])', sprintf(_('%s must contain nonnegative finite values.'), 'X'));
asserts.checkerror('raylfit([1 Inf 2])', sprintf(_('%s must contain nonnegative finite values.'), 'X'));
asserts.checkerror('raylfit([1 2 3], {0.05})', sprintf(_('%s must be numeric.'), 'ALPHA'));
asserts.checkerror('raylfit([1 2 3], -0.1)', sprintf(_('%s must be a scalar in the range [0,1].'), 'ALPHA'));
asserts.checkerror('raylfit([1 2 3], 1.1)', sprintf(_('%s must be a scalar in the range [0,1].'), 'ALPHA'));
asserts.checkerror('raylfit([1 2 3], [], [0 2 0])', _('CENSORING must contain 0 or 1 values.'));
asserts.checkerror('raylfit([1 2 3], [], [], [1 -1 1])', sprintf(_('%s must contain nonnegative finite values.'), 'FREQ'));
asserts.checkerror('raylfit([1 2 3], [], ones(2, 2))', _('Size mismatch on input arguments'));
%=============================================================================
%=============================================================================
