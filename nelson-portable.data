function r = have_mpi()
  persistent mpi_required %#ok<NLS0005>
  if isempty(mpi_required)
    nelson_cli = getNelsonExecutablePath('nelson-cli');
    command = ['mpiexec -n 1 "', nelson_cli, '" -q -e "exit()"'];
    mpi_required = (unix(command) == 0);
  end
  r = mpi_required;
end
