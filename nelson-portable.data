%=============================================================================
asserts.isequal(nargin('geolike'), 2);
asserts.isequal(nargout('geolike'), 2);
%=============================================================================
x = [0 1 2 3 5 8];
[NLOGL, AVAR] = geolike(0.25, x);
asserts.isapprox(NLOGL, 13.78372554330318, 1e-12);
asserts.isapprox(AVAR, 0.007705479452054795, 1e-12);
%=============================================================================
[NLOGL, AVAR] = geolike(single(0.5), single([0 1 2]));
asserts.isequal(class(NLOGL), 'double');
asserts.isequal(class(AVAR), 'double');
asserts.isapprox(NLOGL, 4.158883083359671, 1e-12);
asserts.isapprox(AVAR, 0.04166666666666666, 1e-12);
%=============================================================================
[NLOGL, AVAR] = geolike(1, [0 0 0]);
asserts.isequal(NLOGL, 0);
asserts.isequal(AVAR, 0);
[NLOGL, AVAR] = geolike(1, [0 1]);
asserts.istrue(isinf(NLOGL));
asserts.istrue(isnan(AVAR));
[NLOGL, AVAR] = geolike(NaN, x);
asserts.istrue(isnan(NLOGL));
asserts.istrue(isnan(AVAR));
[NLOGL, AVAR] = geolike(0.5, [1 NaN 3]);
asserts.istrue(isnan(NLOGL));
asserts.istrue(isnan(AVAR));
%=============================================================================
asserts.checkerror('geolike(0.5)', _('Not enough input arguments.'));
asserts.checkerror('geolike({0.5}, [1 2 3])', _('P must be a real numeric scalar.'));
asserts.checkerror('geolike(0.5, {1 2 3})', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('geolike(0.5, [])', sprintf(_('%s must be nonempty.'), 'X'));
asserts.checkerror('geolike(0.5, [-1 1 2])', sprintf(_('%s must contain nonnegative integer finite values.'), 'X'));
asserts.checkerror('geolike(0.5, [1.5 2 3])', sprintf(_('%s must contain nonnegative integer finite values.'), 'X'));
asserts.checkerror('geolike(0.5, [1 Inf 2])', sprintf(_('%s must contain nonnegative integer finite values.'), 'X'));
%=============================================================================%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('geomean'), -2);
asserts.isequal(nargout('geomean'), 1);
%=============================================================================
X = reshape(1:30, [3 5 2]);
G1 = geomean(X);
asserts.isapprox(G1(:, :, 1), [1.817120592832140 4.932424148660940 7.958114415792782 ...
                              10.969613104865232 13.976149868636853], 1e-12);
asserts.isapprox(G1(:, :, 2), [16.980369497551095 19.983319425122101 22.985498104604215 ...
                              25.987173160227080 28.988501188326641], 1e-12);
G2 = geomean(X, 2);
asserts.isapprox(G2(:, :, 1), [5.154900378820651; 6.578428239440857; 7.815513254092054], 1e-12);
asserts.isapprox(G2(:, :, 2), [21.581362563894338; 22.600373672194777; 23.617700562212111], 1e-12);
G3 = geomean(X, 3);
expectedG3 = [4.000000000000000 8.717797887081348 12.409673645990853 15.811388300841893 19.078784028338912; ...
              5.830951894845301 9.999999999999998 13.564659966250538 16.911534525287760 20.149441679609883; ...
              7.348469228349532 11.224972160321824 14.696938456699069 17.999999999999996 21.213203435596427];
asserts.isapprox(G3(:), expectedG3(:), 1e-12);
G4 = geomean(X, [1 2]);
asserts.isequal(size(G4), [1 1 2]);
asserts.isapprox(G4(:), [6.423424749779763; 22.584511308634223], 1e-12);
G5 = geomean(X, [2 3]);
asserts.isapprox(G5(:), [10.547500844090255; 12.193233221220769; 13.586186064350292], 1e-12);
asserts.isapprox(geomean(reshape(1:40, [2 5 4]), 'all'), 15.768527022963257, 1e-12);
%=============================================================================
x = 1:10;
x(3) = NaN;
asserts.istrue(isnan(geomean(x)));
asserts.isapprox(geomean(x, 'omitnan'), 4.740772189428327, 1e-12);
asserts.istrue(isnan(geomean(x, 'includenan')));
asserts.isequal(geomean([1 2 3], 3), [1 2 3]);
asserts.isequal(geomean([1 2 3], [3 4]), [1 2 3]);
asserts.isequal(geomean([1 0 3]), 0);
S = geomean(single([1 2 4 8]));
asserts.isequal(class(S), 'single');
asserts.isapprox(double(S), 2.828427076339722, 1e-6);
%=============================================================================
asserts.checkerror('geomean()', _('Not enough input arguments.'));
asserts.checkerror('geomean({1})', sprintf(_('%s must be a real numeric array.'), 'X'));
asserts.checkerror('geomean([1 2], 0)', _('Dimension must be a positive integer scalar, vector, or ''all''.'));
asserts.checkerror('geomean([1 2], ''bad'')', _('Invalid option.'));
asserts.checkerror('geomean([1 2], ''omitnan'', ''includenan'')', _('Too many input arguments.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('geopdf'), 2);
asserts.isequal(nargout('geopdf'), 1);
%=============================================================================
x = [0 1 2 5];
R = geopdf(x, 0.25);
asserts.isapprox(R, [0.25 0.1875 0.140625 0.059326171875], 1e-15);
%=============================================================================
R = geopdf([0 1 2], [0.25 0.5 1]);
asserts.isapprox(R, [0.25 0.25 0], 1e-15);
%=============================================================================
R = geopdf(single([0 1 2]), single(0.25));
asserts.isequal(class(R), 'single');
asserts.isapprox(double(R), [0.25 0.1875 0.140625], 1e-7);
%=============================================================================
R = geopdf([-1 1.5 Inf NaN 0 0], [0.25 0.25 0.25 0.25 -0.1 1.1]);
asserts.isapprox(R(1:3), [0 0 0], 1e-15);
asserts.istrue(all(isnan(R(4:6))));
R = geopdf([0 1], [0 1]);
asserts.isapprox(R, [0 0], 1e-15);
%=============================================================================
R = geopdf([], []);
asserts.isequal(size(R), [0 0]);
%=============================================================================
asserts.checkerror('geopdf(ones(2), ones(3))', _('Size mismatch on input arguments'));
asserts.checkerror('geopdf({1}, 0.5)', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('geopdf(1, {0.5})', _('P must be a numeric array in the range [0,1].'));
%=============================================================================
asserts.isapprox(geopdf(2, 0.25), 0.75 ^ 2 * 0.25, 1e-12);
asserts.istrue(isnan(geopdf(0, -0.1)));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('geornd'), -1);
asserts.isequal(nargout('geornd'), 1);
%=============================================================================
rng(0);
R = geornd(0.25, 2, 3);
asserts.isapprox(R, [5 0 3; 8 8 0], 1e-15);
%=============================================================================
rng(0);
U = rand(2, 4);
E = floor(log1p(-U) ./ log1p(-0.25));
rng(0);
R = geornd(0.25, 2, 4);
asserts.isequal(size(R), [2 4]);
asserts.isapprox(R, E, 1e-15);
%=============================================================================
rng(0);
U = rand(1, 3);
E = floor(log1p(-U) ./ log1p(-[0.25 0.5 0.75]));
rng(0);
R = geornd([0.25 0.5 0.75]);
asserts.isapprox(R, E, 1e-15);
%=============================================================================
rng(0);
U = rand(2, 3, 'single');
E = floor(log1p(-U) ./ log1p(-single(0.25)));
rng(0);
R = geornd(single(0.25), [2 3]);
asserts.isequal(class(R), 'single');
asserts.isapprox(double(R), double(E), 1e-6);
%=============================================================================
R = geornd(0, [1 3]);
asserts.istrue(all(isinf(R)));
R = geornd(1, [1 3]);
asserts.isapprox(R, zeros(1, 3), 1e-15);
R = geornd(-0.1, [1 3]);
asserts.istrue(all(isnan(R)));
R = geornd(1.1, [1 3]);
asserts.istrue(all(isnan(R)));
%=============================================================================
R = geornd(0.5, 0, 3);
asserts.isequal(size(R), [0 3]);
R = geornd(single(0.5), [2 0 3]);
asserts.isequal(class(R), 'single');
asserts.isequal(size(R), [2 0 3]);
R = geornd(0.5, -1, 3);
asserts.isequal(size(R), [0 3]);
%=============================================================================
asserts.checkerror('geornd([0.25 0.5], 2, 2)', _('Size mismatch on input arguments'));
asserts.checkerror('geornd(0.5, 1.5, 2)', _('Size must contain integer values.'));
asserts.checkerror('geornd(0.5, Inf, 2)', _('Size must contain integer values.'));
asserts.checkerror('geornd({0.5})', _('P must be a numeric array in the range [0,1].'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('geostat'), 1);
asserts.isequal(nargout('geostat'), 2);
%=============================================================================
[m, v] = geostat(0.25);
asserts.isapprox(m, 3, 1e-15);
asserts.isapprox(v, 12, 1e-15);
%=============================================================================
[m, v] = geostat([0.25 0.5 1 0]);
asserts.isapprox(m(1:3), [3 1 0], 1e-15);
asserts.isapprox(v(1:3), [12 2 0], 1e-15);
asserts.istrue(isinf(m(4)) && m(4) > 0);
asserts.istrue(isinf(v(4)) && v(4) > 0);
%=============================================================================
[m, v] = geostat(single([0.25 0.5]));
asserts.isequal(class(m), 'single');
asserts.isequal(class(v), 'single');
asserts.isapprox(double(m), [3 1], 1e-7);
asserts.isapprox(double(v), [12 2], 1e-6);
%=============================================================================
[m, v] = geostat([-0.1 1.1 NaN]);
asserts.istrue(all(isnan(m)));
asserts.istrue(all(isnan(v)));
%=============================================================================
[m, v] = geostat([]);
asserts.isequal(size(m), [0 0]);
asserts.isequal(size(v), [0 0]);
%=============================================================================
asserts.checkerror('geostat({0.5})', _('P must be a numeric array in the range [0,1].'));
%=============================================================================
[geoMean, geoVariance] = geostat(0.25);
asserts.isequal(geoMean, 3);
asserts.isequal(geoVariance, 12);
