% LICENCE_BLOCK_END
%=============================================================================
function varargout = copper(varargin)
  nargoutchk(0, 1);
  narginchk(0, 1);
  if nargin < 1
    R = groot();
    f = R.CurrentFigure;
    if isempty(f)
      m = size(R.DefaultFigureColormap, 1);
    else
      m = size(f.Colormap, 1);
    end
  else
    m = varargin{1};
  end
  varargout{1} = min(1, gray(m) * diag([1.2500 0.7812 0.4975]));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
