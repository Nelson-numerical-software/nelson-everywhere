%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function value = __response_name__(value)
  if ~(ischar(value) || (isstring(value) && isscalar(value)))
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'ResponseName');
  end
  value = char(value);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = probplot(varargin)
  narginchk(1, 5);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [parent, args] = parseParentLocal(args);
  [dist, y, cens, freq, showRef] = parseInputsLocal(args);
  data = prepareDataLocal(y, cens, freq, dist);
  curves = computeCurvesLocal(data, dist, showRef);
  h = drawCurvesLocal(parent, curves, dist, showRef);
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [parent, args] = parseParentLocal(args)
  parent = [];
  if ~isempty(args) && isscalar(args{1}) && (isgraphics(args{1}, 'axes') || isgraphics(args{1}, 'hggroup'))
    parent = args{1};
    args = args(2:end);
  end
end
%=============================================================================
function [dist, y, cens, freq, showRef] = parseInputsLocal(args)
  if isempty(args)
    error('Nelson:notEnoughInputs', 'Not enough input arguments.');
  end
  showRef = true;
  if ischar(args{end}) || isStringScalarLocal(args{end})
    text = lower(char(args{end}));
    if strcmp(text, 'noref')
      showRef = false;
      args(end) = [];
    end
  end
  dist = 'normal';
  if ~isempty(args) && (ischar(args{1}) || isStringScalarLocal(args{1}))
    dist = normalizeDistributionLocal(args{1});
    args = args(2:end);
  end
  if isempty(args)
    error('Nelson:notEnoughInputs', 'Not enough input arguments.');
  end
  if length(args) > 3
    error('Nelson:tooManyInputs', 'Too many input arguments.');
  end
  y = validateDataLocal(args{1});
  cens = [];
  freq = [];
  if length(args) >= 2
    cens = validateSideVectorLocal(args{2}, y, 'Censoring');
  end
  if length(args) >= 3
    freq = validateSideVectorLocal(args{3}, y, 'Frequency');
  end
end
%=============================================================================
function tf = isStringScalarLocal(value)
  tf = isstring(value) && isscalar(value);
end
%=============================================================================
function dist = normalizeDistributionLocal(value)
  text = strtrim(lower(char(value)));
  text = strrep(text, '-', ' ');
  while contains(text, '  ')
    text = strrep(text, '  ', ' ');
  end
  if any(strcmp(text, {'normal', 'norm'}))
    dist = 'normal';
  elseif any(strcmp(text, {'exponential', 'exp'}))
    dist = 'exponential';
  elseif any(strcmp(text, {'extreme value', 'ev'}))
    dist = 'extreme value';
  elseif any(strcmp(text, {'half normal', 'halfnormal'}))
    dist = 'half normal';
  elseif any(strcmp(text, {'lognormal', 'log normal'}))
    dist = 'lognormal';
  elseif strcmp(text, 'logistic')
    dist = 'logistic';
  elseif any(strcmp(text, {'loglogistic', 'log logistic'}))
    dist = 'loglogistic';
  elseif strcmp(text, 'rayleigh')
    dist = 'rayleigh';
  elseif strcmp(text, 'weibull')
    dist = 'weibull';
  else
    error('Nelson:statistics:unsupportedDistribution', 'Unsupported %s.', 'distribution');
  end
end
%=============================================================================
function y = validateDataLocal(y)
  if ~(isnumeric(y) && isreal(y) && ~issparse(y) && ~isempty(y))
    error('Nelson:statistics:yRealNumericArray', '%s must be a real numeric array.', 'Y');
  end
  if ndims(y) > 2
    error('Nelson:statistics:yVectorMatrix', '%s must be a vector or matrix.', 'Y');
  end
  y = double(y);
  if isvector(y)
    y = y(:);
  end
end
%=============================================================================
function value = validateSideVectorLocal(value, y, name)
  if isempty(value)
    return
  end
  if ~(isnumeric(value) || islogical(value)) || ~isreal(value)
    error('Nelson:statistics:mustBeRealNumeric', '%s must be a real numeric array.', name);
  end
  value = double(value);
  if ~isequal(size(value), size(y))
    error('Nelson:statistics:mustMatchY', '%s must match Y.', name);
  end
end
%=============================================================================
function data = prepareDataLocal(y, cens, freq, dist)
  data = cell(size(y, 2), 1);
  for k = 1:size(y, 2)
    column = y(:, k);
    keep = isfinite(column);
    if ~isempty(cens)
      ck = cens(:, k);
      keep = keep & isfinite(ck) & (ck == 0);
    end
    column = column(keep);
    if ~isempty(freq)
      fk = freq(:, k);
      fk = fk(keep);
      column = expandByFrequencyLocal(column, fk);
    end
    column = validateRangeLocal(column, dist);
    if isempty(column)
      error('Nelson:statistics:yContainLeastOneValid', 'Y must contain at least one valid observation per column.');
    end
    data{k} = sort(column(:));
  end
end
%=============================================================================
function column = expandByFrequencyLocal(column, freq)
  if any(~isfinite(freq)) || any(freq < 0) || any(floor(freq) ~= freq)
    error('Nelson:statistics:frequencyContainNonnegativeIntegerValues', '%s must contain nonnegative integer values.', 'Frequency');
  end
  expanded = zeros(sum(freq), 1);
  at = 1;
  for k = 1:length(column)
    count = freq(k);
    if count > 0
      expanded(at:(at + count - 1)) = column(k);
      at = at + count;
    end
  end
  column = expanded;
end
%=============================================================================
function column = validateRangeLocal(column, dist)
  if any(strcmp(dist, {'exponential', 'lognormal', 'loglogistic', 'rayleigh', 'weibull'}))
    column = column(column > 0);
  elseif strcmp(dist, 'half normal')
    column = abs(column);
  end
end
%=============================================================================
function curves = computeCurvesLocal(data, dist, showRef)
  curves = cell(numel(data), 1);
  for k = 1:numel(data)
    values = data{k};
    n = length(values);
    p = ((1:n)' - 0.5) / n;
    refX = [];
    refY = [];
    if showRef
      [refX, refY] = referenceLineLocal(values, dist);
    end
    curves{k} = struct('XData', values(:), 'YData', p(:), ...
      'ReferenceX', refX(:), 'ReferenceY', refY(:), 'Distribution', dist);
  end
end
%=============================================================================
function [refX, refY] = referenceLineLocal(values, dist)
  p = [0.25; 0.75];
  if strcmp(dist, 'half normal')
    p = [0; 0.5];
  end
  xQuartiles = quantile(values, p);
  zQuartiles = distributionInvLocal(p, dist);
  dz = zQuartiles(2) - zQuartiles(1);
  if dz == 0 || isnan(dz)
    scale = 1;
  else
    scale = (xQuartiles(2) - xQuartiles(1)) / dz;
  end
  location = xQuartiles(1) - scale * zQuartiles(1);
  refX = linspace(min(values), max(values), 100)';
  refY = distributionCdfLocal((refX - location) / scale, dist);
  refY = min(max(refY, 0), 1);
end
%=============================================================================
function p = distributionCdfLocal(x, dist)
  switch dist
    case 'normal'
      p = normcdf(x, 0, 1);
    case 'exponential'
      p = 1 - exp(-max(x, 0));
    case 'extreme value'
      p = 1 - exp(-exp(x));
    case 'half normal'
      p = 2 * normcdf(max(x, 0), 0, 1) - 1;
    case 'lognormal'
      p = zeros(size(x));
      positive = x > 0;
      p(positive) = normcdf(log(x(positive)), 0, 1);
    case 'logistic'
      p = 1 ./ (1 + exp(-x));
    case 'loglogistic'
      p = zeros(size(x));
      positive = x > 0;
      p(positive) = x(positive) ./ (1 + x(positive));
    case 'rayleigh'
      p = 1 - exp(-0.5 * max(x, 0) .^ 2);
    case 'weibull'
      p = 1 - exp(-max(x, 0));
  end
end
%=============================================================================
function x = distributionInvLocal(p, dist)
  p = min(max(p, realmin), 1 - eps);
  switch dist
    case 'normal'
      x = norminv(p, 0, 1);
    case 'exponential'
      x = -log(1 - p);
    case 'extreme value'
      x = log(-log(1 - p));
    case 'half normal'
      x = norminv((p + 1) / 2, 0, 1);
    case 'lognormal'
      x = exp(norminv(p, 0, 1));
    case 'logistic'
      x = log(p ./ (1 - p));
    case 'loglogistic'
      x = p ./ (1 - p);
    case 'rayleigh'
      x = sqrt(-2 * log(1 - p));
    case 'weibull'
      x = -log(1 - p);
  end
end
%=============================================================================
function h = drawCurvesLocal(parent, curves, dist, showRef)
  if isempty(parent)
    parent = newplot();
  elseif isgraphics(parent, 'axes')
    parent = newplot(parent);
  end
  h = [];
  for k = 1:numel(curves)
    c = curves{k};
    h = [h; line(parent, c.XData, c.YData, 'Marker', '+', 'LineStyle', 'none')];
    if showRef
      h = [h; line(parent, c.ReferenceX, c.ReferenceY, 'LineStyle', '--', 'LineWidth', 1)];
    end
  end
  for k = 1:length(h)
    h(k).UserData = curves{ceil(k / (1 + double(showRef)))};
  end
  labelAxesLocal(parent, dist);
end
%=============================================================================
function labelAxesLocal(parent, dist)
  ax = parent;
  if isgraphics(parent, 'hggroup')
    ax = ancestor(parent, 'axes');
  end
  xlabel(ax, 'Data');
  ylabel(ax, 'Probability');
  title(ax, ['Probability Plot for ', displayNameLocal(dist), ' Distribution']);
  if any(strcmp(dist, {'lognormal', 'loglogistic', 'weibull'}))
    ax.XScale = 'log';
  end
  ax.YLim = [0 1];
end
%=============================================================================
function name = displayNameLocal(dist)
  switch dist
    case 'normal'
      name = 'Normal';
    case 'exponential'
      name = 'Exponential';
    case 'extreme value'
      name = 'Extreme Value';
    case 'half normal'
      name = 'Half Normal';
    case 'lognormal'
      name = 'Lognormal';
    case 'logistic'
      name = 'Logistic';
    case 'loglogistic'
      name = 'Loglogistic';
    case 'rayleigh'
      name = 'Rayleigh';
    case 'weibull'
      name = 'Weibull';
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = qqplot(varargin)
  narginchk(1, 4);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [parent, args] = parseParentLocal(args);
  [x, y, pvec] = parseInputsLocal(args);
  curves = computeCurvesLocal(x, y, pvec);
  h = drawCurvesLocal(parent, curves, isempty(y));
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [parent, args] = parseParentLocal(args)
  parent = [];
  if ~isempty(args) && isscalar(args{1}) && (isgraphics(args{1}, 'axes') || isgraphics(args{1}, 'hggroup'))
    parent = args{1};
    args = args(2:end);
  end
end
%=============================================================================
function [x, y, pvec] = parseInputsLocal(args)
  if isempty(args)
    error('Nelson:notEnoughInputs', 'Not enough input arguments.');
  end
  if length(args) > 3
    error('Nelson:tooManyInputs', 'Too many input arguments.');
  end
  x = validateDataLocal(args{1}, 'X');
  y = [];
  pvec = [];
  if length(args) >= 2
    second = args{2};
    if isnumeric(second) && isreal(second)
      if length(args) == 2 && isProbabilityVectorLocal(second)
        pvec = validatePvecLocal(second);
      else
        y = validateDataLocal(second, 'Y');
      end
    else
      error('Nelson:statistics:yRealNumericArray', '%s must be a real numeric array.', 'Y');
    end
  end
  if length(args) == 3
    pvec = validatePvecLocal(args{3});
  end
  [x, y] = alignColumnsLocal(x, y);
end
%=============================================================================
function tf = isProbabilityVectorLocal(value)
  tf = isvector(value) && ~isempty(value) && all(isfinite(double(value(:)))) ...
    && all(double(value(:)) >= 0) && all(double(value(:)) <= 100);
end
%=============================================================================
function data = validateDataLocal(data, name)
  if ~(isnumeric(data) && isreal(data) && ~issparse(data) && ~isempty(data))
    error('Nelson:statistics:mustBeRealNumeric', '%s must be a real numeric array.', name);
  end
  if ndims(data) > 2
    error('Nelson:statistics:mustBeVectorOrMatrix', '%s must be a vector or matrix.', name);
  end
  data = double(data);
  if isvector(data)
    data = data(:);
  end
end
%=============================================================================
function pvec = validatePvecLocal(pvec)
  if ~(isnumeric(pvec) && isreal(pvec) && isvector(pvec)) || isempty(pvec) ...
      || any(~isfinite(double(pvec(:)))) || any(double(pvec(:)) < 0) ...
      || any(double(pvec(:)) > 100)
    error('Nelson:statistics:pContainValuesBetween0', 'P must contain values between 0 and 100.');
  end
  pvec = double(pvec(:)) / 100;
end
%=============================================================================
function [x, y] = alignColumnsLocal(x, y)
  if isempty(y)
    return
  end
  nx = size(x, 2);
  ny = size(y, 2);
  if nx == ny
    return
  end
  if nx == 1
    x = repmat(x, 1, ny);
  elseif ny == 1
    y = repmat(y, 1, nx);
  else
    error('Nelson:statistics:xYCompatibleNumbersColumns', 'X and Y must have %s.', 'compatible numbers of columns');
  end
end
%=============================================================================
function curves = computeCurvesLocal(x, y, pvec)
  columns = size(x, 2);
  curves = cell(columns, 1);
  for k = 1:columns
    xk = cleanColumnLocal(x(:, k));
    if isempty(y)
      [xq, yq, p] = normalQuantilesLocal(xk, pvec);
      lineStats = quartileLineLocal(norminv([0.25 0.75], 0, 1), quantile(xk, [0.25 0.75]));
    else
      yk = cleanColumnLocal(y(:, k));
      [xq, yq, p] = sampleQuantilesLocal(xk, yk, pvec);
      lineStats = quartileLineLocal(quantile(xk, [0.25 0.75]), quantile(yk, [0.25 0.75]));
    end
    curves{k} = curveStructLocal(xq, yq, p, lineStats);
  end
end
%=============================================================================
function x = cleanColumnLocal(x)
  x = x(isfinite(x));
  if isempty(x)
    error('Nelson:statistics:dataFinitePerColumn', 'Data must contain at least one finite value per column.');
  end
end
%=============================================================================
function [xq, yq, p] = normalQuantilesLocal(x, pvec)
  if isempty(pvec)
    n = length(x);
    p = ((1:n)' - 0.5) / n;
    yq = sort(x);
  else
    p = pvec;
    yq = quantile(x, p);
    yq = yq(:);
  end
  xq = norminv(p, 0, 1);
end
%=============================================================================
function [xq, yq, p] = sampleQuantilesLocal(x, y, pvec)
  if isempty(pvec)
    n = min(length(x), length(y));
    p = ((1:n)' - 0.5) / n;
  else
    p = pvec;
  end
  xq = quantile(x, p);
  yq = quantile(y, p);
  xq = xq(:);
  yq = yq(:);
end
%=============================================================================
function lineStats = quartileLineLocal(xQuartiles, yQuartiles)
  xQuartiles = xQuartiles(:);
  yQuartiles = yQuartiles(:);
  dx = xQuartiles(2) - xQuartiles(1);
  if dx == 0 || isnan(dx)
    slope = 0;
  else
    slope = (yQuartiles(2) - yQuartiles(1)) / dx;
  end
  intercept = yQuartiles(1) - slope * xQuartiles(1);
  lineStats = struct('Slope', slope, 'Intercept', intercept, ...
    'XQuartiles', xQuartiles, 'YQuartiles', yQuartiles);
end
%=============================================================================
function curve = curveStructLocal(xq, yq, p, lineStats)
  finiteX = xq(isfinite(xq));
  if isempty(finiteX)
    referenceX = lineStats.XQuartiles(:).';
  else
    referenceX = [min(finiteX), max(finiteX)];
  end
  referenceY = lineStats.Intercept + lineStats.Slope * referenceX;
  curve = struct('XData', xq(:), 'YData', yq(:), 'P', p(:), ...
    'QuartileX', lineStats.XQuartiles(:), 'QuartileY', lineStats.YQuartiles(:), ...
    'ReferenceX', referenceX(:), 'ReferenceY', referenceY(:), ...
    'Slope', lineStats.Slope, 'Intercept', lineStats.Intercept);
end
%=============================================================================
function h = drawCurvesLocal(parent, curves, useNormalLabels)
  if isempty(parent)
    parent = newplot();
  elseif isgraphics(parent, 'axes')
    parent = newplot(parent);
  end
  h = [];
  for k = 1:numel(curves)
    c = curves{k};
    h = [h; line(parent, c.XData, c.YData, 'Marker', '+', 'LineStyle', 'none')];
    h = [h; line(parent, c.QuartileX, c.QuartileY, 'LineStyle', '-', 'LineWidth', 1)];
    h = [h; line(parent, c.ReferenceX, c.ReferenceY, 'LineStyle', '--', 'LineWidth', 1)];
  end
  for k = 1:length(h)
    h(k).UserData = curves{ceil(k / 3)};
  end
  labelAxesLocal(parent, useNormalLabels);
end
%=============================================================================
function labelAxesLocal(parent, useNormalLabels)
  ax = parent;
  if isgraphics(parent, 'hggroup')
    ax = ancestor(parent, 'axes');
  end
  if useNormalLabels
    xlabel(ax, 'Standard Normal Quantiles');
    ylabel(ax, 'Quantiles of Input Sample');
    title(ax, 'QQ Plot of Sample Data versus Standard Normal');
  else
    xlabel(ax, 'X Quantiles');
    ylabel(ax, 'Y Quantiles');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = randsample(varargin)
  narginchk(2, 4);
  nargoutchk(0, 1);

  population = varargin{1};
  k = positiveInteger(varargin{2}, sprintf(_('%s must be a positive integer scalar.'), 'K'));
  replacement = false;
  weights = [];
  if nargin >= 3
    replacement = logicalScalar(varargin{3}, 'Replacement');
  end
  if nargin == 4
    if ~replacement
      error('Nelson:statistics:weightedSamplingRequiresReplacement', 'Weighted sampling requires replacement.');
    end
    weights = varargin{4};
  end

  values = populationValues(population);
  n = length(values);
  if ~replacement && k > n
    error('Nelson:statistics:kExceedPopulationSizeWithout', 'K must not exceed the population size without replacement.');
  end
  idx = sampleIndices(n, k, replacement, weights);
  y = values(idx);
  y = y(:);
end
%=============================================================================
function values = populationValues(population)
  if isscalar(population) && isnumeric(population)
    n = positiveInteger(population, sprintf(_('%s must be a positive integer scalar.'), 'N'));
    values = (1:n)';
  else
    if isempty(population)
      error('Nelson:statistics:populationEmpty', 'Population must not be empty.');
    end
    values = population(:);
  end
end
%=============================================================================
function idx = sampleIndices(n, k, replacement, weights)
  if isempty(weights)
    if replacement
      idx = randi(n, k, 1);
    else
      [~, order] = sort(rand(n, 1));
      idx = order(1:k);
    end
    return
  end
  w = weights(:);
  if length(w) ~= n || any(w < 0) || sum(w) <= 0
    error('Nelson:statistics:weightsOneValuePerPopulation', 'Weights must be a nonnegative vector with one value per population element.');
  end
  cdf = cumsum(w ./ sum(w));
  u = rand(k, 1);
  idx = ones(k, 1);
  for i = 1:k
    idx(i) = find(u(i) <= cdf, 1);
  end
end
%=============================================================================
function value = positiveInteger(value, message)
  if ~isscalar(value) || value <= 0 || floor(value) ~= value
    error('Nelson:statistics:mustBePositiveInteger', message);
  end
end
%=============================================================================
function value = logicalScalar(value, label)
  if ~isscalar(value) || ~(isnumeric(value) || islogical(value)) || (value ~= 0 && value ~= 1)
    error('Nelson:statistics:mustBeScalarLogicalValue', '%s must be a scalar logical value.', label);
  end
  value = logical(value);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = range(x, dim)
  narginchk(1, 2);
  nargoutchk(0, 1);
  if ~isnumeric(x) && ~islogical(x)
    error('Nelson:validators:mustBeNumericOrLogical', '%s must be numeric or logical.', 'Input');
  end
  if nargin < 2
    y = max(x) - min(x);
  else
    y = max(x, [], dim) - min(x, [], dim);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [p, h, stats] = ranksum(x, y, varargin)
  narginchk(2, Inf);
  nargoutchk(0, 3);
  opts = parseOptionsLocal(convertStringToCharArgs(varargin));
  [x, y] = validateSamplesLocal(x, y);
  [rankSum, ustat, tieSum, hasTies] = rankSumLocal(x, y);
  method = selectMethodLocal(opts.Method, length(x), length(y), hasTies);
  if strcmp(method, 'exact')
    p = exactPValueLocal(rankSum, length(x), length(y), opts.Tail);
    zval = [];
  else
    [p, zval] = approximatePValueLocal(ustat, length(x), length(y), tieSum, opts.Tail);
  end
  h = p <= opts.Alpha;
  stats = struct('ranksum', rankSum);
  if ~isempty(zval)
    stats.zval = zval;
  end
end
%=============================================================================
function opts = parseOptionsLocal(args)
  opts = struct('Alpha', 0.05, 'Tail', 'both', 'Method', 'auto');
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  for k = 1:2:length(args)
    if ~isTextScalarLocal(args{k})
      error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Name');
    end
    name = lower(char(args{k}));
    switch name
      case 'alpha'
        opts.Alpha = parseAlphaLocal(args{k + 1});
      case 'tail'
        opts.Tail = parseChoiceLocal(args{k + 1}, {'both', 'right', 'left'}, 'TAIL');
      case 'method'
        opts.Method = parseChoiceLocal(args{k + 1}, {'auto', 'exact', 'approximate'}, 'METHOD');
      otherwise
        error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
    end
  end
end
%=============================================================================
function alpha = parseAlphaLocal(value)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) ...
      && value > 0 && value < 1)
    error('Nelson:statistics:alphaOutOfRange', '%s must be a scalar in the range (0,1).', 'ALPHA');
  end
  alpha = double(value);
end
%=============================================================================
function value = parseChoiceLocal(value, choices, name)
  if ~isTextScalarLocal(value)
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', name);
  end
  text = lower(char(value));
  matches = choices(startsWith(choices, text));
  if length(matches) ~= 1
    error('Nelson:statistics:invalidValue:valueHasUnsupportedValue', '%s has an unsupported value.', name);
  end
  value = matches{1};
end
%=============================================================================
function [x, y] = validateSamplesLocal(x, y)
  if ~(isnumeric(x) && isreal(x) && ~issparse(x) && isvector(x))
    error('Nelson:statistics:xRealNumericVector', '%s must be a real numeric vector.', 'X');
  end
  if ~(isnumeric(y) && isreal(y) && ~issparse(y) && isvector(y))
    error('Nelson:statistics:yRealNumericVector', '%s must be a real numeric vector.', 'Y');
  end
  x = double(x(:));
  y = double(y(:));
  x = x(~isnan(x));
  y = y(~isnan(y));
  if isempty(x) || isempty(y)
    error('Nelson:statistics:xYContainLeastOne', '%s must contain at least one non-NaN observation.', 'X and Y');
  end
end
%=============================================================================
function [rankSum, ustat, tieSum, hasTies] = rankSumLocal(x, y)
  n1 = length(x);
  values = [x; y];
  labels = [ones(n1, 1); zeros(length(y), 1)];
  [ranks, tieSum] = tiedRanksLocal(values);
  rankSum = sum(ranks(labels == 1));
  ustat = rankSum - n1 * (n1 + 1) / 2;
  hasTies = tieSum ~= 0;
end
%=============================================================================
function method = selectMethodLocal(method, n1, n2, hasTies)
  if strcmp(method, 'exact') && hasTies
    error('Nelson:statistics:exactMethodSupportedTiesPresent', 'Exact method is not supported when ties are present.');
  end
  if strcmp(method, 'auto')
    if ~hasTies && n1 + n2 <= 20
      method = 'exact';
    else
      method = 'approximate';
    end
  end
end
%=============================================================================
function p = exactPValueLocal(rankSum, n1, n2, tail)
  counts = exactRankSumCountsLocal(n1, n2);
  minRankSum = n1 * (n1 + 1) / 2;
  idx = round(rankSum - minRankSum) + 1;
  total = sum(counts);
  switch tail
    case 'left'
      p = sum(counts(1:idx)) / total;
    case 'right'
      p = sum(counts(idx:end)) / total;
    otherwise
      lo = sum(counts(1:idx)) / total;
      hi = sum(counts(idx:end)) / total;
      p = min(1, 2 * min(lo, hi));
  end
end
%=============================================================================
function counts = exactRankSumCountsLocal(n1, n2)
  maxExtra = n1 * n2;
  states = zeros(n1 + 1, maxExtra + 1);
  states(1, 1) = 1;
  for r = 1:(n1 + n2)
    upper = min(r, n1);
    for k = upper:-1:1
      offset = r - k;
      if offset >= 0
        states(k + 1, offset + 1:end) = states(k + 1, offset + 1:end) ...
          + states(k, 1:end - offset);
      end
    end
  end
  counts = states(n1 + 1, :);
end
%=============================================================================
function [p, zval] = approximatePValueLocal(ustat, n1, n2, tieSum, tail)
  n = n1 + n2;
  mu = n1 * n2 / 2;
  variance = n1 * n2 / 12 * ((n + 1) - tieSum / (n * (n - 1)));
  sigma = sqrt(variance);
  if sigma == 0
    zval = 0;
    p = 1;
    return
  end
  switch tail
    case 'left'
      zval = (ustat - mu + 0.5) / sigma;
      p = normcdf(zval, 0, 1);
    case 'right'
      zval = (ustat - mu - 0.5) / sigma;
      p = normcdf(zval, 0, 1, 'upper');
    otherwise
      zval = (abs(ustat - mu) - 0.5) / sigma;
      p = 2 * normcdf(-abs(zval), 0, 1);
  end
end
%=============================================================================
function [ranks, tieSum] = tiedRanksLocal(values)
  [sortedValues, order] = sort(values(:));
  n = length(sortedValues);
  ranks = zeros(n, 1);
  tieSum = 0;
  starts = [1; find(diff(sortedValues) ~= 0) + 1];
  stops = [starts(2:end) - 1; n];
  for k = 1:length(starts)
    rows = starts(k):stops(k);
    ranks(order(rows)) = (starts(k) + stops(k)) / 2;
    tieLength = stops(k) - starts(k) + 1;
    tieSum = tieSum + tieLength ^ 3 - tieLength;
  end
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [b, bint, r, rint, stats] = regress(y, X, alpha)
  narginchk(2, 3);
  nargoutchk(0, 5);
  if nargin < 3
    alpha = 0.05;
  end
  [y, X, alpha] = validateInputsLocal(y, X, alpha);
  keep = ~isnan(y) & all(~isnan(X), 2);
  yfit = y(keep);
  Xfit = X(keep, :);
  [b, bintFit, rFit, rintFit, stats] = regressFitLocal(yfit, Xfit, alpha);
  r = NaN(size(y));
  rint = NaN(length(y), 2);
  r(keep) = rFit;
  rint(keep, :) = rintFit;
  bint = bintFit;
end
%=============================================================================
function [y, X, alpha] = validateInputsLocal(y, X, alpha)
  if ~(isnumeric(y) && isreal(y) && isvector(y) && ~issparse(y))
    error('Nelson:statistics:yRealNumericVector', '%s must be a real numeric vector.', 'Y');
  end
  if ~(isnumeric(X) && isreal(X) && ismatrix(X) && ~issparse(X))
    error('Nelson:statistics:xRealNumericMatrix', '%s must be a real numeric matrix.', 'X');
  end
  y = double(y(:));
  X = double(X);
  if size(X, 1) ~= length(y)
    error('Nelson:statistics:xYSameNumberRows', '%s must have the same number of rows.', 'Y and X');
  end
  if ~(isnumeric(alpha) && isreal(alpha) && isscalar(alpha) && isfinite(alpha) ...
      && alpha > 0 && alpha < 1)
    error('Nelson:statistics:alphaOutOfRange', '%s must be a scalar in the range (0,1).', 'ALPHA');
  end
  alpha = double(alpha);
end
%=============================================================================
function [b, bint, r, rint, stats] = regressFitLocal(y, X, alpha)
  n = length(y);
  p = size(X, 2);
  if n == 0 || p == 0
    b = NaN(p, 1);
    bint = NaN(p, 2);
    r = NaN(n, 1);
    rint = NaN(n, 2);
    stats = NaN(1, 4);
    return
  end
  b = X \ y;
  r = y - X * b;
  df = n - rank(X);
  sse = sum(r .^ 2);
  if df <= 0
    mse = NaN;
  else
    mse = sse / df;
  end
  XtXinv = pinv(X' * X);
  bint = coefficientIntervalsLocal(b, XtXinv, mse, df, alpha);
  rint = residualIntervalsLocal(r, X, XtXinv, mse, df, alpha);
  stats = modelStatsLocal(y, r, p, df, mse);
end
%=============================================================================
function bint = coefficientIntervalsLocal(b, XtXinv, mse, df, alpha)
  if df <= 0 || isnan(mse)
    bint = NaN(length(b), 2);
    return
  end
  se = sqrt(mse * diag(XtXinv));
  delta = tinv(1 - alpha / 2, df) * se;
  bint = [b - delta, b + delta];
end
%=============================================================================
function rint = residualIntervalsLocal(r, X, XtXinv, mse, df, alpha)
  if df <= 0 || isnan(mse)
    rint = NaN(length(r), 2);
    return
  end
  h = diag(X * XtXinv * X');
  se = sqrt(max(0, mse * (1 - h)));
  delta = tinv(1 - alpha / 2, df) * se;
  rint = [r - delta, r + delta];
end
%=============================================================================
function stats = modelStatsLocal(y, r, p, df, mse)
  sse = sum(r .^ 2);
  sst = sum((y - mean(y)) .^ 2);
  if sst == 0
    r2 = NaN;
  else
    r2 = 1 - sse / sst;
  end
  regressionDf = p - 1;
  if regressionDf <= 0 || df <= 0 || isnan(mse)
    fstat = NaN;
    pvalue = NaN;
  else
    fstat = ((sst - sse) / regressionDf) / mse;
    pvalue = 1 - fcdf(fstat, regressionDf, df);
  end
  stats = [r2, fstat, pvalue, mse];
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function stats = regstats(y, X, modelspec, StatNames)
  narginchk(2, 4);
  nargoutchk(0, 1);
  if nargin < 3 || isempty(modelspec)
    modelspec = 'linear';
  end
  if nargin < 4 || isempty(StatNames)
    StatNames = 'all';
  end
  [y, X] = validateInputsLocal(y, X);
  keep = ~isnan(y) & all(~isnan(X), 2);
  D = designMatrixLocal(X(keep, :), modelspec);
  fit = fitLocal(y(keep), D);
  names = parseStatNamesLocal(StatNames);
  stats = collectStatsLocal(fit, names);
end
%=============================================================================
function [y, X] = validateInputsLocal(y, X)
  if ~(isnumeric(y) && isreal(y) && isvector(y) && ~issparse(y))
    error('Nelson:statistics:yRealNumericVector', '%s must be a real numeric vector.', 'Y');
  end
  if ~(isnumeric(X) && isreal(X) && ismatrix(X) && ~issparse(X))
    error('Nelson:statistics:xRealNumericMatrix', '%s must be a real numeric matrix.', 'X');
  end
  y = double(y(:));
  X = double(X);
  if size(X, 1) ~= length(y)
    error('Nelson:statistics:xYSameNumberRows', '%s must have the same number of rows.', 'Y and X');
  end
end
%=============================================================================
function D = designMatrixLocal(X, modelspec)
  p = size(X, 2);
  terms = modelTermsLocal(p, modelspec);
  D = ones(size(X, 1), 1);
  for k = 1:size(terms, 1)
    col = ones(size(X, 1), 1);
    for j = 1:p
      if terms(k, j) ~= 0
        col = col .* (X(:, j) .^ terms(k, j));
      end
    end
    D = [D col];
  end
end
%=============================================================================
function terms = modelTermsLocal(p, modelspec)
  if ischar(modelspec) || (isstring(modelspec) && isscalar(modelspec))
    switch lower(char(modelspec))
      case {'linear', 'additive'}
        terms = eye(p);
      case {'interactions', 'interaction'}
        terms = [eye(p); pairTermsLocal(p)];
      case 'quadratic'
        terms = [eye(p); pairTermsLocal(p); 2 * eye(p)];
      case 'purequadratic'
        terms = [eye(p); 2 * eye(p)];
      otherwise
        error('Nelson:statistics:invalidModelSpecification', 'Invalid model specification.');
    end
  elseif isnumeric(modelspec)
    if isscalar(modelspec)
      terms = degreeTermsLocal(p, positiveIntegerLocal(modelspec));
    else
      if size(modelspec, 2) ~= p
        error('Nelson:statistics:modelMatrixOneColumnPredictor', 'Model matrix must have one column per %s.', 'predictor');
      end
      terms = double(modelspec);
      terms(all(terms == 0, 2), :) = [];
    end
  else
    error('Nelson:statistics:invalidModelSpecification', 'Invalid model specification.');
  end
end
%=============================================================================
function terms = degreeTermsLocal(p, degree)
  terms = [];
  for total = 1:degree
    terms = [terms; compositionsLocal(p, total)];
  end
end
%=============================================================================
function terms = compositionsLocal(p, total)
  if p == 1
    terms = total;
    return
  end
  terms = [];
  for v = 0:total
    rest = compositionsLocal(p - 1, total - v);
    terms = [terms; [v * ones(size(rest, 1), 1) rest]];
  end
end
%=============================================================================
function terms = pairTermsLocal(p)
  terms = zeros(0, p);
  for i = 1:p
    for j = i + 1:p
      row = zeros(1, p);
      row(i) = 1;
      row(j) = 1;
      terms = [terms; row];
    end
  end
end
%=============================================================================
function value = positiveIntegerLocal(value)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) ...
      && value > 0 && value == fix(value))
    error('Nelson:statistics:modelDegreePositiveIntegerScalar', '%s must be a positive integer scalar.', 'Model degree');
  end
  value = double(value);
end
%=============================================================================
function names = parseStatNamesLocal(StatNames)
  allNames = {'Q', 'R', 'beta', 'covb', 'yhat', 'r', 'mse', 'rsquare', ...
    'adjrsquare', 'leverage', 'hatmat', 's2_i', 'beta_i', 'standres', ...
    'studres', 'dfbetas', 'dffit', 'dffits', 'covratio', 'cookd', ...
    'tstat', 'fstat', 'dwstat'};
  if ischar(StatNames) || (isstring(StatNames) && isscalar(StatNames))
    requested = cellstr(char(StatNames));
  elseif isstring(StatNames)
    requested = cell(1, numel(StatNames));
    for k = 1:numel(StatNames)
      requested{k} = char(StatNames(k));
    end
  elseif iscell(StatNames)
    requested = StatNames(:).';
  else
    error('Nelson:statistics:statNamesCharacterVectorStringArray', 'StatNames must be a character vector, string array, or cell array.');
  end
  if any(strcmpi(requested, 'all'))
    names = allNames;
    return
  end
  names = cell(1, length(requested));
  for k = 1:length(requested)
    if ~(ischar(requested{k}) || (isstring(requested{k}) && isscalar(requested{k})))
      error('Nelson:statistics:statNamesEntriesTextScalars', 'StatNames entries must be text scalars.');
    end
    text = char(requested{k});
    idx = find(strcmp(text, allNames), 1);
    if isempty(idx)
      idx = find(strcmpi(text, allNames), 1);
    end
    if isempty(idx)
      error('Nelson:statistics:invalidStatisticName', 'Invalid statistic name.');
    end
    names{k} = allNames{idx};
  end
end
%=============================================================================
function fit = fitLocal(y, D)
  n = length(y);
  p = size(D, 2);
  fit = struct();
  fit.D = D;
  fit.Q = [];
  fit.R = [];
  if n == 0
    fit.beta = NaN(p, 1);
    fit.yhat = zeros(0, 1);
    fit.r = zeros(0, 1);
    fit.rank = 0;
  else
    fit.beta = D \ y;
    fit.yhat = D * fit.beta;
    fit.r = y - fit.yhat;
    fit.rank = rank(D);
  end
  fit.dfe = n - fit.rank;
  fit.sse = sum(fit.r .^ 2);
  fit.sst = sum((y - mean(y)) .^ 2);
  if fit.dfe > 0
    fit.mse = fit.sse / fit.dfe;
  else
    fit.mse = NaN;
  end
  fit.XtXinv = pinv(D' * D);
  fit.covb = fit.mse * fit.XtXinv;
  fit.H = [];
  fit.leverage = [];
  fit.n = n;
  fit.p = p;
end
%=============================================================================
function stats = collectStatsLocal(fit, names)
  stats = struct();
  stats.source = 'regstats';
  needsInfluence = any(ismember(names, {'leverage', 'hatmat', 's2_i', 'beta_i', ...
    'standres', 'studres', 'dfbetas', 'dffit', 'dffits', 'covratio', 'cookd'}));
  if any(ismember(names, {'Q', 'R'}))
    [fit.Q, fit.R] = qrLocal(fit.D);
  end
  if needsInfluence
    fit = influenceLocal(fit);
  end
  for k = 1:length(names)
    stats.(names{k}) = statValueLocal(fit, names{k});
  end
end
%=============================================================================
function value = statValueLocal(fit, name)
  switch name
    case {'Q', 'R', 'beta', 'covb', 'yhat', 'r', 'mse', 'leverage', 'hatmat'}
      value = fit.(name);
    case 'rsquare'
      value = rsquareLocal(fit);
    case 'adjrsquare'
      value = adjrsquareLocal(fit);
    case {'s2_i', 'beta_i', 'standres', 'studres', 'dfbetas', 'dffit', ...
        'dffits', 'covratio', 'cookd'}
      value = fit.(name);
    case 'tstat'
      value = tstatLocal(fit);
    case 'fstat'
      value = fstatLocal(fit);
    case 'dwstat'
      value = dwstatLocal(fit);
  end
end
%=============================================================================
function fit = influenceLocal(fit)
  fit.H = fit.D * fit.XtXinv * fit.D';
  fit.hatmat = fit.H;
  fit.leverage = diag(fit.H);
  oneMinusH = max(1 - fit.leverage, eps);
  if fit.dfe > 1
    fit.s2_i = (fit.sse - (fit.r .^ 2) ./ oneMinusH) ./ (fit.dfe - 1);
  else
    fit.s2_i = NaN(size(fit.r));
  end
  fit.standres = fit.r ./ sqrt(fit.mse .* oneMinusH);
  fit.studres = fit.r ./ sqrt(fit.s2_i .* oneMinusH);
  delta = fit.XtXinv * (fit.D' .* repmat((fit.r ./ oneMinusH).', fit.p, 1));
  fit.beta_i = repmat(fit.beta, 1, fit.n) - delta;
  scale = sqrt(diag(fit.XtXinv));
  fit.dfbetas = delta ./ (scale * sqrt(fit.s2_i).');
  fit.dffit = fit.leverage .* fit.r ./ oneMinusH;
  fit.dffits = fit.studres .* sqrt(fit.leverage ./ oneMinusH);
  fit.covratio = ((fit.s2_i ./ fit.mse) .^ fit.p) ./ oneMinusH;
  fit.cookd = (fit.r .^ 2 ./ (fit.p .* fit.mse)) .* fit.leverage ./ (oneMinusH .^ 2);
end
%=============================================================================
function [Q, R] = qrLocal(A)
  [n, p] = size(A);
  Q = zeros(n, p);
  R = zeros(p, p);
  for j = 1:p
    v = A(:, j);
    for i = 1:j - 1
      R(i, j) = Q(:, i)' * v;
      v = v - R(i, j) * Q(:, i);
    end
    R(j, j) = norm(v);
    if R(j, j) > eps
      Q(:, j) = v / R(j, j);
    end
  end
end
%=============================================================================
function value = rsquareLocal(fit)
  if fit.sst == 0
    value = NaN;
  else
    value = 1 - fit.sse / fit.sst;
  end
end
%=============================================================================
function value = adjrsquareLocal(fit)
  rsq = rsquareLocal(fit);
  if fit.dfe <= 0 || fit.n <= 1 || isnan(rsq)
    value = NaN;
  else
    value = 1 - (1 - rsq) * (fit.n - 1) / fit.dfe;
  end
end
%=============================================================================
function value = tstatLocal(fit)
  se = sqrt(diag(fit.covb));
  t = fit.beta ./ se;
  if fit.dfe > 0
    pval = 2 * (1 - tcdf(abs(t), fit.dfe));
  else
    pval = NaN(size(t));
  end
  value = struct('beta', fit.beta, 'se', se, 't', t, 'pval', pval);
end
%=============================================================================
function value = fstatLocal(fit)
  dfr = max(fit.rank - 1, 0);
  if dfr > 0 && fit.dfe > 0 && fit.sst ~= 0
    f = ((fit.sst - fit.sse) / dfr) / fit.mse;
    pval = fcdf(f, dfr, fit.dfe, 'upper');
  else
    f = NaN;
    pval = NaN;
  end
  value = struct('f', f, 'pval', pval, 'dfe', fit.dfe, 'dfr', dfr);
end
%=============================================================================
function value = dwstatLocal(fit)
  if fit.sse == 0
    dw = NaN;
  else
    dw = sum(diff(fit.r) .^ 2) / fit.sse;
  end
  value = struct('dw', dw, 'pval', NaN);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [idx, weights] = relieff(X, y, k, varargin)
  narginchk(3, Inf);
  nargoutchk(0, 2);
  [X, y, k, opts] = parseInputsLocal(X, y, k, convertStringToCharArgs(varargin));
  featureDiff = featureDifferencesLocal(X, opts.CategoricalX);
  if strcmp(opts.Method, 'classification')
    weights = classificationWeightsLocal(featureDiff, y, k, opts);
  else
    weights = regressionWeightsLocal(featureDiff, y, k, opts);
  end
  [~, idx] = sort(weights, 'descend');
end
%=============================================================================
function [X, y, k, opts] = parseInputsLocal(X, y, k, args)
  if ~(isnumeric(X) && isreal(X) && ~issparse(X) && ndims(X) == 2)
    error('Nelson:statistics:xRealNumericMatrix', '%s must be a real numeric matrix.', 'X');
  end
  X = double(X);
  if isempty(X) || any(~isfinite(X(:)))
    error('Nelson:statistics:xMustBeFinite', '%s must contain finite values.', 'X');
  end
  if ~(isvector(y) && length(y) == size(X, 1))
    error('Nelson:statistics:yVectorOneElementObservation', 'y must be a vector with one element per observation.');
  end
  if ~(isnumeric(k) && isreal(k) && isscalar(k) && isfinite(k) ...
      && floor(k) == k && k > 0)
    error('Nelson:statistics:kPositiveIntegerScalar', '%s must be a positive integer scalar.', 'k');
  end
  k = double(k);
  opts = defaultOptionsLocal(X, y);
  opts = parseNameValuesLocal(opts, args, X, y);
  opts.Updates = parseUpdatesLocal(opts.Updates, size(X, 1));
  opts.CategoricalX = parseCategoricalXLocal(opts.CategoricalX, size(X, 2));
  opts.Prior = parsePriorLocal(opts.Prior, y, opts.Method);
  opts.Sigma = parseSigmaLocal(opts.Sigma);
end
%=============================================================================
function opts = defaultOptionsLocal(X, y)
  method = 'regression';
  if ~(isnumeric(y) || islogical(y))
    method = 'classification';
  end
  opts = struct('Method', method, 'Prior', 'empirical', ...
    'Updates', size(X, 1), 'CategoricalX', [], 'Sigma', []);
end
%=============================================================================
function opts = parseNameValuesLocal(opts, args, X, y)
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  for i = 1:2:length(args)
    if ~isTextScalarLocal(args{i})
      error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Name');
    end
    name = lower(char(args{i}));
    switch name
      case 'method'
        opts.Method = parseMethodLocal(args{i + 1});
      case 'prior'
        opts.Prior = args{i + 1};
      case 'updates'
        opts.Updates = args{i + 1};
      case 'categoricalx'
        opts.CategoricalX = args{i + 1};
      case 'sigma'
        opts.Sigma = args{i + 1};
      otherwise
        error('Nelson:statistics:unknownOption', 'Unknown option.');
    end
  end
  if strcmp(opts.Method, 'regression') && ~(isnumeric(y) || islogical(y))
    error('Nelson:statistics:regressionMethodRequiresNumericResponse', 'Regression method requires a numeric response.');
  end
end
%=============================================================================
function method = parseMethodLocal(value)
  if ~isTextScalarLocal(value)
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Method');
  end
  value = lower(char(value));
  choices = {'classification', 'regression'};
  matches = choices(strncmp(choices, value, length(value)));
  if isempty(matches)
    error('Nelson:statistics:invalidMethodValue', 'Invalid %s value.', 'Method');
  end
  if length(matches) > 1
    error('Nelson:statistics:ambiguousValue', 'Ambiguous %s value.', 'Method');
  end
  method = matches{1};
end
%=============================================================================
function updates = parseUpdatesLocal(updates, nobs)
  if isempty(updates)
    updates = nobs;
    return
  end
  if isnumeric(updates) && isreal(updates) && isscalar(updates) ...
      && isfinite(updates) && floor(updates) == updates && updates > 0
    updates = 1:min(double(updates), nobs);
  elseif isnumeric(updates) && isreal(updates) && isvector(updates)
    updates = double(updates(:))';
    if any(~isfinite(updates)) || any(floor(updates) ~= updates) ...
        || any(updates < 1) || any(updates > nobs)
      error('Nelson:statistics:updatesContainValidObservationIndices', 'Updates must contain valid observation indices.');
    end
  else
    error('Nelson:statistics:updatesPositiveIntegerScalarVector', 'Updates must be a positive integer scalar or vector of indices.');
  end
end
%=============================================================================
function categorical = parseCategoricalXLocal(value, nvars)
  categorical = false(1, nvars);
  if isempty(value)
    return
  end
  if isTextScalarLocal(value)
    switch lower(char(value))
      case 'on'
        categorical(:) = true;
      case 'off'
        categorical(:) = false;
      otherwise
        error('Nelson:statistics:categoricalPredictorsInvalidValue', '%s has an invalid value.', 'CategoricalX');
    end
  elseif islogical(value) && isvector(value)
    if length(value) ~= nvars
      error('Nelson:statistics:categoricalPredictorsMatchNumberPredictors', '%s must match the number of predictors.', 'CategoricalX');
    end
    categorical = value(:)' ~= 0;
  elseif isnumeric(value) && isreal(value) && isvector(value)
    indices = double(value(:))';
    if any(~isfinite(indices)) || any(floor(indices) ~= indices) ...
        || any(indices < 1) || any(indices > nvars)
      error('Nelson:statistics:categoricalPredictorsContainsInvalidPredictorIndices', '%s contains invalid predictor indices.', 'CategoricalX');
    end
    categorical(indices) = true;
  else
    error('Nelson:statistics:categoricalPredictorsInvalidValue', '%s has an invalid value.', 'CategoricalX');
  end
end
%=============================================================================
function prior = parsePriorLocal(prior, y, method)
  if strcmp(method, 'regression')
    prior = [];
    return
  end
  [~, classes] = classIndicesLocal(y);
  nclasses = length(classes);
  if isTextScalarLocal(prior)
    value = lower(char(prior));
    if strcmp(value, 'empirical')
      counts = zeros(1, nclasses);
      labels = labelsLocal(y);
      for c = 1:nclasses
        counts(c) = sum(labels == classes(c));
      end
      prior = counts / sum(counts);
    elseif strcmp(value, 'uniform')
      prior = ones(1, nclasses) / nclasses;
    else
      error('Nelson:statistics:priorInvalidValue', '%s has an invalid value.', 'Prior');
    end
  elseif isnumeric(prior) && isreal(prior) && isvector(prior) && length(prior) == nclasses
    prior = double(prior(:))';
    if any(~isfinite(prior)) || any(prior < 0) || sum(prior) <= 0
      error('Nelson:statistics:priorContainNonnegativeFiniteValues', '%s must contain nonnegative finite values with positive sum.', 'Prior');
    end
    prior = prior / sum(prior);
  else
    error('Nelson:statistics:priorInvalidValue', '%s has an invalid value.', 'Prior');
  end
end
%=============================================================================
function sigma = parseSigmaLocal(sigma)
  if isempty(sigma)
    return
  end
  if ~(isnumeric(sigma) && isreal(sigma) && isscalar(sigma) && isfinite(sigma) && sigma > 0)
    error('Nelson:statistics:sigmaPositiveScalar', '%s must be a positive scalar.', 'Sigma');
  end
  sigma = double(sigma);
end
%=============================================================================
function featureDiff = featureDifferencesLocal(X, categorical)
  nobs = size(X, 1);
  nvars = size(X, 2);
  featureDiff = zeros(nobs, nobs, nvars);
  ranges = max(X, [], 1) - min(X, [], 1);
  ranges(ranges == 0) = 1;
  for j = 1:nvars
    values = X(:, j);
    if categorical(j)
      featureDiff(:, :, j) = double(values ~= values');
    else
      featureDiff(:, :, j) = abs(values - values') / ranges(j);
    end
  end
end
%=============================================================================
function weights = classificationWeightsLocal(featureDiff, y, k, opts)
  labels = labelsLocal(y);
  [classLabels, classes] = classIndicesLocal(y);
  nobs = length(labels);
  nvars = size(featureDiff, 3);
  weights = zeros(1, nvars);
  distances = predictorDistancesLocal(featureDiff);
  updates = opts.Updates;
  for u = 1:length(updates)
    i = updates(u);
    own = labels(i);
    hit = nearestLocal(distances(i, :), find(labels == own & (1:nobs)' ~= i), k);
    weights = weights - meanDiffLocal(featureDiff, i, hit) / length(updates);
    ownClass = find(classes == own);
    missScale = 1 - opts.Prior(ownClass);
    for c = 1:length(classes)
      if classes(c) == own
        continue
      end
      miss = nearestLocal(distances(i, :), find(labels == classes(c)), k);
      if ~isempty(miss) && missScale > 0
        factor = opts.Prior(c) / missScale;
        weights = weights + factor * meanDiffLocal(featureDiff, i, miss) / length(updates);
      end
    end
  end
end
%=============================================================================
function weights = regressionWeightsLocal(featureDiff, y, k, opts)
  y = double(y(:));
  nobs = length(y);
  nvars = size(featureDiff, 3);
  weights = zeros(1, nvars);
  distances = predictorDistancesLocal(featureDiff);
  responseRange = max(y) - min(y);
  if responseRange == 0
    return
  end
  updates = opts.Updates;
  sigma = opts.Sigma;
  if isempty(sigma)
    sigma = median(distances(distances > 0));
    if isempty(sigma) || sigma <= 0
      sigma = 1;
    end
  end
  for u = 1:length(updates)
    i = updates(u);
    neighbors = nearestLocal(distances(i, :), setdiff(1:nobs, i), k);
    if isempty(neighbors)
      continue
    end
    responseDiff = abs(y(i) - y(neighbors)) / responseRange;
    kernel = exp(-distances(i, neighbors) .^ 2 / (2 * sigma ^ 2));
    kernel = kernel(:)' / max(sum(kernel), realmin);
    for j = 1:nvars
      fd = featureDiff(i, neighbors, j);
      weights(j) = weights(j) + sum(kernel .* responseDiff(:)' .* fd(:)') / length(updates);
      weights(j) = weights(j) - sum(kernel .* (1 - responseDiff(:)') .* fd(:)') / length(updates);
    end
  end
end
%=============================================================================
function d = predictorDistancesLocal(featureDiff)
  d = sqrt(sum(featureDiff .^ 2, 3));
end
%=============================================================================
function neighbors = nearestLocal(distances, candidates, k)
  if isempty(candidates)
    neighbors = [];
    return
  end
  [~, order] = sort(distances(candidates), 'ascend');
  count = min(k, length(order));
  neighbors = candidates(order(1:count));
end
%=============================================================================
function d = meanDiffLocal(featureDiff, i, neighbors)
  nvars = size(featureDiff, 3);
  if isempty(neighbors)
    d = zeros(1, nvars);
    return
  end
  d = zeros(1, nvars);
  for j = 1:nvars
    values = featureDiff(i, neighbors, j);
    d(j) = mean(values(:));
  end
end
%=============================================================================
function labels = labelsLocal(y)
  if isnumeric(y) || islogical(y)
    [~, ~, labels] = unique(y(:));
  elseif iscell(y)
    [~, ~, labels] = unique(y(:));
  else
    [~, ~, labels] = unique(cellstr(y));
  end
  labels = double(labels(:));
end
%=============================================================================
function [classLabels, classes] = classIndicesLocal(y)
  classLabels = labelsLocal(y);
  classes = unique(classLabels);
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || isStringScalar(value);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function B = ridge(y, X, k, scaled)
  narginchk(3, 4);
  nargoutchk(0, 1);
  if nargin < 4 || isempty(scaled)
    scaled = 1;
  end
  [y, X, k, scaled] = validateInputsLocal(y, X, k, scaled);
  keep = ~isnan(y) & all(~isnan(X), 2);
  B = ridgeFitLocal(y(keep), X(keep, :), k, scaled);
end
%=============================================================================
function [y, X, k, scaled] = validateInputsLocal(y, X, k, scaled)
  if ~(isnumeric(y) && isreal(y) && isvector(y) && ~issparse(y))
    error('Nelson:statistics:yRealNumericVector', '%s must be a real numeric vector.', 'Y');
  end
  if ~(isnumeric(X) && isreal(X) && ismatrix(X) && ~issparse(X))
    error('Nelson:statistics:xRealNumericMatrix', '%s must be a real numeric matrix.', 'X');
  end
  if ~(isnumeric(k) && isreal(k) && (isvector(k) || isempty(k)) ...
      && all(isfinite(k)) && all(k >= 0))
    error('Nelson:statistics:kNonnegativeNumericVector', '%s must be a nonnegative numeric vector.', 'K');
  end
  if ~((isnumeric(scaled) || islogical(scaled)) && isreal(scaled) && isscalar(scaled) ...
      && (scaled == 0 || scaled == 1))
    error('Nelson:statistics:SCALED01', '%s must be 0 or 1.', 'SCALED');
  end
  y = double(y(:));
  X = double(X);
  if size(X, 1) ~= length(y)
    error('Nelson:statistics:xYSameNumberRows', '%s must have the same number of rows.', 'Y and X');
  end
  k = double(k(:).');
  scaled = logical(scaled);
end
%=============================================================================
function B = ridgeFitLocal(y, X, k, scaled)
  p = size(X, 2);
  if isempty(k)
    if scaled
      B = zeros(p, 0);
    else
      B = zeros(p + 1, 0);
    end
    return
  end
  if isempty(y) || p == 0
    if scaled
      B = NaN(p, length(k));
    else
      B = NaN(p + 1, length(k));
    end
    return
  end
  xmean = mean(X, 1);
  ymean = mean(y);
  xscale = std(X, 0, 1);
  xscale(xscale == 0 | isnan(xscale)) = 1;
  Z = (X - xmean) ./ xscale;
  yc = y - ymean;
  Bscaled = zeros(p, length(k));
  XtX = Z' * Z;
  Xty = Z' * yc;
  I = eye(p, p);
  for j = 1:length(k)
    Bscaled(:, j) = (XtX + k(j) * I) \ Xty;
  end
  if scaled
    B = Bscaled;
  else
    Bunscaled = Bscaled ./ xscale(:);
    intercept = ymean - xmean * Bunscaled;
    B = [intercept; Bunscaled];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [B, TFrm, TFoutlier, L, U, C] = rmoutliers(A, varargin)
  narginchk(1, Inf);
  nargoutchk(0, 6);
  if ~(isnumeric(A) && isreal(A) && ~issparse(A) && ismatrix(A))
    error('Nelson:statistics:realNumericVectorMatrix', '%s must be a real numeric vector or matrix.', 'A');
  end
  [leadingArgs, nameValueArgs, removeDim, locations] = parseInputsLocal(A, convertStringToCharArgs(varargin));
  detectionDim = detectionDimensionLocal(A);
  if isempty(locations)
    [TFoutlier, L, U, C] = isoutlier(A, leadingArgs{:}, detectionDim, nameValueArgs{:});
  else
    TFoutlier = locations;
    [L, U, C] = emptyThresholdsLocal(size(A), detectionDim);
  end
  TFrm = removedEntriesLocal(TFoutlier, removeDim);
  B = removeEntriesLocal(A, TFrm, removeDim);
end
%=============================================================================
function [leadingArgs, nameValueArgs, removeDim, locations] = parseInputsLocal(A, args)
  leadingArgs = {};
  nameValueArgs = {};
  removeDim = defaultRemoveDimensionLocal(A);
  locations = [];
  idx = 1;
  if idx <= length(args)
    value = args{idx};
    if isTextScalarLocal(value) && ~isLeadingNameValueLocal(value)
      method = parseMethodNameLocal(value);
      leadingArgs{end + 1} = value;
      idx = idx + 1;
      if any(strcmp(method, {'percentiles', 'movmedian', 'movmean'}))
        if idx > length(args)
          error('Nelson:statistics:methodArgumentIncomplete', 'Method argument is incomplete.');
        end
        leadingArgs{end + 1} = args{idx};
        idx = idx + 1;
      end
    elseif isRemoveDimLocal(value)
      removeDim = double(value);
      idx = idx + 1;
    end
  end
  if idx <= length(args) && isRemoveDimLocal(args{idx})
    removeDim = double(args{idx});
    idx = idx + 1;
  end
  if rem(length(args) - idx + 1, 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  while idx <= length(args)
    name = matchedNameLocal(args{idx});
    if strcmp(name, 'outlierlocations')
      locations = parseOutlierLocationsLocal(args{idx + 1}, size(A));
    else
      nameValueArgs{end + 1} = args{idx};
      nameValueArgs{end + 1} = args{idx + 1};
    end
    idx = idx + 2;
  end
end
%=============================================================================
function TFrm = removedEntriesLocal(TFoutlier, removeDim)
  if isvector(TFoutlier)
    TFrm = TFoutlier;
    return
  end
  if removeDim == 1
    TFrm = (double(TFoutlier) * ones(size(TFoutlier, 2), 1)) > 0;
  else
    TFrm = (ones(1, size(TFoutlier, 1)) * double(TFoutlier)) > 0;
  end
end
%=============================================================================
function B = removeEntriesLocal(A, TFrm, removeDim)
  if isvector(A)
    if size(A, 1) == 1
      B = A(:, ~TFrm);
    else
      B = A(~TFrm, :);
    end
  elseif removeDim == 1
    B = A(~TFrm, :);
  else
    B = A(:, ~TFrm);
  end
end
%=============================================================================
function [L, U, C] = emptyThresholdsLocal(sz, detectionDim)
  outSize = sz;
  outSize(detectionDim) = 1;
  L = NaN(outSize);
  U = NaN(outSize);
  C = NaN(outSize);
end
%=============================================================================
function locations = parseOutlierLocationsLocal(value, sz)
  if ~(islogical(value) && isequal(size(value), sz))
    error('Nelson:statistics:outlierLocationsLogicalArraySameSize', 'OutlierLocations must be a logical array the same size as A.');
  end
  locations = value;
end
%=============================================================================
function dim = defaultRemoveDimensionLocal(A)
  if isvector(A)
    dim = detectionDimensionLocal(A);
  else
    dim = 1;
  end
end
%=============================================================================
function dim = detectionDimensionLocal(A)
  if size(A, 1) ~= 1
    dim = 1;
  else
    dim = 2;
  end
end
%=============================================================================
function method = parseMethodNameLocal(value)
  choices = {'median', 'mean', 'quartiles', 'grubbs', 'gesd', ...
    'percentiles', 'movmedian', 'movmean'};
  text = lower(char(value));
  matches = choices(startsWith(choices, text));
  if length(matches) ~= 1
    error('Nelson:statistics:METHODUnsupportedValue', '%s has an unsupported value.', 'METHOD');
  end
  method = matches{1};
end
%=============================================================================
function name = matchedNameLocal(value)
  if ~isTextScalarLocal(value)
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Name');
  end
  names = {'thresholdfactor', 'maxnumoutliers', 'samplepoints', 'outlierlocations', ...
    'datavariables', 'outputformat'};
  text = lower(char(value));
  matches = names(startsWith(names, text));
  if length(matches) ~= 1
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
  name = matches{1};
end
%=============================================================================
function tf = isLeadingNameValueLocal(value)
  names = {'thresholdfactor', 'maxnumoutliers', 'samplepoints', 'outlierlocations', ...
    'datavariables', 'outputformat'};
  text = lower(char(value));
  matches = names(startsWith(names, text));
  tf = length(matches) == 1;
end
%=============================================================================
function tf = isRemoveDimLocal(value)
  tf = isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) ...
    && (value == 1 || value == 2);
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [b, stats] = robustfit(X, y, wfun, tune, const)
  narginchk(2, 5);
  nargoutchk(0, 2);
  if nargin < 3 || isempty(wfun)
    wfun = 'bisquare';
  end
  if nargin < 4
    tune = [];
  end
  if nargin < 5 || isempty(const)
    const = 'on';
  end
  [X, y, wfun, tune, const] = validateInputsLocal(X, y, wfun, tune, const);
  if strcmp(const, 'on')
    X = [ones(size(X, 1), 1), X];
  end
  keep = ~isnan(y) & all(~isnan(X), 2);
  [b, fitStats] = robustFitLocal(X(keep, :), y(keep), wfun, tune);
  stats = expandStatsLocal(fitStats, keep, size(X, 1));
end
%=============================================================================
function [X, y, wfun, tune, const] = validateInputsLocal(X, y, wfun, tune, const)
  if ~(isnumeric(X) && isreal(X) && ismatrix(X) && ~issparse(X))
    error('Nelson:statistics:xRealNumericMatrix', '%s must be a real numeric matrix.', 'X');
  end
  if ~(isnumeric(y) && isreal(y) && isvector(y) && ~issparse(y))
    error('Nelson:statistics:yRealNumericVector', '%s must be a real numeric vector.', 'Y');
  end
  X = double(X);
  y = double(y(:));
  if size(X, 1) ~= length(y)
    error('Nelson:statistics:xYSameNumberRows', '%s must have the same number of rows.', 'X and Y');
  end
  const = parseConstLocal(const);
  wfun = parseWeightFunctionLocal(wfun);
  tune = parseTuneLocal(tune, wfun);
end
%=============================================================================
function const = parseConstLocal(value)
  if ~isTextScalarLocal(value)
    error('Nelson:statistics:CONSTOff', 'CONST must be ''on'' or ''off''.');
  end
  const = parseChoiceLocal(value, {'on', 'off'}, 'CONST');
end
%=============================================================================
function tune = parseTuneLocal(tune, wfun)
  if isempty(tune)
    tune = defaultTuneLocal(wfun);
    return
  end
  if ~(isnumeric(tune) && isreal(tune) && isscalar(tune) && isfinite(tune) && tune > 0)
    error('Nelson:statistics:TUNEPositiveScalar', '%s must be a positive scalar.', 'TUNE');
  end
  tune = double(tune);
end
%=============================================================================
function name = parseWeightFunctionLocal(wfun)
  if isa(wfun, 'function_handle')
    name = wfun;
    return
  end
  if ~isTextScalarLocal(wfun)
    error('Nelson:statistics:WFUNCharacterVectorStringScalar', 'WFUN must be a character vector, string scalar, or function handle.');
  end
  name = parseChoiceLocal(wfun, {'andrews', 'bisquare', 'cauchy', 'fair', ...
                                 'huber', 'logistic', 'ols', 'talwar', 'welsch'}, 'WFUN');
end
%=============================================================================
function [b, stats] = robustFitLocal(X, y, wfun, tune)
  n = length(y);
  p = size(X, 2);
  if n == 0 || p == 0
    b = NaN(p, 1);
    stats = emptyStatsLocal(n, p);
    return
  end
  b = X \ y;
  dfe = n - rank(X);
  h = leverageLocal(X);
  resid = y - X * b;
  ols_s = scaleFromResidualsLocal(resid, dfe);
  if ischar(wfun) && strcmp(wfun, 'ols')
    w = ones(n, 1);
  else
    [b, resid, w] = irlsLocal(X, y, b, h, wfun, tune, p);
  end
  stats = buildStatsLocal(X, y, b, resid, w, h, dfe, ols_s);
end
%=============================================================================
function [b, resid, w] = irlsLocal(X, y, b, h, wfun, tune, p)
  w = ones(length(y), 1);
  for iter = 1:50
    resid = y - X * b;
    s = madScaleLocal(resid, p);
    u = resid ./ max(tune * s * sqrt(max(1 - h, eps)), eps);
    w = weightValuesLocal(u, wfun);
    sw = sqrt(max(w, 0));
    bnew = (X .* sw) \ (y .* sw);
    if norm(bnew - b) <= 1e-6 * max(norm(b), eps)
      b = bnew;
      break
    end
    b = bnew;
  end
  resid = y - X * b;
end
%=============================================================================
function stats = buildStatsLocal(X, y, b, resid, w, h, dfe, ols_s)
  p = length(b);
  mad_s = madScaleLocal(resid, p);
  robust_s = scaleFromResidualsLocal(sqrt(max(w, 0)) .* resid, dfe);
  s = max(mad_s, robust_s);
  covb = pinv(X' * X) * s ^ 2;
  se = sqrt(max(0, diag(covb)));
  tval = b ./ se;
  pval = 2 * (1 - tcdf(abs(tval), max(dfe, 1)));
  stats = struct();
  stats.ols_s = ols_s;
  stats.robust_s = robust_s;
  stats.mad_s = mad_s;
  stats.s = s;
  stats.resid = resid;
  stats.rstud = resid ./ max(s * sqrt(max(1 - h, eps)), eps);
  stats.se = se;
  stats.covb = covb;
  stats.coeffcorr = coefficientCorrelationLocal(covb);
  stats.t = tval;
  stats.p = pval;
  stats.w = w;
  stats.R = rFactorLocal(X);
  stats.dfe = dfe;
  stats.h = h;
end
%=============================================================================
function stats = expandStatsLocal(stats, keep, n)
  fields = {'resid', 'rstud', 'w', 'h'};
  for k = 1:length(fields)
    name = fields{k};
    values = NaN(n, 1);
    values(keep) = stats.(name);
    stats.(name) = values;
  end
end
%=============================================================================
function stats = emptyStatsLocal(n, p)
  stats = struct('ols_s', NaN, 'robust_s', NaN, 'mad_s', NaN, 's', NaN, ...
    'resid', NaN(n, 1), 'rstud', NaN(n, 1), 'se', NaN(p, 1), ...
    'covb', NaN(p, p), 'coeffcorr', NaN(p, p), 't', NaN(p, 1), ...
    'p', NaN(p, 1), 'w', NaN(n, 1), 'R', NaN(p, p), 'dfe', NaN, ...
    'h', NaN(n, 1));
end
%=============================================================================
function s = madScaleLocal(resid, p)
  deviations = sort(abs(resid - median(resid)));
  if length(deviations) > p
    deviations = deviations(p + 1:end);
  end
  s = median(deviations) / 0.6745;
  if ~(isfinite(s) && s > 0)
    s = max(scaleFromResidualsLocal(resid, length(resid) - p), eps);
  end
end
%=============================================================================
function s = scaleFromResidualsLocal(resid, dfe)
  if dfe <= 0
    s = NaN;
  else
    s = sqrt(sum(resid .^ 2) / dfe);
  end
end
%=============================================================================
function h = leverageLocal(X)
  h = diag(X * pinv(X' * X) * X');
  h = min(max(h, 0), 1);
end
%=============================================================================
function w = weightValuesLocal(u, wfun)
  if isa(wfun, 'function_handle')
    w = feval(wfun, u);
    return
  end
  switch wfun
    case 'andrews'
      w = ones(size(u));
      nz = u ~= 0;
      w(nz) = (abs(u(nz)) < pi) .* sin(u(nz)) ./ u(nz);
    case 'bisquare'
      w = (abs(u) < 1) .* (1 - u .^ 2) .^ 2;
    case 'cauchy'
      w = 1 ./ (1 + u .^ 2);
    case 'fair'
      w = 1 ./ (1 + abs(u));
    case 'huber'
      w = 1 ./ max(1, abs(u));
    case 'logistic'
      w = ones(size(u));
      nz = u ~= 0;
      w(nz) = tanh(u(nz)) ./ u(nz);
    case 'talwar'
      w = double(abs(u) < 1);
    otherwise
      w = exp(-(u .^ 2));
  end
  w(~isfinite(w)) = 1;
end
%=============================================================================
function c = coefficientCorrelationLocal(covb)
  d = sqrt(diag(covb));
  c = covb ./ (d * d');
end
%=============================================================================
function R = rFactorLocal(X)
  try
    R = chol(X' * X);
  catch
    R = [];
  end
end
%=============================================================================
function tune = defaultTuneLocal(wfun)
  if isa(wfun, 'function_handle')
    tune = 1;
    return
  end
  switch wfun
    case 'andrews'
      tune = 1.339;
    case 'cauchy'
      tune = 2.385;
    case 'fair'
      tune = 1.400;
    case 'huber'
      tune = 1.345;
    case 'logistic'
      tune = 1.205;
    case 'talwar'
      tune = 2.795;
    case 'welsch'
      tune = 2.985;
    otherwise
      tune = 4.685;
  end
end
%=============================================================================
function value = parseChoiceLocal(value, choices, name)
  text = lower(char(value));
  matches = choices(startsWith(choices, text));
  if length(matches) ~= 1
    error('Nelson:statistics:invalidValue:valueHasUnsupportedValue', '%s has an unsupported value.', name);
  end
  value = matches{1};
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [B, T] = rotatefactors(X, varargin)
  narginchk(1, Inf);
  nargoutchk(0, 2);
  preserveSingle = isa(X, 'single');
  X = validateLoadingsLocal(X);
  opts = parseOptionsLocal(convertStringToCharArgs(varargin), size(X));
  [B, T] = rotateLocal(X, opts);
  if preserveSingle
    B = single(B);
    T = single(T);
  end
end
%=============================================================================
function X = validateLoadingsLocal(X)
  if ~(isnumeric(X) && isreal(X) && ~issparse(X) && ndims(X) == 2)
    error('Nelson:statistics:xRealNumericMatrix', '%s must be a real numeric matrix.', 'X');
  end
  X = double(X);
  if isempty(X) || any(~isfinite(X(:)))
    error('Nelson:statistics:xMustBeFinite', '%s must contain finite values.', 'X');
  end
  if size(X, 2) < 1
    error('Nelson:statistics:xContainLeastOneFactor', 'X must contain at least one factor.');
  end
end
%=============================================================================
function opts = parseOptionsLocal(args, loadingsSize)
  opts = defaultOptionsLocal();
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  for k = 1:2:length(args)
    if ~isTextScalarLocal(args{k})
      error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Name');
    end
    opts = setOptionLocal(opts, lower(char(args{k})), args{k + 1}, loadingsSize);
  end
end
%=============================================================================
function opts = defaultOptionsLocal()
  opts = struct('Method', 'varimax', 'Normalize', true, 'RelTol', sqrt(eps), ...
    'MaxIt', 250, 'Coeff', 1, 'Power', 4, 'Target', [], 'Type', 'oblique');
end
%=============================================================================
function opts = setOptionLocal(opts, name, value, loadingsSize)
  switch name
    case 'method'
      opts.Method = parseChoiceLocal(value, {'varimax', 'quartimax', 'equamax', ...
        'parsimax', 'orthomax', 'promax', 'procrustes', 'pattern'}, 'Method');
    case 'normalize'
      opts.Normalize = parseOnOffLocal(value, 'Normalize');
    case 'reltol'
      opts.RelTol = parsePositiveScalarLocal(value, 'RelTol');
    case 'maxit'
      opts.MaxIt = parsePositiveIntegerLocal(value, 'MaxIt');
    case 'coeff'
      opts.Coeff = parseNonnegativeScalarLocal(value, 'Coeff');
    case 'power'
      opts.Power = parsePositiveScalarLocal(value, 'Power');
    case 'target'
      opts.Target = validateTargetLocal(value, loadingsSize);
    case 'type'
      opts.Type = parseChoiceLocal(value, {'oblique', 'orthogonal'}, 'Type');
    otherwise
      error('Nelson:statistics:unknownOption', 'Unknown option.');
  end
end
%=============================================================================
function value = parseChoiceLocal(value, choices, name)
  if ~isTextScalarLocal(value)
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', name);
  end
  value = lower(char(value));
  matches = choices(startsWith(choices, value));
  if length(matches) ~= 1
    error('Nelson:statistics:invalidValue:valueHasUnsupportedValue', '%s has an unsupported value.', name);
  end
  value = matches{1};
end
%=============================================================================
function tf = parseOnOffLocal(value, name)
  if islogical(value) && isscalar(value)
    tf = value ~= 0;
  elseif isnumeric(value) && isreal(value) && isscalar(value) && (value == 0 || value == 1)
    tf = value ~= 0;
  elseif isTextScalarLocal(value)
    value = lower(char(value));
    if strcmp(value, 'on')
      tf = true;
    elseif strcmp(value, 'off')
      tf = false;
    else
      error('Nelson:statistics:invalidValue:valueHasUnsupportedValue', '%s has an unsupported value.', name);
    end
  else
    error('Nelson:statistics:invalidValue:valueOffTrueFalse', '%s must be on, off, true, or false.', name);
  end
end
%=============================================================================
function value = parsePositiveScalarLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) && value > 0)
    error('Nelson:statistics:mustBePositiveFinite', '%s must be a positive finite scalar.', name);
  end
  value = double(value);
end
%=============================================================================
function value = parseNonnegativeScalarLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) && value >= 0)
    error('Nelson:statistics:mustBeNonnegativeFinite', '%s must be a nonnegative finite scalar.', name);
  end
  value = double(value);
end
%=============================================================================
function value = parsePositiveIntegerLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) ...
      && floor(value) == value && value > 0)
    error('Nelson:statistics:mustBePositiveInteger', '%s must be a positive integer scalar.', name);
  end
  value = double(value);
end
%=============================================================================
function target = validateTargetLocal(target, loadingsSize)
  if ~(isnumeric(target) && isreal(target) && ~issparse(target) && ndims(target) == 2)
    error('Nelson:statistics:targetRealNumericMatrix', '%s must be a real numeric matrix.', 'Target');
  end
  target = double(target);
  if ~isequal(size(target), loadingsSize)
    error('Nelson:statistics:targetSameSizeX', 'Target must have the same size as X.');
  end
  if any(~isfinite(target(:)))
    error('Nelson:statistics:targetContainFiniteValues', '%s must contain finite values.', 'Target');
  end
end
%=============================================================================
function [B, T] = rotateLocal(X, opts)
  switch opts.Method
    case {'varimax', 'quartimax', 'equamax', 'parsimax', 'orthomax'}
      [B, T] = orthomaxLocal(X, opts, rotationCoeffLocal(opts.Method, opts.Coeff));
    case 'promax'
      [B, T] = promaxLocal(X, opts);
    otherwise
      [B, T] = targetRotationLocal(X, opts);
  end
  [B, T] = orientColumnsLocal(B, T);
end
%=============================================================================
function gamma = rotationCoeffLocal(method, coeff)
  switch method
    case 'quartimax'
      gamma = 0;
    case {'equamax', 'parsimax'}
      gamma = [];
    case 'orthomax'
      gamma = coeff;
    otherwise
      gamma = 1;
  end
end
%=============================================================================
function [B, T] = orthomaxLocal(X, opts, gamma)
  [Xn, scale] = normalizeRowsLocal(X, opts.Normalize);
  [p, m] = size(Xn);
  if isempty(gamma)
    if strcmp(opts.Method, 'equamax')
      gamma = m / 2;
    else
      gamma = p * (m - 1) / max(p + m - 2, 1);
    end
  end
  T = eye(m);
  previous = 0;
  for iter = 1:opts.MaxIt
    rotated = Xn * T;
    target = p * rotated .^ 3 - gamma * (rotated * diag(sum(rotated .^ 2, 1)));
    [U, S, V] = svd(Xn' * target);
    T = U * V';
    current = sum(diag(S));
    if current <= previous * (1 + opts.RelTol)
      break
    end
    previous = current;
  end
  B = unnormalizeRowsLocal(Xn * T, scale);
end
%=============================================================================
function [B, T] = promaxLocal(X, opts)
  [orthogonal, Tortho] = orthomaxLocal(X, opts, opts.Coeff);
  target = sign(orthogonal) .* abs(orthogonal) .^ opts.Power;
  procrustesOpts = opts;
  procrustesOpts.Target = target;
  procrustesOpts.Type = 'oblique';
  [B, Tp] = targetRotationLocal(X, procrustesOpts);
  T = Tortho * (Tortho \ Tp);
end
%=============================================================================
function [B, T] = targetRotationLocal(X, opts)
  if isempty(opts.Target)
    error('Nelson:statistics:targetRequiredRotationMethod', 'Target is required for this rotation method.');
  end
  if strcmp(opts.Type, 'orthogonal')
    [U, ~, V] = svd(X' * opts.Target);
    T = U * V';
  else
    T = (X' * X) \ (X' * opts.Target);
    columnNorm = sqrt(sum(T .^ 2, 1));
    columnNorm(columnNorm == 0) = 1;
    T = T ./ repmat(columnNorm, size(T, 1), 1);
  end
  B = X * T;
end
%=============================================================================
function [Xn, scale] = normalizeRowsLocal(X, doNormalize)
  scale = ones(size(X, 1), 1);
  Xn = X;
  if ~doNormalize
    return
  end
  scale = sqrt(sum(X .^ 2, 2));
  scale(scale <= 0) = 1;
  Xn = X ./ repmat(scale, 1, size(X, 2));
end
%=============================================================================
function X = unnormalizeRowsLocal(X, scale)
  X = X .* repmat(scale, 1, size(X, 2));
end
%=============================================================================
function [B, T] = orientColumnsLocal(B, T)
  for k = 1:size(B, 2)
    [~, idx] = max(abs(B(:, k)));
    if B(idx, k) < 0
      B(:, k) = -B(:, k);
      T(:, k) = -T(:, k);
    end
  end
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || isStringScalar(value);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
