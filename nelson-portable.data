function indices = worker_pool_missing_indices(test_cases)
  indices = [];
  for k = 1:length(test_cases)
    if isfield(test_cases(k), 'pool_missing_result') && test_cases(k).pool_missing_result
      indices = [indices, k];
    end
  end
end
%=============================================================================
