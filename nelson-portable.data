% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = plot(varargin)
  inputArguments = convertStringToCharArgs(varargin);
  nbInputArguments = nargin;
  go = [];
  if (nbInputArguments >= 2) && (isscalar(inputArguments{1}) && (isgraphics(inputArguments{1}, 'axes') || isgraphics(inputArguments{1}, 'hggroup')))
    go = inputArguments{1}(1);
    inputArguments(1) = [];
    nbInputArguments = nbInputArguments - 1;
  end

  propertyIndex = 0;
  if (nbInputArguments > 2)
    propertyIndex = nbInputArguments - 1;
    bContinue = 1;
    while ((propertyIndex >= 1) && bContinue)
      bContinue = ischar(inputArguments{propertyIndex}) && isValidGraphicsProperty('line', inputArguments{propertyIndex});
      if bContinue
        propertyIndex = propertyIndex - 2;
      end
    end
    propertyIndex = propertyIndex + 2;
  end

  propertiesList = {};
  if ((propertyIndex > 0) & (propertyIndex < nbInputArguments))
    propertiesList = inputArguments(propertyIndex:end);
    inputArguments(propertyIndex:end) = [];
    nbInputArguments = length(inputArguments);
  end
  [go, propertiesList] = extractParentProperty(go, propertiesList);

  keepBox = false;
  if isempty(go)
    fig = groot().CurrentFigure;
    if ~isempty(fig) && ~isempty(fig.CurrentAxes)
      keepBox = strcmp(fig.CurrentAxes.NextPlot, 'add');
    end
    go = newplot();
  elseif isgraphics(go, 'axes')
    keepBox = strcmp(go.NextPlot, 'add');
    go = newplot(go);
  else
    if ~isgraphics(go, 'hggroup')
      error('Nelson:graphics:invalidParent', 'Parent must be an axes or hggroup object.');
    end
    ax = ancestor(go, 'axes');
    keepBox = strcmp(ax.NextPlot, 'add');
  end
  if isgraphics(go, 'hggroup')
    ax = ancestor(go, 'axes');
  else
    ax = go;
  end
  if ~keepBox && ~isUiFigureAxes(ax)
    ax.Box = 'on';
  end

  h = [];
  while (~isempty(inputArguments))
    cs = '';
    ms = '';
    ps = '';
    if (length(inputArguments) == 1)
      if isempty(h)
        h = plot_Y(inputArguments{1}, go, propertiesList);
      else
        h = [h; plot_Y(inputArguments{1}, go, propertiesList)];
      end
      inputArguments(1) = [];
    else
      [ps, cs, ms, msg] = colstyle(inputArguments{2}, 'plot', false);
      r = isempty(msg);
      if (r)
        h = [h; plot_Y(inputArguments{1}, go, completeProperties(cs, ms, ps, propertiesList))];
        inputArguments(1:2) = [];
      elseif (length(inputArguments) == 2)
        if isempty(h)
          h = plot_XY(inputArguments{1}, inputArguments{2}, go, propertiesList);
        else
          h = [h; plot_XY(inputArguments{1}, inputArguments{2}, go, propertiesList)];
        end
        inputArguments(1:2) = [];
      else
        [ps, cs, ms, msg] = colstyle(inputArguments{3}, 'plot', false);
        r = isempty(msg);
        if (r)
          h = [h; plot_XY(inputArguments{1}, inputArguments{2}, go, completeProperties(cs, ms, ps, propertiesList))];
          inputArguments(1:3) = [];
        else
          if (isempty(h))
            h = plot_XY(inputArguments{1}, inputArguments{2}, go, propertiesList);
          else
            h = [h; plot_XY(inputArguments{1}, inputArguments{2}, go, propertiesList)];
          end
          inputArguments(1:2) = [];
        end
      end
    end
  end
  applyUiAxesPlotTicks(ax);
  if isempty(find(strcmp(propertiesList, 'Visible')))
    h.Visible = 'on';
  end
  if (nargout > 0)
    varargout{1} = h;
  end
end
%=============================================================================
function applyUiAxesPlotTicks(ax)
  if ~isUiFigureAxes(ax)
    return
  end
  if strcmp(ax.XTickMode, 'auto')
    ticks = uiAxesNiceTicks(ax.XLim);
    if ~isempty(ticks)
      ax.XTick = ticks;
    end
  end
  if strcmp(ax.YTickMode, 'auto')
    ticks = uiAxesNiceTicks(ax.YLim);
    if ~isempty(ticks)
      ax.YTick = ticks;
    end
  end
end
%=============================================================================
function ticks = uiAxesNiceTicks(limits)
  ticks = [];
  if numel(limits) ~= 2 || any(~isfinite(limits)) || limits(1) == limits(2)
    return
  end
  span = abs(diff(limits));
  if limits(1) < 0 && limits(2) > 0 && span <= 2
    rawStep = span / 4;
  else
    rawStep = span / 10;
  end
  step = uiAxesTickStep(rawStep);
  firstTick = ceil(limits(1) / step) * step;
  lastTick = floor(limits(2) / step) * step;
  if firstTick <= lastTick
    ticks = firstTick:step:lastTick;
  end
end
%=============================================================================
function step = uiAxesTickStep(rawStep)
  if rawStep <= 0 || ~isfinite(rawStep)
    step = 1;
    return
  end
  scale = 10 ^ floor(log10(rawStep));
  normalized = rawStep / scale;
  if normalized <= 1
    step = scale;
  elseif normalized <= 2
    step = 2 * scale;
  elseif normalized <= 5
    step = 5 * scale;
  else
    step = 10 * scale;
  end
end
%=============================================================================
function tf = isUiFigureAxes(ax)
  tf = false;
  if ~isgraphics(ax, 'axes')
    return
  end
  parent = ax.Parent;
  if isempty(parent) || ~isgraphics(parent, 'figure')
    return
  end
  requiredProperties = {'MenuBar', 'ToolBar', 'NumberTitle', 'IntegerHandle'};
  for k = 1:numel(requiredProperties)
    if ~isprop(parent, requiredProperties{k})
      return
    end
  end
  tf = strcmp(parent.MenuBar, 'none') && strcmp(parent.ToolBar, 'none') ...
    && strcmp(parent.NumberTitle, 'off') && strcmp(parent.IntegerHandle, 'off');
end
%=============================================================================
function [parent, propertiesList] = extractParentProperty(parent, propertiesList)
  parentIndex = [];
  for k = 1:2:(length(propertiesList) - 1)
    if ischar(propertiesList{k}) && strcmpi(propertiesList{k}, 'Parent')
      parentIndex = k;
    end
  end
  if ~isempty(parentIndex)
    parent = propertiesList{parentIndex + 1};
    propertiesList(parentIndex:parentIndex + 1) = [];
  end
end
%=============================================================================
function q = completeProperties(cs, ms, ps, p)
  if isempty(ps)
    ps = 'none';
  end
  if (strcmp(cs, ''))
    q = {'Marker', ms, 'LineStyle', ps, p{:}};
  else
    q = {'Color', cs, 'Marker', ms, 'LineStyle', ps, p{:}};
  end
end
%=============================================================================
function k = plotVector(go, x, y, lineProperties)
  if isgraphics(go, 'hggroup')
    ax = ancestor(go, 'axes');
  else
    ax = go;
  end
  lineStyle = getLineStyleAndUpdateIndex(ax);
  color = getColorAndUpdateIndex(ax);
  if (~any(strcmp(lineProperties, 'LineStyle')))
    lineProperties = [lineProperties, {'LineStyle', lineStyle}];
  end
  k = __line__('Parent', go, 'XData', x, 'YData', y, 'Color', color, 'Visible', 'off', lineProperties{:});
end
%=============================================================================
function h = plot_XY(X, Y, go, lineProperties)
  h = [];
  [X, xIsDate] = datetimeToSerial(X);
  [Y, yIsDate] = datetimeToSerial(Y);
  [X, Y] = matchMatrix(X, Y);
  if (isvector(X))
    X = X(:);
  end;
  if (isvector(Y))
    Y = Y(:);
  end;
  for i = 1:size(Y, 2)
    h = [h; plotVector(go, X(:, i), Y(:, i), lineProperties)];
  end
  if xIsDate
    applyDatetimeAxis(go, 'x');
  end
  if yIsDate
    applyDatetimeAxis(go, 'y');
  end
end
%=============================================================================
function [a, b] = matchMatrix(a, b)
  if (isvector(a) && ~isvector(b))
    if (length(a) == size(b, 1))
      a = repmat(a(:), [1, size(b, 2)]);
      return
    else
      if (length(a) == size(b, 2))
        b = b';
        a = repmat(a(:)', [size(b, 2), 1])';
        return
      else
        error('Nelson:dimagree:dimensionsDoNotMatch', 'Dimensions do not match.');
      end
    end
  end
  if (~isvector(a) && isvector(b))
    if (length(b) == size(a, 1))
      b = repmat(b(:), [1, size(a, 2)]);
    else
      if (length(b) == size(a, 2))
        a = a';
        b = repmat(b(:)', [size(a, 2), 1])';
      else
        error('Nelson:dimagree:dimensionsDoNotMatch', 'Dimensions do not match.');
      end
    end
  end
end
%=============================================================================
function h = plot_Y(Y, go, lineProperties)
  h = [];
  [Y, yIsDate] = datetimeToSerial(Y);
  if (isvector(Y)) Y = Y(:); end;
  if (isreal(Y))
    n = 1:size(Y, 1);
    lineProperties = [lineProperties, {'XDataMode', 'auto'}];
    for i = 1:size(Y, 2)
      h = [h; plotVector(go, n, Y(:, i), lineProperties)];
    end
  else
    for i = 1:size(Y, 2)
      h = [h; plotVector(go, real(Y(:, i)), imag(Y(:, i)), lineProperties)];
    end
  end
  if yIsDate
    applyDatetimeAxis(go, 'y');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = plot3(varargin)
  inputArguments = convertStringToCharArgs(varargin);
  nbInputArguments = nargin;

  if (nbInputArguments >= 2)
    if (isscalar(inputArguments{1}) && (isgraphics(inputArguments{1}, 'axes') || isgraphics(inputArguments{1}, 'hggroup')))
      go = newplotTarget(inputArguments{1}(1));
      inputArguments(1) = [];
      nbInputArguments = nbInputArguments - 1;
    else
      go = newplotTarget(graphicsParentProperty(inputArguments));
    end
  end
  if isgraphics(go, 'hggroup')
    ax = ancestor(go, 'axes');
  else
    ax = go;
  end
  propertyIndex = 0;
  if (nbInputArguments > 2)
    propertyIndex = nbInputArguments - 1;
    bContinue = true;
    while ((propertyIndex >= 1) && bContinue)
      bContinue = ischar(inputArguments{propertyIndex}) && isValidGraphicsProperty('line', inputArguments{propertyIndex});
      if bContinue
        propertyIndex = propertyIndex - 2;
      end
    end
    propertyIndex = propertyIndex + 2;
  end
  propertiesList = {};

  if ((propertyIndex > 0) && (propertyIndex < nbInputArguments))
    propertiesList = inputArguments(propertyIndex:end);
    inputArguments(propertyIndex:end) = [];
  end

  h = [];
  while (~isempty(inputArguments))
    cs = '';
    ms = '';
    ps = '';
    if (length(inputArguments) < 3)
      error('Nelson:notEnoughInputs', 'Not enough input arguments.');
    end;
    r = true;
    if (length(inputArguments) > 3)
      [ps, cs, ms, msg] = colstyle(inputArguments{4}, '', false);
      r = isempty(msg);
    end
    if (length(inputArguments) == 3 || (length(inputArguments) > 3) && ~r)
      h = [h; plot_XYZ(inputArguments{1}, inputArguments{2}, inputArguments{3}, go, propertiesList)];
      inputArguments(1:3) = [];
    elseif ((length(inputArguments) >= 4) && r)
      h = [h; plot_XYZ(inputArguments{1}, inputArguments{2}, inputArguments{3}, go, completeProperties(cs, ms, ps, propertiesList))];
      inputArguments(1:4) = [];
    end;
  end
  if ~ishold(ax)
    view(ax, 3);
  end
  if isempty(find(strcmp(propertiesList, 'Visible')))
    h.Visible = 'on';
  end
  if (nargout > 0)
    varargout{1} = h;
  end
end
%=============================================================================
function q = completeProperties(cs, ms, ps, p)
  if isempty(ps)
    ps = 'none';
  end
  if (strcmp(cs, ''))
    q = {'Marker', ms, 'LineStyle', ps, p{:}};
  else
    q = {'Color', cs, 'Marker', ms, 'LineStyle', ps, p{:}};
  end
end
%=============================================================================
function h = plot_XYZ(X, Y, Z, go, lineProperties)
  h = [];
  if ((isvector(X) || isvector(Y) || isvector(Z)) && (~isvector(X) || ~isvector(Y) || ~isvector(Z)))
    rows = max([size(X, 1), size(Y, 1), size(Z, 1)]);
    cols = max([size(X, 2), size(Y, 2), size(Z, 2)]);
    X = resizeMatrix(X, rows, cols);
    Y = resizeMatrix(Y, rows, cols);
    Z = resizeMatrix(Z, rows, cols);
  end
  if (isvector(X))
    X = X(:);
  end;
  if (isvector(Y))
    Y = Y(:);
  end;
  if (isvector(Z))
    Z = Z(:);
  end;
  for i = 1:size(Z, 2)
    h = [h; plotVector(go, X(:, i), Y(:, i), Z(:, i), lineProperties)];
  end
end
%=============================================================================
function x = resizeMatrix(a, rows, cols)
  if (length(a) == rows)
    x = repmat(a(:), [1, cols]);
  elseif (length(a) == cols)
    x = repmat(a(:)', [rows, 1]);
  else
    error('Nelson:plot3:invalidInputArguments', 'Wrong size for input arguments: vectors with same size expected.');
  end
end
%=============================================================================
function hl = plotVector(go, x, y, z, lineProperties)
  if isgraphics(go, 'hggroup')
    ax = ancestor(go, 'axes');
  else
    ax = go;
  end
  lineStyle = getLineStyleAndUpdateIndex(ax);
  color = getColorAndUpdateIndex(ax);
  if (~any(strcmp(lineProperties, 'LineStyle')))
    lineProperties = [lineProperties, {'LineStyle', lineStyle}];
  end
  hl = __line__('Parent', go, 'XData', x, 'YData', y, 'ZData', z, 'Color', color, 'Visible', 'off', lineProperties{:});
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = plotmatrix(varargin)
  narginchk(1, 4);
  nargoutchk(0, 5);
  args = convertStringToCharArgs(varargin);
  [parentAx, x, y, sameData, markerSpec] = parsePlotMatrixInputs(args);
  [nbRows, xCols] = size(x);
  [yRows, yCols] = size(y);
  if nbRows ~= yRows
    error('Nelson:dimagree:xYNumberRows', 'X and Y must have the same number of rows.');
  end
  h = gobjects(yCols, xCols);
  ax = gobjects(yCols, xCols);
  histHandles = gobjects(1, min(xCols, yCols));
  histAxes = gobjects(1, min(xCols, yCols));
  if ~isempty(parentAx)
    newplot(parentAx);
  end
  parentFigure = plotMatrixFigure(parentAx);
  for row = 1:yCols
    for col = 1:xCols
      ax(row, col) = axes('Parent', parentFigure, ...
        'Position', plotMatrixAxesPosition(row, col, yCols, xCols));
      h(row, col) = plot(ax(row, col), x(:, col), y(:, row), markerSpec, 'LineStyle', 'none');
      applyPlotMatrixAxes(ax(row, col), row, col, yCols, xCols);
    end
  end
  if sameData
    [histHandles, histAxes] = drawDiagonalHistograms(ax, x);
  else
    histHandles = gobjects(0);
    histAxes = gobjects(0);
  end
  applyPlotMatrixVariableScales(ax, histAxes, x, y);
  if isempty(parentAx)
    bigax = axes('Position', [0.08 0.08 0.86 0.86], 'Visible', 'off');
  else
    bigax = parentAx;
    bigax.Visible = 'off';
  end
  bigax.Tag = 'PlotMatrixBigAx';
  state = struct();
  state.ChartType = 'plotmatrix';
  state.XData = x;
  state.YData = y;
  state.SameData = sameData;
  state.Axes = ax;
  state.DataHandles = h;
  state.HistogramHandles = histHandles;
  state.HistogramAxes = histAxes;
  bigax.UserData = state;
  outputs = {h, ax, bigax, histHandles, histAxes};
  for k = 1:nargout
    varargout{k} = outputs{k};
  end
end
%=============================================================================
function fig = plotMatrixFigure(parentAx)
  if isempty(parentAx)
    fig = gcf();
  else
    fig = ancestor(parentAx, 'figure');
  end
end
%=============================================================================
function position = plotMatrixAxesPosition(row, col, nbRows, nbCols)
  left = 0.135166666666667;
  right = 0.095;
  bottom = 0.115433333333333;
  top = 0.075;
  horizontalGap = 0.00516666666666667;
  verticalGap = 0.00543333333333333;
  width = (1 - left - right - (nbCols - 1) * horizontalGap) / nbCols;
  height = (1 - bottom - top - (nbRows - 1) * verticalGap) / nbRows;
  x = left + (col - 1) * (width + horizontalGap);
  y = 1 - top - row * height - (row - 1) * verticalGap;
  position = [x y width height];
end
%=============================================================================
function applyPlotMatrixVariableScales(ax, histAxes, x, y)
  xScales = plotMatrixScales(x);
  yScales = plotMatrixScales(y);
  [nbRows, nbCols] = size(ax);
  for row = 1:nbRows
    for col = 1:nbCols
      ax(row, col).XLim = xScales(col).Limits;
      ax(row, col).XTick = xScales(col).Ticks;
      ax(row, col).YLim = yScales(row).Limits;
      ax(row, col).YTick = yScales(row).Ticks;
    end
  end
  n = min(numel(histAxes), numel(xScales));
  for k = 1:n
    histAxes(k).XLim = xScales(k).Limits;
  end
end
%=============================================================================
function scales = plotMatrixScales(values)
  n = size(values, 2);
  scales = repmat(struct('Limits', [0 1], 'Ticks', []), 1, n);
  for k = 1:n
    [limits, ticks] = plotMatrixColumnScale(values(:, k));
    scales(k).Limits = limits;
    scales(k).Ticks = ticks;
  end
end
%=============================================================================
function [limits, ticks] = plotMatrixColumnScale(values)
  values = values(isfinite(values));
  if isempty(values)
    limits = [0 1];
    ticks = [];
    return
  end
  values = values(:).';
  low = min(values);
  high = max(values);
  if low == high
    limits = [low - 0.5, high + 0.5];
    ticks = low;
    return
  end
  if all(abs(values - round(values)) < 1e-12)
    uniqueValues = unique(values);
    if numel(uniqueValues) > 1 && all(abs(diff(uniqueValues) - 1) < 1e-12)
      ticks = low:high;
      limits = [low - 0.6, high + 0.6];
      return
    end
  end
  step = plotMatrixNiceStep((high - low) / 5);
  first = floor(low / step) * step;
  last = ceil(high / step) * step;
  ticks = first:step:last;
  limits = [first - 0.75 * step, last + 0.75 * step];
end
%=============================================================================
function step = plotMatrixNiceStep(value)
  value = abs(value);
  if value <= 0 || ~isfinite(value)
    step = 1;
    return
  end
  scale = 10 ^ floor(log10(value));
  normalized = value / scale;
  if normalized <= 1
    nice = 1;
  elseif normalized <= 2
    nice = 2;
  elseif normalized <= 5
    nice = 5;
  else
    nice = 10;
  end
  step = nice * scale;
end
%=============================================================================
function [parentAx, x, y, sameData, markerSpec] = parsePlotMatrixInputs(args)
  sameData = true;
  markerSpec = '.';
  parentAx = [];
  if ~isempty(args) && isscalar(args{1}) && isgraphics(args{1}, 'axes')
    parentAx = args{1};
    args = args(2:end);
  end
  if isempty(args) || ~isnumeric(args{1})
    error('Nelson:plotmatrix:numericMatrixExpected', '%s must be a numeric matrix.', 'Value');
  end
  x = double(args{1});
  y = x;
  args = args(2:end);
  if ~isempty(args) && isnumeric(args{1})
    y = double(args{1});
    sameData = false;
    args = args(2:end);
  end
  if ~isempty(args)
    if numel(args) == 1 && (ischar(args{1}) || isStringScalar(args{1}))
      markerSpec = char(args{1});
    else
      error('Nelson:graphics:unsupportedProperty', 'Unsupported "%s" option.', 'plotmatrix');
    end
  end
  if ~ismatrix(x) || ~ismatrix(y)
    error('Nelson:plotmatrix:invalidXAndY', 'X and Y must be matrices.');
  end
end
%=============================================================================
function [histHandles, histAxes] = drawDiagonalHistograms(ax, x)
  n = min(size(ax, 1), size(ax, 2));
  histHandles = gobjects(1, n);
  histAxes = gobjects(1, n);
  for k = 1:n
    pos = ax(k, k).Position;
    histAxes(k) = axes('Position', pos, 'Visible', 'on', 'Tag', 'PlotMatrixHistAx');
    histHandles(k) = histogram(histAxes(k), x(:, k));
    histAxes(k).XTick = [];
    histAxes(k).YTick = [];
    histAxes(k).XGrid = 'off';
    histAxes(k).YGrid = 'off';
  end
end
%=============================================================================
function applyPlotMatrixAxes(ax, row, col, nbRows, nbCols)
  ax.Tag = 'PlotMatrixScatterAx';
  if row < nbRows
    ax.XTickLabel = {};
  end
  if col > 1
    ax.YTickLabel = {};
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = polaraxes(varargin)
  nargoutchk(0, 1);
  inputArguments = convertStringToCharArgs(varargin);
  ax = __polaraxes__(inputArguments{:});
  [fig, previousDrawLater] = polarBeginDrawLater(ax);
  try
    ax = polarInitializeAxes(ax);
    polarEndDrawLater(fig, previousDrawLater);
  catch exception
    polarEndDrawLater(fig, previousDrawLater);
    error(exception.message);
  end
  if nargout == 1
    varargout{1} = ax;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = polarbubblechart(varargin)
  narginchk(3, 1000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  if ~isempty(args) && ~(istable(args{1}) || istimetable(args{1})) ...
      && isscalar(args{1}) && isgraphics(args{1}) ...
      && isgraphics(args{1}, 'axes') && ~isgraphics(args{1}, 'polaraxes')
    error('Nelson:graphics:invalidParentInput', 'Parent input must be a polaraxes object.');
  end
  [ax, args] = polarParseTargetAxes(args);
  ax = ensurePolarAxes(ax);
  if ~isempty(args) && (istable(args{1}) || istimetable(args{1}))
    [theta, radius, bubbleSize, colorData, args, tableArgs] = parseTableBubbleData(args);
  else
    tableArgs = {};
    [theta, radius, bubbleSize, colorData, args] = parseNumericBubbleData(args);
  end
  [chartArgs, rendererArgs] = parseBubbleOptions(args);
  [orientation, nSeries] = getSeriesOrientation(theta, radius, bubbleSize);
  [fig, previousDrawLater] = polarBeginDrawLater(ax);
  try
    ax = polarPrepareDataAxes(ax);
    h = createPolarBubbleSeries(ax, theta, radius, bubbleSize, colorData, orientation, nSeries, chartArgs, tableArgs);
    polarAppendDataHandles(ax, h);
    polarEndDrawLater(fig, previousDrawLater);
  catch exception
    polarEndDrawLater(fig, previousDrawLater);
    error(exception.message);
  end
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function h = createPolarBubbleSeries(ax, theta, radius, bubbleSize, colorData, orientation, nSeries, chartArgs, tableArgs)
  if nSeries == 1
    tk = graphicsSelectSeriesData(theta, orientation, 1, 'row');
    rk = graphicsSelectSeriesData(radius, orientation, 1, 'row');
    sk = graphicsSelectSeriesData(bubbleSize, orientation, 1, 'row');
    ck = graphicsSelectColorSeriesData(colorData, orientation, 1, nSeries, numel(tk), 'row');
    args = [chartArgs, graphicsSelectTableSeriesArgs(tableArgs, 1, nSeries)];
    h = createPolarBubbleObject(ax, tk, rk, sk, ck, args);
    state = struct();
    state.ChartType = 'polarbubblechart';
    state.BubbleSizeData = sk;
    state.Renderer = h;
    h.UserData = state;
    return
  end
  handles = cell(1, nSeries);
  for k = 1:nSeries
    tk = graphicsSelectSeriesData(theta, orientation, k, 'row');
    rk = graphicsSelectSeriesData(radius, orientation, k, 'row');
    sk = graphicsSelectSeriesData(bubbleSize, orientation, k, 'row');
    ck = graphicsSelectColorSeriesData(colorData, orientation, k, nSeries, numel(tk), 'row');
    args = [chartArgs, graphicsSelectTableSeriesArgs(tableArgs, k, nSeries)];
    hk = createPolarBubbleObject(ax, tk, rk, sk, ck, args);
    state = struct();
    state.ChartType = 'polarbubblechart';
    state.BubbleSizeData = sk;
    state.Renderer = hk;
    hk.UserData = state;
    handles{k} = hk;
  end
  h = [handles{:}];
end
%=============================================================================
function ax = ensurePolarAxes(ax)
  if isgraphics(ax, 'polaraxes')
    return
  end
  ax = polarInitializeAxes(ax, false);
end
%=============================================================================
function [theta, radius, bubbleSize, colorData, args] = parseNumericBubbleData(args)
  if numel(args) < 3 || ~isnumeric(args{1}) || ~isnumeric(args{2}) || ~isnumeric(args{3})
    error('Nelson:polarbubblechart:numericThetaRadiusExpected', 'Numeric theta, radius, and bubble size data expected.');
  end
  theta = args{1};
  radius = args{2};
  bubbleSize = args{3};
  args = args(4:end);
  colorData = [];
  if ~isempty(args) && (isnumeric(args{1}) || isColorText(args{1}))
    colorData = normalizeColorData(args{1});
    args = args(2:end);
  end
end
%=============================================================================
function h = createPolarBubbleObject(ax, theta, radius, bubbleSize, colorData, chartArgs)
  if ~isempty(colorData)
    chartArgs = [chartArgs, {'CData', colorData}];
  end
  h = __bubblechart__('Parent', ax, 'XData', [], 'YData', [], ...
    'ThetaData', theta, 'RData', radius, 'SizeData', bubbleSize, chartArgs{:});
end
%=============================================================================
function [chartArgs, rendererArgs] = parseBubbleOptions(args)
  chartArgs = {};
  rendererArgs = {};
  if rem(length(args), 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  for k = 1:2:length(args)
    name = char(args{k});
    value = args{k + 1};
    switch lower(name)
      case 'markeredgecolor'
        chartArgs = [chartArgs, {'MarkerEdgeColor', value}];
        rendererArgs = [rendererArgs, {'MarkerEdgeColor', value}];
      case 'markerfacecolor'
        chartArgs = [chartArgs, {'MarkerFaceColor', value}];
        rendererArgs = [rendererArgs, {'MarkerFaceColor', value}];
      case 'markeredgealpha'
        chartArgs = [chartArgs, {'MarkerEdgeAlpha', value}];
      case 'markerfacealpha'
        chartArgs = [chartArgs, {'MarkerFaceAlpha', value}];
      case 'linewidth'
        chartArgs = [chartArgs, {'LineWidth', value}];
        rendererArgs = [rendererArgs, {'LineWidth', value}];
      case {'displayname', 'visible', 'tag', 'userdata', 'handlevisibility'}
        chartArgs = [chartArgs, {name, value}];
      case 'sourcetable'
        chartArgs = [chartArgs, {'SourceTable', value}];
      case 'thetavariable'
        chartArgs = [chartArgs, {'ThetaVariable', value}];
      case 'rvariable'
        chartArgs = [chartArgs, {'RVariable', value}];
      case 'sizevariable'
        chartArgs = [chartArgs, {'SizeVariable', value}];
      case 'colorvariable'
        chartArgs = [chartArgs, {'ColorVariable', value}];
      otherwise
        error('Nelson:graphics:unsupportedProperty', 'Unsupported "%s" option.', 'polarbubblechart');
    end
  end
end
%=============================================================================
function tf = isColorText(value)
  tf = (ischar(value) || isStringScalar(value)) ...
    && (any(strcmpi(char(value), getColorShortNameList())) || any(strcmpi(char(value), getColorNameList())));
end
%=============================================================================
function colorData = normalizeColorData(value)
  if ischar(value) || isStringScalar(value)
    colorData = validatecolor(value);
  else
    colorData = value;
  end
end
%=============================================================================
function [theta, radius, bubbleSize, colorData, args, tableArgs] = parseTableBubbleData(args)
  tbl = args{1};
  if numel(args) < 4
    error('Nelson:graphics:tableVariableExpected', 'Table variable arguments expected.');
  end
  thetaNames = graphicsTableVariableNames(tbl, args{2});
  radiusNames = graphicsTableVariableNames(tbl, args{3});
  sizeNames = graphicsTableVariableNames(tbl, args{4});
  args = args(5:end);
  colorNames = {};
  if ~isempty(args) && ~isPolarBubblePropertyName(args{1})
    colorNames = graphicsTableVariableNames(tbl, args{1});
    args = args(2:end);
  end
  nSeries = max([numel(thetaNames), numel(radiusNames), numel(sizeNames), max(1, numel(colorNames))]);
  validateTableVariableCounts(thetaNames, radiusNames, sizeNames, colorNames, nSeries);
  [theta, radius, bubbleSize, colorData, tableArgs] ...
    = tableBubbleSeries(tbl, thetaNames, radiusNames, sizeNames, colorNames, nSeries);
end
%=============================================================================
function validateTableVariableCounts(thetaNames, radiusNames, sizeNames, colorNames, nSeries)
  counts = [numel(thetaNames), numel(radiusNames), numel(sizeNames)];
  if ~isempty(colorNames)
    counts(end + 1) = numel(colorNames);
  end
  if any(counts ~= 1 & counts ~= nSeries)
    error('Nelson:dimagree:tableVariableCountsMatch', 'Table variable counts must match.');
  end
end
%=============================================================================
function [theta, radius, bubbleSize, colorData, tableArgs] ...
    = tableBubbleSeries(tbl, thetaNames, radiusNames, sizeNames, colorNames, nSeries)
  theta = [];
  radius = [];
  bubbleSize = [];
  colorData = [];
  tableArgs = cell(1, nSeries);
  for k = 1:nSeries
    thetaName = graphicsSelectName(thetaNames, k);
    radiusName = graphicsSelectName(radiusNames, k);
    sizeName = graphicsSelectName(sizeNames, k);
    theta = graphicsAppendColumn(theta, graphicsNumericColumn(tbl.(thetaName), thetaName));
    radius = graphicsAppendColumn(radius, graphicsNumericColumn(tbl.(radiusName), radiusName));
    bubbleSize = graphicsAppendColumn(bubbleSize, graphicsNumericColumn(tbl.(sizeName), sizeName));
    oneArgs = {'SourceTable', tbl, 'ThetaVariable', thetaName, 'RVariable', radiusName, ...
      'SizeVariable', sizeName};
    if ~isempty(colorNames)
      colorName = graphicsSelectName(colorNames, k);
      colorData = graphicsAppendColumn(colorData, graphicsNumericColumn(tbl.(colorName), colorName));
      oneArgs(end + 1:end + 2) = {'ColorVariable', colorName};
    end
    if nSeries > 1
      oneArgs(end + 1:end + 2) = {'DisplayName', radiusName};
    end
    tableArgs{k} = oneArgs;
  end
end
%=============================================================================
function [orientation, nSeries] = getSeriesOrientation(theta, radius, bubbleSize)
  if isvector(theta) && isvector(radius) && isscalar(bubbleSize)
    orientation = 'points';
    nSeries = numel(theta);
    return
  end
  if isvector(theta) && isvector(radius)
    orientation = 'single';
    nSeries = 1;
    return
  end
  if isvector(theta) && ~isvector(radius)
    rows = size(radius, 1);
    cols = size(radius, 2);
    if numel(theta) == rows && (isscalar(bubbleSize) || (isvector(bubbleSize) && numel(bubbleSize) == rows))
      orientation = 'columns';
      nSeries = cols;
      return
    end
  end
  if ~isvector(theta) && isvector(radius)
    rows = size(theta, 1);
    cols = size(theta, 2);
    if numel(radius) == rows && (isscalar(bubbleSize) || (isvector(bubbleSize) && numel(bubbleSize) == rows))
      orientation = 'columns';
      nSeries = cols;
      return
    end
  end
  if isvector(bubbleSize) && numel(bubbleSize) == numel(theta) && isvector(radius)
    orientation = 'single';
    nSeries = 1;
    return
  end
  rows = size(theta, 1);
  cols = size(theta, 2);
  if isequal(size(bubbleSize), size(theta)) || (isvector(bubbleSize) && numel(bubbleSize) == rows)
    orientation = 'columns';
    nSeries = cols;
  elseif isrow(bubbleSize) && numel(bubbleSize) == cols && rows > 1
    orientation = 'rows';
    nSeries = rows;
  else
    error('Nelson:polarbubblechart:invalidSizeData', 'Size data must match theta and radius data.');
  end
end
%=============================================================================
function tf = isPolarBubblePropertyName(value)
  if ~(ischar(value) || isStringScalar(value))
    tf = false;
    return
  end
  names = {'ColorVariable', 'DisplayName', 'HandleVisibility', 'MarkerEdgeColor', ...
    'MarkerFaceColor', 'MarkerEdgeAlpha', 'MarkerFaceAlpha', 'LineWidth', ...
    'RVariable', 'SizeVariable', 'SourceTable', 'Tag', 'ThetaVariable', ...
    'UserData', 'Visible'};
  tf = any(strcmpi(char(value), names));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
