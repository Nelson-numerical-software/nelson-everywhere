function nhood = ip_connectivity_nhood_2d(conn)
  if conn == 4
    nhood = logical([0 1 0; 1 1 1; 0 1 0]);
  elseif conn == 8
    nhood = true(3, 3);
  else
    error('Nelson:image_processing:unsupportedConnectivity', 'Unsupported connectivity.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
