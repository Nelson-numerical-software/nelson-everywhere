% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
classdef tdigest
  properties (Dependent)
    compression
    totalWeight
  end

  properties (Hidden)
    compressionValue = 100
    totalWeightValue = 0
    means = []
    weights = []
    version = 2.0
  end

  methods
    function obj = tdigest(varargin)
      x = [];
      compression = 100;
      hasData = false;
      narginchk(0, 2);

      if nargin == 1
        arg = varargin{1};
        if isscalar(arg) && isnumeric(arg)
          compression = arg;
        elseif isnumeric(arg)
          x = arg;
          hasData = true;
        else
          error('Nelson:statistics:invalidInputArgumentExpectedNumeric', 'Invalid input argument. Expected a numeric array or a scalar compression value.');
        end
      elseif nargin == 2
        compression = varargin{1};
        x = varargin{2};
        hasData = true;
        tdigest.validateData(x);
      end

      obj.compression = compression;
      obj.totalWeightValue = 0;
      obj.means = [];
      obj.weights = [];
      obj.version = 2.0;

      if hasData
        tdigest.validateData(x);
        obj = obj.addData(x);
      end
    end

    function obj = set.compression(obj, value)
      tdigest.validateCompression(value);
      obj.compressionValue = value;
    end

    function value = get.compression(obj)
      value = obj.compressionValue;
    end

    function obj = set.totalWeight(obj, value)
      if ~isscalar(value) || ~isnumeric(value) || ~isreal(value) || ~isfinite(value) || value < 0
        error('Nelson:statistics:totalWeightNonNegativeScalar', 'Total weight must be a nonnegative scalar number.');
      end
      obj.totalWeightValue = value;
    end

    function value = get.totalWeight(obj)
      value = obj.totalWeightValue;
    end

    function qval = quantile(obj, q)
      if ~isvector(q)
        error('Nelson:validators:mustBeVector', '%s must be a vector.', 'Input quantiles');
      end
      if any(q(:) < 0)
        error('Nelson:statistics:valueLeast0', 'Value must be at least 0.');
      end
      if any(q(:) > 1)
        error('Nelson:statistics:valueLessEqual1', 'Value must be less than or equal to %d.', 1);
      end
      q = q(:);

      if isempty(obj.means)
        qval = NaN(size(q));
        return
      end

      [sortedMeans, idx] = sort(obj.means);
      sortedWeights = obj.weights(idx);

      if length(sortedMeans) == 1
        qval = repmat(sortedMeans(1), size(q));
        return
      end

      cumw = cumsum(sortedWeights);
      centroidPositions = (cumw - sortedWeights / 2) / obj.totalWeight;
      quantilePositions = [0; centroidPositions; 1];
      interpValues = [sortedMeans(1); sortedMeans; sortedMeans(end)];
      qval = interp1(quantilePositions, interpValues, q, 'linear');
      qval = qval(:);
    end

    function qval = percentile(obj, p)
      if any(p(:) < 0)
        error('Nelson:statistics:valueLeast0', 'Value must be at least 0.');
      end
      if any(p(:) > 100)
        error('Nelson:statistics:valueLessEqual100', 'Value must be less than or equal to %d.', 100);
      end
      qval = obj.quantile(p / 100);
    end

    function obj = plus(a, b)
      if isa(a, 'tdigest') && isnumeric(b)
        obj = a.addData(b);
        return
      end
      if isa(b, 'tdigest') && isnumeric(a)
        obj = b.addData(a);
        return
      end
      error('Nelson:statistics:combiningTdigestObjectsAllowedThey', 'Combining ''tdigest'' objects is not allowed as they are designed to be scalar.');
    end

    function obj = compress(obj)
      if isempty(obj.totalWeight) || obj.totalWeight == 0
        return
      end
      if isempty(obj.means) || numel(obj.means) <= 1
        return
      end

      [means, idx] = sort(obj.means);
      weights = obj.weights(idx);

      n = numel(means);
      mergedMeans = zeros(n, 1);
      mergedWeights = zeros(n, 1);
      idxMerged = 1;
      curMean = means(1);
      curWeight = weights(1);
      cumulative = 0;
      totalWeightFactor = 4 * obj.totalWeight / obj.compression;
      invTotalWeight = 1 / obj.totalWeight;

      for k = 2:n
        q = cumulative * invTotalWeight;
        maxWeight = totalWeightFactor * q * (1 - q);
        if curWeight + weights(k) <= maxWeight
          newWeight = curWeight + weights(k);
          curMean = curMean + (means(k) - curMean) * weights(k) / newWeight;
          curWeight = newWeight;
        else
          mergedMeans(idxMerged) = curMean;
          mergedWeights(idxMerged) = curWeight;
          idxMerged = idxMerged + 1;
          curMean = means(k);
          curWeight = weights(k);
        end
        cumulative = cumulative + weights(k);
      end

      mergedMeans(idxMerged) = curMean;
      mergedWeights(idxMerged) = curWeight;
      mergedMeans = mergedMeans(1:idxMerged);
      mergedWeights = mergedWeights(1:idxMerged);

      maxCentroids = ceil(obj.compression);
      while numel(mergedMeans) > maxCentroids && numel(mergedMeans) > 1
        adjSums = mergedWeights(1:end - 1) + mergedWeights(2:end);
        [~, minIdx] = min(adjSums);
        newWeight = mergedWeights(minIdx) + mergedWeights(minIdx + 1);
        newMean = (mergedMeans(minIdx) * mergedWeights(minIdx) ...
          + mergedMeans(minIdx + 1) * mergedWeights(minIdx + 1)) / newWeight;
        mergedMeans(minIdx) = newMean;
        mergedWeights(minIdx) = newWeight;
        mergedMeans(minIdx + 1) = [];
        mergedWeights(minIdx + 1) = [];
      end

      obj.means = mergedMeans;
      obj.weights = mergedWeights;
    end

    function disp(obj)
      fmt = format();
      if strcmp(fmt.LineSpacing, 'loose')
        fprintf('\n');
      end
      fprintf('  tdigest object with compression factor: %d\n', obj.compression);
      fprintf('  Total weight: %d\n', obj.totalWeight);
      fprintf('  Number of centroids: %d\n', length(obj.means));
      if strcmp(fmt.LineSpacing, 'loose')
        fprintf('\n');
      end
    end

    function display(obj, varargin)
      if nargin == 1
        name = inputname(1);
      else
        name = varargin{1};
      end
      fmt = format();
      if strcmp(fmt.LineSpacing, 'loose')
        fprintf('\n');
      end
      if ~isempty(name)
        fprintf('%s = \n', name);
      end
      disp(obj);
    end

    function n = numel(varargin)
      n = 1;
    end

    function obj = horzcat(varargin)
      error('Nelson:statistics:combiningTdigestObjectsAllowedThey', 'Combining ''tdigest'' objects is not allowed as they are designed to be scalar.');
    end

    function obj = vertcat(varargin)
      error('Nelson:statistics:combiningTdigestObjectsAllowedThey', 'Combining ''tdigest'' objects is not allowed as they are designed to be scalar.');
    end
  end

  methods (Access = private)
    function obj = addData(obj, x)
      tdigest.validateData(x);
      valid = x(~isnan(x));
      if isempty(valid)
        return
      end

      needsCompression = obj.shouldCompress();
      obj.means = [obj.means; valid(:)];
      obj.weights = [obj.weights; ones(numel(valid), 1)];
      obj.totalWeight = obj.totalWeight + numel(valid);

      if needsCompression
        obj = obj.compress();
      end
    end

    function tf = shouldCompress(obj)
      threshold = max(obj.compression * 1.5, obj.compression + 50);
      tf = numel(obj.means) > threshold;
    end
  end

  methods (Static, Access = private)
    function validateCompression(value)
      if ~isscalar(value) || ~isnumeric(value) || ~isreal(value) || ~isfinite(value) || value <= 0
        error('Nelson:statistics:compressionParameterPositiveScalarNumber', 'Compression parameter must be a positive scalar number.');
      end
    end

    function validateData(value)
      if ~isnumeric(value) || ~isreal(value)
        error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Data');
      end
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function X = __gmm_check_data__(X)
  if ~(isnumeric(X) && isreal(X) && ~issparse(X) && ndims(X) == 2)
    error('Nelson:statistics:xRealNumericMatrix', '%s must be a real numeric matrix.', 'X');
  end
  X = double(X);
  if isempty(X) || any(~isfinite(X(:)))
    error('Nelson:statistics:xMustBeFinite', '%s must contain finite values.', 'X');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [mu, Sigma, p] = __gmm_check_model__(mu, Sigma, p)
  if nargin < 3 || isempty(p)
    p = ones(1, size(mu, 1)) / size(mu, 1);
  end
  mu = checkMu(mu);
  p = checkProportions(p, size(mu, 1));
  Sigma = checkSigma(Sigma, size(mu, 2), size(mu, 1));
end
%=============================================================================
function mu = checkMu(mu)
  if ~(isnumeric(mu) && isreal(mu) && ~issparse(mu) && ndims(mu) == 2)
    error('Nelson:statistics:MURealNumericMatrix', '%s must be a real numeric matrix.', 'MU');
  end
  mu = double(mu);
  if isempty(mu) || any(~isfinite(mu(:)))
    error('Nelson:statistics:MUContainFiniteValues', '%s must contain finite values.', 'MU');
  end
end
%=============================================================================
function p = checkProportions(p, k)
  if ~(isnumeric(p) && isreal(p) && ~issparse(p) && isvector(p))
    error('Nelson:statistics:componentProportionsNumericVector', 'Component proportions must be a numeric vector.');
  end
  p = double(p(:)');
  if length(p) ~= k || any(~isfinite(p)) || any(p < 0) || sum(p) <= 0
    error('Nelson:statistics:componentProportionsNonnegativeCompatibleMU', 'Component proportions must be nonnegative and compatible with MU.');
  end
  p = p / sum(p);
end
%=============================================================================
function Sigma = checkSigma(Sigma, d, k)
  if ~(isnumeric(Sigma) && isreal(Sigma) && ~issparse(Sigma))
    error('Nelson:statistics:SIGMARealNumericArray', '%s must be a real numeric array.', 'SIGMA');
  end
  Sigma = double(Sigma);
  if any(~isfinite(Sigma(:)))
    error('Nelson:statistics:SIGMAContainFiniteValues', '%s must contain finite values.', 'SIGMA');
  end
  Sigma = normalizeSigmaShape(Sigma, d, k);
  for j = 1:k
    if min(eig(Sigma(:, :, j))) <= 0
      error('Nelson:statistics:SIGMAContainPositiveDefiniteCovariance', 'SIGMA must contain positive definite covariance matrices.');
    end
  end
end
%=============================================================================
function Sigma = normalizeSigmaShape(Sigma, d, k)
  if isvector(Sigma) && length(Sigma) == d
    Sigma = repmat(diag(Sigma(:)), [1 1 k]);
  elseif ndims(Sigma) == 2 && isequal(size(Sigma), [d k])
    Sigma = diagonalPages(Sigma);
  elseif ndims(Sigma) == 2 && isequal(size(Sigma), [d d])
    Sigma = repmat(Sigma, [1 1 k]);
  elseif ndims(Sigma) == 3 && isequal(size(Sigma), [d d k])
    return
  else
    error('Nelson:statistics:SIGMAIncompatibleSize', '%s has incompatible size.', 'SIGMA');
  end
end
%=============================================================================
function pages = diagonalPages(values)
  d = size(values, 1);
  k = size(values, 2);
  pages = zeros(d, d, k);
  for j = 1:k
    pages(:, :, j) = diag(values(:, j));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [P, nlogL, y] = __gmm_responsibilities__(X, mu, Sigma, p)
  [weighted, ~] = __gmm_weighted_density__(X, mu, Sigma, p);
  y = weighted * ones(size(weighted, 2), 1);
  safe = max(y, realmin);
  P = weighted ./ repmat(safe, 1, size(weighted, 2));
  nlogL = -sum(log(safe));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [weighted, density] = __gmm_weighted_density__(X, mu, Sigma, p)
  X = __gmm_check_data__(X);
  [mu, Sigma, p] = __gmm_check_model__(mu, Sigma, p);
  if size(X, 2) ~= size(mu, 2)
    error('Nelson:statistics:xSameNumberColumnsMU', 'X must have the same number of columns as %s.', 'MU');
  end
  n = size(X, 1);
  k = size(mu, 1);
  density = zeros(n, k);
  for j = 1:k
    density(:, j) = componentDensity(X, mu(j, :), Sigma(:, :, j));
  end
  weighted = density .* repmat(p, n, 1);
end
%=============================================================================
function y = componentDensity(X, center, covariance)
  d = size(X, 2);
  R = chol(covariance);
  centered = X - repmat(center, size(X, 1), 1);
  z = centered / R;
  q = (z .* z) * ones(size(z, 2), 1);
  scale = (2 * pi) ^ (d / 2) * prod(diag(R));
  y = exp(-0.5 * q) / scale;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [h, p, adstat, cv] = adtest(x, varargin)
  narginchk(1, Inf);
  nargoutchk(0, 4);
  opts = parseOptionsLocal(convertStringToCharArgs(varargin));
  values = validateSampleLocal(x);
  probabilities = fittedProbabilitiesLocal(values, opts.Distribution);
  adstat = andersonDarlingStatisticLocal(probabilities);
  adjusted = adjustedStatisticLocal(adstat, length(probabilities), opts.Asymptotic);
  p = adPValueLocal(adjusted);
  cv = criticalValueLocal(opts.Alpha, length(probabilities), opts.Asymptotic);
  h = p <= opts.Alpha;
  opts.MCTol;
end
%=============================================================================
function opts = parseOptionsLocal(args)
  opts = struct('Alpha', 0.05, 'Distribution', 'norm', 'MCTol', [], 'Asymptotic', false);
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  names = {'alpha', 'distribution', 'mctol', 'asymptotic'};
  k = 1;
  while k <= length(args)
    name = matchedNameLocal(args{k}, names);
    switch name
      case 'alpha'
        opts.Alpha = scalarInRangeLocal(args{k + 1}, 'ALPHA');
      case 'distribution'
        opts.Distribution = distributionNameLocal(args{k + 1});
      case 'mctol'
        opts.MCTol = positiveScalarLocal(args{k + 1}, 'MCTOL');
      case 'asymptotic'
        opts.Asymptotic = logicalScalarLocal(args{k + 1}, 'ASYMPTOTIC');
    end
    k = k + 2;
  end
  if opts.Asymptotic && ~isempty(opts.MCTol)
    error('Nelson:statistics:ASYMPTOTICFalseMCTOLSpecified', 'ASYMPTOTIC must be false when MCTOL is specified.');
  end
end
%=============================================================================
function name = matchedNameLocal(value, names)
  if ~(ischar(value) || (isstring(value) && isscalar(value)))
    error('Nelson:statistics:nameValueArgumentNameText', 'Name-value argument name must be text.');
  end
  text = lower(char(value));
  matches = names(startsWith(names, text));
  if length(matches) ~= 1
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
  name = matches{1};
end
%=============================================================================
function name = distributionNameLocal(value)
  if ~(ischar(value) || (isstring(value) && isscalar(value)))
    error('Nelson:statistics:DISTRIBUTIONText', 'DISTRIBUTION must be text.');
  end
  text = lower(char(value));
  switch text
    case {'normal', 'norm'}
      name = 'norm';
    case {'exponential', 'exp'}
      name = 'exp';
    case {'extreme value', 'ev', 'extremevalue'}
      name = 'ev';
    case {'lognormal', 'logn'}
      name = 'logn';
    case {'weibull', 'wbl'}
      name = 'weibull';
    otherwise
      error('Nelson:statistics:DISTRIBUTIONUnsupportedValue', '%s has an unsupported value.', 'DISTRIBUTION');
  end
end
%=============================================================================
function values = validateSampleLocal(x)
  if ~(isnumeric(x) && isreal(x) && ~issparse(x) && isvector(x))
    error('Nelson:statistics:xRealNumericVector', '%s must be a real numeric vector.', 'X');
  end
  values = double(x(:));
  values = values(~isnan(values));
  if length(values) < 3
    error('Nelson:statistics:xContainLeastThreeNon', 'X must contain at least three non-NaN observations.');
  end
end
%=============================================================================
function probabilities = fittedProbabilitiesLocal(values, distribution)
  values = sort(values(:));
  switch distribution
    case 'norm'
      probabilities = normalProbabilitiesLocal(values);
    case 'exp'
      if any(values < 0)
        error('Nelson:statistics:xNonnegativeExponentialDistribution', 'X must be nonnegative for the exponential distribution.');
      end
      probabilities = 1 - exp(-values / mean(values));
    case 'ev'
      probabilities = extremeValueProbabilitiesLocal(values);
    case 'logn'
      if any(values <= 0)
        error('Nelson:statistics:xPositiveLognormalDistribution', 'X must be positive for the %s distribution.', 'lognormal');
      end
      probabilities = normalProbabilitiesLocal(log(values));
    otherwise
      if any(values <= 0)
        error('Nelson:statistics:xPositiveWeibullDistribution', 'X must be positive for the %s distribution.', 'Weibull');
      end
      probabilities = extremeValueProbabilitiesLocal(log(values));
  end
  probabilities = min(max(probabilities, realmin), 1 - eps);
end
%=============================================================================
function probabilities = normalProbabilitiesLocal(values)
  sigma = std(values, 0);
  if sigma <= 0
    probabilities = 0.5 * ones(size(values));
  else
    probabilities = normcdf((values - mean(values)) / sigma);
  end
end
%=============================================================================
function probabilities = extremeValueProbabilitiesLocal(values)
  sigma = std(values, 0) * sqrt(6) / pi;
  if sigma <= 0
    probabilities = 0.5 * ones(size(values));
  else
    mu = mean(values) - 0.577215664901533 * sigma;
    probabilities = 1 - exp(-exp((values - mu) / sigma));
  end
end
%=============================================================================
function adstat = andersonDarlingStatisticLocal(probabilities)
  n = length(probabilities);
  weights = (2 * (1:n)' - 1) / n;
  adstat = -n - sum(weights .* (log(probabilities) + log(1 - probabilities(end:-1:1))));
end
%=============================================================================
function adjusted = adjustedStatisticLocal(adstat, n, asymptotic)
  if asymptotic
    adjusted = adstat;
  else
    adjusted = adstat * (1 + 0.75 / n + 2.25 / (n ^ 2));
  end
end
%=============================================================================
function p = adPValueLocal(a)
  if a < 0.2
    p = 1 - exp(-13.436 + 101.14 * a - 223.73 * a ^ 2);
  elseif a < 0.34
    p = 1 - exp(-8.318 + 42.796 * a - 59.938 * a ^ 2);
  elseif a < 0.6
    p = exp(0.9177 - 4.279 * a - 1.38 * a ^ 2);
  else
    p = exp(1.2937 - 5.709 * a + 0.0186 * a ^ 2);
  end
  p = min(max(p, 0), 1);
end
%=============================================================================
function cv = criticalValueLocal(alpha, n, asymptotic)
  lo = 0;
  hi = 10;
  for k = 1:80
    mid = (lo + hi) / 2;
    adjusted = adjustedStatisticLocal(mid, n, asymptotic);
    if adPValueLocal(adjusted) > alpha
      lo = mid;
    else
      hi = mid;
    end
  end
  cv = hi;
end
%=============================================================================
function value = scalarInRangeLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && value > 0 && value < 1)
    error('Nelson:statistics:mustBeInRange', '%s must be a scalar in the range (0,1).', name);
  end
  value = double(value);
end
%=============================================================================
function value = positiveScalarLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && value > 0)
    error('Nelson:statistics:mustBePositive', '%s must be a positive scalar.', name);
  end
  value = double(value);
end
%=============================================================================
function value = logicalScalarLocal(value, name)
  if ~(islogical(value) && isscalar(value))
    error('Nelson:validators:mustBeLogicalScalar', '%s must be a logical scalar.', name);
  end
  value = logical(value);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [p, tbl, stats] = anova1(X, group, displayopt)
  narginchk(1, 3);
  nargoutchk(0, 3);
  hasDisplay = nargin >= 3;
  if nargin < 2
    group = [];
  elseif nargin == 2 && isDisplayOptionLocal(group)
    displayopt = group;
    group = [];
    hasDisplay = true;
  end
  if ~hasDisplay
    displayopt = 'on';
  end
  displayopt = parseDisplayLocal(displayopt);
  [values, labels] = groupedValuesLocal(X, group);
  result = anovaTableLocal(values, labels);
  p = result.p;
  tbl = result.tbl;
  stats = result.stats;
  if strcmp(displayopt, 'on')
    disp(tbl);
  end
end
%=============================================================================
function [values, labels] = groupedValuesLocal(X, group)
  if ~(isnumeric(X) && isreal(X) && ~issparse(X) && ndims(X) == 2)
    error('Nelson:statistics:xRealNumericVectorMatrix', '%s must be a real numeric vector or matrix.', 'X');
  end
  X = double(X);
  if isempty(group)
    [values, labels] = matrixGroupsLocal(X);
  else
    [values, labels] = explicitGroupsLocal(X, group);
  end
end
%=============================================================================
function [values, labels] = matrixGroupsLocal(X)
  ncols = size(X, 2);
  values = X(:);
  groupIndex = reshape(repmat(1:ncols, size(X, 1), 1), [], 1);
  labels = cell(ncols, 1);
  for k = 1:ncols
    labels{k} = int2str(k);
  end
  keep = ~isnan(values);
  values = values(keep);
  groupIndex = groupIndex(keep);
  [values, labels] = compactGroupsLocal(values, groupIndex, labels);
end
%=============================================================================
function [values, labels] = explicitGroupsLocal(X, group)
  if isvector(X)
    values = X(:);
    [codes, labels, keep] = groupCodesLocal(group, numel(values));
  else
    labelsByColumn = inputLabelsLocal(group, size(X, 2));
    values = X(:);
    columnCodes = reshape(repmat((1:size(X, 2)), size(X, 1), 1), [], 1);
    groupValues = labelsByColumn(columnCodes);
    [codes, labels, keep] = groupCodesFromLabelsLocal(groupValues);
  end
  keep = keep & ~isnan(values);
  values = values(keep);
  codes = codes(keep);
  [values, labels] = compactGroupsLocal(values, codes, labels);
end
%=============================================================================
function [values, labels] = compactGroupsLocal(values, codes, labels)
  counts = zeros(length(labels), 1);
  for k = 1:length(labels)
    counts(k) = sum(codes == k);
  end
  keepGroups = counts > 0;
  map = zeros(length(labels), 1);
  map(keepGroups) = 1:sum(keepGroups);
  labels = labels(keepGroups);
  codes = map(codes);
  codes = codes(:);
  values = [values(:), codes];
end
%=============================================================================
function [codes, labels, keep] = groupCodesLocal(group, n)
  rawLabels = inputLabelsLocal(group, n);
  [codes, labels, keep] = groupCodesFromLabelsLocal(rawLabels);
end
%=============================================================================
function [codes, labels, keep] = groupCodesFromLabelsLocal(rawLabels)
  keep = ~strcmp(rawLabels(:), '#<missing>');
  [labels, ~, ic] = unique(rawLabels(keep));
  codes = zeros(length(rawLabels), 1);
  codes(keep) = ic(:);
end
%=============================================================================
function labels = inputLabelsLocal(group, n)
  if iscategorical(group)
    labels = cellstr(group(:));
    labels(strcmp(labels, '<undefined>')) = {'#<missing>'};
  elseif isstring(group)
    labels = cellstr(group(:));
  elseif ischar(group)
    labels = cellstr(group);
  elseif iscellstr(group)
    labels = group(:);
  elseif isnumeric(group) || islogical(group)
    flat = group(:);
    labels = cell(length(flat), 1);
    for k = 1:length(flat)
      if isnumeric(flat) && isnan(flat(k))
        labels{k} = '#<missing>';
      else
        labels{k} = mat2str(flat(k));
      end
    end
  else
    error('Nelson:statistics:GROUPVectorTextArray', '%s must be a vector or text array.', 'GROUP');
  end
  if length(labels) ~= n
    error('Nelson:statistics:GROUPExpectedNumberLabels', 'GROUP must have the expected number of labels.');
  end
end
%=============================================================================
function result = anovaTableLocal(grouped, labels)
  values = grouped(:, 1);
  codes = grouped(:, 2);
  ngroups = length(labels);
  if ngroups < 2 || length(values) <= ngroups
    error('Nelson:statistics:leastTwoGroupsMoreObservations', 'At least two groups with more observations than groups are required.');
  end
  [counts, means, ssw] = groupSummaryLocal(values, codes, ngroups);
  grandMean = sum(values) / length(values);
  ssb = sum(counts .* (means - grandMean) .^ 2);
  sst = sum((values - grandMean) .^ 2);
  dfb = ngroups - 1;
  dfw = length(values) - ngroups;
  msb = ssb / dfb;
  msw = ssw / dfw;
  fstat = msb / msw;
  p = fcdf(fstat, dfb, dfw, 'upper');
  result.tbl = cellTableLocal(ssb, ssw, sst, dfb, dfw, msb, msw, fstat, p);
  result.p = p;
  result.stats = struct('gnames', {labels(:)}, 'n', counts(:)', 'source', 'anova1', ...
    'means', means(:)', 'df', dfw, 's', sqrt(msw));
end
%=============================================================================
function [counts, means, ssw] = groupSummaryLocal(values, codes, ngroups)
  counts = zeros(ngroups, 1);
  sums = zeros(ngroups, 1);
  sumsquares = zeros(ngroups, 1);
  for k = 1:ngroups
    rows = codes == k;
    counts(k) = sum(rows);
    sums(k) = sum(values(rows));
    sumsquares(k) = sum(values(rows) .^ 2);
  end
  means = sums ./ counts;
  ssw = sum(sumsquares - counts .* means .^ 2);
  if ssw < 0 && abs(ssw) < 100 * eps(max(sumsquares))
    ssw = 0;
  end
end
%=============================================================================
function tbl = cellTableLocal(ssb, ssw, sst, dfb, dfw, msb, msw, fstat, p)
  tbl = {'Source', 'SS', 'df', 'MS', 'F', 'Prob>F'; ...
         'Groups', ssb, dfb, msb, fstat, p; ...
         'Error', ssw, dfw, msw, [], []; ...
         'Total', sst, dfb + dfw, [], [], []};
end
%=============================================================================
function opt = parseDisplayLocal(value)
  if ~isDisplayOptionLocal(value)
    error('Nelson:statistics:displayOptionOff', 'Display option must be ''on'' or ''off''.');
  end
  opt = lower(char(value));
end
%=============================================================================
function tf = isDisplayOptionLocal(value)
  tf = false;
  if isTextScalarLocal(value)
    text = lower(char(value));
    tf = strcmp(text, 'on') || strcmp(text, 'off');
  end
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [p, tbl, stats] = anova2(Y, reps, displayopt)
  narginchk(1, 3);
  nargoutchk(0, 3);
  hasDisplay = nargin >= 3;
  if nargin < 2
    reps = 1;
  elseif nargin == 2 && isDisplayOptionLocal(reps)
    displayopt = reps;
    reps = 1;
    hasDisplay = true;
  end
  if ~hasDisplay
    displayopt = 'on';
  end
  displayopt = parseDisplayLocal(displayopt);
  Y = validateDataLocal(Y);
  reps = validateRepsLocal(reps, size(Y, 1));
  result = anova2TableLocal(Y, reps);
  p = result.p;
  tbl = result.tbl;
  stats = result.stats;
  if strcmp(displayopt, 'on')
    disp(tbl);
  end
end
%=============================================================================
function Y = validateDataLocal(Y)
  if ~(isnumeric(Y) && isreal(Y) && ~issparse(Y) && ndims(Y) == 2)
    error('Nelson:statistics:yRealNumericMatrix', '%s must be a real numeric matrix.', 'Y');
  end
  Y = double(Y);
  if isempty(Y) || any(~isfinite(Y(:)))
    error('Nelson:statistics:yContainFiniteObservations', 'Y must contain finite observations.');
  end
  if size(Y, 1) < 2 || size(Y, 2) < 2
    error('Nelson:statistics:yLeastTwoRowsTwo', '%s must have at least two rows and two columns.', 'Y');
  end
end
%=============================================================================
function reps = validateRepsLocal(reps, nrows)
  if ~(isnumeric(reps) && isreal(reps) && isscalar(reps) && isfinite(reps) ...
      && reps >= 1 && floor(reps) == reps)
    error('Nelson:statistics:REPSPositiveIntegerScalar', '%s must be a positive integer scalar.', 'REPS');
  end
  reps = double(reps);
  if rem(nrows, reps) ~= 0
    error('Nelson:statistics:numberRowsYMultipleREPS', '%s must be a multiple of REPS.', 'The number of rows in Y');
  end
  if nrows / reps < 2
    error('Nelson:statistics:yContainLeastTwoRow', 'Y must contain at least two row-factor levels.');
  end
end
%=============================================================================
function result = anova2TableLocal(Y, reps)
  nRowLevels = size(Y, 1) / reps;
  nColLevels = size(Y, 2);
  grandMean = sum(Y(:)) / numel(Y);
  if reps == 1
    result = noReplicationLocal(Y, grandMean);
  else
    result = replicatedLocal(Y, reps, nRowLevels, nColLevels, grandMean);
  end
end
%=============================================================================
function result = noReplicationLocal(Y, grandMean)
  nRows = size(Y, 1);
  nCols = size(Y, 2);
  rowMeans = (Y * ones(nCols, 1)) / nCols;
  colMeans = (ones(1, nRows) * Y) / nRows;
  ssRows = nCols * sum((rowMeans - grandMean) .^ 2);
  ssCols = nRows * sum((colMeans - grandMean) .^ 2);
  ssTotal = sum((Y(:) - grandMean) .^ 2);
  ssError = ssTotal - ssRows - ssCols;
  [dfRows, dfCols, dfError] = noReplicationDfLocal(nRows, nCols);
  [msRows, msCols, msError, fRows, fCols, pRows, pCols] = ...
    ratiosLocal(ssRows, ssCols, ssError, dfRows, dfCols, dfError);
  result.p = [pCols, pRows];
  result.tbl = {'Source', 'SS', 'df', 'MS', 'F', 'Prob>F'; ...
                'Columns', ssCols, dfCols, msCols, fCols, pCols; ...
                'Rows', ssRows, dfRows, msRows, fRows, pRows; ...
                'Error', ssError, dfError, msError, [], []; ...
                'Total', ssTotal, nRows * nCols - 1, [], [], []};
  result.stats = statsLocal(rowMeans(:)', colMeans(:), [], msError, dfError);
end
%=============================================================================
function [dfRows, dfCols, dfError] = noReplicationDfLocal(nRows, nCols)
  dfRows = nRows - 1;
  dfCols = nCols - 1;
  dfError = dfRows * dfCols;
end
%=============================================================================
function result = replicatedLocal(Y, reps, nRowLevels, nColLevels, grandMean)
  [cellMeans, rowMeans, colMeans, ssError] = replicatedMeansLocal(Y, reps, nRowLevels, nColLevels);
  ssRows = nColLevels * reps * sum((rowMeans - grandMean) .^ 2);
  ssCols = nRowLevels * reps * sum((colMeans - grandMean) .^ 2);
  ssInteraction = reps * interactionSumLocal(cellMeans, rowMeans, colMeans, grandMean);
  ssTotal = sum((Y(:) - grandMean) .^ 2);
  [dfRows, dfCols, dfInteraction, dfError] = replicatedDfLocal(nRowLevels, nColLevels, reps);
  msRows = ssRows / dfRows;
  msCols = ssCols / dfCols;
  msInteraction = ssInteraction / dfInteraction;
  msError = ssError / dfError;
  fRows = msRows / msError;
  fCols = msCols / msError;
  fInteraction = msInteraction / msError;
  pRows = fcdf(fRows, dfRows, dfError, 'upper');
  pCols = fcdf(fCols, dfCols, dfError, 'upper');
  pInteraction = fcdf(fInteraction, dfInteraction, dfError, 'upper');
  result.p = [pCols, pRows, pInteraction];
  result.tbl = replicatedTableLocal(ssCols, ssRows, ssInteraction, ssError, ssTotal, ...
    dfCols, dfRows, dfInteraction, dfError, msCols, msRows, msInteraction, msError, ...
    fCols, fRows, fInteraction, pCols, pRows, pInteraction);
  result.stats = statsLocal(rowMeans(:)', colMeans(:), cellMeans, msError, dfError);
end
%=============================================================================
function [cellMeans, rowMeans, colMeans, ssError] = replicatedMeansLocal(Y, reps, nRows, nCols)
  cellMeans = zeros(nRows, nCols);
  rowSums = zeros(nRows, 1);
  colSums = zeros(1, nCols);
  ssError = 0;
  for i = 1:nRows
    rows = (i - 1) * reps + 1:i * reps;
    block = Y(rows, :);
    cellMeans(i, :) = (ones(1, reps) * block) / reps;
    rowSums(i) = sum(block(:));
    colSums = colSums + ones(1, reps) * block;
    centered = block - repmat(cellMeans(i, :), reps, 1);
    ssError = ssError + sum(centered(:) .^ 2);
  end
  rowMeans = rowSums / (nCols * reps);
  colMeans = colSums / (nRows * reps);
end
%=============================================================================
function value = interactionSumLocal(cellMeans, rowMeans, colMeans, grandMean)
  value = 0;
  for i = 1:size(cellMeans, 1)
    delta = cellMeans(i, :) - rowMeans(i) - colMeans + grandMean;
    value = value + sum(delta .^ 2);
  end
end
%=============================================================================
function [dfRows, dfCols, dfInteraction, dfError] = replicatedDfLocal(nRows, nCols, reps)
  dfRows = nRows - 1;
  dfCols = nCols - 1;
  dfInteraction = dfRows * dfCols;
  dfError = nRows * nCols * (reps - 1);
end
%=============================================================================
function [msRows, msCols, msError, fRows, fCols, pRows, pCols] = ...
    ratiosLocal(ssRows, ssCols, ssError, dfRows, dfCols, dfError)
  msRows = ssRows / dfRows;
  msCols = ssCols / dfCols;
  msError = ssError / dfError;
  fRows = msRows / msError;
  fCols = msCols / msError;
  pRows = fcdf(fRows, dfRows, dfError, 'upper');
  pCols = fcdf(fCols, dfCols, dfError, 'upper');
end
%=============================================================================
function tbl = replicatedTableLocal(ssCols, ssRows, ssInter, ssError, ssTotal, dfCols, ...
    dfRows, dfInter, dfError, msCols, msRows, msInter, msError, fCols, fRows, fInter, ...
    pCols, pRows, pInter)
  tbl = {'Source', 'SS', 'df', 'MS', 'F', 'Prob>F'; ...
         'Columns', ssCols, dfCols, msCols, fCols, pCols; ...
         'Rows', ssRows, dfRows, msRows, fRows, pRows; ...
         'Interaction', ssInter, dfInter, msInter, fInter, pInter; ...
         'Error', ssError, dfError, msError, [], []; ...
         'Total', ssTotal, dfCols + dfRows + dfInter + dfError, [], [], []};
end
%=============================================================================
function stats = statsLocal(rowMeans, colMeans, cellMeans, mse, dfe)
  stats = struct('source', 'anova2', 'sigmasq', mse, 'df', dfe, ...
    'rowmeans', rowMeans, 'colmeans', colMeans, 'cellmeans', cellMeans);
end
%=============================================================================
function opt = parseDisplayLocal(value)
  if ~isDisplayOptionLocal(value)
    error('Nelson:statistics:displayOptionOff', 'Display option must be ''on'' or ''off''.');
  end
  opt = lower(char(value));
end
%=============================================================================
function tf = isDisplayOptionLocal(value)
  tf = false;
  if isTextScalarLocal(value)
    text = lower(char(value));
    tf = strcmp(text, 'on') || strcmp(text, 'off');
  end
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [h, p, stats] = ansaribradley(x, y, varargin)
  narginchk(2, Inf);
  nargoutchk(0, 3);
  opts = parseOptionsLocal(convertStringToCharArgs(varargin), x);
  [xr, yr, outSize, perm] = reshapeInputsLocal(x, y, opts.Dim);
  cols = size(xr, 2);
  hvals = false(1, cols);
  pvals = NaN(1, cols);
  wvals = NaN(1, cols);
  zvals = NaN(1, cols);
  for k = 1:cols
    [hvals(k), pvals(k), wvals(k), zvals(k)] = ansariVectorLocal(xr(:, k), yr(:, k), opts);
  end
  h = ipermute(reshape(hvals, outSize), perm);
  p = ipermute(reshape(pvals, outSize), perm);
  stats = struct('W', ipermute(reshape(wvals, outSize), perm), ...
    'Wstar', ipermute(reshape(zvals, outSize), perm));
end
%=============================================================================
function opts = parseOptionsLocal(args, x)
  opts = struct('Alpha', 0.05, 'Tail', 'both', 'Method', 'auto', ...
    'Dim', firstNonsingletonLocal(size(x)));
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  for k = 1:2:length(args)
    if ~isTextScalarLocal(args{k})
      error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Name');
    end
    name = lower(char(args{k}));
    switch name
      case 'alpha'
        opts.Alpha = parseAlphaLocal(args{k + 1});
      case 'tail'
        opts.Tail = parseChoiceLocal(args{k + 1}, {'both', 'right', 'left'}, 'TAIL');
      case 'method'
        opts.Method = parseChoiceLocal(args{k + 1}, {'auto', 'exact', 'approximate'}, 'METHOD');
      case 'dim'
        opts.Dim = parseDimLocal(args{k + 1});
      otherwise
        error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
    end
  end
end
%=============================================================================
function [xr, yr, outSize, perm] = reshapeInputsLocal(x, y, dim)
  validateArrayLocal(x, 'X');
  validateArrayLocal(y, 'Y');
  if isvector(x) && isvector(y)
    xr = double(x(:));
    yr = double(y(:));
    outSize = [1 1];
    perm = [1 2];
    return
  end
  sx = size(x);
  sy = size(y);
  nd = max([length(sx), length(sy), dim]);
  sx(end + 1:nd) = 1;
  sy(end + 1:nd) = 1;
  keep = true(1, nd);
  keep(dim) = false;
  if any(sx(keep) ~= sy(keep))
    error('Nelson:statistics:xYCompatibleSizesOutside', 'X and Y must have %s.', 'compatible sizes outside the test dimension');
  end
  perm = 1:nd;
  perm([1 dim]) = [dim 1];
  xp = permute(double(x), perm);
  yp = permute(double(y), perm);
  psx = size(xp);
  psy = size(yp);
  psx(end + 1:nd) = 1;
  psy(end + 1:nd) = 1;
  xr = reshape(xp, psx(1), prod(psx(2:end)));
  yr = reshape(yp, psy(1), prod(psy(2:end)));
  outSize = psx;
  outSize(1) = 1;
end
%=============================================================================
function [h, p, w, z] = ansariVectorLocal(x, y, opts)
  x = x(~isnan(x));
  y = y(~isnan(y));
  if isempty(x) || isempty(y)
    error('Nelson:statistics:xYContainLeastOne', '%s must contain at least one non-NaN observation.', 'X and Y');
  end
  [w, scores, labels, hasTies] = ansariStatisticLocal(x, y);
  z = zStatisticLocal(w, scores, length(x), length(y));
  method = selectMethodLocal(opts.Method, length(x) + length(y), hasTies);
  if strcmp(method, 'exact')
    p = exactPValueLocal(w, scores, length(x), opts.Tail);
  else
    p = approximatePValueLocal(z, opts.Tail);
  end
  h = p <= opts.Alpha;
  labels;
end
%=============================================================================
function [w, scores, labels, hasTies] = ansariStatisticLocal(x, y)
  n1 = length(x);
  values = [x(:); y(:)];
  labels = [ones(n1, 1); zeros(length(y), 1)];
  [scores, hasTies] = ansariScoresLocal(values);
  w = sum(scores(labels == 1));
end
%=============================================================================
function [scores, hasTies] = ansariScoresLocal(values)
  [sortedValues, order] = sort(values(:));
  n = length(sortedValues);
  base = min((1:n)', (n:-1:1)');
  scores = zeros(n, 1);
  hasTies = false;
  starts = [1; find(diff(sortedValues) ~= 0) + 1];
  stops = [starts(2:end) - 1; n];
  for k = 1:length(starts)
    rows = starts(k):stops(k);
    scores(order(rows)) = mean(base(rows));
    hasTies = hasTies || length(rows) > 1;
  end
end
%=============================================================================
function z = zStatisticLocal(w, scores, n1, n2)
  n = n1 + n2;
  meanScore = mean(scores);
  mu = n1 * meanScore;
  variance = n1 * n2 / (n * (n - 1)) * sum((scores - meanScore) .^ 2);
  if variance <= 0
    z = 0;
  else
    z = (w - mu) / sqrt(variance);
  end
end
%=============================================================================
function method = selectMethodLocal(method, n, hasTies)
  if strcmp(method, 'exact') && hasTies
    error('Nelson:statistics:exactMethodSupportedTiesPresent', 'Exact method is not supported when ties are present.');
  end
  if strcmp(method, 'auto')
    if n <= 25 && ~hasTies
      method = 'exact';
    else
      method = 'approximate';
    end
  end
end
%=============================================================================
function p = approximatePValueLocal(z, tail)
  switch tail
    case 'right'
      p = normcdf(z, 0, 1);
    case 'left'
      p = normcdf(z, 0, 1, 'upper');
    otherwise
      p = 2 * normcdf(-abs(z), 0, 1);
  end
end
%=============================================================================
function p = exactPValueLocal(w, scores, n1, tail)
  scaled = round(scores(:)' * 2);
  target = round(w * 2);
  maxSum = sum(scaled);
  states = zeros(n1 + 1, maxSum + 1);
  states(1, 1) = 1;
  for value = scaled
    for k = n1:-1:1
      states(k + 1, value + 1:end) = states(k + 1, value + 1:end) ...
        + states(k, 1:end - value);
    end
  end
  counts = states(n1 + 1, :);
  idx = target + 1;
  total = sum(counts);
  switch tail
    case 'right'
      p = sum(counts(1:idx)) / total;
    case 'left'
      p = sum(counts(idx:end)) / total;
    otherwise
      lo = sum(counts(1:idx)) / total;
      hi = sum(counts(idx:end)) / total;
      p = min(1, 2 * min(lo, hi));
  end
end
%=============================================================================
function validateArrayLocal(x, name)
  if ~(isnumeric(x) && isreal(x) && ~issparse(x))
    error('Nelson:statistics:mustBeRealNumeric', '%s must be a real numeric array.', name);
  end
end
%=============================================================================
function value = parseAlphaLocal(value)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) ...
      && value > 0 && value < 1)
    error('Nelson:statistics:alphaOutOfRange', '%s must be a scalar in the range (0,1).', 'ALPHA');
  end
  value = double(value);
end
%=============================================================================
function value = parseDimLocal(value)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && value == fix(value) && value >= 1)
    error('Nelson:statistics:dimensionArgumentPositiveIntegerScalar:valueAPositiveIntegerScalar', '%s must be a positive integer scalar.', 'Dimension argument');
  end
  value = double(value);
end
%=============================================================================
function value = parseChoiceLocal(value, choices, name)
  if ~isTextScalarLocal(value)
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', name);
  end
  text = lower(char(value));
  matches = choices(startsWith(choices, text));
  if length(matches) ~= 1
    error('Nelson:statistics:invalidValue:valueHasUnsupportedValue', '%s has an unsupported value.', name);
  end
  value = matches{1};
end
%=============================================================================
function dim = firstNonsingletonLocal(sz)
  dim = 1;
  for k = 1:length(sz)
    if sz(k) ~= 1
      dim = k;
      return
    end
  end
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [ci, bootstat] = bootci(varargin)
  narginchk(3, Inf);
  nargoutchk(0, 2);

  nboot = positiveInteger(varargin{1}, sprintf(_('%s must be a positive integer scalar.'), 'NBOOT'));
  [bootfun, dataArgs, nv] = parseInputs(varargin(2:end));
  opts = parseOptions(nv);
  [n, sampleMask, dataArgs] = validateData(dataArgs);
  original = statisticRow(bootfun, dataArgs);
  bootstat = zeros(nboot, length(original));

  for b = 1:nboot
    indices = sampleIndices(n, opts.Weights);
    bootArgs = makeBootstrapArgs(dataArgs, sampleMask, indices);
    bootstat(b, :) = statisticRow(bootfun, bootArgs);
  end

  alpha = opts.Alpha;
  switch opts.Type
    case 'norm'
      ci = normalInterval(bootstat, original, alpha);
    case 'per'
      ci = percentileInterval(bootstat, alpha / 2, 1 - alpha / 2);
    case 'cper'
      ci = correctedPercentileInterval(bootstat, original, alpha);
    case 'bca'
      ci = bcaInterval(bootfun, dataArgs, sampleMask, bootstat, original, alpha);
    otherwise
      error('Nelson:statistics:studentizedBootstrapConfidenceIntervalsYet', 'Studentized bootstrap confidence intervals are not yet supported.');
  end
end
%=============================================================================
function [bootfun, dataArgs, nv] = parseInputs(args)
  if iscell(args{1})
    bootSpec = args{1};
    if isempty(bootSpec) || ~isa(bootSpec{1}, 'function_handle')
      error('Nelson:statistics:BOOTFUNFunctionHandle', '%s must be a function handle.', 'BOOTFUN');
    end
    bootfun = bootSpec{1};
    dataArgs = bootSpec(2:end);
    nv = args(2:end);
  else
    if ~isa(args{1}, 'function_handle')
      error('Nelson:statistics:BOOTFUNFunctionHandle', '%s must be a function handle.', 'BOOTFUN');
    end
    bootfun = args{1};
    firstNameValue = length(args) + 1;
    for k = 2:length(args)
      if isTextScalar(args{k})
        firstNameValue = k;
        break
      end
    end
    dataArgs = args(2:firstNameValue - 1);
    nv = args(firstNameValue:end);
  end
  if isempty(dataArgs)
    error('Nelson:statistics:leastOneDataArgumentRequired', 'At least one %s is required.', 'data argument');
  end
  if rem(length(nv), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
end
%=============================================================================
function opts = parseOptions(nv)
  opts = struct('Alpha', 0.05, 'Type', 'bca', 'Weights', [], 'Options', []);
  for k = 1:2:length(nv)
    name = optionName(nv{k});
    value = nv{k + 1};
    switch name
      case 'alpha'
        opts.Alpha = positiveScalarInUnit(value, _('Alpha must be a scalar between 0 and 1.'));
      case 'type'
        opts.Type = intervalType(value);
      case 'weights'
        opts.Weights = value;
      case 'options'
        opts.Options = value;
      case {'nbootstd', 'stderr'}
        opts.Type = 'stud';
      otherwise
        error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
    end
  end
end
%=============================================================================
function name = optionName(value)
  if ~isTextScalar(value)
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
  text = lower(char(value));
  names = {'alpha', 'type', 'nbootstd', 'stderr', 'weights', 'options'};
  matches = {};
  for k = 1:length(names)
    if strncmp(names{k}, text, length(text))
      matches{end + 1} = names{k};
    end
  end
  if isempty(matches)
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
  if length(matches) > 1
    error('Nelson:statistics:ambiguousNameValue', 'Ambiguous name-value argument name.');
  end
  name = matches{1};
end
%=============================================================================
function type = intervalType(value)
  text = lower(char(value));
  if strncmp('normal', text, length(text)) || strcmp(text, 'norm')
    type = 'norm';
  elseif strncmp('percentile', text, length(text)) || strcmp(text, 'per')
    type = 'per';
  elseif strcmp(text, 'cper') || strncmp('corrected percentile', text, length(text))
    type = 'cper';
  elseif strcmp(text, 'bca')
    type = 'bca';
  elseif strcmp(text, 'stud') || strncmp('student', text, length(text))
    type = 'stud';
  else
    error('Nelson:statistics:invalidTypeValue', 'Invalid %s value.', 'Type');
  end
end
%=============================================================================
function [n, sampleMask, dataArgs] = validateData(dataArgs)
  n = [];
  sampleMask = false(1, length(dataArgs));
  for k = 1:length(dataArgs)
    value = dataArgs{k};
    if isnumeric(value) || islogical(value)
      if length(dataArgs) == 1 && isvector(value)
        dataArgs{k} = value(:);
      end
      if ~isscalar(dataArgs{k})
        rows = size(dataArgs{k}, 1);
        if isempty(n)
          n = rows;
        elseif rows ~= n
          error('Nelson:statistics:nonscalarDataArgumentsSameNumber', '%s must have the same number of rows.', 'Nonscalar data arguments');
        end
        sampleMask(k) = true;
      end
    end
  end
  if isempty(n)
    error('Nelson:statistics:leastOneNonscalarDataArgument', 'At least one %s is required.', 'nonscalar data argument');
  end
end
%=============================================================================
function args = makeBootstrapArgs(dataArgs, sampleMask, indices)
  args = dataArgs;
  for k = 1:length(args)
    if sampleMask(k)
      args{k} = args{k}(indices, :);
    end
  end
end
%=============================================================================
function indices = sampleIndices(n, weights)
  if isempty(weights)
    indices = randi(n, n, 1);
    return
  end
  w = weights(:);
  if length(w) ~= n || any(w < 0) || sum(w) <= 0
    error('Nelson:statistics:weightsNonnegativeVectorOneValue', 'Weights must be a nonnegative vector with one value per observation.');
  end
  cdf = cumsum(w ./ sum(w));
  u = rand(n, 1);
  indices = ones(n, 1);
  for i = 1:n
    indices(i) = find(u(i) <= cdf, 1);
  end
end
%=============================================================================
function row = statisticRow(bootfun, args)
  value = feval(bootfun, args{:});
  row = value(:)';
end
%=============================================================================
function ci = normalInterval(bootstat, original, alpha)
  z = norminvLocal(1 - alpha / 2);
  bias = mean(bootstat, 1) - original;
  sigma = std(bootstat, 0, 1);
  ci = [original - bias - z .* sigma; original - bias + z .* sigma];
end
%=============================================================================
function ci = percentileInterval(bootstat, lo, hi)
  ci = [percentileRows(bootstat, lo); percentileRows(bootstat, hi)];
end
%=============================================================================
function ci = correctedPercentileInterval(bootstat, original, alpha)
  m = size(bootstat, 2);
  ci = zeros(2, m);
  for j = 1:m
    z0 = biasCorrection(bootstat(:, j), original(j));
    lo = normcdfLocal(2 * z0 + norminvLocal(alpha / 2));
    hi = normcdfLocal(2 * z0 + norminvLocal(1 - alpha / 2));
    ci(:, j) = percentileInterval(bootstat(:, j), lo, hi);
  end
end
%=============================================================================
function ci = bcaInterval(bootfun, dataArgs, sampleMask, bootstat, original, alpha)
  jack = jackknifeStats(bootfun, dataArgs, sampleMask);
  m = size(bootstat, 2);
  ci = zeros(2, m);
  for j = 1:m
    z0 = biasCorrection(bootstat(:, j), original(j));
    acc = acceleration(jack(:, j));
    zlo = norminvLocal(alpha / 2);
    zhi = norminvLocal(1 - alpha / 2);
    lo = normcdfLocal(z0 + (z0 + zlo) ./ (1 - acc .* (z0 + zlo)));
    hi = normcdfLocal(z0 + (z0 + zhi) ./ (1 - acc .* (z0 + zhi)));
    ci(:, j) = percentileInterval(bootstat(:, j), lo, hi);
  end
end
%=============================================================================
function jack = jackknifeStats(bootfun, dataArgs, sampleMask)
  n = size(dataArgs{find(sampleMask, 1)}, 1);
  firstArgs = deleteRows(dataArgs, sampleMask, 1);
  first = statisticRow(bootfun, firstArgs);
  jack = zeros(n, length(first));
  jack(1, :) = first;
  for i = 2:n
    jack(i, :) = statisticRow(bootfun, deleteRows(dataArgs, sampleMask, i));
  end
end
%=============================================================================
function args = deleteRows(dataArgs, sampleMask, row)
  args = dataArgs;
  for k = 1:length(args)
    if sampleMask(k)
      mask = true(size(args{k}, 1), 1);
      mask(row) = false;
      args{k} = args{k}(mask, :);
    end
  end
end
%=============================================================================
function acc = acceleration(jack)
  jm = mean(jack);
  diffs = jm - jack;
  denom = 6 * (sum(diffs .^ 2) .^ 1.5);
  if denom == 0
    acc = 0;
  else
    acc = sum(diffs .^ 3) ./ denom;
  end
end
%=============================================================================
function z0 = biasCorrection(samples, original)
  prop = (sum(samples < original) + 0.5 * sum(samples == original)) / length(samples);
  prop = min(max(prop, eps), 1 - eps);
  z0 = norminvLocal(prop);
end
%=============================================================================
function row = percentileRows(values, prob)
  values = sort(values, 1);
  n = size(values, 1);
  pos = 1 + (n - 1) * prob;
  lo = floor(pos);
  hi = ceil(pos);
  frac = pos - lo;
  row = values(lo, :) .* (1 - frac) + values(hi, :) .* frac;
end
%=============================================================================
function z = norminvLocal(p)
  z = sqrt(2) .* erfinv(2 .* p - 1);
end
%=============================================================================
function p = normcdfLocal(z)
  p = 0.5 .* (1 + erf(z ./ sqrt(2)));
end
%=============================================================================
function value = positiveInteger(value, message)
  if ~isscalar(value) || value <= 0 || floor(value) ~= value
    error('Nelson:statistics:mustBePositiveInteger', message);
  end
end
%=============================================================================
function value = positiveScalarInUnit(value, message)
  if ~isscalar(value) || value <= 0 || value >= 1
    error('Nelson:statistics:mustBeInRange', message);
  end
end
%=============================================================================
function tf = isTextScalar(value)
  tf = ischar(value) || isStringScalar(value);
end
