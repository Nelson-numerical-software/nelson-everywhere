% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function mdl = fitcnb(X, Y, varargin)
  narginchk(2, Inf);
  nargoutchk(0, 1);
  [X, yIndex, classNames] = __classification_training_data__(X, Y);
  if rem(length(varargin), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  opts = parseOptionsLocal(varargin, classNames, size(X, 2), size(X, 1));
  [yIndex, classNames] = __reorder_class_names__(yIndex, classNames, opts.ClassNames);
  prior = priorLocal(opts.Prior, yIndex, length(classNames));
  [mu, sigma] = fitNormalParametersLocal(X, yIndex, length(classNames), opts.Weights);
  mdl = ClassificationNaiveBayes();
  mdl.ClassNames = classNames;
  mdl.Prior = prior;
  mdl.Mu = mu;
  mdl.Sigma = sigma;
  mdl.DistributionNames = opts.DistributionNames;
  mdl.DistributionParameters = distributionParametersLocal(mu, sigma);
  mdl.NumObservations = size(X, 1);
  mdl.NumPredictors = size(X, 2);
end
%=============================================================================
function opts = parseOptionsLocal(args, classNames, p, n)
  opts = struct('ClassNames', {classNames}, 'Prior', 'empirical', ...
    'DistributionNames', {repmat({'normal'}, 1, p)}, 'Weights', []);
  for k = 1:2:length(args)
    name = __option_name__(args{k}, {'classnames', 'prior', 'distributionnames', 'weights'});
    value = args{k + 1};
    switch name
      case 'classnames'
        opts.ClassNames = __class_names__(value, classNames);
      case 'prior'
        opts.Prior = priorOptionLocal(value, length(classNames));
      case 'distributionnames'
        opts.DistributionNames = distributionNamesLocal(value, p);
      case 'weights'
        opts.Weights = weightsLocal(value, n);
    end
  end
end
%=============================================================================
function [mu, sigma] = fitNormalParametersLocal(X, yIndex, kClasses, weights)
  [n, p] = size(X);
  if isempty(weights)
    weights = ones(n, 1);
  end
  mu = zeros(kClasses, p);
  sigma = zeros(kClasses, p);
  for j = 1:kClasses
    rows = yIndex == j;
    w = weights(rows);
    xj = X(rows, :);
    wsum = sum(w);
    mu(j, :) = (w(:)' * xj) / wsum;
    centered = xj - repmat(mu(j, :), size(xj, 1), 1);
    sigma(j, :) = sqrt((w(:)' * (centered .^ 2)) / wsum);
  end
  if any(sigma(:) == 0 | isnan(sigma(:)))
    error('Nelson:statistics:normalDistributionFitBecauseOne', 'A normal distribution cannot be fit because one class has zero variance.');
  end
end
%=============================================================================
function params = distributionParametersLocal(mu, sigma)
  params = cell(size(mu, 1), size(mu, 2));
  for i = 1:size(mu, 1)
    for j = 1:size(mu, 2)
      params{i, j} = [mu(i, j), sigma(i, j)];
    end
  end
end
%=============================================================================
function prior = priorLocal(option, yIndex, kClasses)
  if ischar(option)
    switch option
      case 'empirical'
        counts = zeros(1, kClasses);
        for j = 1:kClasses
          counts(j) = sum(yIndex == j);
        end
        prior = counts / sum(counts);
      otherwise
        prior = ones(1, kClasses) / kClasses;
    end
  else
    prior = double(option(:).');
    prior = prior / sum(prior);
  end
end
%=============================================================================
function value = priorOptionLocal(value, kClasses)
  if ischar(value) || (isstring(value) && isscalar(value))
    text = lower(char(value));
    choices = {'empirical', 'uniform'};
    matches = choices(startsWith(choices, text));
    if length(matches) ~= 1
      error('Nelson:statistics:invalidPriorValue', 'Invalid %s value.', 'Prior');
    end
    value = matches{1};
  elseif isnumeric(value) && isreal(value) && isvector(value) && length(value) == kClasses ...
      && all(isfinite(value)) && all(value >= 0) && sum(value) > 0
    value = double(value(:).');
  else
    error('Nelson:statistics:invalidPriorValue', 'Invalid %s value.', 'Prior');
  end
end
%=============================================================================
function value = distributionNamesLocal(value, p)
  if ischar(value) || (isstring(value) && isscalar(value))
    value = repmat({char(value)}, 1, p);
  elseif iscellstr(value) && (length(value) == 1 || length(value) == p)
    value = value(:).';
    if length(value) == 1
      value = repmat(value, 1, p);
    end
  else
    error('Nelson:statistics:distributionNamesNormalCellArrayNormal', 'DistributionNames must be normal or a cell array of normal values.');
  end
  for k = 1:length(value)
    if ~strcmpi(value{k}, 'normal')
      error('Nelson:statistics:normalPredictorDistributionsSupported', 'Only normal predictor distributions are supported.');
    end
    value{k} = 'normal';
  end
end
%=============================================================================
function value = weightsLocal(value, n)
  if ~(isnumeric(value) && isreal(value) && isvector(value) && all(isfinite(value)) ...
      && length(value) == n && all(value >= 0) && sum(value) > 0)
    error('Nelson:statistics:weightsNonnegativeFiniteNumericVector', 'Weights must be a nonnegative finite numeric vector with positive sum.');
  end
  value = double(value(:));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function mdl = fitcsvm(X, Y, varargin)
  narginchk(2, Inf);
  nargoutchk(0, 1);
  [X, yIndex, classNames] = __classification_training_data__(X, Y, 2);
  if rem(length(varargin), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  opts = parseOptionsLocal(varargin, X, classNames);
  [yIndex, classNames] = __reorder_class_names__(yIndex, classNames, opts.ClassNames);
  [Xfit, mu, sigma] = standardizeTrainingLocal(X, opts.Standardize);
  ySigned = -ones(length(yIndex), 1);
  ySigned(yIndex == 2) = 1;
  opts.BoxConstraints = costConstraintsLocal(yIndex, opts);
  K = kernelMatrixLocal(Xfit, Xfit, opts);
  smo = trainSmoLocal(K, ySigned, opts);
  support = smo.Alpha > 1e-8;
  mdl = ClassificationSVM();
  mdl.SupportVectors = Xfit(support, :);
  mdl.SupportVectorLabels = ySigned(support);
  mdl.Alpha = smo.Alpha(support);
  mdl.Bias = smo.Bias;
  mdl.ClassNames = classNames;
  mdl.KernelFunction = opts.KernelFunction;
  mdl.KernelScale = opts.KernelScale;
  mdl.PolynomialOrder = opts.PolynomialOrder;
  mdl.BoxConstraint = opts.BoxConstraint;
  mdl.BoxConstraints = opts.BoxConstraints(support);
  mdl.Cost = opts.Cost;
  mdl.Standardize = opts.Standardize;
  mdl.Mu = mu;
  mdl.Sigma = sigma;
  mdl.NumObservations = size(X, 1);
  mdl.NumPredictors = size(X, 2);
  mdl.PredictorNames = opts.PredictorNames;
  mdl.ConvergenceInfo = struct('Converged', smo.Converged, 'Iterations', smo.Iterations);
end
%=============================================================================
function opts = parseOptionsLocal(args, X, classNames)
  opts = struct('ClassNames', {classNames}, 'KernelFunction', 'linear', ...
    'KernelScale', kernelScaleAutoLocal(X), 'PolynomialOrder', 3, 'BoxConstraint', 1, ...
    'BoxConstraints', [], 'Cost', [], 'Standardize', false, 'IterationLimit', 1000, 'Tolerance', 1e-3, ...
    'PredictorNames', {__default_predictor_names__(size(X, 2))});
  for k = 1:2:length(args)
    name = __option_name__(args{k}, {'classnames', 'kernelfunction', 'kernelscale', ...
      'polynomialorder', 'boxconstraint', 'standardize', 'iterationlimit', ...
      'tolerance', 'predictornames', 'cost'});
    value = args{k + 1};
    switch name
      case 'classnames'
        opts.ClassNames = __class_names__(value, classNames);
      case 'kernelfunction'
        opts.KernelFunction = kernelFunctionLocal(value);
      case 'kernelscale'
        opts.KernelScale = kernelScaleLocal(value, X);
      case 'polynomialorder'
        opts.PolynomialOrder = positiveIntegerLocal(value, 'PolynomialOrder');
      case 'boxconstraint'
        opts.BoxConstraint = positiveScalarLocal(value, 'BoxConstraint');
      case 'standardize'
        opts.Standardize = logicalScalarLocal(value, 'Standardize');
      case 'iterationlimit'
        opts.IterationLimit = positiveIntegerLocal(value, 'IterationLimit');
      case 'tolerance'
        opts.Tolerance = positiveScalarLocal(value, 'Tolerance');
      case 'predictornames'
        opts.PredictorNames = __predictor_names__(value, size(X, 2));
      case 'cost'
        opts.Cost = costMatrixLocal(value, length(classNames));
    end
  end
  if ~isequal(opts.ClassNames, classNames)
    __check_class_names__(classNames, opts.ClassNames, true);
  end
end
%=============================================================================
function smo = trainSmoLocal(K, y, opts)
  n = length(y);
  alpha = zeros(n, 1);
  b = 0;
  passes = 0;
  iter = 0;
  while passes < 5 && iter < opts.IterationLimit
    changed = 0;
    for i = 1:n
      decision = K * (alpha .* y) + b;
      E = decision - y;
      if ~violatesKktLocal(y(i), E(i), alpha(i), opts, i)
        continue
      end
      [~, j] = max(abs(E - E(i)));
      if j == i
        j = mod(i, n) + 1;
      end
      [alpha, b, didChange] = updatePairLocal(K, y, alpha, b, E, i, j, opts);
      changed = changed + didChange;
    end
    if changed == 0
      passes = passes + 1;
    else
      passes = 0;
    end
    iter = iter + 1;
  end
  smo = struct('Alpha', alpha, 'Bias', b, 'Converged', passes >= 5, 'Iterations', iter);
end
%=============================================================================
function tf = violatesKktLocal(y, E, alpha, opts, i)
  r = y * E;
  tf = (r < -opts.Tolerance && alpha < opts.BoxConstraints(i)) ...
    || (r > opts.Tolerance && alpha > 0);
end
%=============================================================================
function [alpha, b, changed] = updatePairLocal(K, y, alpha, b, E, i, j, opts)
  changed = 0;
  ai = alpha(i);
  aj = alpha(j);
  ci = opts.BoxConstraints(i);
  cj = opts.BoxConstraints(j);
  if y(i) ~= y(j)
    L = max(0, aj - ai);
    H = min(cj, ci + aj - ai);
  else
    L = max(0, ai + aj - ci);
    H = min(cj, ai + aj);
  end
  if L == H
    return
  end
  eta = 2 * K(i, j) - K(i, i) - K(j, j);
  if eta >= 0
    return
  end
  alpha(j) = min(H, max(L, aj - y(j) * (E(i) - E(j)) / eta));
  if abs(alpha(j) - aj) < 1e-12
    alpha(j) = aj;
    return
  end
  alpha(i) = ai + y(i) * y(j) * (aj - alpha(j));
  b1 = b - E(i) - y(i) * (alpha(i) - ai) * K(i, i) - y(j) * (alpha(j) - aj) * K(i, j);
  b2 = b - E(j) - y(i) * (alpha(i) - ai) * K(i, j) - y(j) * (alpha(j) - aj) * K(j, j);
  if alpha(i) > 0 && alpha(i) < ci
    b = b1;
  elseif alpha(j) > 0 && alpha(j) < cj
    b = b2;
  else
    b = (b1 + b2) / 2;
  end
  changed = 1;
end
%=============================================================================
function boxConstraints = costConstraintsLocal(yIndex, opts)
  boxConstraints = opts.BoxConstraint * ones(length(yIndex), 1);
  if isempty(opts.Cost)
    return
  end
  k = size(opts.Cost, 1);
  for row = 1:length(yIndex)
    current = yIndex(row);
    others = 1:k;
    others(current) = [];
    penalty = max(opts.Cost(current, others));
    boxConstraints(row) = opts.BoxConstraint * max(penalty, eps);
  end
end
%=============================================================================
function cost = costMatrixLocal(value, k)
  if ~(isnumeric(value) && isreal(value) && isequal(size(value), [k k]) ...
      && all(isfinite(value(:))) && all(value(:) >= 0))
    error('Nelson:statistics:costNonnegativeSquareMatrixOne', 'Cost must be a nonnegative square matrix with one row and column per class.');
  end
  cost = double(value);
end
%=============================================================================
function K = kernelMatrixLocal(A, B, opts)
  switch opts.KernelFunction
    case 'gaussian'
      a2 = sum(A .^ 2, 2);
      b2 = sum(B .^ 2, 2).';
      dist2 = repmat(a2, 1, size(B, 1)) + repmat(b2, size(A, 1), 1) - 2 * (A * B.');
      K = exp(-max(dist2, 0) / (2 * opts.KernelScale ^ 2));
    case 'polynomial'
      K = (1 + A * B.') .^ opts.PolynomialOrder;
    otherwise
      K = A * B.';
  end
end
%=============================================================================
function [Xfit, mu, sigma] = standardizeTrainingLocal(X, doStandardize)
  mu = zeros(1, size(X, 2));
  sigma = ones(1, size(X, 2));
  Xfit = X;
  if doStandardize
    mu = mean(X, 1);
    centered = X - repmat(mu, size(X, 1), 1);
    sigma = sqrt(sum(centered .^ 2, 1) / max(size(X, 1) - 1, 1));
    sigma(sigma == 0 | isnan(sigma)) = 1;
    Xfit = centered ./ repmat(sigma, size(X, 1), 1);
  end
end
%=============================================================================
function name = kernelFunctionLocal(value)
  if ~(ischar(value) || (isstring(value) && isscalar(value)))
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'KernelFunction');
  end
  text = lower(char(value));
  names = {'linear', 'gaussian', 'rbf', 'polynomial'};
  exact = names(strcmp(names, text));
  if length(exact) == 1
    name = exact{1};
  else
    matches = names(startsWith(names, text));
    if length(matches) ~= 1
      error('Nelson:statistics:invalidKernelFunctionValue', 'Invalid %s value.', 'KernelFunction');
    end
    name = matches{1};
  end
  if strcmp(name, 'rbf')
    name = 'gaussian';
  end
end
%=============================================================================
function value = kernelScaleLocal(value, X)
  if ischar(value) || (isstring(value) && isscalar(value))
    if strcmpi(char(value), 'auto')
      value = kernelScaleAutoLocal(X);
      return
    end
  end
  value = positiveScalarLocal(value, 'KernelScale');
end
%=============================================================================
function value = kernelScaleAutoLocal(X)
  value = sqrt(size(X, 2));
end
%=============================================================================
function value = positiveIntegerLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) ...
      && value > 0 && value == fix(value))
    error('Nelson:statistics:mustBePositiveInteger', '%s must be a positive integer scalar.', name);
  end
  value = double(value);
end
%=============================================================================
function value = positiveScalarLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) && value > 0)
    error('Nelson:statistics:mustBePositive', '%s must be a positive scalar.', name);
  end
  value = double(value);
end
%=============================================================================
function value = logicalScalarLocal(value, name)
  if islogical(value) && isscalar(value)
    return
  end
  if isnumeric(value) && isscalar(value) && (value == 0 || value == 1)
    value = logical(value);
    return
  end
  error('Nelson:statistics:mustBeTrueOrFalse', '%s must be true or false.', name);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function mdl = fitctree(X, Y, varargin)
  narginchk(2, Inf);
  nargoutchk(0, 1);
  [X, yIndex, classNames] = __classification_training_data__(X, Y);
  if rem(length(varargin), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  opts = parseOptionsLocal(varargin, classNames, size(X, 1));
  [yIndex, classNames] = __reorder_class_names__(yIndex, classNames, opts.ClassNames);
  prior = priorLocal(opts.Prior, yIndex, length(classNames));
  tree = growTreeLocal(X, yIndex, length(classNames), opts);
  mdl = ClassificationTree();
  mdl.ClassNames = classNames;
  mdl.Prior = prior;
  mdl.CutPredictor = tree.CutPredictor;
  mdl.CutPoint = tree.CutPoint;
  mdl.LeftChild = tree.LeftChild;
  mdl.RightChild = tree.RightChild;
  mdl.NodeClass = tree.NodeClass;
  mdl.NodeProbability = tree.NodeProbability;
  mdl.IsBranch = tree.IsBranch;
  mdl.SplitCriterion = opts.SplitCriterion;
  mdl.MaxNumSplits = opts.MaxNumSplits;
  mdl.MinLeafSize = opts.MinLeafSize;
  mdl.MinParentSize = opts.MinParentSize;
  mdl.NumObservations = size(X, 1);
  mdl.NumPredictors = size(X, 2);
end
%=============================================================================
function opts = parseOptionsLocal(args, classNames, n)
  opts = struct('ClassNames', {classNames}, 'Prior', 'empirical', 'SplitCriterion', 'gdi', ...
    'MaxNumSplits', max(n - 1, 0), 'MinLeafSize', 1, 'MinParentSize', 10);
  for k = 1:2:length(args)
    name = __option_name__(args{k}, {'classnames', 'prior', 'splitcriterion', 'maxnumsplits', ...
      'minleafsize', 'minparentsize'});
    value = args{k + 1};
    switch name
      case 'classnames'
        opts.ClassNames = __class_names__(value, classNames);
      case 'prior'
        opts.Prior = priorOptionLocal(value, length(classNames));
      case 'splitcriterion'
        opts.SplitCriterion = splitCriterionLocal(value);
      case 'maxnumsplits'
        opts.MaxNumSplits = nonnegativeIntegerLocal(value, 'MaxNumSplits');
      case 'minleafsize'
        opts.MinLeafSize = positiveIntegerLocal(value, 'MinLeafSize');
      case 'minparentsize'
        opts.MinParentSize = positiveIntegerLocal(value, 'MinParentSize');
    end
  end
end
%=============================================================================
function tree = growTreeLocal(X, yIndex, kClasses, opts)
  tree = emptyTreeLocal();
  tree = appendNodeLocal(tree, yIndex, kClasses);
  nodeRows = {1:length(yIndex)};
  queue = 1;
  splits = 0;
  while ~isempty(queue) && splits < opts.MaxNumSplits
    node = queue(1);
    queue(1) = [];
    rows = nodeRows{node};
    split = bestSplitLocal(X(rows, :), yIndex(rows), kClasses, opts);
    if ~split.Valid
      continue
    end
    tree.IsBranch(node) = true;
    tree.CutPredictor(node) = split.Predictor;
    tree.CutPoint(node) = split.CutPoint;
    leftRows = rows(split.LeftMask);
    rightRows = rows(~split.LeftMask);
    tree = appendNodeLocal(tree, yIndex(leftRows), kClasses);
    leftNode = length(tree.IsBranch);
    tree = appendNodeLocal(tree, yIndex(rightRows), kClasses);
    rightNode = length(tree.IsBranch);
    tree.LeftChild(node) = leftNode;
    tree.RightChild(node) = rightNode;
    nodeRows{leftNode} = leftRows;
    nodeRows{rightNode} = rightRows;
    queue = [queue, leftNode, rightNode];
    splits = splits + 1;
  end
end
%=============================================================================
function tree = emptyTreeLocal()
  tree = struct('CutPredictor', [], 'CutPoint', [], 'LeftChild', [], 'RightChild', [], ...
    'NodeClass', [], 'NodeProbability', [], 'IsBranch', []);
end
%=============================================================================
function tree = appendNodeLocal(tree, labels, kClasses)
  counts = classCountsLocal(labels, kClasses);
  prob = counts / sum(counts);
  [~, cls] = max(prob);
  tree.CutPredictor(end + 1, 1) = 0;
  tree.CutPoint(end + 1, 1) = NaN;
  tree.LeftChild(end + 1, 1) = 0;
  tree.RightChild(end + 1, 1) = 0;
  tree.NodeClass(end + 1, 1) = cls;
  tree.NodeProbability(end + 1, :) = prob;
  tree.IsBranch(end + 1, 1) = false;
end
%=============================================================================
function split = bestSplitLocal(X, y, kClasses, opts)
  split = struct('Valid', false, 'Predictor', 0, 'CutPoint', NaN, 'LeftMask', [], 'Gain', 0);
  if length(y) < opts.MinParentSize || length(unique(y)) < 2
    return
  end
  parentImpurity = impurityLocal(classCountsLocal(y, kClasses), opts.SplitCriterion);
  for p = 1:size(X, 2)
    candidate = bestPredictorSplitLocal(X(:, p), y, kClasses, parentImpurity, opts);
    if candidate.Valid && candidate.Gain > split.Gain
      split.Valid = true;
      split.Predictor = p;
      split.CutPoint = candidate.CutPoint;
      split.LeftMask = X(:, p) <= candidate.CutPoint;
      split.Gain = candidate.Gain;
    end
  end
end
%=============================================================================
function candidate = bestPredictorSplitLocal(x, y, kClasses, parentImpurity, opts)
  candidate = struct('Valid', false, 'CutPoint', NaN, 'Gain', 0);
  [xs, order] = sort(x(:));
  ys = y(order);
  boundary = find(diff(xs) ~= 0);
  if isempty(boundary)
    return
  end
  boundary = boundary(boundary >= opts.MinLeafSize & length(y) - boundary >= opts.MinLeafSize);
  if isempty(boundary)
    return
  end
  cumulative = cumulativeCountsLocal(ys, kClasses);
  parentCounts = cumulative(end, :);
  for pos = boundary(:).'
    leftCounts = cumulative(pos, :);
    rightCounts = parentCounts - leftCounts;
    gain = splitGainFromCountsLocal(leftCounts, rightCounts, parentImpurity, opts.SplitCriterion);
    if gain > candidate.Gain
      candidate.Valid = gain > 0;
      candidate.CutPoint = (xs(pos) + xs(pos + 1)) / 2;
      candidate.Gain = gain;
    end
  end
end
%=============================================================================
function cumulative = cumulativeCountsLocal(labels, kClasses)
  cumulative = zeros(length(labels), kClasses);
  for j = 1:kClasses
    cumulative(:, j) = cumsum(labels == j);
  end
end
%=============================================================================
function gain = splitGainFromCountsLocal(leftCounts, rightCounts, parentImpurity, criterion)
  nLeft = sum(leftCounts);
  nRight = sum(rightCounts);
  n = nLeft + nRight;
  leftImpurity = impurityLocal(leftCounts, criterion);
  rightImpurity = impurityLocal(rightCounts, criterion);
  gain = parentImpurity - (nLeft / n) * leftImpurity - (nRight / n) * rightImpurity;
end
%=============================================================================
function value = impurityLocal(counts, criterion)
  p = counts / sum(counts);
  p = p(p > 0);
  switch criterion
    case 'deviance'
      value = -sum(p .* log(p));
    otherwise
      value = 1 - sum(p .^ 2);
  end
end
%=============================================================================
function counts = classCountsLocal(labels, kClasses)
  counts = zeros(1, kClasses);
  for j = 1:kClasses
    counts(j) = sum(labels == j);
  end
end
%=============================================================================
function prior = priorLocal(option, yIndex, kClasses)
  if ischar(option)
    if strcmp(option, 'uniform')
      prior = ones(1, kClasses) / kClasses;
    else
      counts = classCountsLocal(yIndex, kClasses);
      prior = counts / sum(counts);
    end
  else
    prior = double(option(:).');
    prior = prior / sum(prior);
  end
end
%=============================================================================
function value = splitCriterionLocal(value)
  if ~(ischar(value) || (isstring(value) && isscalar(value)))
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'SplitCriterion');
  end
  text = lower(char(value));
  names = {'gdi', 'deviance', 'twoing'};
  exact = names(strcmp(names, text));
  if length(exact) == 1
    value = exact{1};
    return
  end
  matches = names(startsWith(names, text));
  if length(matches) ~= 1
    error('Nelson:statistics:invalidSplitCriterionValue', 'Invalid %s value.', 'SplitCriterion');
  end
  value = matches{1};
end
%=============================================================================
function value = priorOptionLocal(value, kClasses)
  if ischar(value) || (isstring(value) && isscalar(value))
    text = lower(char(value));
    choices = {'empirical', 'uniform'};
    matches = choices(startsWith(choices, text));
    if length(matches) ~= 1
      error('Nelson:statistics:invalidPriorValue', 'Invalid %s value.', 'Prior');
    end
    value = matches{1};
  elseif isnumeric(value) && isreal(value) && isvector(value) && length(value) == kClasses ...
      && all(isfinite(value)) && all(value >= 0) && sum(value) > 0
    value = double(value(:).');
  else
    error('Nelson:statistics:invalidPriorValue', 'Invalid %s value.', 'Prior');
  end
end
%=============================================================================
function value = positiveIntegerLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) ...
      && value > 0 && value == fix(value))
    error('Nelson:statistics:mustBePositiveInteger', '%s must be a positive integer scalar.', name);
  end
  value = double(value);
end
%=============================================================================
function value = nonnegativeIntegerLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) ...
      && value >= 0 && value == fix(value))
    error('Nelson:statistics:mustBeNonnegativeInteger', '%s must be a nonnegative integer scalar.', name);
  end
  value = double(value);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function mdl = fitensemble(X, Y, method, numLearningCycles, learners, varargin)
  narginchk(5, Inf);
  nargoutchk(0, 1);
  if rem(length(varargin), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  [problemType, args] = extractTypeLocal(varargin, Y);
  commonArgs = [{'Method', method, 'NumLearningCycles', numLearningCycles, ...
    'Learners', learners}, args];
  if strcmp(problemType, 'regression')
    mdl = fitrensemble(X, Y, commonArgs{:});
  else
    mdl = fitcensemble(X, Y, commonArgs{:});
  end
end
%=============================================================================
function [problemType, args] = extractTypeLocal(args, Y)
  problemType = defaultTypeLocal(Y);
  keep = true(1, length(args));
  for k = 1:2:length(args)
    if isTypeNameLocal(args{k})
      problemType = typeLocal(args{k + 1});
      keep(k) = false;
      keep(k + 1) = false;
    end
  end
  args = args(keep);
end
%=============================================================================
function tf = isTypeNameLocal(value)
  tf = false;
  if ~(ischar(value) || (isstring(value) && isscalar(value)))
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
  text = lower(char(value));
  tf = startsWith('type', text);
end
%=============================================================================
function problemType = defaultTypeLocal(Y)
  if isnumeric(Y) && isreal(Y)
    problemType = 'regression';
  else
    problemType = 'classification';
  end
end
%=============================================================================
function problemType = typeLocal(value)
  if ~(ischar(value) || (isstring(value) && isscalar(value)))
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Type');
  end
  text = lower(char(value));
  choices = {'classification', 'regression'};
  matches = choices(startsWith(choices, text));
  if length(matches) ~= 1
    error('Nelson:statistics:invalidTypeValue', 'Invalid %s value.', 'Type');
  end
  problemType = matches{1};
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function mdl = fitglm(X, y, varargin)
  narginchk(2, Inf);
  nargoutchk(0, 1);
  [X, y] = validateInputsLocal(X, y);
  [modelspec, args] = parseModelSpecLocal(varargin);
  opts = parseOptionsLocal(args);
  terms = modelTermsLocal(size(X, 2), modelspec);
  keep = ~isnan(y) & all(~isnan(X), 2);
  if ~any(keep)
    error('Nelson:statistics:validObservationsRemainAfterRemoving', 'No valid observations remain after removing missing values.');
  end
  fit = fitGlmLocal(X(keep, :), y(keep), terms, opts);
  mdl = buildModelLocal(fit, X, y, keep, terms, opts);
end
%=============================================================================
function [X, y] = validateInputsLocal(X, y)
  if ~(isnumeric(X) && isreal(X) && ismatrix(X) && ~issparse(X))
    error('Nelson:statistics:xRealNumericMatrix', '%s must be a real numeric matrix.', 'X');
  end
  if ~(isnumeric(y) && isreal(y) && isvector(y) && ~issparse(y))
    error('Nelson:statistics:yRealNumericVector', '%s must be a real numeric vector.', 'Y');
  end
  X = double(X);
  y = double(y(:));
  if size(X, 1) ~= length(y)
    error('Nelson:statistics:xYSameNumberRows', '%s must have the same number of rows.', 'X and Y');
  end
  if size(X, 2) == 0
    error('Nelson:statistics:xContainLeastOnePredictor', 'X must contain at least one predictor.');
  end
end
%=============================================================================
function [modelspec, args] = parseModelSpecLocal(args)
  modelspec = 'linear';
  if ~isempty(args) && isModelSpecValueLocal(args{1})
    modelspec = args{1};
    args = args(2:end);
  end
end
%=============================================================================
function tf = isModelSpecValueLocal(value)
  tf = isnumeric(value) && ~isscalar(value);
  if ischar(value) || (isstring(value) && isscalar(value))
    specs = {'constant', 'linear', 'additive', 'interactions', 'interaction', ...
      'quadratic', 'purequadratic'};
    tf = any(strcmp(lower(char(value)), specs));
  end
end
%=============================================================================
function opts = parseOptionsLocal(args)
  opts = struct('Intercept', true, 'PredictorNames', [], 'ResponseName', 'y', ...
    'Distribution', 'normal', 'Link', '', 'MaxIter', 100, 'TolFun', 1e-8);
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  for k = 1:2:length(args)
    name = optionNameLocal(args{k});
    value = args{k + 1};
    switch name
      case 'intercept'
        opts.Intercept = logicalScalarLocal(value, 'Intercept');
      case 'predictornames'
        opts.PredictorNames = textVectorLocal(value, 'PredictorNames');
      case 'responsename'
        opts.ResponseName = responseNameLocal(value);
      case 'distribution'
        opts.Distribution = distributionLocal(value);
      case 'link'
        opts.Link = linkLocal(value);
      case 'maxiter'
        opts.MaxIter = positiveIntegerLocal(value, 'MaxIter');
      case 'tolfun'
        opts.TolFun = positiveScalarLocal(value, 'TolFun');
    end
  end
  if isempty(opts.Link)
    opts.Link = canonicalLinkLocal(opts.Distribution);
  end
  validateDistributionLinkLocal(opts.Distribution, opts.Link);
end
%=============================================================================
function fit = fitGlmLocal(X, y, terms, opts)
  validateResponseLocal(y, opts.Distribution);
  D = designMatrixLocal(X, terms, opts.Intercept);
  if strcmp(opts.Distribution, 'normal') && strcmp(opts.Link, 'identity')
    fit = fitNormalLocal(D, y);
    fit.NumIterations = 1;
    fit.Converged = true;
  else
    fit = fitIrlsLocal(D, y, opts);
  end
  fit.X = X;
  fit.Terms = terms;
end
%=============================================================================
function fit = fitNormalLocal(D, y)
  beta = D \ y;
  eta = D * beta;
  mu = eta;
  residuals = y - mu;
  dfe = length(y) - rank(D);
  sse = sum(residuals .^ 2);
  dispersion = sse / max(dfe, 1);
  covb = dispersion * pinv(D' * D);
  fit = baseFitStructLocal(D, y, beta, eta, mu, residuals, covb, dfe, dispersion);
end
%=============================================================================
function fit = fitIrlsLocal(D, y, opts)
  beta = D \ initialEtaLocal(y, opts);
  converged = false;
  for iter = 1:opts.MaxIter
    eta = D * beta;
    mu = clippedMeanLocal(inverseLinkLocal(eta, opts.Link), opts.Distribution);
    dmu = derivativeMuEtaLocal(mu, opts.Link);
    variance = varianceLocal(mu, opts.Distribution);
    z = eta + (y - mu) ./ max(dmu, eps);
    w = (dmu .^ 2) ./ max(variance, eps);
    betaNew = weightedLeastSquaresLocal(D, z, w);
    if norm(betaNew - beta) <= opts.TolFun * max(1, norm(beta))
      beta = betaNew;
      converged = true;
      break
    end
    beta = betaNew;
  end
  eta = D * beta;
  mu = clippedMeanLocal(inverseLinkLocal(eta, opts.Link), opts.Distribution);
  residuals = y - mu;
  dfe = length(y) - rank(D);
  w = (derivativeMuEtaLocal(mu, opts.Link) .^ 2) ./ max(varianceLocal(mu, opts.Distribution), eps);
  covb = pinv(D' * (D .* repmat(w, 1, size(D, 2))));
  dispersion = dispersionLocal(y, mu, opts.Distribution, dfe);
  fit = baseFitStructLocal(D, y, beta, eta, mu, residuals, dispersion * covb, dfe, dispersion);
  fit.NumIterations = iter;
  fit.Converged = converged;
end
%=============================================================================
function fit = baseFitStructLocal(D, y, beta, eta, mu, residuals, covb, dfe, dispersion)
  fit = struct('D', D, 'Y', y, 'Beta', beta, 'LinearPredictor', eta, 'Fitted', mu, ...
    'Residuals', residuals, 'Covariance', covb, 'DFE', dfe, 'Dispersion', dispersion, ...
    'SSE', sum(residuals .^ 2), 'SST', sum((y - mean(y)) .^ 2), ...
    'NumObservations', length(y), 'NumCoefficients', length(beta), ...
    'NumIterations', 0, 'Converged', false);
end
%=============================================================================
function mdl = buildModelLocal(fit, X, y, keep, terms, opts)
  mdl = GeneralizedLinearModel();
  mdl.Intercept = opts.Intercept;
  mdl.Terms = terms;
  mdl.Beta = fit.Beta;
  mdl.Covariance = fit.Covariance;
  mdl.NumObservations = fit.NumObservations;
  mdl.NumPredictors = size(X, 2);
  mdl.DFE = fit.DFE;
  mdl.RMSE = sqrt(fit.SSE / max(fit.DFE, 1));
  mdl.SSE = fit.SSE;
  mdl.Deviance = devianceLocal(fit.Y, fit.Fitted, opts.Distribution);
  mdl.Dispersion = fit.Dispersion;
  mdl.Distribution = opts.Distribution;
  mdl.Link = opts.Link;
  mdl.Rsquared = rsquaredLocal(fit);
  mdl.NumIterations = fit.NumIterations;
  mdl.Converged = fit.Converged;
  mdl.PredictorNames = predictorNamesLocal(opts.PredictorNames, size(X, 2));
  mdl.ResponseName = opts.ResponseName;
  mdl.CoefficientNames = coefficientNamesLocal(terms, opts.Intercept, mdl.PredictorNames);
  mdl.Coefficients = coefficientsTableLocal(fit, mdl.CoefficientNames);
  mdl.Fitted = expandVectorLocal(fit.Fitted, keep, size(X, 1));
  raw = expandVectorLocal(fit.Residuals, keep, size(X, 1));
  mdl.Residuals = table(raw, 'VariableNames', {'Raw'});
  y;
end
%=============================================================================
function D = designMatrixLocal(X, terms, intercept)
  D = zeros(size(X, 1), 0);
  if intercept
    D = ones(size(X, 1), 1);
  end
  for k = 1:size(terms, 1)
    col = ones(size(X, 1), 1);
    for j = 1:size(X, 2)
      if terms(k, j) ~= 0
        col = col .* (X(:, j) .^ terms(k, j));
      end
    end
    D = [D col];
  end
end
%=============================================================================
function beta = weightedLeastSquaresLocal(D, z, w)
  sw = sqrt(max(w, eps));
  beta = (D .* repmat(sw, 1, size(D, 2))) \ (z .* sw);
end
%=============================================================================
function eta = initialEtaLocal(y, opts)
  switch opts.Distribution
    case 'binomial'
      mu = (y + 0.5) / 2;
    case 'poisson'
      mu = max(y + 0.1, 0.1);
    otherwise
      mu = y;
  end
  eta = linkValueLocal(mu, opts.Link);
end
%=============================================================================
function mu = inverseLinkLocal(eta, link)
  switch link
    case 'log'
      mu = exp(eta);
    case 'logit'
      mu = 1 ./ (1 + exp(-eta));
    otherwise
      mu = eta;
  end
end
%=============================================================================
function eta = linkValueLocal(mu, link)
  switch link
    case 'log'
      eta = log(max(mu, realmin));
    case 'logit'
      mu = min(max(mu, eps), 1 - eps);
      eta = log(mu ./ (1 - mu));
    otherwise
      eta = mu;
  end
end
%=============================================================================
function dmu = derivativeMuEtaLocal(mu, link)
  switch link
    case 'log'
      dmu = mu;
    case 'logit'
      dmu = mu .* (1 - mu);
    otherwise
      dmu = ones(size(mu));
  end
end
%=============================================================================
function variance = varianceLocal(mu, distribution)
  switch distribution
    case 'binomial'
      variance = mu .* (1 - mu);
    case 'poisson'
      variance = mu;
    otherwise
      variance = ones(size(mu));
  end
end
%=============================================================================
function mu = clippedMeanLocal(mu, distribution)
  switch distribution
    case 'binomial'
      mu = min(max(mu, eps), 1 - eps);
    case 'poisson'
      mu = max(mu, realmin);
  end
end
%=============================================================================
function dispersion = dispersionLocal(y, mu, distribution, dfe)
  if strcmp(distribution, 'normal')
    dispersion = sum((y - mu) .^ 2) / max(dfe, 1);
  else
    dispersion = 1;
  end
end
%=============================================================================
function value = devianceLocal(y, mu, distribution)
  switch distribution
    case 'binomial'
      mu = min(max(mu, eps), 1 - eps);
      term = zeros(size(y));
      pos = y > 0;
      neg = y < 1;
      term(pos) = term(pos) + y(pos) .* log(y(pos) ./ mu(pos));
      term(neg) = term(neg) + (1 - y(neg)) .* log((1 - y(neg)) ./ (1 - mu(neg)));
      value = 2 * sum(term);
    case 'poisson'
      term = mu;
      pos = y > 0;
      term(pos) = y(pos) .* log(y(pos) ./ mu(pos)) - (y(pos) - mu(pos));
      value = 2 * sum(term);
    otherwise
      value = sum((y - mu) .^ 2);
  end
end
%=============================================================================
function terms = modelTermsLocal(p, modelspec)
  if ischar(modelspec) || (isstring(modelspec) && isscalar(modelspec))
    switch lower(char(modelspec))
      case 'constant'
        terms = zeros(0, p);
      case {'linear', 'additive'}
        terms = eye(p);
      case {'interactions', 'interaction'}
        terms = [eye(p); pairTermsLocal(p)];
      case 'quadratic'
        terms = [eye(p); pairTermsLocal(p); 2 * eye(p)];
      case 'purequadratic'
        terms = [eye(p); 2 * eye(p)];
      otherwise
        error('Nelson:statistics:invalidModelSpecification', 'Invalid model specification.');
    end
  elseif isnumeric(modelspec)
    if size(modelspec, 2) ~= p
      error('Nelson:statistics:modelMatrixOneColumnPredictor', 'Model matrix must have one column per %s.', 'predictor');
    end
    terms = double(modelspec);
    terms(all(terms == 0, 2), :) = [];
  else
    error('Nelson:statistics:invalidModelSpecification', 'Invalid model specification.');
  end
end
%=============================================================================
function terms = pairTermsLocal(p)
  terms = zeros(0, p);
  for i = 1:p
    for j = i + 1:p
      row = zeros(1, p);
      row(i) = 1;
      row(j) = 1;
      terms = [terms; row];
    end
  end
end
%=============================================================================
function tbl = coefficientsTableLocal(fit, names)
  se = sqrt(diag(fit.Covariance));
  tStat = fit.Beta ./ se;
  if fit.DFE > 0
    pValue = 2 * (1 - tcdf(abs(tStat), fit.DFE));
  else
    pValue = NaN(size(tStat));
  end
  tbl = table(fit.Beta, se, tStat, pValue, 'VariableNames', {'Estimate', 'SE', 'tStat', 'pValue'}, ...
    'RowNames', names);
end
%=============================================================================
function names = coefficientNamesLocal(terms, intercept, predictorNames)
  names = {};
  if intercept
    names{end + 1} = '(Intercept)';
  end
  for k = 1:size(terms, 1)
    names{end + 1} = termNameLocal(terms(k, :), predictorNames);
  end
  names = names(:);
end
%=============================================================================
function name = termNameLocal(term, predictorNames)
  parts = {};
  for j = 1:length(term)
    if term(j) == 1
      parts{end + 1} = predictorNames{j};
    elseif term(j) > 1
      parts{end + 1} = [predictorNames{j}, '^', int2str(term(j))];
    end
  end
  name = parts{1};
  for k = 2:length(parts)
    name = [name, ':', parts{k}];
  end
end
%=============================================================================
function value = rsquaredLocal(fit)
  if fit.SST == 0
    ordinary = NaN;
  else
    ordinary = 1 - fit.SSE / fit.SST;
  end
  if fit.DFE > 0 && fit.NumObservations > 1 && ~isnan(ordinary)
    adjusted = 1 - (1 - ordinary) * (fit.NumObservations - 1) / fit.DFE;
  else
    adjusted = NaN;
  end
  value = struct('Ordinary', ordinary, 'Adjusted', adjusted);
end
%=============================================================================
function values = expandVectorLocal(values, keep, n)
  expanded = NaN(n, 1);
  expanded(keep) = values;
  values = expanded;
end
%=============================================================================
function names = predictorNamesLocal(names, p)
  if isempty(names)
    names = cell(p, 1);
    for k = 1:p
      names{k} = ['x', int2str(k)];
    end
  else
    if length(names) ~= p
      error('Nelson:statistics:predictorNamesOneNamePredictor', 'PredictorNames must have one name per predictor.');
    end
    names = names(:);
  end
end
%=============================================================================
function validateResponseLocal(y, distribution)
  switch distribution
    case 'binomial'
      if any(y < 0 | y > 1 | y ~= fix(y))
        error('Nelson:statistics:yContain01Values', 'Y must contain 0 or 1 values for the binomial distribution.');
      end
    case 'poisson'
      if any(y < 0 | y ~= fix(y))
        error('Nelson:statistics:yContainNonnegativeIntegerValues', 'Y must contain nonnegative integer values for the poisson distribution.');
      end
  end
end
%=============================================================================
function name = optionNameLocal(value)
  if ~(ischar(value) || (isstring(value) && isscalar(value)))
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
  text = lower(char(value));
  names = {'intercept', 'predictornames', 'responsename', 'distribution', 'link', 'maxiter', 'tolfun'};
  exact = names(strcmp(names, text));
  if length(exact) == 1
    name = exact{1};
    return
  end
  matches = names(startsWith(names, text));
  if length(matches) ~= 1
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
  name = matches{1};
end
%=============================================================================
function name = distributionLocal(value)
  if ~(ischar(value) || (isstring(value) && isscalar(value)))
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Distribution');
  end
  text = lower(char(value));
  names = {'normal', 'binomial', 'poisson'};
  exact = names(strcmp(names, text));
  if length(exact) == 1
    name = exact{1};
    return
  end
  matches = names(startsWith(names, text));
  if length(matches) ~= 1
    error('Nelson:statistics:invalidDistributionValue', 'Invalid %s value.', 'Distribution');
  end
  name = matches{1};
end
%=============================================================================
function name = linkLocal(value)
  if ~(ischar(value) || (isstring(value) && isscalar(value)))
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Link');
  end
  text = lower(char(value));
  names = {'identity', 'log', 'logit'};
  exact = names(strcmp(names, text));
  if length(exact) == 1
    name = exact{1};
    return
  end
  matches = names(startsWith(names, text));
  if length(matches) ~= 1
    error('Nelson:statistics:invalidLinkValue', 'Invalid %s value.', 'Link');
  end
  name = matches{1};
end
%=============================================================================
function link = canonicalLinkLocal(distribution)
  switch distribution
    case 'binomial'
      link = 'logit';
    case 'poisson'
      link = 'log';
    otherwise
      link = 'identity';
  end
end
%=============================================================================
function validateDistributionLinkLocal(distribution, link)
  if strcmp(distribution, 'binomial') && ~strcmp(link, 'logit')
    error('Nelson:statistics:unsupportedLinkValueBinomialDistribution', 'Unsupported Link value for the %s distribution.', 'binomial');
  end
  if strcmp(distribution, 'poisson') && ~strcmp(link, 'log')
    error('Nelson:statistics:unsupportedLinkValuePoissonDistribution', 'Unsupported Link value for the %s distribution.', 'poisson');
  end
  if strcmp(distribution, 'normal') && ~any(strcmp(link, {'identity', 'log'}))
    error('Nelson:statistics:unsupportedLinkValueNormalDistribution', 'Unsupported Link value for the %s distribution.', 'normal');
  end
end
%=============================================================================
function name = responseNameLocal(value)
  if ~(ischar(value) || (isstring(value) && isscalar(value)))
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'ResponseName');
  end
  name = char(value);
end
%=============================================================================
function value = textVectorLocal(value, name)
  if isstring(value)
    value = cellstr(value(:));
  elseif iscellstr(value)
    value = value(:);
  else
    error('Nelson:validators:mustBeTextArray', '%s must be a string array or cell array of character vectors.', name);
  end
end
%=============================================================================
function value = logicalScalarLocal(value, name)
  if islogical(value) && isscalar(value)
    return
  end
  if isnumeric(value) && isscalar(value) && (value == 0 || value == 1)
    value = logical(value);
    return
  end
  error('Nelson:statistics:mustBeTrueOrFalse', '%s must be true or false.', name);
end
%=============================================================================
function value = positiveIntegerLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) ...
      && value > 0 && value == fix(value))
    error('Nelson:statistics:mustBePositiveInteger', '%s must be a positive integer scalar.', name);
  end
  value = double(value);
end
%=============================================================================
function value = positiveScalarLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) && value > 0)
    error('Nelson:statistics:mustBePositive', '%s must be a positive scalar.', name);
  end
  value = double(value);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function gm = fitgmdist(X, k, varargin)
  narginchk(2, Inf);
  nargoutchk(0, 1);
  X = __gmm_check_data__(X);
  k = positiveInteger(k, sprintf(_('%s must be a positive integer scalar.'), 'K'));
  if k > size(X, 1)
    error('Nelson:statistics:kTooLarge', 'K must not exceed the number of rows in X.');
  end
  if rem(length(varargin), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  opts = parseOptions(varargin, size(X, 2));
  best = [];
  for r = 1:opts.Replicates
    current = fitOneReplicate(X, k, opts, r);
    if isempty(best) || current.NegativeLogLikelihood < best.NegativeLogLikelihood
      best = current;
    end
  end
  gm = best;
end
%=============================================================================
function gm = fitOneReplicate(X, k, opts, replicate)
  [mu, Sigma, p] = initializeModel(X, k, opts, replicate);
  oldNlogL = Inf;
  converged = false;
  for iter = 1:opts.MaxIter
    [P, nlogL] = __gmm_responsibilities__(X, mu, Sigma, p);
    [mu, Sigma, p] = maximizeModel(X, P, opts);
    if isfinite(oldNlogL) && abs(oldNlogL - nlogL) <= opts.TolFun * (1 + abs(oldNlogL))
      converged = true;
      break
    end
    oldNlogL = nlogL;
  end
  [~, nlogL] = __gmm_responsibilities__(X, mu, Sigma, p);
  gm = gmdistribution(mu, Sigma, p);
  gm.NegativeLogLikelihood = nlogL;
  gm.NumIterations = iter;
  gm.Converged = converged;
  gm.RegularizationValue = opts.RegularizationValue;
  gm.CovarianceType = opts.CovarianceType;
  gm.SharedCovariance = opts.SharedCovariance;
  gm.AIC = 2 * modelParameterCount(gm) + 2 * nlogL;
  gm.BIC = modelParameterCount(gm) * log(size(X, 1)) + 2 * nlogL;
end
%=============================================================================
function opts = parseOptions(args, variables)
  opts = defaultOptions();
  for pos = 1:2:length(args)
    name = optionName(args{pos});
    value = args{pos + 1};
    switch name
      case 'regularizationvalue'
        opts.RegularizationValue = nonnegativeScalar(value, sprintf(_('%s must be nonnegative.'), 'RegularizationValue'));
      case 'replicates'
        opts.Replicates = positiveInteger(value, sprintf(_('%s must be a positive integer scalar.'), 'Replicates'));
      case 'start'
        opts.Start = value;
      case 'options'
        opts = mergeStatOptions(opts, value);
      case 'covariancetype'
        opts.CovarianceType = covarianceType(value);
      case 'sharedcovariance'
        opts.SharedCovariance = logicalScalar(value, sprintf(_('%s must be true or false.'), 'SharedCovariance'));
      case 'probabilitytolerance'
        opts.ProbabilityTolerance = nonnegativeScalar(value, sprintf(_('%s must be nonnegative.'), 'ProbabilityTolerance'));
      case 'maxiter'
        opts.MaxIter = positiveInteger(value, sprintf(_('%s must be a positive integer scalar.'), 'MaxIter'));
      case 'tolfun'
        opts.TolFun = positiveScalar(value, sprintf(_('%s must be a positive scalar.'), 'TolFun'));
    end
  end
  if strcmp(opts.CovarianceType, 'diagonal') && variables == 0
    error('Nelson:statistics:xLeastOneColumn', 'X must have at least one column.');
  end
end
%=============================================================================
function opts = defaultOptions()
  opts = struct('RegularizationValue', 1e-6, 'Replicates', 1, 'Start', 'plus', ...
    'MaxIter', 100, 'TolFun', 1e-6, 'CovarianceType', 'full', ...
    'SharedCovariance', false, 'ProbabilityTolerance', 0);
end
%=============================================================================
function opts = mergeStatOptions(opts, value)
  if ~isempty(value) && ~isstruct(value)
    error('Nelson:statistics:optionsStructure', 'Options must be a structure.');
  end
  if isempty(value)
    return
  end
  if isfield(value, 'MaxIter') && ~isempty(value.MaxIter)
    opts.MaxIter = positiveInteger(value.MaxIter, sprintf(_('%s must be a positive integer scalar.'), 'MaxIter'));
  end
  if isfield(value, 'TolFun') && ~isempty(value.TolFun)
    opts.TolFun = positiveScalar(value.TolFun, sprintf(_('%s must be a positive scalar.'), 'TolFun'));
  end
end
%=============================================================================
function [mu, Sigma, p] = initializeModel(X, k, opts, replicate)
  start = opts.Start;
  if isnumeric(start)
    labels = labelsFromNumericStart(X, k, start, replicate);
  else
    validateStartText(start);
    labels = deterministicStart(X, k);
  end
  [mu, Sigma, p] = maximizeModel(X, labelsToPosterior(labels, k), opts);
end
%=============================================================================
function labels = labelsFromNumericStart(X, k, start, replicate)
  if isvector(start) && length(start) == size(X, 1)
    labels = start(:);
  elseif ndims(start) == 2 && isequal(size(start), [k size(X, 2)])
    labels = nearestCenterLabels(X, start);
  elseif ndims(start) == 3 && size(start, 1) == k && size(start, 2) == size(X, 2)
    page = min(replicate, size(start, 3));
    labels = nearestCenterLabels(X, start(:, :, page));
  else
    error('Nelson:statistics:invalidStartValue', 'Invalid %s value.', 'Start');
  end
  if any(labels < 1) || any(labels > k) || any(floor(labels) ~= labels)
    error('Nelson:statistics:invalidStartValue', 'Invalid %s value.', 'Start');
  end
end
%=============================================================================
function labels = deterministicStart(X, k)
  [~, order] = sort(X(:, 1));
  labels = zeros(size(X, 1), 1);
  for pos = 1:length(order)
    labels(order(pos)) = mod(pos - 1, k) + 1;
  end
end
%=============================================================================
function validateStartText(value)
  if ~(ischar(value) || isStringScalar(value))
    error('Nelson:statistics:invalidStartValue', 'Invalid %s value.', 'Start');
  end
  text = lower(char(value));
  names = {'plus', 'sample', 'randsample'};
  if ~any(strncmp(names, text, length(text)))
    error('Nelson:statistics:invalidStartValue', 'Invalid %s value.', 'Start');
  end
end
%=============================================================================
function labels = nearestCenterLabels(X, centers)
  D = pdist2(X, centers);
  [~, labels] = min(D, [], 2);
end
%=============================================================================
function P = labelsToPosterior(labels, k)
  P = zeros(length(labels), k);
  for j = 1:k
    P(:, j) = labels == j;
  end
end
%=============================================================================
function [mu, Sigma, p] = maximizeModel(X, P, opts)
  n = size(X, 1);
  d = size(X, 2);
  nk = max(sum(P, 1), realmin);
  p = nk / n;
  mu = (P' * X) ./ repmat(nk(:), 1, d);
  Sigma = covariancePages(X, P, mu, nk, opts);
end
%=============================================================================
function Sigma = covariancePages(X, P, mu, nk, opts)
  d = size(X, 2);
  k = size(mu, 1);
  Sigma = zeros(d, d, k);
  for j = 1:k
    centered = X - repmat(mu(j, :), size(X, 1), 1);
    weighted = centered .* repmat(P(:, j), 1, d);
    Sigma(:, :, j) = centered' * weighted / nk(j);
    if strcmp(opts.CovarianceType, 'diagonal')
      Sigma(:, :, j) = diag(diag(Sigma(:, :, j)));
    end
    Sigma(:, :, j) = Sigma(:, :, j) + opts.RegularizationValue * eye(d);
  end
  if opts.SharedCovariance
    Sigma = repmat(sharedCovariance(Sigma, nk), [1 1 k]);
  end
end
%=============================================================================
function S = sharedCovariance(Sigma, nk)
  S = zeros(size(Sigma, 1), size(Sigma, 2));
  for j = 1:size(Sigma, 3)
    S = S + Sigma(:, :, j) * nk(j);
  end
  S = S / sum(nk);
end
%=============================================================================
function count = modelParameterCount(gm)
  k = gm.NumComponents;
  d = gm.NumVariables;
  if strcmp(gm.CovarianceType, 'diagonal')
    covParams = d;
  else
    covParams = d * (d + 1) / 2;
  end
  if gm.SharedCovariance
    totalCovParams = covParams;
  else
    totalCovParams = k * covParams;
  end
  count = k * d + totalCovParams + k - 1;
end
%=============================================================================
function name = optionName(value)
  if ~(ischar(value) || isStringScalar(value))
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
  text = lower(char(value));
  names = {'regularizationvalue', 'replicates', 'start', 'options', ...
    'covariancetype', 'sharedcovariance', 'probabilitytolerance', 'maxiter', 'tolfun'};
  matches = names(strncmp(names, text, length(text)));
  if isempty(matches)
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
  if length(matches) > 1
    error('Nelson:statistics:ambiguousNameValue', 'Ambiguous name-value argument name.');
  end
  name = matches{1};
end
%=============================================================================
function value = covarianceType(value)
  if ~(ischar(value) || isStringScalar(value))
    error('Nelson:statistics:covarianceTypeFullDiagonal', 'CovarianceType must be full or diagonal.');
  end
  text = lower(char(value));
  if strncmp('full', text, length(text))
    value = 'full';
  elseif strncmp('diagonal', text, length(text))
    value = 'diagonal';
  else
    error('Nelson:statistics:covarianceTypeFullDiagonal', 'CovarianceType must be full or diagonal.');
  end
end
%=============================================================================
function value = logicalScalar(value, message)
  if islogical(value) && isscalar(value)
    return
  end
  if isnumeric(value) && isscalar(value) && (value == 0 || value == 1)
    value = logical(value);
    return
  end
  error('Nelson:validators:mustBeLogicalScalar', message);
end
%=============================================================================
function value = positiveInteger(value, message)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) ...
      && floor(value) == value && value > 0)
    error('Nelson:statistics:mustBePositiveInteger', message);
  end
  value = double(value);
end
%=============================================================================
function value = positiveScalar(value, message)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) && value > 0)
    error('Nelson:statistics:mustBePositive', message);
  end
  value = double(value);
end
%=============================================================================
function value = nonnegativeScalar(value, message)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) && value >= 0)
    error('Nelson:statistics:mustBeNonnegative', message);
  end
  value = double(value);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function mdl = fitlm(X, y, varargin)
  narginchk(2, Inf);
  nargoutchk(0, 1);
  [X, y] = validateInputsLocal(X, y);
  [modelspec, args] = parseModelSpecLocal(varargin);
  opts = parseOptionsLocal(args);
  terms = modelTermsLocal(size(X, 2), modelspec);
  keep = ~isnan(y) & all(~isnan(X), 2);
  fit = fitLocal(X(keep, :), y(keep), terms, opts.Intercept);
  mdl = buildModelLocal(fit, X, y, keep, terms, opts);
end
%=============================================================================
function [X, y] = validateInputsLocal(X, y)
  if ~(isnumeric(X) && isreal(X) && ismatrix(X) && ~issparse(X))
    error('Nelson:statistics:xRealNumericMatrix', '%s must be a real numeric matrix.', 'X');
  end
  if ~(isnumeric(y) && isreal(y) && isvector(y) && ~issparse(y))
    error('Nelson:statistics:yRealNumericVector', '%s must be a real numeric vector.', 'Y');
  end
  X = double(X);
  y = double(y(:));
  if size(X, 1) ~= length(y)
    error('Nelson:statistics:xYSameNumberRows', '%s must have the same number of rows.', 'X and Y');
  end
  if size(X, 2) == 0
    error('Nelson:statistics:xContainLeastOnePredictor', 'X must contain at least one predictor.');
  end
end
%=============================================================================
function [modelspec, args] = parseModelSpecLocal(args)
  modelspec = 'linear';
  if ~isempty(args)
    first = args{1};
    if isModelSpecValueLocal(first)
      modelspec = first;
      args = args(2:end);
    end
  end
end
%=============================================================================
function tf = isModelSpecValueLocal(value)
  tf = isnumeric(value) && ~isscalar(value);
  if ischar(value) || (isstring(value) && isscalar(value))
    text = lower(char(value));
    specs = {'constant', 'linear', 'additive', 'interactions', 'interaction', ...
      'quadratic', 'purequadratic'};
    tf = any(strcmp(text, specs));
  end
end
%=============================================================================
function opts = parseOptionsLocal(args)
  opts = struct('Intercept', true, 'PredictorNames', [], 'ResponseName', 'y');
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  for k = 1:2:length(args)
    name = optionNameLocal(args{k});
    value = args{k + 1};
    switch name
      case 'intercept'
        opts.Intercept = logicalScalarLocal(value, 'Intercept');
      case 'predictornames'
        opts.PredictorNames = textVectorLocal(value, 'PredictorNames');
      case 'responsename'
        if ~(ischar(value) || (isstring(value) && isscalar(value)))
          error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'ResponseName');
        end
        opts.ResponseName = char(value);
    end
  end
end
%=============================================================================
function fit = fitLocal(X, y, terms, intercept)
  D = designMatrixLocal(X, terms, intercept);
  n = length(y);
  p = size(D, 2);
  beta = D \ y;
  yhat = D * beta;
  r = y - yhat;
  rankD = rank(D);
  dfe = n - rankD;
  sse = sum(r .^ 2);
  sst = sum((y - mean(y)) .^ 2);
  mse = NaN;
  if dfe > 0
    mse = sse / dfe;
  end
  XtXinv = pinv(D' * D);
  fit = struct('D', D, 'Beta', beta, 'Fitted', yhat, 'Residuals', r, 'Rank', rankD, ...
    'DFE', dfe, 'SSE', sse, 'SST', sst, 'MSE', mse, 'Covariance', mse * XtXinv, ...
    'NumCoefficients', p, 'NumObservations', n);
end
%=============================================================================
function mdl = buildModelLocal(fit, X, y, keep, terms, opts)
  mdl = LinearModel();
  mdl.Intercept = opts.Intercept;
  mdl.Terms = terms;
  mdl.Beta = fit.Beta;
  mdl.Covariance = fit.Covariance;
  mdl.NumObservations = fit.NumObservations;
  mdl.NumPredictors = size(X, 2);
  mdl.DFE = fit.DFE;
  mdl.RMSE = sqrt(fit.MSE);
  mdl.SSE = fit.SSE;
  mdl.SST = fit.SST;
  mdl.SSR = fit.SST - fit.SSE;
  mdl.Rsquared = rsquaredLocal(fit);
  mdl.FStat = fstatLocal(fit);
  mdl.ModelCriterion = modelCriterionLocal(fit);
  mdl.PredictorNames = predictorNamesLocal(opts.PredictorNames, size(X, 2));
  mdl.ResponseName = opts.ResponseName;
  mdl.CoefficientNames = coefficientNamesLocal(terms, opts.Intercept, mdl.PredictorNames);
  mdl.Coefficients = coefficientsTableLocal(fit, mdl.CoefficientNames);
  mdl.Fitted = expandVectorLocal(fit.Fitted, keep, size(X, 1));
  residuals = expandVectorLocal(fit.Residuals, keep, size(X, 1));
  mdl.Residuals = table(residuals, 'VariableNames', {'Raw'});
  y;
end
%=============================================================================
function D = designMatrixLocal(X, terms, intercept)
  D = zeros(size(X, 1), 0);
  if intercept
    D = ones(size(X, 1), 1);
  end
  for k = 1:size(terms, 1)
    col = ones(size(X, 1), 1);
    for j = 1:size(X, 2)
      if terms(k, j) ~= 0
        col = col .* (X(:, j) .^ terms(k, j));
      end
    end
    D = [D col];
  end
end
%=============================================================================
function terms = modelTermsLocal(p, modelspec)
  if ischar(modelspec) || (isstring(modelspec) && isscalar(modelspec))
    switch lower(char(modelspec))
      case 'constant'
        terms = zeros(0, p);
      case {'linear', 'additive'}
        terms = eye(p);
      case {'interactions', 'interaction'}
        terms = [eye(p); pairTermsLocal(p)];
      case 'quadratic'
        terms = [eye(p); pairTermsLocal(p); 2 * eye(p)];
      case 'purequadratic'
        terms = [eye(p); 2 * eye(p)];
      otherwise
        error('Nelson:statistics:invalidModelSpecification', 'Invalid model specification.');
    end
  elseif isnumeric(modelspec)
    if size(modelspec, 2) ~= p
      error('Nelson:statistics:modelMatrixOneColumnPredictor', 'Model matrix must have one column per %s.', 'predictor');
    end
    terms = double(modelspec);
    terms(all(terms == 0, 2), :) = [];
  else
    error('Nelson:statistics:invalidModelSpecification', 'Invalid model specification.');
  end
end
%=============================================================================
function terms = pairTermsLocal(p)
  terms = zeros(0, p);
  for i = 1:p
    for j = i + 1:p
      row = zeros(1, p);
      row(i) = 1;
      row(j) = 1;
      terms = [terms; row];
    end
  end
end
%=============================================================================
function tbl = coefficientsTableLocal(fit, names)
  se = sqrt(diag(fit.Covariance));
  tStat = fit.Beta ./ se;
  if fit.DFE > 0
    pValue = 2 * (1 - tcdf(abs(tStat), fit.DFE));
  else
    pValue = NaN(size(tStat));
  end
  tbl = table(fit.Beta, se, tStat, pValue, 'VariableNames', {'Estimate', 'SE', 'tStat', 'pValue'}, ...
    'RowNames', names);
end
%=============================================================================
function names = coefficientNamesLocal(terms, intercept, predictorNames)
  names = {};
  if intercept
    names{end + 1} = '(Intercept)';
  end
  for k = 1:size(terms, 1)
    names{end + 1} = termNameLocal(terms(k, :), predictorNames);
  end
  names = names(:);
end
%=============================================================================
function name = termNameLocal(term, predictorNames)
  parts = {};
  for j = 1:length(term)
    if term(j) == 1
      parts{end + 1} = predictorNames{j};
    elseif term(j) > 1
      parts{end + 1} = [predictorNames{j}, '^', int2str(term(j))];
    end
  end
  name = parts{1};
  for k = 2:length(parts)
    name = [name, ':', parts{k}];
  end
end
%=============================================================================
function value = rsquaredLocal(fit)
  if fit.SST == 0
    ordinary = NaN;
  else
    ordinary = 1 - fit.SSE / fit.SST;
  end
  if fit.DFE > 0 && fit.NumObservations > 1 && ~isnan(ordinary)
    adjusted = 1 - (1 - ordinary) * (fit.NumObservations - 1) / fit.DFE;
  else
    adjusted = NaN;
  end
  value = struct('Ordinary', ordinary, 'Adjusted', adjusted);
end
%=============================================================================
function value = fstatLocal(fit)
  df1 = max(fit.Rank - 1, 0);
  if df1 > 0 && fit.DFE > 0 && fit.MSE > 0
    f = ((fit.SST - fit.SSE) / df1) / fit.MSE;
    p = 1 - fcdf(f, df1, fit.DFE);
  else
    f = NaN;
    p = NaN;
  end
  value = struct('F', f, 'pValue', p, 'DF1', df1, 'DF2', fit.DFE);
end
%=============================================================================
function value = modelCriterionLocal(fit)
  n = fit.NumObservations;
  k = fit.NumCoefficients;
  if n == 0 || fit.SSE <= 0
    aic = NaN;
    bic = NaN;
  else
    logL = -0.5 * n * (log(2 * pi) + 1 + log(fit.SSE / n));
    aic = -2 * logL + 2 * k;
    bic = -2 * logL + k * log(n);
  end
  value = struct('AIC', aic, 'BIC', bic);
end
%=============================================================================
function values = expandVectorLocal(values, keep, n)
  expanded = NaN(n, 1);
  expanded(keep) = values;
  values = expanded;
end
%=============================================================================
function names = predictorNamesLocal(names, p)
  if isempty(names)
    names = cell(p, 1);
    for k = 1:p
      names{k} = ['x', int2str(k)];
    end
  else
    if length(names) ~= p
      error('Nelson:statistics:predictorNamesOneNamePredictor', 'PredictorNames must have one name per predictor.');
    end
    names = names(:);
  end
end
%=============================================================================
function name = optionNameLocal(value)
  if ~(ischar(value) || (isstring(value) && isscalar(value)))
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
  text = lower(char(value));
  names = {'intercept', 'predictornames', 'responsename'};
  matches = names(startsWith(names, text));
  if length(matches) ~= 1
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
  name = matches{1};
end
%=============================================================================
function value = textVectorLocal(value, name)
  if isstring(value)
    value = cellstr(value(:));
  elseif iscellstr(value)
    value = value(:);
  else
    error('Nelson:validators:mustBeTextArray', '%s must be a string array or cell array of character vectors.', name);
  end
end
%=============================================================================
function value = logicalScalarLocal(value, name)
  if islogical(value) && isscalar(value)
    return
  end
  if isnumeric(value) && isscalar(value) && (value == 0 || value == 1)
    value = logical(value);
    return
  end
  error('Nelson:statistics:mustBeTrueOrFalse', '%s must be true or false.', name);
end
