function R = timetableMathUnary(A, fun, functionName)
  T = table.applyUnary(timetable2table(A, 'ConvertRowTimes', false), fun, functionName);
  R = timetable.fromTableAndTimes(T, A.Properties.RowTimes, A.Properties);
end
