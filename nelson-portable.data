function [page, found] = externalHelpPage(keyword)
    % Read only loaded external module pages; no persistent/global help index.
    page = struct();
    found = false;
    if isstring(keyword) && isscalar(keyword)
        keyword = char(keyword);
    end
    if ~ischar(keyword) || ~isrow(keyword) || isempty(keyword)
        return
    end
    [names, paths] = getmodules('reverse');
    languages = unique({getlanguage(), getdefaultlanguage()}, 'stable');
    stylesheet = fullfile(modulepath('help_tools'), 'resources', 'nelson_json.xslt');
    for moduleIndex = 1:numel(names)
        corePath = fullfile(nelsonroot(), 'modules', names{moduleIndex});
        if samePath(paths{moduleIndex}, corePath)
            continue
        end
        for languageIndex = 1:numel(languages)
            directory = fullfile(paths{moduleIndex}, 'help', languages{languageIndex}, 'xml');
            if ~isdir(directory)
                continue
            end
            [page, found] = findPage(directory, keyword, stylesheet);
            if found
                return
            end
        end
    end
end
%=============================================================================
function [page, found] = findPage(directory, keyword, stylesheet)
    page = struct();
    found = false;
    files = dir(fullfile(directory, '*.xml'), '-s');
    if isempty(files)
        return
    end
    names = {files.name};
    preferred = strcmp(names, [keyword, '.xml']) | strcmp(names, [strrep(keyword, '.', '_'), '.xml']);
    order = [find(preferred), find(~preferred)];
    for fileIndex = order
        if strcmp(files(fileIndex).name, 'chapter.xml')
            continue
        end
        filename = fullfile(files(fileIndex).folder, files(fileIndex).name);
        try
            document = xmlread(filename, 'AllowDoctype', false);
            root = document.getDocumentElement();
            if ~strcmp(root.getTagName(), 'xmldoc')
                continue
            end
            basename = files(fileIndex).name(1:end-4);
            if ~strcmp(keyword, basename) && ~hasKeyword(root, keyword)
                continue
            end
            page = jsondecode(xslt(document, stylesheet, '-tostring'));
            fields = fieldnames(page);
            page = renameStructField(page, fields, lower(fields));
            page.examples = examples(root);
            found = true;
            return
        catch
            % A malformed/unreadable page must not prevent other help fallbacks.
            page = struct();
        end
    end
end
%=============================================================================
function matched = hasKeyword(root, keyword)
    matched = false;
    for tag = {'keyword', 'keyword_alias'}
        nodes = root.getElementsByTagName(tag{1});
        for index = 0:nodes.getLength()-1
            if strcmp(strtrim(char(nodes.item(index).getTextContent())), keyword)
                matched = true;
                return
            end
        end
    end
end
%=============================================================================
function values = examples(root)
    nodes = root.getElementsByTagName('example_item_data');
    values = cell(1, nodes.getLength());
    for index = 1:numel(values)
        values{index} = char(nodes.item(index-1).getTextContent());
    end
end
%=============================================================================
function equal = samePath(first, second)
    first = strrep(char(first), '\', '/');
    second = strrep(char(second), '\', '/');
    while endsWith(first, '/')
        first(end) = [];
    end
    while endsWith(second, '/')
        second(end) = [];
    end
    if ispc()
        equal = strcmpi(first, second);
    else
        equal = strcmp(first, second);
    end
end
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
% SPDX-License-Identifier: LGPL-3.0-or-later
%=============================================================================
function names = get_builtin_help_modules()
  run(fullfile(nelsonroot(), 'modules', 'modules.m'), false);
  names = string(cellfun(@(item) item{1}, modules_list, 'UniformOutput', false));
  root = fullfile(nelsonroot(), 'modules');
  folders = dir(root);
  for k = 1:numel(folders)
    name = folders(k).name;
    if ~folders(k).isdir || any(strcmp(names, name))
      continue;
    end
    directory = fullfile(root, name);
    manifest = fullfile(directory, 'module.json');
    if ~isfile(manifest) || ~isfolder(fullfile(directory, 'help')) ...
        || ~isfile(fullfile(directory, 'etc', 'startup.m'))
      continue;
    end
    try
      metadata = jsondecode(manifest, '-file');
    catch
      continue;
    end
    if isstruct(metadata) && isscalar(metadata) && isfield(metadata, 'builtin') ...
        && isequal(metadata.builtin, true)
      names(end + 1, 1) = string(name);
    end
  end
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function modules_help_list = get_modules_help_list()
    modules_help_list = get_builtin_help_modules();
    st_packages = nmm('list');
    external_modules_names = fieldnames(st_packages);
    modules_help_list = [modules_help_list; string(external_modules_names)];
    modules_help_list = filter_requested_modules(modules_help_list);
    modules_help_list = modules_help_list(has_help_directory(modules_help_list));
end
%=============================================================================
function modules_help_list = filter_requested_modules(modules_help_list)
    requested = getenv('NELSON_HELP_MODULES');
    if isempty(requested)
        return
    end
    wanted = string(strtrim(strsplit(requested, {',', ';'})));
    wanted = wanted(wanted ~= "");
    if isempty(wanted)
        return
    end
    keep = false(size(modules_help_list));
    for k = 1:length(modules_help_list)
        keep(k) = any(strcmp(modules_help_list(k), wanted));
    end
    modules_help_list = modules_help_list(keep);
end
%=============================================================================
function tf = has_help_directory(modules_help_list)
    tf = false(size(modules_help_list));
    for k = 1:length(modules_help_list)
        module_path = get_help_module_path(modules_help_list{k});
        tf(k) = ~isempty(module_path) && isdir([module_path, '/help']);
    end
end
%=============================================================================
function module_path = get_help_module_path(module_name)
    module_path = '';
    if ismodule(module_name)
        module_path = modulepath(module_name);
    else
        path = [nelsonroot(), '/modules/', module_name, '/etc/startup.m'];
        if isfile(path)
            module_path = [nelsonroot(), '/modules/', module_name, '/'];
        end
    end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function index_help_for_language(destination_dir, lang, modules_help_list, with_main)
  if ~isdir(destination_dir)
    return;
  end

  list_summary_files = {};
  for i = 1:numel(modules_help_list)
    module_name = modules_help_list{i};
    summary_file = fullfile(destination_dir, module_name, 'help_toc_summary.xml');
    if isfile(summary_file)
      list_summary_files = [list_summary_files; summary_file];
    else
      summary_file = fullfile(destination_dir, '../', getdefaultlanguage(), '/', module_name, '/help_toc_summary.xml');
      if isfile(summary_file)
        list_summary_files = [list_summary_files; summary_file];
      end
    end
  end
  if with_main
      main_summary_file = [nelsonroot() '/modules/main/help/' lang '/xml/summary_header.xml'];
      if ~isfile(main_summary_file)
          main_summary_file = [nelsonroot() '/modules/main/help/' getdefaultlanguage() '/xml/summary_header.xml'];
      end
      list_summary_files =[main_summary_file; list_summary_files];
  end


  xmldocmergesummary([destination_dir],list_summary_files);

  nelson_summary2html = [modulepath('help_tools'), '/resources/nelson_summary2html.xslt'];
  xmltransform([destination_dir '/help_summary.xml'], nelson_summary2html, [destination_dir '/summary.html']);

  nelson_toc2html = [modulepath('help_tools'), '/resources/nelson_toc2html.xslt'];
  xmltransform([destination_dir '/help_summary.xml'], nelson_toc2html, [destination_dir '/toc.html']);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function install_help(verbose)
  ver_number = version('-number');
  version_string = sprintf('%d.%d.%d', ver_number(1), ver_number(2), ver_number(3));
  destination_dir = get_help_cache_dir(version_string);
  makeSureDestinationDirExists(destination_dir);
  languages = get_deploy_languages();
  modules_help_list = get_modules_help_list();

  len = length(modules_help_list);
  progress_count = 0;
  progress_total = len + 1;
  lastDisplayedPercent = '';
  if verbose
    lastDisplayedPercent = dispPercentLevel(0, '');
  end

  for idx = [1:len]
    module_name = modules_help_list{idx};
    module_path = get_module_path(module_name);
    if ~isempty(module_path)
      install_module_help_archives(module_name, module_path, languages, destination_dir);
    end
    progress_count = progress_count + 1;
    if verbose
      percent = (progress_count * 100) * inv(progress_total);
      lastDisplayedPercent = dispPercentLevel(percent, lastDisplayedPercent);
    end
  end

  main_module_path = [nelsonroot(), '/modules/main'];
  install_main_help_archives(main_module_path, languages, destination_dir);
  progress_count = progress_count + 1;
  if verbose
    percent = (progress_count * 100) * inv(progress_total);
    lastDisplayedPercent = dispPercentLevel(percent, lastDisplayedPercent);
  end
  if verbose
    fprintf(stdout, '\n');
  end
end
%=============================================================================
function install_module_help_archives(module_name, module_path, languages, help_dir)
  for lang = languages'
    destination_dir = [help_dir, lang{1}];
    help_archive_name = [module_path, '/help/', nelsonappid(), '.modules.', module_name, '.help.', lang{1}, '.nhz'];
    install_help_archive(help_archive_name, destination_dir, module_name);
  end
end
%=============================================================================
function install_main_help_archives(main_module_path, languages, help_dir)
  for lang = languages'
    destination_dir = [help_dir, lang{1}];
    help_archive_name = [main_module_path, '/help/', nelsonappid(), '.modules.', 'main', '.help.', lang{1}, '.nhz'];
    archive_exists = isfile(help_archive_name);
    if install_help_archive(help_archive_name, destination_dir, 'main') || archive_exists
      copy_main_help_files(destination_dir);
      copy_viewer_files(destination_dir);
    end
  end
end
%=============================================================================
function copy_main_help_files(destination_dir)
  files = dir([destination_dir, '/main/*.*']);
  for k = 1:length(files)
    if ~files(k).isdir
      copyfile([destination_dir, '/main/', files(k).name], [destination_dir, '/', files(k).name]);
    end
  end
end
%=============================================================================
function copy_viewer_files(destination_dir)
  resources_dir = [modulepath('help_tools'), '/resources'];
  viewer_file = [resources_dir, '/help_viewer.html'];
  search_file = [resources_dir, '/search_results.html'];
  if isfile(viewer_file)
    copyfile(viewer_file, [destination_dir, '/index.html']);
  end
  if isfile(search_file)
    copyfile(search_file, [destination_dir, '/search_results.html']);
  end
end
%=============================================================================
function installed = install_help_archive(help_archive_name, destination_dir, module_name)
  installed = false;
  if ~isfile(help_archive_name)
    return;
  end
  if is_help_archive_current(help_archive_name, destination_dir, module_name)
    return;
  end
  unzip(help_archive_name, destination_dir);
  write_help_archive_marker(help_archive_name, destination_dir, module_name);
  installed = true;
end
%=============================================================================
function tf = is_help_archive_current(help_archive_name, destination_dir, module_name)
  tf = false;
  module_destination_dir = [destination_dir, '/', module_name];
  if ~isdir(module_destination_dir)
    return;
  end
  if strcmp(module_name, 'main') && ~isfile([destination_dir, '/index.html'])
    return;
  end
  marker_filename = get_help_archive_marker_filename(destination_dir, module_name);
  if ~isfile(marker_filename)
    return;
  end
  archive_info = dir(help_archive_name);
  marker_info = dir(marker_filename);
  if isempty(archive_info.datenum) || isempty(marker_info.datenum)
    return;
  end
  tf = marker_info.datenum >= archive_info.datenum;
end
%=============================================================================
function write_help_archive_marker(help_archive_name, destination_dir, module_name)
  marker_dir = get_help_archive_marker_dir(destination_dir);
  if ~isdir(marker_dir)
    mkdir(marker_dir);
  end
  marker_filename = get_help_archive_marker_filename(destination_dir, module_name);
  filewrite(marker_filename, help_archive_name);
end
%=============================================================================
function marker_filename = get_help_archive_marker_filename(destination_dir, module_name)
  marker_filename = [get_help_archive_marker_dir(destination_dir), '/', module_name, '.stamp'];
end
%=============================================================================
function marker_dir = get_help_archive_marker_dir(destination_dir)
  marker_dir = [destination_dir, '/.deployhelp'];
end
%=============================================================================
function newPrevious = dispPercentLevel(percent, previous)
  percent = round(percent);
  if ~isempty(previous)
    backspace = repmat(sprintf('\b'), 1, length(previous));
    newPrevious = sprintf('%d %%', percent);
    fprintf(stdout, '%s%s', backspace, newPrevious);
  else
    newPrevious = sprintf('%d %%', percent);
    fprintf(stdout, '\n%s %s', _('Extracting help files:'), newPrevious);
  end
end
%=============================================================================
function makeSureDestinationDirExists(destination_dir)
  if ~isdir(destination_dir)
    mkdir(destination_dir);
  end
  for lang = get_deploy_languages()'
    lang_dir = [destination_dir, '/', lang{1}];
    if ~isdir(lang_dir)
      mkdir(lang_dir);
    end
  end
end
%=============================================================================
function languages = get_deploy_languages()
  % Internal knob: NELSON_HELP_DEPLOY_LANGUAGES restricts the deployed
  % languages to the requested subset (comma/semicolon separated). Unset (the
  % default) deploys every available language. Used to keep the help_tools
  % test suite fast without dropping module coverage; not a public contract.
  languages = getavailablelanguages();
  requested = getenv('NELSON_HELP_DEPLOY_LANGUAGES');
  if isempty(requested)
    return
  end
  wanted = strtrim(strsplit(requested, {',', ';'}));
  keep = false(size(languages));
  for k = 1:numel(languages)
    keep(k) = any(strcmp(languages{k}, wanted));
  end
  if any(keep)
    languages = languages(keep);
  end
end
%=============================================================================
function help_dir = get_help_cache_dir(version_string)
  help_dir = getenv('NELSON_HELP_CACHE_DIR');
  if ~isempty(help_dir)
    help_dir = ensureTrailingFileSeparator(help_dir);
  elseif ~isempty(getenv('NELSON_PREFERENCES_PATH'))
    help_dir = [prefdir(), '/help/'];
  else
    help_dir = [userdir(), '/Nelson/', version_string, '/help/'];
  end
end
%=============================================================================
function path = ensureTrailingFileSeparator(path)
  if ~endsWith(path, '/')
    path = [path, '/'];
  end
end
%=============================================================================
function module_path = get_module_path(module_name)
  module_path = '';
  if ismodule(module_name)
    module_path = modulepath(module_name);
  else
    path = [nelsonroot(), '/modules/', module_name, '/etc/startup.m'];
    if isfile(path)
      module_path = [nelsonroot(), '/modules/', module_name, '/'];
    end
  end
end
