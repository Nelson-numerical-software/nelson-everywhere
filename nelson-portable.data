function out = horzcat(varargin)
  out = varargin{1};
  for k = 2:nargin
    names = fieldnames(varargin{k}.Members_);
    for j = 1:length(names)
      out = addts(out, varargin{k}.Members_.(names{j}), names{j});
    end
  end
end
