%=============================================================================
A = [-10 0.1; 0 -20];
B = [0; 10];
C = [10 0];
D = [0];
G = [10 0; 0 10];
H = [0 0];
Q = [0.1 0; 0 0.1];
R = 10;
N = [0; 0];
sys = ss(A, [B G], C, [D H]);
[kEst, l, p, m, z] = kalman(sys, Q, R, N);

A_REF = [-14.14 0.1; -0.007322 -20];
B_REF = [0 0.4142; 10 0.0007322];
C_REF = [10 0; 1 0; 0 1];
D_REF = [0 0; 0 0; 0 0];
l_REF = [0.4142; 0.0007];
p_REF = [0.4142 0.0007; 0.0007 0.2500];
m_REF = [];
z_REF = [];

asserts.isapprox(kEst.A, A_REF, 1e-4);
asserts.isapprox(kEst.B, B_REF, 1e-4);
asserts.isapprox(kEst.C, C_REF, 1e-4);
asserts.isapprox(kEst.D, D_REF, 1e-4);
asserts.isapprox(l, l_REF, 1e-4);
asserts.isapprox(p, p_REF, 1e-3);
asserts.isapprox(m, m_REF, 1e-4);
asserts.isapprox(z, z_REF, 1e-4);
%=============================================================================
A = [11.269 -0.4940 1.129; 1.0000 0 0; 0 1.0000 0];
