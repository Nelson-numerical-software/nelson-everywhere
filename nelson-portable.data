%=============================================================================
function value = var(obj, varargin)
  data = obj.Data;
  n = size(data, 1);
  if n <= 1
    value = zeros(1, size(data, 2));
    return
  end
  centered = data - mean(data, 1);
  value = sum(centered .* centered, 1) ./ (n - 1);
end
