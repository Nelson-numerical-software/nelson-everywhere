% LICENCE_BLOCK_END
%=============================================================================
function varargout = title(varargin)
  narginchk(1, 10000);
  nargoutchk(0, 2);

  if (isgraphics(varargin{1}, 'tiledlayout'))
    if nargin < 2
      error('Nelson:title:textExpected', 'Invalid input argument: title text expected.');
    end
    parent = varargin{1};
    titleContent = charScalar(varargin{2});
    h = parent.Title;
    s = parent.Subtitle;
    [hasSubtitle, subtitleContent, propertyArguments] = parseSubtitleAndProperties(h, varargin, 3);
    set(h, 'String', titleContent, ...
      'HorizontalAlignment', 'center', ...
      'VerticalAlignment', 'bottom', ...
      'FontWeight', 'normal', ...
      propertyArguments{:});
    if hasSubtitle
      set(s, 'String', subtitleContent, ...
        'HorizontalAlignment', 'center', ...
        'VerticalAlignment', 'bottom', ...
        'FontWeight', 'normal');
    end
    if (nargout > 0)
      varargout{1} = h;
    end
    if (nargout > 1)
      varargout{2} = s;
    end
    return;
  elseif isgraphics(varargin{1}, 'legend')
    if nargin < 2
      error('Nelson:title:textExpected', 'Invalid input argument: title text expected.');
    end
    if nargout > 1
      error('Nelson:tooManyOutputs', 'Too many output arguments.');
    end
    parent = varargin{1};
    titleContent = charScalar(varargin{2});
    h = parent.Title;
    set(h, 'String', titleContent, varargin{3:end});
    if (nargout > 0)
      varargout{1} = h;
    end
    return;
  elseif isgraphics(varargin{1})
    indexArguments = 2;
    parent = varargin{1};
  elseif (ischar(varargin{1}) || isStringScalar(varargin{1}))
    indexArguments = 1;
    parent = gca();
  else
    error('Nelson:title:invalidInputArgument', 'Invalid input argument: graphics object or text value expected.');
  end

  % Title stays visible independently of the axes 'Visible' state, so a title
  % set on an axes with hidden decorations (e.g. after 'axis off', as done by
  % pie) still renders.
  visibility = 'on';

  titleContent = charScalar(varargin{indexArguments});

  indexArguments = indexArguments + 1;

  h = parent.Title;
  if ~(isscalar(h) && isgraphics(h, 'text'))
    h = __text__('Parent', parent, 'AutoParent', 'off');
  end
  if isEmptyTextString(h.String)
    set(h, ...
      'Parent', parent, ...
      'Margin', 3, ...
      'AffectAutoLimits', 'off', ...
      'Visible', visibility, ...
      'Clipping', 'off', ...
      'HandleVisibility', 'off', ...
      'FontName', 'Helvetica', ...
      'Color', [0.129411764705882, 0.129411764705882, 0.129411764705882]);
  end

  [hasSubtitle, subtitleContent, propertyArguments] ...
    = parseSubtitleAndProperties(h, varargin, indexArguments);
  setIfNotEmpty(h, propertyArguments);
  parent.Title = h;
  removeChild(parent, parent.Title);
  set(h, 'String', titleContent);

  if isprop(parent, 'Subtitle')
    if hasSubtitle
      s = parent.Subtitle;
      if ~(isscalar(s) && isgraphics(s, 'text'))
        s = __text__('Parent', parent, 'AutoParent', 'off');
      end
      if isEmptyTextString(s.String)
        set(s, ...
          'Parent', parent, ...
          'Margin', 3, ...
          'AffectAutoLimits', 'off', ...
          'Visible', visibility, ...
          'Clipping', 'off', ...
          'HandleVisibility', 'off', ...
          'FontName', 'Helvetica', ...
          'Color', [0.129411764705882, 0.129411764705882, 0.129411764705882]);
      end
      setIfNotEmpty(s, propertyArguments);
      parent.Subtitle = s;
      removeChild(parent, parent.Subtitle);
      set(s, 'String', subtitleContent);
    elseif isgraphics(parent.Subtitle, 'text')
      parent.Subtitle.String = '';
    end
  elseif nargout > 1
    error('Nelson:tooManyOutputs', 'Too many output arguments.');
  end
  setIfNotEmpty(h, propertyArguments);
  if hasSubtitle
    setIfNotEmpty(parent.Subtitle, propertyArguments);
  end
  refreshTitleLayout(parent);
  applyImageAxesTitleState(parent);


  if (nargout > 0)
    varargout{1} = parent.Title;
  end
  if (nargout > 1)
    varargout{2} = parent.Subtitle;
  end
end
%=============================================================================
function applyImageAxesTitleState(parent)
  if ~isgraphics(parent, 'axes') || ~is2D(parent)
    return
  end
  children = get(parent, 'Children');
  hasImage = false;
  for k = 1:numel(children)
    if strcmp(get(children(k), 'Type'), 'image')
      hasImage = true;
      break
    end
  end
  if ~hasImage
    return
  end
  parent.Box = 'on';
  parent.ZLim = [-1 1];
  parent.ZTick = [-1 0 1];
end
%=============================================================================
function removeChild(parent, h)
  if ~isgraphics(h)
    return;
  end
  children = allchild(parent);
  if ~isempty(children)
    children(children == h) = [];
    parent.Children = children;
  end
end
%=============================================================================
function value = charScalar(value)
  if isStringScalar(value)
    value = convertStringsToChars(value);
  end
end
%=============================================================================
function tf = isEmptyTextString(value)
  tf = length(value) == 0 || strcmp(value, '');
end
%=============================================================================
function [hasSubtitle, subtitleContent, propertyArguments] ...
  = parseSubtitleAndProperties(h, args, indexArguments)
  hasSubtitle = false;
  subtitleContent = '';
  nargs = numel(args);
  if (indexArguments <= nargs ...
      && (ischar(args{indexArguments}) || isStringScalar(args{indexArguments})))
    candidatePropertyName = charScalar(args{indexArguments});
    if (indexArguments == nargs || ~isprop(h, candidatePropertyName))
      hasSubtitle = true;
      subtitleContent = charScalar(args{indexArguments});
      indexArguments = indexArguments + 1;
    end
  end
  if indexArguments <= nargs
    propertyArguments = args(indexArguments:end);
  else
    propertyArguments = {};
  end
end
%=============================================================================
function setIfNotEmpty(h, propertyArguments)
  if ~isempty(propertyArguments)
    set(h, propertyArguments{:});
  end
end
%=============================================================================
function refreshTitleLayout(parent)
  if isprop(parent, 'TitleHorizontalAlignment')
    parent.TitleHorizontalAlignment = parent.TitleHorizontalAlignment;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = triplot(varargin)
  nargoutchk(0, 1);
  narginchk(1, inf);
  inputArguments = convertStringToCharArgs(varargin);
  [tri, x, y, lineArguments] = parseTriplotInputs(inputArguments{:});
  [xData, yData] = triangulationLineData(tri, x, y);
  lineArguments = normalizeLineArguments(lineArguments);
  h = line(xData, yData, lineArguments{:});
  if nargout > 0
    varargout{1} = h;
  end
end
%=============================================================================
function [tri, x, y, lineArguments] = parseTriplotInputs(varargin)
  lineArguments = {};
  if isTriangulationObject(varargin{1})
    obj = varargin{1};
    points = obj.Points;
    tri = obj.ConnectivityList;
    if size(points, 2) < 2
      error('Nelson:triplot:invalidTriangulationPoints', 'Triangulation points must have at least two columns.');
    end
    x = points(:, 1);
    y = points(:, 2);
    lineArguments = varargin(2:end);
    return
  end
  if nargin < 3
    error('Nelson:notEnoughInputs', 'Not enough input arguments.');
  end
  tri = varargin{1};
  x = varargin{2};
  y = varargin{3};
  lineArguments = varargin(4:end);
end
%=============================================================================
function tf = isTriangulationObject(value)
  tf = isa(value, 'triangulation') || isa(value, 'delaunayTriangulation');
end
%=============================================================================
function lineArguments = normalizeLineArguments(lineArguments)
  if ~isempty(lineArguments) && isText(lineArguments{1}) ...
      && ~isValidGraphicsProperty('line', lineArguments{1})
    [lineStyle, color, marker, msg] = colstyle(lineArguments{1}, 'plot', false);
    if ~isempty(msg)
      error('Nelson:triplot:invalidLineSpec', msg.message);
    end
    lineArguments(1) = [];
    lineArguments = completeLineProperties(color, marker, lineStyle, lineArguments);
  else
    lineArguments = completeLineProperties([], 'none', '-', lineArguments);
  end
end
%=============================================================================
function lineArguments = completeLineProperties(color, marker, lineStyle, propertiesList)
  if isempty(color)
    color = getColorAndUpdateIndex(gca());
  end
  if isempty(marker)
    marker = 'none';
  end
  if isempty(lineStyle)
    if strcmp(marker, 'none')
      lineStyle = '-';
    else
      lineStyle = 'none';
    end
  end
  lineArguments = propertiesList;
  if ~hasProperty(lineArguments, 'Marker')
    lineArguments = [{'Marker', marker}, lineArguments];
  end
  if ~hasProperty(lineArguments, 'LineStyle')
    lineArguments = [{'LineStyle', lineStyle}, lineArguments];
  end
  if ~hasProperty(lineArguments, 'Color')
    lineArguments = [{'Color', color}, lineArguments];
  end
  if ~hasProperty(lineArguments, 'MarkerEdgeColor')
    lineArguments = [{'MarkerEdgeColor', color}, lineArguments];
  end
end
%=============================================================================
function tf = hasProperty(arguments, name)
  tf = false;
  for k = 1:2:length(arguments)
    if isText(arguments{k}) && strcmpi(arguments{k}, name)
      tf = true;
      return
    end
  end
end
%=============================================================================
function tf = isText(value)
  tf = ischar(value) || (isa(value, 'string') && isscalar(value));
end
%=============================================================================
function [xData, yData] = triangulationLineData(tri, x, y)
  tri = double(tri);
  x = x(:);
  y = y(:);
  if size(tri, 2) ~= 3
    error('Nelson:graphics:invalidTriangleConnectivity', 'Triangle connectivity must have three columns.');
  end
  if any(tri(:) < 1) || any(tri(:) > length(x)) || any(tri(:) ~= fix(tri(:)))
    error('Nelson:graphics:triangleConnectivityContainsInvalid', 'Triangle connectivity contains invalid point indices.');
  end
  edges = [tri(:, [1 2]); tri(:, [2 3]); tri(:, [3 1])];
  edges = unique(sort(edges, 2), 'rows');
  n = size(edges, 1);
  xData = NaN(3 * n, 1);
  yData = NaN(3 * n, 1);
  for k = 1:n
    offset = 3 * (k - 1);
    ids = edges(k, :);
    xData(offset + (1:2)) = x(ids);
    yData(offset + (1:2)) = y(ids);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = trisurf(varargin)
  nargoutchk(0, 1);
  narginchk(1, inf);
  inputArguments = convertStringToCharArgs(varargin);
  [go, tri, x, y, z, c, propertiesList] = parseTrisurfInputs(inputArguments{:});
  if isempty(go)
    go = graphicsParentProperty(propertiesList);
  end
  go = newplotTarget(go);
  previousNextPlot = go.NextPlot;
  go.NextPlot = 'add';
  vertices = [x(:), y(:), z(:)];
  faceValues = [];
  if isempty(c)
    faceValues = faceColorValues(tri, z);
  else
    faceValues = faceColorValues(tri, c);
  end
  if ~hasProperty(propertiesList, 'EdgeColor')
    propertiesList = [propertiesList, {'EdgeColor', go.XColor}];
  end
  if ~hasProperty(propertiesList, 'FaceVertexCData')
    propertiesList = [propertiesList, {'FaceVertexCData', mapFaceValuesToColors(go, faceValues)}];
  end
  if ~hasProperty(propertiesList, 'FaceColor')
    propertiesList = [propertiesList, {'FaceColor', 'flat'}];
  end
  h = patch(go, 'Faces', tri, 'Vertices', vertices, propertiesList{:});
  go.NextPlot = previousNextPlot;
  if strcmp(previousNextPlot, 'replaceall') || strcmp(previousNextPlot, 'replace')
    view(go, 3);
    grid(go, 'on');
  elseif strcmp(previousNextPlot, 'replacechildren')
    view(go, 3);
  end
  if nargout > 0
    varargout{1} = h;
  end
end
%=============================================================================
function [go, tri, x, y, z, c, propertiesList] = parseTrisurfInputs(varargin)
  go = [];
  c = [];
  propertiesList = {};
  if isscalar(varargin{1}) && isgraphics(varargin{1}, 'axes')
    go = varargin{1};
    varargin = varargin(2:end);
  end
  if isTriangulationObject(varargin{1})
    obj = varargin{1};
    points = obj.Points;
    tri = obj.ConnectivityList;
    if size(points, 2) ~= 3
      error('Nelson:trisurf:threeDimensionalTriangulationExpected', 'Three-dimensional triangulation expected.');
    end
    x = points(:, 1);
    y = points(:, 2);
    z = points(:, 3);
    varargin = varargin(2:end);
  else
    if length(varargin) < 4
      error('Nelson:notEnoughInputs', 'Not enough input arguments.');
    end
    tri = double(varargin{1});
    x = varargin{2};
    y = varargin{3};
    z = varargin{4};
    varargin = varargin(5:end);
  end
  if ~isempty(varargin)
    if ~isText(varargin{1}) || isempty(canonicalPatchPropertyName(varargin{1}))
      c = varargin{1};
      varargin = varargin(2:end);
    end
  end
  propertiesList = canonicalizePatchPropertyPairs(varargin);
  validateTriangulation(tri, x, y, z);
  if ~isempty(c) && ~isequal(size(c), size(z))
    error('Nelson:dimagree:colorDataSizeZ', 'Color data must have the same size as Z.');
  end
end
%=============================================================================
function propertyPairs = canonicalizePatchPropertyPairs(propertyPairs)
  if mod(length(propertyPairs), 2) ~= 0
    error('Nelson:graphics:nameValuePair', 'Name-value arguments must be paired.');
  end
  for k = 1:2:length(propertyPairs)
    canonicalName = canonicalPatchPropertyName(propertyPairs{k});
    if isempty(canonicalName)
      error('Nelson:graphics:invalidPropertyName', 'Invalid property name.');
    end
    propertyPairs{k} = canonicalName;
  end
end
%=============================================================================
function canonicalName = canonicalPatchPropertyName(name)
  canonicalName = '';
  if ~isText(name)
    return
  end
  names = {'AlphaDataMapping', 'AmbientStrength', 'BackFaceLighting', 'BeingDeleted', ...
    'BusyAction', 'CData', 'CDataMapping', 'Children', 'CreateFcn', 'DeleteFcn', ...
    'DiffuseStrength', 'DisplayName', 'EdgeAlpha', 'EdgeColor', 'EdgeLighting', ...
    'FaceAlpha', 'FaceColor', 'FaceLighting', 'Faces', 'FaceVertexCData', ...
    'Interruptible', 'LineStyle', 'LineWidth', 'Marker', 'MarkerEdgeColor', ...
    'MarkerFaceColor', 'MarkerSize', 'Parent', 'SpecularColorReflectance', ...
    'SpecularExponent', 'SpecularStrength', 'Tag', 'Type', 'UserData', ...
    'VertexNormals', 'Vertices', 'Visible', 'XData', 'XDataMode', 'YData', ...
    'YDataMode', 'ZData'};
  matches = {};
  for k = 1:length(names)
    if startsWith(lower(names{k}), lower(name))
      matches{end + 1} = names{k};
    end
  end
  if length(matches) == 1
    canonicalName = matches{1};
  elseif length(matches) > 1
    error('Nelson:trisurf:ambiguousPatchPropertyName', 'Ambiguous patch property name.');
  end
end
%=============================================================================
function tf = isTriangulationObject(value)
  tf = isa(value, 'triangulation') || isa(value, 'delaunayTriangulation');
end
%=============================================================================
function validateTriangulation(tri, x, y, z)
  if size(tri, 2) ~= 3
    error('Nelson:graphics:invalidTriangleConnectivity', 'Triangle connectivity must have three columns.');
  end
  if ~isequal(size(x), size(y)) || ~isequal(size(x), size(z))
    error('Nelson:dimagree:coordinateArraysSize', 'Coordinate arrays must have the same size.');
  end
  x = x(:);
  if any(tri(:) < 1) || any(tri(:) > length(x)) || any(tri(:) ~= fix(tri(:)))
    error('Nelson:graphics:triangleConnectivityContainsInvalid', 'Triangle connectivity contains invalid point indices.');
  end
end
%=============================================================================
function values = faceColorValues(tri, data)
  data = data(:);
  values = mean(data(tri), 2);
end
%=============================================================================
function colors = mapFaceValuesToColors(ax, scalars)
  scalars = scalars(:);
  colors = colormap(ax);
  if isempty(colors)
    colors = colormap();
  end
  if isempty(colors)
    colors = jet(64);
  end
  minScalar = min(scalars);
  maxScalar = max(scalars);
  if minScalar == maxScalar
    maxScalar = minScalar + 1;
  end
  ax.CLim = [minScalar, maxScalar];
  nbColors = size(colors, 1);
  indices = ceil((scalars - minScalar) ./ (maxScalar - minScalar) .* nbColors);
  indices(indices < 1) = 1;
  indices(indices > nbColors) = nbColors;
  colors = colors(indices, :);
end
%=============================================================================
function tf = hasProperty(arguments, name)
  tf = false;
  for k = 1:2:length(arguments)
    if isText(arguments{k}) && strcmpi(arguments{k}, name)
      tf = true;
      return
    end
  end
end
%=============================================================================
function tf = isText(value)
  tf = ischar(value) || (isa(value, 'string') && isscalar(value));
end
