% LICENCE_BLOCK_END
%=============================================================================
function [C, ia, ib] = setxor(A, B, varargin)
  [CA, ia] = setdiff(A, B, varargin{:});
  [CB, ib] = setdiff(B, A, varargin{:});
  C = [CA(:); CB(:)];
end
