% LICENCE_BLOCK_END
function grace = run_launcherGrace(options)
  grace = 0;
  if options.Retry <= 0
    return
  end
  policies = run_retryPolicies(options.RetryOnlyOn);
  if any(strcmp(policies, 'timeout')) || any(strcmp(policies, 'all'))
    grace = 90;
  end
end
