asserts.isequal(nargin('logical'), 1);
asserts.isequal(nargout('logical'), 1);
%=============================================================================
asserts.isequal(logical([0 1 2]), [false true true]);
asserts.isequal(class(logical(1)), 'logical');
%=============================================================================
% Generated portable test module boundary.
{
  "schemaVersion": 1,
  "examples": [
    {
      "file": "mat_file_roundtrip.m",
      "title": "MAT file round trip",
      "description": "Save selected variables to a temporary data file and reload them.",
      "tags": [
        "mat-file",
        "workspace"
      ],
      "requirements": []
    }
  ]
}
% Save selected variables in a temporary MAT file and reload them.
filename = [tempdir(), 'nelson-example.mat'];
labels = {'north', 'south'};
values = [12.3, 15.8];
save(filename, 'labels', 'values');
clear labels values;
load(filename);
disp(table(labels', values', 'VariableNames', {'Region', 'Value'}));
{
  "module": "matio"
}
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
folder = tempname();
mkdir(folder);
filename = fullfile(folder, 'loadmat_direct.mat');
%=============================================================================
A = reshape(1:6, 2, 3);
B = 'loadmat direct test';
savemat(filename, 'A', 'B');
clear A B;
%=============================================================================
st = loadmat(filename);
asserts.isequal(st.A, reshape(1:6, 2, 3));
asserts.isequal(st.B, 'loadmat direct test');
%=============================================================================
st = loadmat(filename, 'A');
asserts.isequal(st.A, reshape(1:6, 2, 3));
asserts.istrue(~isfield(st, 'B'));
%=============================================================================
rmfile(filename);
rmdir(folder);
%=============================================================================
% loading a missing file reports a stable identifier
asserts.checkerror('loadmat([tempname(), ''.mat''])', _('File does not exist.'), 'Nelson:matio:fileDoesNotExist');
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
folder = tempname();
mkdir(folder);
filename = fullfile(folder, 'savemat_direct.mat');
%=============================================================================
A = [1 2 3; 4 5 6];
B = true(1, 3);
savemat(filename, 'A', 'B');
%=============================================================================
asserts.istrue(ismatfile(filename));
st = loadmat(filename);
asserts.isequal(st.A, A);
asserts.isequal(st.B, B);
%=============================================================================
rmfile(filename);
rmdir(folder);
