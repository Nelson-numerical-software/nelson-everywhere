%=============================================================================
function [TR, fileformat, attributes, solidID] = stlread(filename)
  narginchk(1, 1);
  nargoutchk(0, 4);
  [connectivity, points, fileformat, attributes, solidID] = __stlread__(filename);
  TR = triangulation(connectivity, points);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function stlwrite(TR, filename, varargin)
  if nargin < 2
    error('Nelson:geometry:wrongNumberInputArguments', 'Wrong number of input arguments.');
  end
  [connectivity, points] = localTriangulationData(TR);
  [fileformat, attributes, solidID] = localParseOptions(size(connectivity, 1), varargin{:});
  __stlwrite__(connectivity, points, filename, fileformat, attributes, solidID);
end
%=============================================================================
function [connectivity, points] = localTriangulationData(TR)
  if ~isa(TR, 'triangulation')
    error('Nelson:geometry:triangulationObjectExpected', 'Triangulation object expected.');
  end
  connectivity = TR.ConnectivityList;
  points = TR.Points;
  if size(connectivity, 2) ~= 3
    error('Nelson:geometry:connectivityListThreeColumns', '%s must have three columns.', 'Connectivity list');
  end
  if size(points, 2) ~= 2 && size(points, 2) ~= 3
    error('Nelson:geometry:pointsTwoThreeColumns', '%s must have two or three columns.', 'Points');
  end
end
%=============================================================================
function [fileformat, attributes, solidID] = localParseOptions(ntri, varargin)
  fileformat = 'binary';
  attributes = [];
  solidID = [];
  if ~isempty(varargin) && localIsFileFormat(varargin{1})
    fileformat = lower(char(varargin{1}));
    varargin = varargin(2:end);
  elseif ~isempty(varargin) && localIsTextScalar(varargin{1}) ...
      && ~localIsName(varargin{1})
    error('Nelson:geometry:fileFormatBinaryText', 'File format must be ''binary'' or ''text''.');
  end
  if mod(length(varargin), 2) ~= 0
    error('Nelson:geometry:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  for k = 1:2:length(varargin)
    if ~localIsTextScalar(varargin{k})
      error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Name');
    end
    name = lower(char(varargin{k}));
    value = varargin{k + 1};
    if strcmp(name, 'attribute')
      attributes = uint16(value(:));
    elseif strcmp(name, 'solidindex')
      solidID = double(value(:));
    else
      error('Nelson:geometry:unsupportedNameValueArgument', 'Unsupported "%s" option.', 'name-value argument');
    end
  end
  if strcmp(fileformat, 'text') && ~isempty(attributes)
    error('Nelson:geometry:attributeParameterSupportedFileFormatBinary', '''Attribute'' parameter is only supported when file format is ''binary''.');
  end
  if strcmp(fileformat, 'binary') && ~isempty(solidID)
    error('Nelson:geometry:solidindexParameterSupportedFileFormatText', '''SolidIndex'' parameter is only supported when file format is ''text''.');
  end
  if strcmp(fileformat, 'binary') && isempty(attributes)
    attributes = uint16(zeros(ntri, 1));
  end
  if strcmp(fileformat, 'text') && isempty(solidID)
    solidID = ones(ntri, 1);
  end
end
%=============================================================================
function tf = localIsFileFormat(value)
  tf = false;
  if localIsTextScalar(value)
    text = lower(char(value));
    tf = strcmp(text, 'binary') || strcmp(text, 'text');
  end
end
%=============================================================================
function tf = localIsName(value)
  tf = false;
  if localIsTextScalar(value)
    text = lower(char(value));
    tf = strcmp(text, 'attribute') || strcmp(text, 'solidindex');
  end
end
%=============================================================================
function tf = localIsTextScalar(value)
  tf = ischar(value) || (isa(value, 'string') && isscalar(value));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [idx, bary] = tsearchn(points, tri, query)
  narginchk(3, 3);
  points = double(points);
  tri = double(tri);
  query = double(query);
  if size(query, 2) ~= size(points, 2) && size(query, 1) == size(points, 2)
    query = query.';
  end
  if size(query, 2) ~= size(points, 2)
    error('Nelson:geometry:queryPointsSameNumberColumnsPoints', '%s must have the same number of columns as points.', 'Query points');
  end
  nq = size(query, 1);
  ns = size(tri, 1);
  nv = size(tri, 2);
  idx = NaN(nq, 1);
  bary = NaN(nq, nv);
  tol = 1e-10;
  for q = 1:nq
    for s = 1:ns
      lambda = simplexBarycentric(points(tri(s, :), :), query(q, :));
      if all(lambda >= -tol) && all(lambda <= 1 + tol)
        idx(q) = s;
        bary(q, :) = lambda;
        break
      end
    end
  end
end
%=============================================================================
function lambda = simplexBarycentric(simplex, point)
  a = [simplex, ones(size(simplex, 1), 1)];
  rhs = [point, 1].';
  lambda = (a.' \ rhs).';
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [a, b] = voronoi(varargin)
  nargoutchk(0, 2);
  narginchk(1, 4);
  points = parseVoronoiInputs(varargin{:});
  if size(points, 2) ~= 2
    error('Nelson:geometry:twoDimensionalPointsExpected', 'Two-dimensional points expected.');
  end
  [vertices, cells] = voronoin(points);
  [vx, vy] = voronoiSegments(vertices, cells, points);
  if nargout == 0
    plot(points(:, 1), points(:, 2), '.', vx, vy);
    return
  end
  if nargout == 1
    a = plot(points(:, 1), points(:, 2), '.', vx, vy);
  else
    a = vx;
    b = vy;
  end
end
%=============================================================================
function points = parseVoronoiInputs(varargin)
  if length(varargin) == 1 && isa(varargin{1}, 'delaunayTriangulation')
    points = varargin{1}.Points;
  elseif length(varargin) == 1
    points = varargin{1};
  elseif length(varargin) == 2
    points = [varargin{1}(:), varargin{2}(:)];
  elseif length(varargin) == 3
    points = [varargin{1}(:), varargin{2}(:)];
  else
    error('Nelson:geometry:wrongNumberInputArguments', 'Wrong number of input arguments.');
  end
end
%=============================================================================
function [vx, vy] = voronoiSegments(vertices, cells, points)
  vx = [];
  vy = [];
  for k = 1:length(cells)
    cellIds = cells{k};
    cellIds = cellIds(isfinite(cellIds) & cellIds > 1);
    if length(cellIds) < 2
      continue
    end
    cellIds(end + 1) = cellIds(1);
    x = vertices(cellIds, 1);
    y = vertices(cellIds, 2);
    vx = [vx; [x(1:end - 1), x(2:end), NaN(size(x(1:end - 1)))](:)];
    vy = [vy; [y(1:end - 1), y(2:end), NaN(size(y(1:end - 1)))](:)];
  end
  if isempty(vx)
    [vx, vy] = boundedBisectors(points);
  end
end
%=============================================================================
function [vx, vy] = boundedBisectors(points)
  tri = delaunay(points);
  edgeList = unique(sort([tri(:, [1 2]); tri(:, [1 3]); tri(:, [2 3])], 2), 'rows');
  minp = min(points, [], 1);
  maxp = max(points, [], 1);
  span = max(maxp - minp);
  if span == 0
    span = 1;
  end
  minp = minp - span;
  maxp = maxp + span;
  vx = [];
  vy = [];
  for k = 1:size(edgeList, 1)
    a = points(edgeList(k, 1), :);
    b = points(edgeList(k, 2), :);
    mid = (a + b) ./ 2;
    direction = [-(b(2) - a(2)), b(1) - a(1)];
    normDirection = sqrt(sum(direction .* direction));
    if normDirection == 0
      continue
    end
    direction = direction ./ normDirection;
    segment = clipLineToBox(mid, direction, minp, maxp);
    if ~isempty(segment)
      vx = [vx; segment(1, 1); segment(2, 1); NaN];
      vy = [vy; segment(1, 2); segment(2, 2); NaN];
    end
  end
end
%=============================================================================
function segment = clipLineToBox(point, direction, minp, maxp)
  candidates = [];
  if direction(1) ~= 0
    for x = [minp(1), maxp(1)]
      t = (x - point(1)) / direction(1);
      y = point(2) + t * direction(2);
      if y >= minp(2) && y <= maxp(2)
        candidates = [candidates; x, y];
      end
    end
  end
  if direction(2) ~= 0
    for y = [minp(2), maxp(2)]
      t = (y - point(2)) / direction(2);
      x = point(1) + t * direction(1);
      if x >= minp(1) && x <= maxp(1)
        candidates = [candidates; x, y];
      end
    end
  end
  candidates = unique(candidates, 'rows');
  if size(candidates, 1) < 2
    segment = [];
  else
    segment = candidates(1:2, :);
  end
end
