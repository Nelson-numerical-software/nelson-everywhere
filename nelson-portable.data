% LICENCE_BLOCK_END
function test_suite = append_test_case_summary(test_suite, test_case)
  if test_case.isbench
    test_suite.bench = test_suite.bench + 1;
    if strcmp(test_case.status, 'Fail')
      test_suite.errors = test_suite.errors + 1;
    end
  else
    test_suite.tests = test_suite.tests + 1;
    test_suite = append_nonbench_summary(test_suite, test_case.status);
  end
end
