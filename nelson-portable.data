function obj = removets(obj, name)
  name = tscollectionValidName(timeseriesText(name, 'Timeseries name'));
  if isfield(obj.Members_, name)
    obj.Members_ = rmfield(obj.Members_, name);
  end
end
%=============================================================================
%=============================================================================
