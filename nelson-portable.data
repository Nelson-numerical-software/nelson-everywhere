% LICENCE_BLOCK_END
%=============================================================================
function TF = ismissing(T)
  TF = false(height(T), width(T));
  names = T.Properties.VariableNames;
  for k = 1:length(names)
    m = ismissing(T.(names{k}));
    if isvector(m)
      TF(:, k) = m(:);
    else
      TF(:, k) = any(reshape(m, height(T), []), 2);
    end
  end
end
