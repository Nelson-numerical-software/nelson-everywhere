function varargout = fsurf(varargin)
  narginchk(1, 1000);
  nargoutchk(0, 1);
  inputArguments = convertStringToCharArgs(varargin);
  if isscalar(inputArguments{1}) && isgraphics(inputArguments{1}, 'axes')
    ax = newplotTarget(inputArguments{1});
    inputArguments = inputArguments(2:end);
  else
    ax = newplotTarget(graphicsParentProperty(inputArguments));
  end
  [fun, xrange, yrange, meshDensity, xrangeSet, yrangeSet, propertiesList] = parseFsurfInputs(inputArguments);
  if ~isnumeric(meshDensity) || ~isscalar(meshDensity) || meshDensity < 2 || meshDensity ~= fix(meshDensity)
    error('Nelson:graphics:invalidMeshDensity', 'MeshDensity must be a positive integer greater than one.');
  end
  x = linspace(xrange(1), xrange(2), meshDensity);
  y = linspace(yrange(1), yrange(2), meshDensity);
  [X, Y] = meshgrid(x, y);
  Z = evaluateFunctionSurface(fun, X, Y);
  rangeProperties = {};
  if xrangeSet
    rangeProperties = [rangeProperties, {'XRange', xrange}];
  end
  if yrangeSet
    rangeProperties = [rangeProperties, {'YRange', yrange}];
  end
  h = __fsurf__('Parent', ax, 'Function', fun, rangeProperties{:}, 'MeshDensity', ...
    meshDensity, 'XData', X, 'YData', Y, 'ZData', Z, propertiesList{:});
  view(ax, 3);
  xlim(ax, xrange);
  ylim(ax, yrange);
  grid(ax, 'on');
  if nargout > 0
    varargout{1} = h;
  end
end
%=============================================================================
function [fun, xrange, yrange, meshDensity, xrangeSet, yrangeSet, propertiesList] = parseFsurfInputs(args)
  if isempty(args)
    error('Nelson:graphics:functionExpected', 'Function expected.');
  end
  fun = args{1};
  args = args(2:end);
  xrange = [-5 5];
  yrange = [-5 5];
  xrangeSet = false;
  yrangeSet = false;
  meshDensity = 35;
  if ~isempty(args) && isnumeric(args{1}) && isvector(args{1})
    range = args{1}(:)';
    if numel(range) == 2
      xrange = range;
      yrange = range;
      xrangeSet = true;
      yrangeSet = true;
    elseif numel(range) == 4
      xrange = range(1:2);
      yrange = range(3:4);
      xrangeSet = true;
      yrangeSet = true;
    else
      error('Nelson:graphics:invalidRange', 'Range must have two or four elements.');
    end
    args = args(2:end);
  end
  k = 1;
  while k <= length(args) - 1
    if ~ischar(args{k})
      break
    end
    name = lower(args{k});
    if strcmp(name, 'meshdensity')
      meshDensity = args{k + 1};
      args(k:k + 1) = [];
    elseif strcmp(name, 'xrange')
      xrange = args{k + 1};
      xrangeSet = true;
      args(k:k + 1) = [];
    elseif strcmp(name, 'yrange')
      yrange = args{k + 1};
      yrangeSet = true;
      args(k:k + 1) = [];
    else
      k = k + 2;
    end
  end
  propertiesList = args;
end
%=============================================================================
function Z = evaluateFunctionSurface(fun, X, Y)
  try
    Z = feval(fun, X, Y);
  catch
    Z = zeros(size(X));
    for k = 1:numel(X)
      Z(k) = feval(fun, X(k), Y(k));
    end
  end
  if ~isequal(size(Z), size(X))
    error('Nelson:fsurf:invalidFunction', 'Function must return an array the same size as X and Y.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = getframe(varargin)
  narginchk(0, 1);
  nargoutchk(0, 2);
  if nargin() == 0
    go = gca();
  else
    go = varargin{1};
  end
  isAxes = isgraphics(go, 'axes') || isgraphics(go, 'polaraxes');
  if ~isAxes && ~isgraphics(go, 'figure')
    error('Nelson:getframe:figureOrAxesExpected', 'figure or axes handle expected.');
  end
  if isAxes
    cdata = getframeAxes(go);
  else
    cdata = getframeFigure(go);
  end
  if nargout() == 2
    varargout{1} = cdata;
    varargout{2} = [];
  else
    varargout{1} = struct('cdata', cdata, 'colormap', []);
  end
end
%=============================================================================
function cdata = getframeAxes(ax)
  gof = ancestor(ax, 'figure');
  cdata = __getframe__(gof);
  units = ax.Units;
  ax.Units = 'pixels';
  pos = ax.Position;
  ax.Units = units;
  idxx1 = min(max(floor(pos(1)), 1), size(cdata, 2));
  idxx2 = min(idxx1 + max(round(pos(3)), 1) - 1, size(cdata, 2));
  idxx = idxx1:idxx2;
  idxy1 = min(max(floor(pos(2)), 1), size(cdata, 1));
  idxy2 = min(idxy1 + max(round(pos(4)), 1) - 1, size(cdata, 1));
  idxy = fliplr(size(cdata, 1) - (idxy1:idxy2) + 1);
  cdata = cdata(idxy, idxx, :);
end
%=============================================================================
function cdata = getframeFigure(f)
  cdata = __getframe__(f);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = grid(varargin)
  narginchk(0, 2);
  nargoutchk(0, 0);

  if (nargin == 0)
    ax = gca();
    gridToggle(ax);
    return;
  end
  inputArguments = varargin;
  if isgraphics(inputArguments{1})
    ax = inputArguments{1};
    inputArguments = inputArguments(2:end);
  else
    ax = gca();
  end

  if length(inputArguments) == 0
    gridToggle(ax);
  else
    if ischar(inputArguments)
      parameter = inputArguments;
    else
      parameter = inputArguments{1};
    end
    if ischar(parameter)
      if strcmp(parameter, 'on')
        gridOn(ax);
      elseif strcmp(parameter, 'off')
        gridOff(ax);
      elseif strcmp(parameter, 'minor')
        minorGridToggle(ax);
      else
        error('Nelson:grid:unknownCommandOption', 'Unknown command option.');
      end
    end
  end
end
%=============================================================================
function minorGridOn(go)
  go.XMinorGrid = 'on';
  go.YMinorGrid = 'on';
  go.ZMinorGrid = 'on';
end
%=============================================================================
function minorGridOff(go)
  go.XMinorGrid = 'off';
  go.YMinorGrid = 'off';
  go.ZMinorGrid = 'off';
end
%=============================================================================
function gridOff(go)
  go.XGrid = 'off';
  go.YGrid = 'off';
  go.ZGrid = 'off';
end
%=============================================================================
function gridOn(go)
  go.XGrid = 'on';
  go.YGrid = 'on';
  go.ZGrid = 'on';
end
%=============================================================================
function gridOff(go)
  go.XGrid = 'off';
  go.YGrid = 'off';
  go.ZGrid = 'off';
end
%=============================================================================
function gridToggle(go)
  if (strcmp(go.XGrid, 'on') || strcmp(go.YGrid, 'on') || strcmp(go.ZGrid, 'on'))
    gridOff(go);
  else
    gridOn(go);
  end
end
%=============================================================================
function minorGridToggle(go)
  if ~isprop(go, 'XMinorGrid')
    return
  end
  if (strcmp(go.XMinorGrid, 'on') || strcmp(go.YMinorGrid, 'on') || strcmp(go.ZMinorGrid, 'on'))
    minorGridOff(go);
  else
    minorGridOn(go);
  end
end
