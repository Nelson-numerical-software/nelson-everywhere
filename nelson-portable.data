[x, t, y] = lsim(sys, U, T, X0);

asserts.isequal(size(x), [11 1]);
asserts.isequal(size(t), [11 1]);
asserts.isequal(size(y), [11 3]);

x_REF = [0.1000;
    0.1097;
    0.1168;
    0.1198;
    0.1189;
    0.1143;
    0.1068;
    0.0971;
    0.0860;
    0.0739;
    0.0616];
t_REF = [0;
  0.1000;
  0.2000;
  0.3000;
  0.4000;
  0.5000;
  0.6000;
  0.7000;
  0.8000;
  0.9000;
  1.0000];
y_REF = [0.1000 0.1000 0.1000;
  -0.2849 0.0876 0.1097;
  -0.4067 0.0516 0.1168;
  -0.4098 0.0101 0.1198;
  -0.3613 -0.0287 0.1189;
  -0.2927 -0.0615 0.1143;
  -0.2193 -0.0871 0.1068;
  -0.1485 -0.1054 0.0971;
  -0.0843 -0.1170 0.0860;
  -0.0283 -0.1225 0.0739;
 0.0187 -0.1230 0.0616];

asserts.isapprox(x, x_REF, 1e-3);
asserts.isapprox(t, t_REF, 1e-3);
asserts.isapprox(y, y_REF, 1e-3);
