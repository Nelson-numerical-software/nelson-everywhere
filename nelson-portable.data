% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = im2double(varargin)
  narginchk(1, 2);
  nargoutchk(0, 1);
  img = varargin{1};
  isIndexed = false;
  if nargin == 2
    txt = varargin{2};
    mustBeTextScalar(txt, 2);
    txt = convertStringsToChars(txt);
    if ~strcmp(txt, 'indexed')
      error('Nelson:invalidText', 'Invalid text argument ''indexed'' expected.');
    end
    isIndexed = true;
  end
  switch class(img)
    case 'double'
      d = img;

    case {'logical', 'single'}
      d = double(img);

    case 'uint8'
      if isIndexed
        d = double(img) + 1;
      else
        d = double(img) / 255;
      end

    case 'uint16'
      if isIndexed
        d = double(img) + 1;
      else
        d = double(img) / 65535;
      end

    case 'int16'
      if ~isIndexed
        d = (double(img) + 32768) / 65535;
      else
        error('Nelson:image_processing:indexedImageDataTypeUint8Uint16', 'An indexed image must have a data type of ''uint8'', ''uint16'', ''double'', ''single'', or ''logical''.');
      end

    otherwise
      error('Nelson:image_processing:imageDoubleLogicalUint8Uint16Int16', 'Image must be double, logical, uint8, uint16, int16, or single.');
  end
  varargout{1} = d;
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function gray = im2gray(img)
  narginchk(1, 1);
  nargoutchk(0, 1);
  if isa(img, 'logical')
    error('Nelson:image_processing:imageNumericNonLogical', '%s must be numeric and non-logical.', 'Image');
  end
  if ~isnumeric(img)
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Image');
  end
  s = size(img);
  if length(s) > 2 && ~ip_is_rgb_image(img)
    error('Nelson:image_processing:rgbImageMNArray', '%s must be an M-by-N-by-3 array.', 'RGB image');
  end
  if ip_is_rgb_image(img)
    gray = rgb2gray(img);
  else
    gray = img;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function out = im2single(varargin)
  narginchk(1, 2);
  nargoutchk(0, 1);
  if nargin == 2
    txt = convertStringsToChars(varargin{2});
    if ~strcmp(txt, 'indexed')
      error('Nelson:invalidText', 'Invalid text argument ''indexed'' expected.');
    end
    img = varargin{1};
    switch class(img)
      case 'uint8'
        out = single(double(img) + 1);
      case 'uint16'
        out = single(double(img) + 1);
      case {'double', 'single'}
        out = single(img);
      case 'logical'
        out = single(img);
      otherwise
        error('Nelson:image_processing:indexedImageDataTypeNoSingle', 'An indexed image must have a data type of ''uint8'', ''uint16'', ''double'', or ''logical''.');
    end
  else
    out = single(im2double(varargin{1}));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function out = im2uint16(varargin)
  narginchk(1, 2);
  nargoutchk(0, 1);
  img = varargin{1};
  indexed = false;
  if nargin == 2
    txt = convertStringsToChars(varargin{2});
    if ~strcmp(txt, 'indexed')
      error('Nelson:invalidText', 'Invalid text argument ''indexed'' expected.');
    end
    indexed = true;
  end
  if indexed
    switch class(img)
      case 'uint16'
        out = img;
      case 'uint8'
        out = uint16(img);
      case 'double'
        ip_assert_integer_valued(img);
        if any(img(:) < 1) || any(img(:) > 65536)
          error('Nelson:image_processing:indexedDoubleImageValuesRange', 'Indexed double image values must be in the range [%d, %d].', 1, 65536);
        end
        out = uint16(img - 1);
      case 'single'
        ip_assert_integer_valued(img);
        if any(img(:) < 1) || any(img(:) > 65536)
          error('Nelson:image_processing:indexedSingleImageValuesRange', 'Indexed single image values must be in the range [%d, %d].', 1, 65536);
        end
        out = uint16(img - 1);
      case 'logical'
        out = uint16(img);
      otherwise
        error('Nelson:image_processing:indexedImageDataTypeUint8Uint16', 'An indexed image must have a data type of ''uint8'', ''uint16'', ''double'', ''single'', or ''logical''.');
    end
  else
    if ~any(strcmp(class(img), {'double', 'logical', 'uint8', 'uint16', 'int16', 'single'}))
      error('Nelson:image_processing:imageDoubleLogicalUint8Uint16Int16', 'Image must be double, logical, uint8, uint16, int16, or single.');
    end
    out = uint16(round(ip_clip01(ip_to_unit_double(img)) * 65535));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function out = im2uint8(varargin)
  narginchk(1, 2);
  nargoutchk(0, 1);
  img = varargin{1};
  indexed = false;
  if nargin == 2
    txt = convertStringsToChars(varargin{2});
    if ~strcmp(txt, 'indexed')
      error('Nelson:invalidText', 'Invalid text argument ''indexed'' expected.');
    end
    indexed = true;
  end
  if indexed
    switch class(img)
      case 'uint8'
        out = img;
      case 'uint16'
        if any(img(:) > 255)
          error('Nelson:image_processing:indexedUint16ImageValuesLessEqual', 'Indexed uint16 image values must be less than or equal to 255.');
        end
        out = uint8(img);
      case 'double'
        ip_assert_integer_valued(img);
        if any(img(:) < 1) || any(img(:) > 256)
          error('Nelson:image_processing:indexedDoubleImageValuesRange', 'Indexed double image values must be in the range [%d, %d].', 1, 256);
        end
        out = uint8(img - 1);
      case 'single'
        ip_assert_integer_valued(img);
        if any(img(:) < 1) || any(img(:) > 256)
          error('Nelson:image_processing:indexedSingleImageValuesRange', 'Indexed single image values must be in the range [%d, %d].', 1, 256);
        end
        out = uint8(img - 1);
      case 'logical'
        out = uint8(img);
      otherwise
        error('Nelson:image_processing:indexedImageDataTypeUint8Uint16', 'An indexed image must have a data type of ''uint8'', ''uint16'', ''double'', ''single'', or ''logical''.');
    end
  else
    if ~any(strcmp(class(img), {'double', 'logical', 'uint8', 'uint16', 'int16', 'single'}))
      error('Nelson:image_processing:imageDoubleLogicalUint8Uint16Int16', 'Image must be double, logical, uint8, uint16, int16, or single.');
    end
    out = uint8(round(ip_clip01(ip_to_unit_double(img)) * 255));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function out = imadjust(varargin)
  narginchk(1, 4);
  nargoutchk(0, 1);
  img = varargin{1};
  isMap = ip_is_colormap(img) && isa(img, 'double') && all(img(:) >= 0) && all(img(:) <= 1);
  if nargin < 2 || isempty(varargin{2})
    if isMap
      in = stretchlim(reshape(img, size(img, 1), 1, 3));
    else
      in = stretchlim(img);
    end
  else
    in = double(varargin{2});
  end
  if nargin < 3 || isempty(varargin{3})
    outRange = [0; 1];
  else
    outRange = double(varargin{3});
  end
  if nargin < 4
    gamma = 1;
  else
    gamma = double(varargin{4});
  end
  if isMap
    d = reshape(img, size(img, 1), 1, 3);
  else
    ip_assert_full_image(img, true);
    d = ip_to_unit_double(img);
  end
  channels = size(d, 3);
  if size(in, 2) == 1
    in = repmat(in(:), 1, channels);
  end
  if size(outRange, 2) == 1
    outRange = repmat(outRange(:), 1, channels);
  end
  if numel(gamma) == 1
    gamma = repmat(gamma, 1, channels);
  end
  y = zeros(size(d));
  for c = 1:channels
    lo = in(1, c); hi = in(2, c);
    if hi == lo
      error('Nelson:image_processing:inputIntensityRangeDistinctBounds', 'Input intensity range must have distinct bounds.');
    end
    plane = ip_clip01((d(:, :, c) - lo) / (hi - lo));
    plane = plane .^ gamma(c);
    y(:, :, c) = outRange(1, c) + plane * (outRange(2, c) - outRange(1, c));
  end
  y = ip_clip01(y);
  if isMap
    out = reshape(y, size(img, 1), 3);
    return;
  end
  switch class(img)
    case 'uint8'
      out = uint8(round(y * 255));
    case 'uint16'
      out = uint16(round(y * 65535));
    case 'int16'
      out = int16(round(y * 65535 - 32768));
    case 'single'
      out = single(y);
    otherwise
      out = y;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function bw = imbinarize(varargin)
  narginchk(1, Inf);
  nargoutchk(0, 1);
  img = varargin{1};
  method = 'global';
  sensitivity = 0.5;
  polarity = 'bright';
  argIndex = 2;
  if nargin >= 2 && (ischar(varargin{2}) || isstring(varargin{2}))
    method = lower(convertStringsToChars(varargin{2}));
    argIndex = 3;
  elseif nargin >= 2
    level = double(varargin{2});
    argIndex = 3;
  else
    level = graythresh(img);
  end
  while argIndex <= nargin
    if argIndex == nargin
      error('Nelson:image_processing:nameValueArgumentsAppearPairs', 'Name-value arguments must be paired.');
    end
    name = lower(convertStringsToChars(varargin{argIndex}));
    value = varargin{argIndex + 1};
    switch name
      case 'sensitivity'
        sensitivity = double(value);
      case 'foregroundpolarity'
        polarity = lower(convertStringsToChars(value));
      otherwise
        error('Nelson:image_processing:unsupportedImbinarizeOption', 'Unsupported "%s" option.', 'imbinarize');
    end
    argIndex = argIndex + 2;
  end
  d = ip_to_unit_double(img);
  switch method
    case 'global'
      if ~exist('level', 'var')
        level = graythresh(img);
      end
      bw = d > level;
    case 'adaptive'
      threshold = adaptthresh(img, sensitivity, 'ForegroundPolarity', polarity);
      if strcmp(polarity, 'bright')
        bw = d > threshold;
      else
        bw = d < threshold;
      end
    otherwise
      error('Nelson:image_processing:unsupportedImbinarizeMethod', 'Unsupported "%s" option.', 'imbinarize method');
  end
end
