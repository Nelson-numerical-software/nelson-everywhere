%=============================================================================
function c = calyears(x)
  narginchk(1, 1);
  if isa(x, 'calendarDuration')
    c = fix(calendarDuration.rawMonths(x) / 12);
  else
    c = calendarDuration(double(x), 0, 0);
  end
end
%=============================================================================
