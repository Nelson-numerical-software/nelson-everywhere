% json = NFlow.internal.planarGenerateLibrary()
%
% Acausal palette N7/N5: the GUI palette manifest for the planar 2-D multibody
% blocks, generated from NFlow.internal.planarCatalog. Frames are the planar connectors
% (undirected, domain "planar"); they are exported as `physicalPins` so the GUI
% renders and wires them like other physical pins, and NFlow.internal.planarExpand turns
% the frame-wire diagram into a planarMechanicalIsland. Id "builtin.acausal_planar".
%=============================================================================
function json = planarGenerateLibrary()
  catalog = NFlow.internal.planarCatalog();
  blocks = {};
  for k = 1:numel(catalog)
    blocks{end + 1} = pl_gen_block(catalog(k)); %#ok<AGROW>
  end
  json = ['{', ...
    '"id":"builtin.acausal_planar",', ...
    '"title":"Planar (acausal)",', ...
    '"version":"1.0.0",', ...
    '"format":"nflow-2",', ...
    '"metadata":{"author":"Allan CORNET","tool":"Nelson nflow"},', ...
    '"comment":"Planar 2-D multibody blocks (frame connectors); lower to planarMechanicalIsland.",', ...
    '"license":"LGPL-3.0",', ...
    '"builtin":true,', ...
    '"blocks":[', strjoin(blocks, ','), ']}'];
end
%=============================================================================
function s = pl_gen_block(c)
  W = 90; H = 70;
  % Frame connectors -> physical pins (drop the '<named frames>' placeholder).
  frames = {};
  for f = 1:numel(c.frames)
    nm = c.frames{f};
    if ~isempty(strfind(nm, '<'))
      continue
    end
    frames{end + 1} = nm; %#ok<AGROW>
  end
  pins = {};
  nf = numel(frames);
  for f = 1:nf
    if nf >= 2
      if f == 1; px = 0; side = 'left'; py = round(H / 2);
      elseif f == 2; px = W; side = 'right'; py = round(H / 2);
      else; px = round(W / 2); side = 'top'; py = 0; end
    else
      px = 0; side = 'left'; py = round(H / 2);
    end
    pins{end + 1} = sprintf(...
      '{"name":"%s","x":%d,"y":%d,"side":"%s","domain":"planar"}', ...
      frames{f}, px, py, side); %#ok<AGROW>
  end
  % Sensors emit one signal output.
  outputs = '[]';
  if ~isempty(c.signal)
    outputs = sprintf('[{"x":%d,"y":%d,"side":"bottom","name":"out"}]', round(W / 2), H);
  end
  % Default params.
  dp = {};
  for qq = 1:numel(c.params)
    pm = c.params{qq};
    if isnumeric(pm{2})
      dp{end + 1} = sprintf('"%s":%.15g', pm{1}, pm{2}); %#ok<AGROW>
    else
      dp{end + 1} = sprintf('"%s":"%s"', pm{1}, pm{2}); %#ok<AGROW>
    end
  end
  defaultParams = ['{', strjoin(dp, ','), '}'];
  iconName = [c.name, '.svg'];
  s = sprintf(['{"type":"%s","label":"%s","acausal":true,"domain":"planar",', ...
    '"width":%d,"height":%d,"physicalPins":[%s],"inputs":[],"outputs":%s,', ...
    '"defaultParams":%s,"icon":"%s",', ...
    '"render":{"type":"image","src":"%s"},"help":"%s"}'], ...
    c.name, c.name, W, H, strjoin(pins, ','), outputs, ...
    defaultParams, iconName, iconName, pl_esc(c.desc));
end
%=============================================================================
function o = pl_esc(s)
  o = strrep(s, '\', '\\');
  o = strrep(o, '"', '\"');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% [Ar, Br, Cr, Dr] = NFlow.internal.reduceDescriptor(A, B, C, D, mask)
%
% Reduce a LINEAR descriptor (semi-explicit index-1 DAE) system to an explicit
% state-space ODE by eliminating its algebraic states (Schur complement). This
% is the core of the acausal code-generation "voie B": a linear electrical /
% thermal island linearises to
%       E xdot = A x + B u ,  y = C x + D u ,  E = diag(mask)
% where mask(i)=1 marks a DIFFERENTIAL state (real xdot) and mask(i)=0 an
% ALGEBRAIC state (node potential / branch current, xdot has no meaning). The
% algebraic rows are the constraint 0 = Aad*xd + Aaa*xa + Ba*u, so
%       xa = -Aaa \ (Aad*xd + Ba*u)
% and substituting back yields the reduced system over the differential states
% xd only, which the (multi-state, scalar-I/O) stateSpace code generator emits:
%       Ar = Add - Ada*(Aaa\Aad)
%       Br = Bd  - Ada*(Aaa\Ba)
%       Cr = Cd  - Ca *(Aaa\Aad)
%       Dr = D   - Ca *(Aaa\Ba)
%
% Inputs:
%   A     nx x nx system Jacobian (row-major full descriptor form)
%   B     nx x nu input matrix
%   C     ny x nx output matrix
%   D     ny x nu feedthrough matrix
%   mask  length-nx vector, 1 = differential state, 0 = algebraic state
%
% Outputs: the reduced (Ar, Br, Cr, Dr) over the nd = sum(mask) differential
% states. When there is no algebraic state the system is returned unchanged.
%
% Errors if the algebraic block Aaa is singular (a higher-index DAE, outside
% this curated linear tier).
%=============================================================================
function [Ar, Br, Cr, Dr] = reduceDescriptor(A, B, C, D, mask)
  narginchk(5, 5);
  nx = size(A, 1);
  if size(A, 2) ~= nx
    error('Nelson:reduceDescriptor:nFlowInternalReduceDescriptorASquare2', 'NFlow.internal.reduceDescriptor: A must be square.');
  end
  mask = logical(mask(:).');
  if numel(mask) ~= nx
    error('Nelson:reduceDescriptor:nFlowInternalReduceDescriptorMaskLength2', 'NFlow.internal.reduceDescriptor: mask length must equal size(A, 1).');
  end
  if isempty(B); B = zeros(nx, 0); end
  if isempty(C); C = zeros(0, nx); end
  nu = size(B, 2);
  ny = size(C, 1);
  if isempty(D); D = zeros(ny, nu); end

  d = find(mask); % differential state indices
  a = find(~mask); % algebraic state indices

  Add = A(d, d);
  Bd = B(d, :);
  Cd = C(:, d);

  if isempty(a)
    % Already an explicit ODE (pure differential): nothing to eliminate.
    Ar = Add; Br = Bd; Cr = Cd; Dr = D;
    return
  end

  Ada = A(d, a);
  Aad = A(a, d);
  Aaa = A(a, a);
  Ba = B(a, :);
  Ca = C(:, a);

  if rcond(Aaa) < eps
    error('Nelson:nflow_blocks:singularAlgebraicBlock', 'NFlow.internal.reduceDescriptor: the algebraic block is singular (higher-index DAE); this island is outside the linear reducible tier.');
  end

  % Solve the algebraic block once for both the state and input couplings:
  %   Kad = Aaa \ Aad ,  Kbu = Aaa \ Ba   =>   xa = -Kad*xd - Kbu*u.
  K = Aaa \ [Aad, Ba];
  Kad = K(:, 1:numel(d));
  Kbu = K(:, numel(d) + 1:end);

  Ar = Add - Ada * Kad;
  Br = Bd - Ada * Kbu;
  Cr = Cd - Ca * Kad;
  Dr = D - Ca * Kbu;
end
