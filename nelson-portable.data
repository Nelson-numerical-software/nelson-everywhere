      "icon": "PlanarRollingWheel.svg",
      "render": {
        "type": "image",
        "src": "PlanarRollingWheel.svg"
      },
      "help": "Wheel at frame a rolls without slipping on the fixed surface line (px,py)+(dx,dy), staying at height radius."
