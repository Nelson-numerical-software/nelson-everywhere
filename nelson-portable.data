previous = getenv('NELSON_TERM_IS_UNICODE_SUPPORTED');
setenv('NELSON_TERM_IS_UNICODE_SUPPORTED', 'TRUE');
asserts.istrue(isunicodesupported())
setenv('NELSON_TERM_IS_UNICODE_SUPPORTED', previous);
%=============================================================================
% Generated portable test module boundary.
% Fill missing samples and compute a moving average.
measurements = [18; NaN; 21; 25; NaN; 24];
[cleaned, replaced] = fillmissing(measurements, 'linear');
smoothed = movmean(cleaned, 3);
disp(table(measurements, cleaned, replaced, smoothed));
% Count observations by category and display a summary table.
observations = table({'north'; 'south'; 'north'; 'east'; 'south'; 'north'}, ...
  [12; 8; 15; 11; 10; 16], 'VariableNames', {'Region', 'Value'});
summary = groupcounts(observations, 'Region');
disp(summary);
{
  "schemaVersion": 1,
  "examples": [
    {
      "file": "clean_measurements.m",
      "title": "Clean a measurement series",
      "description": "Interpolate missing values and compute a moving average.",
      "tags": [
        "data-cleaning",
        "missing-data"
      ],
      "requirements": []
    },
    {
      "file": "group_observations.m",
      "title": "Group observations",
      "description": "Count table rows by category and display a compact summary.",
      "tags": [
        "grouping",
        "table"
      ],
      "requirements": []
    }
  ]
}
