function value = ltiValidateTimeUnit(value)
  value = ltiValidateTextScalar('TimeUnit', value);
  supported = {'nanoseconds', 'microseconds', 'milliseconds', 'seconds', ...
    'minutes', 'hours', 'days', 'weeks', 'months', 'years'};
  if ~any(strcmp(value, supported))
    error('Nelson:control_system:invalidTimeUnit', '%s must be a valid time unit.', 'TimeUnit property');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2017 October Daniel MÃ¥rtensson (Swedish Embedded Control Systems Toolbox)
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = lyap(varargin)
  % Compute solution X of the Lyapunov equation
  narginchk(2, 2);
  nargoutchk(0, 1);

  A = varargin{1};
  Q = varargin{2};

  mustBeNumeric(A, 1);
  mustBeNumeric(Q, 2);
  mustBeReal(A, 1);
  mustBeReal(Q, 2);

  szA = size(A);
  szQ = size(Q);
  if ~isequal(szA(1), szA(2)) || ~isequal(szQ(1), szQ(2))
    error('Nelson:expectedSquare', '%s must be square.', 'Input');
  end

  K = kron(eye(size(A)), A) + kron(conj(A), eye(size(A)));
  X = K \ -Q(:);
  varargout{1} = reshape(X, size(A));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2017 October Daniel MÃ¥rtensson (Swedish Embedded Control Systems Toolbox)
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = minreal(varargin)
  % Minimal realization and pole-zero cancellation.
  % [a, b, c, d] = minreal(a, b, c, d)
  % [a, b, c, d] = minreal(a, b, c, d, tol)
  narginchk(4, 5);
  nargoutchk(0, 4);
  [msg, A, B, C, D] = abcdchk(varargin{:});
  if ~isempty(msg)
    error(msg.id, msg.message);
  end

  if nargin < 5
    tol = 1e-6;
  else
    tol = varargin{5};
  end

  [ns, nu] = size(B);
  if nargin < 5
    tol = 10 * ns * norm(A, 1) * eps;
  else
    tol = varargin{5};
  end

  [am, bm, cm, nn] = reduceSystem(A, B, C, ns, tol);
  if nn > 1
    msg = sprintf(_('%d states removed.'), nn);
  else
    msg = sprintf(_('%d state removed.'), nn);
  end
  disp(msg);

  varargout{1} = am;
  if nargout > 1
    varargout{2} = bm;
  end
  if nargout > 2
    varargout{3} = cm;
  end
  if nargout > 3
    varargout{4} = D;
  end
end
%=============================================================================
function [am, bm, cm, nn] = reduceSystem(A, B, C, ns, tol)
  [am, bm, cm, t, k] = ctrbf(A, B, C, tol);
  kk = sum(k);
  nn = ns - kk;
  nu = nn;
  idx = (nu + 1):ns;
  am = am(idx, idx);
  bm = bm(idx, :);
  cm = cm(:, idx);
  ns = ns - nu;
  if ns
    [am, bm, cm, t, k] = obsvf(am, bm, cm, tol);
    kk = sum(k);
    nu = ns - kk;
    nn = nn + nu;
    idx = (nu + 1):ns;
    am = am(idx, idx);
    bm = bm(idx, :);
    cm = cm(:, idx);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2017 Oktober Daniel MÃ¥rtensson (Swedish Embedded Control Systems Toolbox)
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = nyquist(varargin)
  % nyquist(sys)
  % nyquist(sys, w)
  % [re, im, w] = nyquist(...)

  narginchk(1, 2);
  nargoutchk(0, 3);

  sys = varargin{1};
  if ~islti(sys)
    error('Nelson:control_system:invalidType', '%s expected.', 'LTI model');
  end

  sys = tf(sys);
  if ~issiso(sys)
    error('Nelson:control_system:invalidType', '%s expected.', 'SISO LTI model');
  end
  numerator = sys.Numerator{1, 1};
  denominator = sys.Denominator{1, 1};
  Ts = sys.Ts;
  L = 500; % Number of frequency elements - Need to be 500 for the nyquist plot
  N = length(denominator); % Number of denominators

  % Check if there is any input
  if (nargin > 1)
    W = varargin{2};
    isCellW = (iscell(W) && length(W) == 2) && isscalar(W{1}) && isscalar(W{2}) && isnumeric(W{1}) && isnumeric(W{2});
    isVectorW = isnumeric(W) && isvector(W);
    haveW = isCellW || isVectorW;
    if (haveW)
      if isVectorW
        w = W;
      else
        w1 = W{1};
        w2 = W{2};
        w = logspace(log10(w1), log10(w2), L); % Angular frequencies
      end
    else
      error('Nelson:control_system:invalidParameter', 'Invalid parameter w.');
    end
  else
    zeroPole = [roots(numerator(:)); roots(denominator(:))];
    if isdt(sys)
      zeroPoleIndex = find(abs(zeroPole - 1.0) > norm(zeroPole) * eps & abs(zeroPole) > norm(zeroPole) * eps);
      zeroPole = zp(zeroPoleIndex);
      zeroPole = min(abs(log(zeroPole) / (2 * pi * sys.Ts)));
      wmin = floor(log10(zeroPole));
      wmax = log10(1 / (2 * sys.Ts)); % Nyquist
    else
      zeroPoleIndex = find(abs(zeroPole) > norm(zeroPole) * eps);
      zeroPole = zeroPole(zeroPoleIndex);
      wmin = min(abs(zeroPole));
      wmin = floor(log10(wmin));
      wmax = max(abs(zeroPole));
      wmax = ceil(log10(wmax));
    end

    if abs(denominator(end)) < norm(denominator) * eps
      wmin = wmin - 0.5;
      if isct(sys)
        wmax = wmax + 2.0;
      end
    else
      wmin = wmin - 2.0;
      if isct(sys)
        wmax = wmax + 2.0;
      end
    end
    w = logspace(wmin, wmax, L);
  end

  % Numerator and denominator need to be the same length
  if (length(numerator) > length(denominator))
    denominator = [zeros(1, size(numerator, 2) - size(denominator, 2)) denominator];
  elseif (length(numerator) < length(denominator))
    numerator = [zeros(1, size(denominator, 2) - size(numerator, 2)) numerator];
  end

  L = length(w);
  % Evaluate transfer function
  H = zeros(1, L);
  h = Ts;
  delay = 0;
  if (Ts > 0) % Discrete model
    for k = 1:L
      H(k) = (numerator * fliplr((exp(1i * w(k) * h)) .^ (0:N - 1)).') / (denominator * fliplr((exp(1i * w(k) * h)) .^ (0:N - 1)).') * exp(-delay * exp(1i * w(k) * h));
    end
  else
    for k = 1:L
      H(k) = (numerator * fliplr((1i * w(k)) .^ (0:N - 1)).') / (denominator * fliplr((1i * w(k)) .^ (0:N - 1)).') * exp(-delay * 1i * w(k));
    end
  end
  if nargout == 0
    nyquistplot(H, i, j)
  else
    varargout{1} = reshape(real(H)', 1, 1, length(H));
    if nargout > 1
      varargout{2} = reshape(imag(H)', 1, 1, length(H));
    end
    if nargout > 2
      varargout{3} = w';
    end
  end
end
%=============================================================================
function nyquistplot(H, i, j)
  c = [0 0 1];
  ax = gca();
  cla(ax);
  hold on
  plot(ax, real(H), imag(H), '-', 'Color', c);
  plot(ax, real(H), -imag(H), '-', 'Color', c);
  scatter(ax, -1, 0, 'Marker', '+', 'MarkerEdgeColor', 'r', 'LineWidth', 1.5);
  if (min(real(H)) > -1)
    ax.XLim = [min(real(H) - 2), ax.XLim(2)];
  end
  % Origin reference crosshair (dotted light gray lines through Real = 0 and Imaginary = 0)
  topChildren = ax.Children;
  xLimits = ax.XLim;
  yLimits = ax.YLim;
  gridColor = [0.8, 0.8, 0.8];
  hHorizontal = plot(ax, xLimits, [0, 0], ':', 'Color', gridColor);
  hVertical = plot(ax, [0, 0], yLimits, ':', 'Color', gridColor);
  ax.XLim = xLimits;
  ax.YLim = yLimits;
  % keep the crosshair behind the response curve
  ax.Children = [topChildren; hVertical; hHorizontal];
  % Direction arrows: filled triangles oriented along the response curve, drawn
  % once the axis limits are final so the heads are shaped in screen space.
  drawDirectionArrows(ax, H, c);
  % arrow patches must not disturb the finalized limits
  ax.XLim = xLimits;
  ax.YLim = yLimits;
  box(ax, 'on');
  hold off
  hTitle = title(ax, _('Nyquist Diagram'));
  xlabel(ax, _('Real Axis'));
  ylabel(ax, _('Imaginary Axis'));
  % Center the title above the axes box with a consistent gap, expressed in
  % normalized axes units so it stays clear of the response curve regardless
  % of the data limits (the curve reaches the top of the box).
  set(hTitle, 'Units', 'normalized', 'Position', [0.5, 1.03, 0], ...
    'HorizontalAlignment', 'center', 'VerticalAlignment', 'bottom');
end
%=============================================================================
function drawDirectionArrows(ax, H, c)
  % Place one filled arrowhead on each branch of the Nyquist plot, at the
  % arc-length midpoint of the response curve, pointing along the curve tangent.
  re = real(H);
  im = imag(H);
  L = numel(re);
  if (L < 3)
    return;
  end
  segments = sqrt(diff(re) .^ 2 + diff(im) .^ 2);
  arcLength = [0, cumsum(segments)];
  total = arcLength(end);
  if (~isfinite(total) || total <= 0)
    return;
  end
  [~, k] = min(abs(arcLength - 0.5 * total));
  % keep an interior sample so the central-difference tangent is well defined
  k = max(2, min(L - 1, k));
  % tangent in the direction of increasing frequency
  tx = re(k + 1) - re(k - 1);
  ty = im(k + 1) - im(k - 1);
  % Positive-frequency branch: y = imag(H), arrow follows increasing frequency.
  drawArrowHead(ax, re(k), im(k), tx, ty, c);
  % Negative-frequency (mirror) branch: y = -imag(H). The full Nyquist contour
  % traverses this branch in the opposite sense, so the head is reversed along
  % the real axis while the imaginary component is mirrored.
  drawArrowHead(ax, re(k), -im(k), -tx, ty, c);
end
%=============================================================================
function drawArrowHead(ax, x, y, tx, ty, c)
  % Draw a filled triangular arrowhead anchored at (x, y) pointing along the
  % tangent (tx, ty). The head is shaped in pixel space so it looks correct
  % even when the two axes have different data-to-pixel scaling.
  oldUnits = ax.Units;
  ax.Units = 'pixels';
  boxPosition = ax.Position;
  ax.Units = oldUnits;
  widthPixels = boxPosition(3);
  heightPixels = boxPosition(4);
  xSpan = ax.XLim(2) - ax.XLim(1);
  ySpan = ax.YLim(2) - ax.YLim(1);
  if (widthPixels <= 0 || heightPixels <= 0 || xSpan <= 0 || ySpan <= 0)
    return;
  end
  % pixels per data unit on each axis
  scaleX = widthPixels / xSpan;
  scaleY = heightPixels / ySpan;
  % unit tangent in pixel space
  ux = tx * scaleX;
  uy = ty * scaleY;
  tangentNorm = hypot(ux, uy);
  if (tangentNorm == 0)
    return;
  end
  ux = ux / tangentNorm;
  uy = uy / tangentNorm;
  % perpendicular in pixel space
  vx = -uy;
  vy = ux;
  headLength = 13; % tip-to-base length in pixels
  headHalfWidth = 6; % half base width in pixels
  forward = 0.6 * headLength;
  backward = 0.4 * headLength;
  % triangle vertices as pixel offsets from the anchor point
  offsetX = [ux * forward, -ux * backward + vx * headHalfWidth, -ux * backward - vx * headHalfWidth];
  offsetY = [uy * forward, -uy * backward + vy * headHalfWidth, -uy * backward - vy * headHalfWidth];
  % convert the pixel offsets back to data coordinates
  xVertices = x + offsetX / scaleX;
  yVertices = y + offsetY / scaleY;
  patch(ax, xVertices, yVertices, c, 'EdgeColor', c, 'LineWidth', 0.5);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2017 Oktober Daniel MÃ¥rtensson (Swedish Embedded Control Systems Toolbox)
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = obsv(varargin)
  % Generates the observability matrix of a state space model
  % Ob = obsv(A, C)
  % Ob = obsv(sys)
  narginchk(1, 2);
  nargoutchk(0, 1);
  if nargin == 1
    sys = varargin{1};
    sys = ss(sys);
    A = sys.A;
    C = sys.C;
  else
    A = varargin{1};
    C = varargin{2};
    [mA, nA] = size(A);
    [mC, nC] = size(C);
    if (mA ~= nA)
      error('Nelson:expectedSquare', '%s must be square.', 'Matrix A');
    end
    if (nC ~= nA)
      error('Nelson:control_system:AAndCNumColumnsMismatch', 'Matrices %s and %s should have an identical number of columns.', 'A', 'C');
    end
  end
  n = size(A, 1);
  % Compute the observability matrix now!
  Or = [];
  for i = 0:(n - 1)
    Or = [Or; C * A ^ i];
  end
  varargout{1} = Or;
end
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = obsvf(varargin)
  narginchk(3, 4);
  nargoutchk(0, 5);

  A = varargin{1};
  B = varargin{2};
  C = varargin{3};

  if nargin == 3
    [AA, BB, CC, T, K] = ctrbf(A', C', B');
  else
    tol = varargin{4};
    [AA, BB, CC, T, K] = ctrbf(A', C', B', tol);
  end

  varargout{1} = AA';
  varargout{2} = CC';
  varargout{3} = BB';
  varargout{4} = T;
  varargout{5} = K;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = ord2(varargin)
  narginchk(2, 2);
  nargoutchk(2, 4);

  wn = varargin{1};
  z = varargin{2};
  if (nargout == 2)
    varargout{1} = 1;
    varargout{2} = [1 2 * z * wn wn * wn];
  else
    varargout{1} = [0 1; -wn * wn, -2 * z * wn];
    varargout{2} = [0; 1];
    varargout{3} = [1 0];
    varargout{4} = 0;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = padecoef(varargin)
  narginchk(1, 2)
  nargoutchk(0, 2)
  % see http://en.wikipedia.org/wiki/Pad%C3%A9_approximant

  if nargin == 1
    T = varargin{1};
    n = 1;
  else
    T = varargin{1};
    n = round(varargin{2});
  end

  mustBeNumeric(T, 1);
  mustBeNumeric(n, 2);
  mustBeScalarOrEmpty(T, 1);
  mustBeScalarOrEmpty(n, 2);
  mustBeNonempty(T, 1);
  mustBeNonempty(n, 2);
  mustBePositive(T, 1);
  mustBePositive(n, 2);

  if (T == 0)
    varargout{1} = ones(size(T), 'like', T);
    if nargout == 2
      varargout{2} = varargout{1};
    end
    return
  end

  numerator = zeros(1, n + 1);
  numerator(n + 1) = 1;
  denominator = zeros(1, n + 1);
  denominator(n + 1) = 1;

  for l = 1:n
    g = T * (n - l + 1) / (2 * n - l + 1) / l;
    idxIn = n + 2 - l;
    idxOut = n + 1 - l;
    numerator(idxOut) = (-g) * numerator(idxIn);
    denominator(idxOut) = g * denominator(idxIn);
  end

  varargout{1} = numerator / denominator(1);
  if (nargout == 2)
    varargout{2} = denominator / denominator(1);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2017 October Daniel MÃ¥rtensson (Swedish Embedded Control Systems Toolbox)
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = parallel(varargin)
  % Generates the new transfer function or new state space model of parallel connection
  % sys = parallel(sys1, sys2)
  narginchk(2, 2);
  nargoutchk(0, 1);

  sys1 = varargin{1};
  sys2 = varargin{2};
  if ~islti(sys1) || ~islti(sys2)
    error('Nelson:control_system:invalidType', '%s expected.', 'LTI model');
  end
  ltiCheckSampleTimeCompatibility(sys1, sys2);

  if isa(sys1, 'ss') || isa(sys2, 'ss')
    sys1 = ss(sys1);
    sys2 = ss(sys2);
  end

  varargout{1} = sys1 + sys2;
end
%=============================================================================
% Copyright (c) 2017 September Daniel MÃ¥rtensson (Swedish Embedded Control Systems Toolbox)
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = pole(varargin)
  % Generates poles from transfer functions or state space models
  % p = pole(sys)

  narginchk(1, 1);
  nargoutchk(0, 1);

  sys = varargin{1};
  if ~islti(sys)
    error('Nelson:control_system:invalidType', '%s expected.', 'LTI model');
  end

  if isa(sys, 'ss')
    p = eig(sys.A); % Eigenvalues
  elseif isa(sys, 'tf')
    if ~issiso(sys)
      error('Nelson:control_system:invalidType', '%s expected.', 'SISO LTI model');
    end
    denominators = sys.Denominator;
    denominator = denominators{1};
    p = roots(denominator);
  elseif isa(sys, 'zpk')
    p = pole(zpk2tf(sys));
  else
    error('Nelson:control_system:invalidType', '%s expected.', 'LTI model');
  end
  varargout{1} = p;
end
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
