delay = @(t, y) t - 0.05 + 0 * y(1);
sol = ddensd(@(t, y, z, zp) - y + z + 0 * zp, delay, delay, 1, [0 0.2], ...
  ddeset('MaxStep', 0.02));
asserts.isequal(sol.solver, 'ddensd');
asserts.istrue(abs(sol.y(1, length(sol.x)) - 1) < 1e-8);
asserts.istrue(abs(sol.yp(1, length(sol.x))) < 1e-6);
