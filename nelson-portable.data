%=============================================================================
function varargout = clf(varargin)
  narginchk(0, 1);
  nargoutchk(0, 1);
  if nargin == 1
    f = varargin{1};
  else
    f = gcf();
  end
  f.Children = [];
  f.CurrentAxes = [];
  if isprop(f, 'CurrentObject')
    f.CurrentObject = [];
  end
  refresh(f);
  if nargout == 1
    varargout{1} = f;
  else
    varargout = {};
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = clim(varargin)
  varargin = convertStringToCharArgs(varargin);
  if ((nargin > 0) && isscalar(varargin{1}) && isgraphics(varargin{1}))
    handle = varargin{1};
    varargin(1) = [];
    nargin = nargin - 1;
  else
    handle = gca();
  end
  if (nargin == 0)
    varargout{1} = handle.CLim;
    return;
  end
  if (ischar(varargin{1}))
    if (strcmp(varargin{1}, 'mode'))
      varargout{1} = handle.CLimMode;
      varargout = {};
      return;
    end
    if (strcmp(varargin{1}, 'auto'))
      handle.CLimMode = 'auto';
      varargout = {};
      return;
    end
    if (strcmp(varargin{1}, 'manual'))
      handle.CLimMode = 'manual';
      varargout = {};
      return;
    end
    error('Nelson:clim:invalidArgument', '"%s" or "%s" argument expected.', 'manual', 'auto');

  elseif (isnumeric(varargin{1}) && numel(varargin{1}) == 2)
    value = varargin{1};
    if ~isequal(handle.CLim, value)
      handle.CLim = value;
    end
  else
    error('Nelson:clim:errorSettingProperty', 'Error setting property');
  end
  varargout = {};
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = colormap(varargin)
  narginchk(0, 2);
  nargoutchk(0, 1);
  if (nargin == 0)
    m = colorMapNoRhs();
  else
    if nargin == 1
      m = colorMapOneRhs(varargin{1});
    else
      % nargin == 2
      go = varargin{1};
      map = varargin{2};
      m = colorMapTwoRhs(go, map);
    end
  end
  if nargout == 1
    varargout{1} = m;
  end
end
%=============================================================================
function m = colorMapNoRhs()
  f = gcf();
  m = f.Colormap;
end
%=============================================================================
function m = colorMapOneRhs(arg)
  if isgraphics(arg, 'axes')
    ax = arg;
    m = ax.Colormap;
    return
  elseif isgraphics(arg, 'figure')
    f = arg;
    m = f.Colormap;
    return
  else
    f = gcf();
    map = arg;
    if ischar(map) || isStringScalar(map)
      map = convertStringsToChars(map);
      if strcmp(map, 'default')
        map = 'parula';
      end
      m = eval(map);
    else
      m = map;
    end
    if isequal(f.Colormap, m)
      return
    end
    f.Colormap = m;
    refresh(f);
  end
end
%=============================================================================
function m = colorMapTwoRhs(go, map)
  if ischar(map) || isStringScalar(map)
    map = convertStringsToChars(map);
    if strcmp(map, 'default')
      map = 'parula';
    end
    m = eval(map);
  else
    m = map;
  end
  if isequal(go.Colormap, m)
    return
  end
  go.Colormap = m;
  if ~isgraphics(go, 'Figure')
    go = ancestor(go, 'Figure');
  end
  refresh(go);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = colormaplist(varargin)
  % List available colormaps
  narginchk(0, 0);
  nargoutchk(0, 1);
  orderedMaps = ["parula";
    "turbo";
    "hsv";
    "hot";
    "cool";
    "spring";
    "summer";
    "autumn";
    "winter";
    "gray";
    "bone";
    "copper";
    "pink";
    "sky";
    "abyss";
    "nebula";
    "jet";
    "lines";
    "colorcube";
    "prism";
    "flag";
    "white"];
  mapFiles = dir([modulepath('graphics', 'functions'), '/colormaps/*.m']);
  availableMaps = string(char(mapFiles.name));
  availableMaps = replace(availableMaps, ".m", "");
  availableMaps = deblank(availableMaps);
  maps = orderedMaps;
  for k = 1:numel(availableMaps)
    if ~any(availableMaps(k) == orderedMaps)
      maps = [maps; availableMaps(k)];
    end
  end
  varargout{1} = maps;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function map = abyss(varargin)
  narginchk(0, 1);
  if nargin < 1
    R = groot();
    f = R.CurrentFigure;
    if isempty(f)
      m = size(R.DefaultFigureColormap, 1);
    else
      m = size(f.Colormap, 1);
    end
  else
    m = varargin{1};
  end

  firstColor = [0.1490, 0.5490, 0.8667];
  vector = linspace(0.25, 1, m)';
  map = firstColor .* vector;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = autumn(varargin)
  narginchk(0, 1);
  nargoutchk(0, 1);
  narginchk(0, 1);
  if nargin < 1
    R = groot();
    f = R.CurrentFigure;
    if isempty(f)
      n = size(R.DefaultFigureColormap, 1);
    else
      n = size(f.Colormap, 1);
    end
  else
    n = varargin{1};
  end

  if (n == 1)
    varargout{1} = [1, 0, 0];
  else
    if (n <= 0)
      varargout{1} = zeros(0, 3);
    else
      r = (0:n - 1)' / max(n - 1, 1);
      varargout{1} = [ones(n, 1), r, zeros(n, 1)];
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function map = bone(varargin)
  narginchk(0, 1);
  if nargin < 1
    R = groot();
    f = R.CurrentFigure;
    if isempty(f)
      m = size(R.DefaultFigureColormap, 1);
    else
      m = size(f.Colormap, 1);
    end
  else
    m = varargin{1};
  end

  map = (7 * gray(m) + fliplr(hot(m))) / 8;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function map = colorcube(varargin)
  narginchk(0, 1);
  m = requestedColorCount(varargin{:});
  if m < 8
    map = gray(m);
    return
  end
  redGreenSteps = fix(m ^ (1 / 3) + eps);
  extraColors = m - redGreenSteps ^ 3;
  if extraColors == 0 && redGreenSteps > 2
    blueSteps = redGreenSteps - 1;
  else
    blueSteps = redGreenSteps;
  end
  map = colorCubeGrid(redGreenSteps, blueSteps);
  map = removeRepeatedAndDarkEdges(map);
  map = [map; primaryAndGrayRamps(m - size(map, 1) - 1)];
end
%=============================================================================
function map = colorCubeGrid(redGreenSteps, blueSteps)
  rgValues = linspace(0, 1, redGreenSteps);
  bValues = linspace(0, 1, blueSteps);
  %#ok<NLS0004>
  [red, green, blue] = meshgrid(rgValues, rgValues, bValues);
  map = [red(:), green(:), blue(:)];
end
%=============================================================================
function map = removeRepeatedAndDarkEdges(map)
  movement = sum(abs(diff(map.').'), 2);
  map = map(movement ~= 0, :);
  pairSums = [sum(map(:, [1 2]), 2), sum(map(:, [2 3]), 2), sum(map(:, [1 3]), 2)];
  map = map(min(pairSums, [], 2) ~= 0, :);
end
%=============================================================================
function map = primaryAndGrayRamps(remainingColors)
  primarySteps = floor(remainingColors / 4);
  graySteps = remainingColors - 3 * primarySteps;
  primaryRamp = linspace(1 / primarySteps, 1, primarySteps).';
  zeroRamp = zeros(primarySteps, 1);
  grayRamp = linspace(1 / graySteps, 1, graySteps).';
  map = [primaryRamp, zeroRamp, zeroRamp;
    zeroRamp, primaryRamp, zeroRamp;
    zeroRamp, zeroRamp, primaryRamp;
    0, 0, 0;
    grayRamp, grayRamp, grayRamp];
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
