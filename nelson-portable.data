% LICENCE_BLOCK_END
function status = report_writeJUnit(results, outputFile)
  if isempty(outputFile)
    error('Nelson:tests_manager:outputFilenameExpected', 'Output filename expected.');
  end
  cases = report_resultCases(results);
  fp = fopen(outputFile, 'wt');
  if fp == -1
    status = false;
    return
  end
  fprintf(fp, ['<?xml version="1.0"?>', newline()]);
  fprintf(fp, ['<testsuites tests="', int2str(length(cases)), '" failures="', ...
    int2str(report_countOutcome(cases, 'failed')), '" errors="', int2str(report_countErrors(cases)), ...
    '" skipped="', int2str(report_countSkipped(cases)), '">', newline()]);
  fprintf(fp, ['  <testsuite name="nelson.unittest" tests="', int2str(length(cases)), '">', newline()]);
  for k = 1:length(cases)
    report_writeJUnitCase(fp, cases(k));
  end
  fprintf(fp, ['  </testsuite>', newline()]);
  fprintf(fp, ['</testsuites>', newline()]);
  fclose(fp);
  status = isfile(outputFile);
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function report_writeJUnitCase(fp, testCase)
  fprintf(fp, ['    <testcase name="', report_xmlEscape(report_caseName(testCase)), ...
    '" time="', mat2str(report_caseDuration(testCase), 2), ...
    '" classname="', report_xmlEscape(report_caseClassname(testCase)), '">', newline()]);
  if strcmp(report_caseOutcome(testCase), 'failed')
    fprintf(fp, ['      <failure message="test failed"><![CDATA[', ...
      report_cdataText(report_caseMessage(testCase)), ']]></failure>', newline()]);
  elseif report_isErrorStatus(testCase)
    fprintf(fp, ['      <error message="test error"><![CDATA[', ...
      report_cdataText(report_caseMessage(testCase)), ']]></error>', newline()]);
  elseif report_isSkippedStatus(testCase)
    fprintf(fp, ['      <skipped/>', newline()]);
  end
  if ~isempty(report_caseStdout(testCase))
    fprintf(fp, ['      <system-out><![CDATA[', ...
      report_cdataText(report_caseStdout(testCase)), ']]></system-out>', newline()]);
  end
  if ~isempty(report_caseStderr(testCase))
    fprintf(fp, ['      <system-err><![CDATA[', ...
      report_cdataText(report_caseStderr(testCase)), ']]></system-err>', newline()]);
  end
  fprintf(fp, ['    </testcase>', newline()]);
end
%=============================================================================
