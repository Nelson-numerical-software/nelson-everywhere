function varargout = hsvd(varargin)
  narginchk(1, 1);
  nargoutchk(0, 1);
  sys = varargin{1};
  sys = ss(sys);
  varargout{1} = hsvd(sys);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function res = inv(sys)
  if ~issiso(sys)
    error('Nelson:control_system:invalidType', '%s expected.', 'SISO LTI model');
  end
  res = sys;
  if isstatic(sys)
    res.Numerator = 1 / sys.Numerator{1};
  else
    res.Numerator = sys.Denominator{1};
    res.Denominator = sys.Numerator{1};
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
