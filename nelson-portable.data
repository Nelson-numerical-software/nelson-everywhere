% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function data = graphicsSelectSeriesData(values, orientation, k, outputShape)
  if nargin < 4
    outputShape = 'row';
  end
  if strcmp(orientation, 'single')
    data = reshapeSeries(values, outputShape);
  elseif isscalar(values)
    data = values;
  elseif strcmp(orientation, 'points')
    data = values(k);
  elseif isvector(values)
    data = reshapeSeries(values, outputShape);
  elseif strcmp(orientation, 'columns')
    data = reshapeSeries(values(:, k), outputShape);
  elseif strcmp(outputShape, 'column')
    data = values(k, :).';
  else
    data = values(k, :);
  end
end
%=============================================================================
function data = reshapeSeries(values, outputShape)
  if strcmp(outputShape, 'column')
    data = values(:);
  else
    data = values(:).';
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function args = graphicsSelectTableSeriesArgs(tableArgs, k, nSeries)
  args = {};
  if isempty(tableArgs)
    return
  end
  if nSeries == 1
    args = tableArgs{1};
  else
    args = tableArgs{k};
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [value, name] = graphicsTableVariable(tbl, selector)
  names = tbl.Properties.VariableNames;
  if ischar(selector) || isStringScalar(selector)
    name = char(selector);
  elseif isnumeric(selector) && isscalar(selector)
    index = double(selector);
    if index < 1 || index > numel(names) || floor(index) ~= index
      error('Nelson:graphics:unrecognizedTableVariable', 'Unrecognized table variable.');
    end
    name = names{index};
  elseif islogical(selector) && isvector(selector) && sum(selector(:)) == 1
    index = find(selector(:), 1);
    name = names{index};
  else
    error('Nelson:graphics:unrecognizedTableVariable', 'Unrecognized table variable.');
  end
  if ~any(strcmp(name, names))
    error('Nelson:graphics:unrecognizedTableVariable', 'Unrecognized table variable.');
  end
  value = tbl.(name);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function names = graphicsTableVariableNames(tbl, selector)
  allNames = tbl.Properties.VariableNames;
  if ischar(selector) || isStringScalar(selector)
    names = cellstr(selector);
  elseif isstring(selector)
    names = cellstr(selector(:)');
  elseif iscellstr(selector)
    names = selector(:)';
  elseif isnumeric(selector)
    selector = double(selector(:)');
    names = cell(1, numel(selector));
    for k = 1:numel(selector)
      index = selector(k);
      if index < 1 || index > numel(allNames) || floor(index) ~= index
        error('Nelson:graphics:unrecognizedTableVariable', 'Unrecognized table variable.');
      end
      names{k} = allNames{index};
    end
  elseif islogical(selector) && isvector(selector)
    if numel(selector) ~= numel(allNames)
      error('Nelson:graphics:unrecognizedTableVariable', 'Unrecognized table variable.');
    end
    names = allNames(selector(:)');
  else
    error('Nelson:graphics:unrecognizedTableVariable', 'Unrecognized table variable.');
  end
  for k = 1:numel(names)
    if ~any(strcmp(names{k}, allNames))
      error('Nelson:graphics:unrecognizedTableVariable', 'Unrecognized table variable.');
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function ax = graphicsTargetAxes(parent)
  if isempty(parent)
    ax = newplot();
  elseif isgraphics(parent, 'hggroup')
    ax = ancestor(parent, 'axes');
  else
    ax = newplot(parent);
  end
end
