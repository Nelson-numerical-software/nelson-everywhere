den = [3 1 5];
Ts = 0.2;
sys = tf(num, den, Ts);
R = inv(sys);
den_REF = [3 4];
num_REF = [3 1 5];
Ts = 0.2;
REF = tf(num_REF, den_REF, Ts);
asserts.isequal(R, REF);
