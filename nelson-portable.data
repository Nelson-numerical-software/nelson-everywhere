function pat = possessivePattern(basePattern)
  narginchk(1, 1);
  nargoutchk(0, 1);
  pat = pattern(['(?:', pattern.regexOf(basePattern), ')++']);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
