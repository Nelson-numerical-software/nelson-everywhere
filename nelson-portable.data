  1 0 0;
  0 1 0;
  0 0 1];
D_REF = [0 0; 0 0; 0 0; 0 0];
l_REF = [22.7058; 2.1620; 2.5678];
p_REF = [22.7058 2.1620 2.5678;
  2.1620 2.6767 3.1622;
  2.5678 3.1622 25.6571];
m_REF = [];
z_REF = [];

asserts.isapprox(kEst.A, A_REF, 1e-3);
asserts.isapprox(kEst.B, B_REF, 1e-3);
asserts.isapprox(kEst.C, C_REF, 1e-4);
asserts.isapprox(kEst.D, D_REF, 1e-4);
asserts.isapprox(l, l_REF, 1e-4);
asserts.isapprox(p, p_REF, 1e-3);
asserts.isapprox(m, m_REF, 1e-4);
asserts.isapprox(z, z_REF, 1e-4);
