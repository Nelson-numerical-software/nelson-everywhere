%=============================================================================
solverOptions = {...
  nelson.ode.options.ODE23(), ...
  nelson.ode.options.ODE45(), ...
  nelson.ode.options.ODE78(), ...
  nelson.ode.options.ODE89(), ...
  nelson.ode.options.ODE113(), ...
  nelson.ode.options.ODE15s(), ...
  nelson.ode.options.ODE23s(), ...
  nelson.ode.options.ODE23t(), ...
  nelson.ode.options.ODE23tb(), ...
  nelson.ode.options.ODE15i()};
for k = 1:length(solverOptions)
  asserts.istrue(isa(solverOptions{k}, 'nelson.ode.Options'));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
options = odeset('relt', 1e-4, 'abst', 1e-8, 'maxs', 0.25);
asserts.isequal(odeget(options, 'RelTol'), 1e-4);
asserts.isequal(odeget(options, 'AbsTol'), 1e-8);
asserts.isequal(odeget(options, 'MaxStep'), 0.25);
asserts.isequal(odeget([], 'RelTol', 7), 7);

asserts.checkerror('odeset(''M'', 1)', sprintf(_('Ambiguous %s option name.'), 'ODE'));
asserts.checkerror('odeset(''NoSuchOption'', 1)', sprintf(_('Unknown %s option name.'), 'ODE'));
asserts.checkerror('ode45(@(t,y) y, [0 1], 1, odeset(''RelTol'', 0))', sprintf(_('%s must be positive.'), 'RelTol'));
asserts.checkerror('ode45(@(t,y) y, [0 1], 1, odeset(''AbsTol'', -1))', _('Positive absolute tolerance expected.'));
asserts.checkerror('ode45(@(t,y) y, [0 1], 1, odeset(''InitialStep'', 0))', sprintf(_('%s must be positive.'), 'InitialStep'));
asserts.checkerror('ode45(@(t,y) y, [0 1], 1, odeset(''MaxStep'', 0))', sprintf(_('%s must be positive.'), 'MaxStep'));
asserts.checkerror('ode45(@(t,y) y, [0 1], 1, odeset(''MinStep'', 0))', sprintf(_('%s must be positive.'), 'MinStep'));
asserts.checkerror('ode45(@(t,y) y, [0 1 0.5], 1)', _('Time span entries must strictly increase or decrease.'));
asserts.checkerror('ode45(@(t,y) y, [0 1; 2 3], 1)', _('Time span entries must strictly increase or decrease.'));
asserts.checkerror('ode45(@(t,y) y, [0 Inf], 1)', _('Time span entries must strictly increase or decrease.'));
asserts.checkerror('ode45(@(t,y) y, [0 1], [1; 2], odeset(''OutputSel'', 3))', sprintf(_('%s indices are invalid.'), 'OutputSel'));
asserts.checkerror('ode45(@(t,y) y, [0 1], [1; 2], odeset(''NonNegative'', 0))', sprintf(_('%s indices are invalid.'), 'NonNegative'));
asserts.checkerror('ode45(@(t,y) y, [0 1], 1, odeset(''Stats'', ''maybe''))', sprintf(_('%s must be ''on'' or ''off''.'), 'Stats'));
asserts.checkerror('ode15s(@(t,y) y, [0 1], 1, odeset(''BDF'', ''maybe''))', sprintf(_('%s must be ''on'' or ''off''.'), 'BDF'));
asserts.checkerror('ode15s(@(t,y) y, [0 1], 1, odeset(''JConstant'', ''maybe''))', sprintf(_('%s must be ''on'' or ''off''.'), 'JConstant'));
asserts.checkerror('ode15s(@(t,y) y, [0 1], 1, odeset(''MaxOrder'', 6))', sprintf(_('MaxOrder must be an integer scalar between %d and %d.'), 1, 5));
asserts.checkerror('ode15s(@(t,y) y, [0 1], 1, odeset(''LinearSolver'', ''bad''))', sprintf(_('%s has an invalid value.'), 'LinearSolver'));
asserts.checkerror('ode15s(@(t,y) y, [0 1], 1, odeset(''Preconditioner'', ''bad''))', sprintf(_('%s has an invalid value.'), 'Preconditioner'));
asserts.checkerror('ode15s(@(t,y) y, [0 1], 1, odeset(''MassSingular'', ''bad''))', sprintf(_('%s has an invalid value.'), 'MassSingular'));
asserts.checkerror('ode15s(@(t,y) y, [0 1], 1, odeset(''MStateDependence'', ''bad''))', sprintf(_('%s has an invalid value.'), 'MStateDependence'));
asserts.checkerror('ode45(@(t,y) y, [0 1], [1; 2], odeset(''Mass'', ones(3)))', sprintf(_('%s matrix has incompatible size.'), 'Mass'));
asserts.checkerror('ode45(@(t,y) y, [0 1], [1; 2], odeset(''Jacobian'', ones(3)))', sprintf(_('%s matrix has incompatible size.'), 'Jacobian'));
asserts.checkerror('ode15s(@(t,y) y, [0 1], [1; 2], odeset(''JPattern'', ones(3)))', sprintf(_('%s matrix has incompatible size.'), 'JPattern'));
asserts.checkerror('ode15s(@(t,y) y, [0 1], [1; 2], odeset(''JPattern'', {1}))', sprintf(_('%s must be a numeric or logical matrix.'), 'JPattern'));
asserts.checkerror('ode15s(@(t,y) y, [0 1], [1; 2], odeset(''MvPattern'', ones(3)))', sprintf(_('%s matrix has incompatible size.'), 'MvPattern'));
asserts.checkerror('ode15s(@(t,y) y, [0 1], [1; 2], odeset(''MvPattern'', {1}))', sprintf(_('%s must be a numeric or logical matrix.'), 'MvPattern'));
asserts.checkerror('odeMassMatrix({1})', sprintf(_('%s must be numeric or a function handle.'), 'Mass matrix'));
asserts.checkerror('odeMassMatrix([], ''MassSingular'', ''bad'')', sprintf(_('%s has an invalid value.'), 'MassSingular'));
asserts.checkerror('odeMassMatrix([], ''MStateDependence'', ''bad'')', sprintf(_('%s has an invalid value.'), 'MStateDependence'));
asserts.checkerror('odeMassMatrix([], ''MvPattern'', {1})', sprintf(_('%s must be numeric or logical.'), 'Mass vector pattern'));
asserts.checkerror('odeJacobian({1})', sprintf(_('%s must be numeric or a function handle.'), 'Jacobian'));
asserts.checkerror('odeJacobian([], ''Pattern'', {1})', sprintf(_('%s must be numeric or logical.'), 'Jacobian pattern'));
asserts.checkerror('odeJacobian([], ''Constant'', ''maybe'')', _('Jacobian constant flag must be ''on'' or ''off''.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--ADV-CLI MODE-->
%=============================================================================
close all
figure('Visible', 'off');
asserts.isequal(odeplot([0 1], [1; 2], 'init'), 0);
asserts.isequal(odeplot(0.5, [1.5; 2.5], ''), 0);
ax = gca();
asserts.isequal(size(ax.Children), [2 1]);
asserts.isequal(ax.Children(1).XData, [0 0.5]);
asserts.isequal(odeplot([], [], 'done'), 0);
close all
%=============================================================================
figure('Visible', 'off');
asserts.isequal(odephas2([0 1], [1; 2], 'init'), 0);
asserts.isequal(odephas2(0.5, [1.5; 2.5], ''), 0);
ax = gca();
asserts.isequal(size(ax.Children), [1 1]);
asserts.isequal(ax.Children.XData, [1 1.5]);
asserts.isequal(ax.Children.YData, [2 2.5]);
asserts.isequal(odephas2([], [], 'done'), 0);
close all
%=============================================================================
figure('Visible', 'off');
asserts.isequal(odephas3([0 1], [1; 2; 3], 'init'), 0);
asserts.isequal(odephas3(0.5, [1.5; 2.5; 3.5], ''), 0);
ax = gca();
asserts.isequal(size(ax.Children), [1 1]);
asserts.isequal(ax.Children.XData, [1 1.5]);
asserts.isequal(ax.Children.YData, [2 2.5]);
asserts.isequal(ax.Children.ZData, [3 3.5]);
asserts.isequal(odephas3([], [], 'done'), 0);
close all
%=============================================================================
asserts.checkerror('odephas2(0, 1, '''')', _('Not enough solution components.'));
asserts.checkerror('odephas3(0, [1; 2], '''')', _('Not enough solution components.'));
asserts.checkerror('odeplot(0, 1, ''bad'')', _('Unknown output callback flag.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
clear global ODE_OUTPUT_RECORDER_LOG;
global ODE_OUTPUT_RECORDER_LOG;
ODE_OUTPUT_RECORDER_LOG = {};
options = odeset('OutputFcn', @odeOutputRecorder, 'MaxStep', 0.1);
[t, y] = ode45(@(t, y) y, [0 0.5], 1, options);
asserts.istrue(length(ODE_OUTPUT_RECORDER_LOG) >= 3);
asserts.isequal(ODE_OUTPUT_RECORDER_LOG{1}.flag, 'init');
asserts.isequal(ODE_OUTPUT_RECORDER_LOG{1}.t, [0 0.5]);
asserts.isequal(ODE_OUTPUT_RECORDER_LOG{1}.y, 1);
lastIndex = length(ODE_OUTPUT_RECORDER_LOG);
asserts.isequal(ODE_OUTPUT_RECORDER_LOG{lastIndex}.flag, 'done');
asserts.istrue(isempty(ODE_OUTPUT_RECORDER_LOG{lastIndex}.t));
asserts.istrue(isempty(ODE_OUTPUT_RECORDER_LOG{lastIndex}.y));
asserts.istrue(abs(t(length(t)) - 0.5) < 1e-12);
asserts.istrue(abs(y(length(y)) - exp(0.5)) < 1e-4);

clear global ODE_OUTPUT_STOP_LOG;
global ODE_OUTPUT_STOP_LOG;
ODE_OUTPUT_STOP_LOG = {};
options = odeset('OutputFcn', @odeOutputStopAtThree, 'MaxStep', 0.1);
[t, y] = ode45(@(t, y) y, [0 1], 1, options);
asserts.istrue(t(length(t)) < 1);
asserts.istrue(t(length(t)) >= 0.3);
stopTimes = [];
for k = 1:length(ODE_OUTPUT_STOP_LOG)
  if isempty(ODE_OUTPUT_STOP_LOG{k}.flag) && ODE_OUTPUT_STOP_LOG{k}.t >= 0.3
    stopTimes(end + 1) = ODE_OUTPUT_STOP_LOG{k}.t;
  end
end
asserts.istrue(~isempty(stopTimes));
asserts.istrue(abs(t(length(t)) - stopTimes(1)) < 1e-12);
%=============================================================================
clear global ODE_OUTPUT_RECORDER_LOG;
global ODE_OUTPUT_RECORDER_LOG;
ODE_OUTPUT_RECORDER_LOG = {};
options = odeset('OutputFcn', @odeOutputRecorder, 'Refine', 4, ...
  'InitialStep', 0.25, 'MaxStep', 0.25);
[t, y] = ode45(@(t, y) 1, [0 0.5], 0, options);
outputTimes = [];
for k = 1:length(ODE_OUTPUT_RECORDER_LOG)
  if isempty(ODE_OUTPUT_RECORDER_LOG{k}.flag)
    outputTimes(end + 1) = ODE_OUTPUT_RECORDER_LOG{k}.t;
  end
end
asserts.isequal(length(outputTimes), 8);
asserts.istrue(max(abs(outputTimes - (0.0625:0.0625:0.5))) < 1e-12);
%=============================================================================
clear global ODE_OUTPUT_RECORDER_LOG;
global ODE_OUTPUT_RECORDER_LOG;
ODE_OUTPUT_RECORDER_LOG = {};
options = odeset('OutputFcn', @odeOutputRecorder, 'InitialStep', 0.25, 'MaxStep', 0.25);
[t, y] = ode45(@(t, y) 1, [0 0.2 0.5], 0, options);
outputTimes = [];
for k = 1:length(ODE_OUTPUT_RECORDER_LOG)
  if isempty(ODE_OUTPUT_RECORDER_LOG{k}.flag)
    outputTimes(end + 1) = ODE_OUTPUT_RECORDER_LOG{k}.t;
  end
end
asserts.isequal(length(outputTimes), 2);
asserts.istrue(max(abs(outputTimes - [0.2 0.5])) < 1e-12);
%=============================================================================
clear global ODE_OUTPUT_STOP_LOG;
global ODE_OUTPUT_STOP_LOG;
ODE_OUTPUT_STOP_LOG = {};
options = odeset('OutputFcn', @odeOutputStopAtThree, 'InitialStep', 0.25, 'MaxStep', 0.25);
[t, y] = ode45(@(t, y) 1, [0 0.3 0.5], 0, options);
asserts.istrue(max(abs(t - [0; 0.3])) < 1e-12);
asserts.istrue(max(abs(y - [0; 0.3])) < 1e-12);
%=============================================================================
clear global ODE_OUTPUT_SEL_LOG;
global ODE_OUTPUT_SEL_LOG;
ODE_OUTPUT_SEL_LOG = {};
options = odeset('OutputFcn', @odeOutputSelRecorder, 'OutputSel', 2, ...
  'InitialStep', 0.25, 'MaxStep', 0.25);
ode45(@(t, y)[y(1); y(2)], [0 0.5], [1; 2], options);
asserts.isequal(ODE_OUTPUT_SEL_LOG{1}.flag, 'init');
asserts.isequal(ODE_OUTPUT_SEL_LOG{1}.y, 2);
%=============================================================================
clear global ODE_OUTPUT_PARAMETER_LOG;
global ODE_OUTPUT_PARAMETER_LOG;
ODE_OUTPUT_PARAMETER_LOG = {};
parameterOptions = odeset('OutputFcn', @odeOutputParameterizedRecorder, ...
  'InitialStep', 0.25, 'MaxStep', 0.25);
parameterOptions.Parameters = {7, 11};
ode45(@(t, y, scale, offset) y, [0 0.5], 1, parameterOptions);
asserts.istrue(length(ODE_OUTPUT_PARAMETER_LOG) >= 3);
asserts.isequal(ODE_OUTPUT_PARAMETER_LOG{1}.scale, 7);
asserts.isequal(ODE_OUTPUT_PARAMETER_LOG{1}.offset, 11);
asserts.isequal(ODE_OUTPUT_PARAMETER_LOG{length(ODE_OUTPUT_PARAMETER_LOG)}.scale, 7);
asserts.isequal(ODE_OUTPUT_PARAMETER_LOG{length(ODE_OUTPUT_PARAMETER_LOG)}.offset, 11);
%=============================================================================
badStopOptions = odeset('OutputFcn', @odeOutputBadStop, ...
  'InitialStep', 0.25, 'MaxStep', 0.25);
asserts.checkerror('ode45(@(t, y) y, [0 1], 1, badStopOptions)', ...
  sprintf(_('%s stop flag must be a scalar numeric or logical value.'), 'OutputFcn'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
clear global ODE_OUTPUT_SEL_LOG;
global ODE_OUTPUT_SEL_LOG;
ODE_OUTPUT_SEL_LOG = {};
f = @(t, y)[y(1); -y(2)];
options = odeset('OutputFcn', @odeOutputSelRecorder, 'OutputSel', 2, 'MaxStep', 0.1);
[t, y] = ode45(f, [0 0.3], [1; 2], options);
asserts.istrue(size(y, 2) == 2);
asserts.istrue(length(ODE_OUTPUT_SEL_LOG) >= 3);
asserts.isequal(size(ODE_OUTPUT_SEL_LOG{1}.y), [1 1]);
for k = 2:length(ODE_OUTPUT_SEL_LOG) - 1
  asserts.isequal(size(ODE_OUTPUT_SEL_LOG{k}.y), [1 1]);
end
lastIndex = length(ODE_OUTPUT_SEL_LOG);
asserts.istrue(isempty(ODE_OUTPUT_SEL_LOG{lastIndex}.y));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
ref = odeReferenceValues();
options = odeset('RelTol', 1e-6, 'AbsTol', 1e-9, 'MaxStep', 0.05);
[t45, y45] = ode45(@(t, y) y, [0 0.25 0.5], 1, options);
asserts.istrue(max(abs(t45 - ref.ode45Time)) < 1e-12);
asserts.istrue(max(abs(y45 - ref.ode45Exp)) < 5e-5);

[t23, y23] = ode23(@(t, y)[y(2); -y(1)], [0 pi / 4], [0; 1], options);
asserts.istrue(abs(t23(1) - ref.ode23Time(1)) < 1e-12);
asserts.istrue(abs(t23(length(t23)) - ref.ode23Time(2)) < 1e-12);
asserts.istrue(max(abs(y23(1, :) - ref.ode23Oscillator(1, :))) < 2e-4);
asserts.istrue(max(abs(y23(size(y23, 1), :) - ref.ode23Oscillator(2, :))) < 2e-4);

[tr, yr] = ode45(@(t, y) y, [0.5 0.25 0], exp(0.5), options);
asserts.istrue(max(abs(tr - ref.reverseTime)) < 1e-12);
asserts.istrue(max(abs(yr - ref.reverseExp)) < 5e-6);
%=============================================================================
eventOptions = odeset('Events', @odeReferenceEventHalf, 'InitialStep', 0.05, 'MaxStep', 0.05);
[t, y, te, ye, ie] = ode23(@(t, y) 1, [0 1], 0, eventOptions);
asserts.istrue(abs(t(length(t)) - 0.5) < 1e-10);
asserts.istrue(abs(y(length(y)) - 0.5) < 1e-10);
asserts.istrue(abs(te - 0.5) < 1e-8);
asserts.istrue(abs(ye - 0.5) < 1e-8);
asserts.isequal(ie, 1);

eventOptions = odeset('Events', @odeReferenceEventTwo, 'InitialStep', 0.05, 'MaxStep', 0.05);
[~, ~, te2, ye2, ie2] = ode45(@(t, y) 1, [0 1], 0, eventOptions);
asserts.istrue(max(abs(te2 - ref.eventTwoTime)) < 1e-8);
asserts.istrue(max(abs(ye2 - ref.eventTwoSolution)) < 1e-8);
asserts.isequal(ie2, ref.eventTwoIndex);
%=============================================================================
massOptions = odeset('Mass', 2, 'RelTol', 1e-4, 'AbsTol', 1e-7, 'MaxStep', 0.05);
[tm, ym] = ode15s(@(t, y) y, [0 0.5], 1, massOptions);
odeAssertFinalValue(tm, ym, 0.5, ref.massConstant, 1e-12, 2e-3);

massOptions = odeset('Mass', @(t, y) 2, 'RelTol', 1e-6, 'AbsTol', 1e-9, 'MaxStep', 0.05);
[tf, yf] = ode45(@(t, y) y, [0 0.5], 1, massOptions);
odeAssertFinalValue(tf, yf, 0.5, ref.massFunction, 1e-12, 5e-6);
%=============================================================================
implicitOptions = odeset('RelTol', 1e-6, 'AbsTol', 1e-8, 'MaxStep', 0.05);
[ti, yi] = ode15i(@(t, y, yp) yp + y, [0 0.5], 1, -1, implicitOptions);
odeAssertFinalValue(ti, yi, 0.5, ref.implicitHalf, 1e-12, 2e-3);
%=============================================================================
problem = ode('ODEFcn', @(t, y) - y, 'InitialValue', 1);
[f, data] = solutionFcn(problem, 0, 0.5);
asserts.istrue(abs(data.Time(length(data.Time)) - 0.5) < 1e-12);
asserts.istrue(abs(data.Solution(length(data.Solution)) - ref.objectSolutionHalf) < 5e-4);
asserts.istrue(abs(f(0.25) - ref.objectInterpolationQuarter) < 5e-4);
asserts.istrue(isa(data, 'nelson.ode.ODEResults'));
%=============================================================================
sol = ode45(@(t, y) y, [0 0.5], 1);
[v, vp] = deval(sol, ref.devalTimes);
asserts.istrue(max(abs(v - ref.devalExp)) < 5e-3);
asserts.istrue(max(abs(vp - ref.devalExp)) < 5e-3);

optionAliases = odeset('relt', 1e-4, 'abst', 1e-8);
asserts.isequal(odeget(optionAliases, 'REL'), 1e-4);
asserts.isequal(odeget(optionAliases, 'AbsT'), 1e-8);

eventOptions = odeset('Events', @odeReferenceEventHalf, 'InitialStep', 0.05, 'MaxStep', 0.05);
eventSol = ode45(@(t, y) 1, [0 1], 0, eventOptions);
extendedEventSol = odextend(eventSol, [], 1, odeset('MaxStep', 0.05));
asserts.istrue(abs(extendedEventSol.x(length(extendedEventSol.x)) - 1) < 1e-12);
asserts.istrue(abs(extendedEventSol.y(length(extendedEventSol.y)) - 1) < 1e-8);
asserts.istrue(abs(extendedEventSol.xe(1) - 0.5) < 1e-8);
asserts.istrue(abs(extendedEventSol.ye(1) - 0.5) < 1e-8);
asserts.isequal(extendedEventSol.ie(1), 1);
%=============================================================================
highOrderOptions = odeset('RelTol', 1e-6, 'AbsTol', 1e-9, 'MaxStep', 0.1);
requestedTimes = ref.highOrderTimes;
[t113, y113] = ode113(@(t, y) y, requestedTimes, 1, highOrderOptions);
[t78, y78] = ode78(@(t, y) y, requestedTimes, 1, highOrderOptions);
[t89, y89] = ode89(@(t, y) y, requestedTimes, 1, highOrderOptions);
sol113 = ode113(@(t, y) y, requestedTimes, 1, highOrderOptions);
sol78 = ode78(@(t, y) y, requestedTimes, 1, highOrderOptions);
sol89 = ode89(@(t, y) y, requestedTimes, 1, highOrderOptions);
asserts.istrue(max(abs(t113 - requestedTimes(:))) < 1e-12);
asserts.istrue(max(abs(t78 - requestedTimes(:))) < 1e-12);
asserts.istrue(max(abs(t89 - requestedTimes(:))) < 1e-12);
asserts.istrue(max(abs(y113 - ref.highOrderExp)) < 5e-5);
asserts.istrue(max(abs(y78 - ref.highOrderExp)) < 5e-5);
asserts.istrue(max(abs(y89 - ref.highOrderExp)) < 5e-5);
asserts.istrue(length(sol113.x) > length(requestedTimes));
asserts.istrue(length(sol78.x) > length(requestedTimes));
asserts.istrue(length(sol89.x) > length(requestedTimes));
asserts.istrue(abs(deval(sol78, requestedTimes(2)) - ref.highOrderExp(2)) < 5e-5);

massTimeOptions = odeset(highOrderOptions, 'Mass', @(t, y) 1 + t);
[tmt, ymt] = ode45(@(t, y) y, ref.massTime(:).', 1, massTimeOptions);
asserts.istrue(max(abs(tmt - ref.massTime)) < 1e-12);
asserts.istrue(max(abs(ymt - ref.massTimeSolution)) < 5e-5);

reverseEventOptions = odeset('Events', @odeReferenceEventReverseHalf, ...
  'InitialStep', 0.05, 'MaxStep', 0.05);
[trev, yrev, terev, yerev, ierev] = ode45(@(t, y) 1, [1 0], 1, reverseEventOptions);
asserts.istrue(abs(trev(length(trev)) - 0.5) < 1e-8);
asserts.istrue(abs(yrev(length(yrev)) - 0.5) < 1e-8);
asserts.istrue(abs(terev - 0.5) < 1e-8);
asserts.istrue(abs(yerev - 0.5) < 1e-8);
asserts.isequal(ierev, 1);

implicitParameterOptions = odeset('RelTol', 1e-6, 'AbsTol', 1e-8, ...
  'MaxStep', 0.05);
implicitParameterOptions.Parameters = 2;
[tip, yip] = ode15i(@(t, y, yp, rate) yp + rate * y, [0 0.5], 1, -2, implicitParameterOptions);
odeAssertFinalValue(tip, yip, 0.5, exp(-1), 1e-12, 2e-3);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
options = odeset('Refine', 4, 'InitialStep', 0.5, 'MaxStep', 0.5);
[t, y] = ode45(@(t, y) y, [0 1], 1, options);
asserts.isequal(length(t), 9);
asserts.isequal(t.', 0:0.125:1);
asserts.istrue(abs(y(length(y)) - exp(1)) < 1e-5);
%=============================================================================
sol = ode45(@(t, y) y, [0 1], 1, options);
asserts.isequal(length(sol.x), 3);
asserts.isfalse(isfield(sol.extdata, 'internal'));
asserts.istrue(abs(deval(sol, 0.5) - exp(0.5)) < 1e-5);
%=============================================================================
options = odeset('Refine', 1, 'InitialStep', 0.5, 'MaxStep', 0.5);
[t, y] = ode45(@(t, y) y, [0 1], 1, options);
asserts.isequal(length(t), 3);
asserts.isequal(t.', [0 0.5 1]);
%=============================================================================
baseOptions = odeset('InitialStep', 0.5, 'MaxStep', 0.5);
asserts.isequal(length(ode45(@(t, y) y, [0 1], 1, baseOptions).x), 3);
asserts.isequal(length(ode78(@(t, y) y, [0 1], 1, baseOptions).x), 3);
asserts.isequal(length(ode89(@(t, y) y, [0 1], 1, baseOptions).x), 3);
%=============================================================================
options = odeset('Stats', 'on', 'InitialStep', 0.5, 'MaxStep', 0.5);
txt = evalc('[t, y] = ode45(@(t, y) y, [0 1], 1, options);');
asserts.istrue(contains(txt, 'successful steps'));
asserts.istrue(contains(txt, 'failed attempts'));
asserts.istrue(contains(txt, 'function evaluations'));
%=============================================================================
asserts.checkerror('ode45(@(t, y) y, [0 1], 1, odeset(''Refine'', 1.5))', _('Refine must be an integer scalar.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
requested = 0:0.05:0.5;
options = odeset('InitialStep', 0.002, 'MaxStep', 0.002, 'RelTol', 1e-5, 'AbsTol', 1e-7);
rhs = @(t, y)[1i * 30 * y(1); -0.5 * y(2)];
y0 = [1; 2i];
%=============================================================================
sol = ode45(rhs, requested, y0, options);
asserts.istrue(length(sol.x) > length(requested));
%=============================================================================
[t, y] = ode45(rhs, requested, y0, options);
asserts.isequal(t(:).', requested);
reference = deval(sol, requested);
err = abs(y.' - reference);
asserts.istrue(max(err(:)) < 1e-8);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
[t, y] = ode45(@(t, y) y, [0 0.25 0.5 1], 1);
asserts.isequal(size(t), [4 1]);
asserts.isequal(size(y), [4 1]);
asserts.istrue(max(abs(t - [0; 0.25; 0.5; 1])) < 1e-15);
asserts.istrue(max(abs(y - exp(t))) < 5e-4);
%=============================================================================
requested = linspace(0, 1, 101);
[tdense, ydense] = ode45(@(t, y)[y(2); -y(1)], requested, [0; 1]);
asserts.isequal(size(tdense), [101 1]);
asserts.isequal(size(ydense), [101 2]);
asserts.istrue(max(abs(tdense - requested(:))) < 1e-14);
asserts.istrue(max(abs(ydense(:, 1) - sin(tdense))) < 5e-4);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
[t, y] = ode45(@(t, y) y, [1 0.5 0], exp(1));
asserts.isequal(t, [1; 0.5; 0]);
asserts.istrue(max(abs(y - exp(t))) < 5e-4);

options = odeset('Mass', 2, 'MaxStep', 0.05);
[tm, ym] = ode45(@(t, y) y, [0 1], 1, options);
asserts.istrue(abs(ym(length(ym)) - exp(0.5)) < 5e-4);

options = odeset('Mass', @(t, y) 2, 'MaxStep', 0.05);
[tf, yf] = ode45(@(t, y) y, [0 1], 1, options);
asserts.istrue(abs(yf(length(yf)) - exp(0.5)) < 5e-4);

sol = ode45(@(t, y) y, [0 0.5], 1);
sol2 = odextend(sol, [], 1);
asserts.istrue(abs(sol2.x(length(sol2.x)) - 1) < 1e-12);
asserts.istrue(abs(sol2.y(length(sol2.y)) - exp(1)) < 5e-4);
asserts.istrue(sol2.stats.tfinal == 1);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
sol = ode45(@(t, y) y, [0 1], 1);
names = fieldnames(sol);
asserts.isequal(names{1}, 'solver');
asserts.isequal(names{2}, 'extdata');
asserts.isequal(names{3}, 'x');
asserts.isequal(names{4}, 'y');
asserts.isequal(names{5}, 'stats');
asserts.isequal(names{6}, 'idata');
asserts.isfalse(isfield(sol, 'xe'));
asserts.isfalse(isfield(sol, 'ye'));
asserts.isfalse(isfield(sol, 'ie'));

statsNames = fieldnames(sol.stats);
asserts.isequal(statsNames{1}, 'nsteps');
asserts.isequal(statsNames{2}, 'nfailed');
asserts.isequal(statsNames{3}, 'nfevals');
asserts.isequal(statsNames{4}, 'tfinal');
asserts.istrue(abs(sol.stats.tfinal - 1) < 1e-12);

value = deval(sol, 0.5);
asserts.istrue(abs(value - exp(0.5)) < 1e-4);
[values, slopes] = deval(sol, [0; 0.5; 1]);
asserts.isequal(size(values), [1 3]);
asserts.isequal(size(slopes), [1 3]);
asserts.istrue(max(abs(values - [1 exp(0.5) exp(1)])) < 5e-3);

systemSol = ode45(@(t, y)[y(2); -y(1)], [0 1], [0; 1]);
[systemValues, systemSlopes] = deval(systemSol, [0; 0.5; 1]);
asserts.isequal(size(systemValues), [2 3]);
asserts.isequal(size(systemSlopes), [2 3]);
reverseSol = ode45(@(t, y) y, [1 0], exp(1));

extended = odextend(sol, [], 2);
asserts.isfalse(isfield(extended, 'xe'));
asserts.isfalse(isfield(extended, 'ye'));
asserts.isfalse(isfield(extended, 'ie'));
asserts.istrue(abs(extended.x(length(extended.x)) - 2) < 1e-12);
sameInterval = odextend(sol, [], 0.5);
asserts.isfalse(isfield(sameInterval, 'xe'));
asserts.isfalse(isfield(sameInterval, 'ye'));
asserts.isfalse(isfield(sameInterval, 'ie'));
asserts.istrue(abs(sameInterval.x(length(sameInterval.x)) - 1) < 1e-12);
asserts.checkerror('odextend(sol, [], -1)', _('ODE solution cannot be extended in the requested direction.'));

reverseExtended = odextend(reverseSol, [], -1);
asserts.istrue(abs(reverseExtended.x(length(reverseExtended.x)) + 1) < 1e-12);
asserts.checkerror('odextend(reverseSol, [], 2)', _('ODE solution cannot be extended in the requested direction.'));

asserts.checkerror('deval(sol, -0.1)', _('Evaluation points must lie inside the solution interval.'));
asserts.checkerror('deval(sol, 1.1)', _('Evaluation points must lie inside the solution interval.'));
asserts.checkerror('deval(reverseSol, 1.1)', _('Evaluation points must lie inside the solution interval.'));
asserts.checkerror('deval(reverseSol, -0.1)', _('Evaluation points must lie inside the solution interval.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
solvers = {@ode113, @ode78, @ode89, @ode15s, @ode23s, @ode23t, @ode23tb};
options = odeset('RelTol', 1e-3, 'AbsTol', 1e-6, ...
  'InitialStep', 0.05, 'MaxStep', 0.1, 'Jacobian', -1);

for k = 1:length(solvers)
  solver = solvers{k};
  sol = solver(@(t, y) - y, [0.2 0.1 0], exp(-0.2), options);
  asserts.isequal(size(sol.x, 1), 1);
  asserts.isequal(size(sol.y, 1), 1);
  asserts.istrue(abs(sol.x(1) - 0.2) < 1e-12);
  asserts.istrue(abs(sol.x(length(sol.x))) < 1e-12);
  asserts.istrue(max(abs(sol.y(:) - exp(-sol.x(:)))) < 2e-2);
  ymiddle = deval(sol, 0.05);
  asserts.istrue(abs(ymiddle - exp(-0.05)) < 2e-2);
  asserts.isequal(sol.solver, func2str(solver));
end

implicitOptions = odeset('RelTol', 1e-4, 'AbsTol', 1e-7, ...
  'InitialStep', 0.05, 'MaxStep', 0.1);
[ti, yi] = ode15i(@(t, y, yp) yp + y, [0.2 0.1 0], exp(-0.2), -exp(-0.2), implicitOptions);
asserts.isequal(ti, [0.2; 0.1; 0]);
asserts.istrue(max(abs(yi - exp(-ti))) < 5e-3);
implicitSol = ode15i(@(t, y, yp) yp + y, [0 0.2], 1, -1, implicitOptions);
asserts.istrue(abs(deval(implicitSol, 0.1) - exp(-0.1)) < 5e-3);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
odeCheckSolverForTest(@ode23);
odeCheckSolverForTest(@ode45);
odeCheckSolverForTest(@ode78);
odeCheckSolverForTest(@ode89);
odeCheckSolverForTest(@ode113);
odeCheckSolverForTest(@ode15s);
odeCheckSolverForTest(@ode23s);
odeCheckSolverForTest(@ode23t);
odeCheckSolverForTest(@ode23tb);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
f = @(t, y) - 300 * (y - cos(t)) - sin(t);
options = odeset('Jacobian', -300, 'RelTol', 1e-4, 'AbsTol', 1e-7, ...
  'InitialStep', 1e-4, 'MaxStep', 0.005);
solvers = {@ode15s, @ode23s, @ode23t, @ode23tb};
solutions = cell(size(solvers));
for k = 1:length(solvers)
  solver = solvers{k};
  sol = solver(f, [0 0.01 0.02], 1, options);
  solutions{k} = sol;
  err = max(abs(sol.y(:) - cos(sol.x(:))));
  asserts.istrue(err < 2e-3);
  if strcmp(sol.solver, 'ode15s')
    asserts.istrue(sol.stats.nfevals >= sol.stats.nsteps);
  elseif strcmp(sol.solver, 'ode23s')
    % Modified Rosenbrock (2,3): three stage evaluations plus one
    % finite-difference time derivative per step.
    asserts.istrue(sol.stats.nfevals >= 4 * sol.stats.nsteps);
    asserts.istrue(err < 1e-5);
  elseif strcmp(sol.solver, 'ode23t')
    asserts.istrue(err < 1e-8);
  elseif strcmp(sol.solver, 'ode23tb')
    asserts.istrue(sol.stats.nfevals >= 3 * sol.stats.nsteps);
    asserts.istrue(err < 1e-8);
  else
    asserts.istrue(sol.stats.nfevals >= 2 * sol.stats.nsteps);
  end
end
sol15s = solutions{1};
sol23s = solutions{2};
sol23t = solutions{3};
sol23tb = solutions{4};
last15s = sol15s.y(1, size(sol15s.y, 2));
last23s = sol23s.y(1, size(sol23s.y, 2));
last23t = sol23t.y(1, size(sol23t.y, 2));
last23tb = sol23tb.y(1, size(sol23tb.y, 2));
asserts.istrue(abs(last15s - last23s) > eps);
asserts.istrue(abs(last23t - last23s) > eps);
asserts.istrue(abs(last23tb - last23s) > eps);
%=============================================================================
linearOptions = odeset('Jacobian', -1, 'RelTol', 1e-4, 'AbsTol', 1e-7, ...
  'InitialStep', 1e-3, 'MaxStep', 0.02);
linear23s = ode23s(@(t, y) 1, [0 0.5], 0, linearOptions);
linear23t = ode23t(@(t, y) 1, [0 0.5], 0, linearOptions);
linear23tb = ode23tb(@(t, y) 1, [0 0.5], 0, linearOptions);
asserts.istrue(abs(linear23s.y(length(linear23s.y)) - 0.5) < 5e-5);
asserts.istrue(abs(linear23t.y(length(linear23t.y)) - 0.5) < 5e-5);
asserts.istrue(abs(linear23tb.y(length(linear23tb.y)) - 0.5) < 5e-4);
%=============================================================================
clear global ODE_COUNTED_JACOBIAN_CALLS;
global ODE_COUNTED_JACOBIAN_CALLS;
ODE_COUNTED_JACOBIAN_CALLS = 0;
options = odeset('Jacobian', @odeCountedJacobian, 'JConstant', 'off', ...
  'RelTol', 1e-3, 'AbsTol', 1e-6, 'InitialStep', 1e-4, 'MaxStep', 1e-4);
ode15s(@(t, y) - 100 * y, [0 1e-4], 1, options);
callsWithoutConstant = ODE_COUNTED_JACOBIAN_CALLS;
ODE_COUNTED_JACOBIAN_CALLS = 0;
options = odeset(options, 'JConstant', 'on');
ode15s(@(t, y) - 100 * y, [0 1e-4], 1, options);
callsWithConstant = ODE_COUNTED_JACOBIAN_CALLS;
asserts.istrue(callsWithConstant < callsWithoutConstant);
%=============================================================================
parameterOptions = odeset('Mass', @(t, y, rate, massScale) massScale, ...
  'Jacobian', @(t, y, rate, massScale) - rate, ...
  'RelTol', 1e-5, 'AbsTol', 1e-8, 'InitialStep', 1e-4, 'MaxStep', 0.002);
parameterOptions.Parameters = {100, 2};
parameterSol = ode15s(@(t, y, rate, massScale) - rate * y, [0 0.01], 1, parameterOptions);
asserts.istrue(abs(parameterSol.y(1, size(parameterSol.y, 2)) - exp(-0.5)) < 5e-3);
%=============================================================================
orderOptions = odeset('Jacobian', -20, 'RelTol', 1e-4, 'AbsTol', 1e-7, ...
  'InitialStep', 1e-3, 'MaxStep', 0.01);
defaultOrderSol = ode15s(@(t, y) - 20 * y, [0 0.1], 1, orderOptions);
firstOrderSol = ode15s(@(t, y) - 20 * y, [0 0.1], 1, odeset(orderOptions, 'MaxOrder', 1));
defaultOrderEnd = defaultOrderSol.y(1, size(defaultOrderSol.y, 2));
firstOrderEnd = firstOrderSol.y(1, size(firstOrderSol.y, 2));
asserts.istrue(abs(defaultOrderEnd - exp(-2)) < 5e-3);
asserts.istrue(abs(firstOrderEnd - exp(-2)) < 5e-3);
asserts.istrue(abs(defaultOrderEnd - firstOrderEnd) > eps);
