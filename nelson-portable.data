% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function R = mtimes(A, B)
  % Element-wise operation on a table or timetable combined with a scalar.
  checkTabularScalarOperand(A, B, 'mtimes');
  R = times(A, B);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function checkTabularScalarOperand(A, B, functionName)
  if istabular(A)
    other = B;
  else
    other = A;
  end
  if istabular(other) || ~isscalar(other)
    error(['Nelson:table:', functionName, ':nonScalarOperand'], _('When one input is a table or timetable, the other input must be a scalar.'));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function tf = sameVariableProperties(obj, a, b)
  % True when the Properties structs a and b hold the same per-variable
  % metadata.
  names = {'VariableNames', 'VariableUnits', 'VariableDescriptions', 'VariableContinuity', 'CustomProperties'};
  tf = isstruct(b) && isstruct(a);
  for k = 1:length(names)
    if ~tf
      return
    end
    tf = isfield(a, names{k}) && isfield(b, names{k}) && isequal(a.(names{k}), b.(names{k}));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
classdef (Abstract) tabular
  methods
    function obj = tabular(varargin)
      if nargin ~= 0
        error('Nelson:table:invalidTabularConstruction', 'Invalid tabular construction.');
      end
    end
  end

  methods (Access = protected)
    value = checkPropertiesAssignment(obj, current, value)
    [data, names] = applyVariableProperties(obj, data, oldNames, props)
    validateNames(obj, names, message)
    tf = sameVariableProperties(obj, a, b)
    names = toCellstrRow(obj, names)
    names = checkedVariableNames(obj, names)
    names = checkedRowNames(obj, names)
    names = checkedDimensionNames(obj, names)
    checkDimensionVariableNames(obj, props)
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function names = toCellstrRow(obj, names)
  if isempty(names)
    names = {};
  elseif isstring(names)
    names = cellstr(names);
  elseif ischar(names)
    names = {names};
  end
  names = names(:)';
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function validateNames(obj, names, message)
  if isempty(names)
    return
  end
  if ~iscellstr(names)
    error('Nelson:table:invalidVariableNames', message);
  end
  for k = 1:length(names)
    if isempty(names{k})
      error('Nelson:table:invalidVariableNames', message);
    end
  end
  if length(unique(names)) ~= length(names)
    error('Nelson:table:duplicateVariableNames', message);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
classdef timerange
  properties (Hidden)
    StartValue = -Inf
    EndValue = Inf
    IncludeStart = true
    IncludeEnd = false
    TimeKind = ''
  end

  methods
    function obj = timerange(varargin)
      narginchk(2, 3);
      intervalType = 'openright';
      if nargin == 2 && timerange.isUnit(varargin{2})
        [obj.StartValue, obj.EndValue, obj.TimeKind] = timerange.periodBounds(varargin{1}, varargin{2});
        return
      end
      if nargin == 3 && timerange.isUnit(varargin{3})
        [obj.StartValue, obj.EndValue, obj.TimeKind] = timerange.periodBounds(varargin{1}, varargin{3}, varargin{2});
        return
      end
      if nargin == 3
        intervalType = char(varargin{3});
      end
      [obj.StartValue, kindStart] = timerange.timeValue(varargin{1});
      [obj.EndValue, kindEnd] = timerange.timeValue(varargin{2});
      obj.TimeKind = timerange.mergeKind(kindStart, kindEnd);
      [obj.IncludeStart, obj.IncludeEnd] = timerange.intervalFlags(intervalType);
    end

    function disp(obj)
      if obj.IncludeStart && obj.IncludeEnd
        kind = 'closed interval';
      elseif obj.IncludeStart
        kind = 'half-open interval';
      elseif obj.IncludeEnd
        kind = 'open-left interval';
      else
        kind = 'open interval';
      end
      builtin('disp', '	timetable timerange subscript:');
      builtin('disp', ' ');
      builtin('disp', ['		Select timetable rows with times in the ', kind, '.']);
    end
  end

  methods (Static, Hidden)
    function mask = contains(obj, times)
      if isa(times, 'datetime')
        values = datenum(times);
      elseif isa(times, 'duration')
        values = double(times);
      else
        error('Nelson:timetable:invalidRowTimes', 'Timetable row times must be datetime or duration values.');
      end
      if obj.IncludeStart
        left = values >= obj.StartValue;
      else
        left = values > obj.StartValue;
      end
      if obj.IncludeEnd
        right = values <= obj.EndValue;
      else
        right = values < obj.EndValue;
      end
      mask = left & right;
    end

    function tf = isUnit(value)
      if ~(ischar(value) || (isstring(value) && isscalar(value)))
        tf = false;
        return
      end
      tf = any(strcmp(timerange.unitName(value), ...
        {'year', 'quarter', 'month', 'week', 'day', 'hour', 'minute', 'second'}));
    end

    function [startValue, endValue, kind] = periodBounds(first, unit, second)
      if nargin < 3
        second = first;
      end
      t1 = timerange.toDatetime(first);
      t2 = timerange.toDatetime(second);
      unit = timerange.unitName(unit);
      startTime = dateshift(t1, 'start', unit);
      endTime = timerange.addOneUnit(dateshift(t2, 'start', unit), unit);
      startValue = datenum(startTime);
      endValue = datenum(endTime);
      kind = 'datetime';
    end

    function [value, kind] = timeValue(input)
      if timerange.isInfText(input)
        value = timerange.infTextValue(input);
        kind = '';
      elseif isa(input, 'datetime')
        value = datenum(input);
        kind = 'datetime';
      elseif isa(input, 'duration')
        value = double(input);
        kind = 'duration';
      elseif ischar(input) || (isstring(input) && isscalar(input))
        value = datenum(datetime(input));
        kind = 'datetime';
      else
        error('Nelson:timerange:invalidValue:timeRangeLimitsDatetimeDurationText', 'Time range limits must be datetime, duration, or text scalars.');
      end
      if ~isscalar(value)
        error('Nelson:timerange:invalidValue:timeRangeLimitsScalar', 'Time range limits must be scalar.');
      end
    end

    function out = toDatetime(value)
      if timerange.isInfText(value)
        error('Nelson:timerange:invalidValue:periodTimeRangesRequireFiniteDatetime', 'Period time ranges require finite datetime values.');
      elseif isa(value, 'datetime')
        out = value;
      else
        out = datetime(value);
      end
      if ~isscalar(out)
        error('Nelson:timerange:invalidValue', 'Time period must be scalar.');
      end
    end

    function unit = unitName(unit)
      unit = lower(char(unit));
      if endsWith(unit, 's')
        unit = unit(1:end - 1);
      end
    end

    function out = addOneUnit(t, unit)
      switch unit
        case 'year'
          out = t + calyears(1);
        case 'quarter'
          out = t + calquarters(1);
        case 'month'
          out = t + calmonths(1);
        case 'week'
          out = t + calweeks(1);
        case 'day'
          out = t + days(1);
        case 'hour'
          out = t + hours(1);
        case 'minute'
          out = t + minutes(1);
        case 'second'
          out = t + seconds(1);
      end
    end

    function kind = mergeKind(a, b)
      if isempty(a)
        kind = b;
      elseif isempty(b) || strcmp(a, b)
        kind = a;
      else
        error('Nelson:timerange:invalidValue:timeRangeLimitsUseTimeType', 'Time range limits must use the same time type.');
      end
    end

    function [includeStart, includeEnd] = intervalFlags(intervalType)
      switch lower(char(intervalType))
        case {'openright', 'closedleft'}
          includeStart = true;
          includeEnd = false;
        case {'openleft', 'closedright'}
          includeStart = false;
          includeEnd = true;
        case 'open'
          includeStart = false;
          includeEnd = false;
        case 'closed'
          includeStart = true;
          includeEnd = true;
        otherwise
          error('Nelson:timerange:invalidType', 'Invalid interval type.');
      end
    end

    function tf = isInfText(value)
      tf = (ischar(value) || (isstring(value) && isscalar(value))) ...
        && any(strcmpi(strtrim(char(value)), {'inf', '+inf', '-inf'}));
    end

    function value = infTextValue(input)
      text = lower(strtrim(char(input)));
      if strcmp(text, '-inf')
        value = -Inf;
      else
        value = Inf;
      end
    end
  end
end
