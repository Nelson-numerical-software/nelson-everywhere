C = [1 0 0];
sys = ss(A, [B, B], C, 0);
Q = 1;
R = 1;
[kEst, l, p, m, z] = kalman(sys, Q, R, []);

A_REF = [-11.44 -0.494 1.129;
  -1.162 0 0;
  -2.568 1 0];
B_REF = [-0.3832 22.71;
  0.5919 2.162;
  0.5191 2.568];
