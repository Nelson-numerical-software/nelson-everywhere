% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function column = timetableMissingRows(sample, nRows)
  % nRows rows of missing values of the class of sample, as wide as sample:
  % NaN, NaT, <missing>, <undefined>, an empty character vector in a cell,
  % and 0 or false for the types without missing value.
  sz = size(sample);
  sz(1) = nRows;
  if isfloat(sample)
    column = NaN(sz, class(sample));
  elseif isinteger(sample)
    column = zeros(sz, class(sample));
  elseif islogical(sample)
    column = false(sz);
  elseif iscell(sample)
    column = repmat({''}, sz);
  elseif isa(sample, 'duration')
    column = seconds(NaN(sz));
    column.Format = sample.Format;
  else
    column = sample([], :);
    column(1:nRows, :) = missing;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function rowTimes = timetableRegularRowTimes(nRows, opts)
  % Row times of a regular timetable: nRows times from StartTime (0 sec by
  % default) spaced by TimeStep or 1/SampleRate.
  if ~isempty(opts.SampleRate) && ~isempty(opts.TimeStep)
    error('Nelson:timetable:invalidSyntax:specifySampleRateTimeStepNotBoth', 'Specify SampleRate or TimeStep, not both.');
  end
  if isempty(opts.StartTime)
    startTime = seconds(0);
  else
    startTime = opts.StartTime;
  end
  if ~isempty(opts.SampleRate)
    if ~isnumeric(opts.SampleRate) || ~isscalar(opts.SampleRate) || opts.SampleRate <= 0
      error('Nelson:timetable:invalidValue:sampleRateAPositiveNumericScalar', 'SampleRate must be a positive numeric scalar.');
    end
    step = seconds(1 / double(opts.SampleRate));
  else
    step = opts.TimeStep;
    if ~isa(step, 'duration') || ~isscalar(step)
      error('Nelson:timetable:timeStepNotDuration', 'TimeStep must be a duration scalar.');
    end
  end
  values = 0:(nRows - 1);
  rowTimes = startTime + values(:) .* step;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [rows, newTimes] = timetableResolveRows(rowTimes, sub, allowNew)
  % Row numbers selected by ':', a logical mask, numbers, a timerange, a
  % withtol or row times (text is converted to the row time type). A time
  % selects all the rows at that time, none when it is not a row time; with
  % allowNew (an assignment) it selects the first of them, or a new row
  % after the last one, and newTimes lists these new times in the order of
  % their rows.
  newTimes = rowTimes([]);
  if ischar(sub) && strcmp(sub, ':')
    rows = 1:timetableTimeCount(rowTimes);
    return
  end
  if ischar(sub) || isstring(sub) || iscellstr(sub)
    sub = textTimes(rowTimes, sub);
  end
  if islogical(sub)
    rows = find(sub);
    rows = rows(:)';
  elseif isnumeric(sub)
    rows = sub(:)';
  elseif isa(sub, 'timerange')
    rows = find(timerange.contains(sub, rowTimes));
    rows = rows(:)';
  elseif isa(sub, 'withtol')
    rows = withtol.rows(sub, rowTimes);
  elseif (isa(sub, 'datetime') || isa(sub, 'duration')) && ~strcmp(class(sub), class(rowTimes))
    kind = class(rowTimes);
    error(['Nelson:timetable:InvalidRowSubscripts', upper(kind(1)), kind(2:end)], ...
      _('Timetable row subscript must be a numeric, logical, or %s array, or a timerange subscripter.'), kind);
  elseif (isa(sub, 'datetime') || isa(sub, 'duration')) && nargin > 2 && allowNew
    [rows, newTimes] = assignedTimeRows(rowTimes, sub);
  elseif isa(sub, 'datetime') || isa(sub, 'duration')
    rows = withtol.rows(withtol(sub, seconds(0)), rowTimes);
  else
    error('Nelson:timetable:invalidSubscriptType', 'Invalid %s subscript type.', 'row');
  end
end
%=============================================================================
function times = textTimes(rowTimes, text)
  if isa(rowTimes, 'datetime')
    times = datetime(text);
  else
    times = duration(text);
  end
end
%=============================================================================
function n = timetableTimeCount(value)
  if isa(value, 'datetime')
    n = numel(datenum(value));
  else
    n = numel(seconds(value));
  end
end
%=============================================================================
function [rows, newTimes] = assignedTimeRows(rowTimes, sub)
  newTimes = rowTimes([]);
  nRows = timetableTimeCount(rowTimes);
  rows = zeros(1, timetableTimeCount(sub));
  for k = 1:length(rows)
    idx = withtol.rows(withtol(sub(k), seconds(0)), rowTimes);
    if isempty(idx)
      idx = withtol.rows(withtol(sub(k), seconds(0)), newTimes);
      if isempty(idx)
        newTimes(end + 1, 1) = sub(k);
        idx = timetableTimeCount(newTimes);
      end
      idx = nRows + idx;
    end
    rows(k) = idx(1);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
