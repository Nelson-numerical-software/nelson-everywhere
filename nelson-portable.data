function varargout = meshc(varargin)
  narginchk(1, 1000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [ax, args] = parseSurfaceParent(args);
  validateMeshcZArgument(args);
  saveHold = ishold(ax);
  firstProperty = find(cellfun('isclass', args, 'char'), 1);
  if isempty(firstProperty)
    firstProperty = length(args) + 1;
  end
  defaultProperties = {'FaceColor', 'w', 'EdgeColor', 'flat', ...
    'FaceLighting', 'none', 'EdgeLighting', 'flat'};
  % The defaults come before the caller properties so that a property set by
  % the caller wins over the meshc default.
  surfaceArgs = [args(1:firstProperty - 1), defaultProperties, args(firstProperty:end)];
  s = surface(ax, surfaceArgs{:});
  hold(ax, 'on');
  [~, c] = contour(ax, s.XData, s.YData, s.ZData, 'ZLocation', 'zmin');
  applyMeshXYTicks(ax, s.XData, s.YData);
  applyMeshZLimits(ax, s.ZData);
  if ~saveHold
    hold(ax, 'off');
  end
  view(ax, 3);
  grid(ax, 'on');
  if nargout == 1
    varargout{1} = [s; c];
  end
end
%=============================================================================
function [ax, args] = parseSurfaceParent(args)
  if ~isempty(args) && isscalar(args{1}) && isgraphics(args{1}, 'axes')
    ax = newplot(args{1});
    args = args(2:end);
  else
    [parent, args] = extractParentProperty(args);
    if isempty(parent)
      ax = newplot();
    else
      ax = newplot(parent);
    end
  end
end
%=============================================================================
function [parent, args] = extractParentProperty(args)
  parent = [];
  k = 1;
  while k < numel(args)
    name = args{k};
    if (ischar(name) || isStringScalar(name)) && strcmpi(convertStringsToChars(name), 'Parent')
      value = args{k + 1};
      if ~isscalar(value) || ~isgraphics(value, 'axes')
        error('Nelson:graphics:invalidAxesParent', 'Parent must be an axes handle.');
      end
      parent = value;
      args(k:k + 1) = [];
      return
    end
    k = k + 1;
  end
end
%=============================================================================
function validateMeshcZArgument(args)
  if isempty(args)
    return
  end
  if numel(args) >= 3 && isnumeric(args{1}) && isnumeric(args{2}) && isnumeric(args{3})
    z = args{3};
  else
    z = args{1};
  end
  if isnumeric(z) && min(size(z)) == 1
    error('Nelson:meshc:invalidSurfaceZ', 'The surface Z must contain more than one row or column.');
  end
end
%=============================================================================
function applyMeshXYTicks(ax, xData, yData)
  xTicks = meshcLinearTicks(xData);
  if ~isempty(xTicks)
    ax.XTick = xTicks;
  end
  yTicks = meshcLinearTicks(yData);
  if ~isempty(yTicks)
    ax.YTick = yTicks;
  end
end
%=============================================================================
function ticks = meshcLinearTicks(data)
  values = data(isfinite(data));
  if isempty(values)
    ticks = [];
    return
  end
  limits = [min(values(:)) max(values(:))];
  span = limits(2) - limits(1);
  if ~isfinite(span) || span <= 0
    ticks = [];
    return
  end
  step = meshcNiceStep(span / 4);
  first = ceil(limits(1) / step) * step;
  last = floor(limits(2) / step) * step;
  if first > last
    ticks = [];
  else
    ticks = first:step:last;
  end
end
%=============================================================================
function applyMeshZLimits(ax, zData)
  zValues = zData(isfinite(zData));
  if isempty(zValues)
    return
  end
  limits = [min(zValues(:)) max(zValues(:))];
  if limits(1) == limits(2)
    limits = limits + [-0.5 0.5];
  end
  zlim(ax, limits);
  ticks = meshcZTicks(limits);
  if ~isempty(ticks)
    ax.ZTick = ticks;
  end
end
%=============================================================================
function ticks = meshcZTicks(limits)
  span = limits(2) - limits(1);
  if ~isfinite(span) || span <= 0
    ticks = [];
    return
  end
  step = meshcNiceStep(span / 10);
  first = ceil(limits(1) / step) * step;
  last = floor(limits(2) / step) * step;
  if first > last
    ticks = [];
  else
    ticks = first:step:last;
  end
end
%=============================================================================
function step = meshcNiceStep(rawStep)
  magnitude = 10 ^ floor(log10(rawStep));
  scaled = rawStep / magnitude;
  if scaled <= 1.2
    multiplier = 1;
  elseif scaled <= 2.5
    multiplier = 2;
  elseif scaled <= 5
    multiplier = 5;
  else
    multiplier = 10;
  end
  step = multiplier * magnitude;
end
%=============================================================================%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = meshz(varargin)
  narginchk(1, 10000);
  nargoutchk(0, 1);
  inputArguments = convertStringToCharArgs(varargin);
  nbInputArguments = length(inputArguments);
  if (nbInputArguments >= 2) && isscalar(inputArguments{1}) ...
    && (isgraphics(inputArguments{1}, 'axes') || isgraphics(inputArguments{1}, 'hggroup'))
    go = newplotTarget(inputArguments{1}(1));
    inputArguments = inputArguments(2:end);
    nbInputArguments = length(inputArguments);
  else
    % The remaining arguments are forwarded to mesh, a high level function:
    % left in place, the pair would make that call start a new plot of its own.
    [designatedParent, inputArguments] = graphicsExtractParentProperty(inputArguments);
    go = newplotTarget(designatedParent);
    nbInputArguments = length(inputArguments);
  end
  if isgraphics(go, 'hggroup')
    meshParent = ancestor(go, 'axes');
  else
    meshParent = go;
  end
  propertiesList = {};
  firstString = find(cellfun('isclass', inputArguments, 'char'), 1);
  if (isempty(firstString))
    firstString = nbInputArguments + 1;
  end
  propertiesList = inputArguments(firstString:end);
  inputArguments = inputArguments(1:firstString - 1);
  if (length(inputArguments) == 1)
    Z = inputArguments{1};
    [m, n] = size(Z);
    [X, Y] = meshgrid(0:n - 1, 0:m - 1);
    C = Z;
  elseif (length(inputArguments) == 2)
    X = inputArguments{1};
    Y = inputArguments{2};
    Z = X;
    C = Y;
    [m, n] = size(Z);
    [X, Y] = meshgrid(0:n - 1, 0:m - 1);
  elseif (length(inputArguments) == 3)
    X = inputArguments{1};
    Y = inputArguments{2};
    Z = inputArguments{3};
    C = Z;
  elseif (length(inputArguments) == 4)
    X = inputArguments{1};
    Y = inputArguments{2};
    Z = inputArguments{3};
    C = inputArguments{4};
  else
    error('Nelson:graphics:invalidNameValueArguments', 'Invalid parameter/value pair arguments.');
  end
  [X, Y, Z, C] = reworkData(X, Y, Z, C);
  h = mesh(meshParent, X, Y, Z, C, propertiesList{:});
  if (nargout > 0)
    varargout{1} = h;
  end
end
%=============================================================================
function [X, Y, Z, C] = reworkData(X, Y, Z, C)
  if (isvector(X) && isvector(Y))
    X = [X(1), X(1), X(:).', X(end), X(end)];
    Y = [Y(1); Y(1); Y(:); Y(end); Y(end)];
  else
    X = [X(1, 1), X(1, 1), X(1, :), X(1, end), X(1, end);
      X(1, 1), X(1, 1), X(1, :), X(1, end), X(1, end);
      X(:, 1), X(:, 1), X, X(:, end), X(:, end);
      X(end, 1), X(end, 1), X(end, :), X(end, end), X(end, end);
      X(end, 1), X(end, 1), X(end, :), X(end, end), X(end, end)];

    Y = [Y(1, 1), Y(1, 1), Y(1, :), Y(1, end), Y(1, end);
      Y(1, 1), Y(1, 1), Y(1, :), Y(1, end), Y(1, end);
      Y(:, 1), Y(:, 1), Y, Y(:, end), Y(:, end);
      Y(end, 1), Y(end, 1), Y(end, :), Y(end, end), Y(end, end);
      Y(end, 1), Y(end, 1), Y(end, :), Y(end, end), Y(end, end)];
  end
  ZREF = min(Z(isfinite(Z)));
  Z = [ZREF .* ones(1, size(Z, 2) + 4);
    ZREF .* ones(1, 2), Z(1, :), ZREF .* ones(1, 2);
    ZREF .* ones(size(Z, 1), 1), Z(:, 1), Z, Z(:, end), ZREF .* ones(size(Z, 1), 1);
    ZREF .* ones(1, 2), Z(end, :), ZREF .* ones(1, 2);
    ZREF .* ones(1, size(Z, 2) + 4)];

  CDATA = C(isfinite(C(:)));
  CREF = (min(CDATA) + max(CDATA)) / 2;
  C = [CREF .* ones(2, size(C, 2) + 4);
    CREF .* ones(size(C, 1), 2), C, CREF .* ones(size(C, 1), 2);
    CREF .* ones(2, size(C, 2) + 4)];
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = movie(varargin)
  % movie(M)
  % movie(M,n)
  % movie(M,n,fps)
  % movie(h,...)

  narginchk(1, 4);
  nargoutchk(0, 0);
  inputArguments = varargin;
  nbInputArguments = nargin;
  if (isgraphics(varargin{1}, 'axes'))
    ipos = 2;
    ax = varargin{1};
    inputArguments = varargin(2:end);
    nbInputArguments = length(inputArguments);
    if nbInputArguments == 0
      error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
    end
  else
    ipos = 1;
    ax = gca();
  end
  M = inputArguments{1};
  mustBeA(M, 'struct');
  if (~isequal(fieldnames(M), {'cdata'; 'colormap'}))
    error('Nelson:movie:invalidStructureFields', 'Invalid structure fields.');
  end
  n = 1;
  fps = 12;
  idx = 1:numel(M);

  if nbInputArguments >= 2
    n = inputArguments{2};
    mustBeInteger(n, ipos + 1);
    mustBeScalarOrEmpty(n, ipos + 1);
    if nbInputArguments >= 3
      fps = inputArguments{3};
      mustBeInteger(fps, ipos + 2);
      mustBeScalarOrEmpty(fps, ipos + 2);
      mustBePositive(fps, ipos + 2);
    end
  end

  if (n > 0)
    idx = repmat(idx, 1, n);
  else
    n = -n;
    mat = repmat([idx, fliplr(idx)], 1, fix(n / 2));
    if (fix(n / 2) ~= n / 2)
      idx = [mat, idx];
    else
      idx = mat;
    end
  end

  hold_state = ishold(ax);
  hold(ax, 'on');

  xLim = ax.XLim;
  yLim = ax.YLim;

  im = [];
  for child = ax.Children
    if (isequal(child.Type, 'image') && (strcmp(child.Tag, 'MovieFrame') == true))
      im = child;
      im.CData = M(1).cdata;
      break;
    end
  end
  if isempty(im)
    im = image('Parent', ax, 'CData', M(1).cdata, 'Tag', 'MovieFrame');
  end
  axis(ax, 'off');
  % Row 1 of CData is the top of the picture, so YData runs from the upper limit
  % down to the lower one. Pin the limits too: an image stretched to the limits
  % pushes them outwards frame after frame if they are left on automatic.
  im.XData = xLim;
  im.YData = [yLim(2), yLim(1)];
  ax.XLim = xLim;
  ax.YLim = yLim;

  tau = 1 / fps;
  timerStart = tic;

  for k = idx
    im.CData = M(k).cdata;

    if ~isempty(M(k).colormap)
      ax.Colormap = M(k).colormap;
    end

    drawnow();
    elapsedTime = toc(timerStart);
    pause(max(0, tau - elapsedTime));
    timerStart = tic;
  end

  if ~hold_state
    hold(ax, 'off');
  end
end

%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
