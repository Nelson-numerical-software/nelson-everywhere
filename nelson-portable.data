classdef RandStream < handle
  properties (GetAccess = public, SetAccess = protected)
    Type = 'mt19937ar'
    Seed = uint32(0)
    NumStreams = 1
    StreamIndex = 1
  end

  properties (Dependent)
    Substream
    NormalTransform
    Antithetic
    FullPrecision
    State
  end

  properties (Access = private)
    InternalType = 'twister'
    StateStruct = struct('Type', 'twister', 'Seed', uint32(0), 'State', uint32([]))
    InternalSubstream = 1
    InternalNormalTransform = 'Ziggurat'
    InternalAntithetic = false
    InternalFullPrecision = true
  end

  methods
    function obj = RandStream(type, varargin)
      narginchk(1, Inf);
      [obj.Type, obj.InternalType] = RandStream.resolveType(type);
      opts = RandStream.parseOptions(varargin, obj.InternalType);
      obj.Seed = opts.Seed;
      obj.InternalSubstream = opts.Substream;
      obj.InternalNormalTransform = opts.NormalTransform;
      obj.InternalAntithetic = opts.Antithetic;
      obj.InternalFullPrecision = opts.FullPrecision;
      if isempty(opts.State)
        obj.StateStruct = RandStream.initialState(obj.InternalType, obj.Seed, ...
          obj.InternalSubstream, obj.InternalFullPrecision);
      else
        obj.StateStruct = struct('Type', obj.InternalType, 'Seed', obj.Seed, 'State', opts.State);
      end
    end
    %=========================================================================
    function value = get.State(obj)
      if RandStream.globalStream('iscurrent', obj)
        obj.StateStruct = rng();
        obj.Seed = obj.StateStruct.Seed;
      end
      value = obj.StateStruct.State;
    end
    %=========================================================================
    function set.State(obj, value)
      obj.StateStruct.State = value;
      if RandStream.globalStream('iscurrent', obj)
        rng(obj.StateStruct);
      end
    end
    %=========================================================================
    function value = get.Substream(obj)
      value = obj.InternalSubstream;
    end
    %=========================================================================
    function set.Substream(obj, value)
      obj.InternalSubstream = RandStream.positiveInteger(value, 'Substream');
      obj.StateStruct = RandStream.initialState(obj.InternalType, obj.Seed, ...
        obj.InternalSubstream, obj.InternalFullPrecision);
      if RandStream.globalStream('iscurrent', obj)
        rng(obj.StateStruct);
      end
    end
    %=========================================================================
    function value = get.NormalTransform(obj)
      value = obj.InternalNormalTransform;
    end
    %=========================================================================
    function set.NormalTransform(obj, value)
      obj.InternalNormalTransform = RandStream.normalTransformValue(value);
    end
    %=========================================================================
    function value = get.Antithetic(obj)
      value = obj.InternalAntithetic;
    end
    %=========================================================================
    function set.Antithetic(obj, value)
      obj.InternalAntithetic = RandStream.logicalScalar(value, 'Antithetic');
    end
    %=========================================================================
    function value = get.FullPrecision(obj)
      value = obj.InternalFullPrecision;
    end
    %=========================================================================
    function set.FullPrecision(obj, value)
      obj.InternalFullPrecision = RandStream.logicalScalar(value, 'FullPrecision');
      if RandStream.hasPrecisionMode(obj.InternalType)
        if RandStream.globalStream('iscurrent', obj)
          obj.StateStruct = rng();
        end
        obj.StateStruct.State = RandStream.withPrecisionMode(obj.StateStruct.State, ...
          obj.InternalFullPrecision);
        if RandStream.globalStream('iscurrent', obj)
          rng(obj.StateStruct);
        end
      end
    end
    %=========================================================================
    function reset(obj, varargin)
      if nargin > 2
        error('Nelson:tooManyInputs', 'Too many input arguments.');
      end
      if nargin == 2
        obj.Seed = RandStream.seedValue(varargin{1});
      end
      obj.StateStruct = RandStream.initialState(obj.InternalType, obj.Seed, ...
        obj.InternalSubstream, obj.InternalFullPrecision);
      if RandStream.globalStream('iscurrent', obj)
        rng(obj.StateStruct);
      end
    end
    %=========================================================================
    function varargout = rand(obj, varargin)
      n = max(nargout, 1);
      varargout = RandStream.generate(obj, 'rand', varargin, n);
    end
    %=========================================================================
    function varargout = randn(obj, varargin)
      n = max(nargout, 1);
      varargout = RandStream.generate(obj, 'randn', varargin, n);
    end
    %=========================================================================
    function varargout = randi(obj, varargin)
      n = max(nargout, 1);
      varargout = RandStream.generate(obj, 'randi', varargin, n);
    end
    %=========================================================================
    function varargout = randperm(obj, varargin)
      n = max(nargout, 1);
      varargout = RandStream.generate(obj, 'randperm', varargin, n);
    end
    %=========================================================================
    function varargout = rng(obj)
      backup = rng();
      if ~RandStream.globalStream('iscurrent', obj)
        % the global stream state lives in the global generator
        rng(obj.StateStruct);
      end
      if nargout > 0
        varargout{1} = backup;
      end
    end
    %=========================================================================
    function data = saveobj(obj)
      data = struct();
      data.Type = obj.Type;
      data.Seed = obj.Seed;
      data.NumStreams = obj.NumStreams;
      data.StreamIndex = obj.StreamIndex;
      data.Substream = obj.Substream;
      data.NormalTransform = obj.NormalTransform;
      data.Antithetic = obj.Antithetic;
      data.FullPrecision = obj.FullPrecision;
      data.State = obj.State;
    end
    %=========================================================================
    function varargout = horzcat(varargin)
      error('Nelson:RandStream:cannotConcatenate', 'RandStream objects cannot be concatenated.');
    end
    %=========================================================================
    function varargout = vertcat(varargin)
      error('Nelson:RandStream:cannotConcatenate', 'RandStream objects cannot be concatenated.');
    end
    %=========================================================================
    function varargout = cat(varargin)
      error('Nelson:RandStream:cannotConcatenate', 'RandStream objects cannot be concatenated.');
    end
  end

  methods (Hidden)
    function syncFromGlobalState(obj)
      obj.StateStruct = rng();
      obj.Seed = obj.StateStruct.Seed;
    end
  end

  methods (Static)
    function [varargout] = create(type, varargin)
      narginchk(1, Inf);
      opts = RandStream.parseCreateOptions(varargin);
      indices = opts.StreamIndices;
      if isempty(indices)
        indices = 1:opts.NumStreams;
      end
      streams = cell(1, length(indices));
      for k = 1:length(indices)
        streams{k} = RandStream(type, 'Seed', opts.Seed, 'Substream', indices(k));
        streams{k}.NumStreams = opts.NumStreams;
        streams{k}.StreamIndex = indices(k);
        streams{k}.InternalSubstream = 1;
      end
      if opts.CellOutput
        if nargout > 1
          error('Nelson:tooManyOutputs', 'Too many output arguments.');
        end
        varargout{1} = streams;
      else
        requestedOutputs = max(nargout, 1);
        if requestedOutputs > length(streams)
          error('Nelson:tooManyOutputs', 'Too many output arguments.');
        end
        for k = 1:requestedOutputs
          varargout{k} = streams{k};
        end
      end
    end
    %=========================================================================
    function list()
      if nargout > 0
        error('Nelson:tooManyOutputs', 'Too many output arguments.');
      end
      disp('The following random number generator algorithms are available:');
      disp('dsfmt19937');
      disp('mcg16807');
      disp('mlfg6331_64');
      disp('mrg32k3a');
      disp('mt19937ar');
      disp('pcg64dxsm');
      disp('philox4x32_10');
      disp('shr3cong');
      disp('swb2712');
      disp('threefry4x64_20');
      disp('twister64');
      disp('xoshiro256pp');
    end
    %=========================================================================
    function stream = getGlobalStream()
      stream = RandStream.globalStream('get');
      if isempty(stream)
        stream = RandStream.fromState(rng());
        RandStream.globalStream('set', stream);
      else
        stream.syncFromGlobalState();
      end
    end
    %=========================================================================
    function previous = setGlobalStream(stream)
      if ~(isa(stream, 'RandStream') && isscalar(stream))
        error('Nelson:RandStream:scalarObjectExpected', '%s must be a scalar RandStream object.', 'Input');
      end
      previous = RandStream.getGlobalStream();
      rng(stream.StateStruct);
      RandStream.globalStream('set', stream);
    end
  end

  methods (Hidden, Static)
    function obj = loadobj(data)
      if isa(data, 'RandStream')
        obj = data;
        return
      end
      obj = RandStream(data.Type, 'Seed', data.Seed, 'State', data.State);
      obj.NumStreams = data.NumStreams;
      obj.StreamIndex = data.StreamIndex;
      obj.InternalSubstream = data.Substream;
      obj.NormalTransform = data.NormalTransform;
      obj.Antithetic = data.Antithetic;
      obj.FullPrecision = data.FullPrecision;
    end
    %=========================================================================
    function varargout = empty(varargin)
      error('Nelson:RandStream:emptyArrayNotSupported', 'RandStream empty arrays are not supported.');
    end
  end

  methods (Static, Access = private)
    function out = generate(obj, functionName, args, n)
      if ~(isa(obj, 'RandStream') && isscalar(obj))
        error('Nelson:RandStream:scalarObjectExpected', '%s must be a scalar RandStream object.', 'First input');
      end
      if strcmp(functionName, 'randn') && strcmp(obj.InternalNormalTransform, 'Inversion') ...
          && ~RandStream.hasPrecisionMode(obj.InternalType)
        % Inversion transform: apply the inverse normal CDF to uniform draws
        % (pcg and xoshiro engines already generate normal values this way).
        u = RandStream.draw(obj, 'rand', args, 1);
        u = u{1};
        if isreal(u)
          out = {norminv(u)};
        else
          out = {complex(norminv(real(u)), norminv(imag(u)))};
        end
      else
        out = RandStream.draw(obj, functionName, args, n);
      end
      if strcmp(functionName, 'rand') && obj.InternalAntithetic
        for k = 1:length(out)
          out{k} = 1 - out{k};
        end
      end
    end
    %=========================================================================
    function out = draw(obj, functionName, args, n)
      % The global stream draws from the global generator; any other stream
      % draws from a private engine built from its state, so the global
      % generator is never read nor modified.
      out = cell(1, n);
      if RandStream.globalStream('iscurrent', obj)
        if strcmp(functionName, 'randperm')
          [out{1:n}] = randperm(args{:});
        else
          [out{1:n}] = builtin(functionName, args{:});
        end
      else
        [obj.StateStruct, out{1:n}] = __rng_eval__(obj.StateStruct, functionName, args{:});
      end
    end
    %=========================================================================
    function stream = fromState(state)
      compatibleType = RandStream.compatibleTypeFromInternal(state.Type);
      stream = RandStream(compatibleType, 'Seed', state.Seed, 'State', state.State);
      stream.StateStruct = state;
      if RandStream.hasPrecisionMode(state.Type)
        stream.InternalFullPrecision = (state.State(end - 1) == 0);
      end
    end
    %=========================================================================
    function state = initialState(internalType, seed, substream, fullPrecision)
      state = struct('Type', internalType, 'Seed', seed, 'State', []);
      if ~fullPrecision && RandStream.hasPrecisionMode(internalType)
        state = __rng_eval__(state);
        state.State = RandStream.withPrecisionMode(state.State, false);
      end
      if substream > 1
        state = __rng_eval__(state, 'rand', 1, substream - 1);
      else
        state = __rng_eval__(state);
      end
    end
    %=========================================================================
    function tf = hasPrecisionMode(internalType)
      % pcg and xoshiro engines: uint64 state [engine words; precision mode; cached half].
      tf = any(strcmp(internalType, {'pcg', 'xoshiro'}));
    end
    %=========================================================================
    function state = withPrecisionMode(state, fullPrecision)
      state(end - 1) = uint64(~fullPrecision);
      state(end) = uint64(0);
    end
    %=========================================================================
    function value = globalStream(action, stream)
      persistent current;
      value = [];
      switch action
        case 'set'
          current = stream;
        case 'get'
          value = current;
        case 'iscurrent'
          value = ~isempty(current) && (current == stream);
        otherwise
          error('Nelson:RandStream:invalidGlobalStreamAction', 'Invalid RandStream global stream action.');
      end
    end
    %=========================================================================
    function opts = parseOptions(args, internalType)
      defaultTransform = 'Ziggurat';
      if RandStream.hasPrecisionMode(internalType)
        defaultTransform = 'Inversion';
      end
      opts = struct('Seed', uint32(0), 'State', [], 'Substream', 1, ...
        'NormalTransform', defaultTransform, 'Antithetic', false, 'FullPrecision', true);
      if rem(length(args), 2) ~= 0
        error('Nelson:RandStream:nameValueNotPaired', 'Name-value arguments must be paired.');
      end
      for k = 1:2:length(args)
        name = RandStream.optionName(args{k}, ...
          {'seed', 'state', 'substream', 'normaltransform', 'antithetic', 'fullprecision'});
        switch name
          case 'seed'
            opts.Seed = RandStream.seedValue(args{k + 1});
          case 'state'
            opts.State = args{k + 1};
          case 'substream'
            opts.Substream = RandStream.positiveInteger(args{k + 1}, 'Substream');
          case 'normaltransform'
            opts.NormalTransform = RandStream.normalTransformValue(args{k + 1});
          case 'antithetic'
            opts.Antithetic = RandStream.logicalScalar(args{k + 1}, 'Antithetic');
          case 'fullprecision'
            opts.FullPrecision = RandStream.logicalScalar(args{k + 1}, 'FullPrecision');
        end
      end
    end
    %=========================================================================
    function opts = parseCreateOptions(args)
      opts = struct('Seed', uint32(0), 'NumStreams', 1, 'StreamIndices', [], ...
        'CellOutput', false);
      if rem(length(args), 2) ~= 0
        error('Nelson:RandStream:nameValueNotPaired', 'Name-value arguments must be paired.');
      end
      for k = 1:2:length(args)
        name = RandStream.optionName(args{k}, ...
          {'seed', 'numstreams', 'streamindices', 'celloutput'});
        switch name
          case 'seed'
            opts.Seed = RandStream.seedValue(args{k + 1});
          case 'numstreams'
            opts.NumStreams = RandStream.positiveInteger(args{k + 1}, 'NumStreams');
          case 'streamindices'
            opts.StreamIndices = RandStream.indexVector(args{k + 1}, 'StreamIndices');
          case 'celloutput'
            opts.CellOutput = RandStream.logicalScalar(args{k + 1}, 'CellOutput');
        end
      end
      if ~isempty(opts.StreamIndices) && any(opts.StreamIndices > opts.NumStreams)
        error('Nelson:RandStream:streamIndicesOutOfRange', 'StreamIndices must be less than or equal to NumStreams.');
      end
    end
    %=========================================================================
    function [compatibleType, internalType] = resolveType(type)
      if ~(ischar(type) || (isstring(type) && isscalar(type)))
        error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Generator type');
      end
      text = lower(char(type));
      switch text
        case {'mt19937ar', 'twister'}
          compatibleType = 'mt19937ar';
          internalType = 'twister';
        case 'twister64'
          compatibleType = 'twister64';
          internalType = 'twister64';
        case {'dsfmt19937', 'simdtwister'}
          compatibleType = 'dsfmt19937';
          internalType = 'simdTwister';
        case {'mrg32k3a', 'combrecursive'}
          compatibleType = 'mrg32k3a';
          internalType = 'combRecursive';
        case {'mlfg6331_64', 'laggedfibonacci607'}
          compatibleType = 'mlfg6331_64';
          internalType = 'laggedfibonacci607';
        case {'philox4x32_10', 'philox'}
          compatibleType = 'philox4x32_10';
          internalType = 'philox';
        case {'threefry4x64_20', 'threefry'}
          compatibleType = 'threefry4x64_20';
          internalType = 'threefry';
        case {'pcg64dxsm', 'pcg'}
          compatibleType = 'pcg64dxsm';
          internalType = 'pcg';
        case {'xoshiro256pp', 'xoshiro'}
          compatibleType = 'xoshiro256pp';
          internalType = 'xoshiro';
        case {'mcg16807', 'shr3cong', 'swb2712'}
          compatibleType = text;
          internalType = 'twister';
        otherwise
          error('Nelson:RandStream:invalidGeneratorType', 'A valid generator type expected.');
      end
    end
    %=========================================================================
    function compatibleType = compatibleTypeFromInternal(type)
      switch lower(char(type))
        case 'twister'
          compatibleType = 'mt19937ar';
        case 'twister64'
          compatibleType = 'twister64';
        case 'simdtwister'
          compatibleType = 'dsfmt19937';
        case 'combrecursive'
          compatibleType = 'mrg32k3a';
        case 'laggedfibonacci607'
          compatibleType = 'mlfg6331_64';
        case 'philox'
          compatibleType = 'philox4x32_10';
        case 'threefry'
          compatibleType = 'threefry4x64_20';
        case 'pcg'
          compatibleType = 'pcg64dxsm';
        case 'xoshiro'
          compatibleType = 'xoshiro256pp';
        otherwise
          compatibleType = char(type);
      end
    end
    %=========================================================================
    function name = optionName(value, choices)
      if ~(ischar(value) || (isstring(value) && isscalar(value)))
        error('Nelson:RandStream:invalidNameValueName', 'Invalid name-value argument name.');
      end
      text = lower(char(value));
      matches = choices(startsWith(choices, text));
      if length(matches) ~= 1
        error('Nelson:RandStream:invalidNameValueName', 'Invalid name-value argument name.');
      end
      name = matches{1};
    end
    %=========================================================================
    function value = seedValue(value)
      if ischar(value) || (isstring(value) && isscalar(value))
        if strcmpi(char(value), 'shuffle')
          value = mod(floor(now() * 8640000), 2 ^ 31 - 1);
        else
          error('Nelson:RandStream:invalidSeed', 'Seed must be a nonnegative scalar or shuffle.');
        end
      end
      if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) ...
          && value >= 0 && value < 2 ^ 32)
        error('Nelson:RandStream:seedOutOfRange', 'Seed must be a nonnegative scalar less than 2^32.');
      end
      value = uint32(floor(value));
    end
    %=========================================================================
    function value = positiveInteger(value, name)
      if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) ...
          && value > 0 && value == fix(value))
        error('Nelson:RandStream:aPositiveIntegerScalar2', '%s must be a positive integer scalar.', name);
      end
      value = double(value);
    end
    %=========================================================================
    function value = indexVector(value, name)
      if ~(isnumeric(value) && isreal(value) && isvector(value) && all(isfinite(value(:))) ...
          && all(value(:) > 0) && all(value(:) == fix(value(:))))
        error('Nelson:RandStream:containPositiveIntegerValues2', '%s must contain positive integer values.', name);
      end
      value = double(value(:)).';
    end
    %=========================================================================
    function value = logicalScalar(value, name)
      if islogical(value) && isscalar(value)
        return
      end
      if isnumeric(value) && isscalar(value) && (value == 0 || value == 1)
        value = logical(value);
        return
      end
      error('Nelson:RandStream:trueFalse2', '%s must be true or false.', name);
    end
    %=========================================================================
    function value = normalTransformValue(value)
      if ~(ischar(value) || (isstring(value) && isscalar(value)))
        error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'NormalTransform');
      end
      text = lower(char(value));
      switch text
        case 'ziggurat'
          value = 'Ziggurat';
        case 'polar'
          value = 'Polar';
        case 'inversion'
          value = 'Inversion';
        otherwise
          error('Nelson:RandStream:invalidNormalTransform', 'NormalTransform must be Ziggurat, Polar, or Inversion.');
      end
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = randperm(varargin)
  narginchk(1, 2);
  nargoutchk(0, 1);

  n = varargin{1};
  if (nargin < 2)
    k = n;
  else
    k = varargin{2};
  end
  if (n <= 0)
    varargout{1} = zeros(1, 0);
    return
  end
  if (nargin >= 2 && 4 * k < n)
    % Sparse partial permutation: selection sampling ('Floyd') draws exactly
    % one uniform per selected element and reproduces the reference stream.
    avail = 1:n;
    p = zeros(1, k);
    for i = 1:k
      m = n - i + 1;
      j = floor(rand() * m) + 1;
      p(i) = avail(j);
      avail(j) = avail(m);
    end
    varargout{1} = p;
    return
  end
  % Full permutation (matches the reference) and the dense partial case.
  [~, p] = sort(rand(1, n));
  varargout{1} = p(1:k);
end
%=============================================================================
{
  "module": "random"
}
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <-- Short Description -->
% randi: limits validation and 64-bit ranges (was truncated by an int cast)
%=============================================================================
msg = _('First input must be a positive scalar integer value IMAX, or two integer values [IMIN IMAX] with IMIN less than or equal to IMAX.');
asserts.checkerror('randi(0)', msg);
asserts.checkerror('randi(-3)', msg);
asserts.checkerror('randi(2.5)', msg);
asserts.checkerror('randi([5 3])', msg);
asserts.checkerror('randi([1.5 3])', msg);
asserts.checkerror('randi(NaN)', msg);
asserts.checkerror('randi(Inf)', msg);
%=============================================================================
asserts.checkerror('randi(2^53)', _('IMIN and IMAX must be less than 2^53.'));
asserts.checkerror('randi([-2^53, 10])', _('IMIN and IMAX must be less than 2^53.'));
% the range condition also carries a stable identifier
asserts.checkerror('randi(2^53)', _('IMIN and IMAX must be less than 2^53.'), 'Nelson:randi:rangeTooLarge');
%=============================================================================
% large ranges are no longer truncated to 32 bits
v = randi(2 ^ 40, 1000, 1);
asserts.istrue(all(v >= 1));
asserts.istrue(all(v <= 2 ^ 40));
asserts.istrue(all(v == floor(v)));
% overwhelmingly likely with 1000 draws over [1, 2^40]
asserts.istrue(max(v) > 2 ^ 32);
%=============================================================================
v = randi(2 ^ 53 - 1, 100, 1);
asserts.istrue(all(v >= 1));
asserts.istrue(all(v <= 2 ^ 53 - 1));
%=============================================================================
% ranges with imin different from 1, including negative values
v = randi([5 10], 100, 1);
asserts.istrue(all(v >= 5));
asserts.istrue(all(v <= 10));
v = randi([-5 5], 100, 1);
asserts.istrue(all(v >= -5));
asserts.istrue(all(v <= 5));
asserts.isequal(class(v), 'double');
%=============================================================================
% degenerate but valid range
asserts.isequal(randi([7 7]), 7);
asserts.isequal(randi(1), 1);
%=============================================================================
% still works with type argument
v = randi(10, 2, 2, 'int8');
asserts.isequal(class(v), 'int8');
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
rng(0, 'combRecursive');
r = rng();
asserts.isequal(r.Type, 'combRecursive');
asserts.isequal(r.Seed, uint32(0));
ref_state = uint32([2637242579;
   1747669293;
   2112977067;
   2633436652;
   3518603782;
    229738972;
   2637242579;
   1747669293;
   2112977067;
   2633436652;
   3518603782;
    229738972]);
asserts.isequal(r.State, ref_state);
%=============================================================================
R = rand(4, 4);
REF = [0.727011758018417 0.027684801922269 0.318358744693222 0.726002771745855;
   0.452184066344457 0.131580204223432 0.322981379106844 0.739222484032351;
   0.938714294557252 0.211220857804805 0.416659916207741 0.869799715953008;
   0.236039851373673 0.932393973017922 0.649431596272524 0.681120644246932];
asserts.isapprox(R, REF, 1e-7);
%=============================================================================
R = randi(4, 5);
REF = [3 4 4 3 4;
     4 3 4 2 2;
     4 3 3 3 1;
     1 2 4 2 1;
     2 3 1 3 4];
asserts.isequal(R, REF);
%=============================================================================
R = randn(4, 5);
REF = [1.0512 -1.3932 2.2741 0.1947 0.3203;
   -0.0518 -0.1405 1.0550 0.2135 0.4093;
   -0.6205 0.5707 -0.5586 0.8765 -0.0585;
   -0.2571 -0.9097 -1.6273 -0.0582 -2.6768];
asserts.isapprox(R, REF, 1e-4);
%=============================================================================
R = rand(3, 4, 'like', 3i);
REF = [0.8359 + 0.1269i 0.8624 + 0.2431i 0.3312 + 0.8468i 0.5175 + 0.0340i;
   0.6903 + 0.8748i 0.4749 + 0.2214i 0.8491 + 0.5272i 0.1467 + 0.3601i;
   0.4810 + 0.3258i 0.0504 + 0.4017i 0.0861 + 0.7108i 0.0915 + 0.4767i];
asserts.isapprox(R, REF, 1e-4);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
s = RandStream('mlfg6331_64', 'Seed', 0);
asserts.isequal(class(s), 'RandStream');
asserts.isequal(s.Type, 'mlfg6331_64');
asserts.isequal(s.Seed, uint32(0));
asserts.isequal(s.Substream, 1);
asserts.checkerror('s.Seed = uint32(2);', _('Cannot set property: Seed'));
%=============================================================================
fractionalSeed = RandStream('mt19937ar', 'Seed', 7.9);
asserts.isequal(fractionalSeed.Seed, uint32(7));
shuffleSeed = RandStream('mt19937ar', 'Seed', 'shuffle');
asserts.isequal(class(shuffleSeed), 'RandStream');
%=============================================================================
props = RandStream('mt19937ar', 'Seed', 2, 'NormalTransform', 'polar', ...
  'Antithetic', true, 'FullPrecision', false);
asserts.isequal(props.NormalTransform, 'Polar');
asserts.istrue(props.Antithetic);
asserts.isfalse(props.FullPrecision);
props.NormalTransform = 'inversion';
props.Antithetic = false;
props.FullPrecision = true;
asserts.isequal(props.NormalTransform, 'Inversion');
asserts.isfalse(props.Antithetic);
asserts.istrue(props.FullPrecision);
%=============================================================================
s64 = RandStream('twister64', 'Seed', 7);
asserts.isequal(s64.Type, 'twister64');
asserts.isequal(size(rand(s64, 1, 2)), [1 2]);
%=============================================================================
types = {'twister', 'twister64', 'simdTwister', 'combRecursive', ...
  'philox', 'threefry', 'laggedfibonacci607', 'mlfg6331_64'};
for k = 1:length(types)
  streamForType = RandStream(types{k}, 'Seed', k);
  asserts.isequal(size(rand(streamForType, 1, 2)), [1 2]);
end
%=============================================================================
a = rand(s, 1, 4);
b = rand(s, 1, 4);
reset(s);
c = rand(s, 1, 4);
asserts.isequal(a, c);
asserts.isfalse(isequal(a, b));
%=============================================================================
s = RandStream('mt19937ar', 'Seed', 3);
rand(s, 1, 2);
savedState = s.State;
expected = rand(s, 1, 2);
s.State = savedState;
asserts.isequal(rand(s, 1, 2), expected);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
s = RandStream.create('mrg32k3a', 'Seed', 7);
x = randn(s, 2, 2);
reset(s, 7);
asserts.isequal(randn(s, 2, 2), x);
%=============================================================================
indexedStreams = RandStream.create('mrg32k3a', 'Seed', 7, ...
  'NumStreams', 4, 'StreamIndices', [2 4], 'CellOutput', true);
asserts.isequal(length(indexedStreams), 2);
asserts.isequal(indexedStreams{1}.NumStreams, 4);
asserts.isequal(indexedStreams{1}.StreamIndex, 2);
asserts.isequal(indexedStreams{1}.Substream, 1);
asserts.isequal(indexedStreams{2}.NumStreams, 4);
asserts.isequal(indexedStreams{2}.StreamIndex, 4);
asserts.isequal(indexedStreams{2}.Substream, 1);
indexedStream = RandStream.create('mrg32k3a', 'Seed', 7, ...
  'NumStreams', 4, 'StreamIndices', [2 4]);
asserts.isequal(class(indexedStream), 'RandStream');
asserts.isequal(indexedStream.StreamIndex, 2);
%=============================================================================
streams = RandStream.create('mt19937ar', 'NumStreams', 2, 'CellOutput', true);
asserts.isequal(class(streams), 'cell');
asserts.isequal(length(streams), 2);
asserts.isequal(class(streams{1}), 'RandStream');
[s1, s2] = RandStream.create('mt19937ar', 'NumStreams', 2);
asserts.isequal(s1.StreamIndex, 1);
asserts.isequal(s2.StreamIndex, 2);
asserts.checkerror('[s1, s2, s3] = RandStream.create(''mt19937ar'', ''NumStreams'', 2);', ...
  _('Too many output arguments.'));
%=============================================================================
s = RandStream('mt19937ar', 'Seed', 4);
saved = rng(s);
cleanupRng = onCleanup(@() rng(saved));
globalValues = rand(1, 3);
rng(saved);
clear cleanupRng;
reset(s, 4);
streamValues = rand(s, 1, 3);
asserts.isequal(globalValues, streamValues);
%=============================================================================
globalBackup = RandStream.getGlobalStream();
cleanupGlobal = onCleanup(@() RandStream.setGlobalStream(globalBackup));
s = RandStream('mt19937ar', 'Seed', 4);
previous = RandStream.setGlobalStream(s);
stateBefore = s.State;
rand(1, 3);
stateAfter = s.State;
asserts.isequal(class(previous), 'RandStream');
asserts.isfalse(isequal(stateBefore, stateAfter));
sameGlobal = RandStream.getGlobalStream();
asserts.istrue(sameGlobal == s);
RandStream.setGlobalStream(globalBackup);
clear cleanupGlobal;
%=============================================================================
rp = randperm(RandStream('mt19937ar', 'Seed', 9), 6, 3);
asserts.isequal(size(rp), [1 3]);
asserts.isequal(length(unique(rp)), 3);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% Creating or drawing from a RandStream that is not the global stream must
% leave the global generator untouched.
%=============================================================================
types = {'mt19937ar', 'twister64', 'dsfmt19937', 'mrg32k3a', 'mlfg6331_64', ...
  'philox4x32_10', 'threefry4x64_20', 'pcg64dxsm', 'xoshiro256pp'};
internalTypes = {'twister', 'twister64', 'simdTwister', 'combRecursive', ...
  'laggedfibonacci607', 'philox', 'threefry', 'pcg', 'xoshiro'};
for k = 1:length(types)
  rng(42, internalTypes{k});
  expected = rand(1, 4);
  rng(42, internalTypes{k});
  before = rng();
  s = RandStream(types{k}, 'Seed', 42);
  asserts.isequal(rng(), before);
  asserts.isequal(rand(s, 1, 4), expected);
  asserts.isequal(rng(), before);
  randn(s, 2, 3);
  randi(s, 10, 1, 5);
  randperm(s, 6);
  asserts.isequal(rng(), before);
end
%=============================================================================
% the private stream keeps its own sequence across calls
rng(3, 'twister');
expected = rand(1, 6);
rng('default');
before = rng();
s = RandStream('mt19937ar', 'Seed', 3);
asserts.isequal([rand(s, 1, 2), rand(s, 1, 4)], expected);
asserts.isequal(rng(), before);
%=============================================================================
% options that go through the generation path
before = rng();
s = RandStream('pcg64dxsm', 'Seed', 5, 'FullPrecision', false);
rand(s, 1, 3);
s = RandStream('mrg32k3a', 'Seed', 5, 'Substream', 3);
rand(s, 1, 3);
s = RandStream('mt19937ar', 'Seed', 5, 'NormalTransform', 'Inversion', 'Antithetic', true);
randn(s, 1, 3);
rand(s, 1, 3);
reset(s, 8);
rand(s, 1, 3);
asserts.isequal(rng(), before);
%=============================================================================
% an error raised while drawing leaves the global generator untouched
before = rng();
s = RandStream('philox4x32_10', 'Seed', 1);
asserts.checkerror('rand(s, ''int8'')', _('''single'' or ''double'' expected at last argument.'));
asserts.isequal(rng(), before);
asserts.isequal(rand(s, 1, 2), RandStream('philox4x32_10', 'Seed', 1).rand(1, 2));
%=============================================================================
% the global stream draws from the global generator
rng(11, 'twister');
g = RandStream.getGlobalStream();
first = rand(1, 2);
second = rand(g, 1, 2);
rng(11, 'twister');
asserts.isequal([first, second], rand(1, 4));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
txt = evalc('RandStream.list');
asserts.istrue(~isempty(strfind(txt, 'mt19937ar')));
asserts.istrue(~isempty(strfind(txt, 'mlfg6331_64')));
asserts.istrue(~isempty(strfind(txt, 'twister64')));
%=============================================================================
% NormalTransform 'Inversion' applies the inverse normal CDF to uniform draws.
s = RandStream('mt19937ar', 'Seed', 42, 'NormalTransform', 'Inversion');
asserts.isequal(s.NormalTransform, 'Inversion');
rInv = randn(s, 1, 4);
sU = RandStream('mt19937ar', 'Seed', 42);
REF = norminv(rand(sU, 1, 4));
asserts.isapprox(rInv, REF, 1e-12);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
backup = rng();
%=============================================================================
txt = evalc('RandStream.list');
assert_istrue(contains(txt, 'pcg64dxsm'));
assert_istrue(contains(txt, 'xoshiro256pp'));
%=============================================================================
types = {'pcg64dxsm', 'pcg', 'xoshiro256pp', 'xoshiro'};
names = {'pcg64dxsm', 'pcg64dxsm', 'xoshiro256pp', 'xoshiro256pp'};
internals = {'pcg', 'pcg', 'xoshiro', 'xoshiro'};
for k = 1:numel(types)
  rng(42, internals{k});
  REF = rand(1, 4);
  s = RandStream(types{k}, 'Seed', 42);
  assert_isequal(s.Type, names{k});
  assert_isequal(s.NormalTransform, 'Inversion');
  assert_istrue(s.FullPrecision);
  assert_isequal(rand(s, 1, 4), REF);
  % randn: inverse normal CDF of the uniform draws
  s = RandStream(types{k}, 'Seed', 5);
  z = randn(s, 1, 100);
  reset(s);
  assert_isapprox(z, norminv(rand(s, 1, 100)), 1e-12);
end
%=============================================================================
s = RandStream('pcg', 'Seed', 42);
assert_isequal(rand(s, 1, 2), [0.25111547288804958 0.82460521729518999]);
s = RandStream('xoshiro', 'Seed', 42);
assert_isequal(rand(s, 1, 2), [0.81430514512290986 0.31882104006166112]);
%=============================================================================
% FullPrecision false: each double from a 32-bit half output (two per output).
s = RandStream('pcg64dxsm', 'Seed', 42, 'FullPrecision', false);
assert_isfalse(s.FullPrecision);
REF = [0.25111547287087888 0.57374773256015033 0.82460521731991321 0.39381489774677902];
assert_isequal(rand(s, 1, 4), REF);
s = RandStream('xoshiro256pp', 'Seed', 42, 'FullPrecision', false);
REF = [0.81430514517705888 0.2674317731289193 0.31882104009855539 0.3415407877182588];
assert_isequal(rand(s, 1, 4), REF);
% the cached half output is kept between calls
reset(s);
A = [rand(s, 1, 3), rand(s, 1, 3)];
reset(s);
B = rand(s, 1, 6);
assert_isequal(A, B);
assert_isequal(A(1:4), REF);
x = A * 2 ^ 33;
assert_isequal(mod(x, 2), ones(1, 6));
% toggling the property
s.FullPrecision = true;
reset(s);
assert_isequal(rand(s, 1, 2), [0.81430514512290986 0.31882104006166112]);
s.FullPrecision = false;
reset(s);
assert_isequal(rand(s, 1, 4), REF);
%=============================================================================
% substreams and multiple streams
s = RandStream('pcg', 'Seed', 1);
a = rand(s, 1, 5);
s.Substream = 2;
b = rand(s, 1, 5);
assert_isfalse(isequal(a, b));
s.Substream = 1;
assert_isequal(rand(s, 1, 5), a);
[s1, s2] = RandStream.create('xoshiro256pp', 'NumStreams', 2, 'Seed', 3);
assert_isequal(s1.Type, 'xoshiro256pp');
assert_isequal(s2.StreamIndex, 2);
assert_isfalse(isequal(rand(s1, 1, 5), rand(s2, 1, 5)));
%=============================================================================
% global stream and state roundtrip
s = RandStream('xoshiro', 'Seed', 9);
previous = RandStream.setGlobalStream(s);
st = s.State;
assert_isequal(class(st), 'uint64');
a = rand(1, 4);
s.State = st;
assert_isequal(rand(1, 4), a);
g = RandStream.getGlobalStream();
assert_isequal(g.Type, 'xoshiro256pp');
RandStream.setGlobalStream(previous);
%=============================================================================
p = randperm(RandStream('pcg', 'Seed', 2), 10);
assert_isequal(sort(p), 1:10);
r = randi(RandStream('xoshiro', 'Seed', 2), 6, 1, 100);
assert_istrue(all(r >= 1 & r <= 6));
%=============================================================================
rng(backup);
