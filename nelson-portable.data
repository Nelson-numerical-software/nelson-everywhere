function varargout = var(A, varargin)
  [varargout{1:nargout}] = timetableMathReduceMulti(A, @var, 'var', max(nargout, 1), varargin{:});
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
