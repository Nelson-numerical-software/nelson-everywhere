function metadata = run_accumulator_job_metadata(accumulator, nativeIndex)
  metadata = cell(length(nativeIndex), 1);
  for k = 1:length(nativeIndex)
    metadata{k} = accumulator(nativeIndex(k)).filename;
  end
end
