%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function data = odeSolutionData(sol)
  if isa(sol, 'nelson.ode.ODEResults')
    sol = sol.RawSolution;
  end
  if ~isstruct(sol) || ~isfield(sol, 'x') || ~isfield(sol, 'y')
    error('Nelson:ode_solvers:odeSolutionStructureExpected', 'ODE solution structure expected.');
  end
  if ~isfield(sol, 'xe')
    sol.xe = [];
  end
  if ~isfield(sol, 'ye')
    sol.ye = zeros(size(sol.y, 1), 0);
  end
  if ~isfield(sol, 'ie')
    sol.ie = [];
  end
  if ~isfield(sol, 'stats')
    sol.stats = odeInitialStats();
  end
  data = sol;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = odeSolveFunction(solver, nout, varargin)
  if strcmp(solver, 'ode15i')
    [odefun, tspan, y0, yp0, options] = odeParse15i(varargin{:});
  else
    [odefun, tspan, y0, options] = odeParseStandard(varargin{:});
    yp0 = [];
  end
  sol = odeRunSolver(solver, odefun, tspan, y0, yp0, options, nout);
  if nout <= 1
    varargout{1} = sol;
    return
  end
  if ~odeHasRequestedOutputOnly(sol)
    sol = odeResampleSolution(sol, tspan);
  end
  data = odeSolutionData(sol);
  varargout{1} = data.x(:);
  varargout{2} = data.y.';
  if nout >= 3
    varargout{3} = data.xe(:);
  end
  if nout >= 4
    varargout{4} = data.ye.';
  end
  if nout >= 5
    varargout{5} = data.ie(:);
  end
end
%=============================================================================
function tf = odeHasRequestedOutputOnly(sol)
  tf = isstruct(sol) && isfield(sol, 'extdata') && isfield(sol.extdata, 'requestedOutputOnly') ...
    && sol.extdata.requestedOutputOnly;
end
%=============================================================================
function [odefun, tspan, y0, options] = odeParseStandard(varargin)
  narginchk(3, inf);
  odefun = varargin{1};
  tspan = varargin{2};
  y0 = varargin{3};
  if nargin < 4
    options = [];
  else
    options = varargin{4};
  end
  if nargin > 4
    options = odeAttachParameters(options, varargin(5:end));
  end
end
%=============================================================================
function [odefun, tspan, y0, yp0, options] = odeParse15i(varargin)
  narginchk(4, inf);
  odefun = varargin{1};
  tspan = varargin{2};
  y0 = varargin{3};
  yp0 = varargin{4};
  if nargin < 5
    options = [];
  else
    options = varargin{5};
  end
  if nargin > 5
    options = odeAttachParameters(options, varargin(6:end));
  end
end
%=============================================================================
function options = odeAttachParameters(options, parameters)
  if isempty(options)
    options = struct();
  elseif odeIsSolverOptions(options)
    options = struct(options);
  elseif ~isstruct(options)
    error('Nelson:ode_solvers:optionsArgumentStructureCreatedOdeset', 'Options argument must be a structure created with odeset.');
  end
  options.Parameters = parameters;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function solver = odeSolverName(solver)
  if isstring(solver)
    solver = char(solver);
  end
  if ~ischar(solver)
    error('Nelson:ode_solvers:solverNameExpected', 'Solver name expected.');
  end
  allowed = {'auto', 'autoswitch', 'stiff', 'nonstiff', 'ode45', 'ode23', 'ode78', ...
    'ode89', 'ode113', 'ode15s', 'ode23s', 'ode23t', 'ode23tb', 'ode15i', ...
    'cvodesnonstiff', 'cvodesstiff', 'idas'};
  idx = find(strcmpi(solver, allowed));
  if isempty(idx)
    error('Nelson:ode_solvers:unknownOdeSolver', 'Unknown ODE solver.');
  end
  solver = allowed{idx(1)};
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function stop = odeStopFlag(value, name)
  if isempty(value)
    stop = false;
    return
  end
  if ~(isnumeric(value) || islogical(value)) || ~isscalar(value) || ~isfinite(double(value))
    error('Nelson:ode_solvers:invalidValue:valueStopFlagAScalarNumeric', '%s stop flag must be a scalar numeric or logical value.', name);
  end
  stop = logical(value);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function tf = odeSundialsAvailable()
  tf = __ode_sundials_available__();
  if ~tf
    return
  end
  mode = upper(getenv('NELSON_SUNDIALS_RUNTIME'));
  tf = ~(strcmp(mode, 'OFF') || strcmp(mode, '0') || strcmp(mode, 'FALSE'));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% TR-BDF2 step (trapezoid stage to t + gamma*h followed by a variable
% coefficient BDF2 stage to t + h, gamma = 2 - sqrt(2)) with the standard
% embedded third-order error estimate of Hosea and Shampine, filtered by the
% stage iteration matrix for stiff robustness. Both implicit stages are
% solved with a small modified-Newton iteration so that an inexact supplied
% Jacobian does not leave an uncontrolled solve residual.
function [yhigh, ylow, evals] = odeTRBDF2Step(problem, t, y, h)
  gamma = 2 - sqrt(2);
  f0 = odeRhs(problem, t, y);
  [jac0, jacEvals0] = odeRhsJacobian(problem, t, y, f0);
  htrap = gamma * h;
  ystagePredicted = odeTRBDF2TrapezoidPredict(y, htrap, f0, jac0);
  fstagePredicted = odeRhs(problem, t + htrap, ystagePredicted);
  if strcmpi(problem.options.JConstant, 'on')
    jacStage = jac0;
    jacEvalsStage = 0;
  else
    [jacStage, jacEvalsStage] = odeRhsJacobian(problem, t + htrap, ystagePredicted, fstagePredicted);
  end
  [ystage, fstage, stageEvals] = odeTRBDF2TrapezoidSolve(...
    problem, t, y, htrap, f0, ystagePredicted, fstagePredicted, jacStage);
  yendPredicted = odeTRBDF2BDFPredict(y, ystage, h, fstage, gamma);
  fendPredicted = odeRhs(problem, t + h, yendPredicted);
  if strcmpi(problem.options.JConstant, 'on')
    jacEnd = jac0;
    jacEvalsEnd = 0;
  else
    [jacEnd, jacEvalsEnd] = odeRhsJacobian(problem, t + h, yendPredicted, fendPredicted);
  end
  [yhigh, fend, endEvals] = odeTRBDF2BDFSolve(...
    problem, t, y, ystage, h, gamma, yendPredicted, fendPredicted, jacEnd);
  % Embedded third-order error estimate (difference between the TR-BDF2
  % weights and the third-order interpolatory quadrature on the stage
  % nodes), filtered through the stage iteration matrix.
  sq2 = sqrt(2);
  rawEstimate = h * (((sq2 - 1) / 3) * f0 - (1 / 3) * fstage + ((2 - sq2) / 3) * fend);
  d = 1 - sq2 / 2;
  n = length(y);
  filteredEstimate = (eye(n, n) - h * d * jacEnd) \ rawEstimate;
  ylow = yhigh - filteredEstimate;
  evals = 3 + stageEvals + endEvals + jacEvals0 + jacEvalsStage + jacEvalsEnd;
end
%=============================================================================
function [ystage, fstage, evals] = odeTRBDF2TrapezoidSolve(...
    problem, t, y, htrap, f0, ypredicted, fpredicted, jac)
  ystage = ypredicted;
  fstage = fpredicted;
  evals = 0;
  for iteration = 1:4
    ynext = odeTRBDF2TrapezoidCorrect(y, htrap, f0, ystage, fstage, jac);
    delta = ynext - ystage;
    ystage = ynext;
    scale = problem.options.AbsTol + abs(ystage) * problem.options.RelTol;
    fstage = odeRhs(problem, t + htrap, ystage);
    evals = evals + 1;
    if max(abs(delta) ./ scale) < 0.05
      break
    end
  end
end
%=============================================================================
function [yend, fend, evals] = odeTRBDF2BDFSolve(...
    problem, t, y, ystage, h, gamma, ypredicted, fpredicted, jac)
  a0 = (1 - gamma) / (gamma * h);
  a1 = -1 / (gamma * (1 - gamma) * h);
  a2 = (2 - gamma) / ((1 - gamma) * h);
  n = length(y);
  id = eye(n, n);
  yend = ypredicted;
  fend = fpredicted;
  evals = 0;
  for iteration = 1:4
    rightHandSide = fend - jac * yend - a0 * y - a1 * ystage;
    ynext = (a2 * id - jac) \ rightHandSide;
    delta = ynext - yend;
    yend = ynext;
    scale = problem.options.AbsTol + abs(yend) * problem.options.RelTol;
    fend = odeRhs(problem, t + h, yend);
    evals = evals + 1;
    if max(abs(delta) ./ scale) < 0.05
      break
    end
  end
end
%=============================================================================
function ynext = odeTRBDF2BDFPredict(y, ystage, h, fstage, gamma)
  a0 = (1 - gamma) / (gamma * h);
  a1 = -1 / (gamma * (1 - gamma) * h);
  a2 = (2 - gamma) / ((1 - gamma) * h);
  ynext = (fstage - a0 * y - a1 * ystage) / a2;
end
%=============================================================================
function ynext = odeTRBDF2TrapezoidPredict(y, h, f, jac)
  n = length(y);
  ynext = y + h * ((eye(n, n) - 0.5 * h * jac) \ f);
end
%=============================================================================
function ynext = odeTRBDF2TrapezoidCorrect(y, h, f0, ypredicted, f1, jac)
  n = length(y);
  rightHandSide = y + 0.5 * h * (f0 + f1 - jac * ypredicted);
  ynext = (eye(n, n) - 0.5 * h * jac) \ rightHandSide;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [accepted, ynext, err, evals] = odeTryStep(problem, t, y, h, solverState)
  if strcmp(problem.solver, 'ode23')
    [yhigh, ylow, evals] = odeBogackiShampineStep(problem, t, y, h);
  elseif strcmp(problem.solver, 'ode113')
    [yhigh, ylow, evals] = odeAdamsMoultonStep(problem, t, y, h, solverState);
  elseif strcmp(problem.solver, 'ode78')
    [yhigh, ylow, evals] = odeVerner78Step(problem, t, y, h);
  elseif strcmp(problem.solver, 'ode89')
    [yhigh, ylow, evals] = odeVerner89Step(problem, t, y, h);
  elseif strcmp(problem.solver, 'ode23t')
    [yhigh, ylow, evals] = odeLinearlyImplicitTrapezoidStep(problem, t, y, h);
  elseif strcmp(problem.solver, 'ode23tb')
    [yhigh, ylow, evals] = odeTRBDF2Step(problem, t, y, h);
  elseif strcmp(problem.solver, 'ode15s')
    if odeUseFirstOrderBDF(problem)
      [yhigh, ylow, evals] = odeLinearlyImplicitEulerFirstOrderStep(problem, t, y, h);
    else
      [yhigh, ylow, evals] = odeBDFStep(problem, t, y, h, solverState);
    end
  elseif strcmp(problem.solver, 'ode23s')
    [yhigh, ylow, evals] = odeRosenbrock23Step(problem, t, y, h);
  elseif odeIsLinearlyImplicitEulerSolver(problem.solver)
    [yhigh, ylow, evals] = odeLinearlyImplicitEulerStep(problem, t, y, h);
  else
    [yhigh, ylow, evals] = odeDormandPrinceStep(problem, t, y, h);
  end
  err = odeErrorNorm(problem, y, yhigh, ylow);
  accepted = err <= 1;
  ynext = yhigh;
end

function tf = odeIsLinearlyImplicitEulerSolver(solver)
  tf = false;
end
%=============================================================================
function tf = odeUseFirstOrderBDF(problem)
  tf = ~isempty(problem.options.MaxOrder) && problem.options.MaxOrder == 1;
end
