function hold(varargin)
  narginchk(0, 2);
  switch nargin()
    case 0
      ax = gca();
      nargs = 0;
    case 1
      ax = gca();
      opt_hold_state = varargin{1};
      nargs = 1;
    case 2
      ax = varargin{1};
      opt_hold_state = varargin{2};
      nargs = 1;
    otherwise
      error('Nelson:tooManyInputs', 'Too many input arguments.');
  end
  if ~isgraphics(ax)
    error('Nelson:hold:invalidFirstArgument', 'First argument must be an axes object.');
  end
  fig = ancestor(ax, 'figure');
  nexta = ax.NextPlot;
  nextf = fig.NextPlot;
  hold_state = strcmp(nextf, 'add') && strcmp(nexta, 'add');
  replace_state = 'replace';
  add_state = 'add';

  if (nargs == 0)
    if (hold_state)
      ax.NextPlot = replace_state;
    else
      fig.NextPlot = add_state;
      ax.NextPlot = add_state;
    end
  elseif (strcmpi(opt_hold_state, 'on'))
    fig.NextPlot = add_state;
    ax.NextPlot = add_state;
  elseif (strcmpi(opt_hold_state, 'off'))
    ax.NextPlot = replace_state;
  elseif (strcmpi(opt_hold_state, 'all'))
    fig.NextPlot = add_state;
    ax.NextPlot = add_state;
  else
    error('Nelson:hold:invalidOnOffValue', 'Command option must be ''on'' or ''off''.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = im2frame(varargin)
  % F = im2frame(RGB)
  % F = im2frame(X, map)
  % F = im2frame(X)
  narginchk(1, 2);
  nargoutchk(0, 1);

  inputImage = varargin{1};

  % Initialize colormap as empty if not provided
  colormap = [];
  if nargin > 1
    colormap = varargin{2};
  end

  % Check dimensions
  if ndims(inputImage) > 4
    error('Nelson:im2frame:invalidInputImage', 'Input image must be a scalar image with at most 4 dimensions.');
  end

  numberOfChannels = size(inputImage, 3);

  if numberOfChannels == 3
    % RGB image processing
    if nargin > 1
      warning('Nelson:im2frame:colormapIgnoredForRGB', 'Colormap ignored for RGB images.');
    end

    % Check if inputImage is a valid RGB image
    if ~isnumeric(inputImage) || ~isreal(inputImage) || ~isreal(inputImage) || issparse(inputImage)
      error('Nelson:im2frame:invalidRGBImage', 'RGB image must be a numeric real array.');
    end

  elseif numberOfChannels == 1
    % Indexed or grayscale image processing
    if nargin < 2
      % Handle grayscale image (no colormap provided)
      colormap = gray(256);
    else
      % Check if colormap is a valid colormap
      isValidColormap = isnumeric(colormap) && isreal(colormap) && isfloat(colormap) && ...
        (ndims(colormap) == 2) && (size(colormap, 2) == 3);

      if ~isValidColormap
        error('Nelson:im2frame:invalidColormap', 'A valid colormap expected (Mx3 numeric array).');
      end

      % Check if inputImage is a valid indexed image
      isValidIndexedImage = isnumeric(inputImage) && isreal(inputImage) && ~issparse(inputImage) && ...
        (isfloat(inputImage) && all(inputImage(:) == fix(inputImage(:))) || ...
        (isinteger(inputImage) && intmin(class(inputImage)) == 0));

      if ~isValidIndexedImage
        error('Nelson:im2frame:invalidIndexedImage', 'Indexed image must be an array with integer values.');
      end

      % Handle out-of-range indices for float images
      if isfloat(inputImage)
        invalidIndices = inputImage < 1;
        if any(invalidIndices(:))
          inputImage(invalidIndices) = 1;
        end
      end

      % Handle colormap issues
      maxIndexValue = max(inputImage(:));
      isIntegerType = isinteger(inputImage);

      if isIntegerType
        if maxIndexValue == intmax(class(inputImage))
          inputImage = single(inputImage);
        end
        inputImage = inputImage + 1; % Convert 0-based to 1-based indexing
      end

      numberOfColors = size(colormap, 1);
      if numberOfColors - isIntegerType < maxIndexValue
        % Extend the colormap or clamp indices
        if numel(inputImage) > maxIndexValue - numberOfColors + isIntegerType
          colormapExtension = repmat(colormap(end, :), maxIndexValue - numberOfColors + isIntegerType, 1);
          colormap(end + (1:size(colormapExtension, 1)), :) = colormapExtension;
        else
          inputImage(inputImage > numberOfColors) = numberOfColors;
        end
      end
    end
  else
    error('Nelson:im2frame:invalidImageChannels', 'Input image must be indexed (1 channel) or RGB (3 channels).');
  end

  % Handle 4D images (image sequences)
  if ndims(inputImage) == 4
    inputImage = reshape(num2cell(inputImage, [1 2 3]), 1, size(inputImage, 4));
  end

  % Create and return frame structure
  outputFrameStruct = struct('cdata', inputImage, 'colormap', colormap);
  varargout{1} = outputFrameStruct;
end
%=============================================================================
﻿%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = image(varargin)
  inputArguments = convertStringToCharArgs(varargin);
  [parent, inputArguments] = imageParseParent(inputArguments);

  % image('CData', C, ...) is the low-level form: it adds the image to the
  % target axes as-is. Unlike the high-level forms it does not go through
  % newplot(), so the axes keeps its children and the limit, tick and
  % direction settings the caller pinned before the image was added.
  if (~isempty(inputArguments) && ischar(inputArguments{1}))
    [parent, inputArguments] = imageExtractParentProperty(parent, inputArguments);
    im = __image__('Parent', parent, inputArguments{:});
    if nargout == 1
      varargout{1} = im;
    end
    return
  end

  if isempty(parent)
    parent = graphicsParentProperty(inputArguments);
  end
  if isempty(parent)
    ax = newplot();
    parent = ax;
  elseif isgraphics(parent, 'hggroup')
    ax = ancestor(parent, 'axes');
    newplot(ax);
  else
    ax = newplot(parent);
    parent = ax;
  end
  if (length(inputArguments) == 0)
    C = imageDemoCData();
    im = __image__('Parent', parent, 'CData', C, 'XData', [], 'YData', []);
    if nargout == 1
      varargout{1} = im;
    end
    return
  end
  ax.YDir = 'reverse';
  if ((length(inputArguments) == 1) || ((length(inputArguments) > 1) && (ischar(inputArguments{2}))))
    C = inputArguments{1};
    im = __image__('Parent', parent, 'CData', C, 'XData', [], 'YData', [], inputArguments{2:end});
    axis(ax, 'tight');
    ax.Box = 'on';
  elseif (numel(inputArguments) == 2)
    C = inputArguments{1};
    axis('maximal');
    im = __image__('Parent', parent, 'CData', C, 'XData', [], 'YData', []);
    if exist('zoom')
      zoom(inputArguments{2});
    end
  elseif (length(inputArguments) >= 3)
    x = inputArguments{1};
    y = inputArguments{2};
    C = inputArguments{3};
    inputArguments(1:3) = [];
    im = __image__('Parent', parent, 'XData', x, 'YData', y, 'CData', C, inputArguments{:});
    axis(ax, 'tight');
    ax.Box = 'on';
  else
    error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
  end
  if nargout == 1
    varargout{1} = im;
  end
end
%=============================================================================
function [parent, args] = imageExtractParentProperty(parent, args)
  % 'Parent' given as a property/value pair wins over a leading handle, and is
  % removed from the list so it is passed once. Only an explicit target avoids
  % gca(), which would otherwise create a figure the low-level form never uses.
  if (mod(numel(args), 2) ~= 0)
    error('Nelson:graphics:pvPairsExpected', 'Property/value pairs expected.');
  end
  parentIndex = [];
  for k = 1:2:numel(args)
    if (ischar(args{k}) && strcmpi(args{k}, 'Parent'))
      parentIndex = k;
    end
  end
  if ~isempty(parentIndex)
    parent = args{parentIndex + 1};
    args(parentIndex:parentIndex + 1) = [];
  elseif isempty(parent)
    parent = gca();
  end
end
%=============================================================================
function [parent, args] = imageParseParent(args)
  parent = [];
  if ~isempty(args) && isscalar(args{1}) && (isgraphics(args{1}, 'axes') || isgraphics(args{1}, 'hggroup'))
    parent = args{1};
    args = args(2:end);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = imagesc(varargin)
  imageHandle = [];
  leadingParent = (numel(varargin) > 0) && isscalar(varargin{1}) ...
    && (isgraphics(varargin{1}, 'axes') || isgraphics(varargin{1}, 'hggroup'));
  if leadingParent
    parent = varargin{1};
    varargin(1) = [];
    nargin = nargin - 1;
  else
    parent = graphicsParentProperty(varargin);
  end
  if ~isempty(parent)
    if isgraphics(parent, 'hggroup')
      ax = ancestor(parent, 'axes');
    else
      ax = parent;
    end
    if (leadingParent && length(varargin) == 0)
      im = image(ax);
      im.CDataMapping = 'scaled';
      if (nargout > 0)
        varargout{1} = im;
      end
      return
    end
    ax = newplotTarget(ax);
  else
    [ax, imageHandle] = imagescCurrentAxes(nargout);
  end
  if (length(varargin) == 0)
    im = image();
    im.CDataMapping = 'scaled';
    if (nargout > 0)
      varargout{1} = im;
    end
    return
  end
  if (ischar(varargin{1}) || isStringScalar(varargin{1}))
    % Property/value syntax: imagesc('CData', C, 'XData', x, ...)
    ax.YDir = 'reverse';
    if isempty(imageHandle)
      handle = __image__('Parent', ax, varargin{:}, 'CDataMapping', 'scaled');
    else
      if ~isequal(ax.Children, imageHandle)
        ax.Children = imageHandle;
      end
      handle = imageHandle;
      set(handle, varargin{:}, 'CDataMapping', 'scaled');
    end
    axis(ax, 'tight');
    ax.Box = 'on';
    if (nargout > 0)
      varargout{1} = handle;
    end
    return
  end
  lim = [];
  if ((nargin == 2) || (nargin == 4))
    if ((length(varargin{end}) == 2) && varargin{end}(1) <= varargin{end}(2))
      lim = varargin{end};
      varargin(end) = [];
      nargin = nargin - 1;
    end
  end

  if (isempty(imageHandle) && nargout == 0 && strcmp(lower(ax.NextPlot), 'replace') ...
      && ~isempty(ax.Children))
    children = ax.Children;
    for k = 1:numel(children)
      if isgraphics(children(k), 'image')
        imageHandle = children(k);
        break;
      end
    end
  end
  ax.YDir = 'reverse';
  if ((length(varargin) == 1) || ((length(varargin) > 1) && ischar(varargin{2})))
    C = varargin{1};
    if isempty(imageHandle)
      handle = __image__('Parent', ax, 'CData', C, 'XData', [], ...
        'YData', [], varargin{2:end}, 'CDataMapping', 'scaled');
    else
      if ~isequal(ax.Children, imageHandle)
        ax.Children = imageHandle;
      end
      handle = imageHandle;
      set(handle, 'CData', C, 'XData', [], 'YData', [], ...
        varargin{2:end}, 'CDataMapping', 'scaled');
    end
    axis(ax, 'tight');
    ax.Box = 'on';
  elseif (length(varargin) >= 3)
    x = varargin{1};
    y = varargin{2};
    C = varargin{3};
    if isempty(imageHandle)
      handle = __image__('Parent', ax, 'XData', x, 'YData', y, 'CData', C, ...
        varargin{4:end}, 'CDataMapping', 'scaled');
    else
      if ~isequal(ax.Children, imageHandle)
        ax.Children = imageHandle;
      end
      handle = imageHandle;
      set(handle, 'XData', x, 'YData', y, 'CData', C, varargin{4:end}, ...
        'CDataMapping', 'scaled');
    end
    axis(ax, 'tight');
    ax.Box = 'on';
  else
    handle = image(ax, varargin{:}, 'CDataMapping', 'scaled');
  end

  if ~isempty(lim),
    clim(ax, lim);
  end

  if (nargout > 0)
    varargout{1} = handle;
  end
end
%=============================================================================
function [ax, imageHandle] = imagescCurrentAxes(nbOutputs)
  % No target designated: reuse the image already held by the current axes when
  % the NextPlot policy allows it, otherwise start a new plot there.
  imageHandle = [];
  fig = groot().CurrentFigure;
  if isempty(fig)
    ax = newplot();
    return
  end
  ax = gca();
  figNextPlot = lower(fig.NextPlot);
  axNextPlot = lower(ax.NextPlot);
  children = ax.Children;
  if (nbOutputs == 0 && strcmp(axNextPlot, 'replace') && ~isempty(children) ...
      && ~any(strcmp(figNextPlot, {'replace', 'replacechildren', 'replaceall'})))
    for k = 1:numel(children)
      if isgraphics(children(k), 'image')
        imageHandle = children(k);
        break;
      end
    end
  end
  if ((~isempty(children) && isempty(imageHandle)) || ~strcmp(axNextPlot, 'replace') ...
      || any(strcmp(figNextPlot, {'replace', 'replacechildren', 'replaceall'})))
    ax = newplot();
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = imshow(varargin)
  narginchk(1, 1000);
  nargoutchk(0, 1);
  indexed = false;
  truecolor = false;
  usedColormap = [];
  inputArguments = varargin;

  if (ischar(inputArguments{1}) || isStringScalar(inputArguments{1}))
    filename = convertStringsToChars(inputArguments{1});

    [im, map] = imread(filename);
    if (isempty(map))
      indexed = false;
    else
      indexed = true;
      usedColormap = map;
    end
  else
    im = inputArguments{1};
  end
  inputArguments = inputArguments(2:end);
  nd = ndims(im);
  isSupported = (isnumeric(im) || islogical(im)) && (nd == 2 || nd == 3);
  if ~isSupported
    error('Nelson:imshow:invalidImageArgument', 'Invalid #%d argument: image or filename expected.', 1);
  end

  if (nd == 2)
    if ~indexed
      usedColormap = gray();
    end
  elseif (size(im, 3) == 3)
    if isdouble(im) || issingle(im) || isuint8(im) || isuint16(im)
      truecolor = true;
    else
      error('Nelson:imshow:invalidImage', 'Invalid #%d argument: image must be uint8, uint16, double, or single.', 1);
    end
  else
    error('Nelson:imshow:invalidImageSize', 'Wrong size for #%d argument: image must be MxN or MxNx3 array.', 1);
  end

  displayRange = [];
  XData = [];
  YData = [];
  initialMag = [];
  borderTight = false;
  args = {};

  while ~isempty(inputArguments)
    arg = inputArguments{1};
    if isnumeric(arg)
      if (numel(arg) == 2 || isempty(arg))
        displayRange = arg;
      elseif (size(arg, 2) == 3)
        indexed = true;
        if ((min(arg, [], 'all') >= 0) && (max(arg, [], 'all') <= 1))
          usedColormap = arg;
        else
          error('Nelson:imshow:invalidColormap', 'Invalid colormap.');
        end
      elseif ~isempty(arg)
        error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
      end
      inputArguments = inputArguments(2:end);
    elseif (ischar(arg))
      arg = tolower(arg);
      switch (arg)
        case 'border'
          borderValue = inputArguments{2};
          if (ischar(borderValue) || isStringScalar(borderValue))
            borderTight = strcmp(tolower(convertStringsToChars(borderValue)), 'tight');
          end
          inputArguments = inputArguments(3:end);
        case 'initialmagnification'
          initialMag = inputArguments{2};
          inputArguments = inputArguments(3:end);
        case 'displayrange'
          displayRange = inputArguments{2};
          inputArguments = inputArguments(3:end);
        case 'parent'
          args{end + 1} = 'parent';
          args{end + 1} = inputArguments{2};
          inputArguments = inputArguments(3:end);
        case 'colormap'
          map = inputArguments{2};
          if (min(map, [], 'all') >= 0 && max(map, [], 'all') <= 1)
            usedColormap = map;
          else
            error('Nelson:imshow:invalidColormap', 'Invalid colormap.');
          end
          inputArguments = inputArguments(3:end);
        case 'reduce'
          warning('Nelson:imshow:reduceNotImplemented', 'reduce option not yet implement.');
          inputArguments = inputArguments(3:end);
        case 'xdata'
          XData = inputArguments{2};
          if ~isvector(XData)
            error('Nelson:validators:mustBeVector', '%s must be a vector.', 'XData');
          end
          inputArguments = inputArguments(3:end);
        case 'ydata'
          YData = inputArguments{2};
          if ~isvector(YData)
            error('Nelson:validators:mustBeVector', '%s must be a vector.', 'YData');
          end
          inputArguments = inputArguments(3:end);
        otherwise
          error('Nelson:imshow:unrecognizedProperty', 'Unrecognized property.');
      end
    else
      error('Nelson:imshow:invalidArgumentDetected', 'Invalid argument detected.');
    end
  end

  if (~isreal(im))
    warning('Nelson:imshow:complexInputRealPart', 'Displaying real part of complex input.');
    im = real(im);
  end
  if isempty(displayRange)
    if (islogical(im) || isfloat(im))
      displayRange = [0 1];
    elseif (isinteger(im))
      displayRange = double([intmin(class(im)), intmax(class(im))]);
    else
      displayRange = double([min(im(:)), max(im(:))]);
    end
  end
  if (isfloat(im))
    rnan = isnan(im(:));
    if (any(rnan))
      warning('Nelson:imshow:nanPixelsSetToMin', 'Pixels with NaN values are set to minimum pixel value.');
      im(rnan) = displayRange(1);
    end
  end

  % imshow replaces what the target axes holds. image() and imagesc() are
  % called below in their low-level property/value form, which deliberately
  % leaves the axes alone, so the reset happens here instead.
  parentIndex = find(strcmpi(args, 'Parent'), 1, 'last');
  if isempty(parentIndex)
    newplot();
  else
    imshowResetAxes(args{parentIndex + 1});
  end

  if (truecolor || indexed)
    h = image('CData', im, 'XData', XData, 'YData', YData, args{:});
  else
    h = imagesc('CData', im, 'XData', XData, 'YData', YData, args{:});
    clim(displayRange);
    parent = h.Parent;
    parent.CLim = displayRange;
  end
  parent = h.Parent;
  if ~isempty(usedColormap)
    parent.Colormap = usedColormap;
  end
  if isValidGraphicsProperty('figure', 'View')
    parent.View = [0, 90];
  end
  parent.YDir = 'reverse';
  parent.Layer = 'top';

  % When imshow owns a fresh, default-positioned axes (no explicit 'Parent',
  % no subplot, InitialMagnification not 'fit'), the reference behaviour is to
  % size the axes to the image at the requested magnification (default 100%,
  % reduced only when the image is too large for the screen) and resize the
  % figure around it. This keeps a small image small instead of stretching it
  % to fill the whole figure.
  magIsFit = (ischar(initialMag) || isStringScalar(initialMag)) && ...
    strcmp(tolower(convertStringsToChars(initialMag)), 'fit');
  if (~isempty(initialMag) && ~magIsFit && isnumeric(initialMag) && isscalar(initialMag))
    magFraction = double(initialMag) / 100;
  else
    magFraction = 1;
  end
  explicitParent = any(strcmpi(args, 'parent'));
  if (~explicitParent && ~magIsFit && isSoleDefaultAxes(parent))
    fitFigureToImage(parent, size(im, 1), size(im, 2), magFraction, borderTight);
  end

  axis(parent, 'image');
  parent.Visible = 'off';
  if (nargout > 0)
    varargout{1} = h;
  else
    varargout = {};
  end
end
%=============================================================================
function imshowResetAxes(parent)
  if isgraphics(parent, 'hggroup')
    parent = ancestor(parent, 'axes');
  end
  if ~isempty(parent) && (isgraphics(parent, 'axes') || isgraphics(parent, 'figure'))
    newplot(parent);
  end
end
%=============================================================================
function tf = isSoleDefaultAxes(ax)
  % True when 'ax' is the only axes of its figure and still sits at the default
  % axes position, i.e. imshow created it and no subplot or manual layout is in
  % effect. In that case imshow is free to resize the figure around the image.
  tf = false;
  fig = ancestor(ax, 'figure');
  if isempty(fig)
    return
  end
  children = fig.Children;
  axesCount = 0;
  for k = 1:numel(children)
    if isgraphics(children(k), 'axes')
      axesCount = axesCount + 1;
    end
  end
  if (axesCount ~= 1)
    return
  end
  oldUnits = ax.Units;
  restoreUnits = ~strcmp(oldUnits, 'normalized');
  if restoreUnits
    ax.Units = 'normalized';
  end
  pos = ax.Position;
  if restoreUnits
    ax.Units = oldUnits;
  end
  defaultPosition = [0.13, 0.11, 0.775, 0.815];
  tf = all(abs(pos(:)' - defaultPosition) < 5e-3);
end
%=============================================================================
function fitFigureToImage(ax, rows, cols, magFraction, borderTight)
  % Size the axes to the image at 'magFraction' magnification (reduced when the
  % image cannot fit on screen) and resize the figure around it, leaving the
  % default 'loose' border unless a 'tight' border was requested.
  fig = ancestor(ax, 'figure');
  if isempty(fig) || (rows <= 0) || (cols <= 0)
    return
  end
  % Border metrics of the default 'loose' layout (left/bottom offsets and the
  % total margins added to the image to obtain the figure size), plus a minimum
  % figure size. A 'tight' border wraps the figure exactly around the image.
  if borderTight
    leftMargin = 0;
    bottomMargin = 0;
    horizontalMargin = 0;
    verticalMargin = 0;
    minWidth = 1;
    minHeight = 1;
  else
    leftMargin = 84.4;
    bottomMargin = 58.33;
    horizontalMargin = 168;
    verticalMargin = 81;
    minWidth = 128;
    minHeight = 128;
  end
  displayWidth = cols * magFraction;
  displayHeight = rows * magFraction;
  % Reduce the magnification when the image cannot fit on screen at the
  % requested size (the default 100% otherwise upscales huge images off-screen).
  screenSize = groot().ScreenSize;
  if (numel(screenSize) == 4 && screenSize(3) > 1 && screenSize(4) > 1)
    availableWidth = screenSize(3) * 0.69 - horizontalMargin;
    availableHeight = screenSize(4) * 0.69 - verticalMargin;
    if ((displayWidth > availableWidth) || (displayHeight > availableHeight)) ...
        && (availableWidth > 0) && (availableHeight > 0)
      fitScale = min(availableWidth / cols, availableHeight / rows);
      if (fitScale < magFraction)
        displayWidth = cols * fitScale;
        displayHeight = rows * fitScale;
      end
    end
  end
  figureWidth = max(displayWidth + horizontalMargin, minWidth);
  figureHeight = max(displayHeight + verticalMargin, minHeight);
  figurePosition = fig.Position;
  set(fig, 'Position', [figurePosition(1), figurePosition(2), figureWidth, figureHeight]);
  set(ax, 'Units', 'pixels');
  set(ax, 'Position', [leftMargin, bottomMargin, displayWidth, displayHeight]);
  set(ax, 'Units', 'normalized');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function tf = ishold(varargin)
  narginchk(0, 1);
  if nargin == 1
    a = varargin{1};
  else
    a = gca();
  end
  tf = strcmp(a.NextPlot, 'add');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = isonormals(varargin)
  narginchk(2, 6);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [x, y, z, V, vertices, patchHandle, negate] = parseIsonormalsInputs(args);
  normals = computeIsonormals(x, y, z, V, vertices, negate);
  if nargout == 0
    if isempty(patchHandle)
      error('Nelson:isonormals:patchHandleExpectedWhen', 'Patch handle expected when no output argument is requested.');
    end
    patchHandle.VertexNormals = normals;
    patchHandle.VertexNormalsMode = 'manual';
  else
    varargout{1} = normals;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = isosurface(varargin)
  narginchk(1, 8);
  nargoutchk(0, 3);
  args = convertStringToCharArgs(varargin);
  [x, y, z, V, isovalue, colors, noshare, verbose] = parseIsosurfaceInputs(args);
  if isempty(isovalue)
    isovalue = automaticIsosurfaceLevel(V);
  end
  if verbose
    disp(_('Computing isosurface...'));
  end
  if isempty(isovalue)
    faces = zeros(0, 3);
    vertices = zeros(0, 3);
    cdata = [];
    normals = zeros(0, 3);
  else
    [faces, vertices, cdata, normals] = __isosurface__(x, y, z, V, isovalue, colors, noshare);
  end
  if nargout == 0
    renderIsosurface(faces, vertices, cdata, normals, isovalue, x, y, z);
  elseif nargout == 1
    varargout{1} = isosurfaceStruct(faces, vertices, cdata);
  else
    varargout{1} = faces;
    varargout{2} = vertices;
    if nargout == 3
      varargout{3} = cdata;
    end
  end
end
%=============================================================================
function renderIsosurface(faces, vertices, cdata, normals, isovalue, x, y, z)
  ax = newplot();
  if isempty(cdata)
    colorLimit = isosurfaceColorLimit(isovalue);
    ax.CLim = [0, colorLimit];
    faceVertexCData = repmat(isosurfaceLevelColor(ax, isovalue, colorLimit), size(vertices, 1), 1);
  else
    faceVertexCData = cdata;
  end
  p = patch(ax, 'Faces', faces, 'Vertices', vertices, 'FaceVertexCData', faceVertexCData, ...
    'FaceColor', 'flat', 'FaceLighting', 'gouraud', 'EdgeColor', 'none', 'UserData', isovalue);
  if ~isempty(normals)
    p.VertexNormals = normals;
    p.VertexNormalsMode = 'manual';
  end
  applyIsosurfaceAxes(ax, x, y, z, isovalue);
end
%=============================================================================
function applyIsosurfaceAxes(ax, x, y, z, isovalue)
  ax.XLim = [min(x), max(x)];
  ax.YLim = [min(y), max(y)];
  ax.ZLim = [min(z), max(z)];
  ax.CLim = [0, isosurfaceColorLimit(isovalue)];
  view(ax, 3);
  camlight(ax);
end
%=============================================================================
function colorLimit = isosurfaceColorLimit(isovalue)
  colorLimit = 2 * max(abs(isovalue), eps());
end
%=============================================================================
function color = isosurfaceLevelColor(ax, isovalue, colorLimit)
  colors = colormap(ax);
  nbColors = size(colors, 1);
  index = ceil(isovalue ./ colorLimit .* nbColors);
  index = max(1, min(nbColors, index));
  color = colors(index, :);
end
%=============================================================================
function s = isosurfaceStruct(faces, vertices, cdata)
  s = struct('vertices', vertices, 'faces', faces);
  if ~isempty(cdata)
    s.facevertexcdata = cdata;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = light(varargin)
  nargoutchk(0, 1);
  inputArguments = convertStringToCharArgs(varargin);
  if ~isempty(inputArguments) && isscalar(inputArguments{1}) && isgraphics(inputArguments{1}, 'axes')
    ax = inputArguments{1};
    inputArguments = inputArguments(2:end);
  else
    ax = gca();
  end
  if rem(length(inputArguments), 2) ~= 0
    error('Nelson:graphics:invalidNameValueArguments', 'Invalid parameter/value pair arguments.');
  end
  h = __light__('Parent', ax, inputArguments{:});
  if nargout > 0
    varargout{1} = h;
  end
end
