function varargout = pow2db(varargin)
  narginchk(1, 1);
  nargoutchk(0, 1);
  if (any(varargin{1} < 0))
    error('Nelson:validators:mustBeNonnegative', '%s must be nonnegative.', 'Input argument value');
  end
  varargout{1} = 10 .* log10(varargin{1});
end
%=============================================================================
