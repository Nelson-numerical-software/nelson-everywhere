%=============================================================================
function st = timetableApplyVariableProperties(st, props)
  % Copies the per-variable metadata of a validated timetable Properties
  % struct into its table storage st, whose data is already renamed.
  st.Properties.VariableNames = props.VariableNames;
  st.Properties.VariableDescriptions = props.VariableDescriptions;
  st.Properties.VariableUnits = props.VariableUnits;
  st.Properties.VariableContinuity = props.VariableContinuity;
  st.Properties.CustomProperties = props.CustomProperties;
  st = struct(table.fromStruct(st));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function value = timetableAssignedProperties(current, value)
  % Properties value assigned to a timetable: a new Events value is checked
  % against the timetable row times. The other fields are checked by the
  % Properties setter.
  if isstruct(value) && isscalar(value) && isfield(value, 'Events') ...
      && ~(strcmp(class(value.Events), class(current.Events)) && isequal(value.Events, current.Events))
    value.Events = timetableCheckedEvents(value.Events, current.RowTimes);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function events = timetableCheckedEvents(events, rowTimes)
  % Value stored in the Events property of a timetable with these row
  % times: [], or an event table whose row times have the same type. Event
  % times and timetables are converted with eventtable; 0x0 event times
  % remove the events like [].
  isTimes = isa(events, 'datetime') || isa(events, 'duration');
  if (isa(events, 'double') || isTimes) && isequal(size(events), [0 0])
    events = [];
    return
  end
  if isTimes
    eventTimes = events;
  elseif istimetable(events)
    st = struct(events);
    eventTimes = st.Properties.RowTimes;
  else
    error('Nelson:timetable:InvalidEvents', _('Events property must be an event table.'));
  end
  if ~strcmp(class(eventTimes), class(rowTimes))
    error('Nelson:timetable:InvalidEventsIncompatibleType', _('The attached event table''s row times must be the same data type as the corresponding timetable''s row times.'));
  end
  if ~isa(events, 'eventtable')
    events = eventtable(events);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function st = timetableCreateTableStorage(varargin)
  st = struct();
  st.data = struct();
  st.Version = 2;
  st.VariableCustomProperties = {};
  st.Properties = defaultTableProperties();
  if nargin == 0
    return
  end

  if ischar(varargin{1}) && strcmpi(varargin{1}, 'Size')
    if nargin < 4 || ~ischar(varargin{3}) || ~strcmpi(varargin{3}, 'VariableTypes')
      error('Nelson:timetable:invalidSyntax:sizeVariableTypesSpecifiedTogether', 'Size and VariableTypes must be specified together.');
    end
    sz = varargin{2};
    variableTypes = toCellstrRow(varargin{4});
    nRows = sz(1);
    nVars = sz(2);
    variableNames = cell(1, nVars);
    for k = 1:nVars
      variableNames{k} = ['Var', num2str(k)];
      st.data.(variableNames{k}) = initialValue(nRows, variableTypes{k});
    end
    st.Properties.VariableNames = variableNames;
    st.Properties.VariableTypes = string(variableTypes);
    return
  end

  variableNames = cell(1, nargin);
  for k = 1:nargin
    variableNames{k} = ['Var', num2str(k)];
    st.data.(variableNames{k}) = varargin{k};
  end
  st.Properties.VariableNames = variableNames;
end

function props = defaultTableProperties()
  props = struct();
  props.DimensionNames = {'Row', 'Variables'};
  props.Description = '';
  props.UserData = [];
  props.VariableNames = {};
  props.VariableTypes = string([]);
  props.VariableDescriptions = {};
  props.VariableUnits = {};
  props.VariableContinuity = [];
  props.RowNames = {};
  props.CustomProperties = struct();
end

function names = toCellstrRow(names)
  if isempty(names)
    names = {};
  elseif isstring(names)
    names = cellstr(names);
  elseif ischar(names)
    names = {names};
  end
  names = names(:)';
end

function value = initialValue(nRows, typeName)
  switch lower(typeName)
    case {'double', 'doublenan'}
      value = zeros(nRows, 1);
      if contains(lower(typeName), 'nan')
        value(:) = NaN;
      end
    case 'single'
      value = single(zeros(nRows, 1));
    case 'logical'
      value = false(nRows, 1);
    case 'string'
      value = strings(nRows, 1);
    case {'cell', 'cellstr', 'char'}
      value = cell(nRows, 1);
      for k = 1:nRows
        value{k} = '';
      end
    case 'int8'
      value = int8(zeros(nRows, 1));
    case 'int16'
      value = int16(zeros(nRows, 1));
    case 'int32'
      value = int32(zeros(nRows, 1));
    case 'int64'
      value = int64(zeros(nRows, 1));
    case 'uint8'
      value = uint8(zeros(nRows, 1));
    case 'uint16'
      value = uint16(zeros(nRows, 1));
    case 'uint32'
      value = uint32(zeros(nRows, 1));
    case 'uint64'
      value = uint64(zeros(nRows, 1));
    otherwise
      error('Nelson:timetable:unsupportedVariableType', 'Unsupported variable type: %s', typeName);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function text = timetableDurationCellText(value)
  % Display text of one duration row time.
  secondsValue = seconds(value);
  switch lower(value.Format)
    case 's'
      text = [num2str(secondsValue), ' sec'];
    case 'm'
      text = [num2str(secondsValue ./ 60), ' min'];
    case 'h'
      text = [num2str(secondsValue ./ 3600), ' hr'];
    case 'd'
      text = [num2str(secondsValue ./ 86400), ' days'];
    case 'y'
      text = [num2str(secondsValue ./ (86400 * 365.2425)), ' years'];
    otherwise
      text = char(string(value));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function strs = timetableEventColumn(strs, events, rowTimes)
  % Display texts of a timetable with its event table: an unlabelled first
  % column shows, on each row, the label of the event happening at its row
  % time, "<k events>" when several events match it and "<1 event>" when
  % the event has no label. The row times stay left-aligned under their
  % header.
  if ~isa(events, 'eventtable') || size(strs, 1) < 2
    return
  end
  width = max(strlength(strs(:, 1)));
  strs(2:end, 1) = pad(strs(2:end, 1), width, 'right');
  props = subsref(events, struct('type', '.', 'subs', 'Properties'));
  [rows, eventRows] = timetableEventMatches(rowTimes, props.RowTimes, timetableEventEnds(events));
  matched = eventRows > 0;
  counts = accumarray(rows(matched), 1, [numel(rowTimes), 1]);
  labels = strings(numel(rowTimes), 1);
  labels(counts > 1) = "<" + string(counts(counts > 1)) + " events>";
  texts = labelTexts(events);
  single = find(counts == 1);
  [~, where] = ismember(single, rows(matched));
  eventOfRow = eventRows(matched);
  labels(single) = texts(eventOfRow(where));
  strs = [[""; labels], strs];
end
%=============================================================================
function texts = labelTexts(events)
  % Text of each event label, "<1 event>" for a missing or empty label.
  name = eventtable.variables(events).EventLabelsVariable;
  n = height(events);
  if isempty(name)
    texts = repmat("<1 event>", n, 1);
    return
  end
  values = subsref(events, struct('type', '.', 'subs', name));
  texts = strings(n, 1);
  for k = 1:n
    value = values(k, :);
    if iscell(value)
      value = value{1};
    end
    if isnumeric(value) && isnan(value)
      text = "";
    elseif isnumeric(value)
      text = string(num2str(value));
    else
      text = string(value);
    end
    if ismissing(text) || strlength(text) == 0
      text = "<1 event>";
    end
    texts(k) = text;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function ends = timetableEventEnds(events)
  % End times of the events of an event table, [] when the events are
  % instantaneous.
  eventVars = eventtable.variables(events);
  ends = [];
  if ~isempty(eventVars.EventLengthsVariable)
    props = subsref(events, struct('type', '.', 'subs', 'Properties'));
    ends = props.RowTimes + subsref(events, struct('type', '.', 'subs', eventVars.EventLengthsVariable));
  elseif ~isempty(eventVars.EventEndsVariable)
    ends = subsref(events, struct('type', '.', 'subs', eventVars.EventEndsVariable));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [rows, eventRows] = timetableEventMatches(rowTimes, eventTimes, eventEnds)
  % Pairs (timetable row, event table row) of the events happening at each
  % row time, in row order then event order. A row without event is paired
  % with 0. An event without end matches the rows at its time, an event
  % with an end the rows in [time, end).
  t = timeNumbers(rowTimes);
  s = timeNumbers(eventTimes);
  hasEnds = ~isempty(eventEnds);
  if hasEnds
    e = timeNumbers(eventEnds);
  end
  matchedRows = cell(numel(s), 1);
  matchedEvents = cell(numel(s), 1);
  for k = 1:numel(s)
    if hasEnds
      found = find(t >= s(k) & t < e(k));
    else
      found = find(t == s(k));
    end
    matchedRows{k} = found(:);
    matchedEvents{k} = k * ones(numel(found), 1);
  end
  rows = vertcat(zeros(0, 1), matchedRows{:});
  eventRows = vertcat(zeros(0, 1), matchedEvents{:});
  alone = true(numel(t), 1);
  alone(rows) = false;
  rows = [rows; find(alone)];
  eventRows = [eventRows; zeros(nnz(alone), 1)];
  [~, order] = sort(rows * (numel(s) + 1) + eventRows);
  rows = rows(order);
  eventRows = eventRows(order);
end
%=============================================================================
function x = timeNumbers(times)
  if isa(times, 'datetime')
    x = datenum(times(:));
  else
    x = seconds(times(:));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function rowTimes = timetableGrowRowTimes(rowTimes, newHeight, newTimes)
  % Row times of a timetable grown to newHeight rows by an assignment: the
  % times given in the row subscript (newTimes), then missing times (NaN
  % for durations, NaT for datetimes).
  nRows = timeCount(rowTimes);
  if newHeight <= nRows
    return
  end
  if nargin > 2 && timeCount(newTimes) > 0
    rowTimes = [rowTimes; newTimes];
    nRows = nRows + timeCount(newTimes);
  end
  if newHeight > nRows
    rowTimes(nRows + 1:newHeight, 1) = missing;
  end
end
%=============================================================================
function n = timeCount(value)
  if isa(value, 'datetime')
    n = numel(datenum(value));
  else
    n = numel(seconds(value));
  end
end
