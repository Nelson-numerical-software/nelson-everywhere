% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function polarEndDrawLater(fig, previousDrawLater)
  if ~isempty(fig) && isgraphics(fig, 'figure') && strcmp(previousDrawLater, 'off')
    fig.DrawLater = 'off';
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
