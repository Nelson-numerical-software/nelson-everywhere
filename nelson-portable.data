function option = validateMissingOption(option)
  if nargin == 0 || isempty(option)
    option = 'auto';
    return
  end
  if isstring(option)
    option = char(option);
  end
  if ~ischar(option)
    error('Nelson:categorical:missingOptionMustBeText', '%s must be text.', 'Missing option');
  end
end
