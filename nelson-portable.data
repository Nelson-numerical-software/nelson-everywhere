function addOptional(obj, name, defaultValue, validator)
  narginchk(3, 4);
  if nargin < 4
    validator = [];
  end
  if ~(isempty(validator) || isa(validator, 'function_handle'))
    error('Nelson:inputParser:validatorAFunctionHandleEmpty4', 'Validator must be a function handle or empty.');
  end
  inputParser.addSchema(obj, 'optional', name, defaultValue, validator);
end
