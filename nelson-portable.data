function obj = tscollectionRefreshMetadata(obj)
  if isa(obj.TimeInfo, 'tsdata.timemetadata')
    obj.TimeInfo = setTime(obj.TimeInfo, obj.Time_);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function scale = tscollectionUnitDays(units)
  switch lower(units)
    case {'second', 'seconds', 'sec', 'secs'}
      scale = 1 / 86400;
    case {'minute', 'minutes', 'min', 'mins'}
      scale = 1 / 1440;
    case {'hour', 'hours', 'hr', 'hrs'}
      scale = 1 / 24;
    case {'day', 'days'}
      scale = 1;
    otherwise
      scale = 1 / 86400;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function name = tscollectionValidName(name)
  if isempty(name)
    name = 'series';
  end
  chars = char(name);
  for k = 1:length(chars)
    ok = (chars(k) >= 'a' && chars(k) <= 'z') ...
      || (chars(k) >= 'A' && chars(k) <= 'Z') ...
      || (chars(k) >= '0' && chars(k) <= '9') ...
      || chars(k) == '_';
    if ~ok
      chars(k) = '_';
    end
  end
  if ~((chars(1) >= 'a' && chars(1) <= 'z') || (chars(1) >= 'A' && chars(1) <= 'Z'))
    chars = ['x', chars];
  end
  name = chars;
end
