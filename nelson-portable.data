% LICENCE_BLOCK_END
%=============================================================================
function varargout = size(A, varargin)
  if nargin == 1
    if nargout <= 1
      varargout{1} = size(A.codes);
    else
      [varargout{1:nargout}] = size(A.codes);
    end
  else
    varargout{1} = size(A.codes, varargin{1});
  end
end
