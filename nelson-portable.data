function names = optimSupportedOptions()
  names = {'AbsoluteGapTolerance'; 'Algorithm'; 'BarrierParamUpdate'; 'CheckGradients'; 'ConstraintTolerance'; 'Diagnostics'; ...
    'CutGeneration'; 'DiffMaxChange'; 'DiffMinChange'; 'Display'; 'FiniteDifferenceStepSize'; ...
    'FiniteDifferenceType'; 'FunValCheck'; 'FunctionTolerance'; 'GradConstr'; ...
    'GradObj'; 'Hessian'; 'HessianApproximation'; 'HessianFcn'; 'HessianMultiplyFcn'; ...
    'HessFcn'; 'HessMult'; 'HessPattern'; 'HessUpdate'; 'HonorBounds'; ...
    'Heuristics'; 'InitBarrierParam'; 'InitDamping'; 'InitTrustRegionRadius'; 'IntegerTolerance'; ...
    'Jacobian'; 'JacobMult'; 'JacobPattern'; 'LargeScale'; 'LPMaxIterations'; ...
    'LPOptimalityTolerance'; 'LPPreprocess'; 'MaxFeasiblePoints'; 'MaxFunEvals'; ...
    'MaxFunctionEvaluations'; 'MaxIter'; 'MaxIterations'; 'MaxNodes'; ...
    'MaxNumFeasPoints'; 'MaxPCGIter'; 'MaxProjCGIter'; 'MaxSQPIter'; 'MaxTime'; 'NodeSelection'; ...
    'ObjectiveImprovementThreshold'; 'ObjectiveLimit'; 'OptimalityTolerance'; ...
    'OutputFcn'; 'PlotFcn'; 'PlotFcns'; 'PrecondBandWidth'; 'RelativeGapTolerance'; 'RootLPAlgorithm'; ...
    'RelLineSrchBnd'; 'RelLineSrchBndDuration'; 'ScaleProblem'; ...
    'SpecifyConstraintGradient'; 'SpecifyObjectiveGradient'; 'StepTolerance'; ...
    'SubproblemAlgorithm'; 'TolCon'; 'TolFun'; 'TolGapAbs'; 'TolGapRel'; ...
    'TolInteger'; 'TolPCG'; 'TolProjCG'; 'TolProjCGAbs'; 'TolX'; 'TypicalX'; ...
    'UseCodegenSolver'; 'UseParallel'};
  names = names(:);
end
