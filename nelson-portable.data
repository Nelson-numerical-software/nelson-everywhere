% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function status = odeOutputPlot(kind, t, y, flag)
  persistent states
  status = 0;
  if isempty(states)
    states = struct();
  end
  if isstring(flag)
    flag = char(flag);
  end
  state = odeOutputPlotGetState(states, kind);
  switch flag
    case 'init'
      state = odeOutputPlotInitialState(kind, t, y);
      states.(kind) = state;
    case 'done'
      odeOutputPlotFlush(kind, state);
      states.(kind) = state;
      drawnow();
    case ''
      if isempty(t) || isempty(y)
        return
      end
      state = odeOutputPlotAppend(kind, state, t, y);
      states.(kind) = state;
    otherwise
      error('Nelson:ode_solvers:unknownOutputCallbackFlag', 'Unknown output callback flag.');
  end
end
%=============================================================================
function state = odeOutputPlotEmptyState()
  state = struct('XData', [], 'YData', [], 'ZData', [], 'Handles', [], 'DrawCount', 0);
end
%=============================================================================
function state = odeOutputPlotGetState(states, kind)
  if isfield(states, kind)
    state = states.(kind);
  else
    state = odeOutputPlotEmptyState();
  end
end
%=============================================================================
function state = odeOutputPlotInitialState(kind, t, y)
  state = odeOutputPlotGetReusableState(kind);
  existingXData = state.XData;
  state = odeOutputPlotAppend(kind, state, t(1), y);
  if strcmp(kind, 'time') && length(t) >= 2
    bounds = [min([existingXData(:); t(:)]) max([existingXData(:); t(:)])];
    if bounds(1) ~= bounds(2)
      xlim(bounds);
    end
  end
end
%=============================================================================
function state = odeOutputPlotGetReusableState(kind)
  state = odeOutputPlotEmptyState();
  ax = gca();
  if ishold() && strcmp(kind, 'time')
    children = ax.Children;
    for k = 1:numel(children)
      child = children(k);
      if strcmp(child.Type, 'line') && strcmp(child.Tag, 'odeOutputPlot')
        state.XData = child.XData;
        state.YData = child.YData;
        state.Handles = {child};
        state.DrawCount = 0;
        return
      end
    end
  end
end
%=============================================================================
function state = odeOutputPlotAppend(kind, state, t, y)
  [newX, newY, newZ] = odeOutputPlotData(kind, t, y);
  state.XData = [state.XData newX];
  state.YData = [state.YData newY];
  state.ZData = [state.ZData newZ];
  if isempty(state.Handles) || ~odeOutputPlotHandlesValid(state.Handles)
    state.Handles = odeOutputPlotCreate(kind, state);
    state.DrawCount = 0;
  else
    state.DrawCount = state.DrawCount + 1;
    if odeOutputPlotShouldDraw(state)
      odeOutputPlotUpdate(kind, state);
      state.DrawCount = 0;
    end
  end
end
%=============================================================================
function tf = odeOutputPlotShouldDraw(state)
  tf = length(state.XData) <= 16 || state.DrawCount >= 250;
end
%=============================================================================
function odeOutputPlotFlush(kind, state)
  if isempty(state.Handles) || ~odeOutputPlotHandlesValid(state.Handles)
    return
  end
  odeOutputPlotUpdate(kind, state);
end
%=============================================================================
function [x, y, z] = odeOutputPlotData(kind, t, y)
  z = [];
  t = t(:).';
  y = odeOutputPlotNormalizeSolution(t, y);
  switch kind
    case 'time'
      x = t;
    case 'phase2'
      odeOutputPlotCheckComponents(y, 2);
      x = y(1, :);
      y = y(2, :);
    case 'phase3'
      odeOutputPlotCheckComponents(y, 3);
      x = y(1, :);
      z = y(3, :);
      y = y(2, :);
    otherwise
      error('Nelson:ode_solvers:unknownOutputPlotType', 'Unknown output plot type.');
  end
end
%=============================================================================
function y = odeOutputPlotNormalizeSolution(t, y)
  if isvector(y)
    y = y(:);
  end
  if size(y, 2) ~= length(t)
    if size(y, 1) == length(t)
      y = y.';
    elseif length(t) ~= 1
      error('Nelson:ode_solvers:incompatibleTimeSolutionSizes', 'Incompatible time and solution sizes.');
    end
  end
end
%=============================================================================
function odeOutputPlotCheckComponents(y, n)
  if size(y, 1) < n
    error('Nelson:ode_solvers:notEnoughSolutionComponents', 'Not enough solution components.');
  end
end
%=============================================================================
function handles = odeOutputPlotCreate(kind, state)
  ax = gca();
  switch kind
    case 'time'
      handles = odeOutputPlotCreateTimeLines(ax, state.XData, state.YData);
      xlabel(_('Time'));
      ylabel(_('Solution'));
    case 'phase2'
      handles = line('XData', state.XData, 'YData', state.YData, 'Parent', ax);
      handles.Tag = 'odeOutputPlot';
      xlabel('y(1)');
      ylabel('y(2)');
    case 'phase3'
      handles = line('XData', state.XData, 'YData', state.YData, ...
        'ZData', state.ZData, 'Parent', ax);
      handles.Tag = 'odeOutputPlot';
      xlabel('y(1)');
      ylabel('y(2)');
      zlabel('y(3)');
      view(3);
  end
end
%=============================================================================
function handles = odeOutputPlotCreateTimeLines(ax, x, y)
  handles = cell(size(y, 1), 1);
  wasHold = ishold();
  for k = 1:size(y, 1)
    handles{k} = line('XData', x, 'YData', y(k, :), 'Parent', ax);
    handles{k}.Tag = 'odeOutputPlot';
    hold on
  end
  if ~wasHold
    hold off
  end
end
%=============================================================================
function tf = odeOutputPlotHandlesValid(handles)
  if iscell(handles)
    tf = ~isempty(handles);
    for k = 1:length(handles)
      tf = tf && ishandle(handles{k});
    end
  else
    tf = ~isempty(handles) && ishandle(handles);
  end
end
%=============================================================================
function odeOutputPlotUpdate(kind, state)
  switch kind
    case 'time'
      for k = 1:length(state.Handles)
        state.Handles{k}.XData = state.XData;
        state.Handles{k}.YData = state.YData(k, :);
      end
    case 'phase2'
      state.Handles.XData = state.XData;
      state.Handles.YData = state.YData;
    case 'phase3'
      state.Handles.XData = state.XData;
      state.Handles.YData = state.YData;
      state.Handles.ZData = state.ZData;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function problem = odePrepareProblem(solver, odefun, tspan, y0, yp0, options)
  if ischar(odefun) || isStringScalar(odefun)
    odefun = odeLegacyTextFunction(str2func(char(odefun)), solver);
  end
  if ~isa(odefun, 'function_handle')
    error('Nelson:ode_solvers:functionHandleExpected', '%s must be a function handle.', 'Value');
  end
  if ~isnumeric(tspan) || numel(tspan) < 2
    error('Nelson:ode_solvers:timeSpanContainLeastTwoValues', 'Time span must contain at least two values.');
  end
  if ~isvector(tspan) || any(~isfinite(tspan(:))) || ~odeIsStrictlyMonotone(tspan(:).')
    error('Nelson:ode_solvers:timeSpanEntriesStrictlyIncreaseDecrease', 'Time span entries must strictly increase or decrease.');
  end
  tspan = tspan(:).';
  odeValidateVector(y0, 'InitialValue');
  if nargin < 6 || isempty(options)
    options = odeDefaultOptions();
  elseif odeIsSolverOptions(options)
    options = struct(options);
  end
  parameters = [];
  eventDefinitionObject = [];
  if isstruct(options) && isfield(options, 'Parameters')
    parameters = options.Parameters;
    options = rmfield(options, 'Parameters');
  end
  if isstruct(options) && isfield(options, 'EventDefinitionObject')
    eventDefinitionObject = options.EventDefinitionObject;
    options = rmfield(options, 'EventDefinitionObject');
  end
  options = odeMergeOptions(odeDefaultOptions(), options);
  options.Parameters = parameters;
  options = odeApplyDefaults(options, tspan, y0, solver);
  if ~isempty(eventDefinitionObject)
    options.EventDefinitionObject = eventDefinitionObject;
  end
  tfinal = tspan(length(tspan));
  problem.solver = solver;
  problem.odefun = odefun;
  problem.t0 = tspan(1);
  problem.tfinal = tfinal;
  problem.tspan = tspan;
  problem.y0 = y0(:);
  problem.yp0 = yp0;
  problem.options = options;
  problem.direction = sign(problem.tfinal - problem.t0);
  problem.errorExponent = odeErrorExponent(solver);
  if problem.direction == 0
    error('Nelson:ode_solvers:timeSpanEndpointsDistinct', 'Time span endpoints must be distinct.');
  end
end
%=============================================================================
function fcn = odeLegacyTextFunction(originalFcn, solver)
  isImplicit = strcmp(solver, 'ode15i');
  fcn = @(t, y, varargin) odeCallLegacyTextFunction(originalFcn, isImplicit, t, y, varargin{:});
end
%=============================================================================
function varargout = odeCallLegacyTextFunction(originalFcn, isImplicit, t, y, varargin)
  if isImplicit
    args = [{t, y, varargin{1}, []}, varargin(2:end)];
  else
    args = [{t, y, []}, varargin];
  end
  if nargout == 0
    feval(originalFcn, args{:});
  else
    [varargout{1:nargout}] = feval(originalFcn, args{:});
  end
end
%=============================================================================
function tf = odeIsStrictlyMonotone(tspan)
  delta = diff(tspan);
  tf = all(delta > 0) || all(delta < 0);
end
%=============================================================================
function exponent = odeErrorExponent(solver)
  if strcmp(solver, 'ode23')
    exponent = -1 / 3;
  elseif strcmp(solver, 'ode113')
    exponent = -1 / 4;
  elseif strcmp(solver, 'ode78')
    exponent = -1 / 7;
  elseif strcmp(solver, 'ode89')
    exponent = -1 / 8;
  elseif strcmp(solver, 'ode15s') || strcmp(solver, 'ode23tb')
    exponent = -1 / 3;
  elseif strcmp(solver, 'ode23s') || strcmp(solver, 'ode23t')
    exponent = -1 / 2;
  else
    exponent = -1 / 5;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function gradient = odeProjectedAdjointGradient(sol, sensitivity, parameters, indices)
  n = size(sol.y, 1);
  p = length(indices);
  gradient = zeros(p, 1);
  if ~isempty(sensitivity.ObjectiveFcn)
    tfinal = sol.x(length(sol.x));
    yfinal = sol.y(:, length(sol.x));
    sfinal = reshape(sol.sensitivity(:, :, length(sol.x)), n, p);
    base = odeAdjointScalar(sensitivity.ObjectiveFcn, tfinal, yfinal, parameters);
    gradient = gradient + odeAdjointParameterGradient(...
      sensitivity.ObjectiveFcn, tfinal, yfinal, parameters, indices, base);
    gradient = gradient + sfinal.' * odeAdjointStateGradient(...
      sensitivity.ObjectiveFcn, tfinal, yfinal, parameters, base);
  end
  if ~isempty(sensitivity.QuadratureFcn)
    gradient = gradient + odeAdjointQuadratureProjectedGradient(...
      sol, sensitivity.QuadratureFcn, parameters, indices);
  end
end
%=============================================================================
function gradient = odeAdjointQuadratureProjectedGradient(sol, fcn, parameters, indices)
  p = length(indices);
  integrand = zeros(p, length(sol.x));
  for k = 1:length(sol.x)
    y = sol.y(:, k);
    s = sol.sensitivity(:, :, k);
    base = odeAdjointScalar(fcn, sol.x(k), y, parameters);
    integrand(:, k) = odeAdjointParameterGradient(fcn, sol.x(k), y, parameters, indices, base) ...
      + s.' * odeAdjointStateGradient(fcn, sol.x(k), y, parameters, base);
  end
  gradient = zeros(p, 1);
  for k = 1:length(sol.x) - 1
    dt = sol.x(k + 1) - sol.x(k);
    gradient = gradient + 0.5 * dt * (integrand(:, k) + integrand(:, k + 1));
  end
end
%=============================================================================
function value = odeAdjointScalar(fcn, t, y, parameters)
  value = feval(fcn, t, y, parameters);
  if ~isnumeric(value) || ~isreal(value) || ~isscalar(value)
    error('Nelson:ode_solvers:adjointScalarFunctionReturnRealScalar', 'Adjoint scalar function must return a real scalar.');
  end
end
%=============================================================================
function gradient = odeAdjointStateGradient(fcn, t, y, parameters, base)
  gradient = zeros(length(y), 1);
  for k = 1:length(y)
    step = sqrt(eps) * max(1, abs(y(k)));
    trial = y;
    trial(k) = trial(k) + step;
    gradient(k) = (odeAdjointScalar(fcn, t, trial, parameters) - base) / step;
  end
end
%=============================================================================
function gradient = odeAdjointParameterGradient(fcn, t, y, parameters, indices, base)
  gradient = zeros(length(indices), 1);
  for k = 1:length(indices)
    idx = indices(k);
    step = sqrt(eps) * max(1, abs(parameters(idx)));
    trial = parameters;
    trial(idx) = trial(idx) + step;
    gradient(k) = (odeAdjointScalar(fcn, t, y, trial) - base) / step;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% After a rejected step the variable-order BDF kernel drops the oldest
% history point, lowering the working order by one (down to BDF2). A sharp
% solution feature that keeps rejecting high-order steps is then attacked
% with a more robust low-order formula, and the order rebuilds naturally as
% steps are accepted again.
function solverState = odeReduceOrderOnFailure(problem, solverState)
  if ~strcmp(problem.solver, 'ode15s')
    return
  end
  if ~isfield(solverState, 'consecutiveRejections')
    solverState.consecutiveRejections = 0;
  end
  solverState.consecutiveRejections = solverState.consecutiveRejections + 1;
  % An isolated rejection is normal step-size calibration; only a repeated
  % failure at the same location indicates the high-order formula is
  % struggling (sharp feature) and warrants dropping an order.
  if solverState.consecutiveRejections < 2
    return
  end
  if ~isfield(solverState, 'historyValid') || ~solverState.historyValid
    return
  end
  if ~isfield(solverState, 't') || length(solverState.t) <= 3
    return
  end
  solverState.t = solverState.t(2:end);
  solverState.y = solverState.y(:, 2:end);
  solverState.slope = solverState.slope(:, 2:end);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function sol = odeResampleSolution(sol, tspan)
  if length(tspan) <= 2
    refine = sol.extdata.options.Refine;
    if isempty(refine) || refine <= 1
      return
    end
    tspan = odeRefinedTimeVector(sol.x, refine);
  else
    tspan = odeReachedTimeVector(sol.x, tspan);
  end
  if length(tspan) < 2
    return
  end
  internal = sol;
  values = zeros(size(sol.y, 1), length(tspan));
  slopes = values;
  internalSlopes = [];
  if isfield(sol, 'extdata') && isfield(sol.extdata, 'slopes')
    internalSlopes = sol.extdata.slopes;
  end
  [values, slopes] = odeDevalInterpolate(sol.x, sol.y, tspan(:).', internalSlopes);
  values = odeApplyResampledNonNegative(sol.extdata.options, values);
  sol.x = tspan(:).';
  sol.y = values;
  sol.extdata.internal = internal;
  sol.extdata.slopes = slopes;
end

function output = odeReachedTimeVector(x, tspan)
  direction = sign(x(length(x)) - x(1));
  if direction == 0
    output = x(1);
    return
  end
  finalTime = x(length(x));
  keep = direction * (finalTime - tspan) >= -eps * (1 + abs(finalTime));
  output = tspan(keep);
  if isempty(output) || abs(output(length(output)) - finalTime) > eps * (1 + abs(finalTime))
    output(end + 1) = finalTime;
  end
end

function refined = odeRefinedTimeVector(x, refine)
  refined = x(1);
  for k = 1:(length(x) - 1)
    for j = 1:refine
      refined(end + 1) = x(k) + (j / refine) * (x(k + 1) - x(k));
    end
  end
end

function values = odeApplyResampledNonNegative(options, values)
  idx = options.NonNegative;
  if isempty(idx)
    return
  end
  values(idx(:), :) = max(values(idx(:), :), 0);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function sol = odeRestoreComplexSolution(sol, restore)
  sol = odeRestoreComplexSolutionStruct(sol, restore.StateSize, restore.Options);
end
%=============================================================================
function sol = odeRestoreComplexSolutionStruct(sol, n, originalOptions)
  sol.y = odeRealToComplexRows(sol.y, n);
  if isfield(sol, 'ye')
    sol.ye = odeRealToComplexRows(sol.ye, n);
  end
  if isfield(sol, 'extdata')
    if isfield(sol.extdata, 'slopes')
      sol.extdata.slopes = odeRealToComplexRows(sol.extdata.slopes, n);
    end
    if isfield(sol.extdata, 'internal')
      sol.extdata.internal = odeRestoreComplexSolutionStruct(sol.extdata.internal, n, originalOptions);
    end
    sol.extdata.options = originalOptions;
  end
  if isfield(sol, 'idata')
    sol.idata.idxNonNegative = originalOptions.NonNegative;
  end
end
%=============================================================================
function y = odeRealToComplexRows(z, n)
  if isempty(z)
    y = zeros(n, 0);
  else
    y = z(1:n, :) + 1i * z((n + 1):(2 * n), :);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function dy = odeRhs(problem, t, y)
  if strcmp(problem.solver, 'ode15i')
    dy = odeImplicitSlope(problem, t, y);
  else
    dy = odeCallFcn(problem.odefun, t, y, problem.options);
  end
  if ~isempty(problem.options.Mass)
    mass = problem.options.Mass;
    if isa(mass, 'function_handle')
      mass = odeCallFcn(mass, t, y, problem.options);
    end
    dy = mass \ dy;
  end
  dy = dy(:);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [jac, evals] = odeRhsJacobian(problem, t, y, f0)
  evals = 0;
  jac = problem.options.Jacobian;
  if isempty(jac)
    [jac, evals] = odeFiniteDifferenceRhsJacobian(problem, t, y, f0);
    return
  end
  if isa(jac, 'function_handle')
    jac = odeCallFcn(jac, t, y, problem.options);
    evals = 1;
  end
  if ~isempty(problem.options.Mass)
    mass = problem.options.Mass;
    if isa(mass, 'function_handle')
      mass = odeCallFcn(mass, t, y, problem.options);
      evals = evals + 1;
    end
    jac = mass \ jac;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% Modified Rosenbrock (2,3) pair of Shampine and Reichelt (the ode23s
% formula). Second-order accurate, L-stable, with an embedded third-order
% error estimate. The right-hand side and Jacobian are already expressed in
% standard form y' = F(t, y) (the mass matrix, if any, is pre-applied by
% odeRhs / odeRhsJacobian).
function [yhigh, ylow, evals] = odeRosenbrock23Step(problem, t, y, h)
  d = 1 / (2 + sqrt(2));
  e32 = 6 + sqrt(2);
  n = length(y);
  f0 = odeRhs(problem, t, y);
  [jac, jacEvals] = odeRhsJacobian(problem, t, y, f0);
  [tder, tderEvals] = odeRosenbrockTimeDerivative(problem, t, y, f0);
  W = eye(n, n) - h * d * jac;
  k1 = W \ (f0 + h * d * tder);
  f1 = odeRhs(problem, t + 0.5 * h, y + 0.5 * h * k1);
  k2 = W \ (f1 - k1) + k1;
  yhigh = y + h * k2;
  f2 = odeRhs(problem, t + h, yhigh);
  k3 = W \ (f2 - e32 * (k2 - f1) - 2 * (k1 - f0) + h * d * tder);
  errorEstimate = (h / 6) * (k1 - 2 * k2 + k3);
  ylow = yhigh - errorEstimate;
  evals = 3 + tderEvals + jacEvals;
end
%=============================================================================
function [tder, evals] = odeRosenbrockTimeDerivative(problem, t, y, f0)
  % Finite-difference approximation of the partial derivative df/dt, needed
  % for non-autonomous problems. It vanishes for autonomous right-hand sides.
  delta = sqrt(eps) * max(1, abs(t));
  ft = odeRhs(problem, t + delta, y);
  tder = (ft - f0) / delta;
  evals = 1;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function sol = odeRunAdjointSensitivity(solver, odefun, tspan, y0, yp0, options, sensitivity)
  if ~odeIsSundialsSolver(solver)
    error('Nelson:ode_solvers:adjointSensitivitiesRequireSundialsSolver', 'Adjoint sensitivities require a SUNDIALS solver.');
  end
  if ~odeSundialsAvailable()
    error('Nelson:ode_solvers:sundialsBackendNotAvailable', 'SUNDIALS backend is not available.');
  end
  if ~isempty(options.Events)
    error('Nelson:ode_solvers:adjointEventsUnsupported', 'Adjoint sensitivities with events are not supported yet.');
  end
  if isempty(sensitivity.ObjectiveFcn) && isempty(sensitivity.QuadratureFcn)
    error('Nelson:ode_solvers:adjointSensitivitiesRequireObjectivefcnQuadraturefcn', 'Adjoint sensitivities require ObjectiveFcn or QuadratureFcn.');
  end
  if ~isempty(sensitivity.InitialValue) || ~isempty(sensitivity.InitialSlope)
    error('Nelson:ode_solvers:adjointSensitivitiesNotUseSensitivityInitial', 'Adjoint sensitivities do not use sensitivity initial conditions.');
  end
  if ~isempty(sensitivity.ObjectiveTime) ...
      && abs(sensitivity.ObjectiveTime - tspan(length(tspan))) > ...
      100 * eps * max(1, abs(tspan(length(tspan))))
    error('Nelson:ode_solvers:adjointFinalTimeOnly', 'Only final-time adjoint objectives are supported yet.');
  end
  parameters = options.Parameters(:);
  indices = odeAdjointParameterIndices(sensitivity, length(parameters));
  adjointData = struct();
  adjointData.Method = 'adjoint';
  adjointData.Parameters = parameters(:);
  adjointData.ParameterIndices = indices(:) - 1;
  adjointData.ObjectiveFcn = sensitivity.ObjectiveFcn;
  adjointData.QuadratureFcn = sensitivity.QuadratureFcn;
  adjointData.ObjectiveTime = sensitivity.ObjectiveTime;
  adjointData.RelativeTolerance = sensitivity.AdjointRelativeTolerance;
  adjointData.AbsoluteTolerance = sensitivity.AdjointAbsoluteTolerance;
  nativeOptions = options;
  nativeOptions.Sensitivity = adjointData;
  problem = odePrepareProblem(solver, odefun, tspan, y0, yp0, nativeOptions);
  sol = __ode_sundials_run__(problem);
  odeDisplayStats(problem, sol.stats);
end
function indices = odeAdjointParameterIndices(sensitivity, count)
  if isempty(sensitivity.ParameterIndices)
    indices = (1:count).';
  else
    indices = sensitivity.ParameterIndices(:);
  end
  if any(indices > count)
    error('Nelson:ode_solvers:parameterindicesExceedNumberParameters', 'ParameterIndices exceed the number of parameters.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function sol = odeRunDelaySensitivity(solver, odefun, tspan, y0, yp0, options, delay, sensitivity)
  odeValidateDelaySensitivity(options, sensitivity);
  if strcmp(sensitivity.Method, 'adjoint')
    sol = odeRunDelayProjectedAdjoint(solver, odefun, tspan, y0, yp0, options, delay, sensitivity);
    return
  end
  sol = odeRunDelayDirectSensitivity(solver, odefun, tspan, y0, yp0, options, delay, sensitivity);
end
%=============================================================================
function sol = odeRunDelayDirectSensitivity(solver, odefun, tspan, y0, yp0, options, delay, sensitivity)
  parameters = options.Parameters(:);
  indices = odeDelaySensitivityParameterIndices(sensitivity, length(parameters));
  baseSol = odeRunDelaySolver(solver, odefun, tspan, y0, yp0, options, delay);
  n = size(baseSol.y, 1);
  p = length(indices);
  s0 = odeDelaySensitivityInitialValue(sensitivity, n, p);
  values = zeros(n, p, length(baseSol.x));
  eventValues = odeDelaySensitivityEventStorage(baseSol, n, p);
  for k = 1:p
    idx = indices(k);
    step = sqrt(eps) * max(abs(parameters(idx)), 1);
    trialParameters = parameters;
    trialParameters(idx) = trialParameters(idx) + step;
    trialOptions = options;
    trialOptions.Parameters = trialParameters;
    trialY0 = y0(:) + step * s0(:, k);
    trialSol = odeRunDelaySolver(solver, odefun, tspan, trialY0, yp0, trialOptions, delay);
    values(:, k, :) = (odeDelaySensitivityValuesAt(trialSol, baseSol.x) - baseSol.y) / step;
    eventValues = odeDelaySensitivityEvents(eventValues, baseSol, trialSol, k, step);
  end
  sol = baseSol;
  sol.sensitivity = values;
  if ~isempty(eventValues)
    sol.eventSensitivity = eventValues;
  end
end
%=============================================================================
function sol = odeRunDelayProjectedAdjoint(solver, odefun, tspan, y0, yp0, options, delay, sensitivity)
  directSensitivity = sensitivity;
  directSensitivity.Method = 'direct';
  directSol = odeRunDelayDirectSensitivity(...
    solver, odefun, tspan, y0, yp0, options, delay, directSensitivity);
  parameters = options.Parameters(:);
  indices = odeDelaySensitivityParameterIndices(sensitivity, length(parameters));
  gradient = odeProjectedAdjointGradient(directSol, sensitivity, parameters, indices);
  sol = directSol;
  if isfield(sol, 'sensitivity')
    sol = rmfield(sol, 'sensitivity');
  end
  sol.adjointGradient = gradient(:).';
  sol.stats.sensitivityMethod = 'adjoint';
end
%=============================================================================
function odeValidateDelaySensitivity(options, sensitivity)
  if strcmp(sensitivity.Method, 'adjoint')
    if isempty(sensitivity.ObjectiveFcn) && isempty(sensitivity.QuadratureFcn)
      error('Nelson:ode_solvers:adjointSensitivitiesRequireObjectivefcnQuadraturefcn', 'Adjoint sensitivities require ObjectiveFcn or QuadratureFcn.');
    end
    if ~isempty(sensitivity.InitialValue) || ~isempty(sensitivity.InitialSlope)
      error('Nelson:ode_solvers:adjointSensitivitiesNotUseSensitivityInitial', 'Adjoint sensitivities do not use sensitivity initial conditions.');
    end
  end
  if ~isnumeric(options.Parameters) || ~isreal(options.Parameters) || ~isvector(options.Parameters)
    error('Nelson:ode_solvers:parametersNumericVectorPerformSensitivityAnalysis', 'Parameters must be a numeric vector to perform a sensitivity analysis.');
  end
  if ~isempty(options.OutputFcn)
    error('Nelson:ode_solvers:sensitivityEquationsDelayedOutputFunctions', 'Sensitivity equations with delayed output functions are not supported yet.');
  end
end
%=============================================================================
function indices = odeDelaySensitivityParameterIndices(sensitivity, count)
  if isempty(sensitivity.ParameterIndices)
    indices = (1:count).';
  else
    indices = sensitivity.ParameterIndices(:);
  end
  if any(indices > count)
    error('Nelson:ode_solvers:parameterindicesExceedNumberParameters', 'ParameterIndices exceed the number of parameters.');
  end
end
%=============================================================================
function s0 = odeDelaySensitivityInitialValue(sensitivity, n, p)
  if isempty(sensitivity.InitialValue)
    s0 = zeros(n, p);
  elseif isequal(size(sensitivity.InitialValue), [n p])
    s0 = sensitivity.InitialValue;
  elseif numel(sensitivity.InitialValue) == n * p
    s0 = reshape(sensitivity.InitialValue, n, p);
  else
    error('Nelson:ode_solvers:sensitivityInitialValueIncompatibleSize', 'Sensitivity initial value has incompatible size.');
  end
end
%=============================================================================
function values = odeDelaySensitivityValuesAt(sol, times)
  values = interp1(sol.x(:), sol.y.', times(:), 'linear').';
end
%=============================================================================
function eventValues = odeDelaySensitivityEventStorage(sol, n, p)
  if isfield(sol, 'ye')
    eventValues = zeros(n, p, size(sol.ye, 2));
  else
    eventValues = [];
  end
end
%=============================================================================
function eventValues = odeDelaySensitivityEvents(eventValues, baseSol, trialSol, k, step)
  if isempty(eventValues) || ~isfield(trialSol, 'ye') || ~isequal(size(baseSol.ye), size(trialSol.ye))
    return
  end
  eventValues(:, k, :) = (trialSol.ye - baseSol.ye) / step;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function sol = odeRunDelaySolver(solver, odefun, tspan, y0, yp0, options, delay)
  odeValidateDelayProblem(solver, options, delay);
  valueDelays = odeDelayInitialValues(delay.ValueDelay, tspan(1), y0(:), options);
  slopeDelays = odeDelayInitialValues(delay.SlopeDelay, tspan(1), y0(:), options);
  allDelays = [valueDelays; slopeDelays];
  direction = sign(tspan(length(tspan)) - tspan(1));
  t0 = tspan(1);
  tfinal = tspan(length(tspan));
  history = delay.History;
  previousTimes = t0;
  previousValues = y0(:);
  previousSlopes = odeDelayInitialSlope(y0(:), yp0);
  aggregate = [];
  chunkStart = t0;
  chunkIndex = 0;
  while direction * (tfinal - chunkStart) > 0
    chunkIndex = chunkIndex + 1;
    chunkLength = odeDelayChunkLength(delay, chunkStart, previousValues(:, end), ...
      options, allDelays, tfinal, direction);
    chunkEnd = chunkStart + direction * chunkLength;
    [chunkSol, chunkEnd] = odeDelaySolveChunkWithRetry(solver, odefun, tspan, chunkStart, ...
      chunkEnd, direction, previousTimes, previousValues, previousSlopes, t0, history, ...
      delay, options);
    aggregate = odeDelayMergeSolution(aggregate, chunkSol, chunkIndex);
    previousTimes = aggregate.x;
    previousValues = aggregate.y;
    previousSlopes = aggregate.extdata.slopes;
    chunkStart = aggregate.x(length(aggregate.x));
    if direction * (chunkEnd - chunkStart) > eps * (1 + abs(chunkEnd))
      break
    end
  end
  aggregate = odeDelayFinalizeSolution(aggregate, solver, options, yp0);
  problem = odePrepareProblem(solver, odefun, tspan, y0, yp0, options);
  odeDisplayStats(problem, aggregate.stats);
  sol = aggregate;
end
%=============================================================================
function chunkLength = odeDelayChunkLength(delay, t, y, options, fallbackDelays, tfinal, direction)
  try
    values = [odeDelayCurrentValues(delay.ValueDelay, t, y, options); ...
      odeDelayCurrentValues(delay.SlopeDelay, t, y, options)];
  catch
    values = fallbackDelays;
  end
  if isempty(values)
    values = fallbackDelays;
  end
  chunkLength = min(values(:));
  remaining = abs(tfinal - t);
  chunkLength = min(chunkLength, remaining);
  if ~(isfinite(chunkLength) && chunkLength > 0)
    error('Nelson:ode_solvers:delayEntriesPositive', 'Delay entries must be positive.');
  end
  chunkLength = max(chunkLength, eps * (1 + abs(t)) * max(1, abs(direction)));
end
%=============================================================================
function [chunkSol, chunkEnd] = odeDelaySolveChunkWithRetry(solver, odefun, tspan, chunkStart, ...
    chunkEnd, direction, previousTimes, previousValues, previousSlopes, t0, history, delay, options)
  for attempt = 1:24
    try
      chunkSol = odeDelaySolveChunk(solver, odefun, tspan, chunkStart, chunkEnd, direction, ...
        previousTimes, previousValues, previousSlopes, t0, history, delay, options);
      return
    catch
      ex = lasterror();
      if ~odeDelayCanRetryChunk(ex, chunkStart, chunkEnd)
        error(ex.message);
      end
      chunkEnd = chunkStart + 0.5 * (chunkEnd - chunkStart);
    end
  end
  error('Nelson:ode_solvers:stateDependentDelayRequiresKnownPast', 'State-dependent delay requires a known past state.');
end
%=============================================================================
function tf = odeDelayCanRetryChunk(ex, chunkStart, chunkEnd)
  message = ex.message;
  tf = contains(message, _('State-dependent delay requires a known past state.')) ...
    && abs(chunkEnd - chunkStart) > eps * (1 + abs(chunkStart));
end
%=============================================================================
function chunkSol = odeDelaySolveChunk(solver, odefun, tspan, chunkStart, chunkEnd, direction, ...
    previousTimes, previousValues, previousSlopes, t0, history, delay, options)
  chunkTspan = odeDelayChunkTimeSpan(tspan, chunkStart, chunkEnd, direction);
  chunkOptions = options;
  chunkOptions.Stats = 'off';
  chunkOptions.Parameters = [];
  chunkOptions = odeDelayWrapParameterizedOptions(...
    chunkOptions, options, previousTimes, previousValues, previousSlopes, t0, history, delay);
  if odeDelayUsesImplicitResidual(solver)
    wrappedFcn = @(t, y, yp) odeDelayResidual(...
      odefun, t, y, yp, previousTimes, previousValues, previousSlopes, t0, history, ...
      delay.ValueDelay, delay.SlopeDelay, options);
  else
    wrappedFcn = @(t, y) odeDelayRhs(...
      odefun, t, y, previousTimes, previousValues, previousSlopes, t0, history, ...
      delay.ValueDelay, delay.SlopeDelay, options);
  end
  chunkSol = odeDelayRunChunkSolver(...
    solver, wrappedFcn, chunkTspan, previousValues(:, end), previousSlopes(:, end), chunkOptions);
end
%=============================================================================
function sol = odeDelayRunChunkSolver(solver, odefun, tspan, y0, yp0, options)
  if strcmp(solver, 'autoswitch')
    error('Nelson:ode_solvers:delayEquationsNotSupportAutoswitchChunks', 'Delay equations do not support autoswitch chunks.');
  end
  problem = odePrepareProblem(solver, odefun, tspan, y0, yp0, options);
  if odeIsSundialsSolver(problem.solver)
    if ~odeSundialsAvailable()
      error('Nelson:ode_solvers:sundialsBackendNotAvailable', 'SUNDIALS backend is not available.');
    end
    sol = __ode_sundials_run__(problem);
    sol = odeDelayApplySundialsOutputFcn(problem, sol);
    return
  end
  [x, y, slopes, xe, ye, ie, stats] = odeIntegrate(problem);
  sol = odeBuildSolution(problem, x, y, slopes, xe, ye, ie, stats);
end
%=============================================================================
function sol = odeDelayApplySundialsOutputFcn(problem, sol)
  if isempty(problem.options.OutputFcn)
    return
  end
  stop = odeCallOutput(problem, problem.tspan, problem.y0, 'init');
  stopIndex = [];
  if stop
    stopIndex = 1;
  else
    for k = 2:length(sol.x)
      if odeCallOutput(problem, sol.x(k), sol.y(:, k), '')
        stopIndex = k;
        break
      end
    end
  end
  odeCallOutput(problem, [], [], 'done');
  if ~isempty(stopIndex)
    sol = odeDelayTrimSundialsSolution(sol, stopIndex, problem.direction);
  end
end
%=============================================================================
function sol = odeDelayTrimSundialsSolution(sol, stopIndex, direction)
  sol.x = sol.x(1:stopIndex);
  sol.y = sol.y(:, 1:stopIndex);
  if isfield(sol, 'yp')
    sol.yp = sol.yp(:, 1:stopIndex);
  end
  if isfield(sol, 'extdata') && isfield(sol.extdata, 'slopes')
    sol.extdata.slopes = sol.extdata.slopes(:, 1:stopIndex);
  end
  if isfield(sol, 'xe')
    if direction > 0
      keep = sol.xe <= sol.x(end);
    else
      keep = sol.xe >= sol.x(end);
    end
    sol.xe = sol.xe(keep);
    sol.ye = sol.ye(:, keep);
    sol.ie = sol.ie(keep);
  end
end
%=============================================================================
function chunkOptions = odeDelayWrapParameterizedOptions(...
    chunkOptions, options, times, values, slopes, t0, history, delay)
  if isfield(options, 'EventDefinitionObject')
    eventDefinition = options.EventDefinitionObject;
    chunkOptions = rmfield(chunkOptions, 'EventDefinitionObject');
    chunkOptions.Events = @(t, y) odeDelayEventObject(eventDefinition, t, y, options);
  elseif ~isempty(options.Events)
    eventFcn = options.Events;
    chunkOptions.Events = @(t, y) odeDelayEventFunction(...
      eventFcn, t, y, options, times, values, slopes, t0, history, delay);
  end
  if isa(options.Mass, 'function_handle')
    massFcn = options.Mass;
    chunkOptions.Mass = @(t, y) odeDelayMassFunction(massFcn, t, y, options);
  end
end
%=============================================================================
function [value, isterminal, direction] = odeDelayEventObject(eventDefinition, t, y, options)
  args = {eventDefinition, t, y};
  args = odeAppendParameters(args, options.Parameters);
  [value, isterminal, direction] = odeEvaluateEventObject(args{:});
end
%=============================================================================
function [value, isterminal, direction] = odeDelayEventFunction(...
    eventFcn, t, y, options, times, values, slopes, t0, history, delay)
  [z, zp] = odeDelayEventDelayedValues(t, y, times, values, slopes, t0, history, delay, options);
  ninputs = nargin(eventFcn);
  if ninputs == -1 || ninputs >= 4
    [value, isterminal, direction] = feval(eventFcn, t, y, z, zp);
  elseif ninputs == 3
    [value, isterminal, direction] = feval(eventFcn, t, y, z);
  else
    localOptions = options;
    [value, isterminal, direction] = odeCallFcn(eventFcn, t, y, localOptions);
  end
end
%=============================================================================
function [z, zp] = odeDelayEventDelayedValues(t, y, times, values, slopes, t0, history, delay, options)
  valueDelays = odeDelayCurrentValues(delay.ValueDelay, t, y, options);
  z = zeros(length(y(:)), length(valueDelays));
  for k = 1:length(valueDelays)
    delayedT = odeDelayKnownTime(t, valueDelays(k), times);
    z(:, k) = odeDelayEvaluateState(delayedT, times, values, t0, history, options);
  end
  slopeDelays = odeDelayCurrentValues(delay.SlopeDelay, t, y, options);
  zp = zeros(length(y(:)), length(slopeDelays));
  for k = 1:length(slopeDelays)
    delayedT = odeDelayKnownTime(t, slopeDelays(k), times);
    zp(:, k) = odeDelayEvaluateSlope(delayedT, times, slopes, values(:, 1), t0, history, options);
  end
end
%=============================================================================
function mass = odeDelayMassFunction(massFcn, t, y, options)
  localOptions = options;
  mass = odeCallFcn(massFcn, t, y, localOptions);
end
%=============================================================================
function odeValidateDelayProblem(solver, options, delay)
  if strcmp(solver, 'cvodesnonstiff') || strcmp(solver, 'cvodesstiff')
    error('Nelson:ode_solvers:delayEquationsRequireOdeLinearlyImplicit', 'Delay equations require an ODE, linearly implicit, or fully implicit residual solver.');
  end
  if isempty(delay.ValueDelay) && isempty(delay.SlopeDelay)
    error('Nelson:ode_solvers:valuedelaySlopedelaySpecifiedDelayEquations', 'ValueDelay or SlopeDelay must be specified for delay equations.');
  end
  if ~isempty(delay.ValueDelay) && ~isa(delay.ValueDelay, 'function_handle') ...
      && (~isnumeric(delay.ValueDelay) || any(delay.ValueDelay(:) <= 0))
    error('Nelson:ode_solvers:valuedelayEntriesPositiveConstants', '%s entries must be positive constants.', 'ValueDelay');
  end
  if ~isempty(delay.SlopeDelay) && ~isa(delay.SlopeDelay, 'function_handle') ...
      && (~isnumeric(delay.SlopeDelay) || any(delay.SlopeDelay(:) <= 0))
    error('Nelson:ode_solvers:slopedelayEntriesPositiveConstants', '%s entries must be positive constants.', 'SlopeDelay');
  end
end
%=============================================================================
function yp = odeDelayInitialSlope(y0, yp0)
  if isempty(yp0)
    yp = zeros(size(y0));
  else
    yp = yp0(:);
  end
end
%=============================================================================
function tf = odeDelayUsesImplicitResidual(solver)
  tf = strcmp(solver, 'ode15i') || strcmp(solver, 'idas');
end
%=============================================================================
function values = odeDelayInitialValues(delayValue, t, y, options)
  if isempty(delayValue)
    values = [];
  elseif isa(delayValue, 'function_handle')
    values = odeDelayEvaluateDelayFunction(delayValue, t, y, options);
  else
    values = delayValue(:);
  end
  odeDelayCheckPositive(values);
end
%=============================================================================
function tspanChunk = odeDelayChunkTimeSpan(tspan, t0, tfinal, direction)
  inside = tspan(direction * (tspan - t0) > 0 & direction * (tfinal - tspan) > 0);
  tspanChunk = [t0 inside tfinal];
end
%=============================================================================
function dydt = odeDelayRhs(...
    odefun, t, y, times, values, slopes, t0, history, valueDelays, slopeDelays, options)
  valueDelays = odeDelayCurrentValues(valueDelays, t, y, options);
  slopeDelays = odeDelayCurrentValues(slopeDelays, t, y, options);
  z = zeros(length(y(:)), length(valueDelays));
  for k = 1:length(valueDelays)
    delayedT = odeDelayKnownTime(t, valueDelays(k), times);
    z(:, k) = odeDelayEvaluateState(delayedT, times, values, t0, history, options);
  end
  if isempty(slopeDelays)
    args = {t, y, z};
  else
    zp = zeros(length(y(:)), length(slopeDelays));
    for k = 1:length(slopeDelays)
      delayedT = odeDelayKnownTime(t, slopeDelays(k), times);
      zp(:, k) = odeDelayEvaluateSlope(...
        delayedT, times, slopes, values(:, 1), t0, history, options);
    end
    args = {t, y, z, zp};
  end
  args = odeAppendParameters(args, options.Parameters);
  dydt = feval(odefun, args{:});
  dydt = dydt(:);
end
%=============================================================================
function values = odeDelayCurrentValues(delayValue, t, y, options)
  if isempty(delayValue)
    values = [];
  elseif isa(delayValue, 'function_handle')
    values = odeDelayEvaluateDelayFunction(delayValue, t, y, options);
  else
    values = delayValue(:);
  end
  odeDelayCheckPositive(values);
end
%=============================================================================
function values = odeDelayEvaluateDelayFunction(fcn, t, y, options)
  args = {t, y};
  if isfield(options, 'Parameters') && ~isempty(options.Parameters)
    args = odeAppendParameters(args, options.Parameters);
  end
  values = feval(fcn, args{:});
  if ~isnumeric(values) || any(~isfinite(values(:)))
    error('Nelson:ode_solvers:delayFunctionReturnFiniteNumericValues', 'Delay function must return finite numeric values.');
  end
  values = values(:);
end
%=============================================================================
function residual = odeDelayResidual(...
    odefun, t, y, yp, times, values, slopes, t0, history, valueDelays, slopeDelays, options)
  valueDelays = odeDelayCurrentValues(valueDelays, t, y, options);
  slopeDelays = odeDelayCurrentValues(slopeDelays, t, y, options);
  z = zeros(length(y(:)), length(valueDelays));
  for k = 1:length(valueDelays)
    delayedT = odeDelayKnownTime(t, valueDelays(k), times);
    z(:, k) = odeDelayEvaluateState(delayedT, times, values, t0, history, options);
  end
  if isempty(slopeDelays)
    args = {t, y, yp, z};
  else
    zp = zeros(length(y(:)), length(slopeDelays));
    for k = 1:length(slopeDelays)
      delayedT = odeDelayKnownTime(t, slopeDelays(k), times);
      zp(:, k) = odeDelayEvaluateSlope(...
        delayedT, times, slopes, values(:, 1), t0, history, options);
    end
    args = {t, y, yp, z, zp};
  end
  args = odeAppendParameters(args, options.Parameters);
  residual = feval(odefun, args{:});
  residual = residual(:);
end
%=============================================================================
function odeDelayCheckPositive(values)
  if any(values(:) <= 0)
    error('Nelson:ode_solvers:delayEntriesPositive', 'Delay entries must be positive.');
  end
end
%=============================================================================
function delayedT = odeDelayKnownTime(t, delayValue, times)
  delayedT = t - delayValue;
  tolerance = max(1e-8, sqrt(eps) * (1 + abs(t)));
  if delayedT > times(length(times)) + tolerance
    error('Nelson:ode_solvers:stateDependentDelayRequiresKnownPast', 'State-dependent delay requires a known past state.');
  end
  delayedT = min(delayedT, times(length(times)));
end
%=============================================================================
function y = odeDelayEvaluateState(t, times, values, t0, history, options)
  if t <= t0
    y = odeDelayEvaluateHistory(t, values(:, 1), history, options);
    return
  end
  if length(times) == 1
    y = values(:, 1);
    return
  end
  y = interp1(times(:), values.', t, 'linear').';
end
%=============================================================================
function yp = odeDelayEvaluateSlope(t, times, slopes, y0, t0, history, options)
  if t <= t0
    yp = odeDelayEvaluateHistorySlope(t, y0, history, options);
    return
  end
  if length(times) == 1 || isempty(slopes)
    yp = zeros(size(y0));
    return
  end
  yp = interp1(times(:), slopes.', t, 'linear').';
end
%=============================================================================
function yp = odeDelayEvaluateHistorySlope(t, y0, history, options)
  if isempty(history) || isnumeric(history)
    yp = zeros(size(y0));
    return
  end
  if isstruct(history)
    [~, yp] = deval(history, t);
    yp = yp(:);
    return
  end
  step = sqrt(eps) * max(1, abs(t));
  yplus = odeDelayEvaluateHistory(t + step, y0, history, options);
  yminus = odeDelayEvaluateHistory(t - step, y0, history, options);
  yp = (yplus - yminus) / (2 * step);
end
%=============================================================================
function y = odeDelayEvaluateHistory(t, y0, history, options)
  if isempty(history)
    y = y0;
    return
  end
  if isa(history, 'function_handle')
    args = odeAppendParameters({t}, options.Parameters);
    y = feval(history, args{:});
  elseif isstruct(history)
    y = deval(history, t);
  elseif isscalar(history)
    y = history * ones(size(y0));
  else
    y = history(:);
  end
  if length(y(:)) ~= length(y0(:))
    error('Nelson:ode_solvers:historySizeNotMatchInitialValue', 'History size does not match initial value.');
  end
  y = y(:);
end
%=============================================================================
function aggregate = odeDelayMergeSolution(aggregate, chunkSol, chunkIndex)
  if isempty(aggregate)
    aggregate = chunkSol;
    aggregate.stats.nchunks = chunkIndex;
    return
  end
  first = 2;
  aggregate.x = [aggregate.x chunkSol.x(first:end)];
  aggregate.y = [aggregate.y chunkSol.y(:, first:end)];
  aggregate.extdata.slopes = [aggregate.extdata.slopes chunkSol.extdata.slopes(:, first:end)];
  if isfield(chunkSol, 'xe')
    if isfield(aggregate, 'xe')
      aggregate.xe = [aggregate.xe chunkSol.xe];
      aggregate.ye = [aggregate.ye chunkSol.ye];
      aggregate.ie = [aggregate.ie chunkSol.ie];
    else
      aggregate.xe = chunkSol.xe;
      aggregate.ye = chunkSol.ye;
      aggregate.ie = chunkSol.ie;
    end
  end
  aggregate.stats = odeDelayMergeStats(aggregate.stats, chunkSol.stats);
  aggregate.stats.nchunks = chunkIndex;
end
%=============================================================================
function stats = odeDelayMergeStats(stats, chunkStats)
  names = {'nsteps'; 'nfailed'; 'nfevals'};
  for k = 1:length(names)
    name = names{k};
    if isfield(stats, name) && isfield(chunkStats, name)
      stats.(name) = stats.(name) + chunkStats.(name);
    end
  end
end
%=============================================================================
function sol = odeDelayFinalizeSolution(sol, solver, options, yp0)
  sol.solver = solver;
  sol.extdata.options = options;
  sol.extdata.yp0 = yp0;
  if ~isfield(sol.stats, 'nchunks')
    sol.stats.nchunks = 1;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function sol = odeRunSensitivity(solver, odefun, tspan, y0, yp0, options, sensitivity)
  odeValidateSensitivityProblem(solver, options, sensitivity);
  if strcmp(sensitivity.Method, 'adjoint')
    sol = odeRunAdjointSensitivity(solver, odefun, tspan, y0, yp0, options, sensitivity);
    return
  end
  parameters = options.Parameters(:);
  indices = odeSensitivityParameterIndices(sensitivity, length(parameters));
  y0 = y0(:);
  if odeIsSundialsSolver(solver) && isempty(options.Events)
    sol = odeRunSundialsSensitivity(...
      solver, odefun, tspan, y0, yp0, options, sensitivity, parameters, indices);
    return
  end
  if odeSensitivityIsImplicitSolver(solver)
    sol = odeRunImplicitSensitivity(solver, odefun, tspan, y0, yp0, options, ...
      sensitivity, parameters, indices);
    return
  end
  s0 = odeSensitivityInitialValue(sensitivity, length(y0), length(indices));
  z0 = [y0; s0(:)];
  augOptions = odeSensitivityOptions(options, length(y0));
  augfun = @(t, z) odeSensitivityRhs(odefun, t, z, length(y0), parameters, indices, ...
    sensitivity, options);
  sol = odeRunSolver(solver, augfun, tspan, z0, [], augOptions);
  sol = odeSensitivitySplitSolution(sol, length(y0), length(indices));
end
%=============================================================================
function sol = odeRunSundialsSensitivity(solver, odefun, tspan, y0, yp0, options, ...
    sensitivity, parameters, indices)
  n = length(y0);
  p = length(indices);
  s0 = odeSensitivityInitialValue(sensitivity, n, p);
  sensitivityData = struct();
  sensitivityData.Parameters = parameters(:);
  sensitivityData.ParameterIndices = indices(:) - 1;
  sensitivityData.ParameterScales = max(abs(parameters(indices(:))), 1);
  sensitivityData.InitialValue = s0;
  if strcmp(solver, 'idas')
    if isempty(yp0)
      yp0 = zeros(size(y0));
    else
      yp0 = yp0(:);
    end
    sensitivityData.InitialSlope = odeSensitivityInitialSlopeImplicit(...
      odefun, tspan(1), y0, yp0, s0, sensitivity, parameters, indices, options);
  else
    sensitivityData.InitialSlope = [];
  end
  nativeOptions = options;
  nativeOptions.Sensitivity = sensitivityData;
  problem = odePrepareProblem(solver, odefun, tspan, y0, yp0, nativeOptions);
  sol = __ode_sundials_run__(problem);
  odeDisplayStats(problem, sol.stats);
end
%=============================================================================
function odeValidateSensitivityProblem(solver, options, sensitivity)
  if ~isnumeric(options.Parameters) || ~isreal(options.Parameters) || ~isvector(options.Parameters)
    error('Nelson:ode_solvers:parametersNumericVectorPerformSensitivityAnalysis', 'Parameters must be a numeric vector to perform a sensitivity analysis.');
  end
  if ~odeSensitivityIsImplicitSolver(solver) && ~isempty(sensitivity.InitialSlope)
    error('Nelson:ode_solvers:sensitivityInitialSlopesNotSupportedExplicit', 'Sensitivity initial slopes are not supported for explicit problems.');
  end
  if isfield(options, 'EventDefinitionObject') ...
      && odeSensitivityHasCallbackEvent(options.EventDefinitionObject)
    error('Nelson:ode_solvers:sensitivityEquationsEventCallbacksNotSupported', 'Sensitivity equations with event callbacks are not supported yet.');
  end
end
%=============================================================================
function tf = odeSensitivityIsImplicitSolver(solver)
  tf = strcmp(solver, 'ode15i') || strcmp(solver, 'idas');
end
%=============================================================================
function sol = odeRunImplicitSensitivity(solver, odefun, tspan, y0, yp0, options, ...
    sensitivity, parameters, indices)
  n = length(y0);
  p = length(indices);
  if isempty(yp0)
    yp0 = zeros(size(y0));
  else
    yp0 = yp0(:);
  end
  s0 = odeSensitivityInitialValue(sensitivity, n, p);
  sp0 = odeSensitivityInitialSlopeImplicit(...
    odefun, tspan(1), y0, yp0, s0, sensitivity, parameters, indices, options);
  z0 = [y0; s0(:)];
  zp0 = [yp0; sp0(:)];
  augOptions = odeSensitivityOptions(options, n);
  augOptions.InitialSlope = zp0;
  augfun = @(t, z, zp) odeSensitivityImplicitResidual(...
    odefun, t, z, zp, n, p, parameters, indices, options);
  sol = odeRunSolver(solver, augfun, tspan, z0, zp0, augOptions);
  sol = odeSensitivitySplitSolution(sol, n, p);
end
%=============================================================================
function sp0 = odeSensitivityInitialSlopeImplicit(...
    odefun, t, y, yp, s0, sensitivity, parameters, indices, options)
  n = length(y);
  p = length(indices);
  if ~isempty(sensitivity.InitialSlope)
    sp0 = odeSensitivityInitialSlopeValue(sensitivity.InitialSlope, n, p);
    return
  end
  residual = odeSensitivityImplicitPhysicalResidual(odefun, t, y, yp, parameters);
  jacY = odeSensitivityImplicitStateJacobian(odefun, t, y, yp, parameters, residual);
  jacYp = odeSensitivityImplicitSlopeJacobian(odefun, t, y, yp, parameters, residual);
  jacP = odeSensitivityImplicitParameterJacobian(...
    odefun, t, y, yp, parameters, indices, residual);
  sp0 = zeros(n, p);
  for k = 1:p
    sp0(:, k) = odeSensitivitySolveMass(jacYp, -(jacY * s0(:, k) + jacP(:, k)));
  end
end
%=============================================================================
function sp0 = odeSensitivityInitialSlopeValue(value, n, p)
  if isequal(size(value), [n p])
    sp0 = value;
  elseif numel(value) == n * p
    sp0 = reshape(value, n, p);
  else
    error('Nelson:ode_solvers:sensitivityInitialSlopeSizeMismatch', 'Sensitivity initial slope has incompatible size.');
  end
end
%=============================================================================
function residual = odeSensitivityImplicitResidual(...
    odefun, t, z, zp, n, p, parameters, indices, options)
  y = z(1:n);
  yp = zp(1:n);
  smat = reshape(z(n + 1:length(z)), n, p);
  spmat = reshape(zp(n + 1:length(zp)), n, p);
  f0 = odeSensitivityImplicitPhysicalResidual(odefun, t, y, yp, parameters);
  jacY = odeSensitivityImplicitStateJacobian(odefun, t, y, yp, parameters, f0);
  jacYp = odeSensitivityImplicitSlopeJacobian(odefun, t, y, yp, parameters, f0);
  jacP = odeSensitivityImplicitParameterJacobian(odefun, t, y, yp, parameters, indices, f0);
  sres = jacY * smat + jacYp * spmat + jacP;
  residual = [f0(:); sres(:)];
end
%=============================================================================
function tf = odeSensitivityHasCallbackEvent(eventDefinition)
  response = eventDefinition.Response;
  if iscell(response)
    tf = false;
    for k = 1:numel(response)
      tf = tf || strcmpi(response{k}, 'callback');
    end
  else
    tf = strcmpi(response, 'callback');
  end
end
%=============================================================================
function indices = odeSensitivityParameterIndices(sensitivity, count)
  if isempty(sensitivity.ParameterIndices)
    indices = (1:count).';
  else
    indices = sensitivity.ParameterIndices(:);
  end
  if any(indices > count)
    error('Nelson:ode_solvers:parameterindicesExceedNumberParameters', 'ParameterIndices exceed the number of parameters.');
  end
end
%=============================================================================
function s0 = odeSensitivityInitialValue(sensitivity, n, p)
  if isempty(sensitivity.InitialValue)
    s0 = zeros(n, p);
    return
  end
  value = sensitivity.InitialValue;
  if isequal(size(value), [n p])
    s0 = value;
  elseif numel(value) == n * p
    s0 = reshape(value, n, p);
  else
    error('Nelson:ode_solvers:sensitivityInitialValueIncompatibleSize', 'Sensitivity initial value has incompatible size.');
  end
end
%=============================================================================
function options = odeSensitivityOptions(options, n)
  baseOptions = options;
  options.Parameters = [];
  if ~isempty(baseOptions.Events)
    options.Events = @(t, z) odeSensitivityEvents(baseOptions, t, z, n);
  else
    options.Events = [];
  end
  if isfield(options, 'EventDefinitionObject')
    options = rmfield(options, 'EventDefinitionObject');
  end
  if ~isempty(baseOptions.OutputFcn)
    options.OutputFcn = @(t, z, flag) odeSensitivityOutput(baseOptions, t, z, flag, n);
  else
    options.OutputFcn = [];
  end
  options.OutputSel = [];
  options.NonNegative = baseOptions.NonNegative;
  options.Mass = [];
  options.MvPattern = [];
  options.Jacobian = [];
  options.JPattern = [];
  options.Vectorized = 'off';
end
%=============================================================================
function stop = odeSensitivityOutput(options, t, z, flag, n)
  y = z;
  if ~isempty(z) && isempty(flag)
    y = z(1:n, :);
  elseif ~isempty(z) && strcmp(flag, 'init')
    y = z(1:n, :);
  end
  if ~isempty(options.OutputSel) && (isempty(flag) || strcmp(flag, 'init'))
    y = y(options.OutputSel, :);
  end
  args = {t, y, flag};
  if isfield(options, 'Parameters') && ~isempty(options.Parameters)
    args = odeAppendParameters(args, options.Parameters);
  end
  stop = feval(options.OutputFcn, args{:});
end
%=============================================================================
function [value, isterminal, direction] = odeSensitivityEvents(options, t, z, n)
  y = z(1:n);
  if isfield(options, 'EventDefinitionObject')
    args = {options.EventDefinitionObject, t, y};
    if isfield(options, 'Parameters') && ~isempty(options.Parameters)
      args = odeAppendParameters(args, options.Parameters);
    end
    [value, isterminal, direction] = odeEvaluateEventObject(args{:});
  else
    [value, isterminal, direction] = odeCallFcn(options.Events, t, y, options);
  end
end
%=============================================================================
function dz = odeSensitivityRhs(odefun, t, z, n, parameters, indices, sensitivity, options)
  y = z(1:n);
  pcount = length(indices);
  smat = reshape(z(n + 1:length(z)), n, pcount);
  f0 = odeSensitivityPhysicalRhs(odefun, t, y, parameters, options);
  jacY = odeSensitivityStateJacobian(odefun, t, y, parameters, f0, sensitivity, options);
  jacP = odeSensitivityParameterJacobian(odefun, t, y, parameters, indices, f0, options);
  ds = jacY * smat + jacP;
  dz = [f0(:); ds(:)];
end
%=============================================================================
function residual = odeSensitivityImplicitPhysicalResidual(odefun, t, y, yp, parameters)
  residual = feval(odefun, t, y, yp, parameters);
  residual = residual(:);
end
%=============================================================================
function rhs = odeSensitivityPhysicalRhs(odefun, t, y, parameters, options)
  rhs = feval(odefun, t, y, parameters);
  if ~isempty(options.Mass)
    mass = odeSensitivityMassValue(options.Mass, t, y, parameters, options);
    rhs = odeSensitivitySolveMass(mass, rhs);
  end
end
%=============================================================================
function mass = odeSensitivityMassValue(mass, t, y, parameters, options)
  if isa(mass, 'function_handle')
    localOptions = options;
    localOptions.Parameters = parameters;
    mass = odeCallFcn(mass, t, y, localOptions);
  end
end
%=============================================================================
function rhs = odeSensitivitySolveMass(mass, rhs)
  if isscalar(mass)
    rhs = rhs ./ mass;
  else
    rhs = mass \ rhs;
  end
end
%=============================================================================
function jac = odeSensitivityImplicitStateJacobian(odefun, t, y, yp, parameters, f0)
  n = length(y);
  jac = zeros(n, n);
  for k = 1:n
    step = sqrt(eps) * max(abs(y(k)), 1);
    trial = y;
    trial(k) = trial(k) + step;
    trialResidual = odeSensitivityImplicitPhysicalResidual(odefun, t, trial, yp, parameters);
    jac(:, k) = (trialResidual - f0) / step;
  end
end
%=============================================================================
function jac = odeSensitivityImplicitSlopeJacobian(odefun, t, y, yp, parameters, f0)
  n = length(yp);
  jac = zeros(n, n);
  for k = 1:n
    step = sqrt(eps) * max(abs(yp(k)), 1);
    trial = yp;
    trial(k) = trial(k) + step;
    trialResidual = odeSensitivityImplicitPhysicalResidual(odefun, t, y, trial, parameters);
    jac(:, k) = (trialResidual - f0) / step;
  end
end
%=============================================================================
function jac = odeSensitivityImplicitParameterJacobian(...
    odefun, t, y, yp, parameters, indices, f0)
  n = length(y);
  jac = zeros(n, length(indices));
  for k = 1:length(indices)
    idx = indices(k);
    step = sqrt(eps) * max(abs(parameters(idx)), 1);
    trial = parameters;
    trial(idx) = trial(idx) + step;
    trialResidual = odeSensitivityImplicitPhysicalResidual(odefun, t, y, yp, trial);
    jac(:, k) = (trialResidual - f0) / step;
  end
end
%=============================================================================
function jac = odeSensitivityStateJacobian(odefun, t, y, parameters, f0, sensitivity, options)
  if ~isempty(sensitivity.Jacobian)
    jac = sensitivity.Jacobian.Jacobian;
    if isa(jac, 'function_handle')
      jac = feval(jac, t, y, parameters);
    end
    if ~isempty(options.Mass)
      mass = odeSensitivityMassValue(options.Mass, t, y, parameters, options);
      jac = odeSensitivitySolveMass(mass, jac);
    end
    return
  end
  n = length(y);
  jac = zeros(n, n);
  for k = 1:n
    step = sqrt(eps) * max(abs(y(k)), 1);
    trial = y;
    trial(k) = trial(k) + step;
    trialRhs = odeSensitivityPhysicalRhs(odefun, t, trial, parameters, options);
    jac(:, k) = (trialRhs - f0) / step;
  end
end
%=============================================================================
function jac = odeSensitivityParameterJacobian(odefun, t, y, parameters, indices, f0, options)
  n = length(y);
  jac = zeros(n, length(indices));
  for k = 1:length(indices)
    idx = indices(k);
    step = sqrt(eps) * max(abs(parameters(idx)), 1);
    trial = parameters;
    trial(idx) = trial(idx) + step;
    trialRhs = odeSensitivityPhysicalRhs(odefun, t, y, trial, options);
    jac(:, k) = (trialRhs - f0) / step;
  end
end
%=============================================================================
function sol = odeSensitivitySplitSolution(sol, n, p)
  z = sol.y;
  nt = size(z, 2);
  sol.y = z(1:n, :);
  if isfield(sol, 'extdata') && isfield(sol.extdata, 'slopes')
    sol.extdata.slopes = sol.extdata.slopes(1:n, :);
  end
  if isfield(sol, 'extdata') && isfield(sol.extdata, 'yp0') && ~isempty(sol.extdata.yp0)
    sol.extdata.yp0 = sol.extdata.yp0(1:n);
  end
  sensitivity = zeros(n, p, nt);
  for k = 1:nt
    sensitivity(:, :, k) = reshape(z(n + 1:size(z, 1), k), n, p);
  end
  sol.sensitivity = sensitivity;
  if isfield(sol, 'ye')
    zevent = sol.ye;
    sol.ye = zevent(1:n, :);
    ne = size(zevent, 2);
    eventSensitivity = zeros(n, p, ne);
    for k = 1:ne
      eventSensitivity(:, :, k) = reshape(zevent(n + 1:size(zevent, 1), k), n, p);
    end
    sol.eventSensitivity = eventSensitivity;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
