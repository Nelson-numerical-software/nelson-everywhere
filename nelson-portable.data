%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
modules_list = getmodules('reverse');
for k = modules_list(:)'
  try
    removemodule(k{1});
  catch
    e = lasterror();
    warning(e.message)
  end
end
%==============================================================================
{
  "schemaVersion": 1,
  "description": "Vocabulary of capability names usable in a module examples/index.json 'requirements' field. 'baseline' true means the capability is always present in a standard Nelson build, so its gallery example does not need a runtime error() guard; false means the capability is optional or environment-dependent and its example must guard against the capability being unavailable.",
  "requirements": [
    { "name": "gui", "baseline": true },
    { "name": "plots", "baseline": true },
    { "name": "control-system", "baseline": true },
    { "name": "graphics-io", "baseline": true },
    { "name": "fft", "baseline": true },
    { "name": "hdf5", "baseline": true },
    { "name": "ode-solvers", "baseline": true },
    { "name": "gif", "baseline": true },
    { "name": "nflow", "baseline": true },
    { "name": "web_gui", "baseline": false },
    { "name": "network", "baseline": false },
    { "name": "credentials", "baseline": false },
    { "name": "compiler", "baseline": false },
    { "name": "mpi", "baseline": false },
    { "name": "windows", "baseline": false },
    { "name": "python", "baseline": false },
    { "name": "julia", "baseline": false },
    { "name": "audio-input", "baseline": false },
    { "name": "audio-output", "baseline": false },
    { "name": "audio-flac", "baseline": false },
    { "name": "audio-ogg", "baseline": false },
    { "name": "audio-mpeg", "baseline": false },
    { "name": "external-application", "baseline": false }
  ]
}
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
true = 1; false = 0;
run([nelsonroot() '/modules/' 'modules.m']);
for module_state = modules_list'
  if (module_state{1}{2})
    run([nelsonroot(), '/modules/', module_state{1}{1}, '/loader.m']);
  end
end
if iswasm()
  root_temp_dir = [nelsonroot(), '/temp'];
  if ~isdir(root_temp_dir)
    mkdir(root_temp_dir);
  end
end
%==============================================================================
if (isquietmode() == false)
  banner();
  fprintf(stdout(), '\n%s\n', version());
  fprintf(stdout(), '%s\n', version('-date'));
  fprintf(stdout(), '%s\n', ' ');
end
clear('all');
cd(nelsonroot());
