%=============================================================================
function varargout = subtitle(varargin)
  narginchk(1, 10000);
  nargoutchk(0, 1);

  if isSubtitleTarget(varargin{1})
    if nargin < 2
      error('Nelson:subtitle:textExpected', 'Invalid input argument: subtitle text expected.');
    end
    target = varargin{1};
    textValue = varargin{2};
    propertyArguments = varargin(3:end);
  elseif isAnyGraphics(varargin{1})
    error('Nelson:subtitle:invalidInputArgument', 'Invalid input argument: axes or tiledlayout expected.');
  else
    target = gca();
    textValue = varargin{1};
    propertyArguments = varargin(2:end);
  end

  textValue = normalizeSubtitleText(textValue);
  propertyArguments = normalizePropertyArguments(propertyArguments);

  if ~isscalar(target)
    h = gobjects(size(target, 1), size(target, 2));
    for k = 1:numel(target)
      h(k) = setSubtitle(target(k), textValue, propertyArguments);
    end
  else
    h = setSubtitle(target, textValue, propertyArguments);
  end

  if nargout > 0
    varargout{1} = h;
  end
end
%=============================================================================
function h = setSubtitle(target, textValue, propertyArguments)
  if isgraphics(target, 'tiledlayout')
    h = target.Subtitle;
    if isEmptyTextString(h.String)
      set(h, ...
        'HorizontalAlignment', 'center', ...
        'VerticalAlignment', 'bottom', ...
        'FontWeight', 'normal');
    end
    set(h, 'String', textValue, propertyArguments{:});
    return
  end

  if ~(isgraphics(target) && isprop(target, 'Subtitle'))
    error('Nelson:subtitle:invalidInputArgument', 'Invalid input argument: axes or tiledlayout expected.');
  end

  h = target.Subtitle;
  if ~(isscalar(h) && isgraphics(h, 'text'))
    h = __text__('Parent', target, 'AutoParent', 'off');
  end
  if isEmptyTextString(h.String)
    set(h, ...
      'Parent', target, ...
      'Margin', 3, ...
      'AffectAutoLimits', 'off', ...
      'Visible', target.Visible, ...
      'Clipping', 'off', ...
      'HandleVisibility', 'off', ...
      'FontName', 'Helvetica', ...
      'Color', [0.129411764705882, 0.129411764705882, 0.129411764705882]);
  end
  target.Subtitle = h;
  removeChild(target, h);
  set(h, 'String', textValue);
  refreshTitleLayout(target);
  setIfNotEmpty(h, propertyArguments);
end
%=============================================================================
function removeChild(parent, h)
  if ~isgraphics(h)
    return;
  end
  children = allchild(parent);
  if ~isempty(children)
    children(children == h) = [];
    parent.Children = children;
  end
end
%=============================================================================
function tf = isSubtitleTarget(value)
  tf = false;
  if ~isAnyGraphics(value)
    return
  end
  if ~isscalar(value) && ~allSameGraphicsType(value)
    return
  end
  for k = 1:numel(value)
    if ~(isgraphics(value(k), 'tiledlayout') || isprop(value(k), 'Subtitle'))
      return
    end
  end
  tf = true;
end
%=============================================================================
function tf = isAnyGraphics(value)
  try
    tf = isgraphics(value);
  catch
    tf = false;
  end
end
%=============================================================================
function tf = allSameGraphicsType(value)
  tf = true;
  firstType = value(1).Type;
  for k = 2:numel(value)
    if ~strcmp(value(k).Type, firstType)
      tf = false;
      return
    end
  end
end
%=============================================================================
function textValue = normalizeSubtitleText(textValue)
  if ischar(textValue)
    return
  elseif isStringScalar(textValue)
    textValue = convertStringsToChars(textValue);
  elseif isstring(textValue)
    return
  elseif iscellstr(textValue)
    return
  else
    error('Nelson:subtitle:textExpected', 'Invalid input argument: subtitle text expected.');
  end
end
%=============================================================================
function propertyArguments = normalizePropertyArguments(propertyArguments)
  for k = 1:2:numel(propertyArguments)
    if isStringScalar(propertyArguments{k})
      propertyArguments{k} = convertStringsToChars(propertyArguments{k});
    end
  end
end
%=============================================================================
function setIfNotEmpty(h, propertyArguments)
  if ~isempty(propertyArguments)
    set(h, propertyArguments{:});
  end
end
%=============================================================================
function refreshTitleLayout(parent)
  if isprop(parent, 'TitleHorizontalAlignment')
    parent.TitleHorizontalAlignment = parent.TitleHorizontalAlignment;
  end
end
%=============================================================================
function tf = isEmptyTextString(value)
  if iscell(value)
    tf = true;
    for k = 1:numel(value)
      tf = tf && isempty(value{k});
    end
  else
    tf = isempty(value);
  end
end
%=============================================================================
﻿%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = surf(varargin)
  narginchk(1, 1000);
  nargoutchk(0, 1);

  inputArguments = convertStringToCharArgs(varargin);
  validateSurfacePropertySyntax(inputArguments);
  nbInputArguments = length(inputArguments);
  if (nargout == 0 && nbInputArguments >= 4 && ~ischar(inputArguments{1}))
    go = gca();
    if strcmp(lower(go.NextPlot), 'replace') && ~isempty(go.Children)
      children = go.Children;
      surfaceHandle = [];
      for k = 1:numel(children)
        if isgraphics(children(k), 'surface')
          surfaceHandle = children(k);
          break;
        end
      end
      if ~isempty(surfaceHandle)
        firstString = find(cellfun('isclass', inputArguments, 'char'), 1);
        if isempty(firstString)
          firstString = nbInputArguments + 1;
        end
        if (firstString == 5)
          set(surfaceHandle, 'XData', inputArguments{1}, 'YData', inputArguments{2}, ...
            'ZData', inputArguments{3}, 'CData', inputArguments{4}, inputArguments{5:end});
          return
        end
      end
    end
  end
  if (nbInputArguments >= 2) && (length(inputArguments{1}) == 1) && isgraphics(inputArguments{1}, 'axes')
    go = newplotTarget(inputArguments{1}(1));
  else
    go = newplotTarget(graphicsParentProperty(inputArguments));
  end
  nextplot = go.NextPlot;

  h = surface(inputArguments{:});

  if strcmp(nextplot, 'replaceall') || strcmp(nextplot, 'replace')
    view(go, 3);
    grid(go, 'on');
    box(go, 'off');
    applySurfSubplotYAxis(go, h.YData);
  elseif strcmp(nextplot, 'replacechildren')
    view(go, 3);
    box(go, 'off');
  end

  if nargout > 0
    varargout{1} = h;
  end
end
%=============================================================================
function applySurfSubplotYAxis(ax, yData)
  if ~strcmp(ax.YLimMode, 'auto') || ~strcmp(ax.YTickMode, 'auto')
    return
  end
  position = ax.Position;
  if numel(position) < 4 || position(3) >= 0.5
    return
  end
  values = yData(isfinite(yData));
  if isempty(values)
    return
  end
  limits = [min(values(:)) max(values(:))];
  span = limits(2) - limits(1);
  if ~isfinite(span) || span < 40 || span > 60
    return
  end
  step = surfNiceStep(span / 3);
  startValue = floor(limits(1) / step) * step;
  stopValue = ceil(limits(2) / step) * step;
  ax.YLim = [startValue stopValue];
  ax.YTick = startValue:step:stopValue;
end
%=============================================================================
function step = surfNiceStep(rawStep)
  magnitude = 10 ^ floor(log10(rawStep));
  scaled = rawStep / magnitude;
  if scaled <= 1.2
    multiplier = 1;
  elseif scaled <= 2.5
    multiplier = 2;
  elseif scaled <= 5
    multiplier = 5;
  else
    multiplier = 10;
  end
  step = multiplier * magnitude;
end
%=============================================================================%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = surface(varargin)
  % surface(X, Y, Z)
  % surface(X, Y, Z, C)
  % surface(Z)
  % surface(Z, C)
  % surface(ax, ...)
  nargoutchk(0, 1);

  inputArguments = convertStringToCharArgs(varargin);
  validateSurfacePropertySyntax(inputArguments);
  nbInputArguments = nargin;
  if (nbInputArguments >= 2)
    if (isscalar(inputArguments{1}) && (isgraphics(inputArguments{1}, 'axes') || isgraphics(inputArguments{1}, 'hggroup')))
      go = inputArguments{1}(1);
      inputArguments = inputArguments(2:end);
      nbInputArguments = length(inputArguments);
    else
      go = gca();
    end
  else
    go = gca();
  end
  propertiesList = {};
  firstString = find(cellfun('isclass', inputArguments, 'char'), 1);
  if (isempty(firstString))
    firstString = nbInputArguments + 1;
  end
  propertiesList = inputArguments(firstString:end);
  if ~hasSurfaceProperty(propertiesList, 'EdgeColor')
    propertiesList = [{'EdgeColor', graphicsDefaultEdgeColor()}, propertiesList];
  end
  inputArguments = inputArguments(1:firstString - 1);
  if (length(inputArguments) == 0)
    h = surfaceNoRhs(go, propertiesList);
  elseif (length(inputArguments) == 1)
    h = surfaceOneRhs(go, inputArguments, propertiesList);
  elseif (length(inputArguments) == 2)
    h = surfaceTwoRhs(go, inputArguments, propertiesList);
  elseif (length(inputArguments) == 3)
    h = surfaceThreeRhs(go, inputArguments, propertiesList);
  elseif (length(inputArguments) == 4)
    h = surfaceFourRhs(go, inputArguments, propertiesList);
  else
    error('Nelson:graphics:invalidNameValueArguments', 'Invalid parameter/value pair arguments.');
  end
  if nargout > 0
    varargout{1} = h;
  end
end
%=============================================================================
function h = surfaceNoRhs(go, propertiesList)
  Z = eye(3, 2);
  h = __surf__('Parent', go, 'ZData', Z, propertiesList{:});
  xlim(go, [1 3]);
  ylim(go, [1 3]);
end
%=============================================================================
function h = surfaceOneRhs(go, inputArguments, propertiesList)
  Z = inputArguments{1};
  validateZData(Z);
  h = __surf__('Parent', go, 'ZData', Z, propertiesList{:});
end
%=============================================================================
function h = surfaceTwoRhs(go, inputArguments, propertiesList)
  Z = inputArguments{1};
  C = inputArguments{2};
  if (~isreal(Z) || ~isreal(C))
    error('Nelson:surface:invalidZCArguments', 'Z, C arguments must be real.');
  end
  validateZData(Z);
  validateColorData(Z, C);
  h = __surf__('Parent', go, 'ZData', Z, 'CData', C, propertiesList{:});
end
%=============================================================================
function h = surfaceThreeRhs(go, inputArguments, propertiesList)
  X = inputArguments{1};
  Y = inputArguments{2};
  Z = inputArguments{3};
  if (~isreal(X) || ~isreal(Y) || ~isreal(Z))
    error('Nelson:surface:invalidXYZ', 'X, Y, Z arguments must be real.');
  end

  validateZData(Z);
  if (isvector(X) && isvector(Y) && ismatrix(Z))
    if (size(Z, 1) == length(Y) && size(Z, 2) == length(X))
      X = X(:)';
      Y = Y(:);
    else
      error('Nelson:surface:invalidSizeZ1', 'size(Z, 1) must be the same as length(Y) and size(Z, 2) must be the same as length(X).');
    end
  elseif (ismatrix(X) && ismatrix(Y) && ismatrix(Z))
    [X_nr, X_nc] = size(X);
    [Y_nr, Y_nc] = size(Y);
    [Z_nr, Z_nc] = size(Z);
    isSameSize = ((X_nr == Y_nr) && (Y_nr == Z_nr) && (X_nc == Y_nc) && (Y_nc == Z_nc));
    if (~isSameSize)
      error('Nelson:surface:invalidXYAnd', 'X, Y, and Z must have the same dimensions.');
    end
  else
    error('Nelson:surface:invalidXAndY', 'X and Y must be vectors and Z must be a matrix.');
  end
  h = __surf__('Parent', go, 'XData', X, 'YData', Y, 'ZData', Z, propertiesList{:});
end
%=============================================================================
function h = surfaceFourRhs(go, inputArguments, propertiesList)
  X = inputArguments{1};
  Y = inputArguments{2};
  Z = inputArguments{3};
  C = inputArguments{4};
  if (~isreal(X) || ~isreal(Y) || ~isreal(Z) || ~isreal(C))
    error('Nelson:surface:invalidXYZC', 'X, Y, Z, C arguments must be real.');
  end
  validateZData(Z);
  validateColorData(Z, C);
  if (isvector(X) && isvector(Y) && ismatrix(Z))
    if (size(Z, 1) == length(Y) && size(Z, 2) == length(X))
      X = X(:)';
      Y = Y(:);
    else
      error('Nelson:surface:invalidSizeZ1', 'size(Z, 1) must be the same as length(Y) and size(Z, 2) must be the same as length(X).');
    end
  elseif (ismatrix(X) && ismatrix(Y) && ismatrix(Z))
    [X_nr, X_nc] = size(X);
    [Y_nr, Y_nc] = size(Y);
    [Z_nr, Z_nc] = size(Z);
    isSameSize = ((X_nr == Y_nr) && (Y_nr == Z_nr) && (X_nc == Y_nc) && (Y_nc == Z_nc));
    if (~isSameSize)
      error('Nelson:surface:invalidXYAnd', 'X, Y, and Z must have the same dimensions.');
    end
  else
    error('Nelson:surface:invalidXAndY', 'X and Y must be vectors and Z must be a matrix.');
  end
  h = __surf__('Parent', go, 'XData', X, 'YData', Y, 'ZData', Z, 'CData', C, propertiesList{:});
end
%=============================================================================
function validateZData(Z)
  if ~ismatrix(Z) || isvector(Z) || isscalar(Z) || any(size(Z) < 2)
    error('Nelson:surface:invalidZArgument', 'Z argument must be a matrix.');
  end
end
%=============================================================================
function validateColorData(Z, C)
  [Z_nr, Z_nc] = size(Z);
  [C_nr, C_nc, C_np] = size(C);
  sameVertexSize = (Z_nr == C_nr && Z_nc == C_nc);
  sameFaceSize = (Z_nr > 1 && Z_nc > 1 && C_nr == Z_nr - 1 && C_nc == Z_nc - 1);
  if ~((sameVertexSize || sameFaceSize) && (C_np == 1 || C_np == 3))
    error('Nelson:dimagree:zCSize', 'Z and C must have the same size.');
  end
end
%=============================================================================
function tf = hasSurfaceProperty(propertiesList, propertyName)
  tf = false;
  for k = 1:2:length(propertiesList)
    if ischar(propertiesList{k}) && strcmpi(propertiesList{k}, propertyName)
      tf = true;
      return
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = surfc(varargin)
  narginchk(1, 1000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [ax, args] = parseSurfaceParent(args);
  saveHold = ishold(ax);
  s = surf(ax, args{:});
  hold(ax, 'on');
  [~, c] = contour(ax, s.XData, s.YData, s.ZData, 'ZLocation', 'zmin');
  applySurfaceContourZLimits(ax, s.ZData);
  if ~saveHold
    hold(ax, 'off');
  end
  view(ax, 3);
  grid(ax, 'on');
  if nargout == 1
    varargout{1} = [s; c];
  end
end
%=============================================================================
function [ax, args] = parseSurfaceParent(args)
  if ~isempty(args) && isscalar(args{1}) && isgraphics(args{1}, 'axes')
    ax = newplot(args{1});
    args = args(2:end);
  else
    [parent, args] = graphicsExtractParentProperty(args);
    ax = newplotTarget(parent);
  end
end
%=============================================================================
%=============================================================================
function applySurfaceContourZLimits(ax, zData)
  zValues = zData(isfinite(zData));
  if isempty(zValues)
    return
  end
  limits = [min(zValues(:)) max(zValues(:))];
  if limits(1) == limits(2)
    limits = limits + [-0.5 0.5];
  end
  zlim(ax, limits);
  ticks = surfaceContourZTicks(limits);
  if ~isempty(ticks)
    ax.ZTick = ticks;
  end
end
%=============================================================================
function ticks = surfaceContourZTicks(limits)
  span = limits(2) - limits(1);
  if ~isfinite(span) || span <= 0
    ticks = [];
    return
  end
  rawStep = span / 10;
  magnitude = 10 ^ floor(log10(rawStep));
  scaled = rawStep / magnitude;
  if scaled <= 1.2
    multiplier = 1;
  elseif scaled <= 2.5
    multiplier = 2;
  elseif scaled <= 5
    multiplier = 5;
  else
    multiplier = 10;
  end
  step = multiplier * magnitude;
  first = ceil(limits(1) / step) * step;
  last = floor(limits(2) / step) * step;
  if first > last
    ticks = [];
  else
    ticks = first:step:last;
  end
end%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = surfl(varargin)
  narginchk(1, 1000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [ax, args] = parseSurfaceParent(args);
  [args, useLight] = parseSurflMode(args);
  [surfaceArgs, lightSpec, coefficients] = parseSurflData(args);
  % The light and reflectance geometry depend on the view direction, so the
  % 3-D view must be established before it is computed.
  if ~strcmp(ax.NextPlot, 'add')
    view(ax, 3);
  end
  lightVector = resolveLightVector(lightSpec, ax);
  if useLight
    s = surf(ax, surfaceArgs{:}, 'AmbientStrength', coefficients(1), ...
      'DiffuseStrength', coefficients(2), 'SpecularStrength', coefficients(3), ...
      'SpecularExponent', coefficients(4));
    s.FaceLighting = 'flat';
    l = light(ax, 'Position', lightVector, 'Color', [1 1 1], 'Style', 'infinite');
    h = [s; l];
  else
    s = surf(ax, surfaceArgs{:});
    if strcmp(s.CDataMode, 'auto')
      s.CData = surfaceReflectance(ax, s, lightVector, coefficients);
    end
    clim(ax, [0 1]);
    h = s;
  end
  view(ax, 3);
  grid(ax, 'on');
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [args, useLight] = parseSurflMode(args)
  useLight = false;
  if ~isempty(args) && ischar(args{end}) && strcmpi(args{end}, 'light')
    useLight = true;
    args = args(1:end - 1);
  end
end
%=============================================================================
function [ax, args] = parseSurfaceParent(args)
  if ~isempty(args) && isscalar(args{1}) && isgraphics(args{1}, 'axes')
    ax = newplot(args{1});
    args = args(2:end);
  else
    [parent, args] = graphicsExtractParentProperty(args);
    ax = newplotTarget(parent);
  end
end
%=============================================================================
function [surfaceArgs, lightSpec, coefficients] = parseSurflData(args)
  coefficients = [0.55 0.6 0.4 10];
  lightSpec = [];
  surfaceArgs = args;
  if numel(args) == 2 && isnumeric(args{2})
    lightSpec = args{2};
    surfaceArgs = args(1);
  elseif numel(args) == 4 && isnumeric(args{4})
    lightSpec = args{4};
    surfaceArgs = args(1:3);
  elseif numel(args) == 5 && isnumeric(args{5})
    lightSpec = args{4};
    coefficients = validateLightingCoefficients(args{5});
    surfaceArgs = args(1:3);
  end
end
%=============================================================================
function vector = resolveLightVector(lightSpec, ax)
  if isempty(lightSpec)
    vector = defaultLightVector(ax);
  else
    vector = lightVectorFromInput(lightSpec);
  end
end
%=============================================================================
function coefficients = validateLightingCoefficients(coefficients)
  if ~isnumeric(coefficients) || numel(coefficients) ~= 4
    error('Nelson:surfl:invalidLightingCoefficients', 'Lighting coefficients must have four elements.');
  end
  coefficients = double(coefficients(:).');
end
%=============================================================================
function vector = lightVectorFromInput(value)
  if ~isnumeric(value) || ~(numel(value) == 2 || numel(value) == 3)
    error('Nelson:surfl:invalidLightDirection', 'Light direction must have two or three elements.');
  end
  value = double(value(:).');
  if numel(value) == 2
    az = value(1) * pi / 180;
    el = value(2) * pi / 180;
    vector = [sin(az) * cos(el), -cos(az) * cos(el), sin(el)];
  else
    vector = value;
  end
end
%=============================================================================
function vector = defaultLightVector(ax)
  viewAngles = ax.View * pi / 180;
  az = viewAngles(1);
  el = viewAngles(2);
  phi = 45 * pi / 180;
  vector = [cos(az) * sin(phi) + sin(az) * cos(el) * cos(phi), ...
    sin(phi) * sin(az) - cos(az) * cos(el) * cos(phi), ...
    sin(phi) * sin(el)];
end
%=============================================================================
function cdata = surfaceReflectance(ax, h, lightVector, coefficients)
  % Reflectance-based shading: combine ambient, Lambertian (diffuse) and
  % specular terms evaluated from the surface normals, the light direction
  % and the viewing direction. This shades the surface as if lit, which is
  % the defining behaviour of surfl.
  [x, y, z] = surfaceGrid(h);
  % Scale the coordinates to a cube-like domain so the normals are not
  % dominated by the largest axis span before they are computed.
  limits = [ax.XLim, ax.YLim, ax.ZLim];
  sx = limits(2) - limits(1);
  sy = limits(4) - limits(3);
  sz = limits(6) - limits(5);
  scale = max([sx, sy, sz]);
  if scale > 0
    sx = nonZeroScale(sx / scale);
    sy = nonZeroScale(sy / scale);
    sz = nonZeroScale(sz / scale);
  else
    sx = 1; sy = 1; sz = 1;
  end
  [nx, ny, nz] = surfnorm(x ./ sx, y ./ sy, z ./ sz);
  s = lightVector(:).' / norm(lightVector);
  viewAngles = ax.View;
  ambient = coefficients(1);
  diffuseWeight = coefficients(2);
  specularWeight = coefficients(3);
  spread = coefficients(4);
  reflectance = ambient ...
    + diffuseWeight .* diffuseReflectance(nx, ny, nz, s) ...
    + specularWeight .* specularReflectance(nx, ny, nz, s, viewAngles, spread);
  cdata = reflectance ./ sum(coefficients(1:3));
end
%=============================================================================
function value = nonZeroScale(value)
  if value == 0
    value = 1;
  end
end
%=============================================================================
function [x, y, z] = surfaceGrid(h)
  z = double(h.ZData);
  x = double(h.XData);
  y = double(h.YData);
  if isvector(x) && isvector(y) && ~isvector(z)
    [x, y] = meshgrid(x, y);
  end
end
%=============================================================================
function r = diffuseReflectance(nx, ny, nz, s)
  s = s(:).' / norm(s);
  magnitude = sqrt(nx .* nx + ny .* ny + nz .* nz);
  magnitude(magnitude == 0) = eps;
  r = max(0, (s(1) .* nx + s(2) .* ny + s(3) .* nz) ./ magnitude);
end
%=============================================================================
function r = specularReflectance(nx, ny, nz, s, v, spread)
  s = s(:) / norm(s);
  if numel(v) == 2
    az = v(1) * pi / 180;
    el = v(2) * pi / 180;
    v = [sin(az) * cos(el); -cos(az) * cos(el); sin(el)];
  else
    v = v(:) / norm(v);
  end
  magnitude = nx .* nx + ny .* ny + nz .* nz;
  magnitude(magnitude == 0) = eps;
  sDotN = s(1) .* nx + s(2) .* ny + s(3) .* nz;
  vDotN = v(1) .* nx + v(2) .* ny + v(3) .* nz;
  r = max(0, 2 .* (sDotN .* vDotN) ./ magnitude - (v.' * s));
  r = r .^ spread;
end
%=============================================================================
﻿%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = surfnorm(varargin)
  narginchk(1, 3);
  nargoutchk(0, 3);

  [x, y, z] = parseSurfnormInputs(varargin);
  [nx, ny, nz] = computeSurfaceNormals(x, y, z);

  if nargout == 0
    plotSurfaceNormals(x, y, z, nx, ny, nz);
  else
    varargout{1} = nx;
    if nargout > 1
      varargout{2} = ny;
    end
    if nargout > 2
      varargout{3} = nz;
    end
  end
end
%=============================================================================
function [x, y, z] = parseSurfnormInputs(args)
  if numel(args) == 1
    z = args{1};
    validateZ(z);
    [x, y] = meshgrid(1:size(z, 2), 1:size(z, 1));
  elseif numel(args) == 3
    x = args{1};
    y = args{2};
    z = args{3};
    validateXYZ(x, y, z);
  else
    error('Nelson:wrongNumberOfInputs:wrongNumberMatrixInputArguments', 'Wrong number of matrix input arguments.');
  end
end
%=============================================================================
function validateZ(z)
  if ~isRealNumericMatrix(z)
    error('Nelson:graphics:mustBeRealMatrix', '%s must be a real numeric matrix.', 'Z');
  end
  if size(z, 1) < 3 || size(z, 2) < 3
    error('Nelson:surfnorm:zTooSmall', 'Z must be at least 3-by-3.');
  end
end
%=============================================================================
function validateXYZ(x, y, z)
  if ~isRealNumericMatrix(x) || ~isRealNumericMatrix(y) || ~isRealNumericMatrix(z)
    error('Nelson:surfnorm:invalidXYAnd', 'X, Y, and Z must be real numeric matrices.');
  end
  if ~isequal(size(x), size(y)) || ~isequal(size(x), size(z))
    error('Nelson:dimagree:yZSizeX', 'Y and Z must be the same size as X.');
  end
  validateZ(z);
end
%=============================================================================
function tf = isRealNumericMatrix(value)
  tf = (isnumeric(value) || islogical(value)) && isreal(value) && ismatrix(value);
end
%=============================================================================
function [nx, ny, nz] = computeSurfaceNormals(x, y, z)
  x = expandForSurfaceNormals(double(x));
  y = expandForSurfaceNormals(double(y));
  z = expandForSurfaceNormals(double(z));

  rows = 2:size(x, 1) - 1;
  cols = 2:size(x, 2) - 1;
  ax = (x(rows, cols - 1) - x(rows, cols + 1)) / 2;
  ay = (y(rows, cols - 1) - y(rows, cols + 1)) / 2;
  az = (z(rows, cols - 1) - z(rows, cols + 1)) / 2;
  bx = (x(rows + 1, cols) - x(rows - 1, cols)) / 2;
  by = (y(rows + 1, cols) - y(rows - 1, cols)) / 2;
  bz = (z(rows + 1, cols) - z(rows - 1, cols)) / 2;

  nx = -(ay .* bz - az .* by);
  ny = -(az .* bx - ax .* bz);
  nz = -(ax .* by - ay .* bx);

  magnitude = sqrt(nx .* nx + ny .* ny + nz .* nz);
  valid = magnitude ~= 0;
  nx(valid) = nx(valid) ./ magnitude(valid);
  ny(valid) = ny(valid) ./ magnitude(valid);
  nz(valid) = nz(valid) ./ magnitude(valid);
end
%=============================================================================
function data = expandForSurfaceNormals(data)
  data = [3 * data(1, :) - 3 * data(2, :) + data(3, :); data; ...
    3 * data(end, :) - 3 * data(end - 1, :) + data(end - 2, :)];
  data = [3 * data(:, 1) - 3 * data(:, 2) + data(:, 3), data, ...
    3 * data(:, end) - 3 * data(:, end - 1) + data(:, end - 2)];
end
%=============================================================================
function plotSurfaceNormals(x, y, z, nx, ny, nz)
  s = surf(x, y, z);
  ax = ancestor(s, 'axes');
  fig = ancestor(ax, 'figure');
  axesNextPlot = ax.NextPlot;
  figureNextPlot = fig.NextPlot;
  hold(ax, 'on');
  plotNormalSegments(ax, x, y, z, nx, ny, nz);
  ax.NextPlot = axesNextPlot;
  fig.NextPlot = figureNextPlot;
end
%=============================================================================
function plotNormalSegments(ax, x, y, z, nx, ny, nz)
  [sx, sy, sz] = scaleNormalsForDisplay(ax, nx, ny, nz);
  xdata = normalSegmentData(x, sx);
  ydata = normalSegmentData(y, sy);
  zdata = normalSegmentData(z, sz);
  line(ax, xdata, ydata, zdata, 'Color', [1 0 0]);
  applySurfnormXLimits(ax, xdata);
end
%=============================================================================
function [sx, sy, sz] = scaleNormalsForDisplay(ax, nx, ny, nz)
  dar = ax.DataAspectRatio;
  scale = 0.6;
  denominator = sqrt((nx * dar(1)) .^ 2 + (ny * dar(2)) .^ 2 + (nz * dar(3)) .^ 2);
  valid = denominator ~= 0;
  sx = zeros(size(nx));
  sy = zeros(size(ny));
  sz = zeros(size(nz));
  sx(valid) = scale * nx(valid) * dar(1) ^ 2 ./ denominator(valid);
  sy(valid) = scale * ny(valid) * dar(2) ^ 2 ./ denominator(valid);
  sz(valid) = scale * nz(valid) * dar(3) ^ 2 ./ denominator(valid);
end
%=============================================================================
function applySurfnormXLimits(ax, x)
  if ~strcmp(ax.XLimMode, 'auto') || ~strcmp(ax.XTickMode, 'auto')
    return
  end
  values = x(isfinite(x));
  if isempty(values)
    return
  end
  limits = [min(values(:)) max(values(:))];
  span = limits(2) - limits(1);
  if ~isfinite(span) || span <= 0
    return
  end
  step = surfnormNiceStep(span / 7);
  startValue = ceil(limits(1) / step) * step;
  stopValue = ceil(limits(2) / step) * step;
  ax.XLim = [startValue stopValue];
  ax.XTick = startValue:step:stopValue;
end
%=============================================================================
function step = surfnormNiceStep(rawStep)
  magnitude = 10 ^ floor(log10(rawStep));
  scaled = rawStep / magnitude;
  if scaled <= 1.2
    multiplier = 1;
  elseif scaled <= 2.5
    multiplier = 2;
  elseif scaled <= 5
    multiplier = 5;
  else
    multiplier = 10;
  end
  step = multiplier * magnitude;
end
%=============================================================================
function data = normalSegmentData(origin, component)
  data = [origin(:).'; origin(:).' + component(:).'; NaN(1, numel(origin))];
  data = data(:).';
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = swarmchart(varargin)
  narginchk(2, 1000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [parent, args] = graphicsParseParent(args);
  [x, y, args] = parseSwarmData(args);
  [opts, scatterArgs] = parseSwarmOptions(args);
  ax = graphicsTargetAxes(parent);
  h = scatter(ax, x(:), y(:), scatterArgs{:});
  h.XJitter = opts.XJitter;
  h.XJitterWidth = swarmJitterWidth(x, opts.XJitterWidth);
  expandSwarmJitterLimit(ax, x, opts.XJitter, h.XJitterWidth, 'X');
  h.UserData = struct('ChartType', 'swarmchart', 'XDataOriginal', x, ...
    'YDataOriginal', y, 'Options', opts);
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [x, y, args] = parseSwarmData(args)
  if (istable(args{1}) || istimetable(args{1})) && numel(args) >= 3
    x = graphicsTableVariable(args{1}, args{2});
    y = graphicsTableVariable(args{1}, args{3});
    args = args(4:end);
  elseif numel(args) >= 2
    x = args{1};
    y = args{2};
    args = args(3:end);
  else
    error('Nelson:swarmchart:xAndYExpected', 'X and Y data expected.');
  end
  if ~isnumeric(x) || ~isnumeric(y) || numel(x) ~= numel(y)
    error('Nelson:swarmchart:invalidXAndY', 'X and Y must be numeric arrays with the same number of elements.');
  end
end
%=============================================================================
function [opts, scatterArgs] = parseSwarmOptions(args)
  opts = struct('XJitter', 'density', 'XJitterWidth', [], 'ColorVariable', []);
  scatterArgs = {};
  k = 1;
  while k <= length(args)
    if ischar(args{k}) && k < length(args)
      name = lower(args{k});
      value = args{k + 1};
      switch name
        case 'xjitter'
          opts.XJitter = lower(char(value));
          k = k + 2;
          continue
        case 'xjitterwidth'
          opts.XJitterWidth = double(value);
          k = k + 2;
          continue
        case 'colorvariable'
          opts.ColorVariable = value;
          k = k + 2;
          continue
      end
    end
    scatterArgs{end + 1} = args{k};
    k = k + 1;
  end
end
%=============================================================================
function width = swarmJitterWidth(x, requestedWidth)
  if ~isempty(requestedWidth)
    width = requestedWidth;
    return
  end
  levels = unique(double(x(:).'));
  if numel(levels) <= 1
    width = 0.9;
  else
    width = 0.9 * min(diff(levels));
  end
end
%=============================================================================
function expandSwarmJitterLimit(ax, values, jitterMode, jitterWidth, axisName)
  % The jitter spread is applied at render time, so the axis auto limits
  % (computed from the un-jittered category positions) would clip the
  % spread points. Widen the jittered axis by half the category spacing so
  % that the whole swarm stays visible.
  if strcmp(jitterMode, 'none')
    return
  end
  v = double(values(:).');
  v = v(isfinite(v));
  if isempty(v)
    return
  end
  levels = unique(v);
  if numel(levels) <= 1
    spacing = 1;
  else
    spacing = min(diff(levels));
  end
  margin = max(0.5 * spacing, 0.5 * jitterWidth);
  lo = min(levels) - margin;
  hi = max(levels) + margin;
  limName = [axisName, 'Lim'];
  current = get(ax, limName);
  set(ax, limName, [min(current(1), lo), max(current(2), hi)]);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = swarmchart3(varargin)
  narginchk(3, 1000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [parent, args] = graphicsParseParent(args);
  [x, y, z, args] = parseSwarm3Data(args);
  [opts, scatterArgs] = parseSwarm3Options(args);
  ax = graphicsTargetAxes(parent);
  h = scatter3(ax, x(:), y(:), z(:), scatterArgs{:});
  h.XJitter = opts.XJitter;
  h.XJitterWidth = swarmJitterWidth(x, opts.XJitterWidth);
  h.YJitter = opts.YJitter;
  h.YJitterWidth = swarmJitterWidth(y, opts.YJitterWidth);
  expandSwarmJitterLimit(ax, x, opts.XJitter, h.XJitterWidth, 'X');
  expandSwarmJitterLimit(ax, y, opts.YJitter, h.YJitterWidth, 'Y');
  view(ax, 3);
  h.UserData = struct('ChartType', 'swarmchart3', 'XDataOriginal', x, ...
    'YDataOriginal', y, 'ZDataOriginal', z, 'Options', opts);
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [x, y, z, args] = parseSwarm3Data(args)
  if (istable(args{1}) || istimetable(args{1})) && numel(args) >= 4
    x = graphicsTableVariable(args{1}, args{2});
    y = graphicsTableVariable(args{1}, args{3});
    z = graphicsTableVariable(args{1}, args{4});
    args = args(5:end);
  elseif numel(args) >= 3
    x = args{1};
    y = args{2};
    z = args{3};
    args = args(4:end);
  else
    error('Nelson:swarmchart3:xYAndExpected', 'X, Y, and Z data expected.');
  end
  if ~isnumeric(x) || ~isnumeric(y) || ~isnumeric(z) || numel(x) ~= numel(y) || numel(x) ~= numel(z)
    error('Nelson:swarmchart3:invalidXYAnd', 'X, Y, and Z must be numeric arrays with the same number of elements.');
  end
end
%=============================================================================
function [opts, scatterArgs] = parseSwarm3Options(args)
  opts = struct('XJitter', 'density', 'XJitterWidth', [], ...
    'YJitter', 'density', 'YJitterWidth', [], 'ColorVariable', []);
  scatterArgs = {};
  k = 1;
  while k <= length(args)
    if ischar(args{k}) && k < length(args)
      name = lower(args{k});
      value = args{k + 1};
      switch name
        case 'xjitter'
          opts.XJitter = lower(char(value));
          k = k + 2;
          continue
        case 'xjitterwidth'
          opts.XJitterWidth = double(value);
          k = k + 2;
          continue
        case 'yjitter'
          opts.YJitter = lower(char(value));
          k = k + 2;
          continue
        case 'yjitterwidth'
          opts.YJitterWidth = double(value);
          k = k + 2;
          continue
        case 'colorvariable'
          opts.ColorVariable = value;
          k = k + 2;
          continue
      end
    end
    scatterArgs{end + 1} = args{k};
    k = k + 1;
  end
end
%=============================================================================
function width = swarmJitterWidth(values, requestedWidth)
  if ~isempty(requestedWidth)
    width = requestedWidth;
    return
  end
  levels = unique(double(values(:).'));
  if numel(levels) <= 1
    width = 0.9;
  else
    width = 0.9 * min(diff(levels));
  end
end
%=============================================================================
function expandSwarmJitterLimit(ax, values, jitterMode, jitterWidth, axisName)
  % The jitter spread is applied at render time, so the axis auto limits
  % (computed from the un-jittered category positions) would clip the
  % spread points. Widen the jittered axis by half the category spacing so
  % that the whole swarm stays visible.
  if strcmp(jitterMode, 'none')
    return
  end
  v = double(values(:).');
  v = v(isfinite(v));
  if isempty(v)
    return
  end
  levels = unique(v);
  if numel(levels) <= 1
    spacing = 1;
  else
    spacing = min(diff(levels));
  end
  margin = max(0.5 * spacing, 0.5 * jitterWidth);
  lo = min(levels) - margin;
  hi = max(levels) + margin;
  limName = [axisName, 'Lim'];
  current = get(ax, limName);
  set(ax, limName, [min(current(1), lo), max(current(2), hi)]);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = text(varargin)
  % h = text(x, y, label)
  % h = text(x, y, z, label)
  % h = text(ax, x, y, label)
  % h = text(ax, x, y, z, label)
  % h = text(PropertyName, PropertyValue, ...)
  % h = text(ax, PropertyName, PropertyValue, ...)

  narginchk(0, 10000);
  nargoutchk(0, 1);
  inputArguments = convertStringToCharArgs(varargin);
  parent = [];
  if (~isempty(inputArguments) && isscalar(inputArguments{1}) && (isgraphics(inputArguments{1}, 'axes') || isgraphics(inputArguments{1}, 'hggroup')))
    parent = inputArguments{1};
    inputArguments = inputArguments(2:end);
  end

  % text() and text(PropertyName, PropertyValue, ...) take the position from
  % the 'Position' property instead of the positional x, y and z arguments.
  if (isempty(inputArguments) || ischar(inputArguments{1}))
    [parent, inputArguments] = extractParentProperty(parent, inputArguments);
    H = __text__('Parent', parent, inputArguments{:});
    if (nargout == 1)
      varargout{1} = H;
    end
    return
  end

  narginchk(3, 10000);
  if isempty(parent)
    parent = gca();
  end

  if isnumeric(inputArguments{1})
    x = inputArguments{1};
    inputArguments = inputArguments(2:end);
  else
    error('Nelson:text:invalidInputArgument', 'Invalid input argument: numeric value expected.')
  end
  if isnumeric(inputArguments{1})
    y = inputArguments{1};
    inputArguments = inputArguments(2:end);
  else
    error('Nelson:text:invalidInputArgument', 'Invalid input argument: numeric value expected.')
  end
  if isnumeric(inputArguments{1})
    z = inputArguments{1};
    inputArguments = inputArguments(2:end);
  else
    z = zeros(size(x));
  end

  if (length(x) ~= length(y))
    error('Nelson:text:invalidVectorsXAnd', 'Vectors x and %s must be the same length.', 'y');
  end
  if (length(x) ~= length(z))
    error('Nelson:text:invalidVectorsXAnd', 'Vectors x and %s must be the same length.', 'z');
  end

  if numel(inputArguments) == 0
    error('Nelson:text:invalidLastArgument', 'last argument must be a string or cell of strings.')
  end
  if ischar(inputArguments{1})
    labelArray = charToLabel(inputArguments{1}, length(x));
  elseif iscell(inputArguments{1})
    labelArray = cellToLabel(inputArguments{1}, length(x));
  elseif isstring(inputArguments{1})
    labelArray = stringToLabel(inputArguments{1}, length(x));
  else
    error('Nelson:text:invalidLastArgument', 'last argument must be a string or cell of strings.')
  end
  inputArguments = inputArguments(2:end);
  [parent, inputArguments] = extractParentProperty(parent, inputArguments);
  H = [];
  for (i = 1:numel(x))
    H = [H, __text__('Parent', parent, 'Position', [x(i), y(i), z(i)], 'String', labelArray{i}, inputArguments{1:end})];
  end
  if (nargout == 1)
    varargout{1} = H;
  end
end
%=============================================================================
function [parent, inputArguments] = extractParentProperty(parent, inputArguments)
  if (mod(numel(inputArguments), 2) ~= 0)
    error('Nelson:graphics:pvPairsExpected', 'Property/value pairs expected.');
  end
  parentIndex = [];
  for k = 1:2:numel(inputArguments)
    if (ischar(inputArguments{k}) && strcmpi(inputArguments{k}, 'Parent'))
      parentIndex = k;
    end
  end
  if ~isempty(parentIndex)
    parent = inputArguments{parentIndex + 1};
    inputArguments(parentIndex:parentIndex + 1) = [];
  elseif isempty(parent)
    parent = gca();
  end
end
%=============================================================================
function labelArray = charToLabel(value, len)
  label = value;
  labelArray = repmat({label}, [len, 1]);
end
%=============================================================================
function labelArray = stringToLabel(value, len)
  if isscalar(value)
    labelArray = repmat({stringScalarToChar(value)}, [len, 1]);
  elseif len == 1
    labelArray = {stringArrayToText(value)};
  elseif numel(value) == len
    labelArray = cell(len, 1);
    for idx = 1:len
      labelArray{idx} = stringScalarToChar(value(idx));
    end
  else
    error('Nelson:text:invalidNumberOfText', 'Number of text labels must match the number of positions.');
  end
end
%=============================================================================
function labelArray = cellToLabel(value, len)
  if len == 1
    labelArray = {cellElementsToText(value)};
  elseif numel(value) == len
    labelArray = cell(len, 1);
    for idx = 1:len
      labelArray{idx} = labelValueToChar(value{idx});
    end
  elseif numel(value) == 1
    labelArray = repmat({labelValueToChar(value{1})}, [len, 1]);
  else
    error('Nelson:text:invalidNumberOfText', 'Number of text labels must match the number of positions.');
  end
end
%=============================================================================
function label = cellElementsToText(value)
  label = '';
  for idx = 1:numel(value)
    line = labelValueToChar(value{idx});
    if idx == 1
      label = line;
    else
      label = [label, char(10), line];
    end
  end
end
%=============================================================================
function label = labelValueToChar(value)
  if ischar(value)
    label = value;
  elseif isstring(value)
    if isscalar(value)
      label = stringScalarToChar(value);
    else
      label = stringArrayToText(value);
    end
  elseif iscell(value)
    label = cellElementsToText(value);
  elseif isnumeric(value)
    label = sprintf('%g', value);
  else
    error('Nelson:text:invalidTextLabel', 'Text label must be a string, a cell of strings, or a numeric value.');
  end
end
%=============================================================================
function label = stringArrayToText(value)
  label = '';
  for idx = 1:numel(value)
    line = stringScalarToChar(value(idx));
    if idx == 1
      label = line;
    else
      label = [label, char(10), line];
    end
  end
end
%=============================================================================
function label = stringScalarToChar(value)
  if ismissing(value)
    label = '';
  else
    label = char(value);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
