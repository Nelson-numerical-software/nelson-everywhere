%=============================================================================
function obj = subsasgn(obj, S, value)
  if strcmp(S(1).type, '()')
    obj = localAssignDatetimeElements(obj, S, value);
    return
  end
  if strcmp(S(1).type, '.')
    obj = localAssignDatetimeProperty(obj, S(1).subs, value);
    return
  end
  error('Nelson:time:invalidDatetimeAssignment', 'Invalid %s.', 'datetime assignment');
end
%=============================================================================
function obj = localAssignDatetimeElements(obj, S, value)
  serial = datenum(obj);
  if isa(value, 'missing')
    serial(S(1).subs{:}) = NaN(size(value));
  else
    if ~isa(value, 'datetime')
      value = datetime(value);
    end
    serial(S(1).subs{:}) = datenum(value);
  end
  % Elements created by growing the array are NaT, not serial day zero.
  assigned = true(size(datenum(obj)));
  assigned(S(1).subs{:}) = true;
  serial(~assigned) = NaN;
  obj.SerialValue = serial;
  obj.TimeMillis = [];
end
%=============================================================================
function obj = localAssignDatetimeProperty(obj, name, value)
  switch name
    case 'Format'
      obj.Format = value;
    case 'TimeZone'
      obj.TimeZone = value;
    case 'Year'
      obj = datetime.setComponent(obj, 1, value);
    case 'Month'
      obj = datetime.setComponent(obj, 2, value);
    case 'Day'
      obj = datetime.setComponent(obj, 3, value);
    case 'Hour'
      obj = datetime.setComponent(obj, 4, value);
    case 'Minute'
      obj = datetime.setComponent(obj, 5, value);
    case 'Second'
      obj = datetime.setComponent(obj, 6, value);
    otherwise
      error('Nelson:time:invalidDatetimeProperty', 'Invalid %s.', 'datetime property');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = subsref(obj, S)
  if strcmp(S(1).type, '()')
    serial = datenum(obj);
    millis = datetime.storedMillis(obj);
    if ~isempty(millis)
      millis = millis(S(1).subs{:});
    end
    out = datetime.fromSerial(serial(S(1).subs{:}), obj.FormatValue, obj.TimeZoneValue, millis);
    if numel(S) > 1
      varargout{1} = subsref(out, S(2:end));
    else
      varargout{1} = out;
    end
    return
  end
  if strcmp(S(1).type, '.')
    value = localDatetimeReference(obj, S(1).subs);
    if numel(S) > 1
      value = subsref(value, S(2:end));
    end
    varargout{1} = value;
    return
  end
  error('Nelson:time:invalidDatetimeIndexing', 'Invalid %s.', 'datetime indexing');
end
%=============================================================================
function value = localDatetimeReference(obj, name)
  switch name
    case 'Format'
      value = datetime.resolveDisplayFormat(obj.FormatValue, datetime.rawSerial(obj));
    case 'TimeZone'
      value = obj.TimeZoneValue;
    case 'Year'
      value = datetime.component(obj, 1);
    case 'Month'
      value = datetime.component(obj, 2);
    case 'Day'
      value = datetime.component(obj, 3);
    case 'Hour'
      value = datetime.component(obj, 4);
    case 'Minute'
      value = datetime.component(obj, 5);
    case 'Second'
      value = datetime.component(obj, 6);
    case {'SerialValue', 'FormatValue', 'TimeZoneValue'}
      state = builtin('struct', obj);
      value = state.(name);
    otherwise
      error('Nelson:time:unknownProperty', ['Invalid datetime property: ', name]);
  end
end
