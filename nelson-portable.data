function mdl = fitrtree(X, Y, varargin)
  narginchk(2, Inf);
  nargoutchk(0, 1);
  [X, y] = __regression_training_data__(X, Y);
  if rem(length(varargin), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  opts = parseOptionsLocal(varargin, size(X, 1), size(X, 2));
  tree = growTreeLocal(X, y, opts);
  mdl = RegressionTree();
  mdl.CutPredictor = tree.CutPredictor;
  mdl.CutPoint = tree.CutPoint;
  mdl.LeftChild = tree.LeftChild;
  mdl.RightChild = tree.RightChild;
  mdl.NodeMean = tree.NodeMean;
  mdl.NodeError = tree.NodeError;
  mdl.NodeSize = tree.NodeSize;
  mdl.IsBranch = tree.IsBranch;
  mdl.MaxNumSplits = opts.MaxNumSplits;
  mdl.MinLeafSize = opts.MinLeafSize;
  mdl.MinParentSize = opts.MinParentSize;
  mdl.PredictorNames = opts.PredictorNames;
  mdl.ResponseName = opts.ResponseName;
  mdl.NumObservations = size(X, 1);
  mdl.NumPredictors = size(X, 2);
  yfit = predict(mdl, X);
  mdl.ResubstitutionLoss = mean((y - yfit) .^ 2);
end
%=============================================================================
function opts = parseOptionsLocal(args, n, p)
  opts = struct('MaxNumSplits', max(n - 1, 0), 'MinLeafSize', 1, 'MinParentSize', 10, ...
    'PredictorNames', {__default_predictor_names__(p)}, 'ResponseName', 'y');
  for k = 1:2:length(args)
    name = __option_name__(args{k}, {'maxnumsplits', 'minleafsize', 'minparentsize', ...
      'predictornames', 'responsename'});
    value = args{k + 1};
    switch name
      case 'maxnumsplits'
        opts.MaxNumSplits = nonnegativeIntegerLocal(value, 'MaxNumSplits');
      case 'minleafsize'
        opts.MinLeafSize = positiveIntegerLocal(value, 'MinLeafSize');
      case 'minparentsize'
        opts.MinParentSize = positiveIntegerLocal(value, 'MinParentSize');
      case 'predictornames'
        opts.PredictorNames = __predictor_names__(value, p);
      case 'responsename'
        opts.ResponseName = __response_name__(value);
    end
  end
end
%=============================================================================
function tree = growTreeLocal(X, y, opts)
  tree = emptyTreeLocal();
  tree = appendNodeLocal(tree, y);
  nodeRows = {1:length(y)};
  queue = 1;
  splits = 0;
  while ~isempty(queue) && splits < opts.MaxNumSplits
    node = queue(1);
    queue(1) = [];
    rows = nodeRows{node};
    split = bestSplitLocal(X(rows, :), y(rows), opts);
    if ~split.Valid
      continue
    end
    tree.IsBranch(node) = true;
    tree.CutPredictor(node) = split.Predictor;
    tree.CutPoint(node) = split.CutPoint;
    leftRows = rows(split.LeftMask);
    rightRows = rows(~split.LeftMask);
    tree = appendNodeLocal(tree, y(leftRows));
    leftNode = length(tree.IsBranch);
    tree = appendNodeLocal(tree, y(rightRows));
    rightNode = length(tree.IsBranch);
    tree.LeftChild(node) = leftNode;
    tree.RightChild(node) = rightNode;
    nodeRows{leftNode} = leftRows;
    nodeRows{rightNode} = rightRows;
    queue = [queue, leftNode, rightNode];
    splits = splits + 1;
  end
end
%=============================================================================
function tree = emptyTreeLocal()
  tree = struct('CutPredictor', [], 'CutPoint', [], 'LeftChild', [], 'RightChild', [], ...
    'NodeMean', [], 'NodeError', [], 'NodeSize', [], 'IsBranch', []);
end
%=============================================================================
function tree = appendNodeLocal(tree, y)
  tree.CutPredictor(end + 1, 1) = 0;
  tree.CutPoint(end + 1, 1) = NaN;
  tree.LeftChild(end + 1, 1) = 0;
  tree.RightChild(end + 1, 1) = 0;
  tree.NodeMean(end + 1, 1) = mean(y);
  tree.NodeError(end + 1, 1) = sseLocal(y);
  tree.NodeSize(end + 1, 1) = length(y);
  tree.IsBranch(end + 1, 1) = false;
end
%=============================================================================
function split = bestSplitLocal(X, y, opts)
  split = struct('Valid', false, 'Predictor', 0, 'CutPoint', NaN, 'LeftMask', [], 'Gain', 0);
  if length(y) < opts.MinParentSize || sseLocal(y) <= eps
    return
  end
  parentError = sseLocal(y);
  for p = 1:size(X, 2)
    candidate = bestPredictorSplitLocal(X(:, p), y, parentError, opts);
    if candidate.Valid && candidate.Gain > split.Gain
      split.Valid = true;
      split.Predictor = p;
      split.CutPoint = candidate.CutPoint;
      split.LeftMask = X(:, p) <= candidate.CutPoint;
      split.Gain = candidate.Gain;
    end
  end
end
%=============================================================================
function candidate = bestPredictorSplitLocal(x, y, parentError, opts)
  candidate = struct('Valid', false, 'CutPoint', NaN, 'Gain', 0);
  [xs, order] = sort(x(:));
  ys = y(order);
  boundary = find(diff(xs) ~= 0);
  if isempty(boundary)
    return
  end
  boundary = boundary(boundary >= opts.MinLeafSize & length(y) - boundary >= opts.MinLeafSize);
  if isempty(boundary)
    return
  end
  csum = cumsum(ys);
  csum2 = cumsum(ys .^ 2);
  leftN = boundary(:);
  rightN = length(y) - leftN;
  leftSum = csum(leftN);
  leftSum2 = csum2(leftN);
  rightSum = csum(end) - leftSum;
  rightSum2 = csum2(end) - leftSum2;
  leftError = max(leftSum2 - (leftSum .^ 2) ./ leftN, 0);
  rightError = max(rightSum2 - (rightSum .^ 2) ./ rightN, 0);
  [gain, idx] = max(parentError - leftError - rightError);
  if gain > eps
    pos = leftN(idx);
    candidate.Valid = true;
    candidate.CutPoint = (xs(pos) + xs(pos + 1)) / 2;
    candidate.Gain = gain;
  end
end
%=============================================================================
function value = sseLocal(y)
  value = sum((y - mean(y)) .^ 2);
end
%=============================================================================
function value = positiveIntegerLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) ...
      && value > 0 && value == fix(value))
    error('Nelson:statistics:mustBePositiveInteger', '%s must be a positive integer scalar.', name);
  end
  value = double(value);
end
%=============================================================================
function value = nonnegativeIntegerLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) ...
      && value >= 0 && value == fix(value))
    error('Nelson:statistics:mustBeNonnegativeInteger', '%s must be a nonnegative integer scalar.', name);
  end
  value = double(value);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [p, tbl, stats] = friedman(X, reps, displayopt)
  narginchk(1, 3);
  nargoutchk(0, 3);
  hasDisplay = nargin >= 3;
  if nargin < 2
    reps = 1;
  elseif nargin == 2 && isDisplayOptionLocal(reps)
    displayopt = reps;
    reps = 1;
    hasDisplay = true;
  end
  if ~hasDisplay
    displayopt = 'on';
  end
  displayopt = parseDisplayLocal(displayopt);
  X = validateDataLocal(X);
  reps = validateRepsLocal(reps, size(X, 1));
  result = friedmanTableLocal(X, reps);
  p = result.p;
  tbl = result.tbl;
  stats = result.stats;
  if strcmp(displayopt, 'on')
    disp(tbl);
  end
end
%=============================================================================
function X = validateDataLocal(X)
  if ~(isnumeric(X) && isreal(X) && ~issparse(X) && ndims(X) == 2)
    error('Nelson:statistics:xRealNumericMatrix', '%s must be a real numeric matrix.', 'X');
  end
  X = double(X);
  if isempty(X) || any(isnan(X(:)))
    error('Nelson:statistics:xContainNonNaNObservations', 'X must contain non-NaN observations.');
  end
  if size(X, 1) < 2 || size(X, 2) < 2
    error('Nelson:statistics:xLeastTwoRowsTwo', '%s must have at least two rows and two columns.', 'X');
  end
end
%=============================================================================
function reps = validateRepsLocal(reps, nrows)
  if ~(isnumeric(reps) && isreal(reps) && isscalar(reps) && isfinite(reps) ...
      && reps >= 1 && floor(reps) == reps)
    error('Nelson:statistics:REPSPositiveIntegerScalar', '%s must be a positive integer scalar.', 'REPS');
  end
  reps = double(reps);
  if rem(nrows, reps) ~= 0
    error('Nelson:statistics:numberRowsXMultipleREPS', '%s must be a multiple of REPS.', 'The number of rows in X');
  end
  if nrows / reps < 2
    error('Nelson:statistics:xContainLeastTwoBlock', 'X must contain at least two block levels.');
  end
end
%=============================================================================
function result = friedmanTableLocal(X, reps)
  nBlocks = size(X, 1) / reps;
  nTreatments = size(X, 2);
  [rankSums, blockTieSum] = treatmentRankSumsLocal(X, reps, nBlocks, nTreatments);
  correction = tieCorrectionLocal(blockTieSum, nBlocks, nTreatments);
  chiSquare = friedmanStatisticLocal(rankSums, nBlocks, reps, nTreatments, correction);
  dfTreatments = nTreatments - 1;
  p = chi2cdf(chiSquare, dfTreatments, 'upper');
  ssTreatments = sum(rankSums .^ 2) / (nBlocks * reps) ...
    - nBlocks * reps * nTreatments * (nTreatments + 1) ^ 2 / 4;
  ssTotal = nBlocks * reps * nTreatments * (nTreatments ^ 2 - 1) / 12;
  ssError = ssTotal - ssTreatments;
  result.p = p;
  result.tbl = cellTableLocal(ssTreatments, ssError, ssTotal, dfTreatments, nBlocks, reps, chiSquare, p);
  result.stats = struct('source', 'friedman', 'n', nBlocks, 'reps', reps, ...
    'meanranks', rankSums / (nBlocks * reps), 'sumranks', rankSums, 'df', dfTreatments);
end
%=============================================================================
function [rankSums, blockTieSum] = treatmentRankSumsLocal(X, reps, nBlocks, nTreatments)
  rankSums = zeros(1, nTreatments);
  blockTieSum = 0;
  for b = 1:nBlocks
    rows = (b - 1) * reps + 1:b * reps;
    block = X(rows, :);
    for r = 1:reps
      [ranks, tieSum] = tiedRanksRowLocal(block(r, :));
      rankSums = rankSums + ranks;
      blockTieSum = blockTieSum + tieSum;
    end
  end
end
%=============================================================================
function [ranks, tieSum] = tiedRanksRowLocal(values)
  [sortedValues, order] = sort(values(:));
  k = length(sortedValues);
  ranks = zeros(1, k);
  tieSum = 0;
  starts = [1; find(diff(sortedValues) ~= 0) + 1];
  stops = [starts(2:end) - 1; k];
  for j = 1:length(starts)
    rows = starts(j):stops(j);
    ranks(order(rows)) = (starts(j) + stops(j)) / 2;
    tieLength = stops(j) - starts(j) + 1;
    tieSum = tieSum + tieLength ^ 3 - tieLength;
  end
end
%=============================================================================
function correction = tieCorrectionLocal(blockTieSum, nBlocks, nTreatments)
  denominator = nBlocks * (nTreatments ^ 3 - nTreatments);
  correction = 1 - blockTieSum / denominator;
end
%=============================================================================
function value = friedmanStatisticLocal(rankSums, nBlocks, reps, nTreatments, correction)
  value = 12 / (nBlocks * reps * nTreatments * (nTreatments + 1)) * sum(rankSums .^ 2) ...
    - 3 * nBlocks * reps * (nTreatments + 1);
  if correction == 0
    value = 0;
  else
    value = value / correction;
  end
end
%=============================================================================
function tbl = cellTableLocal(ssTreatments, ssError, ssTotal, dfTreatments, nBlocks, reps, chiSquare, p)
  tbl = {'Source', 'SS', 'df', 'Chi-sq', 'Prob>Chi-sq'; ...
         'Columns', ssTreatments, dfTreatments, chiSquare, p; ...
         'Error', ssError, (nBlocks * reps - 1) * dfTreatments, [], []; ...
         'Total', ssTotal, nBlocks * reps * dfTreatments, [], []};
end
%=============================================================================
function opt = parseDisplayLocal(value)
  if ~isDisplayOptionLocal(value)
    error('Nelson:statistics:displayOptionOff', 'Display option must be ''on'' or ''off''.');
  end
  opt = lower(char(value));
end
%=============================================================================
function tf = isDisplayOptionLocal(value)
  tf = false;
  if isTextScalarLocal(value)
    text = lower(char(value));
    tf = strcmp(text, 'on') || strcmp(text, 'off');
  end
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [idx, scores] = fsrftest(X, Y, varargin)
  narginchk(2, Inf);
  nargoutchk(0, 2);
  [X, Y, opts] = parseInputsLocal(X, Y, convertStringToCharArgs(varargin));
  scores = zeros(1, size(X, 2));
  for j = 1:size(X, 2)
    scores(j) = predictorScoreLocal(X(:, j), Y, opts.CategoricalPredictors(j), opts);
  end
  [~, idx] = sort(scores, 'descend');
end
%=============================================================================
function [X, Y, opts] = parseInputsLocal(X, Y, args)
  if ~(isnumeric(X) && isreal(X) && ~issparse(X) && ndims(X) == 2)
    error('Nelson:statistics:xRealNumericMatrix', '%s must be a real numeric matrix.', 'X');
  end
  if ~(isnumeric(Y) && isreal(Y) && isvector(Y))
    error('Nelson:statistics:yRealNumericVector', '%s must be a real numeric vector.', 'Y');
  end
  if size(X, 1) ~= length(Y)
    error('Nelson:statistics:xYSameNumberRows', '%s must have the same number of rows.', 'X and Y');
  end
  X = double(X);
  Y = double(Y(:));
  if isempty(X) || size(X, 2) == 0
    error('Nelson:statistics:xContainLeastOnePredictor', 'X must contain at least one predictor.');
  end
  if any(isinf(X(:))) || any(isinf(Y(:)))
    error('Nelson:statistics:xYContainInfValues', '%s must not contain Inf values.', 'X and Y');
  end
  opts = defaultOptionsLocal(size(X, 2), size(X, 1));
  opts = parseNameValuesLocal(opts, args);
  opts.CategoricalPredictors = parseCategoricalLocal(opts.CategoricalPredictors, size(X, 2));
  opts.NumBins = parseNumBinsLocal(opts.NumBins);
  opts.UseMissing = parseLogicalScalarLocal(opts.UseMissing, 'UseMissing');
  opts.Weights = parseWeightsLocal(opts.Weights, size(X, 1));
end
%=============================================================================
function opts = defaultOptionsLocal(nvars, nobs)
  opts = struct('CategoricalPredictors', false(1, nvars), ...
    'NumBins', 10, 'UseMissing', false, 'Weights', ones(nobs, 1));
end
%=============================================================================
function opts = parseNameValuesLocal(opts, args)
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  for k = 1:2:length(args)
    if ~isTextScalarLocal(args{k})
      error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Name');
    end
    name = lower(char(args{k}));
    switch name
      case 'categoricalpredictors'
        opts.CategoricalPredictors = args{k + 1};
      case 'numbins'
        opts.NumBins = args{k + 1};
      case 'usemissing'
        opts.UseMissing = args{k + 1};
      case 'weights'
        opts.Weights = args{k + 1};
      otherwise
        error('Nelson:statistics:unknownOption', 'Unknown option.');
    end
  end
end
%=============================================================================
function categorical = parseCategoricalLocal(value, nvars)
  categorical = false(1, nvars);
  if isempty(value)
    return
  end
  if isTextScalarLocal(value)
    switch lower(char(value))
      case 'all'
        categorical(:) = true;
      case 'none'
        categorical(:) = false;
      otherwise
        error('Nelson:statistics:categoricalPredictorsInvalidValue', '%s has an invalid value.', 'CategoricalPredictors');
    end
  elseif islogical(value) && isvector(value)
    if length(value) ~= nvars
      error('Nelson:statistics:categoricalPredictorsMatchNumberPredictors', '%s must match the number of predictors.', 'CategoricalPredictors');
    end
    categorical = value(:)' ~= 0;
  elseif isnumeric(value) && isreal(value) && isvector(value)
    idx = double(value(:))';
    if any(~isfinite(idx)) || any(floor(idx) ~= idx) || any(idx < 1) || any(idx > nvars)
      error('Nelson:statistics:categoricalPredictorsContainsInvalidPredictorIndices', '%s contains invalid predictor indices.', 'CategoricalPredictors');
    end
    categorical(idx) = true;
  else
    error('Nelson:statistics:categoricalPredictorsInvalidValue', '%s has an invalid value.', 'CategoricalPredictors');
  end
end
%=============================================================================
function numBins = parseNumBinsLocal(numBins)
  if ~(isnumeric(numBins) && isreal(numBins) && isscalar(numBins) ...
      && isfinite(numBins) && floor(numBins) == numBins && numBins >= 2)
    error('Nelson:statistics:numBinsIntegerScalarGreaterOne', 'NumBins must be an integer scalar greater than one.');
  end
  numBins = double(numBins);
end
%=============================================================================
function weights = parseWeightsLocal(weights, nobs)
  if ~(isnumeric(weights) && isreal(weights) && isvector(weights) && length(weights) == nobs)
    error('Nelson:statistics:weightsRealNumericVectorOne', 'Weights must be a real numeric vector with one value per observation.');
  end
  weights = double(weights(:));
  if any(~isfinite(weights)) || any(weights < 0) || sum(weights) <= 0
    error('Nelson:statistics:weightsContainNonnegativeFiniteValues:valueContainNonnegativeFiniteValuesPositive', '%s must contain nonnegative finite values with positive sum.', 'Weights');
  end
end
%=============================================================================
function score = predictorScoreLocal(x, y, categorical, opts)
  valid = validRowsLocal(x, y, opts.Weights, opts.UseMissing);
  x = x(valid);
  y = y(valid);
  weights = opts.Weights(valid);
  if length(y) < 3 || weightedVarianceLocal(y, weights) <= 0
    score = 0;
  elseif categorical
    score = categoricalScoreLocal(x, y, weights, opts.UseMissing);
  else
    score = continuousScoreLocal(x, y, weights, opts);
  end
  if ~isfinite(score) || score < 0
    score = 0;
  end
end
%=============================================================================
function valid = validRowsLocal(x, y, weights, useMissing)
  valid = weights > 0 & ~isnan(y);
  if ~useMissing
    valid = valid & ~isnan(x);
  end
end
%=============================================================================
function score = continuousScoreLocal(x, y, weights, opts)
  if opts.NumBins > 2 && length(unique(x(~isnan(x)))) > opts.NumBins
    groups = binContinuousLocal(x, opts.NumBins, opts.UseMissing);
    score = anovaScoreLocal(groups, y, weights);
  else
    score = linearScoreLocal(x, y, weights);
  end
end
%=============================================================================
function score = linearScoreLocal(x, y, weights)
  keep = ~isnan(x);
  x = x(keep);
  y = y(keep);
  weights = weights(keep);
  if length(y) < 3 || weightedVarianceLocal(x, weights) <= 0
    score = 0;
    return
  end
  mx = weightedMeanLocal(x, weights);
  my = weightedMeanLocal(y, weights);
  sx = sum(weights .* (x - mx) .^ 2);
  sy = sum(weights .* (y - my) .^ 2);
  sxy = sum(weights .* (x - mx) .* (y - my));
  r2 = min(max((sxy ^ 2) / max(sx * sy, realmin), 0), 1);
  if r2 >= 1
    score = realmax;
  else
    score = (r2 / max(1 - r2, realmin)) * max(length(y) - 2, 1);
  end
end
%=============================================================================
function score = categoricalScoreLocal(x, y, weights, useMissing)
  if useMissing && any(isnan(x))
    missingCode = max(x(~isnan(x))) + 1;
    if isempty(missingCode) || ~isfinite(missingCode)
      missingCode = 1;
    end
    x(isnan(x)) = missingCode;
  end
  score = anovaScoreLocal(x, y, weights);
end
%=============================================================================
function score = anovaScoreLocal(groups, y, weights)
  [labels, ~, groupIndex] = unique(groups(:));
  validLabels = ~isnan(labels);
  labels = labels(validLabels);
  if length(labels) < 2
    score = 0;
    return
  end
  grandMean = weightedMeanLocal(y, weights);
  between = 0;
  within = 0;
  nonempty = 0;
  validOriginal = find(validLabels);
  for k = 1:length(labels)
    keep = groupIndex == validOriginal(k);
    if ~any(keep)
      continue
    end
    wk = weights(keep);
    yk = y(keep);
    groupMean = weightedMeanLocal(yk, wk);
    between = between + sum(wk) * (groupMean - grandMean) ^ 2;
    within = within + sum(wk .* (yk - groupMean) .^ 2);
    nonempty = nonempty + 1;
  end
  dfBetween = max(nonempty - 1, 1);
  dfWithin = max(length(y) - nonempty, 1);
  if within <= 0
    if between > 0
      score = realmax;
    else
      score = 0;
    end
  else
    score = (between / dfBetween) / max(within / dfWithin, realmin);
  end
end
%=============================================================================
function groups = binContinuousLocal(x, numBins, useMissing)
  groups = NaN(size(x));
  keep = ~isnan(x);
  values = x(keep);
  [~, order] = sort(values);
  binNumbers = ceil((1:length(values)) * numBins / max(length(values), 1));
  binNumbers(binNumbers < 1) = 1;
  binNumbers(binNumbers > numBins) = numBins;
  temp = zeros(size(values));
  temp(order) = binNumbers;
  groups(keep) = temp;
  if useMissing && any(~keep)
    groups(~keep) = numBins + 1;
  end
end
%=============================================================================
function value = weightedMeanLocal(x, weights)
  value = sum(weights .* x) / sum(weights);
end
%=============================================================================
function value = weightedVarianceLocal(x, weights)
  keep = ~isnan(x);
  x = x(keep);
  weights = weights(keep);
  if isempty(x) || sum(weights) <= 0
    value = 0;
    return
  end
  mu = weightedMeanLocal(x, weights);
  value = sum(weights .* (x - mu) .^ 2) / sum(weights);
end
%=============================================================================
function tf = parseLogicalScalarLocal(value, name)
  if islogical(value) && isscalar(value)
    tf = value ~= 0;
  elseif isnumeric(value) && isscalar(value) && (value == 0 || value == 1)
    tf = value ~= 0;
  else
    error('Nelson:validators:mustBeLogicalScalar', '%s must be a logical scalar.', name);
  end
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || isStringScalar(value);
end
