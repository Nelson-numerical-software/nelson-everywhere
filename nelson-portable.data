% LICENCE_BLOCK_END
%=============================================================================
function varargout = durationSizeValue(secondsValue, requestedOutputs, varargin)
  if requestedOutputs <= 1
    varargout{1} = size(secondsValue, varargin{:});
  else
    [varargout{1:requestedOutputs}] = size(secondsValue, varargin{:});
  end
end
