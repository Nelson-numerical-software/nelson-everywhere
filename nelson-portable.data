function [poolable, direct] = partition_poolable_test_cases(test_cases)
  mask = worker_pool_eligible_mask(test_cases);
  poolable = test_cases(mask);
  direct = test_cases(~mask);
  poolable = poolable(:);
  direct = direct(:);
end
