% LICENCE_BLOCK_END
function kind = discover_caseKind(name)
  if startsWith(name, 'bench_')
    kind = 'bench';
  elseif startsWith(name, 'bug_')
    kind = 'bug';
  else
    kind = 'test';
  end
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function timeout = discover_defaultTimeout(kind, tagTimeout)
  if nargin < 2
    tagTimeout = 0;
  end
  if tagTimeout > 0
    timeout = tagTimeout;
    return
  end
  if strcmp(kind, 'bench')
    timeout = 380;
  else
    timeout = 140;
  end
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function files = discover_discoverDirectoryFiles(testsDir, kind)
  files = {};
  if ~isdir(testsDir)
    return
  end
  patterns = discover_patternsForKind(kind);
  for pattern = patterns
    entries = dir([testsDir, pattern{1}]);
    if ~isempty(entries)
      names = sort(string(strcat(testsDir, {entries.name})));
      files = [files; cell(names(:))];
    end
  end
end
﻿%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function files = discover_discoverFiles(targets, kind) %#ok<NLS0026>
  files = {};
  if isempty(targets)
    targets = getmodules();
  end
  if ischar(targets)
    targets = {targets};
  end
  for item = targets(:)'
    target = item{1};
    if isfile(target)
      files = discover_appendIfKind(files, target, kind);
    elseif ismodule(target)
      files = [files; discover_discoverModuleFiles(target, kind)];
    elseif isdir(target)
      files = [files; discover_discoverDirectoryFiles(target, kind)];
    end
  end
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function files = discover_discoverModuleFiles(moduleName, kind)
  try
    testsDir = [modulepath(moduleName), '/tests/'];
  catch
    testsDir = [nelsonroot(), '/modules/', moduleName, '/tests/'];
  end
  files = discover_discoverDirectoryFiles(testsDir, kind);
end
