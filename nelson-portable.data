% LICENCE_BLOCK_END
%=============================================================================
function n = end(A, index, count)
  sz = size(A.codes);
  if count == 1
    n = numel(A.codes);
  elseif index <= length(sz)
    n = sz(index);
  else
    n = 1;
  end
end
