%=============================================================================
function varargout = isspace(varargin)
  narginchk(1, 1);
  nargoutchk(0, 1);
  A = varargin{1};
  mustBeA(A, ["char", "string"], 1);
  if isstring(A)
    mustBeTextScalar(A, 1);
  end
  A = convertStringsToChars(A);
  % whitespace: space (32), tab (9), line feed (10),
  % vertical tab (11), form feed (12), carriage return (13)
  D = double(A);
  varargout{1} = (D == 32) | (D >= 9 & D <= 13);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
