function [b, a] = sos2tf(sos)
  narginchk(1, 1);
  nargoutchk(0, 2);
  if isempty(sos)
    b = 1;
    a = 1;
    return;
  end
  if ~ismatrix(sos) || size(sos, 2) ~= 6
    error('Nelson:signal:invalidSOSMatrix', 'SOS matrix must have six columns.');
  end
  b = 1;
  a = 1;
  for row = 1:size(sos, 1)
    b = conv(b, sos(row, 1:3));
    a = conv(a, sos(row, 4:6));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = sos2zp(sos)
  narginchk(1, 1);
  nargoutchk(0, 3);
  if isempty(sos)
    z = [];
    p = [];
    k = 1;
  else
    if ~ismatrix(sos) || size(sos, 2) ~= 6
      error('Nelson:signal:invalidSOSMatrix', 'SOS matrix must have six columns.');
    end
    z = [];
    p = [];
    k = 1;
    for row = 1:size(sos, 1)
      numerator = sos(row, 1:3);
      denominator = signalTrimTrailingZeros(sos(row, 4:6));
      sectionOrder = length(denominator);
      numerator = numerator(1:sectionOrder);
      z = [z; rootsWithTrailingZeros(numerator)];
      p = [p; roots(denominator)];
      k = k * numerator(1) / denominator(1);
    end
  end
  varargout{1} = z;
  if nargout > 1
    varargout{2} = p;
  end
  if nargout > 2
    varargout{3} = k;
  end
end
%=============================================================================
function r = rootsWithTrailingZeros(coefficients)
  trimmed = signalTrimTrailingZeros(coefficients);
  numberOfZeros = length(coefficients) - length(trimmed);
  r = roots(trimmed);
  if numberOfZeros > 0
    r = [r; zeros(numberOfZeros, 1)];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = sosfilt(sos, x, varargin)
  narginchk(2, 3);
  nargoutchk(0, 1);
  if ~ismatrix(sos) || size(sos, 2) ~= 6
    error('Nelson:signal:invalidSOSMatrix', 'SOS matrix must have six columns.');
  end
  dim = [];
  if nargin == 3
    dim = varargin{1};
  end
  y = x;
  for row = 1:size(sos, 1)
    if isempty(dim)
      y = filter(sos(row, 1:3), sos(row, 4:6), y);
    else
      y = filter(sos(row, 1:3), sos(row, 4:6), y, [], dim);
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = spectrogram(varargin)
  narginchk(1, 5);
  nargoutchk(0, 4);
  x = varargin{1}(:);
  if nargin >= 2 && ~isempty(varargin{2})
    window = varargin{2};
    if isscalar(window)
      window = hamming(window);
    else
      window = window(:);
    end
  else
    window = hamming(256);
  end
  if nargin >= 3 && ~isempty(varargin{3})
    overlap = varargin{3};
  else
    overlap = floor(length(window) / 2);
  end
  if nargin >= 4 && ~isempty(varargin{4})
    nfft = varargin{4};
  else
    nfft = max(256, 2 ^ nextpow2(length(window)));
  end
  if nargin == 5
    fs = varargin{5};
  else
    fs = 1;
  end
  [s, f, t] = signalSpectrogramCore(x, window, overlap, nfft, fs);
  p = abs(s) .^ 2 ./ (fs * sum(abs(window) .^ 2));
  if size(p, 1) > 2
    if mod(nfft, 2) == 0
      p(2:end - 1, :) = 2 * p(2:end - 1, :);
    else
      p(2:end, :) = 2 * p(2:end, :);
    end
  end
  if nargout == 0
    imagesc(t, f, pow2db(p));
  else
    varargout{1} = s;
    if nargout > 1
      varargout{2} = f;
    end
    if nargout > 2
      varargout{3} = t;
    end
    if nargout > 3
      varargout{4} = p;
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
