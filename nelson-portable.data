function varargout = ipermute(varargin)
  narginchk(2, 2);
  nargoutchk(0, 1);
  A = varargin{1};
  dimorder = varargin{2};
  dimreordered(dimorder) = 1:numel(dimorder);
  varargout{1} = permute(A, dimreordered);
end
