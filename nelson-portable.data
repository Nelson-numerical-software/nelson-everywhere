function [ax, args] = polarAxesForFunction(args)
  if ~isempty(args) && isscalar(args{1}) && (isgraphics(args{1}, 'axes') || isgraphics(args{1}, 'polaraxes'))
    ax = args{1};
    args(1) = [];
  else
    ax = gca();
  end
  if ~polarIsAxes(ax)
    error('Nelson:polarAxesForFunction:polarAxesExpected', 'Polar axes expected.');
  end
end
