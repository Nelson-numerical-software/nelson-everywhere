%=============================================================================
function R = sprand(varargin)
  narginchk(1, 3);
  if nargin == 2
    error('Nelson:sparse:invalidNumberInputArguments2', 'Invalid number of input arguments.');
  end
  R = randomSparse(@rand, varargin{:});
end
