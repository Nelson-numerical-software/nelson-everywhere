%=============================================================================
function disp(T)
  if isempty(T)
    return
  end
  if height(T) > 20
    table.dispTableCompact(T);
  else
    table.dispTableFull(T);
  end
  currentFormat = format();
  if strcmp(currentFormat.LineSpacing, 'loose')
    builtin('disp', ' ');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
classdef eventtable < table
  methods
    function obj = eventtable(eventTimes, varargin)
      narginchk(1, Inf);
      inputArguments = convertStringToCharArgs(varargin);
      opts = eventtable.defaultOptions();
      dataArgs = {};
      dataNames = {};
      if isa(eventTimes, 'timetable')
        [eventTimes, dataArgs, dataNames] = eventtable.fromTimetable(eventTimes);
      else
        eventtable.validateTimes(eventTimes);
      end
      k = 1;
      while k <= length(inputArguments)
        if eventtable.isOptionName(inputArguments{k})
          if k == length(inputArguments)
            error('Nelson:eventtable:nameValuePair', 'Name-value argument must be followed by a value.');
          end
          opts = eventtable.applyOption(opts, inputArguments{k}, inputArguments{k + 1});
          k = k + 2;
        else
          if eventtable.isTextScalar(inputArguments{k})
            error('Nelson:eventtable:invalidArgumentName', eventtable.invalidArgumentNameMessage(inputArguments{k}));
          end
          dataArgs{end + 1} = inputArguments{k};
          dataNames{end + 1} = inputname(k + 1);
          k = k + 1;
        end
      end

      eventTimes = eventTimes(:);
      nRows = eventtable.heightOf(eventTimes);
      [dataArgs, dataNames, opts] = eventtable.applyVectorOptions(dataArgs, dataNames, opts, nRows);
      for k = 1:length(dataArgs)
        if eventtable.heightOf(dataArgs{k}) ~= nRows
          error('Nelson:eventtable:dimagree', 'Event data variables must match the number of event times.');
        end
      end

      if isempty(dataArgs)
        dataArgs = {eventtable.defaultLabels(nRows)};
        dataNames = {'EventLabels'};
        opts.EventLabelsVariable = 'EventLabels';
      end
      variableNames = eventtable.variableNames(dataNames, dataArgs);
      obj@table(eventTimes, dataArgs{:}, 'VariableNames', [{'Time'}, variableNames]);
      props = obj.Properties;
      if ~isfield(props, 'CustomProperties') || isempty(props.CustomProperties)
        props.CustomProperties = struct();
      end
      props.CustomProperties.EventTimeVariable = 'Time';
      props.CustomProperties.EventLabelsVariable = ...
        eventtable.eventLabelsVariable(opts.EventLabelsVariable, variableNames, dataArgs);
      props.CustomProperties.EventLengthsVariable = ...
        eventtable.eventLengthsVariable(opts.EventLengthsVariable, variableNames, dataArgs, ...
        props.CustomProperties.EventLabelsVariable);
      props.CustomProperties.EventEndsVariable = ...
        eventtable.eventEndsVariable(opts.EventEndsVariable, variableNames);
      obj.Properties = props;
    end

    function display(obj, varargin)
      if nargin == 2
        name = varargin{1};
      else
        name = inputname(1);
      end
      currentFormat = format();
      if ~isempty(name)
        if strcmp(currentFormat.LineSpacing, 'loose')
          builtin('disp', ' ');
        end
        builtin('disp', [name, ' =']);
      end
      if strcmp(currentFormat.LineSpacing, 'loose')
        builtin('disp', ' ');
      end
      header = sprintf('  %d%s%d %s', height(obj), char(215), width(obj), 'eventtable');
      builtin('disp', header);
      if strcmp(currentFormat.LineSpacing, 'loose')
        builtin('disp', ' ');
      end
      disp(obj);
    end

    function R = plus(A, B)
      R = eventtableMathBinary(A, B, @plus);
    end

    function R = minus(A, B)
      R = eventtableMathBinary(A, B, @minus);
    end

    function R = times(A, B)
      R = eventtableMathBinary(A, B, @times);
    end

    function R = rdivide(A, B)
      R = eventtableMathBinary(A, B, @rdivide);
    end

    function R = ldivide(A, B)
      R = eventtableMathBinary(A, B, @ldivide);
    end

    function R = power(A, B)
      R = eventtableMathBinary(A, B, @power);
    end

    function R = uplus(A)
      R = eventtableMathUnary(A, @uplus, 'uplus');
    end

    function R = uminus(A)
      R = eventtableMathUnary(A, @uminus, 'uminus');
    end

    function R = abs(A)
      R = eventtableMathUnary(A, @abs, 'abs');
    end

    function R = sum(A, varargin)
      R = eventtableMathReduce(A, @sum, 'sum', varargin{:});
    end

    function R = mean(A, varargin)
      R = eventtableMathReduce(A, @mean, 'mean', varargin{:});
    end

    function R = cumsum(A, varargin)
      R = eventtableMathMap(A, @cumsum, 'cumsum', varargin{:});
    end

  end

  methods (Static, Access = private)
    function opts = defaultOptions()
      opts = struct();
      opts.EventLabels = [];
      opts.EventLengths = [];
      opts.EventEnds = [];
      opts.EventLabelsVariable = '';
      opts.EventLengthsVariable = '';
      opts.EventEndsVariable = '';
      opts.HasEventLabels = false;
      opts.HasEventLengths = false;
      opts.HasEventEnds = false;
    end

    function tf = isOptionName(value)
      tf = false;
      if isstring(value)
        if ~isscalar(value)
          return
        end
        value = char(value);
      end
      if ~ischar(value)
        return
      end
      names = {'EventLabels', 'EventLabelsVariable', 'EventLengths', ...
        'EventLengthsVariable', 'EventEnds', 'EventEndsVariable'};
      tf = any(strcmpi(value, names));
    end

    function tf = isTextScalar(value)
      tf = ischar(value) || (isstring(value) && isscalar(value));
    end

    function opts = applyOption(opts, name, value)
      name = char(name);
      switch lower(name)
        case 'eventlabels'
          opts.EventLabels = value;
          opts.HasEventLabels = true;
        case 'eventlengths'
          opts.EventLengths = value;
          opts.HasEventLengths = true;
        case 'eventends'
          opts.EventEnds = value;
          opts.HasEventEnds = true;
        case 'eventlabelsvariable'
          opts.EventLabelsVariable = eventtable.scalarName(value);
        case 'eventlengthsvariable'
          opts.EventLengthsVariable = eventtable.scalarName(value);
        case 'eventendsvariable'
          opts.EventEndsVariable = eventtable.scalarName(value);
      end
    end

    function validateTimes(eventTimes)
      if ~(isa(eventTimes, 'datetime') || isa(eventTimes, 'duration'))
        error('Nelson:eventtable:invalidEventTimes', 'Event times must be datetime or duration values.');
      end
    end

    function [eventTimes, dataArgs, dataNames] = fromTimetable(TT)
      eventTimes = TT.Properties.RowTimes;
      variableNames = TT.Properties.VariableNames;
      dataArgs = cell(1, length(variableNames));
      dataNames = variableNames;
      for k = 1:length(variableNames)
        dataArgs{k} = TT.(variableNames{k});
      end
    end

    function [dataArgs, dataNames, opts] = applyVectorOptions(dataArgs, dataNames, opts, nRows)
      if opts.HasEventLengths && (opts.HasEventEnds || ~isempty(opts.EventEndsVariable))
        error('Nelson:eventtable:invalidSyntax', 'EventLengths and EventEnds cannot both be specified.');
      end
      if opts.HasEventEnds && ~isempty(opts.EventLengthsVariable)
        error('Nelson:eventtable:invalidSyntax', 'EventLengths and EventEnds cannot both be specified.');
      end
      if opts.HasEventLabels
        dataArgs{end + 1} = eventtable.expandScalar(opts.EventLabels, nRows);
        dataNames{end + 1} = 'EventLabels';
        opts.EventLabelsVariable = 'EventLabels';
      end
      if opts.HasEventLengths
        dataArgs{end + 1} = eventtable.expandScalar(opts.EventLengths, nRows);
        dataNames{end + 1} = 'EventLengths';
        opts.EventLengthsVariable = 'EventLengths';
      end
      if opts.HasEventEnds
        dataArgs{end + 1} = eventtable.expandScalar(opts.EventEnds, nRows);
        dataNames{end + 1} = 'EventEnds';
        opts.EventEndsVariable = 'EventEnds';
      end
    end

    function variableNames = variableNames(dataNames, dataArgs)
      variableNames = cell(1, length(dataArgs));
      for k = 1:length(dataArgs)
        if k <= length(dataNames) && ~isempty(dataNames{k})
          variableNames{k} = dataNames{k};
        else
          variableNames{k} = ['EventVar', int2str(k)];
        end
      end
      variableNames = eventtable.cellstrRow(variableNames);
    end

    function name = eventLabelsVariable(name, variableNames, dataArgs)
      if ~isempty(name)
        eventtable.validateVariableName(name, variableNames);
        return
      end
      name = '';
      for k = 1:length(dataArgs)
        value = dataArgs{k};
        if iscellstr(value) || isa(value, 'string') || ischar(value)
          name = variableNames{k};
          return
        end
      end
      if ~isempty(variableNames)
        name = variableNames{1};
      end
    end

    function name = eventLengthsVariable(name, variableNames, dataArgs, labelsName)
      if ~isempty(name)
        eventtable.validateVariableName(name, variableNames);
        return
      end
      name = '';
      for k = 1:length(dataArgs)
        if strcmp(variableNames{k}, labelsName)
          continue
        end
        if isa(dataArgs{k}, 'duration')
          name = variableNames{k};
          return
        end
      end
    end

    function name = eventEndsVariable(name, variableNames)
      if ~isempty(name)
        eventtable.validateVariableName(name, variableNames);
      end
    end

    function validateVariableName(name, variableNames)
      if ~any(strcmp(name, variableNames))
        error('Nelson:eventtable:invalidVariableName', 'Invalid event variable name.');
      end
    end

    function n = heightOf(value)
      if isa(value, 'datetime')
        n = numel(datenum(value));
      elseif isa(value, 'duration')
        n = numel(seconds(value));
      else
        n = size(value, 1);
      end
    end

    function labels = defaultLabels(nRows)
      labels = strings(nRows, 1);
      for k = 1:nRows
        labels(k) = ['Event ', int2str(k)];
      end
    end

    function value = expandScalar(value, nRows)
      if eventtable.heightOf(value) == 1 && nRows ~= 1
        if iscell(value)
          value = repmat(value, nRows, 1);
        else
          value = repmat(value, nRows, 1);
        end
      else
        value = value(:);
      end
    end

    function msg = invalidArgumentNameMessage(value)
      if ischar(value) || (isstring(value) && isscalar(value))
        name = char(value);
      else
        name = class(value);
      end
      msg = sprintf('Invalid argument name ''%s''. Name must be ''EventLabels'', ''EventLabelsVariable'', ''EventLengths'', ''EventLengthsVariable'', ''EventEnds'', or ''EventEndsVariable''.', name);
    end

    function names = cellstrRow(names)
      if ischar(names)
        names = {names};
      elseif isstring(names)
        names = cellstr(names);
      end
      names = names(:)';
    end

    function name = scalarName(name)
      if isstring(name)
        if ~isscalar(name)
          error('Nelson:eventtable:invalidType', 'Character row vector expected.');
        end
        name = char(name);
      elseif iscellstr(name) && isscalar(name)
        name = name{1};
      elseif ~ischar(name)
        error('Nelson:eventtable:invalidType', 'Character row vector expected.');
      end
    end
  end
end
