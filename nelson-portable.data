asserts.isequal(nargin('raylpdf'), 2);
asserts.isequal(nargout('raylpdf'), 1);
%=============================================================================
x = [-1 0 2 4 Inf];
R = raylpdf(x, 2);
E = [0 0 0.3032653298563167 0.1353352832366127 0];
asserts.isapprox(R, E, 1e-15);
%=============================================================================
R = raylpdf([1 2 3], [1 2 3]);
E = [0.6065306597126334 0.3032653298563167 0.2021768865708778];
asserts.isapprox(R, E, 1e-15);
%=============================================================================
R = raylpdf(single([0 2 4]), single(2));
asserts.isequal(class(R), 'single');
asserts.isapprox(double(R), [0 0.3032653298563167 0.1353352832366127], 1e-7);
%=============================================================================
R = raylpdf([1 NaN 1 1], [1 1 NaN 0]);
asserts.isapprox(R(1), 0.6065306597126334, 1e-15);
asserts.istrue(all(isnan(R(2:4))));
%=============================================================================
R = raylpdf([], []);
asserts.isequal(size(R), [0 0]);
%=============================================================================
asserts.checkerror('raylpdf(1)', _('Not enough input arguments.'));
asserts.checkerror('raylpdf(ones(2), ones(3))', _('Size mismatch on input arguments'));
asserts.checkerror('raylpdf({1}, 1)', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('raylpdf(1, {1})', sprintf(_('%s must be real numeric.'), 'B'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('raylrnd'), -1);
asserts.isequal(nargout('raylrnd'), 1);
%=============================================================================
rng(0);
U = rand(2, 4);
E = 2 .* sqrt(-2 .* log1p(-U));
rng(0);
R = raylrnd(2, 2, 4);
asserts.isequal(size(R), [2 4]);
asserts.isapprox(R, E, 1e-14);
%=============================================================================
rng(0);
U = rand(1, 3);
E = [1 2 3] .* sqrt(-2 .* log1p(-U));
rng(0);
R = raylrnd([1 2 3]);
asserts.isapprox(R, E, 1e-14);
%=============================================================================
rng(0);
U = rand(2, 3, 'single');
E = single(2) .* sqrt(single(-2) .* log1p(-U));
rng(0);
R = raylrnd(single(2), [2 3]);
asserts.isequal(class(R), 'single');
asserts.isapprox(double(R), double(E), 1e-6);
%=============================================================================
R = raylrnd(0, [1 3]);
asserts.istrue(all(isnan(R)));
R = raylrnd(-1, [1 3]);
asserts.istrue(all(isnan(R)));
%=============================================================================
R = raylrnd(1, 0, 3);
asserts.isequal(size(R), [0 3]);
R = raylrnd(single(1), [2 0 3]);
asserts.isequal(class(R), 'single');
asserts.isequal(size(R), [2 0 3]);
R = raylrnd(1, -1, 3);
asserts.isequal(size(R), [0 3]);
%=============================================================================
asserts.checkerror('raylrnd()', _('Not enough input arguments.'));
asserts.checkerror('raylrnd([1 2], 2, 2)', _('Size mismatch on input arguments'));
asserts.checkerror('raylrnd(1, 1.5, 2)', _('Size must contain integer values.'));
asserts.checkerror('raylrnd(1, Inf, 2)', _('Size must contain integer values.'));
asserts.checkerror('raylrnd({1})', sprintf(_('%s must be real numeric.'), 'B'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('raylstat'), 1);
asserts.isequal(nargout('raylstat'), 2);
%=============================================================================
[m, v] = raylstat(2);
asserts.isapprox(m, 2.5066282746310002, 1e-15);
asserts.isapprox(v, 1.7168146928204138, 1e-15);
%=============================================================================
[m, v] = raylstat([1 2]);
asserts.isapprox(m, [1.2533141373155001 2.5066282746310002], 1e-15);
asserts.isapprox(v, [0.42920367320510344 1.7168146928204138], 1e-15);
%=============================================================================
[m, v] = raylstat(single([1 2]));
asserts.isequal(class(m), 'single');
asserts.isequal(class(v), 'single');
asserts.isapprox(double(m), [1.2533141373155001 2.5066282746310002], 1e-6);
asserts.isapprox(double(v), [0.42920367320510344 1.7168146928204138], 1e-6);
%=============================================================================
[m, v] = raylstat([1 0 -1 NaN]);
asserts.isapprox(m(1), 1.2533141373155001, 1e-15);
asserts.istrue(all(isnan(m(2:4))));
asserts.istrue(all(isnan(v(2:4))));
%=============================================================================
[m, v] = raylstat([]);
asserts.isequal(size(m), [0 0]);
asserts.isequal(size(v), [0 0]);
%=============================================================================
asserts.checkerror('raylstat()', _('Not enough input arguments.'));
asserts.checkerror('raylstat({1})', sprintf(_('%s must be real numeric.'), 'B'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('regress'), 3);
asserts.isequal(nargout('regress'), 5);
%=============================================================================
y = [1; 2.1; 2.9; 4.2; 5.1; 5.9];
X = [ones(6, 1), (1:6)'];
[b, bint, r, rint, stats] = regress(y, X);
asserts.isapprox(b, [0.053333333333333; 0.994285714285714], 1e-12);
asserts.isapprox(bint, [-0.295274524306209 0.401941190972875; ...
                       0.904771480016559 1.083799948554870], 1e-12);
asserts.isapprox(r, [-0.047619047619047; 0.058095238095238; -0.136190476190476; ...
                    0.169523809523810; 0.075238095238095; -0.119047619047619], 1e-12);
REFRINT = [-0.306024383877048 0.210786288638954; ...
           -0.256268421308617 0.372458897499094; ...
           -0.475085897563161 0.202704945182209; ...
           -0.169371611848876 0.508419230896495; ...
           -0.239125564165761 0.389601754641951; ...
           -0.377452955305619 0.139357717210382];
asserts.isapprox(rint, REFRINT, 1e-12);
asserts.isapprox(stats, [0.995811862734349 951.078534031414961 ...
                        0.000006586889601 0.018190476190476], 1e-12);
%=============================================================================
y2 = y;
y2(3) = NaN;
[b2, bint2, r2, rint2, stats2] = regress(y2, X, 0.01);
asserts.isapprox(b2, [0.097674418604652; 0.989534883720930], 1e-12);
asserts.istrue(isnan(r2(3)));
asserts.istrue(all(isnan(rint2(3, :))));
asserts.isapprox(r2([1 2 4 5 6]), [-0.087209302325582; 0.023255813953488; ...
                                   0.144186046511627; 0.054651162790696; ...
                                   -0.134883720930233], 1e-12);
asserts.isapprox(bint2, [-0.639494381340872 0.834843218550176; ...
                        0.807504023362717 1.171565744079144], 1e-12);
asserts.isapprox(stats2, [0.997033135266931 1008.168445475641 ...
                         0.000068647144096 0.016705426356589], 1e-12);
%=============================================================================
[b3, bint3, r3, rint3, stats3] = regress([1; 2], [1 1; 1 2]);
asserts.isapprox(b3, [0; 1], 1e-12);
asserts.istrue(all(isnan(bint3(:))));
asserts.istrue(all(isnan(rint3(:))));
asserts.istrue(isnan(stats3(2)));
%=============================================================================
asserts.checkerror('regress()', _('Not enough input arguments.'));
asserts.checkerror('regress({1}, [1])', sprintf(_('%s must be a real numeric vector.'), 'Y'));
asserts.checkerror('regress([1], {1})', sprintf(_('%s must be a real numeric matrix.'), 'X'));
asserts.checkerror('regress([1; 2], [1 2])', sprintf(_('%s must have the same number of rows.'), 'Y and X'));
asserts.checkerror('regress([1; 2], [1; 2], 0)', sprintf(_('%s must be a scalar in the range (0,1).'), 'ALPHA'));
asserts.checkerror('regress([1; 2], [1; 2], 1)', sprintf(_('%s must be a scalar in the range (0,1).'), 'ALPHA'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--WEIGHT 2-->
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('regstats'), 4);
asserts.isequal(nargout('regstats'), 1);
%=============================================================================
X = [1 5; 2 4; 3 6; 4 8; 5 7; 6 9];
y = [3.2; 4.1; 5.9; 7.8; 8.4; 10.2];
stats = regstats(y, X, 'linear', {'beta', 'yhat', 'r', 'mse', ...
  'rsquare', 'adjrsquare', 'leverage', 'standres', 'studres', ...
  'cookd', 'tstat', 'fstat', 'dwstat'});
asserts.isequal(stats.source, 'regstats');
asserts.isapprox(stats.beta, [0.406818181818184; 1.106818181818182; ...
                             0.356818181818181], 1e-12);
asserts.isapprox(stats.yhat, [3.297727272727272; 4.047727272727273; ...
                             5.868181818181817; 7.688636363636363; ...
                             8.438636363636364; 10.259090909090908], 1e-12);
asserts.isapprox(stats.r, [-0.097727272727272; 0.052272727272727; ...
                          0.031818181818183; 0.111363636363637; ...
                          -0.038636363636364; -0.059090909090909], 1e-12);
asserts.isapprox(stats.mse, 0.010227272727273, 1e-12);
asserts.isapprox([stats.rsquare stats.adjrsquare], ...
  [0.999146304446805 0.998577174078009], 1e-12);
asserts.isapprox(stats.leverage, [0.659090909090909; 0.659090909090909; ...
                                 0.181818181818183; 0.477272727272728; ...
                                 0.477272727272727; 0.545454545454550], 1e-12);
asserts.isapprox(stats.standres, [-1.655070771676910; 0.885270412757418; ...
                                 0.347832796499981; 1.523091186792525; ...
                                 -0.528419391336183; -0.866666666666664], 1e-12);
asserts.isapprox(stats.studres, [-4.583815401645083; 0.840963287746189; ...
                                0.289910378296916; 2.611708775356326; ...
                                -0.453051522255677; -0.817302997500508], 1e-12);
asserts.isapprox(stats.cookd, [1.765300411522596; 0.505053497942376; ...
                              0.008962048468222; 0.706028145347631; ...
                              0.084982146607857; 0.300444444444448], 1e-12);
asserts.isapprox(stats.tstat.beta, stats.beta, 1e-12);
asserts.isapprox(stats.tstat.se, [0.200528743225265; 0.052074723806316; ...
                                 0.052074723806316], 1e-12);
asserts.isapprox(stats.tstat.t, [2.028727529405513; 21.254422508985691; ...
                                6.852041753410153], 1e-12);
asserts.isapprox(stats.tstat.pval, [0.135510135408937; 0.000227862423876; ...
                                   0.006363176736190], 1e-12);
asserts.isapprox([stats.fstat.f stats.fstat.pval stats.fstat.dfe stats.fstat.dfr], ...
  [1755.566666666666606 0.000024943335536 3 2], 1e-12);
asserts.isapprox(stats.dwstat.dw, 1.700168350168342, 1e-12);
asserts.istrue(isnan(stats.dwstat.pval));
%=============================================================================
selected = regstats(y, X, 'interactions', {'yhat', 'r', 'beta'});
asserts.isequal(fieldnames(selected), {'source'; 'yhat'; 'r'; 'beta'});
asserts.isapprox(selected.beta, [0.053883495145628; 1.218284789644015; ...
                                0.417313915857605; -0.016990291262136], 1e-12);
asserts.isapprox(selected.r, [-0.073786407766988; 0.076213592233010; ...
                             -0.006796116504853; 0.078155339805828; ...
                             -0.071844660194174; -0.001941747572815], 1e-12);
%=============================================================================
Xn = X;
Xn(2, 1) = NaN;
yn = y;
yn(5) = NaN;
missing = regstats(yn, Xn, 'linear', 'beta');
asserts.isapprox(missing.beta, [0.125000000000002; 1.066666666666666; ...
                               0.416666666666667], 1e-12);
%=============================================================================
Dspec = [1 0; 0 1; 1 1; 2 0];
matrixModel = regstats(y, X, Dspec, {'beta', 'R'});
asserts.isapprox(matrixModel.beta, [0.498113207547169; 1.222955974842770; ...
                                   0.274842767295596; 0.030188679245283; ...
                                   -0.048113207547170], 1e-12);
asserts.isequal(size(matrixModel.R), [5 5]);
asserts.isapprox(diag(matrixModel.R), [2.449489742783178; 4.183300132670378; ...
                                      1.942016624910449; 5.300085762599421; ...
                                      3.043375744519579], 1e-12);
%=============================================================================
allStats = regstats(y, X);
expectedFields = {'source'; 'Q'; 'R'; 'beta'; 'covb'; 'yhat'; 'r'; 'mse'; ...
  'rsquare'; 'adjrsquare'; 'leverage'; 'hatmat'; 's2_i'; 'beta_i'; ...
  'standres'; 'studres'; 'dfbetas'; 'dffit'; 'dffits'; 'covratio'; ...
  'cookd'; 'tstat'; 'fstat'; 'dwstat'};
asserts.isequal(fieldnames(allStats), expectedFields);
asserts.isequal(size(allStats.hatmat), [6 6]);
asserts.isequal(size(allStats.beta_i), [3 6]);
asserts.isequal(size(allStats.dfbetas), [3 6]);
%=============================================================================
emptyStats = regstats(zeros(0, 1), zeros(0, 2), 'linear', {'beta', 'mse', 'yhat'});
asserts.isequal(size(emptyStats.beta), [3 1]);
asserts.istrue(all(isnan(emptyStats.beta)));
asserts.istrue(isnan(emptyStats.mse));
asserts.isequal(size(emptyStats.yhat), [0 1]);
%=============================================================================
asserts.checkerror('regstats()', _('Not enough input arguments.'));
asserts.checkerror('regstats({1}, [1])', sprintf(_('%s must be a real numeric vector.'), 'Y'));
asserts.checkerror('regstats([1], {1})', sprintf(_('%s must be a real numeric matrix.'), 'X'));
asserts.checkerror('regstats([1; 2], [1 2])', sprintf(_('%s must have the same number of rows.'), 'Y and X'));
asserts.checkerror('regstats([1; 2], [1; 2], ''bad'', ''beta'')', _('Invalid model specification.'));
asserts.checkerror('regstats([1; 2], [1; 2], ''linear'', ''bad'')', _('Invalid statistic name.'));
asserts.checkerror('regstats([1; 2], [1; 2], [1 0], ''beta'')', sprintf(_('Model matrix must have one column per %s.'), 'predictor'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--WEIGHT 2-->
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('relieff'), -4);
asserts.isequal(nargout('relieff'), 2);
%=============================================================================
X = [0 0; 0 1; 1 0; 1 1; 3 0; 3 1];
y = [1; 1; 1; 1; 2; 2];
[idx, weights] = relieff(X, y, 1, 'Method', 'classification');
asserts.isequal(idx, [1 2]);
asserts.isapprox(weights, [0.555555555555555 -0.333333333333333], 1e-12);
%=============================================================================
[idx, weights] = relieff(X, {'a'; 'a'; 'a'; 'a'; 'b'; 'b'}, 1);
asserts.isequal(idx, [1 2]);
asserts.isapprox(weights, [0.555555555555555 -0.333333333333333], 1e-12);
%=============================================================================
[idx, weights] = relieff(X + 1, {'a'; 'a'; 'a'; 'a'; 'b'; 'b'}, 1, ...
  'CategoricalX', 'on', 'Prior', 'uniform');
asserts.isequal(idx, [1 2]);
asserts.isapprox(weights, [0.666666666666667 -0.666666666666667], 1e-12);
%=============================================================================
yr = [0; 0; 1; 1; 3; 3];
[idx, weights] = relieff(X, yr, 2);
asserts.isequal(idx, [1 2]);
asserts.isapprox(weights, [0.177146728908471 -0.130227486052146], 1e-12);
%=============================================================================
[idx, weights] = relieff(X, yr, 2, 'CategoricalX', [2], ...
  'Sigma', 1, 'Updates', [1 2 3]);
asserts.isequal(idx, [1 2]);
asserts.isapprox(weights, [-0.031235056790279 -0.260454972104293], 1e-12);
%=============================================================================
[idx, weights] = relieff(X, y, 1, 'Method', 'classification', ...
  'Prior', [0.5 0.5], 'Updates', 3);
asserts.isequal(size(idx), [1 2]);
asserts.isequal(size(weights), [1 2]);
%=============================================================================
asserts.checkerror('relieff()', _('Not enough input arguments.'));
asserts.checkerror('relieff({1}, y, 1)', sprintf(_('%s must be a real numeric matrix.'), 'X'));
asserts.checkerror('relieff([NaN 1], 1, 1)', sprintf(_('%s must contain finite values.'), 'X'));
asserts.checkerror('relieff(X, [1; 2], 1)', _('y must be a vector with one element per observation.'));
asserts.checkerror('relieff(X, y, 0)', sprintf(_('%s must be a positive integer scalar.'), 'k'));
asserts.checkerror('relieff(X, y, 1, ''Method'', ''bad'')', sprintf(_('Invalid %s value.'), 'Method'));
asserts.checkerror('relieff(X, {''a'';''b'';''c'';''d'';''e'';''f''}, 1, ''Method'', ''regression'')', _('Regression method requires a numeric response.'));
asserts.checkerror('relieff(X, y, 1, ''Updates'', [0 1])', _('Updates must contain valid observation indices.'));
asserts.checkerror('relieff(X, y, 1, ''CategoricalX'', [4])', sprintf(_('%s contains invalid predictor indices.'), 'CategoricalX'));
asserts.checkerror('relieff(X, y, 1, ''Method'', ''classification'', ''Prior'', [1 -1])', sprintf(_('%s must contain nonnegative finite values with positive sum.'), 'Prior'));
asserts.checkerror('relieff(X, yr, 1, ''Sigma'', 0)', sprintf(_('%s must be a positive scalar.'), 'Sigma'));
asserts.checkerror('relieff(X, y, 1, ''Unknown'', 1)', _('Unknown option.'));
%=============================================================================
%=============================================================================
