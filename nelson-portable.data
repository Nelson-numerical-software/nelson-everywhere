addpath(modulepath('optimization', 'functions'), '-frozen');
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
classdef SolverOptions
  properties (Dependent)
    SolverName
  end

  properties (Hidden)
    SolverNameValue = 'default'
    Store = struct()
  end

  methods
    function obj = SolverOptions(solver, varargin)
      obj.SolverNameValue = lower(char(solver));
      obj.Store = defaultOptions(obj.SolverNameValue);
      if nargin == 2 && (isstruct(varargin{1}) || isobject(varargin{1}))
        obj.Store = mergeOptions(obj.SolverNameValue, varargin{1});
        return
      end
      if mod(length(varargin), 2) ~= 0
        error('Nelson:optimization:nameValueExpected', 'Name-value arguments expected.');
      end
      updates = struct();
      for k = 1:2:length(varargin)
        name = canonicalName(varargin{k});
        updates.(name) = varargin{k + 1};
      end
      obj.Store = mergeOptions(obj.SolverNameValue, updates);
    end

    function value = get.SolverName(obj)
      value = obj.SolverNameValue;
    end

    function st = struct(varargin)
      % struct(obj): unset algorithm-dependent defaults stay empty in Store so
      % that a later Algorithm change re-resolves them; readers always see
      % resolved values. With field name and value pairs, an options object
      % among the values is stored as a field like any other value.
      if nargin ~= 1
        st = builtin('struct', varargin{:});
        return
      end
      obj = varargin{1};
      st = resolveAlgorithmDefaults(obj.SolverNameValue, obj.Store);
    end

    function names = fieldnames(obj)
      names = fieldnames(obj.Store);
    end

    function value = subsref(obj, s)
      if strcmp(s(1).type, '.') && isfield(obj.Store, s(1).subs)
        resolved = resolveAlgorithmDefaults(obj.SolverNameValue, obj.Store);
        value = resolved.(s(1).subs);
        if length(s) > 1
          value = builtin('subsref', value, s(2:end));
        end
      else
        value = builtin('subsref', obj, s);
      end
    end

    function obj = subsasgn(obj, s, value)
      if strcmp(s(1).type, '.')
        updates = struct();
        name = canonicalName(s(1).subs);
        updates.(name) = value;
        obj.Store = mergeOptions(obj.SolverNameValue, obj.Store, updates);
      else
        obj = builtin('subsasgn', obj, s, value);
      end
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function name = canonicalName(inputName)
  if isstring(inputName)
    inputName = char(inputName);
  end
  if ~ischar(inputName) || size(inputName, 1) ~= 1
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Option name');
  end
  direct = directCanonicalName(inputName);
  if ~isempty(direct)
    name = direct;
    return
  end
  names = supportedOptions();
  matches = false(size(names));
  lowerInput = lower(inputName);
  for k = 1:length(names)
    name = lower(names{k});
    if length(name) >= length(lowerInput)
      matches(k) = strcmp(name(1:length(lowerInput)), lowerInput);
    end
  end
  if sum(matches) == 0
    error('Nelson:optimization:unknownOption', 'Unrecognized optimization option "%s".', inputName);
  end
  if sum(matches) > 1
    exact = false(size(names));
    for k = 1:length(names)
      exact(k) = strcmp(lower(names{k}), lowerInput);
    end
    if sum(exact) == 1
      matches = exact;
    else
      error('Nelson:optimization:ambiguousOption', 'Ambiguous optimization option "%s".', inputName);
    end
  end
  idx = find(matches, 1);
  name = names{idx};
end
%=============================================================================
function name = directCanonicalName(inputName)
  switch lower(inputName)
    case 'enablefeasibilitymode'
      name = 'EnableFeasibilityMode';
    case 'hessianapproximation'
      name = 'HessianApproximation';
    case 'usecodegensolver'
      name = 'UseCodegenSolver';
    case 'barrierparamupdate'
      name = 'BarrierParamUpdate';
    case 'maxpcgiter'
      name = 'MaxPCGIter';
    case 'maxprojcgiter'
      name = 'MaxProjCGIter';
    case 'tolconsqp'
      name = 'TolConSQP';
    case 'tolprojcg'
      name = 'TolProjCG';
    case 'tolprojcgabs'
      name = 'TolProjCGAbs';
    case 'honorbounds'
      name = 'HonorBounds';
    otherwise
      name = '';
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function opts = defaultOptions(solver)
  opts = struct();
  opts.Display = 'notify';
  opts.MaxFunEvals = [];
  opts.MaxFunctionEvaluations = [];
  opts.MaxIter = [];
  opts.MaxIterations = [];
  opts.TolX = 1e-4;
  opts.TolFun = 1e-4;
  opts.FunctionTolerance = [];
  opts.StepTolerance = [];
  opts.OptimalityTolerance = 1e-6;
  opts.ConstraintTolerance = 1e-6;
  opts.FiniteDifferenceType = 'forward';
  opts.FiniteDifferenceStepSize = [];
  opts.TypicalX = [];
  opts.FunValCheck = 'off';
  opts.OutputFcn = [];
  opts.PlotFcns = [];
  opts.Jacobian = 'off';
  opts.GradObj = 'off';
  opts.GradConstr = 'off';
  opts.HessianFcn = [];
  opts.HessianMultiplyFcn = [];
  opts.SpecifyObjectiveGradient = false;
  opts.SpecifyConstraintGradient = false;
  opts.Algorithm = defaultAlgorithm(solver);
  opts.BarrierParamUpdate = 'monotone';
  opts.EnableFeasibilityMode = false;
  opts.Hessian = [];
  opts.HessianApproximation = 'bfgs';
  opts.HessUpdate = 'bfgs';
  opts.SubproblemAlgorithm = 'cg';
  opts.ScaleProblem = 'none';
  opts.Diagnostics = 'off';
  opts.HonorBounds = true;
  opts.UseParallel = false;
  opts.UseCodegenSolver = false;
  opts.HessFcn = [];
  opts.HessMult = [];
  opts.MaxTime = Inf;
  opts.MaxNodes = [];
  opts.MaxFeasiblePoints = [];
  opts.MaxNumFeasPoints = [];
  opts.AbsoluteGapTolerance = 1e-6;
  opts.RelativeGapTolerance = 1e-4;
  opts.TolGapAbs = [];
  opts.TolGapRel = [];
  opts.IntegerTolerance = 1e-6;
  opts.TolInteger = [];
  opts.LPMaxIterations = [];
  opts.LPOptimalityTolerance = 1e-7;
  opts.LPPreprocess = 'basic';
  opts.NodeSelection = 'simplebestproj';
  opts.RootLPAlgorithm = 'dual-simplex';
  opts.Heuristics = 'basic';
  opts.CutGeneration = 'basic';
  opts.ObjectiveImprovementThreshold = 0;
  opts.MaxPCGIter = [];
  opts.MaxProjCGIter = [];
  opts.PrecondBandWidth = 0;
  opts.TolPCG = 0.1;
  opts.TolConSQP = 1e-6;
  opts.TolProjCG = 0.01;
  opts.TolProjCGAbs = 1e-10;
  switch lower(solver)
    case {'fminsearch', 'fminbnd', 'fzero'}
      opts.MaxFunEvals = 500;
      opts.MaxIter = 500;
      opts.FunctionTolerance = opts.TolFun;
      opts.StepTolerance = opts.TolX;
    case 'lsqnonneg'
      opts.MaxIter = [];
      opts.TolX = 10 * eps;
      opts.Display = 'off';
    case 'quadprog'
      opts.MaxIterations = 200;
      opts.MaxIter = 200;
      opts.StepTolerance = 1e-6;
      opts.Display = 'final';
    case 'fmincon'
      opts.Algorithm = 'interior-point';
      % Algorithm-dependent defaults (MaxIterations, MaxFunctionEvaluations,
      % StepTolerance, SubproblemAlgorithm) stay empty here and are resolved
      % against the selected algorithm by resolveAlgorithmDefaults.
      opts.MaxIterations = [];
      opts.MaxIter = [];
      opts.MaxFunctionEvaluations = [];
      opts.MaxFunEvals = [];
      opts.FunctionTolerance = 1e-6;
      opts.TolFun = 1e-6;
      opts.StepTolerance = [];
      opts.TolX = [];
      opts.SubproblemAlgorithm = [];
      opts.ObjectiveLimit = -1e20;
      opts.Display = 'final';
    case {'fsolve', 'lsqnonlin'}
      opts.MaxIterations = 400;
      opts.MaxIter = 400;
      opts.MaxFunctionEvaluations = '100*numberOfVariables';
      opts.MaxFunEvals = '100*numberOfVariables';
      opts.FunctionTolerance = 1e-6;
      opts.TolFun = 1e-6;
      opts.StepTolerance = 1e-6;
      opts.TolX = 1e-6;
      opts.InitDamping = 0.01;
      opts.Display = 'final';
    case 'fminunc'
      opts.Algorithm = 'quasi-newton';
      opts.MaxIterations = 400;
      opts.MaxIter = 400;
      opts.MaxFunctionEvaluations = 1000;
      opts.MaxFunEvals = 1000;
      opts.FunctionTolerance = 1e-6;
      opts.TolFun = 1e-6;
      opts.StepTolerance = 1e-6;
      opts.TolX = 1e-6;
      opts.ObjectiveLimit = -1e20;
      opts.Display = 'final';
    case 'intlinprog'
      opts.Algorithm = 'highs';
      opts.MaxNodes = 1e4;
      opts.MaxNumFeasPoints = Inf;
      opts.MaxFeasiblePoints = Inf;
      opts.MaxIterations = 30000;
      opts.MaxIter = 30000;
      opts.Display = 'final';
    case 'linprog'
      opts.Algorithm = 'highs';
      opts.MaxIterations = 30000;
      opts.MaxIter = 30000;
      opts.Display = 'final';
    case 'default'
      opts.Display = 'notify';
    otherwise
      opts.MaxIterations = 400;
      opts.MaxFunctionEvaluations = 1000;
      opts.MaxFunEvals = 1000;
      opts.FunctionTolerance = 1e-6;
      opts.StepTolerance = 1e-6;
      opts.Display = 'final';
  end
end
%=============================================================================
function algorithm = defaultAlgorithm(solver)
  switch lower(solver)
    case 'fminsearch'
      algorithm = 'nelder-mead';
    case 'fminbnd'
      algorithm = 'golden-section';
    case 'fzero'
      algorithm = 'brent';
    case 'lsqnonneg'
      algorithm = 'active-set';
    case 'quadprog'
      algorithm = 'active-set';
    case 'fmincon'
      algorithm = 'interior-point';
    case 'fminunc'
      algorithm = 'quasi-newton';
    case {'intlinprog', 'linprog'}
      algorithm = 'highs';
    case 'lsqnonlin'
      algorithm = 'trust-region-reflective';
    case 'fsolve'
      algorithm = 'trust-region-dogleg';
    otherwise
      algorithm = 'default';
  end
end
