%=============================================================================
function [C, ia, ib] = intersect(A, B, varargin)
  [codesA, codesB, ~, options] = tableSetInputs(A, B, varargin);
  [~, ia, ib] = intersect(codesA, codesB, 'rows', options{:});
  ia = reshape(ia, [], 1);
  ib = reshape(ib, [], 1);
  C = A(ia, :);
end
