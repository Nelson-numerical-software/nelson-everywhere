%=============================================================================
function q = integral_zero_result(fun, a, arrayValued)
  if arrayValued
    v = fun(a);
    q = zeros(size(v));
    if ~isreal(v)
      q = complex(q, q) - complex(q, q);
    end
  else
    q = 0;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function vq = interp1_eval(x, v, xq, method, extrapMode, extrapValue)
  if nargin < 4 || isempty(method)
    method = 'linear';
  end
  if nargin < 5 || isempty(extrapMode)
    extrapMode = 'default';
  end
  if nargin < 6
    extrapValue = NaN;
  end

  x = full(x(:));
  if ~isnumeric(x) || ~isnumeric(v) || ~isnumeric(xq)
    error('Nelson:interp1:numericExpected', 'Numeric input arguments expected.');
  end
  if issparse(x) || issparse(v) || issparse(xq)
    error('Nelson:special_functions:denseExpected', 'dense type for all input arguments expected.');
  end
  if ~isreal(x) || ~isreal(xq)
    error('Nelson:interp1:mustBeReal', 'Sample points and query points must be real.');
  end
  n = numel(x);
  if n < 2
    error('Nelson:special_functions:notEnoughSamplePoints', 'At least two sample points expected.');
  end
  dx = diff(x);
  if any(dx == 0) || ~(all(dx > 0) || all(dx < 0))
    error('Nelson:interp1:samplePointsNotMonotonic', 'Sample points must be strictly monotonic.');
  end

  originalVector = isvector(v);
  if originalVector
    if numel(v) ~= n
      error('Nelson:dimagree:xVLength', 'X and V must be of the same length.');
    end
    vMatrix = full(v(:));
    extraDims = [];
  else
    if size(v, 1) ~= n
      error('Nelson:dimagree:lENGTHXSIZEV1', 'LENGTH(X) and SIZE(V,1) must be the same.');
    end
    extraDims = size(v);
    extraDims = extraDims(2:end);
    vMatrix = reshape(full(v), n, []);
  end

  if dx(1) < 0
    x = flipud(x);
    vMatrix = flipud(vMatrix);
  end

  qSize = size(xq);
  q = full(xq(:));
  out = zeros(numel(q), size(vMatrix, 2)) + 0 * vMatrix(1, 1);
  for col = 1:size(vMatrix, 2)
    out(:, col) = interp1_eval_column(x, vMatrix(:, col), q, method, extrapMode, extrapValue);
  end

  if originalVector
    vq = reshape(out(:, 1), qSize);
  else
    if isvector(xq)
      vq = reshape(out, [numel(q), extraDims]);
    else
      vq = reshape(out, [qSize, extraDims]);
    end
  end
end
%=============================================================================
function yq = interp1_eval_column(x, y, q, method, extrapMode, extrapValue)
  if strcmp(method, 'spline')
    % Use the dedicated not-a-knot spline; interp1 extrapolates for 'spline'
    % by default, matching spline().
    yq = spline(x, y, q);
    if strcmp(extrapMode, 'constant')
      outside = (q < min(x)) | (q > max(x));
      yq(outside) = extrapValue;
    end
    return
  end
  if strcmp(method, 'cubic') || strcmp(method, 'v5cubic')
    % 'cubic'/'v5cubic' use cubic convolution on a uniformly spaced grid; on a
    % non-uniform grid the reference warns and falls back to 'spline'.
    if strcmp(extrapMode, 'extrap')
      % 'cubic'/'v5cubic' do not extrapolate; the reference warns and returns
      % NaN outside the sample range.
      warning('Nelson:interp1:noExtrap', 'The ''cubic'' and ''v5cubic'' methods do not support extrapolation.');
      extrapMode = 'default';
      extrapValue = NaN;
    end
    dh = diff(x);
    if all(abs(dh - dh(1)) <= 1e-10 * max(abs(dh(1)), 1))
      yq = interp1_cubic_convolution(x, y, q, extrapMode, extrapValue);
    else
      warning('Nelson:interp1:cubicNonUniform', 'The ''cubic'' method requires the grid to have a uniform spacing. Switching the method from ''cubic'' to ''spline'' because this condition is not met.');
      yq = spline(x, y, q);
      if strcmp(extrapMode, 'constant')
        outside = (q < min(x)) | (q > max(x));
        yq(outside) = extrapValue;
      end
    end
    return
  end
  % 'makima' is evaluated by the pure Nelson path (interp1_vector); the native
  % __interp1__ does not implement modified Akima interpolation.
  nativeMethods = {'linear', 'nearest', 'previous', 'next', 'pchip', 'spline'};
  if any(strcmp(method, nativeMethods))
    try
      if strcmp(extrapMode, 'extrap')
        yq = __interp1__(x, y, q, method, 'extrap');
      elseif strcmp(extrapMode, 'constant')
        yq = __interp1__(x, y, q, method, extrapValue);
      elseif any(strcmp(method, {'pchip', 'spline'}))
        yq = __interp1__(x, y, q, method, 'extrap');
      else
        yq = __interp1__(x, y, q, method);
      end
      return
    catch
    end
  end
  yq = interp1_vector(x, y, q, method, extrapMode, extrapValue);
end
%=============================================================================
function yq = interp1_cubic_convolution(x, y, q, extrapMode, extrapValue)
  n = numel(x);
  x = x(:);
  y = y(:);
  q = q(:);
  h = x(2) - x(1);
  yq = zeros(numel(q), 1);
  lo = x(1);
  hi = x(n);
  for k = 1:numel(q)
    qi = q(k);
    if (qi < lo || qi > hi) && ~strcmp(extrapMode, 'extrap')
      if strcmp(extrapMode, 'constant')
        yq(k) = extrapValue;
      else
        yq(k) = NaN;
      end
      continue
    end
    idx = floor((qi - lo) / h) + 1;
    if idx < 1
      idx = 1;
    elseif idx > n - 1
      idx = n - 1;
    end
    t = (qi - x(idx)) / h;
    yi = y(idx);
    yp1 = y(idx + 1);
    if idx - 1 >= 1
      ym1 = y(idx - 1);
    else
      ym1 = 3 * y(1) - 3 * y(2) + y(3);
    end
    if idx + 2 <= n
      yp2 = y(idx + 2);
    else
      yp2 = 3 * y(n) - 3 * y(n - 1) + y(n - 2);
    end
    yq(k) = yi + 0.5 * t * ((yp1 - ym1) ...
      + t * ((2 * ym1 - 5 * yi + 4 * yp1 - yp2) ...
      + t * (-ym1 + 3 * yi - 3 * yp1 + yp2)));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function pp = interp1_pp(x, v, method)
  x = full(x(:)).';
  if ~isvector(v)
    error('Nelson:interp1:ppFormVectorOnly', 'PP form is supported for vector sample values.');
  end
  v = full(v(:)).';
  if numel(x) ~= numel(v)
    error('Nelson:dimagree:xVLength', 'X and V must be of the same length.');
  end
  if strcmp(method, 'nearest') || strcmp(method, 'previous') || strcmp(method, 'next')
    error('Nelson:interp1:ppFormContinuousOnly', 'PP form is supported for continuous interpolation methods.');
  end
  if any(diff(x) < 0)
    x = fliplr(x);
    v = fliplr(v);
  end
  n = numel(x);
  coefs = zeros(n - 1, 4) + 0 * v(1);
  if strcmp(method, 'linear')
    for k = 1:n - 1
      slope = (v(k + 1) - v(k)) / (x(k + 1) - x(k));
      coefs(k, :) = [0, 0, slope, v(k)];
    end
  else
    if strcmp(method, 'makima')
      d = interp1_makima_slopes_local(x(:), v(:));
    else
      d = interp1_pchip_slopes_local(x(:), v(:));
    end
    for k = 1:n - 1
      h = x(k + 1) - x(k);
      c0 = v(k);
      c1 = d(k);
      c2 = (3 * (v(k + 1) - v(k)) / h - 2 * d(k) - d(k + 1)) / h;
      c3 = (2 * (v(k) - v(k + 1)) / h + d(k) + d(k + 1)) / (h * h);
      coefs(k, :) = [c3, c2, c1, c0];
    end
  end
  pp = struct('form', 'pp', 'breaks', x, 'coefs', coefs, 'pieces', n - 1, 'order', 4, 'dim', 1);
end
%=============================================================================
function d = interp1_pchip_slopes_local(x, y)
  n = numel(x);
  h = diff(x);
  delta = diff(y) ./ h;
  d = zeros(size(y)) + 0 * y(1);
  if n == 2
    d(:) = delta(1);
    return
  end
  for k = 2:n - 1
    if isreal(delta(k - 1)) && isreal(delta(k)) && delta(k - 1) * delta(k) > 0
      w1 = 2 * h(k) + h(k - 1);
      w2 = h(k) + 2 * h(k - 1);
      d(k) = (w1 + w2) / (w1 / delta(k - 1) + w2 / delta(k));
    else
      d(k) = (delta(k - 1) + delta(k)) / 2;
    end
  end
  d(1) = ((2 * h(1) + h(2)) * delta(1) - h(1) * delta(2)) / (h(1) + h(2));
  d(n) = ((2 * h(end) + h(end - 1)) * delta(end) - h(end) * delta(end - 1)) / (h(end) + h(end - 1));
end
%=============================================================================
function d = interp1_makima_slopes_local(x, y)
  n = numel(x);
  h = diff(x);
  delta = diff(y) ./ h;
  d = zeros(size(y)) + 0 * y(1);
  if n == 2
    d(:) = delta(1);
    return
  end
  m = zeros(n + 3, 1) + 0 * y(1);
  m(3:n + 1) = delta;
  m(2) = 2 * m(3) - m(4);
  m(1) = 2 * m(2) - m(3);
  m(n + 2) = 2 * m(n + 1) - m(n);
  m(n + 3) = 2 * m(n + 2) - m(n + 1);
  for i = 1:n
    w1 = abs(m(i + 3) - m(i + 2)) + abs(m(i + 3) + m(i + 2)) / 2;
    w2 = abs(m(i + 1) - m(i)) + abs(m(i + 1) + m(i)) / 2;
    if w1 + w2 == 0
      d(i) = 0;
    else
      d(i) = (w1 * m(i + 1) + w2 * m(i + 2)) / (w1 + w2);
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function yq = interp1_vector(x, y, q, method, extrapMode, extrapValue)
  n = numel(x);
  yq = zeros(size(q)) + 0 * y(1);
  defaultExtrap = any(strcmp(method, {'pchip', 'makima', 'spline'}));

  if strcmp(method, 'makima')
    d = interp1_makima_slopes(x, y);
  elseif any(strcmp(method, {'pchip', 'spline', 'cubic'}))
    d = interp1_pchip_slopes(x, y);
  else
    d = [];
  end

  for k = 1:numel(q)
    xk = q(k);
    if isnan(xk)
      yq(k) = NaN;
      continue
    end
    outside = (xk < x(1)) || (xk > x(end));
    if outside && strcmp(extrapMode, 'constant')
      yq(k) = extrapValue;
      continue
    end
    if outside && strcmp(extrapMode, 'default') && ~defaultExtrap
      yq(k) = NaN;
      continue
    end

    if xk <= x(1)
      left = 1;
    elseif xk >= x(end)
      left = n - 1;
    else
      left = find(x <= xk, 1, 'last');
      if left >= n
        left = n - 1;
      end
    end

    switch method
      case 'nearest'
        if abs(xk - x(left)) <= abs(x(left + 1) - xk)
          yq(k) = y(left);
        else
          yq(k) = y(left + 1);
        end
      case 'previous'
        if xk < x(1)
          yq(k) = y(1);
        else
          idx = find(x <= xk, 1, 'last');
          yq(k) = y(idx);
        end
      case 'next'
        if xk > x(end)
          yq(k) = y(end);
        else
          idx = find(x >= xk, 1, 'first');
          yq(k) = y(idx);
        end
      case {'pchip', 'makima', 'spline', 'cubic'}
        h = x(left + 1) - x(left);
        t = (xk - x(left)) / h;
        h00 = (2 * t ^ 3) - (3 * t ^ 2) + 1;
        h10 = (t ^ 3) - (2 * t ^ 2) + t;
        h01 = (-2 * t ^ 3) + (3 * t ^ 2);
        h11 = (t ^ 3) - (t ^ 2);
        yq(k) = h00 * y(left) + h10 * h * d(left) + h01 * y(left + 1) + h11 * h * d(left + 1);
      otherwise
        frac = (xk - x(left)) / (x(left + 1) - x(left));
        yq(k) = y(left) + frac * (y(left + 1) - y(left));
    end
  end
end
%=============================================================================
function d = interp1_pchip_slopes(x, y)
  n = numel(x);
  h = diff(x);
  delta = diff(y) ./ h;
  d = zeros(size(y)) + 0 * y(1);
  if n == 2
    d(:) = delta(1);
    return
  end
  for k = 2:n - 1
    if isreal(delta(k - 1)) && isreal(delta(k)) && delta(k - 1) * delta(k) > 0
      w1 = 2 * h(k) + h(k - 1);
      w2 = h(k) + 2 * h(k - 1);
      d(k) = (w1 + w2) / (w1 / delta(k - 1) + w2 / delta(k));
    else
      d(k) = (delta(k - 1) + delta(k)) / 2;
    end
  end
  d(1) = interp1_pchip_endpoint(h(1), h(2), delta(1), delta(2));
  d(n) = interp1_pchip_endpoint(h(end), h(end - 1), delta(end), delta(end - 1));
end
%=============================================================================
function d = interp1_makima_slopes(x, y)
  % Modified Akima piecewise cubic Hermite slopes at the nodes.
  % The classic Akima weights are augmented with the '+ |sum| / 2' term so
  % that regions where consecutive slopes are equal but non-zero no longer
  % produce the 0/0 indeterminate form of the original Akima scheme.
  n = numel(x);
  h = diff(x);
  delta = diff(y) ./ h;
  d = zeros(size(y)) + 0 * y(1);
  if n == 2
    d(:) = delta(1);
    return
  end
  % Extend the segment slopes with two synthetic values on each side using a
  % linear extrapolation of the slope sequence.
  m = zeros(n + 3, 1) + 0 * y(1);
  m(3:n + 1) = delta;
  m(2) = 2 * m(3) - m(4);
  m(1) = 2 * m(2) - m(3);
  m(n + 2) = 2 * m(n + 1) - m(n);
  m(n + 3) = 2 * m(n + 2) - m(n + 1);
  for i = 1:n
    w1 = abs(m(i + 3) - m(i + 2)) + abs(m(i + 3) + m(i + 2)) / 2;
    w2 = abs(m(i + 1) - m(i)) + abs(m(i + 1) + m(i)) / 2;
    if w1 + w2 == 0
      d(i) = 0;
    else
      d(i) = (w1 * m(i + 1) + w2 * m(i + 2)) / (w1 + w2);
    end
  end
end
%=============================================================================
function d = interp1_pchip_endpoint(h1, h2, del1, del2)
  d = ((2 * h1 + h2) * del1 - h1 * del2) / (h1 + h2);
  if isreal(d) && isreal(del1) && isreal(del2)
    if sign(d) ~= sign(del1)
      d = 0;
    elseif sign(del1) ~= sign(del2) && abs(d) > abs(3 * del1)
      d = 3 * del1;
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function tf = interp_is_text(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function method = interp_method(value, allowPchip, allowPreviousNext)
  if ~interp_is_text(value)
    error('Nelson:interp:methodExpected', 'Interpolation method expected.');
  end
  method = convertStringsToChars(value);
  if strcmp(method, 'v5cubic')
    method = 'cubic';
  end
  allowed = {'linear', 'nearest', 'cubic', 'makima', 'spline'};
  if allowPchip
    allowed{end + 1} = 'pchip';
  end
  if allowPreviousNext
    allowed{end + 1} = 'previous';
    allowed{end + 1} = 'next';
  end
  if ~any(strcmp(method, allowed))
    error('Nelson:interp:unknownMethod', 'Unknown interpolation method.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [x, v, xq, method, extrapMode, extrapValue, returnPP] = interp_parse1(varargin)
  method = 'linear';
  extrapMode = 'default';
  extrapValue = NaN;
  returnPP = false;
  xq = [];

  args = varargin;
  if numel(args) >= 1 && interp_is_text(args{end})
    last = convertStringsToChars(args{end});
    if strcmp(last, 'pp')
      returnPP = true;
      args(end) = [];
    end
  end

  if returnPP
    if numel(args) < 3
      error('Nelson:notEnoughInputs', 'Not enough input arguments.');
    end
    x = args{1};
    v = args{2};
    method = interp_method(args{3}, true, true);
    extrapMode = 'extrap';
    return
  end

  if numel(args) >= 1
    tail = args{end};
    if interp_is_text(tail)
      tailText = convertStringsToChars(tail);
      if strcmp(tailText, 'extrap')
        extrapMode = 'extrap';
        args(end) = [];
      end
    elseif isnumeric(tail) && isscalar(tail) && numel(args) >= 4
      extrapMode = 'constant';
      extrapValue = tail;
      args(end) = [];
    end
  end

  if numel(args) >= 1 && interp_is_text(args{end})
    method = interp_method(args{end}, true, true);
    args(end) = [];
  end

  switch numel(args)
    case 2
      v = args{1};
      xq = args{2};
      if isvector(v)
        x = 1:length(v);
      else
        x = 1:size(v, 1);
      end
    case 3
      x = args{1};
      v = args{2};
      xq = args{3};
    otherwise
      if numel(args) < 2
        error('Nelson:notEnoughInputs', 'Not enough input arguments.');
      end
      error('Nelson:tooManyInputs', 'Too many input arguments.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [args, method, extrapMode, extrapValue] = interp_parse_tail(args, allowPchip)
  method = 'linear';
  extrapMode = 'default';
  extrapValue = NaN;

  if numel(args) >= 2
    tail = args{end};
    if isnumeric(tail) && isscalar(tail) && interp_is_text(args{end - 1})
      extrapMode = 'constant';
      extrapValue = tail;
      args(end) = [];
    end
  end

  if numel(args) >= 1 && interp_is_text(args{end})
    method = interp_method(args{end}, allowPchip, false);
    args(end) = [];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function Vq = interpn_core(grids, V, queries, method, extrapMode, extrapValue)
  if nargin < 4 || isempty(method)
    method = 'linear';
  end
  if nargin < 5 || isempty(extrapMode)
    extrapMode = 'default';
  end
  if nargin < 6
    extrapValue = NaN;
  end
  nativeMethod = method;
  nativeExtrapMode = extrapMode;
  if strcmp(nativeExtrapMode, 'default') && any(strcmp(nativeMethod, {'spline', 'makima'}))
    nativeExtrapMode = 'extrap';
  end
  if ~any(strcmp(method, {'linear', 'nearest', 'cubic', 'makima', 'spline', 'pchip'}))
    error('Nelson:interp:unsupportedMethod', 'Unsupported interpolation method.');
  end
  if ~isnumeric(V)
    error('Nelson:interpn:numericSampleValuesExpected', 'Numeric sample values expected.');
  end
  if issparse(V)
    error('Nelson:special_functions:denseExpected', 'dense type for all input arguments expected.');
  end

  nd = numel(grids);
  if numel(queries) ~= nd
    error('Nelson:interpn:invalidQueryGridCount', 'Wrong number of query grids.');
  end
  dataSize = size(V);
  if numel(dataSize) < nd
    dataSize(end + 1:nd) = 1;
  end
  for dim = 1:nd
    g = full(grids{dim}(:));
    if ~isnumeric(g) || ~isreal(g) || issparse(g)
      error('Nelson:interpn:invalidGridVectors', 'Grid vectors must be real dense numeric vectors.');
    end
    if numel(g) ~= dataSize(dim)
      error('Nelson:interp:gridSizeMismatch', 'Grid vector length and sample value size are incompatible.');
    end
    dg = g(2:end) - g(1:end - 1);
    if any(dg == 0) || ~(all(dg > 0) || all(dg < 0))
      error('Nelson:interpn:gridVectorsNotMonotonic', 'Grid vectors must be strictly monotonic.');
    end
    if dg(1) < 0
      g = flipud(g);
      V = flipdim(V, dim);
    end
    grids{dim} = g;
  end

  if strcmp(method, 'makima')
    % The native builtin evaluates 'makima' with a value-independent Lagrange
    % stencil (identical to 'cubic'), which is not the modified-Akima result
    % because the Akima slopes depend non-linearly on the sample values.
    % Evaluate a genuine tensor-product modified-Akima interpolant here.
    effectiveExtrap = extrapMode;
    if strcmp(effectiveExtrap, 'default')
      effectiveExtrap = 'extrap';
    end
    Vq = interpn_makima_core(grids, V, queries, effectiveExtrap, extrapValue, nd);
    return
  end

  if any(strcmp(nativeMethod, {'linear', 'nearest', 'cubic', 'makima', 'spline', 'pchip'}))
    try
      Vq = __interpn__(V, nativeMethod, nativeExtrapMode, extrapValue, grids{:}, queries{:});
      return
    catch
    end
  end
  if any(strcmp(method, {'cubic', 'makima', 'spline', 'pchip'}))
    if strcmp(extrapMode, 'default') && any(strcmp(method, {'spline', 'makima'}))
      extrapMode = 'extrap';
    end
    method = 'linear';
  end

  dataSize = size(V);
  if numel(dataSize) < nd
    dataSize(end + 1:nd) = 1;
  end
  gridSize = dataSize(1:nd);
  extraSize = dataSize(nd + 1:end);
  if isempty(extraSize)
    extraSize = 1;
  end
  pageCount = prod(extraSize);
  Vmat = reshape(V, prod(gridSize), pageCount);

  sameSize = true;
  qSize = size(queries{1});
  for dim = 1:nd
    if ~isnumeric(queries{dim}) || ~isreal(queries{dim}) || issparse(queries{dim})
      error('Nelson:interpn:invalidQueryPoints', 'Query points must be real dense numeric arrays.');
    end
    sameSize = sameSize && isequal(size(queries{dim}), qSize);
  end

  queryAsGrid = false;
  if ~sameSize
    queryAsGrid = true;
    qSize = zeros(1, nd);
    for dim = 1:nd
      if ~interpn_is_query_vector(queries{dim})
        error('Nelson:dimagree:valueArraysSize', '%s arrays must have the same size.', 'Query');
      end
      qSize(dim) = numel(queries{dim});
      queries{dim} = full(queries{dim}(:));
    end
  else
    for dim = 1:nd
      queries{dim} = full(queries{dim});
    end
  end

  totalQueries = prod(qSize);
  out = zeros(totalQueries, pageCount) + 0 * Vmat(1, 1);
  strides = [1, cumprod(gridSize(1:end - 1))];
  defaultExtrap = any(strcmp(method, {'spline', 'makima'}));

  for qi = 1:totalQueries
    q = zeros(1, nd);
    if queryAsGrid
      remIndex = qi - 1;
      for dim = 1:nd
        sub = mod(remIndex, qSize(dim)) + 1;
        remIndex = floor(remIndex / qSize(dim));
        q(dim) = queries{dim}(sub);
      end
    else
      for dim = 1:nd
        qd = queries{dim};
        q(dim) = qd(qi);
      end
    end

    left = ones(1, nd);
    frac = zeros(1, nd);
    nearest = ones(1, nd);
    outside = false;
    for dim = 1:nd
      g = grids{dim};
      if isnan(q(dim)) || q(dim) < g(1) || q(dim) > g(end)
        outside = true;
      end
      if q(dim) <= g(1)
        left(dim) = 1;
      elseif q(dim) >= g(end)
        left(dim) = numel(g) - 1;
      else
        left(dim) = find(g <= q(dim), 1, 'last');
        if left(dim) >= numel(g)
          left(dim) = numel(g) - 1;
        end
      end
      frac(dim) = (q(dim) - g(left(dim))) / (g(left(dim) + 1) - g(left(dim)));
      if abs(q(dim) - g(left(dim))) <= abs(g(left(dim) + 1) - q(dim))
        nearest(dim) = left(dim);
      else
        nearest(dim) = left(dim) + 1;
      end
    end

    if outside && strcmp(extrapMode, 'constant')
      out(qi, :) = extrapValue;
      continue
    elseif outside && strcmp(extrapMode, 'default') && ~defaultExtrap
      out(qi, :) = NaN;
      continue
    end

    if strcmp(method, 'nearest')
      lin = 1 + sum((nearest - 1) .* strides);
      out(qi, :) = Vmat(lin, :);
    else
      value = zeros(1, pageCount) + 0 * Vmat(1, 1);
      for mask = 0:(2 ^ nd - 1)
        idx = left;
        weight = 1;
        for dim = 1:nd
          if bitand(mask, 2 ^ (dim - 1))
            idx(dim) = left(dim) + 1;
            weight = weight * frac(dim);
          else
            weight = weight * (1 - frac(dim));
          end
        end
        lin = 1 + sum((idx - 1) .* strides);
        value = value + weight * Vmat(lin, :);
      end
      out(qi, :) = value;
    end
  end

  if isequal(extraSize, 1)
    Vq = reshape(out(:, 1), qSize);
  else
    Vq = reshape(out, [qSize, extraSize]);
  end
end
%=============================================================================
function tf = interpn_is_query_vector(q)
  sz = size(q);
  tf = nnz(sz > 1) <= 1;
end
%=============================================================================
function Vq = interpn_makima_core(grids, V, queries, extrapMode, extrapValue, nd)
  % Tensor-product modified-Akima evaluation. The interpolant is separable:
  % along each dimension it is the 1-D modified-Akima piecewise cubic Hermite
  % spline, applied dimension by dimension. Because the Akima slopes depend on
  % the sample values, this cannot be written as a value-independent stencil.
  dataSize = size(V);
  if numel(dataSize) < nd
    dataSize(end + 1:nd) = 1;
  end
  gridSize = dataSize(1:nd);
  extraSize = dataSize(nd + 1:end);
  if isempty(extraSize)
    extraSize = 1;
  end
  pageCount = prod(extraSize);
  Vmat = reshape(V, prod(gridSize), pageCount);
  strides = [1, cumprod(gridSize(1:end - 1))];

  sameSize = true;
  qSize = size(queries{1});
  for dim = 1:nd
    if ~isnumeric(queries{dim}) || ~isreal(queries{dim}) || issparse(queries{dim})
      error('Nelson:interpn:invalidQueryPoints', 'Query points must be real dense numeric arrays.');
    end
    sameSize = sameSize && isequal(size(queries{dim}), qSize);
  end

  queryAsGrid = false;
  if ~sameSize
    queryAsGrid = true;
    qSize = zeros(1, nd);
    for dim = 1:nd
      if ~interpn_is_query_vector(queries{dim})
        error('Nelson:dimagree:valueArraysSize', '%s arrays must have the same size.', 'Query');
      end
      qSize(dim) = numel(queries{dim});
      queries{dim} = full(queries{dim}(:));
    end
  else
    for dim = 1:nd
      queries{dim} = full(queries{dim});
    end
  end

  totalQueries = prod(qSize);
  out = zeros(totalQueries, pageCount) + 0 * Vmat(1, 1);
  constantMode = strcmp(extrapMode, 'constant');

  for qi = 1:totalQueries
    q = zeros(1, nd);
    if queryAsGrid
      remIndex = qi - 1;
      for dim = 1:nd
        sub = mod(remIndex, qSize(dim)) + 1;
        remIndex = floor(remIndex / qSize(dim));
        q(dim) = queries{dim}(sub);
      end
    else
      for dim = 1:nd
        qd = queries{dim};
        q(dim) = qd(qi);
      end
    end

    outside = false;
    hasNaN = false;
    for dim = 1:nd
      g = grids{dim};
      if isnan(q(dim))
        hasNaN = true;
      elseif q(dim) < g(1) || q(dim) > g(end)
        outside = true;
      end
    end
    if hasNaN
      out(qi, :) = NaN;
      continue
    end
    if outside && constantMode
      out(qi, :) = extrapValue;
      continue
    end

    out(qi, :) = interpn_makima_recurse(1, 0, grids, Vmat, gridSize, strides, q, nd);
  end

  if isequal(extraSize, 1)
    Vq = reshape(out(:, 1), qSize);
  else
    Vq = reshape(out, [qSize, extraSize]);
  end
end
%=============================================================================
function row = interpn_makima_recurse(dim, baseOffset, grids, Vmat, gridSize, strides, q, nd)
  % Collapse dimension 'dim' by evaluating a 1-D modified-Akima interpolant at
  % q(dim) over the node values gathered along that dimension. Dimensions
  % 1..dim-1 are already fixed through baseOffset (a 0-based linear offset).
  n = gridSize(dim);
  if dim == nd
    rows = baseOffset + (0:n - 1)' * strides(dim) + 1;
    nodeVals = Vmat(rows, :);
  else
    pageCount = size(Vmat, 2);
    nodeVals = zeros(n, pageCount) + 0 * Vmat(1, 1);
    for j = 1:n
      nodeVals(j, :) = interpn_makima_recurse(dim + 1, ...
        baseOffset + (j - 1) * strides(dim), grids, Vmat, gridSize, strides, q, nd);
    end
  end
  row = interpn_makima_1d(grids{dim}, nodeVals, q(dim));
end
%=============================================================================
function row = interpn_makima_1d(g, nodeVals, xq)
  % 1-D modified-Akima piecewise cubic Hermite evaluation of the columns of
  % nodeVals (one column per output page) at the scalar query xq. Points
  % outside the grid are extrapolated using the boundary segment.
  n = numel(g);
  if n == 1
    row = nodeVals(1, :);
    return
  end
  if xq <= g(1)
    left = 1;
  elseif xq >= g(n)
    left = n - 1;
  else
    left = find(g <= xq, 1, 'last');
    if left >= n
      left = n - 1;
    end
  end
  d = interpn_makima_slopes(g, nodeVals);
  h = g(left + 1) - g(left);
  t = (xq - g(left)) / h;
  h00 = (2 * t ^ 3) - (3 * t ^ 2) + 1;
  h10 = (t ^ 3) - (2 * t ^ 2) + t;
  h01 = (-2 * t ^ 3) + (3 * t ^ 2);
  h11 = (t ^ 3) - (t ^ 2);
  row = h00 * nodeVals(left, :) + h10 * h * d(left, :) ...
    + h01 * nodeVals(left + 1, :) + h11 * h * d(left + 1, :);
end
%=============================================================================
function d = interpn_makima_slopes(g, y)
  % Modified-Akima slopes at the nodes for every column of y. The classic
  % Akima weights are augmented with the '+ |sum| / 2' term so that regions of
  % equal but non-zero consecutive slopes do not produce the 0/0 form of the
  % original Akima scheme.
  n = numel(g);
  p = size(y, 2);
  d = zeros(n, p) + 0 * y(1);
  if n == 2
    delta = (y(2, :) - y(1, :)) / (g(2) - g(1));
    d(1, :) = delta;
    d(2, :) = delta;
    return
  end
  h = diff(g);
  delta = diff(y, 1, 1) ./ repmat(h, 1, p);
  m = zeros(n + 3, p) + 0 * y(1);
  m(3:n + 1, :) = delta;
  m(2, :) = 2 * m(3, :) - m(4, :);
  m(1, :) = 2 * m(2, :) - m(3, :);
  m(n + 2, :) = 2 * m(n + 1, :) - m(n, :);
  m(n + 3, :) = 2 * m(n + 2, :) - m(n + 1, :);
  for i = 1:n
    w1 = abs(m(i + 3, :) - m(i + 2, :)) + abs(m(i + 3, :) + m(i + 2, :)) / 2;
    w2 = abs(m(i + 1, :) - m(i, :)) + abs(m(i + 1, :) + m(i, :)) / 2;
    denom = w1 + w2;
    di = (w1 .* m(i + 1, :) + w2 .* m(i + 2, :)) ./ denom;
    di(denom == 0) = 0;
    d(i, :) = di;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = quadgk(fun, a, b, varargin)
  narginchk(3, inf);
  nargoutchk(0, 2);
  if ~isa(fun, 'function_handle')
    error('Nelson:special_functions:funArgNotHandle', 'First argument must be a function handle.');
  end
  if ~(isnumeric(a) && isscalar(a)) || ~(isnumeric(b) && isscalar(b))
    error('Nelson:special_functions:limitsNumericScalars', 'Integration limits must be numeric scalars.');
  end
  opts = quadgkParseOptions(varargin{:});
  points = [a, opts.Waypoints(:).', b];
  if any(~isreal(points)) && any(~isfinite(points))
    error('Nelson:quadgk:complexInfinite', 'Complex contours require finite limits and waypoints.');
  end
  [q, errbnd] = integral_contour(fun, points, opts.RelTol, opts.AbsTol, false, opts.MaxIntervalCount);
  varargout{1} = q;
  if nargout > 1
    varargout{2} = errbnd;
  end
end
%=============================================================================
function opts = quadgkParseOptions(varargin)
  opts = struct('RelTol', 1e-6, 'AbsTol', 1e-10, 'Waypoints', [], 'MaxIntervalCount', 650);
  if mod(numel(varargin), 2) ~= 0
    error('Nelson:special_functions:optionsPairs', 'Options must be given as name/value pairs.');
  end
  for k = 1:2:numel(varargin)
    name = varargin{k};
    value = varargin{k + 1};
    if ~(ischar(name) || (isstring(name) && isscalar(name)))
      error('Nelson:special_functions:optionName', 'Option name must be a character vector.');
    end
    switch lower(char(name))
      case 'reltol'
        opts.RelTol = quadgkNonnegativeScalar(value, 'RelTol');
      case 'abstol'
        opts.AbsTol = quadgkNonnegativeScalar(value, 'AbsTol');
      case 'waypoints'
        if ~isnumeric(value) || ~isvector(value)
          error('Nelson:quadgk:Waypoints', 'Waypoints must be a numeric vector.');
        end
        opts.Waypoints = value(:).';
      case 'maxintervalcount'
        if ~(isnumeric(value) && isscalar(value) && isreal(value) && value >= 1)
          error('Nelson:quadgk:MaxIntervalCount', 'MaxIntervalCount must be a positive real scalar.');
        end
        opts.MaxIntervalCount = double(value);
      otherwise
        error('Nelson:special_functions:unknownOption', 'Unknown option name: %s', char(name));
    end
  end
end
%=============================================================================
function value = quadgkNonnegativeScalar(value, name)
  if ~(isnumeric(value) && isscalar(value) && isreal(value) && value >= 0)
    error(['Nelson:quadgk:', name], sprintf('%s must be a nonnegative real scalar.', name));
  end
  value = double(value);
end
