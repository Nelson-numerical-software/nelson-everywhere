function [M, I] = max(A, varargin)
  if ~A.isOrdinal
    error('Nelson:categorical:requiresOrdinal', '%s requires ordinal categorical arrays.', 'Maximum');
  end
  sortable = A.codes;
  sortable(sortable == 0) = -Inf;
  flat = sortable(:);
  maxValue = -Inf;
  I = 0;
  for k = 1:length(flat)
    if flat(k) > maxValue
      maxValue = flat(k);
      I = k;
    end
  end
  M = A(I);
end
