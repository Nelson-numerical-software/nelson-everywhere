function msg = test_redirect_error_message(redirect_err, res_cmd)
  try
    s = jsondecode(redirect_err, '-file');
    if ~isempty(s) && isfield(s, 'msg')
      msg = s.msg;
      return
    end
  catch
  end
  msg = fileread(redirect_err);
  if isempty(msg)
    msg = ['Error code not caught:', ' ', num2str(res_cmd)];
  end
end
