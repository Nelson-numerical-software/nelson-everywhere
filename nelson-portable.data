% LICENCE_BLOCK_END
%=============================================================================
function names = checkCategoryNames(names, allowDuplicates, varargin)
  if nargin < 2
    allowDuplicates = false;
  end
  names = categorical.checkCategoryNames(names, allowDuplicates);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function newCodes = convertCodes(codes, oldNames, newNames)
  map = zeros(length(oldNames), 1);
  for k = 1:length(oldNames)
    idx = find(strcmp(newNames, oldNames{k}), 1);
    if ~isempty(idx)
      map(k) = idx;
    end
  end
  newCodes = zeros(size(codes));
  for k = 1:numel(codes)
    code = codes(k);
    if code > 0
      newCodes(k) = map(code);
    end
  end
end
%=============================================================================
