% LICENCE_BLOCK_END
%=============================================================================
function nmm_error(reason, varargin)
  error(['Nelson:nmm:', reason], varargin{:});
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function report = nmm_explain(varargin)
  if length(varargin) ~= 1
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  packageName = varargin{1};
  if ~ischar(packageName)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 2);
  end
  report = struct();
  report.package = packageName;
  report.status = nmm_status(packageName);
  report.tree = nmm_tree(packageName);
  report.why = nmm_why(packageName);
  report.summary = summaryLines(report.status, report.why, report.tree);
end
%=============================================================================
function lines = summaryLines(status, why, tree)
  lines = {};
  if ~status.installed
    lines{end + 1} = [status.package, ' is not installed.'];
    return
  end
  lines{end + 1} = [status.package, ' ', status.version, ' is installed.'];
  if status.pinned
    lines{end + 1} = ['Pinned version: ', status.pinned_version, '.'];
  end
  lines{end + 1} = ['Dependencies: ', int2str(length(status.dependencies)), '.'];
  if ~isempty(tree.missing)
    lines{end + 1} = ['Missing dependencies: ', strjoin(tree.missing, ', '), '.'];
  end
  if isempty(why.required_by)
    lines{end + 1} = 'No installed package depends on it.';
  else
    lines{end + 1} = ['Required by: ', strjoin(why.required_by, ', '), '.'];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [module_name, module_data] = nmm_find_installed_module(module_or_path, varargin)
  module_name = [];
  module_data = struct([]);
  version = '';
  nbArguments = 1 + length(varargin);
  if nbArguments == 2
    version = varargin{1};
  elseif nbArguments ~= 1
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end

  modules = nmm_list();
  if isempty(modules)
    return
  end
  if isfield(modules, module_or_path)
    module_name = module_or_path;
    module_data = selectInstalledVersion(getfield(modules, module_or_path), version);
    return
  end
  if ~isempty(version) || ~isdir(module_or_path)
    return
  end
  module_or_path = fullpath(module_or_path);
  if ~endsWith(module_or_path, '/')
    module_or_path = [module_or_path, '/'];
  end
  for m = fieldnames(modules)'
    selected = selectInstalledPath(getfield(modules, m{1}), module_or_path);
    if ~isempty(selected)
      module_name = m{1};
      module_data = selected;
      return
    end
  end
end
%=============================================================================
function selected = selectInstalledVersion(module_data, version)
  selected = struct([]);
  versions = installedVersions(module_data);
  if isempty(version)
    if isfield(module_data, 'path') && isfield(module_data, 'version')
      selected.path = module_data.path;
      selected.load = module_data.load;
      selected.version = module_data.version;
    elseif ~isempty(versions)
      selected = versions(1);
    end
    return
  end
  for k = 1:length(versions)
    if strcmp(versions(k).version, version)
      selected = versions(k);
      return
    end
  end
end
%=============================================================================
function selected = selectInstalledPath(module_data, module_path)
  selected = struct([]);
  versions = installedVersions(module_data);
  for k = 1:length(versions)
    if strcmp(versions(k).path, module_path)
      selected = versions(k);
      return
    end
  end
end
%=============================================================================
function versions = installedVersions(module_data)
  versions = struct([]);
  if isfield(module_data, 'versions') && ~isempty(module_data.versions)
    versions = module_data.versions;
    return
  end
  if isfield(module_data, 'path') && isfield(module_data, 'version')
    versions = module_data;
    if isfield(versions, 'versions')
      versions = rmfield(versions, 'versions');
    end
    if isfield(versions, 'pinned_version')
      versions = rmfield(versions, 'pinned_version');
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function report = nmm_graph(varargin)
  if length(varargin) ~= 1
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  packageName = varargin{1};
  if ~ischar(packageName)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 2);
  end
  tree = nmm_tree(packageName);
  labels = {};
  edges = struct([]);
  [labels, edges] = collectGraph(tree, labels, edges);
  report = struct();
  report.package = packageName;
  report.dot = dotGraph(labels, edges);
  report.mermaid = mermaidGraph(labels, edges);
end
%=============================================================================
function [labels, edges] = collectGraph(node, labels, edges)
  parent = nodeLabel(node);
  labels = appendLabel(labels, parent);
  for k = 1:length(node.dependencies)
    child = nodeLabel(node.dependencies(k));
    labels = appendLabel(labels, child);
    edges = appendEdge(edges, parent, child, node.dependencies(k).requested);
    [labels, edges] = collectGraph(node.dependencies(k), labels, edges);
  end
end
%=============================================================================
function text = dotGraph(labels, edges)
  lines = {'digraph nmm {'};
  for k = 1:length(labels)
    lines{end + 1} = ['  "', escapeLabel(labels{k}), '";'];
  end
  for k = 1:length(edges)
    label = '';
    if ~isempty(edges(k).requested)
      label = [' [label="', escapeLabel(edges(k).requested), '"]'];
    end
    lines{end + 1} = ['  "', escapeLabel(edges(k).from), '" -> "', escapeLabel(edges(k).to), '"', label, ';'];
  end
  lines{end + 1} = '}';
  text = strjoin(lines, newline);
end
%=============================================================================
function text = mermaidGraph(labels, edges)
  lines = {'graph TD'};
  for k = 1:length(labels)
    lines{end + 1} = ['  n', int2str(k), '["', escapeLabel(labels{k}), '"]'];
  end
  for k = 1:length(edges)
    from = findLabel(labels, edges(k).from);
    to = findLabel(labels, edges(k).to);
    lines{end + 1} = ['  n', int2str(from), ' --> n', int2str(to)];
  end
  text = strjoin(lines, newline);
end
%=============================================================================
function label = nodeLabel(node)
  label = node.package;
  if ~isempty(node.version)
    label = [label, '@', node.version];
  elseif ~isempty(node.requested)
    label = [label, '@', node.requested];
  end
end
%=============================================================================
function labels = appendLabel(labels, label)
  if ~any(strcmp(labels, label))
    labels{end + 1} = label;
  end
end
%=============================================================================
function edges = appendEdge(edges, from, to, requested)
  edge = struct();
  edge.from = from;
  edge.to = to;
  edge.requested = requested;
  if isempty(edges)
    edges = edge;
  else
    edges(end + 1) = edge;
  end
end
%=============================================================================
function idx = findLabel(labels, label)
  idx = 1;
  for k = 1:length(labels)
    if strcmp(labels{k}, label)
      idx = k;
      return
    end
  end
end
%=============================================================================
function label = escapeLabel(label)
  label = strrep(label, '\', '\\');
  label = strrep(label, '"', '\"');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% result = nmm_i18n(MODULE)
% result = nmm_i18n(MODULE, LOCALE1, LOCALE2, ...)
%   Generate (or refresh) the locale catalogs of a module so its _()/_W() user
%   interface strings and its own "Nelson:<module>:*" error templates can be
%   translated. MODULE is a module root directory or an installed module name.
%
%   The work is delegated to ngen.i18n when the ngen module is available;
%   otherwise the same pipeline is run inline on the native i18nHelpers builtin
%   (extractUI / extractErrors / namespace / merge / sort). Catalogs are written
%   under MODULE/locale as <module>-ui-<locale>.json and
%   <module>-errors-<locale>.json (an empty catalog is still written as {}).
%=============================================================================
function result = nmm_i18n(varargin)
  if nargin < 1
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  moduleDir = nmm_i18n_resolve_dir(varargin{1});
  if nargin > 1
    locales = varargin(2:end);
  else
    locales = getavailablelanguages();
    locales = locales(:)';
  end
  name = nmm_i18n_module_name(moduleDir);

  if ismodule('ngen')
    result = ngen.i18n(moduleDir, 'Locales', locales, 'Name', name);
    return;
  end

  % --- Inline fallback (no ngen): core i18nHelpers only. ----------------------
  if ~any(strcmp(locales, 'en_US'))
    locales = [{'en_US'}, locales];
  end
  localeDir = [moduleDir, '/locale'];
  if ~isdir(localeDir)
    mkdir(localeDir);
  end
  uiEn = [localeDir, '/', name, '-ui-en_US.json'];
  errEn = [localeDir, '/', name, '-errors-en_US.json'];

  i18nHelpers('extractUI', moduleDir, uiEn);
  nmm_i18n_finalize(uiEn);
  i18nHelpers('extractErrors', moduleDir, errEn);
  i18nHelpers('namespace', errEn, [name, ':']);
  nmm_i18n_finalize(errEn);

  files = {uiEn, errEn};
  for k = 1:numel(locales)
    loc = locales{k};
    if strcmp(loc, 'en_US')
      continue;
    end
    uiLoc = [localeDir, '/', name, '-ui-', loc, '.json'];
    errLoc = [localeDir, '/', name, '-errors-', loc, '.json'];
    nmm_i18n_ensure_json(uiLoc);
    nmm_i18n_ensure_json(errLoc);
    i18nHelpers('merge', uiEn, uiLoc);
    i18nHelpers('merge', errEn, errLoc);
    nmm_i18n_finalize(uiLoc);
    nmm_i18n_finalize(errLoc);
    files{end + 1} = uiLoc; %#ok<AGROW>
    files{end + 1} = errLoc; %#ok<AGROW>
  end
  result = struct('name', name, 'localeDir', localeDir, 'files', {files});
end
%=============================================================================
function moduleDir = nmm_i18n_resolve_dir(value)
  if ~ischar(value) && ~(isstring(value) && isscalar(value))
    nmm_error('InvalidArgument', 'A module directory or name is expected.');
  end
  value = char(value);
  if isdir(value)
    moduleDir = strrep(value, '\', '/');
    while length(moduleDir) > 1 && strcmp(moduleDir(end), '/')
      moduleDir = moduleDir(1:end - 1);
    end
    return;
  end
  if ismodule(value)
    moduleDir = strrep(modulepath(value), '\', '/');
    return;
  end
  nmm_error('ModuleNotFound', 'Module directory or name not found.');
end
%=============================================================================
function name = nmm_i18n_module_name(moduleDir)
  name = '';
  jsonPath = [moduleDir, '/module.json'];
  if isfile(jsonPath)
    try
      info = jsondecode(jsonPath, '-file');
      if isstruct(info) && isfield(info, 'module') && ~isempty(info.module)
        name = char(info.module);
      end
    catch
    end
  end
  if isempty(name)
    parts = strsplit(moduleDir, '/');
    name = parts{end};
  end
end
%=============================================================================
function nmm_i18n_ensure_json(jsonFile)
  if ~isfile(jsonFile)
    filewrite(jsonFile, sprintf('{}\n'));
  end
end
%=============================================================================
function nmm_i18n_finalize(jsonFile)
  hasEntries = false;
  if isfile(jsonFile)
    try
      data = jsondecode(jsonFile, '-file');
      hasEntries = isstruct(data) && ~isempty(fieldnames(data));
    catch
    end
  end
  if hasEntries
    i18nHelpers('sort', jsonFile, jsonFile);
  else
    filewrite(jsonFile, sprintf('{}\n'));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% nmm('init', DESTINATION, ...) generates a valid module.json manifest.
% The manifest is validated with nmm's own schema validator
% (nmm_validate_module_json) so the produced file is always nmm-valid.
%=============================================================================
function result = nmm_init(varargin)
  if isempty(varargin)
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  destination = varargin{1};
  if ~ischar(destination) || isempty(destination)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 2);
  end
  options = parseOptions(varargin(2:end));
  destination = ensureTrailingSlash(destination);

  if options.interactive
    options = promptMissingFields(options, destination);
  end

  data = buildManifest(options, destination);
  nmm_validate_module_json(data);

  json = jsonprettyprint(jsonencode(data));

  % best-practice warnings reuse nmm's own warnings linter (non-fatal)
  warnings = nmm_module_json_warnings(data);

  if options.dryrun
    echoWarnings(warnings);
    result = data;
    result.warnings = warnings;
    return
  end

  if ~isdir(destination)
    mkdir(destination);
  end
  module_json_path = [destination, 'module.json'];
  if isfile(module_json_path) && ~options.force
    nmm_error('ModuleJsonAlreadyExists', 'module.json already exists (use ''Force'', true to overwrite): %s', module_json_path);
  end
  filewrite(module_json_path, json);

  if options.skeleton
    writeSkeleton(destination, data.module);
  end

  echoWarnings(warnings);
  result = fullpath(module_json_path);
end
%=============================================================================
function echoWarnings(warnings)
  if isempty(warnings)
    return
  end
  disp(_('module.json best-practice suggestions:'));
  for k = 1:length(warnings)
    disp(['  - ', warnings{k}]);
  end
end
%=============================================================================
function options = parseOptions(args)
  options = struct();
  options.module = '';
  options.title = '';
  options.summary = '';
  options.version = '';
  options.license = '';
  options.builtin = [];
  options.platforms = {};
  options.nelson = '';
  options.dependencies = [];
  options.keywords = {};
  options.authors = {};
  options.description = '';
  options.repository = '';
  options.homepage = '';
  options.issues = '';
  options.documentation = '';
  options.force = false;
  options.dryrun = false;
  options.interactive = false;
  options.skeleton = false;

  if mod(length(args), 2) ~= 0
    nmm_error('NameValuePairsExpected', 'name/value pairs expected.');
  end
  for k = 1:2:length(args)
    key = args{k};
    value = args{k + 1};
    if ~ischar(key)
      nmm_error('CharactersExpected', '#%d argument: characters expected.', k + 2);
    end
    switch lower(key)
      case 'module'
        options.module = asChar(value, 'module');
      case 'title'
        options.title = asChar(value, 'title');
      case 'summary'
        options.summary = asChar(value, 'summary');
      case 'version'
        options.version = asChar(value, 'version');
      case 'license'
        options.license = asChar(value, 'license');
      case 'nelson'
        options.nelson = asChar(value, 'nelson');
      case 'description'
        options.description = asChar(value, 'description');
      case 'repository'
        options.repository = asChar(value, 'repository');
      case 'homepage'
        options.homepage = asChar(value, 'homepage');
      case 'issues'
        options.issues = asChar(value, 'issues');
      case 'documentation'
        options.documentation = asChar(value, 'documentation');
      case 'builtin'
        options.builtin = asLogical(value, 'builtin');
      case 'platforms'
        options.platforms = asCellstr(value, 'platforms');
      case 'keywords'
        options.keywords = asCellstr(value, 'keywords');
      case 'authors'
        options.authors = asCellstr(value, 'authors');
      case 'author'
        options.authors = asCellstr(value, 'author');
      case 'dependencies'
        options.dependencies = asDependencies(value);
      case 'force'
        options.force = asLogical(value, 'Force');
      case 'dryrun'
        options.dryrun = asLogical(value, 'DryRun');
      case 'interactive'
        options.interactive = asLogical(value, 'Interactive');
      case 'skeleton'
        options.skeleton = asLogical(value, 'Skeleton');
      otherwise
        nmm_error('UnknownOption', 'unknown option: %s', key);
    end
  end
end
%=============================================================================
function data = buildManifest(options, destination)
  module_name = options.module;
  if isempty(module_name)
    module_name = defaultModuleName(destination, options.title);
  end

  version = options.version;
  if isempty(version)
    version = '1.0.0';
  end
  platforms = options.platforms;
  if isempty(platforms)
    platforms = {'all'};
  end
  nelson = options.nelson;
  if isempty(nelson)
    nelson = '>=2.0.0';
  end
  builtin = options.builtin;
  if isempty(builtin)
    builtin = false;
  end
  dependencies = options.dependencies;
  if isempty(dependencies)
    dependencies = struct();
  end
  title = options.title;
  if isempty(title)
    title = module_name;
  end
  summary = options.summary;
  if isempty(summary)
    summary = title;
  end

  data = struct();
  data.module = module_name;
  data.title = title;
  data.summary = summary;
  data.version = version;
  if ~isempty(options.description)
    data.description = options.description;
  end
  if ~isempty(options.authors)
    data.authors = options.authors;
  end
  if ~isempty(options.keywords)
    data.keywords = options.keywords;
  end
  data.license = options.license;
  if ~isempty(options.repository)
    data.repository = options.repository;
  end
  if ~isempty(options.homepage)
    data.homepage = options.homepage;
  end
  if ~isempty(options.issues)
    data.issues = options.issues;
  end
  if ~isempty(options.documentation)
    data.documentation = options.documentation;
  end
  data.builtin = builtin;
  data.platforms = platforms;
  data.nelson = nelson;
  data.dependencies = dependencies;
end
%=============================================================================
function name = defaultModuleName(destination, title)
  name = folderBaseName(destination);
  if isValidModuleName(name)
    return
  end
  name = sanitizeModuleName(name);
  if isValidModuleName(name)
    return
  end
  name = sanitizeModuleName(title);
  if isValidModuleName(name)
    return
  end
  nmm_error('ModuleNameNotDerivable', 'Unable to derive a valid module name, please provide ''module''.');
end
%=============================================================================
function base = folderBaseName(destination)
  base = destination;
  while endsWith(base, '/') || endsWith(base, '\')
    base = base(1:end - 1);
  end
  slash = max([strfind(base, '/'), strfind(base, '\')]);
  if ~isempty(slash)
    base = base(slash + 1:end);
  end
end
%=============================================================================
function name = sanitizeModuleName(candidate)
  if isempty(candidate)
    name = '';
    return
  end
  name = regexprep(candidate, '[^A-Za-z0-9_]', '_');
  name = regexprep(name, '^[^A-Za-z]+', '');
end
%=============================================================================
function tf = isValidModuleName(name)
  tf = ischar(name) && ~isempty(name) && ~isempty(regexp(name, '^[A-Za-z][A-Za-z0-9_]*$', 'once'));
end
%=============================================================================
function value = asChar(value, fieldname)
  if isstring(value)
    value = char(value);
  end
  if ~ischar(value)
    nmm_error('OptionCharactersExpected', 'option ''%s'': characters expected.', fieldname);
  end
end
%=============================================================================
function value = asLogical(value, fieldname)
  if ~(islogical(value) && isscalar(value))
    if isnumeric(value) && isscalar(value)
      value = logical(value);
    else
      nmm_error('LogicalExpected', 'option ''%s'': logical scalar expected.', fieldname);
    end
  end
end
%=============================================================================
function value = asCellstr(value, fieldname)
  if ischar(value)
    value = {value};
  elseif isstring(value)
    value = cellstr(value);
  elseif iscell(value)
    for k = 1:numel(value)
      if isstring(value{k})
        value{k} = char(value{k});
      end
      if ~ischar(value{k})
        nmm_error('OptionCellOfStringsExpected', 'option ''%s'': cell of strings expected.', fieldname);
      end
    end
    value = value(:)';
  else
    nmm_error('OptionCellOfStringsExpected', 'option ''%s'': cell of strings expected.', fieldname);
  end
end
%=============================================================================
function value = asDependencies(value)
  if isempty(value)
    value = struct();
    return
  end
  if ~isstruct(value)
    nmm_error('InvalidDependenciesOption', 'option ''dependencies'': struct expected.');
  end
end
%=============================================================================
function options = promptMissingFields(options, destination)
  if isempty(options.module)
    default_module = '';
    try
      default_module = defaultModuleName(destination, options.title);
    catch
      default_module = '';
    end
    options.module = promptValidated('module name', default_module, @isValidModuleName, 'Invalid module name.');
  end
  if isempty(options.title)
    options.title = promptText('title', options.module);
  end
  if isempty(options.summary)
    options.summary = promptText('summary', options.title);
  end
  if isempty(options.version)
    options.version = promptValidated('version', '1.0.0', @isSemverOk, 'Invalid semantic version.');
  end
  if isempty(options.license)
    options.license = promptText('license (SPDX)', 'MIT');
  end
  if isempty(options.nelson)
    options.nelson = promptText('nelson version range', '>=2.0.0');
  end
  if isempty(options.platforms)
    options.platforms = promptValidated('platforms (comma separated)', 'all', @isPlatformsOk, 'Platform not supported.', @splitList);
  end
  if isempty(options.keywords)
    answer = promptText('keywords (comma separated)', '');
    if ~isempty(strtrim(answer))
      options.keywords = splitList(answer);
    end
  end
  if isempty(options.dependencies)
    answer = promptText('dependencies (name=constraint, comma separated)', '');
    if ~isempty(strtrim(answer))
      options.dependencies = parseDependencyList(answer);
    end
  end
end
%=============================================================================
function value = promptText(label, default_value)
  prompt = sprintf('%s [%s]: ', label, default_value);
  answer = input(prompt, 's');
  if isempty(strtrim(answer))
    value = default_value;
  else
    value = strtrim(answer);
  end
end
%=============================================================================
function value = promptValidated(label, default_value, checkFcn, errorMessage, varargin)
  transform = @(x) x;
  if ~isempty(varargin)
    transform = varargin{1};
  end
  while true
    answer = promptText(label, default_value);
    candidate = transform(answer);
    try
      ok = checkFcn(candidate);
    catch
      ok = false;
    end
    if ok
      value = candidate;
      return
    end
    disp(errorMessage);
  end
end
%=============================================================================
function tf = isSemverOk(value)
  tf = false;
  if ~ischar(value) || isempty(value)
    return
  end
  try
    semver(value, value);
    tf = true;
  catch
    tf = false;
  end
end
%=============================================================================
function tf = isPlatformsOk(value)
  tf = nmm_is_supported_platform(value);
end
%=============================================================================
function items = splitList(text)
  items = {};
  tokens = strsplit(text, ',');
  for k = 1:length(tokens)
    token = strtrim(tokens{k});
    if ~isempty(token)
      items{end + 1} = token;
    end
  end
end
%=============================================================================
function deps = parseDependencyList(text)
  deps = struct();
  tokens = strsplit(text, ',');
  for k = 1:length(tokens)
    token = strtrim(tokens{k});
    if isempty(token)
      continue
    end
    pair = strsplit(token, '=');
    name = strtrim(pair{1});
    if length(pair) > 1
      constraint = strtrim(pair{2});
    else
      constraint = '>=0.0.0';
    end
    deps.(name) = constraint;
  end
end
%=============================================================================
function writeSkeleton(destination, module_name)
  header = ["%=============================================================================";
    "% generated by nmm('init')";
    "%============================================================================="];
  filewrite([destination, 'builder.m'], header);
  nmm_build_loader(module_name, destination(1:end - 1));
  if ~isdir([destination, 'etc'])
    mkdir([destination, 'etc']);
  end
  filewrite([destination, 'etc/startup.m'], header);
  filewrite([destination, 'etc/finish.m'], header);
  if ~isdir([destination, 'help'])
    mkdir([destination, 'help']);
  end
  if ~isdir([destination, 'help/en_US'])
    mkdir([destination, 'help/en_US']);
  end
  if ~isdir([destination, 'help/en_US/xml'])
    mkdir([destination, 'help/en_US/xml']);
  end
  filewrite([destination, 'help/en_US/xml/chapter.xml'], ...
    ['<?xml version="1.0" encoding="UTF-8" ?>', char(10), '<chapter></chapter>']);
  if ~isdir([destination, 'tests'])
    mkdir([destination, 'tests']);
  end
  test_lines = [header; ""; "assert_istrue(true);"];
  filewrite([destination, 'tests/test_', module_name, '.m'], test_lines);
end
%=============================================================================
function path = ensureTrailingSlash(path)
  if ~endsWith(path, '/')
    path = [path, '/'];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function report = nmm_install(varargin)
  report = [];
  switch length(varargin)
    case 1
      nmm_install_one_rhs(varargin{1});
    case 2
      report = nmm_install_two_rhs(varargin{1}, varargin{2});
    case 3
      report = nmm_install_options(varargin{1}, varargin{2}, varargin{3});
    case 4
      report = nmm_install_options(varargin{1}, varargin{2}, varargin{3}, varargin{4});
    otherwise
      nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
end
%=============================================================================
% nmm('install', module_name)
% nmm('install', local_module_directory)
% nmm('install', http_git_repository)
function nmm_install_one_rhs(param1, varargin)
  if ~ischar(param1)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 2);
  end
  runTests = testsFromEnvironment();
  if nargin == 2
    runTests = varargin{1};
  end
  if isfile(param1)
    nmm_install_file(param1);
  else
    if isdir(param1)
      nmm_install_directory(param1, runTests);
    else
      [res, url, tag_branch] = nmm_is_http_repository(param1);
      if res
        nmm_install_repository(url, tag_branch, runTests);
      else
        nmm_error('SourceExpected', 'An valid git url or local directory expected.');
      end
    end
  end
end
%=============================================================================
function report = nmm_install_two_rhs(module_name, module_version)
  report = [];
  if ~ischar(module_name)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 2);
  end
  if ~ischar(module_version)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 3);
  end
  if strcmp(module_version, '-dry-run')
    if isfile(module_name)
      report = dryRunPackageInstall(module_name);
    else
      report = nmm_install_registry_dry_run(module_name, '');
    end
  elseif strcmp(module_version, '-force')
    if ~isfile(module_name)
      nmm_error('PackageFilenameExpected', '#%d argument: package filename expected.', 2);
    end
    report = nmm_install_force_package(module_name);
  elseif strcmp(module_version, '-no-tests') || strcmp(module_version, '-tests')
    installSourceWithTests(module_name, strcmp(module_version, '-tests'));
  elseif strcmp(module_version, '-offline')
    installOfflinePackage(module_name, '');
  else
    packageInfo = nmm_registry('info', module_name, module_version);
    installPackageInfo(packageInfo);
  end
end
%=============================================================================
function report = dryRunPackageInstall(filename)
  if ~endsWith(filename, '.nmz')
    nmm_error('InvalidPackageFileExtension', 'filename extension .nmz expected.');
  end
  verifyPackageChecksum(filename);
  stagingPath = newTemporaryDirectory();
  try
    unzip(filename, stagingPath);
    nmm_validate(stagingPath);
    validateBuiltPackageStructure(stagingPath);
    lockFile = [stagingPath, 'module-lock.json'];
    if ~isfile(lockFile)
      nmm_error('ModuleLockMissing', 'module-lock.json is missing.');
    end
    info = jsondecode(lockFile, '-file');
    moduleInfo = nmm_read_module_json(stagingPath);
    validateArchiveLock(info, moduleInfo);
    validateLockChecksums(stagingPath, info);
    checkInstalledDependencies(info);
    destination = [usermodulesdir(), info.module, '/', info.version, '/'];
    report = struct();
    report.ok = true;
    report.module = info.module;
    report.version = info.version;
    report.destination = destination;
    report.destination_exists = isdir(destination);
    cleanupDirectory(stagingPath);
  catch
    e = lasterror();
    cleanupDirectory(stagingPath);
    error(e);
  end
end
%=============================================================================
function installOfflinePackage(module_name, versionSpec)
  source = nmm_cache('latest', module_name, versionSpec);
  nmm_install_one_rhs(source);
end
%=============================================================================
function installPackageInfo(packageInfo)
  refuseYankedPackage(packageInfo);
  verifyRegistryPackageCompatibility(packageInfo);
  installRegistryDependencies(packageInfo);
  source = packageSource(packageInfo);
  if isHttpArchiveSource(source)
    installRemoteArchive(source, packageInfo);
    return
  end
  verifyRegistryChecksum(packageInfo, source);
  nmm_install_one_rhs(source, testsPolicyForPackage(packageInfo));
end
%=============================================================================
function tf = isHttpArchiveSource(source)
  tf = ischar(source) && endsWith(lower(source), '.nmz') ...
      && (startsWith(source, 'http://') || startsWith(source, 'https://'));
end
%=============================================================================
function installRemoteArchive(source, packageInfo)
  % Download a hosted .nmz to a temporary file, verify its checksum against
  % the registry entry (mandatory for a remote archive), then install it.
  checksum = '';
  if isfield(packageInfo, 'checksum') && ischar(packageInfo.checksum)
    checksum = packageInfo.checksum;
  end
  if isempty(checksum)
    nmm_error('RegistryPackageChecksumRequired', 'A hosted .nmz package must declare a checksum in the registry.');
  end
  tempDir = newTemporaryDirectory();
  target = [tempDir, packageInfo.name, '-', packageInfo.version, '.nmz'];
  try
    websave(target, source, nmm_web_options());
  catch
    e = lasterror();
    cleanupDirectory(tempDir);
    nmm_error('RegistryPackageDownloadFailed', 'Cannot download package archive: %s (%s)', source, e.message);
  end
  if ~strcmpi(checksum, sha256(target, '-file'))
    cleanupDirectory(tempDir);
    nmm_error('RegistryPackageChecksumMismatch', 'Registry checksum does not match package source.');
  end
  try
    nmm_install_file(target);
    cleanupDirectory(tempDir);
  catch
    e = lasterror();
    cleanupDirectory(tempDir);
    error(e);
  end
end
%=============================================================================
function installSourceWithTests(source, runTests)
  if isdir(source)
    nmm_install_directory(source, runTests);
    return
  end
  [isRepository, url, tag_branch] = nmm_is_http_repository(source);
  if isRepository
    nmm_install_repository(url, tag_branch, runTests);
    return
  end
  if isfile(source)
    % prebuilt archives were tested when packed: nothing to run here
    nmm_install_file(source);
    return
  end
  nmm_error('SourceExpected', 'An valid git url or local directory expected.');
end
%=============================================================================
function refuseYankedPackage(packageInfo)
  % A yanked version stays resolvable for lockfiles but is never installed anew.
  if ~isfield(packageInfo, 'yanked') || isempty(packageInfo.yanked)
    return
  end
  value = packageInfo.yanked;
  yanked = (islogical(value) || isnumeric(value)) && logical(value(1));
  yanked = yanked || (ischar(value) && any(strcmpi(value, {'true', '1', 'yes'})));
  if ~yanked
    return
  end
  reason = '';
  if isfield(packageInfo, 'yank_reason') && ischar(packageInfo.yank_reason) && ~isempty(packageInfo.yank_reason)
    reason = [': ', packageInfo.yank_reason];
  end
  nmm_error('PackageYanked', 'Package version has been yanked from the registry: %s %s%s', packageInfo.name, packageInfo.version, reason);
end
%=============================================================================
function runTests = testsFromEnvironment()
  % Package tests are opt-in at install time: NELSON_NMM_INSTALL_TESTS=1
  % (or true/on/yes) runs them for every source install.
  value = lower(strtrim(getenv('NELSON_NMM_INSTALL_TESTS')));
  runTests = any(strcmp(value, {'1', 'true', 'on', 'yes'}));
end
%=============================================================================
function runTests = testsPolicyForPackage(packageInfo)
  % A registry entry can require the package tests ("tests": "required").
  runTests = testsFromEnvironment();
  if isfield(packageInfo, 'tests') && ischar(packageInfo.tests) ...
      && strcmpi(packageInfo.tests, 'required')
    runTests = true;
  end
end
%=============================================================================
function steps = sourceSteps(runTests)
  % Progress plan of a source install: the test step only counts when it runs.
  steps = struct();
  steps.total = 5 + double(logical(runTests));
  steps.fetch = 1;
  steps.dependencies = 2;
  steps.build = 3;
  steps.test = 4;
  steps.register = steps.total - 1;
  steps.done = steps.total;
end
%=============================================================================
function installRegistryDependencies(packageInfo)
  if ~isfield(packageInfo, 'dependencies')
    return
  end
  if ~isstruct(packageInfo.dependencies)
    nmm_error('RegistryDependenciesInvalid', 'Package registry dependencies must be a struct.');
  end
  for dependency = fieldnames(packageInfo.dependencies)'
    dependencyName = dependency{1};
    dependencySpec = packageInfo.dependencies.(dependencyName);
    ensureInstalledDependency(packageInfo.name, dependencyName, dependencySpec);
  end
end
%=============================================================================
function verifyRegistryPackageCompatibility(packageInfo)
  if isfield(packageInfo, 'platforms')
    [r, msg] = nmm_is_supported_platform(packageInfo.platforms);
    if ~r
      nmm_error('PlatformNotSupported', msg);
    end
  end
  verifyArtifactForArch(packageInfo);
  if isfield(packageInfo, 'nelson')
    if ~nelsonVersionSatisfies(packageInfo.nelson)
      nmm_error('NelsonVersionNotSupported', 'Nelson version not supported: %s', packageInfo.nelson);
    end
  end
end
%=============================================================================
function verifyArtifactForArch(packageInfo)
  % A binary package ships one archive per architecture under "artifacts". When
  % the running architecture has no archive (for instance a version that only
  % published win64 so far), fail with a clear message instead of a later
  % missing-source error.
  if ~isfield(packageInfo, 'artifacts') || ~isstruct(packageInfo.artifacts) ...
      || isempty(fieldnames(packageInfo.artifacts))
    return
  end
  arch = computer('arch');
  if ~isfield(packageInfo.artifacts, arch)
    nmm_error('ArchiveNotAvailable', 'No %s archive available for %s %s.', arch, packageInfo.name, packageInfo.version);
  end
end
%=============================================================================
function r = nelsonVersionSatisfies(range)
  if ~ischar(range)
    r = false;
    return
  end
  v = version('-number');
  current = sprintf('%d.%d.%d', v(1), v(2), v(3));
  if isVersionConstraint(range)
    r = semverConstraintSatisfied(current, range);
  else
    r = semver(current, range) == 0;
  end
end
%=============================================================================
function tf = isVersionConstraint(value)
  tf = startsWith(value, '>') || startsWith(value, '<') ...
      || startsWith(value, '=') || startsWith(value, '^') ...
      || startsWith(value, '~') || contains(value, ' ');
end
%=============================================================================
function verifyRegistryChecksum(packageInfo, source)
  if ~isfile(source)
    return
  end
  if ~isfield(packageInfo, 'checksum')
    return
  end
  checksum = packageInfo.checksum;
  if ~ischar(checksum) || isempty(checksum)
    return
  end
  if ~strcmpi(checksum, sha256(source, '-file'))
    nmm_error('RegistryPackageChecksumMismatch', 'Registry checksum does not match package source.');
  end
end
%=============================================================================
function source = packageSource(packageInfo)
  source = '';
  if isfield(packageInfo, 'source')
    source = packageInfo.source;
  elseif isfield(packageInfo, 'url')
    source = packageInfo.url;
  elseif isfield(packageInfo, 'archive')
    source = packageInfo.archive;
  end
  if ~ischar(source) || isempty(source)
    nmm_error('RegistryPackageSourceMissing', 'Package registry entry has no install source.');
  end
end
%=============================================================================
function nmm_install_file(filename)
  if ~endsWith(filename, '.nmz')
    nmm_error('InvalidPackageFileExtension', 'filename extension .nmz expected.');
  end
  verifyPackageChecksum(filename);
  stagingPath = newTemporaryDirectory();
  try
    unzip(filename, stagingPath);
    nmm_validate(stagingPath);
    validateBuiltPackageStructure(stagingPath);
    lockFile = [stagingPath, 'module-lock.json'];
    if ~isfile(lockFile)
      nmm_error('ModuleLockMissing', 'module-lock.json is missing.');
    end
    info = jsondecode(lockFile, '-file');
    nmm_progress('install', info.module, info.version, 'extract', 1, 3);
    if nmm_is_installed(info.module, info.version)
      warning('Nelson:module:alreadyInstalled', '%s already installed.', info.module);
      cleanupDirectory(stagingPath);
      return
    end
    moduleInfo = nmm_read_module_json(stagingPath);
    validateArchiveLock(info, moduleInfo);
    validateLockChecksums(stagingPath, info);
    checkInstalledDependencies(info);
    isSupported = strcmp(info.platform, 'all') || strcmp(info.platform, computer('arch'));
    if ~isSupported
      nmm_error('PlatformNotSupported', 'platform not supported.');
    end
    nmm_progress('install', info.module, info.version, 'register', 2, 3);
    commitPreparedModule(stagingPath, info.module, info.version);
    nmm_cache('store', filename, info.module, info.version);
    nmm_progress('install', info.module, info.version, 'done', 3, 3);
    cleanupDirectory(stagingPath);
  catch
    e = lasterror();
    cleanupDirectory(stagingPath);
    error(e);
  end
end
%=============================================================================
function validateArchiveLock(lock, moduleInfo)
  if ~isfield(lock, 'module') || ~strcmp(lock.module, moduleInfo.module)
    nmm_error('ModuleLockModuleMismatch', 'module-lock.json module name mismatch.');
  end
  if ~isfield(lock, 'version') || ~strcmp(lock.version, moduleInfo.version)
    nmm_error('ModuleLockVersionMismatch', 'module-lock.json module version mismatch.');
  end
  if ~isfield(lock, 'builtin') || lock.builtin ~= moduleInfo.builtin
    nmm_error('ModuleLockBuiltinMismatch', 'module-lock.json builtin mismatch.');
  end
  if ~isfield(lock, 'package_type') || ~strcmp(lock.package_type, packageType(moduleInfo))
    nmm_error('ModuleLockPackageTypeMismatch', 'module-lock.json package type mismatch.');
  end
  if ~isfield(lock, 'nelson') || ~isstruct(lock.nelson)
    nmm_error('ModuleLockNelsonMissing', 'module-lock.json field is missing: nelson');
  end
  if ~isfield(lock.nelson, 'version') || ~isfield(lock.nelson, 'arch') || ~isfield(lock.nelson, 'abi')
    nmm_error('ModuleLockNelsonMissing', 'module-lock.json field is missing: nelson');
  end
  if lock.builtin
    if ~strcmp(lock.nelson.arch, computer('arch'))
      nmm_error('NelsonArchitectureNotSupported', 'Nelson architecture not supported.');
    end
    if ~strcmp(lock.nelson.abi, nelsonAbiTag())
      nmm_error('NelsonAbiNotSupported', 'Nelson ABI not supported: %s', lock.nelson.abi);
    end
  end
end
%=============================================================================
function type = packageType(info)
  if info.builtin
    type = 'binary';
  else
    type = 'source';
  end
end
%=============================================================================
function verifyPackageChecksum(filename)
  checksumFile = [filename, '.sha256'];
  if ~isfile(checksumFile)
    return
  end
  expected = strtrim(fileread(checksumFile));
  separator = strfind(expected, ' ');
  if ~isempty(separator)
    expected = expected(1:separator(1) - 1);
  end
  actual = sha256(filename, '-file');
  if ~strcmpi(expected, actual)
    nmm_error('PackageChecksumMismatch', 'Package checksum does not match.');
  end
end
%=============================================================================
function validateLockChecksums(modulePath, lock)
  if ~isfield(lock, 'checksums') || ~isstruct(lock.checksums)
    nmm_error('ModuleLockChecksumsMissing', 'module-lock.json field is missing: checksums');
  end
  checksums = lock.checksums;
  required = {'module_json', 'loader'};
  for field = required
    if ~isfield(checksums, field{1})
      nmm_error('ModuleLockChecksumMissing', ['module-lock.json checksum is missing: ', field{1}]);
    end
  end
  for field = fieldnames(checksums)'
    name = field{1};
    filename = checksumFilename(modulePath, name);
    if isempty(filename)
      nmm_error('ModuleLockChecksumUnknownFile', ['module-lock.json checksum has unknown file: ', name]);
    end
    if ~isfile(filename)
      nmm_error('ModuleLockChecksumFileMissing', ['module-lock.json checksum file is missing: ', name]);
    end
    if ~strcmpi(checksums.(name), sha256(filename, '-file'))
      nmm_error('ModuleLockChecksumMismatch', ['module-lock.json checksum mismatch: ', name]);
    end
  end
end
%=============================================================================
function filename = checksumFilename(modulePath, name)
  root = ensureTrailingSlash(modulePath);
  switch name
    case 'module_json'
      filename = [root, 'module.json'];
    case 'loader'
      filename = [root, 'loader.m'];
    case 'builder'
      filename = [root, 'builder.m'];
    case 'etc_startup'
      filename = [root, 'etc/startup.m'];
    case 'etc_finish'
      filename = [root, 'etc/finish.m'];
    otherwise
      filename = '';
  end
end
%=============================================================================
function validateBuiltPackageStructure(module_path)
  if ~isfile([module_path, 'loader.m'])
    nmm_error('LoaderMissing', 'loader.m is missing.');
  end
  if ~isfile([module_path, 'module-lock.json'])
    nmm_error('ModuleLockMissing', 'module-lock.json is missing.');
  end
end
%=============================================================================
function nmm_install_directory(directory, varargin)
  runTests = testsFromEnvironment();
  if nargin == 2
    runTests = varargin{1};
  end
  steps = sourceSteps(runTests);
  directory = ensureTrailingSlash(directory);
  if ~is_local_module(directory)
    nmm_error('ModuleDirectoryExpectedValidModuleRepository', 'Valid module repository expected.');
  end
  nmm_validate(directory);
  module_description = nmm_read_module_json(directory);
  if nmm_is_installed(module_description.module, module_description.version)
    warning('Nelson:module:alreadyInstalled', '%s already installed.', module_description.module);
    return
  end
  nmm_progress('install', module_description.module, module_description.version, 'dependencies', steps.dependencies, steps.total);
  installModuleDependencies(directory, module_description);
  [r, msg] = nmm_is_supported_platform(module_description.platforms);
  if ~r
    nmm_error('PlatformNotSupported', msg);
  end
  if (module_description.builtin && ~havecompiler())
    installCompiler = false;
    if ispc()
      [installCompiler, message] = configuremsvc();
    end
    if installCompiler
      warning('Nelson:module:visualStudioConfigured', 'Visual studio detected and configured to be used with Nelson.');
    else
      nmm_error('CompilerRequired', 'An C/C++ compiler is required by %s', module_description.module);
    end
  end
  installSourceModule(directory, module_description, runTests);
end
%=============================================================================
function nmm_install_repository(url, tag_branch, varargin)
  runTests = testsFromEnvironment();
  if nargin == 3
    runTests = varargin{1};
  end
  steps = sourceSteps(runTests);
  sourcePath = newTemporaryDirectory();
  try
    repo('export', url, tag_branch, sourcePath);
    nmm_validate(sourcePath);
    module_description = nmm_read_module_json(sourcePath);
    nmm_progress('install', module_description.module, module_description.version, 'fetch', steps.fetch, steps.total);
    if nmm_is_installed(module_description.module, module_description.version)
      warning('Nelson:module:alreadyInstalled', '%s already installed.', module_description.module);
      cleanupDirectory(sourcePath);
      return
    end
    nmm_progress('install', module_description.module, module_description.version, 'dependencies', steps.dependencies, steps.total);
    installModuleDependencies(sourcePath, module_description);
    [r, msg] = nmm_is_supported_platform(module_description.platforms);
    if ~r
      nmm_error('PlatformNotSupported', msg);
    end
    if (module_description.builtin && ~havecompiler())
      installCompiler = false;
      if ispc()
        [installCompiler, message] = configuremsvc();
      end
      if installCompiler
        warning('Nelson:module:visualStudioConfigured', 'Visual studio detected and configured to be used with Nelson.');
      else
        nmm_error('CompilerRequired', 'An C/C++ compiler is required by %s', module_description.module);
      end
    end
    installSourceModule(sourcePath, module_description, runTests);
    cleanupDirectory(sourcePath);
  catch
    e = lasterror();
    cleanupDirectory(sourcePath);
    error(e);
  end
end
%=============================================================================
function r = is_local_module(param)
  r = false;
  if isdir(param)
    path = fullpath(param);
    if ~endsWith(path, '/')
      path = [path, '/'];
    end
    r = isfile([path, 'module.json']) && isfile([path, 'builder.m']);
  end
end
%=============================================================================
function installModuleDependencies(module_path, module_description)
  dependencies = resolvedSourceDependencies(module_path, module_description);
  if isempty(fieldnames(dependencies))
    return
  end
  for dependency = fieldnames(dependencies)'
    dependencyName = dependency{1};
    dependencySpec = dependencies.(dependencyName);
    ensureInstalledDependency(module_description.module, dependencyName, dependencySpec);
  end
end
%=============================================================================
function dependencies = resolvedSourceDependencies(module_path, module_description)
  if isSourceLocked(module_path)
    lock = jsondecode([ensureTrailingSlash(module_path), 'module-lock.json'], '-file');
    validateSourceLock(lock, module_description);
    dependencies = lock.dependencies;
    return
  end
  dependencies = struct();
  if isfield(module_description, 'dependencies')
    dependencies = module_description.dependencies;
  end
end
%=============================================================================
function r = isSourceLocked(module_path)
  r = isfile([ensureTrailingSlash(module_path), 'module-lock.json']);
end
%=============================================================================
function validateSourceLock(lock, module_description)
  if ~isfield(lock, 'module') || ~strcmp(lock.module, module_description.module)
    nmm_error('ModuleLockModuleMismatch', 'module-lock.json module name mismatch.');
  end
  if ~isfield(lock, 'version') || ~strcmp(lock.version, module_description.version)
    nmm_error('ModuleLockVersionMismatch', 'module-lock.json module version mismatch.');
  end
  if ~isfield(lock, 'dependencies') || ~isstruct(lock.dependencies)
    nmm_error('ModuleLockDependenciesMissing', 'module-lock.json field is missing: dependencies');
  end
end
%=============================================================================
function ensureInstalledDependency(requesterName, dependencyName, dependencySpec)
  if ~ischar(dependencySpec)
    nmm_error('InvalidDependencyDeclaration', 'Invalid dependency declaration: %s', dependencyName);
  end
  if nmm_is_installed(dependencyName)
    if isDependencySource(dependencySpec)
      return
    end
    modules = nmm_list();
    dependencyData = getfield(modules, dependencyName);
    if versionSatisfies(dependencyData.version, dependencySpec)
      return
    end
    compatibleVersion = findCompatibleInstalledVersion(dependencyData, dependencySpec);
    if ~isempty(compatibleVersion)
      nmm_load(dependencyName, compatibleVersion);
      return
    end
    versions = installedVersionsText(dependencyData);
    nmm_error('DependencyConflict', '%s requires %s %s, installed versions: %s', requesterName, dependencyName, dependencySpec, versions);
  end
  if isDependencySource(dependencySpec)
    nmm_install_one_rhs(dependencySpec);
  else
    try
      nmm_install_two_rhs(dependencyName, dependencySpec);
    catch
      e = lasterror();
      if isMissingRegistryDependencyError(e)
        nmm_error('DependencyNotInstalled', nmm_missing_dependency_message(dependencyName));
      end
      error(e);
    end
  end
  nmm_mark_installed_as_dependency(dependencyName);
end
%=============================================================================
function tf = isMissingRegistryDependencyError(e)
  tf = strcmp(e.identifier, 'Nelson:nmm:PackageNotFound') ...
      || strcmp(e.identifier, 'Nelson:nmm:RegistryNotConfigured');
end
%=============================================================================
function r = isDependencySource(dependencySpec)
  [isRepository, url, tag_branch] = nmm_is_http_repository(dependencySpec);
  r = isRepository || isdir(dependencySpec) || isfile(dependencySpec);
end
%=============================================================================
function r = versionSatisfies(installedVersion, dependencySpec)
  if startsWith(dependencySpec, '>') || startsWith(dependencySpec, '<') ...
      || startsWith(dependencySpec, '=') || startsWith(dependencySpec, '^') ...
      || startsWith(dependencySpec, '~') || contains(dependencySpec, ' ')
    r = semverConstraintSatisfied(installedVersion, dependencySpec);
  else
    r = semver(installedVersion, dependencySpec) == 0;
  end
end
%=============================================================================
function tf = semverConstraintSatisfied(installedVersion, dependencySpec)
  tf = true;
  constraints = strsplit(strtrim(dependencySpec), ' ');
  for k = 1:length(constraints)
    item = constraints{k};
    if isempty(item)
      continue
    end
    try
      if semver(installedVersion, item) ~= 1
        tf = false;
        return
      end
    catch
      tf = false;
      return
    end
  end
end
%=============================================================================
function version = findCompatibleInstalledVersion(dependencyData, dependencySpec)
  version = '';
  versions = installedVersions(dependencyData);
  for k = 1:length(versions)
    if versionSatisfies(versions(k).version, dependencySpec)
      if isempty(version) || semver(versions(k).version, version) == 1
        version = versions(k).version;
      end
    end
  end
end
%=============================================================================
function text = installedVersionsText(dependencyData)
  versions = installedVersions(dependencyData);
  values = {};
  for k = 1:length(versions)
    values{end + 1} = versions(k).version;
  end
  text = strjoin(values, ', ');
  if isempty(text)
    text = _('none');
  end
end
%=============================================================================
function installSourceModule(sourcePath, module_description, varargin)
  runTests = false;
  if nargin == 3
    runTests = varargin{1};
  end
  steps = sourceSteps(runTests);
  stagingPath = newTemporaryDirectory();
  try
    copyfile(sourcePath, stagingPath, 'f');
    nmm_progress('install', module_description.module, module_description.version, 'build', steps.build, steps.total);
    run([stagingPath, 'builder.m']);
    if runTests
      nmm_progress('install', module_description.module, module_description.version, 'test', steps.test, steps.total);
      runPackageTests(stagingPath);
    end
    createModuleLockJson(stagingPath);
    nmm_progress('install', module_description.module, module_description.version, 'register', steps.register, steps.total);
    commitPreparedModule(stagingPath, module_description.module, module_description.version);
    cleanupDirectory(stagingPath);
    nmm_progress('install', module_description.module, module_description.version, 'done', steps.done, steps.total);
  catch
    e = lasterror();
    cleanupDirectory(stagingPath);
    error(e);
  end
end
%=============================================================================
function runPackageTests(module_path)
  testFiles = packageTestFiles(module_path);
  if isempty(testFiles)
    nmm_error('PackageTestsMissing', 'No package tests found.');
  end
  status = test_run(testFiles, '-stoponfail');
  if ~status
    nmm_error('PackageTestsFailed', 'Package tests failed.');
  end
end
%=============================================================================
function testFiles = packageTestFiles(module_path)
  root = ensureTrailingSlash(module_path);
  entries = dir([root, 'tests/*.m']);
  testFiles = {};
  for k = 1:length(entries)
    if ~entries(k).isdir
      testFiles{end + 1} = [root, 'tests/', entries(k).name];
    end
  end
end
%=============================================================================
function destination_dir = commitPreparedModule(source, module_name, module_version)
  destination_dir = '';
  snapshot = installedModuleSnapshot(module_name);
  destination_dir = copyModule(source, module_name, module_version);
  try
    if ismodule(module_name)
      removemodule(module_name);
    end
    saveInstalledModule(module_name, destination_dir, module_version);
    modules = nmm_list();
    activeModule = getfield(modules, module_name);
    nmm_load(module_name, activeModule.version);
  catch
    e = lasterror();
    if isdir(destination_dir)
      cleanupDirectory(destination_dir);
    end
    restoreInstalledModuleSnapshot(module_name, snapshot);
    error(e);
  end
end
%=============================================================================
function destination_dir = copyModule(source, module_name, module_version)
  p = usermodulesdir();
  destination_dir = [p, module_name, '/', module_version, '/'];
  if isdir(destination_dir)
    nmm_prepare_destination(destination_dir, module_name, module_version);
  end
  mkdir(destination_dir);
  try
    copyfile(source, destination_dir, 'f');
    deployhelp('add', module_name, destination_dir);
  catch
    e = lasterror();
    cleanupDirectory(destination_dir);
    error(e);
  end
end
%=============================================================================
function saveInstalledModule(module_name, module_path, version)
  element.path = module_path;
  element.load = true;
  element.version = version;
  modules = nmm_list();
  if isfield(modules, module_name)
    current = getfield(modules, module_name);
    versions = upsertInstalledVersion(installedVersions(current), element);
    activeVersion = selectedActiveVersion(current, versions);
    active = selectInstalledVersion(versions, activeVersion);
    active.versions = versions;
    if isfield(current, 'pinned_version') && hasInstalledVersion(versions, current.pinned_version)
      active.pinned_version = current.pinned_version;
    end
    modules.(module_name) = active;
  else
    element.versions = element;
    modules.(module_name) = element;
  end
  p = usermodulesdir();
  modules_json_path = [p, 'modules.json'];
  txt = jsonprettyprint(jsonencode(modules));
  filewrite(modules_json_path, txt);
end
%=============================================================================
function versions = installedVersions(module_data)
  versions = struct([]);
  if isfield(module_data, 'versions') && ~isempty(module_data.versions)
    versions = module_data.versions;
    return
  end
  if isfield(module_data, 'path') && isfield(module_data, 'version')
    versions = module_data;
    if isfield(versions, 'versions')
      versions = rmfield(versions, 'versions');
    end
    if isfield(versions, 'pinned_version')
      versions = rmfield(versions, 'pinned_version');
    end
  end
end
%=============================================================================
function versions = upsertInstalledVersion(versions, element)
  if isempty(versions)
    versions = element;
    return
  end
  for k = 1:length(versions)
    if strcmp(versions(k).version, element.version)
      versions(k) = element;
      return
    end
  end
  versions(end + 1) = element;
end
%=============================================================================
function version = selectedActiveVersion(current, versions)
  if isfield(current, 'pinned_version') && hasInstalledVersion(versions, current.pinned_version)
    version = current.pinned_version;
    return
  end
  version = latestInstalledVersion(versions);
end
%=============================================================================
function version = latestInstalledVersion(versions)
  version = versions(1).version;
  for k = 2:length(versions)
    if semver(versions(k).version, version) == 1
      version = versions(k).version;
    end
  end
end
%=============================================================================
function r = hasInstalledVersion(versions, version)
  r = false;
  for k = 1:length(versions)
    if strcmp(versions(k).version, version)
      r = true;
      return
    end
  end
end
%=============================================================================
function selected = selectInstalledVersion(versions, version)
  selected = struct([]);
  for k = 1:length(versions)
    if strcmp(versions(k).version, version)
      selected = versions(k);
      return
    end
  end
end
%=============================================================================
function createModuleLockJson(module_path)
  info = nmm_read_module_json(module_path);
  moduleLockJson = [module_path, '/module-lock.json'];
  st = struct();
  st.module = info.module;
  st.version = info.version;
  st.lock = 2;
  st.lock_format = 'nelson.nmm.lock/2';
  if ~info.builtin
    st.platform = 'all';
  else
    st.platform = computer('arch');
  end
  st.builtin = info.builtin;
  st.package_type = packageType(info);
  source = struct();
  source.type = 'local';
  source.reference = '';
  st.source = source;
  nelson = struct();
  nelson.version = nelsonVersionString();
  nelson.arch = computer('arch');
  nelson.abi = nelsonAbiTag();
  st.nelson = nelson;
  st.checksums = lockChecksums(module_path);
  modules = readModulesJson();
  dependencies = struct();
  if isfield(info, 'dependencies')
    for m = fieldnames(info.dependencies)'
      if ~isfield(modules, m{1})
        nmm_error('DependencyNotInstalled', '%s not installed.', m{1});
      end
      dependencyInfo = getfield(modules, m{1});
      dependencies.(m{1}) = dependencyInfo.version;
    end
  end
  st.dependencies = dependencies;
  content = jsonprettyprint(jsonencode(st));
  filewrite(moduleLockJson, content);
end
%=============================================================================
function checksums = lockChecksums(module_path)
  root = ensureTrailingSlash(module_path);
  checksums = struct();
  checksums = addFileChecksum(checksums, 'module_json', [root, 'module.json']);
  checksums = addFileChecksum(checksums, 'loader', [root, 'loader.m']);
  checksums = addFileChecksum(checksums, 'builder', [root, 'builder.m']);
  checksums = addFileChecksum(checksums, 'etc_startup', [root, 'etc/startup.m']);
  checksums = addFileChecksum(checksums, 'etc_finish', [root, 'etc/finish.m']);
end
%=============================================================================
function checksums = addFileChecksum(checksums, field, filename)
  if isfile(filename)
    checksums.(field) = sha256(filename, '-file');
  end
end
%=============================================================================
function data = readModulesJson()
  p = usermodulesdir();
  modules_json_path = [p, 'modules.json'];
  if isfile(modules_json_path)
    data = jsondecode(modules_json_path, '-file');
  else
    data = struct();
  end
end
%=============================================================================
function writeModulesJson(data)
  p = usermodulesdir();
  modules_json_path = [p, 'modules.json'];
  filewrite(modules_json_path, jsonprettyprint(jsonencode(data)));
end
%=============================================================================
function s = nelsonVersionString()
  v = version('-number');
  s = sprintf('%d.%d.%d', v(1), v(2), v(3));
end
%=============================================================================
function tag = nelsonAbiTag()
  compiler = version('-compiler');
  tag = [computer('arch'), '-', compiler{3}];
end
%=============================================================================
function checkInstalledDependencies(info)
  if ~isfield(info, 'dependencies')
    return
  end
  for m = fieldnames(info.dependencies)'
    requiredVersion = info.dependencies.(m{1});
    if ~nmm_is_installed(m{1}, requiredVersion)
      nmm_error('DependencyNotInstalled', nmm_missing_dependency_message(m{1}));
    end
  end
end
%=============================================================================
function snapshot = installedModuleSnapshot(module_name)
  snapshot = struct();
  snapshot.exists = false;
  snapshot.data = struct();
  modules = nmm_list();
  if isfield(modules, module_name)
    snapshot.exists = true;
    snapshot.data = getfield(modules, module_name);
  end
end
%=============================================================================
function restoreInstalledModuleSnapshot(module_name, snapshot)
  if ismodule(module_name)
    try
      removemodule(module_name);
    catch
    end
  end
  try
    deployhelp('remove', module_name);
  catch
  end
  modules = readModulesJson();
  if snapshot.exists
    modules.(module_name) = snapshot.data;
  elseif isfield(modules, module_name)
    modules = rmfield(modules, module_name);
  end
  writeModulesJson(modules);
  if snapshot.exists && isfield(snapshot.data, 'path') && isdir(snapshot.data.path)
    try
      nmm_load(module_name, snapshot.data.version);
    catch
    end
  end
end
%=============================================================================
function path = newTemporaryDirectory()
  root = [usermodulesdir(), '.nmm-tmp/'];
  if ~isdir(root)
    mkdir(root);
  end
  path = [root, createGUID(), '/'];
  mkdir(path);
end
%=============================================================================
function cleanupDirectory(path)
  if ischar(path) && isdir(path)
    [r, msg] = rmdir(path, 's');
  end
end
%=============================================================================
function path = ensureTrailingSlash(path)
  if ~endsWith(path, '/')
    path = [path, '/'];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function report = nmm_install_force_package(filename)
  report = nmm_install(filename, '-dry-run');
  wasInstalled = nmm_is_installed(report.module, report.version);
  if wasInstalled
    nmm_uninstall(report.module, report.version, '-force');
  elseif report.destination_exists
    removeOrphanDestination(report.destination);
  end
  nmm_install(filename);
  report.forced = wasInstalled;
end
%=============================================================================
function removeOrphanDestination(destination)
  root = usermodulesdir();
  if ~startsWith(destination, root) || ~isdir(destination)
    return
  end
  [res, msg] = rmdir(destination, 's');
  if ~res
    nmm_error('InstalledDirectoryRemoveFailed', msg);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function report = nmm_install_options(varargin)
  if length(varargin) == 3
    report = installThree(varargin{1}, varargin{2}, varargin{3});
  elseif length(varargin) == 4
    report = installFour(varargin{1}, varargin{2}, varargin{3}, varargin{4});
  else
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
end
%=============================================================================
function report = installThree(packageName, versionSpec, option)
  report = [];
  validateText(packageName, '#2');
  validateText(versionSpec, '#3');
  validateText(option, '#4');
  if strcmp(versionSpec, '-offline') && strcmp(option, '-dry-run')
    report = dryRunOfflinePackage(packageName, '');
  elseif strcmp(option, '-offline')
    nmm('install', nmm_cache('latest', packageName, versionSpec));
  elseif strcmp(option, '-dry-run')
    report = nmm_install_registry_dry_run(packageName, versionSpec);
  elseif strcmp(option, '-no-tests')
    installRegistryPackage(packageName, versionSpec, 'off', false);
  elseif strcmp(option, '-tests')
    installRegistryPackage(packageName, versionSpec, 'on', false);
  elseif strcmp(option, '-force')
    installRegistryPackage(packageName, versionSpec, 'auto', true);
  else
    nmm_error('InvalidOptionExpected', '%s expected.', sprintf('#%d argument: ''-offline'', ''-dry-run'', ''-tests'', ''-no-tests'' or ''-force''', 4));
  end
end
%=============================================================================
function report = installFour(packageName, versionSpec, option1, option2)
  validateText(packageName, '#2');
  validateText(versionSpec, '#3');
  validateText(option1, '#4');
  validateText(option2, '#5');
  offline = strcmp(option1, '-offline') || strcmp(option2, '-offline');
  dryRun = strcmp(option1, '-dry-run') || strcmp(option2, '-dry-run');
  if offline && dryRun
    report = dryRunOfflinePackage(packageName, versionSpec);
  else
    nmm_error('InvalidOptionOfflineDryRun', '#%d and #%d arguments: ''-offline'' and ''-dry-run'' expected.', 4, 5);
  end
end
%=============================================================================
function validateText(value, name)
  if ~ischar(value)
    nmm_error('CharactersExpectedCharactersExpected', '%s argument: characters expected.', name);
  end
end
%=============================================================================
function report = dryRunOfflinePackage(packageName, versionSpec)
  source = nmm_cache('latest', packageName, versionSpec);
  report = nmm('install', source, '-dry-run');
  report.offline = true;
  report.source = source;
end
%=============================================================================
function installRegistryPackage(packageName, versionSpec, testsMode, force)
  % testsMode: 'on' (-tests), 'off' (-no-tests) or 'auto' (environment). A
  % registry entry declaring "tests": "required" always runs them.
  plan = nmm_install_registry_dry_run(packageName, versionSpec);
  source = plan.install_plan(1).source;
  info = nmm_registry('info', packageName, versionSpec);
  if isfield(info, 'tests') && ischar(info.tests) && strcmpi(info.tests, 'required')
    testsMode = 'on';
  end
  if force && nmm_is_installed(plan.package, plan.version)
    nmm('remove', plan.package, plan.version, '-force');
  end
  isSource = isdir(source) || nmm_is_http_repository(source);
  if isSource && strcmp(testsMode, 'on')
    nmm('install', source, '-tests');
  elseif isSource && strcmp(testsMode, 'off')
    nmm('install', source, '-no-tests');
  elseif isfile(source) && force
    nmm('install', source, '-force');
  else
    nmm('install', source);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function report = nmm_install_registry_dry_run(packageName, versionSpec)
  if ~ischar(packageName)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 2);
  end
  if ~ischar(versionSpec)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 3);
  end
  packageInfo = nmm_registry('info', packageName, versionSpec);
  context = struct();
  context.plan = struct([]);
  context.conflicts = {};
  context.warnings = {};
  context.stack = {};
  context = addRegistryPackagePlan(context, packageInfo);
  report = struct();
  report.ok = isempty(context.conflicts);
  report.package = packageInfo.name;
  report.version = packageInfo.version;
  report.dependencies = packageDependencies(packageInfo);
  report.install_plan = context.plan;
  report.conflicts = context.conflicts;
  report.warnings = context.warnings;
end
%=============================================================================
function context = addRegistryPackagePlan(context, packageInfo)
  validateRegistryPackageCompatibility(packageInfo);
  source = packageSource(packageInfo);
  checksumVerified = verifyRegistryPackageSource(packageInfo, source);
  item = packagePlanItem(packageInfo, source, checksumVerified);
  if nmm_is_installed(packageInfo.name, packageInfo.version)
    item.action = 'already-installed';
    context = appendPlan(context, item);
    return
  end
  context = appendPlan(context, item);
  dependencies = packageDependencies(packageInfo);
  validateRegistryDependencies(dependencies);
  for dependency = fieldnames(dependencies)'
    dependencyName = dependency{1};
    dependencySpec = dependencies.(dependencyName);
    context = addDependencyPlan(context, dependencyName, dependencySpec);
  end
end
%=============================================================================
function context = addDependencyPlan(context, dependencyName, dependencySpec)
  if dependencyIsInstalled(dependencyName, dependencySpec)
    context = appendPlan(context, installedPlanItem(dependencyName, dependencySpec));
    return
  end
  if isDependencySource(dependencySpec)
    context = appendPlan(context, sourceDependencyPlanItem(dependencyName, dependencySpec));
    return
  end
  packageInfo = nmm_registry('info', dependencyName, dependencySpec);
  if any(strcmp(context.stack, dependencyName))
    nmm_error('DependencyCycle', 'Dependency cycle detected: %s', dependencyName);
  end
  context.stack{end + 1} = dependencyName;
  context = addRegistryPackagePlan(context, packageInfo);
  context.stack(end) = [];
end
%=============================================================================
function context = appendPlan(context, item)
  for k = 1:length(context.plan)
    if strcmp(context.plan(k).package, item.package)
      if ~strcmp(context.plan(k).version, item.version)
        context.conflicts{end + 1} = sprintf('%s: %s vs %s', item.package, context.plan(k).version, item.version);
      end
      return
    end
  end
  if isempty(context.plan)
    context.plan = item;
  else
    context.plan(end + 1) = item;
  end
end
%=============================================================================
function item = packagePlanItem(packageInfo, source, checksumVerified)
  item = struct();
  item.package = packageInfo.name;
  item.version = packageInfo.version;
  item.action = 'install';
  item.source = source;
  item.source_available = sourceAvailable(source);
  item.checksum = packageChecksum(packageInfo);
  item.checksum_verified = checksumVerified;
  item.dependencies = packageDependencies(packageInfo);
  item.requested = '';
end
%=============================================================================
function item = installedPlanItem(dependencyName, dependencySpec)
  [~, moduleData] = nmm_find_installed_module(dependencyName);
  item = emptyPlanItem(dependencyName, moduleData.version);
  item.action = 'already-satisfied';
  item.source = '';
  item.source_available = true;
  item.dependencies = struct();
  item.requested = dependencySpec;
end
%=============================================================================
function item = sourceDependencyPlanItem(dependencyName, dependencySpec)
  item = emptyPlanItem(dependencyName, dependencySpec);
  item.action = 'install-source';
  item.source = dependencySpec;
  item.source_available = sourceAvailable(dependencySpec);
  item.dependencies = struct();
  item.requested = dependencySpec;
end
%=============================================================================
function item = emptyPlanItem(packageName, packageVersion)
  item = struct();
  item.package = packageName;
  item.version = packageVersion;
  item.action = '';
  item.source = '';
  item.source_available = false;
  item.checksum = '';
  item.checksum_verified = false;
  item.dependencies = struct();
  item.requested = '';
end
%=============================================================================
function dependencies = packageDependencies(packageInfo)
  dependencies = struct();
  if isfield(packageInfo, 'dependencies')
    dependencies = packageInfo.dependencies;
  end
end
%=============================================================================
function validateRegistryDependencies(dependencies)
  if ~isstruct(dependencies)
    nmm_error('RegistryDependenciesInvalid', 'Package registry dependencies must be a struct.');
  end
  for dependency = fieldnames(dependencies)'
    if ~ischar(dependencies.(dependency{1}))
      nmm_error('InvalidDependencyDeclaration', 'Invalid dependency declaration: %s', dependency{1});
    end
  end
end
%=============================================================================
function tf = dependencyIsInstalled(dependencyName, dependencySpec)
  tf = false;
  if ~nmm_is_installed(dependencyName)
    return
  end
  if isDependencySource(dependencySpec)
    tf = true;
    return
  end
  modules = nmm_list();
  dependencyData = getfield(modules, dependencyName);
  versions = installedVersions(dependencyData);
  for k = 1:length(versions)
    if versionSatisfies(versions(k).version, dependencySpec)
      tf = true;
      return
    end
  end
  installed = installedVersionsText(versions);
  nmm_error('DependencyConflictRequiresInstalledVersions', '%s requires %s, installed versions: %s', dependencyName, dependencySpec, installed);
end
%=============================================================================
function versions = installedVersions(moduleData)
  versions = struct([]);
  if isfield(moduleData, 'versions') && ~isempty(moduleData.versions)
    versions = moduleData.versions;
    return
  end
  if isfield(moduleData, 'path') && isfield(moduleData, 'version')
    versions = moduleData;
    if isfield(versions, 'versions')
      versions = rmfield(versions, 'versions');
    end
    if isfield(versions, 'pinned_version')
      versions = rmfield(versions, 'pinned_version');
    end
  end
end
%=============================================================================
function text = installedVersionsText(versions)
  values = {};
  for k = 1:length(versions)
    values{end + 1} = versions(k).version;
  end
  text = strjoin(values, ', ');
end
%=============================================================================
function validateRegistryPackageCompatibility(packageInfo)
  if isfield(packageInfo, 'platforms')
    [r, msg] = nmm_is_supported_platform(packageInfo.platforms);
    if ~r
      nmm_error('PlatformNotSupported', msg);
    end
  end
  verifyArtifactForArch(packageInfo);
  if isfield(packageInfo, 'nelson') && ~nelsonVersionSatisfies(packageInfo.nelson)
    nmm_error('NelsonVersionNotSupported', 'Nelson version not supported: %s', packageInfo.nelson);
  end
end
%=============================================================================
function verifyArtifactForArch(packageInfo)
  % A binary package ships one archive per architecture under "artifacts": when
  % the running architecture has no archive, fail with a clear message rather
  % than a later missing-source error.
  if ~isfield(packageInfo, 'artifacts') || ~isstruct(packageInfo.artifacts) ...
      || isempty(fieldnames(packageInfo.artifacts))
    return
  end
  arch = computer('arch');
  if ~isfield(packageInfo.artifacts, arch)
    nmm_error('ArchiveNotAvailable', 'No %s archive available for %s %s.', arch, packageInfo.name, packageInfo.version);
  end
end
%=============================================================================
function tf = nelsonVersionSatisfies(range)
  if ~ischar(range)
    tf = false;
    return
  end
  v = version('-number');
  current = sprintf('%d.%d.%d', v(1), v(2), v(3));
  if isVersionConstraint(range)
    tf = semverConstraintSatisfied(current, range);
  else
    tf = semver(current, range) == 0;
  end
end
%=============================================================================
function checksumVerified = verifyRegistryPackageSource(packageInfo, source)
  checksumVerified = false;
  if ~sourceAvailable(source)
    nmm_error('RegistryPackageSourceMissingPackageRegistryEntry', 'Package registry entry source does not exist.');
  end
  if ~isfile(source)
    return
  end
  checksum = packageChecksum(packageInfo);
  if isempty(checksum)
    return
  end
  if ~strcmpi(checksum, sha256(source, '-file'))
    nmm_error('RegistryPackageChecksumMismatch', 'Registry checksum does not match package source.');
  end
  checksumVerified = true;
end
%=============================================================================
function checksum = packageChecksum(packageInfo)
  checksum = '';
  if isfield(packageInfo, 'checksum') && ischar(packageInfo.checksum)
    checksum = packageInfo.checksum;
  end
end
%=============================================================================
function source = packageSource(packageInfo)
  source = '';
  if isfield(packageInfo, 'source')
    source = packageInfo.source;
  elseif isfield(packageInfo, 'url')
    source = packageInfo.url;
  elseif isfield(packageInfo, 'archive')
    source = packageInfo.archive;
  end
  if ~ischar(source) || isempty(source)
    nmm_error('RegistryPackageSourceMissing', 'Package registry entry has no install source.');
  end
end
%=============================================================================
function tf = sourceAvailable(source)
  tf = isfile(source) || isdir(source) || isHttpSource(source);
end
%=============================================================================
function tf = isHttpSource(source)
  tf = ischar(source) && (startsWith(source, 'http://') || startsWith(source, 'https://'));
end
%=============================================================================
function tf = isDependencySource(dependencySpec)
  [isRepository, url, tag_branch] = nmm_is_http_repository(dependencySpec);
  tf = isRepository || isdir(dependencySpec) || isfile(dependencySpec);
end
%=============================================================================
function tf = versionSatisfies(installedVersion, dependencySpec)
  if isVersionConstraint(dependencySpec)
    tf = semverConstraintSatisfied(installedVersion, dependencySpec);
  else
    tf = semver(installedVersion, dependencySpec) == 0;
  end
end
%=============================================================================
function tf = isVersionConstraint(value)
  tf = startsWith(value, '>') || startsWith(value, '<') ...
      || startsWith(value, '=') || startsWith(value, '^') ...
      || startsWith(value, '~') || contains(value, ' ');
end
%=============================================================================
function tf = semverConstraintSatisfied(version, constraint)
  tf = true;
  constraints = strsplit(strtrim(constraint), ' ');
  for k = 1:length(constraints)
    item = constraints{k};
    if isempty(item)
      continue
    end
    try
      if semver(version, item) ~= 1
        tf = false;
        return
      end
    catch
      tf = false;
      return
    end
  end
end
