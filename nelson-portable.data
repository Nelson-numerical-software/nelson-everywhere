addgateway(modulepath('signal_processing', 'builtin'), 'signal_processing');
addpath(modulepath('signal_processing', 'functions'), '-frozen');
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function p = bandpower(varargin)
  narginchk(1, 4);
  nargoutchk(0, 1);
  for k = 1:nargin
    if isinteger(varargin{k})
      % power is a double quantity: integer arithmetic would saturate
      varargin{k} = double(varargin{k});
    end
  end
  if isPsdInput(varargin)
    pxx = varargin{1};
    f = varargin{2};
    if nargin >= 4
      freqRange = varargin{3};
    else
      freqRange = [];
    end
    p = signalBandpowerFromPsd(pxx, f, freqRange);
    return;
  end
  x = varargin{1};
  if nargin == 1
    p = mean(abs(x(:)) .^ 2);
  elseif nargin == 3
    fs = varargin{2};
    freqRange = varargin{3};
    [pxx, f] = signalPeriodogramCore(x, hamming(length(x)), length(x), fs);
    p = signalBandpowerFromPsd(pxx, f, freqRange);
  else
    error('Nelson:signal:bandpower:missingSampleRate', 'Frequency range must be specified with sampling frequency.');
  end
end
%=============================================================================
function tf = isPsdInput(args)
  tf = numel(args) >= 3 && (ischar(args{end}) || isstring(args{end})) && strcmpi(char(args{end}), 'psd');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function c = bartlett(varargin)
  % Oppenheim, Alan V., Ronald W. Schafer, and John R. Buck. Discrete-Time Signal Processing. Upper Saddle River, NJ: Prentice Hall, 1999, pp.
  narginchk(1, 1);
  m = varargin{1};
  isPositiveIntegerOrEmpty = isempty(m) || (isscalar(m) && (m == fix(m)) && (m > 0));
  if ~isPositiveIntegerOrEmpty
    error('Nelson:validators:mustBePositiveInteger', '%s must be a positive integer.', 'M');
  end
  if isempty(m)
    c = zeros(0, 1);
  elseif (m ~= 1)
    m = m - 1;
    n = fix(m / 2);
    c = [2 * (0:n) / m, 2 - 2 * (n + 1:m) / m]';
  else
    c = 1;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function c = blackman(varargin)
  % https://www.sciencedirect.com/topics/engineering/blackman-window
  narginchk(1, 2);
  [m, N] = signalParseWindowLengthAndOption(varargin);

  if isempty(m)
    c = zeros(0, 1);
  elseif (m ~= 1)
    m = m - 1;
    k = (0:m)' / N;
    c = 0.42 - (0.5 * cos(2 * pi * k)) + (0.08 * cos(4 * pi * k));
  else
    c = 1;
  end
end
