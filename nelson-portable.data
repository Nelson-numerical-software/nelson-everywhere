% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--ENGLISH IMPOSED-->
%=============================================================================
msg = 'Dimension argument must be a positive integer scalar or vector of positive integers.';
asserts.checkerror('mean(ones(2, 2), [1 0])', msg, 'Nelson:statistics:invalidDimensionArg');
asserts.checkerror('var(ones(2, 2), 0, [1 0])', msg, 'Nelson:statistics:invalidDimensionArg');
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('median'), -4);
asserts.isequal(nargout('median'), 1);
%=============================================================================
asserts.isequal(median([3 1 2]), 2);
asserts.isequal(median([4 1 2 3]), 2.5);
%=============================================================================
M = [1 4 7; 2 5 8; 3 6 9];
asserts.isequal(median(M), [2 5 8]);
asserts.isequal(median(M, 2), [4; 5; 6]);
asserts.isequal(median(M, 'all'), 5);
%=============================================================================
asserts.isequal(median([1 NaN 3], 'omitnan'), 2);
asserts.istrue(isnan(median([1 NaN 3], 'includenan')));
%=============================================================================
asserts.isequal(median(uint8([1 5 9])), uint8(5));
asserts.isequal(median(uint8([1 5])), uint8(3));
%=============================================================================
asserts.isequal(median([1 NaN 3], 'omitnan'), 2);
%=============================================================================
% vector of dimensions (vecdim)
A = reshape(1:24, [2 3 4]);
assert_isequal(size(median(A, [1 2])), [1 1 4]);
assert_isequal(median(A, [1 2]), reshape([3.5 9.5 15.5 21.5], [1 1 4]));
assert_isequal(size(median(A, [1 3])), [1 3]);
assert_isequal(median(A, [1 3]), [10.5 12.5 14.5]);
assert_isequal(median(A, [2 3]), [12; 13]);
assert_isequal(median(A, [1 2 3]), 12.5);
assert_isequal(median(A, [1 2 3]), median(A, 'all'));
% a vector that lists a single effective dimension behaves like a scalar dim
assert_isequal(median(A, [2]), median(A, 2));
% omitnan combined with a vector of dimensions
C = cat(3, [1 NaN; 3 4], [5 6; NaN 8]);
assert_isequal(median(C, [1 2], 'omitnan'), reshape([3 6], [1 1 2]));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% integer classes are preserved, rounding half away from zero
asserts.isequal(median(int8([1 2])), int8(2));
asserts.isequal(class(median(int8([1 2]))), 'int8');
asserts.isequal(median(int8([-1 -2])), int8(-2));
asserts.isequal(median(int8([1 2 3])), int8(2));
asserts.isequal(median(uint8([250 251])), uint8(251));
asserts.isequal(median(int16([1 2; 3 4; 5 6])), int16([3 4]));
%=============================================================================
% single stays single
asserts.isequal(class(median(single([1 2 3]))), 'single');
asserts.isequal(median(single([1 2 3 4])), single(2.5));
%=============================================================================
% empty inputs
asserts.isequal(median([]), NaN);
asserts.isequal(median(int8([])), int8(0));
asserts.isequal(class(median(single([]))), 'single');
asserts.isequal(median(zeros(0, 3)), [NaN NaN NaN]);
%=============================================================================
% nanflag still works
asserts.isequal(median([1 NaN 3], 'omitnan'), 2);
asserts.isequal(median([1 NaN 3]), NaN);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
% median, var and std of an empty array reduce the working dimension to 1:
% the result keeps the other dimensions and is NaN where it is not empty.
% [] (0x0) without dimension gives NaN, with a dimension it follows the rule.
%=============================================================================
asserts.isequal(median(zeros(0, 3)), NaN(1, 3));
asserts.isequal(median(zeros(0, 3), 2), zeros(0, 1));
asserts.isequal(median(zeros(3, 0)), zeros(1, 0));
asserts.isequal(median(zeros(3, 0), 2), NaN(3, 1));
asserts.isequal(median(zeros(1, 0)), NaN);
asserts.isequal(median(zeros(0, 3, 2)), NaN(1, 3, 2));
asserts.isequal(median(zeros(0, 3), 'omitnan'), NaN(1, 3));
asserts.isequal(median(zeros(0, 3), 'all'), NaN);
asserts.isequal(median([]), NaN);
asserts.isequal(median([], 'omitnan'), NaN);
asserts.isequal(median([], 1), zeros(1, 0));
asserts.isequal(median([], 2), zeros(0, 1));
asserts.isequal(median([], [1 2]), NaN);
asserts.isequal(median(single(zeros(0, 3))), single(NaN(1, 3)));
asserts.isequal(median(int8(zeros(0, 3))), int8([0 0 0]));
asserts.isequal(median(int8([])), int8(0));
asserts.isequal(median(int8([]), 1), int8(zeros(1, 0)));
%=============================================================================
for f = {@var, @std}
  fn = f{1};
  asserts.isequal(fn(zeros(0, 3)), NaN(1, 3));
  asserts.isequal(fn(zeros(0, 3), 0, 2), zeros(0, 1));
  asserts.isequal(fn(zeros(3, 0)), zeros(1, 0));
  asserts.isequal(fn(zeros(3, 0), 0, 2), NaN(3, 1));
  asserts.isequal(fn(zeros(1, 0)), NaN);
  asserts.isequal(fn(zeros(0, 3, 2)), NaN(1, 3, 2));
  asserts.isequal(fn(zeros(0, 3), 1), NaN(1, 3));
  asserts.isequal(fn(zeros(0, 3), 'omitnan'), NaN(1, 3));
  asserts.isequal(fn(zeros(0, 3), 0, 'all'), NaN);
  asserts.isequal(fn(zeros(0, 3), 0, [1 2]), NaN);
  asserts.isequal(fn([]), NaN);
  asserts.isequal(fn([], 0, 'all'), NaN);
  asserts.isequal(fn([], 0, 1), zeros(1, 0));
  asserts.isequal(fn([], 0, 2), zeros(0, 1));
  asserts.isequal(fn([], 0, [1 2]), NaN);
  asserts.isequal(fn(single(zeros(0, 3))), single(NaN(1, 3)));
  asserts.isequal(fn(single([]), 0, 1), single(zeros(1, 0)));
  asserts.isequal(fn(zeros(0, 3), ones(0, 1)), NaN(1, 3));
end
%=============================================================================
% second output (mean) follows the same shapes
[v, m] = var(zeros(0, 3));
asserts.isequal(v, NaN(1, 3));
asserts.isequal(m, NaN(1, 3));
[v, m] = var([], 0, 1);
asserts.isequal(v, zeros(1, 0));
asserts.isequal(m, zeros(1, 0));
[s, m] = std(zeros(0, 3), 0, 'all');
asserts.isequal(s, NaN);
asserts.isequal(m, NaN);
[s, m] = std(zeros(3, 0), 0, 2);
asserts.isequal(s, NaN(3, 1));
asserts.isequal(m, NaN(3, 1));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
[m, f, c] = mode([1 2 2 3]);
asserts.isequal(m, 2);
asserts.isequal(f, 2);
asserts.isequal(c, {2});
%=============================================================================
A = [1 2 2; 3 3 4];
m = mode(A, 2);
asserts.isequal(m, [2; 3]);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
% mode of an empty array reduces the working dimension to 1: M is NaN, F is 0
% and C holds 0x1 empty arrays. [] (0x0) without dimension gives NaN, with a
% dimension it follows the rule.
%=============================================================================
asserts.isequal(mode(zeros(0, 3)), NaN(1, 3));
asserts.isequal(mode(zeros(0, 3), 2), zeros(0, 1));
asserts.isequal(mode(zeros(3, 0)), zeros(1, 0));
asserts.isequal(mode(zeros(3, 0), 2), NaN(3, 1));
asserts.isequal(mode(zeros(1, 0)), NaN);
asserts.isequal(mode(zeros(0, 3, 2)), NaN(1, 3, 2));
asserts.isequal(mode([]), NaN);
asserts.isequal(mode([], 1), zeros(1, 0));
asserts.isequal(mode([], 2), zeros(0, 1));
%=============================================================================
[M, F, C] = mode(zeros(0, 3));
asserts.isequal(M, NaN(1, 3));
asserts.isequal(F, zeros(1, 3));
asserts.isequal(C, {zeros(0, 1), zeros(0, 1), zeros(0, 1)});
[M, F, C] = mode(zeros(3, 0), 2);
asserts.isequal(F, zeros(3, 1));
asserts.isequal(C, {zeros(0, 1); zeros(0, 1); zeros(0, 1)});
[M, F, C] = mode([], 1);
asserts.isequal(M, zeros(1, 0));
asserts.isequal(F, zeros(1, 0));
asserts.isequal(C, cell(1, 0));
[M, F, C] = mode([]);
asserts.isequal(M, NaN);
asserts.isequal(F, 0);
asserts.isequal(C, {zeros(0, 1)});
%=============================================================================
% single and integer classes are kept (NaN becomes 0 for integers)
asserts.isequal(mode(single(zeros(0, 3))), single(NaN(1, 3)));
asserts.isequal(mode(int8(zeros(0, 3))), int8([0 0 0]));
asserts.isequal(mode(int8([])), int8(0));
asserts.isequal(mode(uint16(zeros(3, 0)), 2), uint16([0; 0; 0]));
[M, F, C] = mode(int8([]));
asserts.isequal(C, {int8(zeros(0, 1))});
[M, F, C] = mode(single(zeros(0, 2)));
asserts.isequal(C, {single(zeros(0, 1)), single(zeros(0, 1))});
asserts.isequal(mode(single([1 1 2])), single(1));
asserts.isequal(mode(int16([4 4 2; 4 1 2]), 2), int16([4; 1]));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('moment'), -3);
asserts.isequal(nargout('moment'), 1);
%=============================================================================
X = [0.5377 -0.4336 0.7254 1.4090 0.4889; ...
     1.8339 0.3426 -0.0631 1.4172 1.0347; ...
    -2.2588 3.5784 0.7147 0.6715 0.7269; ...
     0.8622 2.7694 -0.2050 -1.2075 -0.3034; ...
     0.3188 -1.3499 -0.1241 0.7172 0.2939; ...
    -1.3077 3.0349 1.4897 1.6302 -0.7873];
m = moment(X, 3);
asserts.isapprox(m, [-1.114317297123259 -0.997267318261260 0.123395588389407 ...
                    -1.102322260825926 -0.104560266348759], 1e-12);
%=============================================================================
A = zeros(4, 3, 2);
A(:, :, 1) = [0.5377 0.3188 3.5784; ...
              1.8339 -1.3077 2.7694; ...
             -2.2588 -0.4336 -1.3499; ...
              0.8622 0.3426 3.0349];
A(:, :, 2) = [0.7254 -0.1241 0.6715; ...
             -0.0631 1.4897 -1.2075; ...
              0.7147 1.4090 0.7172; ...
             -0.2050 1.4172 1.6302];
M1 = moment(A, 4);
asserts.isapprox(M1(:, :, 1), [11.442394531893287 0.355338544936619 33.673184429093418], 1e-12);
asserts.isapprox(M1(:, :, 2), [0.036041892279158 0.490179723794366 2.382081633264558], 1e-12);
M2 = moment(A, 4, 2);
asserts.isapprox(M2(:, :, 1), [7.347356173805583; 13.870057013328696; ...
                              0.462418667468267; 2.773986910844348], 1e-12);
asserts.isapprox(M2(:, :, 2), [0.034127792361341; 2.239000243299763; ...
                              0.017089642572040; 0.676673019602859], 1e-12);
M3 = moment(A, 4, 3);
expectedM3 = [0.000077577737192 0.002404931653211 4.462727663348193; ...
              0.809374170930063 3.827351062099657 15.633589351405227; ...
              4.885981167353441 0.720450728183816 1.141105937836488; ...
              0.081070580662682 0.083342660921864 0.243340472518548];
asserts.isapprox(M3(:), expectedM3(:), 1e-12);
asserts.isapprox(moment(A, 3, 'all'), 0.243116207471213, 1e-12);
M4 = moment(A, 3, [1 2]);
asserts.isequal(size(M4), [1 1 2]);
asserts.isapprox(M4(:), [0.600181036053087; -0.347464028593259], 1e-12);
M5 = moment(A, 3, [2 3]);
asserts.isapprox(M5(:), [2.755144864879407; 0.044319105006906; ...
                        -0.758406484945074; 0.533977440121500], 1e-12);
%=============================================================================
asserts.istrue(all(abs(moment([1 2 3], 1)) < 1e-12));
asserts.isapprox(moment([1 2 3], 2), 2 / 3, 1e-12);
M6 = moment([1 2 3], 3, 3);
asserts.isequal(size(M6), [1 3]);
asserts.isequal(M6, [0 0 0]);
asserts.istrue(isnan(moment([1 NaN 3], 2)));
S = moment(single([1 2 4 8]), 2);
asserts.isequal(class(S), 'single');
asserts.isapprox(double(S), 7.1875, 1e-6);
%=============================================================================
asserts.checkerror('moment()', _('Not enough input arguments.'));
asserts.checkerror('moment([1 2])', _('Not enough input arguments.'));
asserts.checkerror('moment({1}, 2)', sprintf(_('%s must be a real numeric array.'), 'X'));
asserts.checkerror('moment([1 2], 0)', sprintf(_('%s must be a positive integer scalar.'), 'ORDER'));
asserts.checkerror('moment([1 2], 1.5)', sprintf(_('%s must be a positive integer scalar.'), 'ORDER'));
asserts.checkerror('moment([1 2], 2, 0)', _('Dimension must be a positive integer scalar, vector, or ''all''.'));
asserts.checkerror('moment([1 2], 2, ''bad'')', _('Dimension must be a positive integer scalar, vector, or ''all''.'));
