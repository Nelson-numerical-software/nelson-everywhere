%=============================================================================
x = [-2, -1, 0, 1, 2];
R = normpdf(x);
REF = [0.0540 0.2420 0.3989 0.2420 0.0540];
asserts.isapprox(R, REF, 1e-3);
%=============================================================================
x = [-2, -1, 0, 1, 2];
R = normpdf(x, 2, 1);
REF = [0.0001 0.0044 0.0540 0.2420 0.3989];
asserts.isapprox(R, REF, 1e-3);
%=============================================================================
R = normpdf(0, [-2, -1, 0, 1, 2], 1);
REF = [0.0540 0.2420 0.3989 0.2420 0.0540];
asserts.isapprox(R, REF, 1e-3);
%=============================================================================
asserts.isapprox(normpdf(0), 1 / sqrt(2 * pi), 1e-12);
