function bw = imextendedmax(varargin)
  narginchk(2, 3);
  nargoutchk(0, 1);
  if nargin == 2
    filtered = imhmax(varargin{1}, varargin{2});
    bw = imregionalmax(filtered);
  else
    filtered = imhmax(varargin{1}, varargin{2}, varargin{3});
    bw = imregionalmax(filtered, varargin{3});
  end
end
