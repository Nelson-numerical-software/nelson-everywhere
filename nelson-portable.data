%=============================================================================
function V = validateIsosurfaceVolume(V)
  if ~isnumeric(V) || ~isreal(V) || ndims(V) ~= 3
    error('Nelson:isosurface:invalidVolumeType', 'Volume data must be a real numeric 3-D array.');
  end
  V = double(V);
end
