%=============================================================================
function varargout = dlyap(varargin)
  % Compute solution X of the Lyapunov equation
  narginchk(2, 2);
  nargoutchk(0, 1);

  A = varargin{1};
  Q = varargin{2};

  mustBeNumeric(A, 1);
  mustBeNumeric(Q, 2);
  mustBeReal(A, 1);
  mustBeReal(Q, 2);

  szA = size(A);
  szQ = size(Q);
  if ~isequal(szA(1), szA(2)) || ~isequal(szQ(1), szQ(2))
    error('Nelson:expectedSquare', '%s must be square.', 'Input');
  end

  p = kron(conj(A), A);
  K = eye(size(p)) - p;
  X = K \ Q(:);
  varargout{1} = reshape(X, size(A));
end
