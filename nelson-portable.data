function B = reshape(A, varargin)
  B = categorical.fromCodes(reshape(A.codes, varargin{:}), A.categoryNames, A.isOrdinal, A.isProtected);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function A = setcats(A, newCategories)
  narginchk(2, 2);
  desired = categorical.checkCategoryNames(newCategories, false);
  [tf, map] = categorical.namesMember(A.categoryNames, desired);
  for k = 1:numel(A.codes)
    code = A.codes(k);
    if code > 0
      if tf(code)
        A.codes(k) = map(code);
      else
        A.codes(k) = 0;
      end
    end
  end
  A.categoryNames = desired(:);
end
