function m = x2mdate(x, outputType)
  narginchk(1, 2);
  serial = double(x) + datenum(1899, 12, 31);
  if nargin == 2 && strcmpi(char(outputType), 'datetime')
    m = datetime(serial, 'ConvertFrom', 'datenum');
  else
    m = serial;
  end
end
