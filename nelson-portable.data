function content = worker_pool_script_header(privateDir)
  content = {
    'setenv(''NELSON_UNITTEST_RUNFILE_WORKER'', ''TRUE'');'
    ['addpath(', nelsonStringLiteral(privateDir), ');']
    'worker_files = {};'
  };
end
