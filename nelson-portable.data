function y = rectpuls(varargin)
  narginchk(1, 2);
  nargoutchk(0, 1);
  t = varargin{1};
  width = 1;
  if nargin == 2
    width = varargin{2};
  end
  y = double(t >= -width / 2 & t < width / 2);
end
