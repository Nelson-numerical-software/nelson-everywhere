%=============================================================================
function y = yyyymmdd(t)
  narginchk(1, 1);
  v = datevec(datenum(t));
  y = v(:, 1) .* 10000 + v(:, 2) .* 100 + v(:, 3);
  y = reshape(y, size(datenum(t)));
end
