%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
f = @(t, y) 1;
ev = @odeTestEventHalf;
options = odeset('Events', ev, 'InitialStep', 0.05, 'MaxStep', 0.05);
[t, y, te, ye, ie] = ode23(f, [0 1], 0, options);
asserts.istrue(abs(t(length(t)) - 0.5) < 1e-10);
asserts.istrue(abs(y(length(y)) - 0.5) < 1e-10);
asserts.istrue(abs(te(1) - 0.5) < 0.06);
asserts.istrue(abs(ye(1) - 0.5) < 0.06);
asserts.isequal(ie(1), 1);
%=============================================================================
options = odeset('Events', @odeTestQuadraticEvent, 'InitialStep', 0.2, 'MaxStep', 0.2, 'Refine', 1);
[t, y, te, ye, ie] = ode23(f, [0 1], 0, options);
asserts.istrue(abs(te(1) - 0.5) < 1e-6);
asserts.istrue(abs(ye(1) - 0.5) < 1e-6);
asserts.isequal(ie(1), 1);
%=============================================================================
% Event localization must follow the solution curve (Hermite), not the step
% chord: a falling ball hits the ground at exactly sqrt(2/g).
ballOptions = odeset('Events', @odeTestFallingBallEvent, 'RelTol', 1e-8, 'AbsTol', 1e-10);
ballSol = ode45(@(t, y)[y(2); -9.8], [0 3], [1; 0], ballOptions);
asserts.istrue(abs(ballSol.xe(1) - sqrt(2 / 9.8)) < 1e-9);
asserts.istrue(abs(ballSol.ye(1, 1)) < 1e-9);
%=============================================================================
badLengthOptions = odeset('Events', @odeTestBadEventLength);
asserts.checkerror('ode45(@(t, y) 1, [0 1], 0, badLengthOptions)', ...
  _('Event outputs must have the same number of elements.'));

badValueOptions = odeset('Events', @odeTestBadEventValue);
asserts.checkerror('ode45(@(t, y) 1, [0 1], 0, badValueOptions)', ...
  _('Event values must be finite numeric values.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
for direction = [-1 0 1]
  options = odeset('Events', @(t, y) odeTestInitialEvent(t, y, direction), ...
    'InitialStep', 0.1, 'MaxStep', 0.1);
  [t, y, te, ye, ie] = ode45(@(t, y) 1, [0 1], 0, options);
  asserts.istrue(abs(t(length(t)) - 1) < 1e-12);
  asserts.istrue(abs(y(length(y)) - 1) < 1e-10);
  if direction < 0
    asserts.istrue(isempty(te));
    asserts.istrue(isempty(ye));
    asserts.istrue(isempty(ie));
  else
    asserts.isequal(length(te), 1);
    asserts.istrue(abs(te(1)) < 1e-12);
    asserts.istrue(abs(ye(1)) < 1e-12);
    asserts.isequal(ie(1), 1);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
options = odeset('Events', @odeTestTwoEvents, 'MaxStep', 0.05);
[t, y, te, ye, ie] = ode45(@(t, y) 1, [0 1], 0, options);
asserts.isequal(length(te), 2);
asserts.istrue(abs(te(1) - 0.25) < 1e-10);
asserts.istrue(abs(te(2) - 0.5) < 1e-10);
asserts.istrue(abs(ye(1) - 0.25) < 1e-10);
asserts.istrue(abs(ye(2) - 0.5) < 1e-10);
asserts.isequal(ie(:), [1; 2]);
asserts.istrue(abs(t(length(t)) - 0.5) < 1e-10);

options = odeset('Events', @odeTestDirectionEvents, 'MaxStep', 0.05);
[td, yd, ted, yed, ied] = ode45(@(t, y) 1, [0 1], 0, options);
asserts.isequal(length(ted), 1);
asserts.isequal(ied(1), 2);
asserts.istrue(abs(ted(1) - 0.5) < 1e-10);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
options = odeset('RelTol', 1e-6, 'AbsTol', 1e-9, 'MaxStep', 0.1);
sol23 = ode23(@(t, y) y, [0 1], 1, options);
sol45 = ode45(@(t, y) y, [0 1], 1, options);
asserts.isequal(sol23.solver, 'ode23');
asserts.isequal(sol45.solver, 'ode45');
asserts.istrue(abs(sol23.y(length(sol23.y)) - exp(1)) < 2e-4);
asserts.istrue(abs(sol45.y(length(sol45.y)) - exp(1)) < 2e-6);
asserts.istrue(sol23.stats.nfevals >= 4 * sol23.stats.nsteps);
asserts.istrue(sol45.stats.nfevals >= 7 * sol45.stats.nsteps);
sol78 = ode78(@(t, y) y, [0 1], 1, options);
sol89 = ode89(@(t, y) y, [0 1], 1, options);
sol113 = ode113(@(t, y) y, [0 1], 1, options);
asserts.isequal(sol78.solver, 'ode78');
asserts.isequal(sol89.solver, 'ode89');
asserts.isequal(sol113.solver, 'ode113');
asserts.istrue(abs(sol78.y(length(sol78.y)) - exp(1)) < 2e-7);
asserts.istrue(abs(sol89.y(length(sol89.y)) - exp(1)) < 2e-7);
asserts.istrue(abs(sol113.y(length(sol113.y)) - exp(1)) < 2e-6);
% Verner pairs: ten stages for the 7(6) formula, thirteen for the 8(7).
asserts.istrue(sol78.stats.nfevals >= 10 * sol78.stats.nsteps);
asserts.istrue(sol89.stats.nfevals >= 13 * sol89.stats.nsteps);
asserts.istrue(sol89.stats.nfevals > sol78.stats.nfevals);
asserts.istrue(sol113.stats.nfevals >= sol113.stats.nsteps);
asserts.istrue(sol113.stats.nfevals < sol78.stats.nfevals);

[t23, y23] = ode23(@(t, y)[y(2); -y(1)], [0 pi / 4 pi / 2], [0; 1], options);
[t45, y45] = ode45(@(t, y)[y(2); -y(1)], [0 pi / 4 pi / 2], [0; 1], options);
asserts.istrue(max(abs(y23(:, 1) - sin(t23))) < 2e-4);
asserts.istrue(max(abs(y45(:, 1) - sin(t45))) < 2e-6);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
[t, y] = ode45(@(t, y)[y(2); -y(1)], [0 0.5], [1 0]);
asserts.isequal(size(t, 2), 1);
asserts.isequal(size(y, 2), 2);
asserts.isequal(y(1, :), [1 0]);

[tc, yc] = ode45(@(t, y)[y(2); -y(1)], [0 0.5], [1; 0]);
asserts.isequal(size(tc, 2), 1);
asserts.isequal(size(yc, 2), 2);
asserts.isequal(yc(1, :), [1 0]);
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% A solution that blows up must return the partial solution with a warning,
% not raise an error.
lastwarn('');
sol = ode45(@(t, y) y ^ 2, [0 2], 1);
[msg, ~] = lastwarn();
asserts.istrue(isstruct(sol) || isobject(sol));
asserts.istrue(sol.x(end) < 2);
asserts.istrue(~isempty(msg));
asserts.istrue(all(isfinite(sol.y(:, end))));
%=============================================================================
% A well-posed problem must integrate to the end without any warning.
lastwarn('');
good = ode45(@(t, y) - y, [0 1], 1);
[msg2, ~] = lastwarn();
asserts.istrue(abs(good.x(end) - 1) < 1e-9);
asserts.istrue(isempty(msg2));
asserts.istrue(abs(good.y(end) - exp(-1)) < 1e-3);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
options = odeset('Mass', 2, 'MaxStep', 0.05);
[t, y] = ode45(@(tt, yy) - yy, [0 1], 2, options);
asserts.istrue(abs(y(size(y, 1), 1) - 2 * exp(-0.5)) < 1e-3);
%=============================================================================
options = odeset('NonNegative', 1, 'MaxStep', 0.05);
[t, y] = ode45(@(tt, yy) - 10, [0 1], 1, options);
asserts.istrue(all(y(:) >= 0));
%=============================================================================
sol = ode45(@(tt, yy) - yy, [0 0.5], 1);
sol = odextend(sol, [], 1);
asserts.istrue(abs(sol.x(length(sol.x)) - 1) < 1e-12);
asserts.istrue(abs(sol.y(1, size(sol.y, 2)) - exp(-1)) < 5e-3);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
options = odeset('NormControl', 'on', 'RelTol', 1e-5, 'AbsTol', 1e-8);
[t, y] = ode45(@(t, y)[y(1); -2 * y(2)], [0 1], [1; 1], options);
asserts.istrue(abs(y(size(y, 1), 1) - exp(1)) < 1e-4);
asserts.istrue(abs(y(size(y, 1), 2) - exp(-2)) < 1e-4);
%=============================================================================
clear global ODE_VECTORIZED_STIFF_COLUMNS;
global ODE_VECTORIZED_STIFF_COLUMNS;
ODE_VECTORIZED_STIFF_COLUMNS = [];
options = odeset('Vectorized', 'on', 'MaxStep', 0.05, 'RelTol', 1e-4, 'AbsTol', 1e-7);
sol = ode15s(@odeVectorizedStiffRhs, [0 0.03], [1; 2], options);
asserts.istrue(abs(sol.y(1, length(sol.x)) - exp(-3)) < 5e-3);
asserts.istrue(abs(sol.y(2, length(sol.x)) - 2 * exp(-3)) < 1e-2);
asserts.istrue(any(ODE_VECTORIZED_STIFF_COLUMNS > 1));
%=============================================================================
clear global ODE_VECTORIZED_PATTERN_COLUMNS;
global ODE_VECTORIZED_PATTERN_COLUMNS;
ODE_VECTORIZED_PATTERN_COLUMNS = [];
pattern = [1 0 0; 0 1 0; 0 0 0];
options = odeset('Vectorized', 'on', 'JPattern', pattern, 'MaxStep', 0.05, 'RelTol', 1e-4, 'AbsTol', 1e-7);
sol = ode15s(@odeVectorizedPatternRhs, [0 0.03], [1; 2; 3], options);
asserts.istrue(abs(sol.y(1, length(sol.x)) - exp(-3)) < 5e-3);
asserts.istrue(abs(sol.y(2, length(sol.x)) - 2 * exp(-3)) < 1e-2);
asserts.istrue(abs(sol.y(3, length(sol.x)) - 3) < 1e-12);
asserts.istrue(any(ODE_VECTORIZED_PATTERN_COLUMNS == 2));
asserts.isfalse(any(ODE_VECTORIZED_PATTERN_COLUMNS == 3));
