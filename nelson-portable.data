function test_cases_updated = process_test_cases_pooled_raw(test_cases, nbWorkers, runtimeOptions)
  chunks = worker_pool_chunks(test_cases, nbWorkers);
  workers = worker_pool_create_workers(chunks, runtimeOptions);
  %#ok<NLS0004>
  cleanupWorkers = onCleanup(@() worker_pool_remove_workers(workers));
  nativeResults = run_worker_pool_processes(workers, nbWorkers);
  test_cases_updated = worker_pool_collect_results(chunks, workers, nativeResults);
  test_cases_updated = worker_pool_mark_worker_usage(...
    test_cases_updated, workers, nbWorkers);
  test_cases_updated = worker_pool_retry_missing(test_cases_updated, nbWorkers);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function testCasesUpdated = process_test_cases_progressive(...
    testCases, nbWorkers, initialIndex, nbTotalTests, stoponfail)
  phaseBegin = time();
  testCases = sort_test_cases_by_order(testCases);
  state = progressive_initial_state(testCases);
  fmtStart = test_start_format(nbTotalTests);
  allIndices = 1:length(testCases);
  [jobs, state.cases, worker] = progressive_test_jobs(...
    state.cases, allIndices, 1, _('Scheduling jobs'));
  tests_manager_trace('run', ['job preparation cases=', int2str(length(testCases)), ...
    ' elapsed=', sprintf('%.3fs', time() - phaseBegin)]);
  tests_manager_trace('progressive', ['start cases=', int2str(length(testCases)), ...
    ' jobs=', int2str(length(jobs.index)), ' workers=', int2str(nbWorkers)]);
  if isempty(jobs.index)
    state = progressive_flush_ready(state, initialIndex, nbTotalTests, fmtStart, stoponfail);
    testCasesUpdated = progressive_completed_cases(state);
    testCasesUpdated = progressive_mark_metrics(testCasesUpdated, state, nbWorkers);
    testCasesUpdated = remove_test_case_runtime_fields(testCasesUpdated);
    return
  end
  previousOmpThreads = configure_child_thread_environment(nbWorkers);
  try
    [state, stopped] = progressive_run_jobs(state, jobs, nbWorkers, true, ...
      initialIndex, nbTotalTests, fmtStart, stoponfail);
    run_removeFile(worker.command_filename);
    if ~stopped
      fallback = find(state.fallback & ~state.completed);
      if ~isempty(fallback)
        [fallbackJobs, state.cases, fallbackWorker] = ...
          progressive_test_jobs(state.cases, fallback, 2); %#ok<ASGLU>
        state.fallback_attempt(fallback) = true;
        [state, stopped] = progressive_run_jobs(state, fallbackJobs, ...
          min(nbWorkers, length(fallback)), false, initialIndex, ...
          nbTotalTests, fmtStart, stoponfail);
      end
    end
    if ~stopped
      state = progressive_complete_missing(state);
      [state, stopped] = progressive_flush_ready(state, initialIndex, ...
        nbTotalTests, fmtStart, stoponfail); %#ok<ASGLU>
    end
  catch ex
    restore_child_thread_environment(previousOmpThreads);
    progressive_cleanup_scripts(state.cases, worker);
    rethrow(ex);
  end
  restore_child_thread_environment(previousOmpThreads);
  progressive_cleanup_scripts(state.cases, worker);
  phaseBegin = time();
  testCasesUpdated = progressive_completed_cases(state);
  testCasesUpdated = progressive_mark_metrics(testCasesUpdated, state, nbWorkers);
  testCasesUpdated = remove_test_case_runtime_fields(testCasesUpdated);
  tests_manager_trace('run', ['result finalization cases=', ...
    int2str(length(testCasesUpdated)), ' elapsed=', ...
    sprintf('%.3fs', time() - phaseBegin)]);
end
%=============================================================================
% Child test processes inherit this environment: cap their computational
% thread pool so that nbWorkers concurrent children do not oversubscribe
% the machine (nbWorkers x physical cores threads otherwise).
function previousOmpThreads = configure_child_thread_environment(nbWorkers)
  previousOmpThreads = getenv('OMP_NUM_THREADS');
  childThreads = max(1, floor(maxNumCompThreads() / max(1, nbWorkers)));
  setenv('OMP_NUM_THREADS', int2str(childThreads));
end
%=============================================================================
function restore_child_thread_environment(previousOmpThreads)
  if isempty(previousOmpThreads)
    unsetenv('OMP_NUM_THREADS');
  else
    setenv('OMP_NUM_THREADS', previousOmpThreads);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function tf = progress_indicator_enabled(count)
  if nargin < 1
    count = 0;
  end
  if count < 50
    tf = false;
    return
  end
  if strcmp(getenv('NELSON_UNITTEST_PROGRESS_ANIMATION'), '1')
    tf = true;
    return
  end
  mode = getnelsonmode();
  tf = strcmp(mode, 'GUI') || strcmp(mode, 'WEB_GUI');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function progress_indicator_finish(progress, current)
  if ~progress.enabled
    return
  end
  if nargin < 2
    current = progress.total;
  end
  if isfield(progress, 'transient') && progress.transient
    % Erase the whole indicator line so it does not stay between test
    % results; the scheduling phase is transient progress, not a result.
    visibleLength = 2 + length(progress.label) + 2 + length(progress.previous);
    if visibleLength > 0
      eraser = repmat(sprintf('\b'), 1, visibleLength);
      blanks = repmat(' ', 1, visibleLength);
      fprintf(stdout, '%s%s%s', eraser, blanks, eraser);
    end
    return
  end
  progress_indicator_update(progress, current);
  fprintf(stdout, newline);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function progress = progress_indicator_start(label, total, transient)
  if nargin < 3
    transient = false;
  end
  progress = struct('enabled', false, 'label', label, ...
    'total', max(1, double(total)), 'last_percent', -1, 'previous', '', ...
    'transient', logical(transient));
  if isempty(label) || ~progress_indicator_enabled(total)
    return
  end
  progress.enabled = true;
  progress = progress_indicator_update(progress, 0);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function progress = progress_indicator_update(progress, current)
  if ~progress.enabled
    return
  end
  percent = round(100 * double(current) / progress.total);
  percent = min(100, max(0, percent));
  if percent == progress.last_percent
    return
  end
  text = sprintf('%d %%', percent);
  if isempty(progress.previous)
    fprintf(stdout, ['  ', '%s: %s'], progress.label, text);
  else
    backspace = repmat(sprintf('\b'), 1, length(progress.previous));
    fprintf(stdout, '%s%s', backspace, text);
  end
  progress.previous = text;
  progress.last_percent = percent;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function jobs = progressive_append_job(jobs, testCase, index, attempt, ...
    executable, processArguments, payload, kind, launcher, reusable)
  jobs.executables = [jobs.executables, cellstr(executable)];
  jobs.process_arguments = [jobs.process_arguments, cellstr(processArguments)];
  jobs.timeouts = [jobs.timeouts, testCase.launcher_timeout];
  jobs.kind = [jobs.kind, cellstr(kind)];
  jobs.index = [jobs.index, index];
  jobs.metadata = [jobs.metadata, cellstr(testCase.filename)];
  jobId = [kind, '_', int2str(index), '_attempt_', int2str(attempt)];
  jobs.job_id = [jobs.job_id, cellstr(jobId)];
  jobs.schedule_order = [jobs.schedule_order, index];
  jobs.weight = [jobs.weight, test_case_weight(testCase)];
  jobs.reusable = [jobs.reusable, double(reusable)];
  jobs.payload = [jobs.payload, cellstr(payload)];
  jobs.launcher = [jobs.launcher, cellstr(launcher)];
  jobs.result_file = [jobs.result_file, cellstr(testCase.outputfile)];
  jobs.attempt = [jobs.attempt, attempt];
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function updatedState = progressive_apply_payload(currentState, caseIndex, event)
  updatedState = currentState;
  payload = decode_runfile_payload(event.payload);
  testCase = worker_pool_apply_payload(...
    updatedState.cases(caseIndex), payload, event);
  if event.reusable || updatedState.fallback_attempt(caseIndex)
    testCase.worker_pool_used = true;
  end
  if updatedState.fallback_attempt(caseIndex)
    testCase.worker_pool_fallback = true;
    testCase.worker_pool_failure = updatedState.failures{caseIndex};
  end
  updatedState.results{caseIndex} = testCase;
  updatedState.completed(caseIndex) = true;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function updatedState = progressive_apply_process(...
    currentState, caseIndex, event, allowFallback)
  updatedState = currentState;
  reusableFailure = allowFallback && event.reusable ...
    && ~event.timed_out && ~strcmp(event.reason, 'interrupted');
  if reusableFailure
    updatedState.fallback(caseIndex) = true;
    updatedState.failures{caseIndex} = worker_pool_failure_from_native(event);
    return
  end
  nativeResult = run_processes_progressive_event_to_native(event);
  testCase = run_progressive_direct_case(updatedState.cases(caseIndex), ...
    nativeResult, launcher_aborted_code());
  if testCase.time <= 0 && nativeResult.duration > 0
    testCase.time = double(nativeResult.duration) * 1e-3;
  end
  if event.reusable || updatedState.fallback_attempt(caseIndex)
    testCase.worker_pool_used = true;
    testCase.worker_pool_failure = worker_pool_failure_from_native(event);
  end
  if updatedState.fallback_attempt(caseIndex)
    testCase.worker_pool_fallback = true;
    testCase.worker_pool_failure = updatedState.failures{caseIndex};
  end
  updatedState.results{caseIndex} = testCase;
  updatedState.completed(caseIndex) = true;
end
%=============================================================================
%=============================================================================
