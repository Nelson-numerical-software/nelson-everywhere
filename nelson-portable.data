%=============================================================================
function y = __mean_family__(x, method, varargin)
  if ~(isnumeric(x) && isreal(x) && ~issparse(x))
    error('Nelson:statistics:xMustBeRealArray', '%s must be a real numeric array.', 'X');
  end
  if isempty(x)
    y = cast(NaN, class(x));
    return
  end
  [dims, allValues, omitnan, returnInput] = parseInputsLocal(x, varargin);
  if returnInput
    y = x;
  elseif allValues
    y = meanVectorLocal(double(x(:)), method, omitnan);
  else
    y = meanAlongDimensionsLocal(double(x), method, dims, omitnan);
  end
  if isa(x, 'single') && ~isa(y, 'single')
    y = single(y);
  end
end
%=============================================================================
function [dims, allValues, omitnan, returnInput] = parseInputsLocal(x, args)
  dims = firstNonsingletonLocal(size(x));
  allValues = false;
  omitnan = false;
  returnInput = false;
  if isempty(args)
    return
  end
  first = args{1};
  consumedDimension = false;
  if isTextScalarLocal(first)
    text = lower(char(first));
    if strcmp(text, 'all')
      dims = [];
      allValues = true;
      consumedDimension = true;
    elseif isNanFlagLocal(text)
      omitnan = strcmp(text, 'omitnan');
    else
      error('Nelson:statistics:invalidOption', 'Invalid option.');
    end
  else
    [dims, returnInput] = parseDimensionLocal(first, size(x));
    consumedDimension = true;
  end
  if length(args) >= 2
    text = textArgumentLocal(args{2});
    if ~isNanFlagLocal(text)
      error('Nelson:statistics:invalidOption', 'Invalid option.');
    end
    omitnan = strcmp(text, 'omitnan');
  end
  if length(args) > 2 || (~consumedDimension && length(args) > 1)
    error('Nelson:tooManyInputs', 'Too many input arguments.');
  end
end
%=============================================================================
function [dims, returnInput] = parseDimensionLocal(value, sz)
  returnInput = false;
  if ~(isnumeric(value) && isreal(value) && isvector(value) && ~isempty(value) ...
      && all(value == fix(value)) && all(value >= 1))
    error('Nelson:statistics:dimensionPositiveIntegerScalarVector', 'Dimension must be a positive integer scalar, vector, or ''all''.');
  end
  dims = unique(double(value(:).'), 'stable');
  rank = max(2, length(sz));
  if isscalar(dims) && (dims > rank || dimensionLengthLocal(sz, dims) == 1)
    returnInput = true;
  elseif all(dims > rank)
    returnInput = true;
  else
    dims = dims(dims <= rank);
  end
end
%=============================================================================
function y = meanAlongDimensionsLocal(x, method, dims, omitnan)
  originalRank = max(2, length(size(x)));
  sz = size(x);
  nd = max([length(sz), max(dims)]);
  sz(end + 1:nd) = 1;
  keepDims = setdiff(1:nd, dims, 'stable');
  perm = [dims, keepDims];
  xp = permute(reshape(x, sz), perm);
  psize = size(xp);
  psize(end + 1:nd) = 1;
  n = prod(psize(1:length(dims)));
  cols = prod(psize(length(dims) + 1:end));
  xr = reshape(xp, n, cols);
  values = NaN(1, cols);
  for k = 1:cols
    values(k) = meanVectorLocal(xr(:, k), method, omitnan);
  end
  outSize = sz;
  outSize(dims) = 1;
  outSize = outSize(1:originalRank);
  permutedOutSize = [ones(1, length(dims)), psize(length(dims) + 1:end)];
  y = ipermute(reshape(values, permutedOutSize), perm);
  y = reshape(y, outSize);
end
%=============================================================================
function value = meanVectorLocal(values, method, omitnan)
  if omitnan
    values = values(~isnan(values));
  end
  if isempty(values)
    value = NaN;
  elseif strcmp(method, 'geomean')
    value = exp(mean(log(values)));
  else
    value = length(values) / sum(1 ./ values);
  end
end
%=============================================================================
function text = textArgumentLocal(value)
  if ~isTextScalarLocal(value)
    error('Nelson:statistics:invalidOption', 'Invalid option.');
  end
  text = lower(char(value));
end
%=============================================================================
function tf = isNanFlagLocal(text)
  tf = strcmp(text, 'includenan') || strcmp(text, 'omitnan');
end
%=============================================================================
function value = dimensionLengthLocal(sz, dim)
  if dim <= length(sz)
    value = sz(dim);
  else
    value = 1;
  end
end
%=============================================================================
function dim = firstNonsingletonLocal(sz)
  dim = 1;
  for k = 1:length(sz)
    if sz(k) ~= 1
      dim = k;
      return
    end
  end
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = __moment_stats__(x, order, varargin)
  if ~(isnumeric(x) && isreal(x) && ~issparse(x))
    error('Nelson:statistics:xMustBeRealArray', '%s must be a real numeric array.', 'X');
  end
  if isempty(x)
    y = NaN;
    return
  end
  [flag, dims, allValues] = parseInputsLocal(x, varargin);
  if allValues
    y = momentVectorLocal(double(x(:)), flag, order);
  else
    y = momentAlongDimensionsLocal(double(x), flag, dims, order);
  end
  if isa(x, 'single')
    y = single(y);
  end
end
%=============================================================================
function [flag, dims, allValues] = parseInputsLocal(x, args)
  flag = 1;
  dims = firstNonsingletonLocal(size(x));
  allValues = false;
  if isempty(args)
    return
  end
  flag = parseFlagLocal(args{1});
  if length(args) >= 2
    [dims, allValues] = parseDimensionLocal(args{2});
  end
end
%=============================================================================
function flag = parseFlagLocal(value)
  if isempty(value)
    flag = 1;
    return
  end
  if ~(isnumeric(value) || islogical(value)) || ~isscalar(value) || ~(value == 0 || value == 1)
    error('Nelson:statistics:invalidFlag', '%s must be 0 or 1.', 'Flag');
  end
  flag = double(value);
end
%=============================================================================
function [dims, allValues] = parseDimensionLocal(value)
  allValues = false;
  if isTextScalarLocal(value)
    if strcmpi(char(value), 'all')
      dims = [];
      allValues = true;
      return
    end
    error('Nelson:statistics:dimensionPositiveIntegerScalarVector', 'Dimension must be a positive integer scalar, vector, or ''all''.');
  end
  if ~(isnumeric(value) && isreal(value) && isvector(value) && ~isempty(value) ...
      && all(value == fix(value)) && all(value >= 1))
    error('Nelson:statistics:dimensionPositiveIntegerScalarVector', 'Dimension must be a positive integer scalar, vector, or ''all''.');
  end
  dims = unique(double(value(:).'), 'stable');
end
%=============================================================================
function y = momentAlongDimensionsLocal(x, flag, dims, order)
  originalRank = max(2, length(size(x)));
  sz = size(x);
  nd = max([length(sz), max(dims)]);
  sz(end + 1:nd) = 1;
  keepDims = setdiff(1:nd, dims, 'stable');
  perm = [dims, keepDims];
  xp = permute(reshape(x, sz), perm);
  psize = size(xp);
  psize(end + 1:nd) = 1;
  n = prod(psize(1:length(dims)));
  cols = prod(psize(length(dims) + 1:end));
  xr = reshape(xp, n, cols);
  values = NaN(1, cols);
  for k = 1:cols
    values(k) = momentVectorLocal(xr(:, k), flag, order);
  end
  outSize = sz;
  outSize(dims) = 1;
  outSize = outSize(1:originalRank);
  permutedOutSize = [ones(1, length(dims)), psize(length(dims) + 1:end)];
  y = ipermute(reshape(values, permutedOutSize), perm);
  y = reshape(y, outSize);
end
%=============================================================================
function value = momentVectorLocal(values, flag, order)
  values = values(~isnan(values));
  n = length(values);
  if n == 0
    value = NaN;
    return
  end
  centered = values - mean(values);
  m2 = mean(centered .^ 2);
  if ~(m2 > 0)
    value = NaN;
    return
  end
  if order == 3
    value = mean(centered .^ 3) / (m2 ^ 1.5);
    if flag == 0
      value = correctedSkewnessLocal(value, n);
    end
  else
    value = mean(centered .^ 4) / (m2 ^ 2);
    if flag == 0
      value = correctedKurtosisLocal(value, n);
    end
  end
end
%=============================================================================
function value = correctedSkewnessLocal(value, n)
  if n < 3
    value = NaN;
  else
    value = sqrt(n * (n - 1)) / (n - 2) * value;
  end
end
%=============================================================================
function value = correctedKurtosisLocal(value, n)
  if n < 4
    value = NaN;
  else
    value = ((n - 1) / ((n - 2) * (n - 3))) * ((n + 1) * value - 3 * (n - 1)) + 3;
  end
end
%=============================================================================
function dim = firstNonsingletonLocal(sz)
  dim = 1;
  for k = 1:length(sz)
    if sz(k) ~= 1
      dim = k;
      return
    end
  end
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = __nan_statistics__(x, method, weights, varargin)
  if ~(isnumeric(x) && isreal(x) && ~issparse(x))
    error('Nelson:statistics:xMustBeRealArray', '%s must be a real numeric array.', 'X');
  end
  if isempty(x)
    y = cast(NaN, class(x));
    return
  end
  [dims, allValues, returnInput] = parseDimensionsLocal(x, varargin);
  if returnInput
    y = returnInputLocal(x, method);
  elseif strcmp(method, 'median')
    y = medianLocal(x, dims, allValues);
  elseif strcmp(method, 'mean')
    y = meanLocal(x, dims, allValues);
  else
    y = varianceFamilyLocal(x, method, weights, dims, allValues);
  end
  if isa(x, 'single') && ~isa(y, 'single')
    y = single(y);
  end
end
%=============================================================================
function y = meanLocal(x, dims, allValues)
  x = double(x);
  mask = ~isnan(x);
  x(~mask) = 0;
  n = reduceSumLocal(double(mask), dims, allValues);
  y = reduceSumLocal(x, dims, allValues) ./ n;
  y(n == 0) = NaN;
end
%=============================================================================
function y = varianceFamilyLocal(x, method, weights, dims, allValues)
  if isscalar(weights)
    y = scalarWeightedVarianceLocal(double(x), weights, dims, allValues);
  else
    if allValues || ~isscalar(dims)
      error('Nelson:statistics:vectorWeightsRequireScalarOperating', 'Vector weights require a scalar operating dimension.');
    end
    y = vectorWeightedVarianceLocal(double(x), double(weights(:)), dims);
  end
  if strcmp(method, 'std')
    y = sqrt(y);
  end
end
%=============================================================================
function y = scalarWeightedVarianceLocal(x, flag, dims, allValues)
  mask = ~isnan(x);
  x(~mask) = 0;
  n = reduceSumLocal(double(mask), dims, allValues);
  s = reduceSumLocal(x, dims, allValues);
  ss = reduceSumLocal(x .* x, dims, allValues);
  y = (ss - (s .* s) ./ n) ./ denominatorLocal(n, flag);
  y(n == 0) = NaN;
end
%=============================================================================
function y = vectorWeightedVarianceLocal(x, weights, dim)
  if length(weights) ~= size(x, dim)
    error('Nelson:statistics:weightsLengthMatchOperatingDimension', 'Weights length must match the operating dimension.');
  end
  nd = max(ndims(x), dim);
  shape = ones(1, nd);
  shape(dim) = length(weights);
  w = reshape(weights, shape);
  reps = size(x);
  reps(end + 1:nd) = 1;
  reps(dim) = 1;
  w = repmat(w, reps);
  valid = ~isnan(x) & ~isnan(w);
  x(~valid) = 0;
  w(~valid) = 0;
  if any(w(:) < 0)
    error('Nelson:statistics:weights01NonnegativeVector', 'Weights must be 0, 1, or a nonnegative vector.');
  end
  sw = sum(w, dim);
  sx = sum(w .* x, dim);
  sxx = sum(w .* x .* x, dim);
  y = (sxx - (sx .* sx) ./ sw) ./ sw;
  y(sw == 0) = NaN;
end
%=============================================================================
function d = denominatorLocal(n, flag)
  if flag == 0
    d = n - 1;
    idx = n <= 1;
    if any(idx(:))
      d(idx) = n(idx);
    end
  else
    d = n;
  end
end
%=============================================================================
function y = medianLocal(x, dims, allValues)
  if allValues
    values = double(x(:));
    values = values(~isnan(values));
    y = medianVectorLocal(values);
  else
    y = medianAlongDimensionsLocal(double(x), dims);
  end
end
%=============================================================================
function y = medianAlongDimensionsLocal(x, dims)
  originalRank = max(2, length(size(x)));
  sz = size(x);
  nd = max([length(sz), max(dims)]);
  sz(end + 1:nd) = 1;
  keepDims = setdiff(1:nd, dims, 'stable');
  perm = [dims, keepDims];
  xp = permute(reshape(x, sz), perm);
  psize = size(xp);
  psize(end + 1:nd) = 1;
  n = prod(psize(1:length(dims)));
  cols = prod(psize(length(dims) + 1:end));
  xr = reshape(xp, n, cols);
  values = NaN(1, cols);
  for k = 1:cols
    column = xr(:, k);
    values(k) = medianVectorLocal(column(~isnan(column)));
  end
  outSize = sz;
  outSize(dims) = 1;
  outSize = outSize(1:originalRank);
  permutedOutSize = [ones(1, length(dims)), psize(length(dims) + 1:end)];
  y = ipermute(reshape(values, permutedOutSize), perm);
  y = reshape(y, outSize);
end
%=============================================================================
function value = medianVectorLocal(values)
  if isempty(values)
    value = NaN;
  else
    value = median(values);
  end
end
%=============================================================================
function y = reduceSumLocal(x, dims, allValues)
  if allValues
    y = sum(x, 'all');
    return
  end
  if isscalar(dims)
    y = sum(x, dims);
    return
  end
  originalRank = max(2, length(size(x)));
  sz = size(x);
  nd = max([length(sz), max(dims)]);
  sz(end + 1:nd) = 1;
  keepDims = setdiff(1:nd, dims, 'stable');
  perm = [dims, keepDims];
  xp = permute(reshape(x, sz), perm);
  psize = size(xp);
  psize(end + 1:nd) = 1;
  n = prod(psize(1:length(dims)));
  cols = prod(psize(length(dims) + 1:end));
  values = sum(reshape(xp, n, cols), 1);
  outSize = sz;
  outSize(dims) = 1;
  outSize = outSize(1:originalRank);
  permutedOutSize = [ones(1, length(dims)), psize(length(dims) + 1:end)];
  y = ipermute(reshape(values, permutedOutSize), perm);
  y = reshape(y, outSize);
end
%=============================================================================
function [dims, allValues, returnInput] = parseDimensionsLocal(x, args)
  dims = firstNonsingletonLocal(size(x));
  allValues = false;
  returnInput = false;
  if isempty(args)
    return
  end
  if length(args) > 1
    error('Nelson:tooManyInputs', 'Too many input arguments.');
  end
  value = args{1};
  if isTextScalarLocal(value)
    text = lower(char(value));
    if strcmp(text, 'all')
      dims = [];
      allValues = true;
    else
      error('Nelson:statistics:invalidOption', 'Invalid option.');
    end
  else
    [dims, returnInput] = parseDimensionLocal(value, size(x));
  end
end
%=============================================================================
function [dims, returnInput] = parseDimensionLocal(value, sz)
  returnInput = false;
  if ~(isnumeric(value) && isreal(value) && isvector(value) && ~isempty(value) ...
      && all(value == fix(value)) && all(value >= 1))
    error('Nelson:statistics:dimensionPositiveIntegerScalarVector', 'Dimension must be a positive integer scalar, vector, or ''all''.');
  end
  dims = unique(double(value(:).'), 'stable');
  rank = max(2, length(sz));
  if isscalar(dims) && (dims > rank || dimensionLengthLocal(sz, dims) == 1)
    returnInput = true;
  elseif all(dims > rank)
    returnInput = true;
  else
    dims = dims(dims <= rank);
  end
end
%=============================================================================
function y = returnInputLocal(x, method)
  if strcmp(method, 'mean') || strcmp(method, 'median')
    y = x;
  else
    y = zeros(size(x), class(x));
    y(isnan(x)) = NaN;
  end
end
%=============================================================================
function value = dimensionLengthLocal(sz, dim)
  if dim <= length(sz)
    value = sz(dim);
  else
    value = 1;
  end
end
%=============================================================================
function dim = firstNonsingletonLocal(sz)
  dim = 1;
  for k = 1:length(sz)
    if sz(k) ~= 1
      dim = k;
      return
    end
  end
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function name = __option_name__(value, names)
  if ~(ischar(value) || (isstring(value) && isscalar(value)))
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
  text = lower(char(value));
  exact = names(strcmp(names, text));
  if length(exact) == 1
    name = exact{1};
    return
  end
  matches = names(startsWith(names, text));
  if isempty(matches)
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
  if length(matches) > 1
    error('Nelson:statistics:ambiguousNameValue', 'Ambiguous name-value argument name.');
  end
  name = matches{1};
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function value = __predictor_names__(value, p)
  if isstring(value)
    value = cellstr(value(:));
  elseif iscellstr(value)
    value = value(:);
  else
    error('Nelson:validators:mustBeTextArray', '%s must be a string array or cell array of character vectors.', 'PredictorNames');
  end
  if length(value) ~= p
    error('Nelson:statistics:predictorNamesOneNamePredictor', 'PredictorNames must have one name per predictor.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function Q = __quantile__(A, probs, args, allowCount, percentInput)
  if ~(isnumeric(A) && isreal(A) && ~issparse(A))
    error('Nelson:statistics:aMustBeRealArray', '%s must be a real numeric array.', 'A');
  end
  [p, method] = parseProbabilitiesLocal(probs, allowCount, percentInput);
  [dims, allValues, method] = parseArgsLocal(A, args, method);
  if allValues
    Q = quantileVectorLocal(double(A(:)), p, method);
    Q = Q(:);
    return
  end
  Q = quantileAlongDimensionsLocal(double(A), p, dims, method);
end
%=============================================================================
function [p, method] = parseProbabilitiesLocal(value, allowCount, percentInput)
  method = 'midpoint';
  if ~(isnumeric(value) && isreal(value) && (isscalar(value) || isvector(value)))
    error('Nelson:statistics:probabilitiesRealNumericScalarVector', '%s must be a real numeric scalar or vector.', 'Probabilities');
  end
  value = double(value(:).');
  if allowCount && isscalar(value) && value > 1 && isfinite(value) && value == fix(value)
    if value <= 1
      error('Nelson:statistics:numberQuantilesIntegerGreaterOne', 'Number of quantiles must be an integer greater than one.');
    end
    p = (1:value) ./ (value + 1);
    return
  end
  if percentInput
    if any(~isfinite(value)) || any(value < 0) || any(value > 100)
      error('Nelson:statistics:percentageOutOfRange', 'Percentages must be in the range [0,100].');
    end
    p = value ./ 100;
  else
    if any(~isfinite(value)) || any(value < 0) || any(value > 1)
      error('Nelson:statistics:probabilityOutOfRange', '%s must be in the range [0,1].', 'Probabilities');
    end
    p = value;
  end
end
%=============================================================================
function [dims, allValues, method] = parseArgsLocal(A, args, method)
  dims = firstNonsingletonLocal(size(A));
  allValues = false;
  k = 1;
  while k <= length(args)
    arg = args{k};
    if isTextScalarLocal(arg) && strcmpi(char(arg), 'method')
      if k == length(args)
        error('Nelson:statistics:methodRequiresValue', 'Method option requires a value.');
      end
      method = parseMethodLocal(args{k + 1});
      k = k + 2;
    elseif isTextScalarLocal(arg)
      if strcmpi(char(arg), 'all')
        dims = [];
        allValues = true;
        k = k + 1;
      else
        error('Nelson:statistics:invalidQuantileOption', 'Invalid quantile option.');
      end
    elseif isnumeric(arg)
      [dims, allValues] = parseDimensionLocal(arg);
      k = k + 1;
    else
      error('Nelson:statistics:invalidQuantileOption', 'Invalid quantile option.');
    end
  end
end
%=============================================================================
function method = parseMethodLocal(value)
  if ~isTextScalarLocal(value)
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Method');
  end
  method = lower(char(value));
  switch method
    case {'midpoint', 'exact', 'inclusive', 'exclusive', 'approximate'}
    otherwise
      error('Nelson:statistics:invalidQuantileMethod', 'Invalid quantile method.');
  end
end
%=============================================================================
function [dims, allValues] = parseDimensionLocal(value)
  allValues = false;
  if ~(isnumeric(value) && isreal(value) && isvector(value) && all(value == fix(value)) ...
      && all(value >= 1))
    error('Nelson:statistics:invalidDimensionArg:dimensionArgumentAPositiveIntegerScalar', 'Dimension argument must be a positive integer scalar, vector, or ''all''.');
  end
  dims = unique(double(value(:).'), 'stable');
end
%=============================================================================
function Q = quantileAlongDimensionsLocal(A, p, dims, method)
  originalRank = max(2, length(size(A)));
  sz = size(A);
  nd = max([length(sz), max(dims)]);
  sz(end + 1:nd) = 1;
  keepDims = setdiff(1:nd, dims, 'stable');
  perm = [dims, keepDims];
  Ap = permute(reshape(A, sz), perm);
  psize = size(Ap);
  psize(end + 1:nd) = 1;
  n = prod(psize(1:length(dims)));
  cols = prod(psize(length(dims) + 1:end));
  Ar = reshape(Ap, n, cols);
  values = NaN(length(p), cols);
  for k = 1:cols
    values(:, k) = quantileVectorLocal(Ar(:, k), p, method);
  end
  outSize = sz;
  outSize(dims) = 1;
  outSize(dims(1)) = length(p);
  outSize = outSize(1:max(originalRank, dims(1)));
  permutedOutSize = [length(p), ones(1, length(dims) - 1), psize(length(dims) + 1:end)];
  Q = ipermute(reshape(values, permutedOutSize), perm);
  Q = reshape(Q, outSize);
end
%=============================================================================
function q = quantileVectorLocal(values, p, method)
  values = sort(values(~isnan(values)));
  n = length(values);
  q = NaN(length(p), 1);
  if n == 0
    return
  end
  if n == 1
    q(:) = values(1);
    return
  end
  pos = positionsLocal(p, n, method);
  for j = 1:length(p)
    q(j) = interpolateLocal(values, pos(j));
  end
end
%=============================================================================
function pos = positionsLocal(p, n, method)
  switch lower(method)
    case {'midpoint', 'exact', 'approximate'}
      pos = n .* p + 0.5;
    case 'inclusive'
      pos = (n - 1) .* p + 1;
    case 'exclusive'
      pos = (n + 1) .* p;
    otherwise
      error('Nelson:statistics:invalidQuantileMethod', 'Invalid quantile method.');
  end
end
%=============================================================================
function value = interpolateLocal(values, pos)
  n = length(values);
  if pos <= 1
    value = values(1);
  elseif pos >= n
    value = values(n);
  else
    lo = floor(pos);
    hi = ceil(pos);
    if lo == hi
      value = values(lo);
    else
      value = values(lo) + (pos - lo) .* (values(hi) - values(lo));
    end
  end
end
%=============================================================================
function dim = firstNonsingletonLocal(sz)
  dim = 1;
  for k = 1:length(sz)
    if sz(k) ~= 1
      dim = k;
      return
    end
  end
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
