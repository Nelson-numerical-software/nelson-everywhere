% LICENCE_BLOCK_END
%=============================================================================
function addParamValue(obj, name, defaultValue, validator)
  narginchk(3, 4);
  if nargin < 4
    addParameter(obj, name, defaultValue);
  else
    addParameter(obj, name, defaultValue, validator);
  end
end
