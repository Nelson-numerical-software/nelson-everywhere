% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function pat = alphanumericBoundary(boundary)
  narginchk(0, 1);
  nargoutchk(0, 1);
  if nargin == 0 || strcmpi(char(boundary), 'either')
    expr = '(?:(?<=\w)(?=\W)|(?<=\W)(?=\w)|^\b|\b$)';
  elseif strcmpi(char(boundary), 'start')
    expr = '(?<!\w)(?=\w)';
  elseif strcmpi(char(boundary), 'end')
    expr = '(?<=\w)(?!\w)';
  else
    error('Nelson:string:boundaryStartEndEither', 'Boundary must be ''start'', ''end'', or ''either''.');
  end
  pat = pattern(expr);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function pat = alphanumericsPattern(varargin)
  narginchk(0, 2);
  nargoutchk(0, 1);
  pat = pattern('[A-Za-z0-9]');
  if nargin == 0
    pat = asManyOfPattern(pat);
  elseif nargin == 1
    pat = pattern(['(?:', pattern.regexOf(pat), '){', int2str(varargin{1}), '}']);
  elseif nargin == 2
    pat = asManyOfPattern(pat, [varargin{1}, varargin{2}]);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function pat = asFewOfPattern(basePattern, count, maxCount)
  narginchk(1, 3);
  nargoutchk(0, 1);
  expr = pattern.regexOf(basePattern);
  if nargin == 1
    quantifier = '*?';
  elseif nargin == 3
    count = [count, maxCount];
  end
  if nargin > 1 && isscalar(count)
    quantifier = ['{', int2str(count), ',}?'];
  elseif nargin > 1
    quantifier = ['{', int2str(count(1)), ',', quantifierUpper(count(2)), '}?'];
  end
  pat = pattern(['(?:', expr, ')', quantifier]);
end
%=============================================================================
function txt = quantifierUpper(value)
  if isinf(value)
    txt = '';
  else
    txt = int2str(value);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function pat = asManyOfPattern(basePattern, count, maxCount)
  narginchk(1, 3);
  nargoutchk(0, 1);
  expr = pattern.regexOf(basePattern);
  if nargin == 1
    quantifier = '+';
  elseif nargin == 3
    count = [count, maxCount];
  end
  if nargin > 1 && isscalar(count)
    quantifier = ['{', int2str(count), ',}'];
  elseif nargin > 1
    quantifier = ['{', int2str(count(1)), ',', quantifierUpper(count(2)), '}'];
  end
  pat = pattern(['(?:', expr, ')', quantifier]);
end
%=============================================================================
function txt = quantifierUpper(value)
  if isinf(value)
    txt = '';
  else
    txt = int2str(value);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
