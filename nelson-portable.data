%=============================================================================
function c = calweeks(x)
  narginchk(1, 1);
  if isa(x, 'calendarDuration')
    c = fix(calendarDuration.rawDays(x) / 7);
  else
    c = calendarDuration(0, 0, double(x) .* 7);
  end
end
%=============================================================================
