function pattern = discover_filenamePattern(filename)
  [~, name, ~] = fileparts(filename); %#ok<NLS0004>
  if startsWith(name, 'test_')
    pattern = 'test_*.m';
  elseif startsWith(name, 'bug_')
    pattern = 'bug_*.m';
  elseif startsWith(name, 'bench_')
    pattern = 'bench_*.m';
  else
    pattern = '';
  end
end
