% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function ax = uiaxes(varargin)
  % uiaxes: create axes for App Designer style apps (uifigure based).
  % Behaves like axes with UIAxes defaults:
  %   Units = 'pixels', Position = [10 10 400 300],
  %   NextPlot = 'replacechildren', FontUnits = 'pixels'
  parent = [];
  args = varargin;
  if ~isempty(args) && isgraphics(args{1})
    parent = args{1};
    args = args(2:end);
  end
  if mod(numel(args), 2) ~= 0
    error('Nelson:uicomponent:pvPairsExpected', 'Wrong number of input arguments: property/value pairs expected.');
  end
  if isempty(parent)
    parent = uifigure();
  end
  userSetsPosition = false;
  for k = 1:2:numel(args)
    name = lower(char(args{k}));
    if strcmp(name, 'position') || strcmp(name, 'innerposition') || strcmp(name, 'outerposition')
      userSetsPosition = true;
    end
  end
  ax = __uiaxes__('Parent', parent, 'NextPlot', 'replacechildren', 'FontUnits', 'pixels', 'FontSize', 12);
  ax.Units = 'pixels';
  if ~userSetsPosition
    ax.Position = [10 10 400 300];
  end
  for k = 1:2:numel(args)
    set(ax, args{k}, args{k + 1});
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = view(varargin)
  % view(2), view(3)
  % view([0 90]), view([0 90 0])
  % view(az, el)

  narginchk(0, 3);
  nargoutchk(0, 2);
  args = {};

  if (nargin == 0)
    ax = gca();
    args = {ax};
  elseif (nargin == 1)
    ax = gca();
    args = {ax, varargin{1}};
  elseif (nargin == 2)
    if (isgraphics(varargin{1}))
      args = {varargin{1}, varargin{2}};
    else
      ax = gca();
      args = {ax, varargin{1}, varargin{2}};
    end
  else
    args = varargin;
  end
  if (nargout == 0 && numel(args) == 3 && isgraphics(args{1}, 'axes'))
    currentView = args{1}.View;
    if (isequal(currentView, [args{2}, args{3}]))
      varargout = {};
      return
    end
  end
  [azimuth, elevation] = __view__(args{:});
  if (nargout == 0)
    varargout = {};
  elseif (nargout == 1)
    varargout{1} = [azimuth, elevation];
  else
    varargout{1} = azimuth;
    varargout{2} = elevation;
  end
end
