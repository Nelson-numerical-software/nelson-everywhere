% LICENCE_BLOCK_END
%=============================================================================
function display(obj, varargin)
  if nargin == 2
    name = varargin{1};
  else
    name = inputname(1);
  end
  if ~isempty(name)
    disp([name, ' =']);
    disp(' ');
  end
  disp(obj);
end
