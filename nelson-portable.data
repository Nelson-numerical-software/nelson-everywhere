%=============================================================================
function [dC, C] = candgen(varargin)
  narginchk(1, Inf);
  nargoutchk(0, 2);

  nfactors = positiveInteger(varargin{1}, sprintf(_('%s must be a positive integer scalar.'), 'NFACTORS'));
  modelspec = 'linear';
  args = varargin(2:end);
  if ~isempty(args) && ~(isTextScalar(args{1}) && isOptionName(args{1}))
    modelspec = args{1};
    args = args(2:end);
  end
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  bounds = repmat([-1 1], nfactors, 1);
  for k = 1:2:length(args)
    name = optionName(args{k});
    switch name
      case 'bounds'
        bounds = validateBounds(args{k + 1}, nfactors);
      otherwise
        error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
    end
  end
  dC = fullCandidate(bounds);
  C = x2fx(dC, modelspec);
end
%=============================================================================
function dC = fullCandidate(bounds)
  dC = zeros(1, size(bounds, 1));
  for j = 1:size(bounds, 1)
    levels = unique(bounds(j, :));
    current = dC;
    dC = [];
    for k = 1:length(levels)
      block = current;
      block(:, j) = levels(k);
      dC = [dC; block];
    end
  end
end
%=============================================================================
function bounds = validateBounds(bounds, nfactors)
  if ~isnumeric(bounds) || ndims(bounds) ~= 2 || size(bounds, 1) ~= nfactors
    error('Nelson:statistics:boundsOneRowFactor', 'Bounds must have one row per factor.');
  end
  if size(bounds, 2) < 2
    error('Nelson:statistics:boundsContainLeastTwoLevels', 'Bounds must contain at least two levels per factor.');
  end
end
%=============================================================================
function tf = isOptionName(value)
  tf = false;
  try
    optionName(value);
    tf = true;
  catch
    tf = false;
  end
end
%=============================================================================
function name = optionName(value)
  if ~isTextScalar(value)
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
  text = lower(char(value));
  if strncmp('bounds', text, length(text))
    name = 'bounds';
  else
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
end
%=============================================================================
function value = positiveInteger(value, message)
  if ~isscalar(value) || value <= 0 || floor(value) ~= value
    error('Nelson:statistics:mustBePositiveInteger', message);
  end
end
%=============================================================================
function tf = isTextScalar(value)
  tf = ischar(value) || isStringScalar(value);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [A, B, r, U, V, stats] = canoncorr(X, Y)
  narginchk(2, 2);
  nargoutchk(0, 6);
  [X, Y] = validateInputsLocal(X, Y);
  n = size(X, 1);
  X = X - repmat(mean(X, 1), n, 1);
  Y = Y - repmat(mean(Y, 1), n, 1);
  [Xr, keepX] = independentColumnsLocal(X, 'X');
  [Yr, keepY] = independentColumnsLocal(Y, 'Y');
  [Ax, Bx, r, Ux, Vx] = reducedCanoncorrLocal(Xr, Yr, n);
  A = zeros(size(X, 2), size(Ax, 2));
  B = zeros(size(Y, 2), size(Bx, 2));
  if isempty(r)
    U = zeros(n, 0);
    V = zeros(n, 0);
    if nargout > 5
      stats = statsLocal(r, n, sum(keepX), sum(keepY));
    end
    return
  end
  A(keepX, :) = Ax;
  B(keepY, :) = Bx;
  [A, B, U, V] = orientColumnsLocal(A, B, X, Y);
  if nargout > 5
    stats = statsLocal(r, n, sum(keepX), sum(keepY));
  end
end
%=============================================================================
function [X, Y] = validateInputsLocal(X, Y)
  if ~(isnumeric(X) && isreal(X) && ~issparse(X) && ndims(X) == 2)
    error('Nelson:statistics:xRealNumericMatrix', '%s must be a real numeric matrix.', 'X');
  end
  if ~(isnumeric(Y) && isreal(Y) && ~issparse(Y) && ndims(Y) == 2)
    error('Nelson:statistics:yRealNumericMatrix', '%s must be a real numeric matrix.', 'Y');
  end
  if size(X, 1) ~= size(Y, 1)
    error('Nelson:statistics:xYSameNumberRows', '%s must have the same number of rows.', 'X and Y');
  end
  if size(X, 1) < 2 || size(X, 2) == 0 || size(Y, 2) == 0
    error('Nelson:statistics:xYContainLeastTwo', 'X and Y must contain at least two observations and one variable.');
  end
  X = double(X);
  Y = double(Y);
  if any(~isfinite(X(:))) || any(~isfinite(Y(:)))
    error('Nelson:statistics:xYContainFiniteValues', '%s must contain finite values.', 'X and Y');
  end
end
%=============================================================================
function [Xr, keep] = independentColumnsLocal(X, name)
  s = svd(X, 'econ');
  tolerance = max(size(X)) * eps(max([1; s(:)]));
  targetRank = sum(s > tolerance);
  keep = false(1, size(X, 2));
  Q = zeros(size(X, 1), 0);
  for k = 1:size(X, 2)
    v = X(:, k);
    if ~isempty(Q)
      v = v - Q * (Q' * v);
    end
    vnorm = norm(v);
    if vnorm > tolerance
      keep(k) = true;
      Q(:, end + 1) = v / vnorm;
    end
    if sum(keep) == targetRank
      break
    end
  end
  if sum(keep) < size(X, 2)
    warning(['Nelson:statistics:canoncorr:', name, 'RankDeficient'], ...
      sprintf(_('%s is not full rank.'), name));
  end
  Xr = X(:, keep);
end
%=============================================================================
function [A, B, r, U, V] = reducedCanoncorrLocal(X, Y, n)
  rx = size(X, 2);
  ry = size(Y, 2);
  d = min(rx, ry);
  if d == 0
    A = zeros(rx, 0);
    B = zeros(ry, 0);
    r = zeros(1, 0);
    U = zeros(n, 0);
    V = zeros(n, 0);
    return
  end
  [UX, SX, VX] = svd(X, 'econ');
  [UY, SY, VY] = svd(Y, 'econ');
  sx = diag(SX);
  sy = diag(SY);
  [L, D, M] = svd(UX' * UY, 'econ');
  r = min(max(diag(D(1:d, 1:d))', 0), 1);
  scale = sqrt(n - 1);
  A = VX(:, 1:rx) * (diag(scale ./ sx(1:rx)) * L(:, 1:d));
  B = VY(:, 1:ry) * (diag(scale ./ sy(1:ry)) * M(:, 1:d));
  U = X * A;
  V = Y * B;
end
%=============================================================================
function [A, B, U, V] = orientColumnsLocal(A, B, X, Y)
  U = X * A;
  V = Y * B;
  for k = 1:size(A, 2)
    if corrLocal(U(:, k), V(:, k)) < 0
      B(:, k) = -B(:, k);
      V(:, k) = -V(:, k);
    end
    [~, idx] = max(abs(A(:, k)));
    if A(idx, k) < 0
      A(:, k) = -A(:, k);
      B(:, k) = -B(:, k);
      U(:, k) = -U(:, k);
      V(:, k) = -V(:, k);
    end
  end
end
%=============================================================================
function c = corrLocal(x, y)
  denominator = norm(x) * norm(y);
  if denominator == 0
    c = NaN;
  else
    c = (x' * y) / denominator;
  end
end
%=============================================================================
function stats = statsLocal(r, n, p, q)
  d = length(r);
  Wilks = zeros(1, d);
  df1 = zeros(1, d);
  df2 = zeros(1, d);
  F = zeros(1, d);
  pF = zeros(1, d);
  chisq = zeros(1, d);
  pChisq = zeros(1, d);
  for k = 1:d
    pk = p - k + 1;
    qk = q - k + 1;
    lambda = prod(max(0, 1 - r(k:d) .^ 2));
    Wilks(k) = lambda;
    df1(k) = pk * qk;
    m = n - 1 - (pk + qk + 1) / 2;
    chisq(k) = max(0, -m * log(max(lambda, realmin)));
    pChisq(k) = chiSquareUpperLocal(chisq(k), df1(k));
    [F(k), df2(k), pF(k)] = raoFLocal(lambda, pk, qk, m);
  end
  stats = struct('Wilks', Wilks, 'df1', df1, 'df2', df2, 'F', F, ...
    'pF', pF, 'chisq', chisq, 'pChisq', pChisq, 'dfe', df1, 'p', pChisq);
end
%=============================================================================
function [F, df2, p] = raoFLocal(lambda, p, q, m)
  df1 = p * q;
  denom = p ^ 2 + q ^ 2 - 5;
  if denom > 0
    s = sqrt(max((p ^ 2 * q ^ 2 - 4) / denom, 1));
  else
    s = 1;
  end
  df2 = m * s - df1 / 2 + 1;
  lambdaRoot = max(lambda, realmin) .^ (1 / s);
  F = ((1 - lambdaRoot) / lambdaRoot) * (df2 / df1);
  if df2 > 0 && F >= 0
    p = betainc(df2 / (df2 + df1 * F), df2 / 2, df1 / 2);
  else
    p = NaN;
  end
end
%=============================================================================
function p = chiSquareUpperLocal(x, df)
  p = gammaincUpperLocal(x / 2, df / 2);
end
%=============================================================================
function q = gammaincUpperLocal(x, a)
  if x < 0 || a <= 0
    q = NaN;
  elseif x == 0
    q = 1;
  elseif x < a + 1
    q = 1 - gammaincSeriesLocal(x, a);
  else
    q = gammaincFractionLocal(x, a);
  end
end
%=============================================================================
function p = gammaincSeriesLocal(x, a)
  ap = a;
  del = 1 / a;
  sumValue = del;
  for k = 1:200
    ap = ap + 1;
    del = del * x / ap;
    sumValue = sumValue + del;
    if abs(del) < abs(sumValue) * eps
      break
    end
  end
  p = sumValue * exp(-x + a * log(x) - gammaln(a));
end
%=============================================================================
function q = gammaincFractionLocal(x, a)
  fpmin = realmin / eps;
  b = x + 1 - a;
  c = 1 / fpmin;
  d = 1 / max(b, fpmin);
  h = d;
  for k = 1:200
    an = -k * (k - a);
    b = b + 2;
    d = an * d + b;
    if abs(d) < fpmin
      d = fpmin;
    end
    c = b + an / c;
    if abs(c) < fpmin
      c = fpmin;
    end
    d = 1 / d;
    del = d * c;
    h = h * del;
    if abs(del - 1) < eps
      break
    end
  end
  q = exp(-x + a * log(x) - gammaln(a)) * h;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [h, p, stats] = chi2gof(x, varargin)
  narginchk(1, Inf);
  nargoutchk(0, 3);
  opts = parseOptionsLocal(convertStringToCharArgs(varargin));
  [values, frequency] = validateSampleLocal(x, opts.Frequency);
  edges = selectEdgesLocal(values, opts);
  observed = observedCountsLocal(values, frequency, edges);
  expected = expectedCountsLocal(edges, values, frequency, opts);
  [observed, expected] = poolBinsLocal(observed, expected, opts.EMin);
  [p, chi2stat, df] = pValueLocal(observed, expected, opts.NParams);
  h = p <= opts.Alpha;
  if isnan(p)
    h = false;
  end
  stats = struct('chi2stat', chi2stat, 'df', df, 'edges', edges, ...
    'O', observed, 'E', expected);
end
%=============================================================================
function opts = parseOptionsLocal(args)
  opts = struct('Alpha', 0.05, 'NBins', [], 'Ctrs', [], 'Edges', [], ...
    'CDF', [], 'Expected', [], 'Frequency', [], 'NParams', 0, 'EMin', 5);
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  k = 1;
  while k <= length(args)
    if ~(ischar(args{k}) || (isstring(args{k}) && isscalar(args{k})))
      error('Nelson:statistics:nameValueArgumentNameText', 'Name-value argument name must be text.');
    end
    name = lower(char(args{k}));
    value = args{k + 1};
    switch name
      case 'alpha'
        opts.Alpha = scalarInRangeLocal(value, 'ALPHA', 0, 1);
      case 'nbins'
        opts.NBins = positiveIntegerLocal(value, 'NBINS');
      case {'ctrs', 'centers'}
        opts.Ctrs = numericVectorLocal(value, 'CTRS');
      case 'edges'
        opts.Edges = numericVectorLocal(value, 'EDGES');
      case 'cdf'
        opts.CDF = value;
      case 'expected'
        opts.Expected = numericVectorLocal(value, 'EXPECTED');
      case 'frequency'
        opts.Frequency = value;
      case 'nparams'
        opts.NParams = nonnegativeIntegerLocal(value, 'NPARAMS');
      case 'emin'
        opts.EMin = positiveScalarLocal(value, 'EMIN');
      otherwise
        error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
    end
    k = k + 2;
  end
  validateOptionCombinationLocal(opts);
end
%=============================================================================
function validateOptionCombinationLocal(opts)
  nSpecified = ~isempty(opts.Ctrs) + ~isempty(opts.Edges);
  if nSpecified > 1
    error('Nelson:statistics:CTRSEDGESBothSpecified', 'CTRS and EDGES cannot both be specified.');
  end
  if ~isempty(opts.NBins) && (~isempty(opts.Ctrs) || ~isempty(opts.Edges))
    error('Nelson:statistics:NBINSCombinedCTRSEDGES', 'NBINS cannot be combined with CTRS or EDGES.');
  end
end
%=============================================================================
function [values, frequency] = validateSampleLocal(x, frequency)
  if ~(isnumeric(x) && isreal(x) && ~issparse(x) && isvector(x))
    error('Nelson:statistics:xRealNumericVector', '%s must be a real numeric vector.', 'X');
  end
  values = double(x(:));
  if isempty(frequency)
    frequency = ones(size(values));
  elseif ~(isnumeric(frequency) && isreal(frequency) && isvector(frequency))
    error('Nelson:statistics:FREQUENCYRealNumericVector', '%s must be a real numeric vector.', 'FREQUENCY');
  else
    frequency = double(frequency(:));
  end
  if length(frequency) ~= length(values)
    error('Nelson:statistics:FREQUENCYOneValueObservation', '%s must have one value per observation.', 'FREQUENCY');
  end
  keep = isfinite(values) & isfinite(frequency) & frequency > 0;
  values = values(keep);
  frequency = frequency(keep);
  if isempty(values)
    error('Nelson:statistics:xContainLeastOneFinite', 'X must contain at least one finite observation.');
  end
end
%=============================================================================
function edges = selectEdgesLocal(values, opts)
  if ~isempty(opts.Edges)
    edges = opts.Edges(:).';
    if length(edges) < 2 || any(diff(edges) <= 0)
      error('Nelson:statistics:EDGESStrictlyIncreasingVector', '%s must be a strictly increasing vector.', 'EDGES');
    end
  elseif ~isempty(opts.Ctrs)
    edges = centersToEdgesLocal(opts.Ctrs);
  elseif ~isempty(opts.Expected)
    edges = finiteRangeEdgesLocal(values, length(opts.Expected));
  elseif ~isempty(opts.CDF)
    edges = cdfDefaultEdgesLocal(values, opts.CDF, defaultBinCountLocal(opts));
  else
    edges = norminv((0:defaultBinCountLocal(opts)) / defaultBinCountLocal(opts));
  end
end
%=============================================================================
function n = defaultBinCountLocal(opts)
  if isempty(opts.NBins)
    n = 10;
  else
    n = opts.NBins;
  end
end
%=============================================================================
function edges = centersToEdgesLocal(centers)
  centers = centers(:).';
  if isempty(centers) || any(diff(centers) <= 0)
    error('Nelson:statistics:CTRSStrictlyIncreasingVector', '%s must be a strictly increasing vector.', 'CTRS');
  end
  if isscalar(centers)
    edges = [-Inf Inf];
  else
    midpoints = (centers(1:end - 1) + centers(2:end)) / 2;
    edges = [-Inf midpoints Inf];
  end
end
%=============================================================================
function edges = finiteRangeEdgesLocal(values, nBins)
  lo = min(values);
  hi = max(values);
  if lo == hi
    lo = lo - 0.5;
    hi = hi + 0.5;
  end
  edges = linspace(lo, hi, nBins + 1);
  edges(1) = -Inf;
  edges(end) = Inf;
end
%=============================================================================
function edges = cdfDefaultEdgesLocal(values, cdfSpec, nBins)
  probabilities = (0:nBins) / nBins;
  if isnumeric(cdfSpec)
    [support, cdfValues] = validateCdfMatrixLocal(cdfSpec);
    inner = interp1(cdfValues, support, probabilities(2:end - 1), 'linear');
    inner = inner(:).';
    edges = [-Inf inner Inf];
  else
    edges = finiteRangeEdgesLocal(values, nBins);
  end
end
%=============================================================================
function observed = observedCountsLocal(values, frequency, edges)
  observed = zeros(1, length(edges) - 1);
  [values, order] = sort(values);
  frequency = frequency(order);
  bin = 1;
  for k = 1:length(values)
    while bin < length(edges) - 1 && values(k) > edges(bin + 1)
      bin = bin + 1;
    end
    if values(k) >= edges(bin) && values(k) <= edges(bin + 1)
      observed(bin) = observed(bin) + frequency(k);
    end
  end
end
%=============================================================================
function expected = expectedCountsLocal(edges, values, frequency, opts)
  total = sum(frequency);
  if ~isempty(opts.Expected)
    expected = opts.Expected(:).';
    if length(expected) ~= length(edges) - 1
      error('Nelson:statistics:EXPECTEDMatchNumberBins', 'EXPECTED must match the number of bins.');
    end
    if any(expected < 0) || sum(expected) <= 0
      error('Nelson:statistics:EXPECTEDContainNonnegativeCountsPositive', 'EXPECTED must contain nonnegative counts with positive sum.');
    end
    expected = expected * total / sum(expected);
    return
  end
  cdfValues = evaluateCdfLocal(edges, opts.CDF);
  expected = total * diff(cdfValues(:).');
  expected(expected < 0 & expected > -sqrt(eps)) = 0;
  if any(expected < 0)
    error('Nelson:statistics:CDFValuesNondecreasing', 'CDF values must be nondecreasing.');
  end
end
%=============================================================================
function cdfValues = evaluateCdfLocal(edges, cdfSpec)
  if isempty(cdfSpec)
    cdfValues = normcdf(edges);
  elseif isnumeric(cdfSpec)
    [support, probabilities] = validateCdfMatrixLocal(cdfSpec);
    cdfValues = interp1(support, probabilities, edges, 'linear', NaN);
    cdfValues(isinf(edges) & edges < 0) = 0;
    cdfValues(isinf(edges) & edges > 0) = 1;
  elseif isa(cdfSpec, 'function_handle')
    cdfValues = feval(cdfSpec, edges);
  else
    error('Nelson:statistics:CDFTwoColumnMatrixFunction', 'CDF must be a two-column matrix or function handle.');
  end
  cdfValues = double(cdfValues(:).');
  if length(cdfValues) ~= length(edges)
    error('Nelson:statistics:invalidCdfOutput', 'CDF function must return %s.', 'one value per edge');
  end
  if any(isnan(cdfValues)) || any(cdfValues < 0 | cdfValues > 1)
    error('Nelson:statistics:invalidCdf', '%s must be in the range [0,1].', 'CDF values');
  end
end
%=============================================================================
function [support, probabilities] = validateCdfMatrixLocal(cdfSpec)
  if ~(isnumeric(cdfSpec) && isreal(cdfSpec) && size(cdfSpec, 2) == 2)
    error('Nelson:statistics:CDFTwoColumnMatrixFunction', 'CDF must be a two-column matrix or function handle.');
  end
  support = double(cdfSpec(:, 1));
  probabilities = double(cdfSpec(:, 2));
  if any(diff(support) <= 0) || any(diff(probabilities) < 0)
    error('Nelson:statistics:CDFMatrixValuesSortedNondecreasing', 'CDF matrix values must be sorted and nondecreasing.');
  end
  if any(probabilities < 0 | probabilities > 1)
    error('Nelson:statistics:invalidCdf', '%s must be in the range [0,1].', 'CDF values');
  end
end
%=============================================================================
function [observed, expected] = poolBinsLocal(observed, expected, eMin)
  while length(expected) > 1 && any(expected < eMin)
    [~, idx] = min(expected);
    if idx == 1
      target = 2;
    elseif idx == length(expected)
      target = idx - 1;
    elseif expected(idx - 1) <= expected(idx + 1)
      target = idx - 1;
    else
      target = idx + 1;
    end
    observed(target) = observed(target) + observed(idx);
    expected(target) = expected(target) + expected(idx);
    observed(idx) = [];
    expected(idx) = [];
  end
end
%=============================================================================
function [p, chi2stat, df] = pValueLocal(observed, expected, nParams)
  valid = expected > 0;
  chi2stat = sum(((observed(valid) - expected(valid)) .^ 2) ./ expected(valid));
  df = sum(valid) - 1 - nParams;
  if df <= 0
    p = NaN;
  else
    p = chi2cdf(chi2stat, df, 'upper');
  end
end
%=============================================================================
function value = scalarInRangeLocal(value, name, lo, hi)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && value > lo && value < hi)
    error('Nelson:statistics:mustBeInRange', '%s must be a scalar in the range (0,1).', name);
  end
  value = double(value);
end
%=============================================================================
function value = positiveScalarLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && value > 0)
    error('Nelson:statistics:mustBePositive', '%s must be a positive scalar.', name);
  end
  value = double(value);
end
%=============================================================================
function value = positiveIntegerLocal(value, name)
  value = positiveScalarLocal(value, name);
  if value ~= fix(value)
    error('Nelson:statistics:mustBePositiveInteger', '%s must be a positive integer scalar.', name);
  end
end
%=============================================================================
function value = nonnegativeIntegerLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && value >= 0 && value == fix(value))
    error('Nelson:statistics:mustBeNonnegativeInteger', '%s must be a nonnegative integer scalar.', name);
  end
  value = double(value);
end
%=============================================================================
function value = numericVectorLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isvector(value))
    error('Nelson:statistics:mustBeRealVector', '%s must be a real numeric vector.', name);
  end
  value = double(value(:).');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function T = clusterdata(varargin)
  narginchk(3, Inf);
  nargoutchk(0, 1);

  X = varargin{1};
  if ~isnumeric(X) || ndims(X) ~= 2 || size(X, 1) < 2
    error('Nelson:statistics:xNumericMatrixLeastTwo', 'X must be a numeric matrix with at least two rows.');
  end
  if rem(nargin - 1, 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  opts = parseOptions(varargin(2:end));
  if isempty(opts.Cutoff) == isempty(opts.MaxClust)
    error('Nelson:statistics:cutoffOrMaxClust', 'Specify either Cutoff or MaxClust.');
  end

  if isempty(opts.DistanceParameter)
    D = pdist(X, opts.Distance);
  else
    D = pdist(X, opts.Distance, opts.DistanceParameter);
  end
  Z = linkage(D, opts.Linkage);
  if isempty(opts.Cutoff)
    T = cluster(Z, 'MaxClust', opts.MaxClust, 'Criterion', opts.Criterion);
  else
    T = cluster(Z, 'Cutoff', opts.Cutoff, 'Criterion', opts.Criterion);
  end
end
%=============================================================================
function opts = parseOptions(args)
  opts = struct('Cutoff', [], 'MaxClust', [], 'Criterion', 'distance', ...
                'Distance', 'euclidean', 'DistanceParameter', [], ...
                'Linkage', 'single', 'SaveMemory', 'off', 'Depth', []);
  for k = 1:2:length(args)
    name = optionName(args{k});
    value = args{k + 1};
    switch name
      case 'cutoff'
        opts.Cutoff = numericVector(value, sprintf(_('%s must be numeric.'), 'Cutoff'));
      case 'maxclust'
        opts.MaxClust = numericVector(value, sprintf(_('%s must be numeric.'), 'MaxClust'));
      case 'criterion'
        opts.Criterion = criterionValue(value);
      case 'distance'
        opts.Distance = value;
      case 'linkage'
        opts.Linkage = value;
      case 'p'
        opts.DistanceParameter = positiveScalar(value, sprintf(_('%s must be a positive scalar.'), 'P'));
      case 'savememory'
        opts.SaveMemory = onOffValue(value);
      case 'depth'
        opts.Depth = positiveScalar(value, sprintf(_('%s must be a positive scalar.'), 'Depth'));
      otherwise
        error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
    end
  end
end
%=============================================================================
function name = optionName(value)
  if ~(ischar(value) || isStringScalar(value))
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Name');
  end
  text = lower(char(value));
  if isempty(text)
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
  names = {'cutoff', 'maxclust', 'criterion', 'distance', 'linkage', 'p', 'savememory', 'depth'};
  matches = {};
  for k = 1:length(names)
    if strncmp(names{k}, text, length(text))
      matches{end + 1} = names{k};
    end
  end
  if isempty(matches)
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
  if length(matches) > 1
    error('Nelson:statistics:ambiguousNameValue', 'Ambiguous name-value argument name.');
  end
  name = matches{1};
end
%=============================================================================
function value = criterionValue(value)
  if ~(ischar(value) || isStringScalar(value))
    error('Nelson:statistics:criterionDistance', 'Criterion must be ''distance''.');
  end
  text = lower(char(value));
  if ~isempty(text) && strncmp('distance', text, length(text))
    value = 'distance';
  else
    error('Nelson:statistics:criterionDistance', 'Criterion must be ''distance''.');
  end
end
%=============================================================================
function value = onOffValue(value)
  if ~(ischar(value) || isStringScalar(value))
    error('Nelson:statistics:saveMemoryOff', 'SaveMemory must be ''on'' or ''off''.');
  end
  text = lower(char(value));
  if ~isempty(text) && strncmp('on', text, length(text))
    value = 'on';
  elseif ~isempty(text) && strncmp('off', text, length(text))
    value = 'off';
  else
    error('Nelson:statistics:saveMemoryOff', 'SaveMemory must be ''on'' or ''off''.');
  end
end
%=============================================================================
function values = numericVector(value, message)
  if ~isnumeric(value) || ~isvector(value) || isempty(value)
    error('Nelson:statistics:mustBeNumericVector', message);
  end
  values = value(:)';
end
%=============================================================================
function value = positiveScalar(value, message)
  if ~isnumeric(value) || ~isscalar(value) || ~(value > 0)
    error('Nelson:statistics:mustBePositive', message);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [Y, e] = cmdscale(D, p)
  narginchk(1, 2);
  nargoutchk(0, 2);
  if nargin < 2
    p = [];
  end
  [D, requestedP] = parseInputsLocal(D, nargin, p);
  n = size(D, 1);
  if n == 0
    Y = zeros(0, 0);
    e = zeros(0, 1);
    return
  end
  D = dissimilarityMatrixLocal(D);
  B = gramMatrixLocal(D);
  [V, E] = eig((B + B') / 2);
  [eAll, order] = sort(real(diag(E)), 'descend');
  V = real(V(:, order));
  V = orientColumnsLocal(V);
  positive = positiveEigenvaluesLocal(eAll);
  if isempty(requestedP)
    e = eAll(:);
    cols = find(positive);
  else
    p = requestedP;
    e = eAll(1:min(p, length(eAll)));
    cols = find(positive(1:min(p, length(positive))));
  end
  if isempty(cols)
    Y = zeros(n, 0);
  else
    Y = V(:, cols) * diag(sqrt(max(eAll(cols), 0)));
  end
end
%=============================================================================
function [D, p] = parseInputsLocal(D, nin, inputP)
  if ~(isnumeric(D) && isreal(D) && ~issparse(D) && ndims(D) == 2)
    error('Nelson:statistics:dRealNumericVectorMatrix', '%s must be a real numeric vector or matrix.', 'D');
  end
  if any(~isfinite(double(D(:))))
    error('Nelson:statistics:dContainFiniteValues', '%s must contain finite values.', 'D');
  end
  D = double(D);
  p = [];
  if isvector(D) && ~(size(D, 1) == size(D, 2))
    D = squareform(D);
  elseif size(D, 1) ~= size(D, 2)
    error('Nelson:statistics:dSquareValidDistanceVector', 'D must be square or a valid distance vector.');
  end
  if nin == 2
    p = validatePRequestedLocal(inputP, size(D, 1));
  end
end
%=============================================================================
function p = validatePRequestedLocal(p, n)
  if ~(isnumeric(p) && isreal(p) && isscalar(p) && isfinite(p) ...
      && floor(p) == p && p >= 1 && p <= n)
    error('Nelson:statistics:pIntegerScalarBetween1', 'p must be an integer scalar between 1 and the number of points.');
  end
  p = double(p);
end
%=============================================================================
function D = dissimilarityMatrixLocal(D)
  if isempty(D)
    return
  end
  if isSimilarityLocal(D)
    D = sqrt(max(0, 1 - D));
    D(1:size(D, 1) + 1:end) = 0;
    return
  end
  if isUpperTriangularDissimilarityLocal(D)
    D = D + D';
  end
  validateDissimilarityLocal(D);
end
%=============================================================================
function tf = isSimilarityLocal(D)
  diagonal = diag(D);
  offDiagonal = D - diag(diagonal);
  tf = all(abs(diagonal - 1) <= 100 * eps) ...
    && all(offDiagonal(:) <= 1 + 100 * eps) ...
    && isSymmetricLocal(D);
end
%=============================================================================
function tf = isUpperTriangularDissimilarityLocal(D)
  diagonal = diag(D);
  lower = tril(D, -1);
  upper = triu(D, 1);
  tf = all(abs(diagonal) <= 100 * eps) ...
    && all(abs(lower(:)) <= 100 * eps) ...
    && any(upper(:) > 0);
end
%=============================================================================
function validateDissimilarityLocal(D)
  if ~isSymmetricLocal(D)
    error('Nelson:statistics:dSymmetricUpperTriangular', 'D must be symmetric or upper triangular.');
  end
  if any(abs(diag(D)) > 100 * eps)
    error('Nelson:statistics:dZerosDiagonal', 'D must have zeros on the diagonal.');
  end
  if any(D(:) < -100 * eps)
    error('Nelson:statistics:dContainNonnegativeDissimilarities', 'D must contain nonnegative dissimilarities.');
  end
end
%=============================================================================
function tf = isSymmetricLocal(D)
  tolerance = 100 * eps(max(1, max(abs(D(:)))));
  tf = all(all(abs(D - D') <= tolerance));
end
%=============================================================================
function B = gramMatrixLocal(D)
  n = size(D, 1);
  D2 = D .^ 2;
  rowMean = mean(D2, 2);
  colMean = mean(D2, 1);
  totalMean = mean(D2(:));
  B = -0.5 * (D2 - repmat(rowMean, 1, n) - repmat(colMean, n, 1) + totalMean);
end
%=============================================================================
function positive = positiveEigenvaluesLocal(e)
  tolerance = max(size(e)) * eps(max(1, max(abs(e))));
  positive = e > tolerance;
end
%=============================================================================
function V = orientColumnsLocal(V)
  for k = 1:size(V, 2)
    [~, idx] = max(abs(V(:, k)));
    if V(idx, k) < 0
      V(:, k) = -V(:, k);
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function compactModel = compact(model)
  narginchk(1, 1);
  nargoutchk(0, 1);
  if isa(model, 'RegressionEnsemble') || isa(model, 'ClassificationEnsemble') ...
      || isa(model, 'ClassificationSVM') || isa(model, 'RegressionSVM')
    compactModel = model;
    return
  end
  error('Nelson:statistics:compactModelSupportedObject', 'Compact model is not supported for this object.');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [dCE, X] = cordexch(varargin)
  narginchk(2, Inf);
  nargoutchk(0, 2);
  [dCE, X] = rowexch(varargin{:});
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [rho, pval] = corr(X, varargin)
  narginchk(1, Inf);
  nargoutchk(0, 2);
  [Y, opts] = parseInputsLocal(X, convertStringToCharArgs(varargin));
  [X, Y] = validateInputsLocal(X, Y);
  if strcmp(opts.Rows, 'complete')
    [X, Y] = completeRowsLocal(X, Y);
  end
  if strcmp(opts.Type, 'spearman')
    X = rankColumnsLocal(X);
    Y = rankColumnsLocal(Y);
  end
  if strcmp(opts.Type, 'kendall')
    rho = pairwiseKendallLocal(X, Y, opts.Rows);
    n = pairwiseCountsLocal(X, Y, opts.Rows);
    pval = pvalueKendallLocal(rho, n, opts.Tail);
  else
    [rho, n] = pairwisePearsonLocal(X, Y, opts.Rows, opts.Weights);
    pval = pvaluePearsonLocal(rho, n, opts.Tail, ~isempty(opts.Weights));
  end
end
%=============================================================================
function [Y, opts] = parseInputsLocal(X, args)
  opts = struct('Type', 'pearson', 'Rows', 'all', 'Tail', 'both', 'Weights', []);
  Y = [];
  if ~isempty(args) && ~isTextScalarLocal(args{1})
    Y = args{1};
    args = args(2:end);
  end
  if isempty(Y)
    Y = X;
  end
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  for k = 1:2:length(args)
    if ~isTextScalarLocal(args{k})
      error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Name');
    end
    name = lower(char(args{k}));
    switch name
      case 'type'
        opts.Type = parseChoiceLocal(args{k + 1}, {'pearson', 'kendall', 'spearman'}, 'TYPE');
      case 'rows'
        opts.Rows = parseChoiceLocal(args{k + 1}, {'all', 'complete', 'pairwise'}, 'ROWS');
      case 'tail'
        opts.Tail = parseChoiceLocal(args{k + 1}, {'both', 'right', 'left'}, 'TAIL');
      case 'weights'
        opts.Weights = parseWeightsLocal(args{k + 1}, size(X, 1));
      otherwise
        error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
    end
  end
end
%=============================================================================
function [X, Y] = validateInputsLocal(X, Y)
  if ~(isnumeric(X) && isreal(X) && ~issparse(X) && ismatrix(X))
    error('Nelson:statistics:xRealNumericMatrix', '%s must be a real numeric matrix.', 'X');
  end
  if ~(isnumeric(Y) && isreal(Y) && ~issparse(Y) && ismatrix(Y))
    error('Nelson:statistics:yRealNumericMatrix', '%s must be a real numeric matrix.', 'Y');
  end
  if size(X, 1) ~= size(Y, 1)
    error('Nelson:statistics:xYSameNumberRows', '%s must have the same number of rows.', 'X and Y');
  end
  X = double(X);
  Y = double(Y);
end
%=============================================================================
function weights = parseWeightsLocal(value, n)
  if ~(isnumeric(value) && isreal(value) && isvector(value) && length(value) == n)
    error('Nelson:statistics:weightsNumericVectorOneValue', '%s must be a numeric vector with one value per observation.', 'Weights');
  end
  weights = double(value(:));
  if any(isnan(weights)) || any(weights < 0)
    error('Nelson:statistics:weightsContainNonnegativeFiniteValues', '%s must contain nonnegative finite values.', 'Weights');
  end
  if all(weights == 0)
    error('Nelson:validators:mustBePositive', '%s must be positive.', 'At least one weight');
  end
end
%=============================================================================
function [X, Y] = completeRowsLocal(X, Y)
  keep = all(~isnan(X), 2) & all(~isnan(Y), 2);
  X = X(keep, :);
  Y = Y(keep, :);
end
%=============================================================================
function R = rankColumnsLocal(X)
  R = NaN(size(X));
  for k = 1:size(X, 2)
    R(:, k) = tiedrank(X(:, k));
  end
end
%=============================================================================
function [rho, n] = pairwisePearsonLocal(X, Y, rowsMode, weights)
  if isempty(weights) && (~strcmp(rowsMode, 'pairwise') || (~any(isnan(X(:))) && ~any(isnan(Y(:)))))
    [rho, n] = pearsonMatrixLocal(X, Y);
    return
  end
  if ~isempty(weights) && (~strcmp(rowsMode, 'pairwise') || (~any(isnan(X(:))) && ~any(isnan(Y(:)))))
    [rho, n] = weightedPearsonMatrixLocal(X, Y, weights);
    return
  end
  nx = size(X, 2);
  ny = size(Y, 2);
  rho = NaN(nx, ny);
  n = zeros(nx, ny);
  for i = 1:nx
    for j = 1:ny
      keep = validRowsLocal(X(:, i), Y(:, j), rowsMode);
      xi = X(keep, i);
      yj = Y(keep, j);
      if isempty(weights)
        [rho(i, j), n(i, j)] = pearsonVectorLocal(xi, yj);
      else
        [rho(i, j), n(i, j)] = weightedPearsonVectorLocal(xi, yj, weights(keep));
      end
    end
  end
end
%=============================================================================
function [rho, n] = pearsonMatrixLocal(X, Y)
  n = size(X, 1) * ones(size(X, 2), size(Y, 2));
  if size(X, 1) < 2
    rho = NaN(size(X, 2), size(Y, 2));
    return
  end
  X = X - mean(X, 1);
  Y = Y - mean(Y, 1);
  sx = sqrt(sum(X .* X, 1));
  sy = sqrt(sum(Y .* Y, 1));
  rho = (X' * Y) ./ (sx' * sy);
  rho((sx' * sy) == 0) = NaN;
end
%=============================================================================
function [rho, n] = weightedPearsonMatrixLocal(X, Y, weights)
  n = size(X, 1) * ones(size(X, 2), size(Y, 2));
  if size(X, 1) < 2 || any(isnan(X(:))) || any(isnan(Y(:)))
    rho = NaN(size(X, 2), size(Y, 2));
    return
  end
  w = weights(:);
  sw = sum(w);
  mx = sum(X .* w, 1) / sw;
  my = sum(Y .* w, 1) / sw;
  X = X - mx;
  Y = Y - my;
  sx = sqrt(sum((X .* X) .* w, 1));
  sy = sqrt(sum((Y .* Y) .* w, 1));
  rho = (X' * (Y .* w)) ./ (sx' * sy);
  rho((sx' * sy) == 0) = NaN;
end
%=============================================================================
function keep = validRowsLocal(x, y, rowsMode)
  switch rowsMode
    case 'all'
      keep = true(size(x));
    otherwise
      keep = ~isnan(x) & ~isnan(y);
  end
end
%=============================================================================
function [r, n] = pearsonVectorLocal(x, y)
  n = length(x);
  if n < 2 || any(isnan(x)) || any(isnan(y))
    r = NaN;
    return
  end
  x = x - mean(x);
  y = y - mean(y);
  den = sqrt(sum(x .* x) * sum(y .* y));
  if den == 0
    r = NaN;
  else
    r = sum(x .* y) / den;
  end
end
%=============================================================================
function [r, n] = weightedPearsonVectorLocal(x, y, w)
  keep = ~isnan(x) & ~isnan(y) & (w > 0);
  x = x(keep);
  y = y(keep);
  w = w(keep);
  n = length(x);
  if n < 2
    r = NaN;
    return
  end
  sw = sum(w);
  mx = sum(w .* x) / sw;
  my = sum(w .* y) / sw;
  x = x - mx;
  y = y - my;
  den = sqrt(sum(w .* x .* x) * sum(w .* y .* y));
  if den == 0
    r = NaN;
  else
    r = sum(w .* x .* y) / den;
  end
end
%=============================================================================
function rho = pairwiseKendallLocal(X, Y, rowsMode)
  nx = size(X, 2);
  ny = size(Y, 2);
  rho = NaN(nx, ny);
  for i = 1:nx
    for j = 1:ny
      keep = validRowsLocal(X(:, i), Y(:, j), rowsMode);
      rho(i, j) = kendallVectorLocal(X(keep, i), Y(keep, j));
    end
  end
end
%=============================================================================
function r = kendallVectorLocal(x, y)
  if length(x) < 2 || any(isnan(x)) || any(isnan(y))
    r = NaN;
    return
  end
  concordant = 0;
  discordant = 0;
  tx = 0;
  ty = 0;
  n = length(x);
  for a = 1:n - 1
    dx = x(a) - x(a + 1:end);
    dy = y(a) - y(a + 1:end);
    sx = sign(dx);
    sy = sign(dy);
    concordant = concordant + sum(sx .* sy > 0);
    discordant = discordant + sum(sx .* sy < 0);
    tx = tx + sum(sx == 0 & sy ~= 0);
    ty = ty + sum(sy == 0 & sx ~= 0);
  end
  den = sqrt((concordant + discordant + tx) * (concordant + discordant + ty));
  if den == 0
    r = NaN;
  else
    r = (concordant - discordant) / den;
  end
end
%=============================================================================
function n = pairwiseCountsLocal(X, Y, rowsMode)
  nx = size(X, 2);
  ny = size(Y, 2);
  n = zeros(nx, ny);
  for i = 1:nx
    for j = 1:ny
      n(i, j) = sum(validRowsLocal(X(:, i), Y(:, j), rowsMode));
    end
  end
end
%=============================================================================
function p = pvaluePearsonLocal(r, n, tail, hasWeights)
  p = NaN(size(r));
  if hasWeights
    return
  end
  valid = ~isnan(r) & n > 2 & abs(r) < 1;
  t = r(valid) .* sqrt((n(valid) - 2) ./ max(1 - r(valid) .^ 2, 0));
  p(valid) = tailProbabilityFromTLocal(t, n(valid) - 2, tail);
  perfect = ~isnan(r) & n > 2 & abs(r) == 1;
  if any(perfect(:))
    p(perfect) = perfectCorrelationPValueLocal(r(perfect), tail);
  end
end
%=============================================================================
function p = pvalueKendallLocal(r, n, tail)
  p = NaN(size(r));
  valid = ~isnan(r) & n > 2;
  sigma = sqrt(2 * (2 * n(valid) + 5) ./ (9 * n(valid) .* (n(valid) - 1)));
  z = r(valid) ./ sigma;
  p(valid) = tailProbabilityFromNormalLocal(z, tail);
end
%=============================================================================
function p = tailProbabilityFromTLocal(t, v, tail)
  switch tail
    case 'right'
      p = 1 - tcdf(t, v);
    case 'left'
      p = tcdf(t, v);
    otherwise
      p = 2 * min(tcdf(t, v), 1 - tcdf(t, v));
  end
end
%=============================================================================
function p = perfectCorrelationPValueLocal(r, tail)
  p = zeros(size(r));
  switch tail
    case 'right'
      p(r < 0) = 1;
    case 'left'
      p(r > 0) = 1;
  end
end
%=============================================================================
function p = tailProbabilityFromNormalLocal(z, tail)
  switch tail
    case 'right'
      p = 1 - normcdf(z, 0, 1);
    case 'left'
      p = normcdf(z, 0, 1);
    otherwise
      p = 2 * min(normcdf(z, 0, 1), 1 - normcdf(z, 0, 1));
  end
end
%=============================================================================
function value = parseChoiceLocal(value, choices, name)
  if ~isTextScalarLocal(value)
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', name);
  end
  text = lower(char(value));
  matches = choices(startsWith(choices, text));
  if length(matches) ~= 1
    error('Nelson:statistics:invalidValue:valueHasUnsupportedValue', '%s has an unsupported value.', name);
  end
  value = matches{1};
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function C = cov(varargin)
  % C = cov(A)
  % C = cov(A, w)
  % C = cov(A, B)
  % C = cov(A, B, w)
  if nargin < 1
    error('Nelson:notEnoughInputs', 'Not enough input arguments.');
  end
  if nargin > 3
    error('Nelson:tooManyInputs', 'Too many input arguments.');
  end
  w = 0;
  if nargin == 1
    A = varargin{1};
    if isempty(A)
      C = NaN;
    elseif isvector(A)
      nobs = length(A);
      r = 1 / (nobs - 1);
      % use |mean|^2 so that the variance of complex data is real and >= 0
      C = r * (norm(A) ^ 2 - nobs * abs(mean(A)) ^ 2);
    else
      nobs = size(A, 'r');
      m = nobs;
      if nobs > 1
        nobs = nobs - 1;
      end
      ac = A - sum(A, 1) ./ m;
      C = (ac' * ac) ./ nobs;
      if isscalar(C)
        C = real(C);
      end
    end
    return
  end
  if nargin == 2
    A = varargin{1};
    wOrB = varargin{2};
    if isscalar(A) && isscalar(wOrB)
      if wOrB == 0 || wOrB == 1
        C = 0;
      else
        C = zeros(2, 2);
      end
      return
    else
      B = wOrB;
    end
  end
  if nargin == 3
    A = varargin{1};
    B = varargin{2};
    w = varargin{3};
  end

  if ~(w == 0 || w == 1)
    error('Nelson:statistics:invalidValue:wrongValueNArgument01', 'Wrong value for #%d argument: 0 or 1 expected.', 3);
  end

  A = A(:);
  B = B(:);
  if (length(A) ~= length(B))
    error('Nelson:statistics:arguments12SameLength', 'arguments #%d and #%d must have same length.', 1, 2);
  end
  nobs = length(A);
  if w == 1
    r = 1 / nobs;
  else
    r = 1 / (nobs - 1);
  end
  mA = mean(A);
  mB = mean(B);
  C = r * [norm(A) ^ 2 - nobs * abs(mA) ^ 2, A' * B - nobs * conj(mA) * mB; 0, norm(B) ^ 2 - nobs * abs(mB) ^ 2];
  C(2, 1) = conj(C(1, 2));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = crosstab(varargin)
  narginchk(1, Inf);
  nargoutchk(0, 4);
  [inputs, opts] = parseCrosstabInputsLocal(varargin);
  [codes, labelColumns, labels, keep] = crosstabCodesLocal(inputs, opts.IncludeMissingGroups);
  counts = crosstabCountsLocal(codes, labelColumns, keep);
  varargout{1} = formatCrosstabOutputLocal(counts, labels, opts.OutputFormat);
  if nargout > 1
    varargout{2} = chiSquareLocal(counts);
  end
  if nargout > 2
    varargout{3} = chiSquarePValueLocal(varargout{2}, counts);
  end
  if nargout > 3
    varargout{4} = labels;
  end
end
%=============================================================================
function [inputs, opts] = parseCrosstabInputsLocal(args)
  opts = struct('IncludeMissingGroups', false, 'OutputFormat', 'matrix');
  firstName = findFirstNameLocal(args);
  dataArgs = args(1:firstName - 1);
  if isempty(dataArgs)
    error('Nelson:statistics:leastOneGroupingVariableRequired', 'At least one %s is required.', 'grouping variable');
  end
  if length(dataArgs) == 1 && istable(dataArgs{1})
    dataArgs = tableVariablesLocal(dataArgs{1});
  end
  inputs = dataArgs;
  k = firstName;
  while k <= length(args)
    if k == length(args)
      error('Nelson:statistics:nameValueArgumentFollowedValue', 'Name-value argument must be followed by a value.');
    end
    name = lower(char(args{k}));
    switch name
      case 'includemissinggroups'
        opts.IncludeMissingGroups = logical(args{k + 1});
      case 'outputformat'
        opts.OutputFormat = lower(char(args{k + 1}));
      otherwise
        error('Nelson:statistics:unknownOption', 'Unknown option.');
    end
    k = k + 2;
  end
end
%=============================================================================
function idx = findFirstNameLocal(args)
  names = {'IncludeMissingGroups', 'OutputFormat'};
  idx = length(args) + 1;
  for k = 1:length(args)
    if ischar(args{k}) || (isstring(args{k}) && isscalar(args{k}))
      text = char(args{k});
      if any(strcmpi(text, names))
        idx = k;
        return
      end
    end
  end
end
%=============================================================================
function inputs = tableVariablesLocal(T)
  st = struct(T);
  names = st.Properties.VariableNames;
  inputs = cell(1, length(names));
  for k = 1:length(names)
    inputs{k} = T.(names{k});
  end
end
%=============================================================================
function [codes, labelColumns, labels, keep] = crosstabCodesLocal(inputs, includeMissing)
  n = numel(inputs{1});
  codes = zeros(n, length(inputs));
  valuesColumns = cell(1, length(inputs));
  labelColumns = cell(1, length(inputs));
  keep = true(n, 1);
  for dim = 1:length(inputs)
    if numel(inputs{dim}) ~= n
      error('Nelson:statistics:allGroupingVariablesSameNumber', 'All grouping variables must have the same number of elements.');
    end
    values = crosstabValuesLocal(inputs{dim});
    valuesColumns{dim} = values;
    missing = missingMaskLocal(inputs{dim});
    if ~includeMissing
      keep = keep & ~missing;
    end
  end
  for dim = 1:length(inputs)
    values = valuesColumns{dim};
    [groups, ic] = groupsAndCodesLocal(values, keep);
    labelColumns{dim} = labelsFromGroupsLocal(groups);
    if isempty(groups)
      codes(:, dim) = 0;
    else
      codes(keep, dim) = ic(:);
    end
  end
  labels = labelsMatrixLocal(labelColumns);
end
%=============================================================================
function labels = labelsMatrixLocal(labelColumns)
  maxLen = 0;
  for k = 1:length(labelColumns)
    maxLen = max(maxLen, length(labelColumns{k}));
  end
  labels = cell(maxLen, length(labelColumns));
  for k = 1:length(labelColumns)
    labels(1:length(labelColumns{k}), k) = labelColumns{k};
  end
end
%=============================================================================
function values = crosstabValuesLocal(x)
  if iscategorical(x)
    values = cellstr(x(:));
  elseif ischar(x)
    values = cellstr(x);
  elseif isstring(x)
    values = cellstr(x(:));
  elseif iscellstr(x)
    values = x(:);
  elseif isnumeric(x) || islogical(x)
    values = x(:);
  else
    error('Nelson:statistics:groupingVariablesVectorsTextArrays', 'Grouping variables must be vectors or text arrays.');
  end
end
%=============================================================================
function mask = missingMaskLocal(x)
  if isnumeric(x)
    mask = isnan(x(:));
  elseif iscategorical(x)
    mask = strcmp(cellstr(x(:)), '<undefined>');
  else
    mask = false(numel(x), 1);
  end
end
%=============================================================================
function [groups, ic] = groupsAndCodesLocal(values, keep)
  if isnumeric(values) || islogical(values)
    [groups, ~, ic] = unique(values(keep));
  else
    [groups, ~, ic] = unique(values(keep), 'stable');
  end
end
%=============================================================================
function labels = labelsFromGroupsLocal(groups)
  if iscell(groups)
    labels = groups(:);
  else
    labels = cell(length(groups), 1);
    for k = 1:length(groups)
      labels{k} = mat2str(groups(k));
    end
  end
end
%=============================================================================
function counts = crosstabCountsLocal(codes, labelColumns, keep)
  dims = zeros(1, size(codes, 2));
  for k = 1:size(codes, 2)
    dims(k) = length(labelColumns{k});
  end
  if length(dims) == 1
    dims = [dims, 1];
  end
  counts = zeros(dims);
  keptRows = find(keep);
  if isempty(keptRows)
    return
  end
  linear = ones(length(keptRows), 1);
  stride = 1;
  for dim = 1:size(codes, 2)
    linear = linear + (codes(keptRows, dim) - 1) * stride;
    stride = stride * dims(dim);
  end
  linear = sort(linear);
  starts = [1; find(diff(linear) ~= 0) + 1];
  stops = [starts(2:end) - 1; length(linear)];
  for k = 1:length(starts)
    counts(linear(starts(k))) = stops(k) - starts(k) + 1;
  end
end
%=============================================================================
function out = formatCrosstabOutputLocal(counts, labels, format)
  switch format
    case 'matrix'
      out = counts;
    case 'table'
      out = crosstabTableLocal(counts, labels);
    case {'stacked-table', 'stacked'}
      out = crosstabStackedLocal(counts, labels);
    otherwise
      error('Nelson:statistics:unsupportedOutputFormat', 'Unsupported %s.', 'output format');
  end
end
%=============================================================================
function T = crosstabTableLocal(counts, labels)
  if ndims(counts) ~= 2
    error('Nelson:statistics:tableOutputFormatSupportedTwo', 'Table output format is supported for two grouping variables.');
  end
  T = array2table(counts);
  rowValues = labels(:, 1);
  T.Group1 = rowValues;
  T = movevars(T, 'Group1', 'Before', 1);
end
%=============================================================================
function T = crosstabStackedLocal(counts, labels)
  n = numel(counts);
  columns = cell(1, ndims(counts));
  [columns{:}] = ind2sub(size(counts), (1:n)');
  values = cell(1, ndims(counts));
  for dim = 1:ndims(counts)
    values{dim} = labels(columns{dim}, dim);
  end
  T = table(values{:}, counts(:), 'VariableNames', stackedNamesLocal(ndims(counts)));
end
%=============================================================================
function names = stackedNamesLocal(n)
  names = cell(1, n + 1);
  for k = 1:n
    names{k} = ['Group', int2str(k)];
  end
  names{end} = 'Count';
end
%=============================================================================
function value = chiSquareLocal(counts)
  if isempty(counts) || sum(counts(:)) == 0
    value = NaN;
    return
  end
  if ndims(counts) ~= 2
    value = NaN;
    return
  end
  total = sum(counts(:));
  expected = sum(counts, 2) * sum(counts, 1) / total;
  valid = expected > 0;
  value = sum(((counts(valid) - expected(valid)) .^ 2) ./ expected(valid));
end
%=============================================================================
function p = chiSquarePValueLocal(chi2, counts)
  if isnan(chi2) || ndims(counts) ~= 2
    p = NaN;
    return
  end
  df = (size(counts, 1) - 1) * (size(counts, 2) - 1);
  p = gammaincUpperLocal(chi2 / 2, df / 2);
end
%=============================================================================
function q = gammaincUpperLocal(x, a)
  if x < 0 || a <= 0
    q = NaN;
  elseif x == 0
    q = 1;
  elseif x < a + 1
    q = 1 - gammaincSeriesLocal(x, a);
  else
    q = gammaincFractionLocal(x, a);
  end
end
%=============================================================================
function p = gammaincSeriesLocal(x, a)
  ap = a;
  del = 1 / a;
  sumValue = del;
  for k = 1:200
    ap = ap + 1;
    del = del * x / ap;
    sumValue = sumValue + del;
    if abs(del) < abs(sumValue) * eps
      break
    end
  end
  p = sumValue * exp(-x + a * log(x) - gammaln(a));
end
%=============================================================================
function q = gammaincFractionLocal(x, a)
  fpmin = realmin / eps;
  b = x + 1 - a;
  c = 1 / fpmin;
  d = 1 / max(b, fpmin);
  h = d;
  for k = 1:200
    an = -k * (k - a);
    b = b + 2;
    d = an * d + b;
    if abs(d) < fpmin
      d = fpmin;
    end
    c = b + an / c;
    if abs(c) < fpmin
      c = fpmin;
    end
    d = 1 / d;
    del = d * c;
    h = h * del;
    if abs(del - 1) < eps
      break
    end
  end
  q = exp(-x + a * log(x) - gammaln(a)) * h;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [dCE2, X] = daugment(varargin)
  narginchk(2, Inf);
  nargoutchk(0, 2);

  dCE = varargin{1};
  mruns = positiveInteger(varargin{2}, sprintf(_('%s must be a positive integer scalar.'), 'MRUNS'));
  if ~isnumeric(dCE) || ndims(dCE) ~= 2 || isempty(dCE)
    error('Nelson:statistics:DCENonemptyNumericMatrix', '%s must be a nonempty numeric matrix.', 'DCE');
  end
  modelspec = 'linear';
  args = varargin(3:end);
  if ~isempty(args) && ~(isTextScalar(args{1}) && isOptionName(args{1}))
    modelspec = args{1};
    args = args(2:end);
  end
  [candArgs, exchArgs] = splitOptions(args);
  [dC, C] = candgen(size(dCE, 2), modelspec, candArgs{:});
  fixed = x2fx(dCE, modelspec);
  r = candexch(C, mruns, 'FixedRows', fixed, exchArgs{:});
  dCE2 = [dCE; dC(r, :)];
  X = x2fx(dCE2, modelspec);
end
%=============================================================================
function [candArgs, exchArgs] = splitOptions(args)
  candArgs = {};
  exchArgs = {};
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  for k = 1:2:length(args)
    name = optionName(args{k});
    if strcmp(name, 'bounds')
      candArgs = [candArgs args(k:k + 1)];
    else
      exchArgs = [exchArgs args(k:k + 1)];
    end
  end
end
%=============================================================================
function tf = isOptionName(value)
  tf = false;
  try
    optionName(value);
    tf = true;
  catch
    tf = false;
  end
end
%=============================================================================
function name = optionName(value)
  if ~isTextScalar(value)
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
  text = lower(char(value));
  names = {'bounds', 'avoidduplicates', 'display', 'initialdesign', 'maxiterations', 'options', 'fixedrows', 'numtries'};
  matches = {};
  for k = 1:length(names)
    if strncmp(names{k}, text, length(text))
      matches{end + 1} = names{k};
    end
  end
  if isempty(matches)
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
  if length(matches) > 1
    error('Nelson:statistics:ambiguousNameValue', 'Ambiguous name-value argument name.');
  end
  name = matches{1};
end
%=============================================================================
function value = positiveInteger(value, message)
  if ~isscalar(value) || value <= 0 || floor(value) ~= value
    error('Nelson:statistics:mustBePositiveInteger', message);
  end
end
%=============================================================================
function tf = isTextScalar(value)
  tf = ischar(value) || isStringScalar(value);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = dendrogram(varargin)
  narginchk(1, Inf);
  nargoutchk(0, 3);
  args = convertStringToCharArgs(varargin);
  [parent, args] = parseParentLocal(args);
  [Z, p, args] = parseTreeLocal(args);
  n = size(Z, 1) + 1;
  opts = parseOptionsLocal(args, n, max(Z(:, 3)));
  if ~isempty(opts.Parent)
    parent = opts.Parent;
  end
  nodes = treeNodesLocal(Z);
  minRank = nodeRanksLocal(nodes, n, opts.Reorder);
  displayNodes = displayNodesLocal(nodes, n, p, minRank);
  stop = false(1, 2 * n - 1);
  stop(displayNodes) = true;
  leafNodes = displayOrderLocal(2 * n - 1, nodes, n, stop, minRank);
  positions = zeros(1, 2 * n - 1);
  positions(leafNodes) = 1:numel(leafNodes);
  [H, leafNodes] = drawDendrogramLocal(parent, nodes, n, stop, minRank, positions, opts);
  T = leafAssignmentsLocal(leafNodes, nodes, n);
  outperm = outputPermutationLocal(leafNodes);
  if nargout >= 1
    varargout{1} = H;
  end
  if nargout >= 2
    varargout{2} = T;
  end
  if nargout >= 3
    varargout{3} = outperm;
  end
end
%=============================================================================
function [parent, args] = parseParentLocal(args)
  parent = [];
  if ~isempty(args) && isscalar(args{1}) && (isgraphics(args{1}, 'axes') || isgraphics(args{1}, 'hggroup'))
    parent = args{1};
    args = args(2:end);
  end
end
%=============================================================================
function [Z, p, args] = parseTreeLocal(args)
  if isempty(args)
    error('Nelson:notEnoughInputs', 'Not enough input arguments.');
  end
  Z = args{1};
  if ~(isnumeric(Z) && isreal(Z) && ndims(Z) == 2 && size(Z, 2) == 3 && size(Z, 1) >= 1)
    error('Nelson:statistics:treeRealNumericMatrixThree', 'Tree must be a real numeric matrix with three columns.');
  end
  Z = double(Z);
  if any(~isfinite(Z(:))) || any(Z(:, 3) < 0)
    error('Nelson:statistics:treeContainFiniteNonnegativeDistances', 'Tree must contain finite nonnegative distances.');
  end
  validateTreeIdsLocal(Z);
  args = args(2:end);
  p = 30;
  if ~isempty(args) && isnumeric(args{1}) && isscalar(args{1}) && isreal(args{1})
    p = validatePValueLocal(args{1});
    args = args(2:end);
  end
end
%=============================================================================
function validateTreeIdsLocal(Z)
  n = size(Z, 1) + 1;
  for k = 1:size(Z, 1)
    ids = Z(k, 1:2);
    if any(floor(ids) ~= ids) || any(ids < 1) || any(ids >= n + k)
      error('Nelson:statistics:treeContainsInvalidNodeIdentifiers', 'Tree contains invalid node identifiers.');
    end
  end
end
%=============================================================================
function p = validatePValueLocal(p)
  if ~(isfinite(p) && p >= 0 && floor(p) == p)
    error('Nelson:statistics:pNonnegativeIntegerScalar', '%s must be a nonnegative integer scalar.', 'P');
  end
  p = double(p);
end
%=============================================================================
function opts = parseOptionsLocal(args, n, maxHeight)
  opts = struct('Orientation', 'top', 'Labels', [], 'Reorder', [], ...
    'CheckCrossing', true, 'ColorThreshold', [], 'ShowCut', false, ...
    'ShowMarkers', false, 'ClusterIndices', [], 'Parent', []);
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  for k = 1:2:length(args)
    name = optionNameLocal(args{k});
    value = args{k + 1};
    switch name
      case 'orientation'
        opts.Orientation = orientationLocal(value);
      case 'labels'
        opts.Labels = labelsLocal(value, n);
      case 'reorder'
        opts.Reorder = reorderLocal(value, n);
      case 'checkcrossing'
        opts.CheckCrossing = logicalScalarLocal(value, 'CheckCrossing');
      case 'colorthreshold'
        opts.ColorThreshold = thresholdLocal(value, maxHeight);
      case 'showcut'
        opts.ShowCut = logicalScalarLocal(value, 'ShowCut');
      case 'showmarkers'
        opts.ShowMarkers = logicalScalarLocal(value, 'ShowMarkers');
      case 'clusterindices'
        opts.ClusterIndices = clusterIndicesLocal(value, n);
      case 'parent'
        opts.Parent = parentLocal(value);
    end
  end
end
%=============================================================================
function name = optionNameLocal(value)
  if ~(ischar(value) || isStringScalar(value))
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Name');
  end
  text = lower(char(value));
  names = {'reorder', 'checkcrossing', 'clusterindices', 'colorthreshold', ...
    'showcut', 'showmarkers', 'orientation', 'labels', 'parent'};
  hits = {};
  for k = 1:numel(names)
    if strncmp(names{k}, text, length(text))
      hits{end + 1} = names{k};
    end
  end
  if isempty(hits)
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
  if numel(hits) > 1
    error('Nelson:statistics:ambiguousNameValue', 'Ambiguous name-value argument name.');
  end
  name = hits{1};
end
%=============================================================================
function value = orientationLocal(value)
  if ~(ischar(value) || isStringScalar(value))
    error('Nelson:statistics:orientationTopBottomLeftRight', 'Orientation must be ''top'', ''bottom'', ''left'', or ''right''.');
  end
  text = lower(char(value));
  choices = {'top', 'bottom', 'left', 'right'};
  hit = strcmp(text, choices);
  if ~any(hit)
    error('Nelson:statistics:orientationTopBottomLeftRight', 'Orientation must be ''top'', ''bottom'', ''left'', or ''right''.');
  end
  value = choices{hit};
end
%=============================================================================
function labels = labelsLocal(value, n)
  if iscellstr(value)
    labels = value(:);
  elseif isstring(value)
    labels = cellstr(value(:));
  elseif ischar(value)
    labels = cellstr(value);
  else
    error('Nelson:statistics:labelsCharacterStringCellString', 'Labels must be character, string, or cell string values.');
  end
  if numel(labels) ~= n
    error('Nelson:statistics:labelsContainOneValueObservation', 'Labels must contain one value per observation.');
  end
end
%=============================================================================
function reorder = reorderLocal(value, n)
  if ~(isnumeric(value) && isreal(value) && isvector(value) && numel(value) == n)
    error('Nelson:statistics:reorderPermutationVector', 'Reorder must be a permutation vector.');
  end
  reorder = double(value(:)');
  if any(~isfinite(reorder)) || any(floor(reorder) ~= reorder) || ~isequal(sort(reorder), 1:n)
    error('Nelson:statistics:reorderPermutationVector', 'Reorder must be a permutation vector.');
  end
end
%=============================================================================
function tf = logicalScalarLocal(value, name)
  if islogical(value) && isscalar(value)
    tf = value ~= 0;
  elseif isnumeric(value) && isscalar(value) && (value == 0 || value == 1)
    tf = value ~= 0;
  else
    error('Nelson:validators:mustBeLogicalScalar', '%s must be a logical scalar.', name);
  end
end
%=============================================================================
function value = thresholdLocal(value, maxHeight)
  if (ischar(value) || isStringScalar(value)) && strcmpi(char(value), 'default')
    value = 0.7 * maxHeight;
  elseif isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value)
    value = double(value);
    if value <= 0 || value >= maxHeight
      value = [];
    end
  else
    error('Nelson:statistics:colorThresholdDefaultFiniteNumericScalar', 'ColorThreshold must be ''default'' or a finite numeric scalar.');
  end
end
%=============================================================================
function values = clusterIndicesLocal(value, n)
  if ~(isnumeric(value) && isreal(value) && isvector(value) && numel(value) == n)
    error('Nelson:statistics:clusterIndicesContainOneIntegerObservation', 'ClusterIndices must contain one integer per observation.');
  end
  values = double(value(:));
  if any(~isfinite(values)) || any(floor(values) ~= values) || any(values < 1)
    error('Nelson:statistics:clusterIndicesContainPositiveIntegerValues', 'ClusterIndices must contain positive integer values.');
  end
end
%=============================================================================
function parent = parentLocal(value)
  if ~(isscalar(value) && (isgraphics(value, 'axes') || isgraphics(value, 'hggroup')))
    error('Nelson:statistics:parentAxesHggroupObject', 'Parent must be an axes or hggroup object.');
  end
  parent = value;
end
%=============================================================================
function nodes = treeNodesLocal(Z)
  n = size(Z, 1) + 1;
  count = 2 * n - 1;
  nodes.Left = zeros(1, count);
  nodes.Right = zeros(1, count);
  nodes.Height = zeros(1, count);
  nodes.Left(n + (1:n - 1)) = Z(:, 1)';
  nodes.Right(n + (1:n - 1)) = Z(:, 2)';
  nodes.Height(n + (1:n - 1)) = Z(:, 3)';
end
%=============================================================================
function minRank = nodeRanksLocal(nodes, n, reorder)
  if isempty(reorder)
    rank = 1:n;
  else
    rank = zeros(1, n);
    rank(reorder) = 1:n;
  end
  minRank = zeros(1, 2 * n - 1);
  minRank(1:n) = rank;
  for node = n + 1:2 * n - 1
    minRank(node) = min(minRank(nodes.Left(node)), minRank(nodes.Right(node)));
  end
end
%=============================================================================
function displayNodes = displayNodesLocal(nodes, n, p, minRank)
  root = 2 * n - 1;
  if p == 0 || n <= p
    target = n;
  else
    target = min(max(p, 1), n);
  end
  displayNodes = root;
  while numel(displayNodes) < target
    internal = displayNodes(displayNodes > n);
    if isempty(internal)
      break
    end
    [~, which] = max(nodes.Height(internal));
    node = internal(which);
    location = find(displayNodes == node, 1);
    kids = orderedChildrenLocal(node, nodes, minRank);
    displayNodes = [displayNodes(1:location - 1), kids, displayNodes(location + 1:end)];
  end
end
%=============================================================================
function kids = orderedChildrenLocal(node, nodes, minRank)
  kids = [nodes.Left(node), nodes.Right(node)];
  if minRank(kids(2)) < minRank(kids(1))
    kids = kids([2 1]);
  end
end
%=============================================================================
function order = displayOrderLocal(node, nodes, n, stop, minRank)
  if node <= n || stop(node)
    order = node;
  else
    kids = orderedChildrenLocal(node, nodes, minRank);
    order = [displayOrderLocal(kids(1), nodes, n, stop, minRank), ...
      displayOrderLocal(kids(2), nodes, n, stop, minRank)];
  end
end
%=============================================================================
function [H, leafNodes] = drawDendrogramLocal(parent, nodes, n, stop, minRank, positions, opts)
  if isempty(parent)
    parent = newplot();
  elseif isgraphics(parent, 'axes')
    parent = newplot(parent);
  end
  [H, leafNodes] = drawNodeLocal(parent, 2 * n - 1, nodes, n, stop, minRank, positions, opts);
  if opts.ShowMarkers
    H = [H; drawMarkersLocal(parent, numel(leafNodes), opts)];
  end
  if opts.ShowCut && ~isempty(opts.ColorThreshold)
    H = [H; drawCutLocal(parent, numel(leafNodes), opts)];
  end
  decorateAxesLocal(parent, nodes, leafNodes, n, opts);
end
%=============================================================================
function [H, leafNodes, x, y] = drawNodeLocal(parent, node, nodes, n, stop, minRank, positions, opts)
  if node <= n || stop(node)
    H = [];
    leafNodes = node;
    x = positions(node);
    y = 0;
    return
  end
  kids = orderedChildrenLocal(node, nodes, minRank);
  [HL, leavesL, xL, yL] = drawNodeLocal(parent, kids(1), nodes, n, stop, minRank, positions, opts);
  [HR, leavesR, xR, yR] = drawNodeLocal(parent, kids(2), nodes, n, stop, minRank, positions, opts);
  [xd, yd] = orientDataLocal([xL xL xR xR], [yL nodes.Height(node) nodes.Height(node) yR], opts);
  h = line(parent, xd, yd, 'Color', [0 0.4470 0.7410], 'LineWidth', 0.5);
  h.UserData = struct('Node', node, 'Children', kids, 'Height', nodes.Height(node));
  H = [HL; HR; h];
  leafNodes = [leavesL leavesR];
  x = (xL + xR) / 2;
  y = nodes.Height(node);
end
%=============================================================================
function h = drawMarkersLocal(parent, count, opts)
  [x, y] = orientDataLocal(1:count, zeros(1, count), opts);
  h = line(parent, x, y, 'LineStyle', 'none', 'Marker', 'o', ...
    'MarkerFaceColor', 'none', 'MarkerEdgeColor', [0 0 0]);
end
%=============================================================================
function h = drawCutLocal(parent, count, opts)
  t = opts.ColorThreshold;
  [x, y] = orientDataLocal([0.5 count + 0.5], [t t], opts);
  h = line(parent, x, y, 'LineStyle', '--', 'Color', [0.4 0.4 0.4]);
end
%=============================================================================
function [x, y] = orientDataLocal(x0, y0, opts)
  switch opts.Orientation
    case 'top'
      x = x0; y = y0;
    case 'bottom'
      x = x0; y = -y0;
    case 'left'
      x = y0; y = x0;
    case 'right'
      x = -y0; y = x0;
  end
end
%=============================================================================
function decorateAxesLocal(parent, nodes, leafNodes, n, opts)
  ax = parent;
  if isgraphics(parent, 'hggroup')
    ax = ancestor(parent, 'axes');
  end
  labels = tickLabelsLocal(leafNodes, n, opts.Labels);
  count = numel(leafNodes);
  maxHeight = max(nodes.Height);
  if any(strcmp(opts.Orientation, {'top', 'bottom'}))
    ax.XTick = 1:count;
    ax.XTickLabel = labels;
    xlim(ax, [0.5 count + 0.5]);
    ylim(ax, verticalLimitsLocal(maxHeight, opts.Orientation));
  else
    ax.YTick = 1:count;
    ax.YTickLabel = labels;
    ylim(ax, [0.5 count + 0.5]);
    xlim(ax, horizontalLimitsLocal(maxHeight, opts.Orientation));
  end
end
%=============================================================================
function labels = tickLabelsLocal(leafNodes, n, inputLabels)
  labels = cell(numel(leafNodes), 1);
  for k = 1:numel(leafNodes)
    node = leafNodes(k);
    if node <= n
      if isempty(inputLabels)
        labels{k} = num2str(node);
      else
        labels{k} = inputLabels{node};
      end
    else
      labels{k} = '';
    end
  end
end
%=============================================================================
function limits = verticalLimitsLocal(maxHeight, orientation)
  pad = max(maxHeight * 0.05, eps);
  if strcmp(orientation, 'bottom')
    limits = [-(maxHeight + pad), pad];
  else
    limits = [-pad, maxHeight + pad];
  end
end
%=============================================================================
function limits = horizontalLimitsLocal(maxHeight, orientation)
  pad = max(maxHeight * 0.05, eps);
  if strcmp(orientation, 'right')
    limits = [-(maxHeight + pad), pad];
  else
    limits = [-pad, maxHeight + pad];
  end
end
%=============================================================================
function T = leafAssignmentsLocal(leafNodes, nodes, n)
  T = zeros(n, 1);
  for k = 1:numel(leafNodes)
    leaves = descendantsLocal(leafNodes(k), nodes, n);
    T(leaves) = k;
  end
end
%=============================================================================
function leaves = descendantsLocal(node, nodes, n)
  if node <= n
    leaves = node;
  else
    leaves = [descendantsLocal(nodes.Left(node), nodes, n), ...
      descendantsLocal(nodes.Right(node), nodes, n)];
  end
end
%=============================================================================
function outperm = outputPermutationLocal(leafNodes)
  if all(leafNodes <= numel(leafNodes))
    outperm = leafNodes;
  else
    outperm = 1:numel(leafNodes);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function D = dummyvar(group)
  narginchk(1, 1);
  nargoutchk(0, 1);
  if iscell(group) && ~(iscellstr(group) && isvector(group))
    D = dummyvarCellGroupLocal(group);
  else
    D = dummyvarOneGroupLocal(group);
  end
end
%=============================================================================
function D = dummyvarCellGroupLocal(group)
  if isempty(group)
    D = zeros(0, 0);
    return
  end
  D = [];
  n = [];
  for k = 1:numel(group)
    block = dummyvarOneGroupLocal(group{k});
    if isempty(n)
      n = size(block, 1);
    elseif size(block, 1) ~= n
      error('Nelson:statistics:groupingVariablesSameNumberRows', '%s must have the same number of rows.', 'Grouping variables');
    end
    D = [D, block];
  end
end
%=============================================================================
function D = dummyvarOneGroupLocal(group)
  if isnumeric(group) || islogical(group)
    D = dummyvarNumericLocal(group);
  elseif iscategorical(group)
    D = dummyvarCategoricalLocal(group);
  elseif isstring(group)
    D = dummyvarTextLocal(cellstr(group(:)));
  elseif ischar(group)
    D = dummyvarTextLocal(cellstr(group));
  elseif iscellstr(group)
    D = dummyvarTextLocal(group(:));
  else
    error('Nelson:statistics:GROUPGroupingVariable', '%s must be a grouping variable.', 'GROUP');
  end
end
%=============================================================================
function D = dummyvarNumericLocal(group)
  if ~(isvector(group) || ndims(group) == 2)
    error('Nelson:statistics:GROUPVectorMatrix', '%s must be a vector or matrix.', 'GROUP');
  end
  outType = classForOutputLocal(group);
  values = double(group);
  if any(values(~isnan(values)) < 1) || any(values(~isnan(values)) ~= fix(values(~isnan(values))))
    error('Nelson:statistics:numericGROUPValuesPositiveIntegers', 'Numeric GROUP values must be positive integers or NaN.');
  end
  if isvector(values)
    values = values(:);
  end
  D = zeros(size(values, 1), 0, outType);
  for col = 1:size(values, 2)
    column = values(:, col);
    if all(isnan(column))
      levels = 0;
    else
      levels = max(column(~isnan(column)));
    end
    block = zeros(size(values, 1), levels, outType);
    missing = isnan(column);
    if any(missing)
      block(missing, :) = NaN;
    end
    for level = 1:levels
      rows = column == level;
      if any(rows)
        block(rows, level) = 1;
      end
    end
    D = [D, block];
  end
end
%=============================================================================
function D = dummyvarCategoricalLocal(group)
  names = categories(group);
  labels = cellstr(group(:));
  D = labelsToDummyLocal(labels, names(:), true);
end
%=============================================================================
function D = dummyvarTextLocal(labels)
  labels = labels(:);
  missing = strcmp(labels, '');
  names = unique(labels(~missing), 'stable');
  D = labelsToDummyLocal(labels, names(:), true);
end
%=============================================================================
function D = labelsToDummyLocal(labels, names, emptyIsMissing)
  labels = labels(:);
  D = zeros(length(labels), length(names));
  missing = false(length(labels), 1);
  if emptyIsMissing
    missing = strcmp(labels, '') | strcmp(labels, '<undefined>');
  end
  if any(missing)
    D(missing, :) = NaN;
  end
  for k = 1:length(names)
    rows = strcmp(labels, names{k});
    if any(rows)
      D(rows, k) = 1;
    end
  end
end
%=============================================================================
function outType = classForOutputLocal(group)
  if isa(group, 'single')
    outType = 'single';
  else
    outType = 'double';
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [f, x, flo, fup] = ecdf(y, varargin)
  narginchk(1, Inf);
  nargoutchk(0, 4);
  parent = [];
  if isAxesHandleLocal(y)
    if isempty(varargin)
      error('Nelson:statistics:yRealNumericVectorTwo', 'Y must be a real numeric vector or two-column matrix.');
    end
    parent = y;
    y = varargin{1};
    varargin = varargin(2:end);
  end
  opts = parseOptionsLocal(varargin);
  [values, censoring, frequency] = prepareInputLocal(y, opts);
  [f, x, variance] = computeEcdfLocal(values, censoring, frequency, opts.Function);
  [flo, fup] = boundsLocal(f, variance, opts.Alpha, opts.Function);
  if nargout == 0
    plotEcdfLocal(parent, x, f, flo, fup, opts);
  end
end
%=============================================================================
function tf = isAxesHandleLocal(value)
  tf = false;
  if ~(isscalar(value) && exist('isgraphics') ~= 0)
    return
  end
  tf = isgraphics(value, 'axes') || isgraphics(value, 'hggroup');
end
%=============================================================================
function opts = parseOptionsLocal(args)
  opts = struct('Function', 'cdf', 'Censoring', [], 'Frequency', [], ...
    'Alpha', 0.05, 'Bounds', 'off');
  k = 1;
  while k <= length(args)
    if k == length(args)
      error('Nelson:statistics:nameValueArgumentFollowedValue', 'Name-value argument must be followed by a value.');
    end
    name = lower(char(args{k}));
    switch name
      case 'function'
        opts.Function = normalizeFunctionLocal(args{k + 1});
      case 'censoring'
        opts.Censoring = args{k + 1};
      case 'frequency'
        opts.Frequency = args{k + 1};
      case 'alpha'
        opts.Alpha = args{k + 1};
      case 'bounds'
        opts.Bounds = normalizeBoundsLocal(args{k + 1});
      case {'iterationlimit', 'tolerance', 'icmfrequency'}
        args{k + 1};
      otherwise
        error('Nelson:statistics:unknownOption', 'Unknown option.');
    end
    k = k + 2;
  end
  if ~(isnumeric(opts.Alpha) && isscalar(opts.Alpha) && opts.Alpha > 0 && opts.Alpha < 1)
    error('Nelson:statistics:alphaScalarBetween01', 'Alpha must be a scalar between 0 and 1.');
  end
end
%=============================================================================
function value = normalizeBoundsLocal(value)
  value = lower(char(value));
  switch value
    case {'on', 'off'}
    otherwise
      error('Nelson:statistics:boundsOff', 'Bounds must be ''on'' or ''off''.');
  end
end
%=============================================================================
function name = normalizeFunctionLocal(value)
  name = lower(char(value));
  switch name
    case {'cdf', 'cumulative distribution function'}
      name = 'cdf';
    case {'survivor', 'survival', 'survivor function'}
      name = 'survivor';
    case {'cumhazard', 'cumulative hazard', 'cumulative hazard function', 'hazard'}
      name = 'cumhazard';
    otherwise
      error('Nelson:statistics:unsupportedFunctionType', 'Unsupported %s.', 'function type');
  end
end
%=============================================================================
function [values, censoring, frequency] = prepareInputLocal(y, opts)
  if ~(isnumeric(y) && isreal(y) && ~issparse(y))
    error('Nelson:statistics:yRealNumericVectorTwo', 'Y must be a real numeric vector or two-column matrix.');
  end
  if ismatrix(y) && size(y, 2) == 2 && ~isvector(y)
    values = y(:, 1);
    censoring = zeros(size(values));
    exact = y(:, 1) == y(:, 2);
    right = isfinite(y(:, 1)) & isinf(y(:, 2));
    left = isinf(y(:, 1)) & isfinite(y(:, 2));
    values(right) = y(right, 1);
    values(left) = y(left, 2);
    censoring(right) = 1;
    censoring(left) = -1;
    censoring(exact) = 0;
  elseif isvector(y)
    values = y(:);
    censoring = zeros(size(values));
    if ~isempty(opts.Censoring)
      censoring = opts.Censoring(:);
    end
  else
    error('Nelson:statistics:yRealNumericVectorTwo', 'Y must be a real numeric vector or two-column matrix.');
  end
  frequency = ones(size(values));
  if ~isempty(opts.Frequency)
    frequency = opts.Frequency(:);
  end
  if length(censoring) ~= length(values) || length(frequency) ~= length(values)
    error('Nelson:statistics:mustMatchY', '%s must match Y.', 'Censoring and frequency');
  end
  keep = ~(isnan(values) | isnan(censoring) | isnan(frequency)) & frequency > 0;
  values = values(keep);
  censoring = censoring(keep);
  frequency = frequency(keep);
  if any(censoring ~= -1 & censoring ~= 0 & censoring ~= 1)
    error('Nelson:statistics:censoringValues101', 'Censoring values must be -1, 0, or 1.');
  end
end
%=============================================================================
function [f, x, variance] = computeEcdfLocal(values, censoring, frequency, functionName)
  if isempty(values)
    f = NaN;
    x = NaN;
    variance = NaN;
    return
  end
  left = censoring == -1;
  censoring(left) = 0;
  if all(censoring == 0)
    [f, x, variance] = computeUncensoredLocal(values, frequency, functionName);
    return
  end
  [values, order] = sort(values);
  censoring = censoring(order);
  frequency = frequency(order);
  eventTimes = unique(values(censoring == 0));
  if isempty(eventTimes)
    x = min(values);
    base = strcmp(functionName, 'survivor');
    f = double(base);
    variance = 0;
    return
  end
  x = [min(values); eventTimes(:)];
  survivor = ones(length(eventTimes) + 1, 1);
  greenwood = zeros(length(eventTimes) + 1, 1);
  gsum = 0;
  for k = 1:length(eventTimes)
    t = eventTimes(k);
    risk = sum(frequency(values >= t));
    events = sum(frequency(values == t & censoring == 0));
    if risk > 0
      survivor(k + 1) = survivor(k) * max(0, 1 - events / risk);
      if risk > events && events > 0
        gsum = gsum + events / (risk * (risk - events));
      end
    else
      survivor(k + 1) = survivor(k);
    end
    greenwood(k + 1) = survivor(k + 1) ^ 2 * gsum;
  end
  switch functionName
    case 'survivor'
      f = survivor;
      variance = greenwood;
    case 'cumhazard'
      f = -log(survivor);
      variance = greenwood ./ max(survivor .^ 2, realmin);
    otherwise
      f = 1 - survivor;
      variance = greenwood;
  end
end
%=============================================================================
function [f, x, variance] = computeUncensoredLocal(values, frequency, functionName)
  [values, order] = sort(values);
  frequency = frequency(order);
  if length(values) == 1
    starts = 1;
  else
    starts = [1; find(diff(values) ~= 0) + 1];
  end
  stops = [starts(2:end) - 1; length(values)];
  eventTimes = values(starts);
  counts = zeros(length(eventTimes), 1);
  for k = 1:length(starts)
    counts(k) = sum(frequency(starts(k):stops(k)));
  end
  total = sum(counts);
  cdfValues = [0; cumsum(counts) / total];
  survivor = 1 - cdfValues;
  x = [min(values); eventTimes(:)];
  switch functionName
    case 'survivor'
      f = survivor;
      variance = cdfValues .* (1 - cdfValues) / total;
    case 'cumhazard'
      f = -log(survivor);
      variance = cdfValues ./ max(total * survivor .^ 2, realmin);
    otherwise
      f = cdfValues;
      variance = cdfValues .* (1 - cdfValues) / total;
  end
end
%=============================================================================
function plotEcdfLocal(parent, x, f, flo, fup, opts)
  if isempty(parent)
    if strcmp(opts.Bounds, 'on')
      stairs(x, [flo f fup]);
    else
      stairs(x, f);
    end
  else
    if strcmp(opts.Bounds, 'on')
      stairs(parent, x, [flo f fup]);
    else
      stairs(parent, x, f);
    end
  end
end
%=============================================================================
function [flo, fup] = boundsLocal(f, variance, alpha, functionName)
  z = norminv(1 - alpha / 2, 0, 1);
  delta = z * sqrt(max(0, variance));
  flo = f - delta;
  fup = f + delta;
  switch functionName
    case {'cdf', 'survivor'}
      flo = min(max(flo, 0), 1);
      fup = min(max(fup, 0), 1);
    otherwise
      flo = max(flo, 0);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function eva = evalclusters(varargin)
  narginchk(3, Inf);
  nargoutchk(0, 1);

  X = varargin{1};
  clust = varargin{2};
  criterion = criterionName(varargin{3});
  if ~isnumeric(X) || ndims(X) ~= 2 || isempty(X)
    error('Nelson:statistics:xNonemptyNumericMatrix', '%s must be a nonempty numeric matrix.', 'X');
  end
  if rem(nargin - 3, 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end

  opts = parseOptions(varargin(4:end));
  labels = clusteringSolutions(X, clust, opts);
  values = evaluateSolutions(X, labels, criterion, opts);
  inspectedK = clusterCounts(labels);
  [optimalK, optimalColumn] = chooseOptimal(inspectedK, values, criterion);

  eva = struct();
  eva.CriterionName = criterion;
  eva.NumObservations = size(X, 1);
  eva.InspectedK = inspectedK;
  eva.CriterionValues = values;
  eva.OptimalK = optimalK;
  eva.OptimalY = labels(:, optimalColumn);
  eva.ClusterLabels = labels;
  eva.Distance = opts.Distance;
  if strcmp(criterion, 'silhouette')
    eva.ClusterPriors = opts.ClusterPriors;
  end

  if nargout == 0
    disp(eva);
    clear eva;
  end
end
%=============================================================================
function opts = parseOptions(args)
  opts = struct('KList', [], 'Distance', 'sqeuclidean', 'ClusterPriors', 'empirical');
  for k = 1:2:length(args)
    name = optionName(args{k});
    value = args{k + 1};
    switch name
      case 'klist'
        opts.KList = positiveIntegerVector(value, 'KList must be a vector of positive integers.');
      case 'distance'
        opts.Distance = value;
      case 'clusterpriors'
        opts.ClusterPriors = clusterPriorsValue(value);
      otherwise
        error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
    end
  end
end
%=============================================================================
function name = optionName(value)
  if ~(ischar(value) || isStringScalar(value))
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Name');
  end
  text = lower(char(value));
  if isempty(text)
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
  names = {'klist', 'distance', 'clusterpriors'};
  matches = {};
  for k = 1:length(names)
    if strncmp(names{k}, text, length(text))
      matches{end + 1} = names{k};
    end
  end
  if isempty(matches)
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
  if length(matches) > 1
    error('Nelson:statistics:ambiguousNameValue', 'Ambiguous name-value argument name.');
  end
  name = matches{1};
end
%=============================================================================
function criterion = criterionName(value)
  if ~(ischar(value) || isStringScalar(value))
    error('Nelson:statistics:criterionSilhouetteCalinskiHarabaszDaviesBouldin', 'Criterion must be silhouette, CalinskiHarabasz, or DaviesBouldin.');
  end
  text = lower(char(value));
  names = {'silhouette', 'calinskiharabasz', 'daviesbouldin'};
  canonical = {'silhouette', 'CalinskiHarabasz', 'DaviesBouldin'};
  matches = [];
  for k = 1:length(names)
    if ~isempty(text) && strncmp(names{k}, text, length(text))
      matches(end + 1) = k;
    end
  end
  if isempty(matches)
    error('Nelson:statistics:criterionSilhouetteCalinskiHarabaszDaviesBouldin', 'Criterion must be silhouette, CalinskiHarabasz, or DaviesBouldin.');
  end
  if length(matches) > 1
    error('Nelson:statistics:ambiguousValue', 'Ambiguous %s value.', 'criterion');
  end
  criterion = canonical{matches(1)};
end
%=============================================================================
function value = clusterPriorsValue(value)
  if ~(ischar(value) || isStringScalar(value))
    error('Nelson:statistics:clusterPriorsEmpiricalEqual', 'ClusterPriors must be empirical or equal.');
  end
  text = lower(char(value));
  names = {'empirical', 'equal'};
  matches = {};
  for k = 1:length(names)
    if ~isempty(text) && strncmp(names{k}, text, length(text))
      matches{end + 1} = names{k};
    end
  end
  if isempty(matches)
    error('Nelson:statistics:clusterPriorsEmpiricalEqual', 'ClusterPriors must be empirical or equal.');
  end
  if length(matches) > 1
    error('Nelson:statistics:ambiguousValue', 'Ambiguous %s value.', 'ClusterPriors');
  end
  value = matches{1};
end
%=============================================================================
function values = positiveIntegerVector(value, message)
  if ~isnumeric(value) || ~isvector(value) || isempty(value) || any(value(:) < 1) || any(value(:) ~= fix(value(:)))
    error('Nelson:statistics:mustBePositiveInteger', message);
  end
  values = value(:)';
end
%=============================================================================
function labels = clusteringSolutions(X, clust, opts)
  if isnumeric(clust)
    labels = matrixSolutions(X, clust);
    return
  end
  if isempty(opts.KList)
    error('Nelson:statistics:kListSpecifiedClusteringAlgorithms', 'KList must be specified for clustering algorithms.');
  end
  labels = zeros(size(X, 1), length(opts.KList));
  for k = 1:length(opts.KList)
    labels(:, k) = runClustering(X, clust, opts.KList(k), opts);
  end
end
%=============================================================================
function labels = matrixSolutions(X, clust)
  if ndims(clust) ~= 2 || size(clust, 1) ~= size(X, 1) || isempty(clust)
    error('Nelson:statistics:CLUSTOneRowObservation', '%s must have one row per observation.', 'CLUST');
  end
  labels = clust;
end
%=============================================================================
function labels = runClustering(X, clust, k, opts)
  if ischar(clust) || isStringScalar(clust)
    name = lower(char(clust));
    if isempty(name)
      error('Nelson:statistics:invalidClusteringAlgorithm', 'Invalid clustering algorithm.');
    end
    if strncmp('kmeans', name, length(name))
      labels = kmeans(X, k, 'EmptyAction', 'singleton', 'Replicates', 5, 'Distance', opts.Distance);
    elseif strncmp('linkage', name, length(name))
      labels = clusterdata(X, 'MaxClust', k, 'Linkage', linkageMethod(opts.Distance), 'Distance', linkageDistance(opts.Distance));
    elseif strncmp('spectralcluster', name, length(name))
      labels = spectralcluster(X, k, 'Distance', spectralDistance(opts.Distance));
    else
      error('Nelson:statistics:invalidClusteringAlgorithm', 'Invalid clustering algorithm.');
    end
  elseif isfunction_handle(clust)
    labels = feval(clust, X, k);
  else
    error('Nelson:statistics:invalidClusteringAlgorithm', 'Invalid clustering algorithm.');
  end
  labels = labelsFromScores(labels, k, size(X, 1));
end
%=============================================================================
function method = linkageMethod(distance)
  if ischar(distance) || isStringScalar(distance)
    text = lower(char(distance));
    if strncmp('sqeuclidean', text, length(text)) || strncmp('euclidean', text, length(text))
      method = 'ward';
    else
      method = 'average';
    end
  else
    method = 'average';
  end
end
%=============================================================================
function distance = linkageDistance(distance)
  if ischar(distance) || isStringScalar(distance)
    text = lower(char(distance));
    if strncmp('sqeuclidean', text, length(text))
      distance = 'euclidean';
    end
  end
end
%=============================================================================
function distance = spectralDistance(distance)
  if ischar(distance) || isStringScalar(distance)
    text = lower(char(distance));
    if strncmp('sqeuclidean', text, length(text))
      distance = 'euclidean';
    end
  end
end
%=============================================================================
function labels = labelsFromScores(labels, k, n)
  if ~isnumeric(labels) || ndims(labels) ~= 2 || size(labels, 1) ~= n
    error('Nelson:statistics:clusteringOutputOneRowObservation', '%s must have one row per observation.', 'Clustering output');
  end
  if size(labels, 2) > 1
    [~, labels] = max(labels, [], 2);
  else
    labels = labels(:);
  end
  if length(unique(labels)) ~= k
    error('Nelson:statistics:clusteringOutputContainKClusters', 'Clustering output must contain K clusters.');
  end
end
%=============================================================================
function values = evaluateSolutions(X, labels, criterion, opts)
  values = zeros(1, size(labels, 2));
  for k = 1:size(labels, 2)
    current = labels(:, k);
    switch criterion
      case 'silhouette'
        values(k) = silhouetteCriterion(X, current, opts.Distance, opts.ClusterPriors);
      case 'CalinskiHarabasz'
        values(k) = calinskiHarabaszCriterion(X, current);
      case 'DaviesBouldin'
        values(k) = daviesBouldinCriterion(X, current);
    end
  end
end
%=============================================================================
function values = clusterCounts(labels)
  values = zeros(1, size(labels, 2));
  for k = 1:size(labels, 2)
    values(k) = length(unique(labels(:, k)));
  end
end
%=============================================================================
function value = silhouetteCriterion(X, labels, distance, priors)
  if length(unique(labels)) < 2
    value = NaN;
    return
  end
  s = silhouette(X, labels, distance);
  if strcmp(priors, 'empirical')
    value = mean(s);
  else
    groups = unique(labels);
    clusterValues = zeros(length(groups), 1);
    for k = 1:length(groups)
      clusterValues(k) = mean(s(labels == groups(k)));
    end
    value = mean(clusterValues);
  end
end
%=============================================================================
function value = calinskiHarabaszCriterion(X, labels)
  groups = unique(labels);
  n = size(X, 1);
  k = length(groups);
  if k < 2 || k >= n
    value = NaN;
    return
  end
  grandMean = mean(X, 1);
  within = 0;
  between = 0;
  for i = 1:k
    rows = labels == groups(i);
    Xi = X(rows, :);
    centroid = mean(Xi, 1);
    centered = Xi - centroid;
    within = within + sum(centered(:) .^ 2);
    delta = centroid - grandMean;
    between = between + size(Xi, 1) * sum(delta(:) .^ 2);
  end
  value = (between / (k - 1)) / (within / (n - k));
end
%=============================================================================
function value = daviesBouldinCriterion(X, labels)
  groups = unique(labels);
  k = length(groups);
  if k < 2
    value = NaN;
    return
  end
  centroids = zeros(k, size(X, 2));
  scatter = zeros(k, 1);
  for i = 1:k
    Xi = X(labels == groups(i), :);
    centroids(i, :) = mean(Xi, 1);
    scatter(i) = meanEuclideanDistance(Xi, centroids(i, :));
  end
  maxRatio = zeros(k, 1);
  for i = 1:k
    best = -Inf;
    for j = 1:k
      if i ~= j
        separation = euclideanDistance(centroids(i, :), centroids(j, :));
        if separation == 0
          ratio = Inf;
        else
          ratio = (scatter(i) + scatter(j)) / separation;
        end
        best = max(best, ratio);
      end
    end
    maxRatio(i) = best;
  end
  value = mean(maxRatio);
end
%=============================================================================
function value = meanEuclideanDistance(X, center)
  delta = X - center;
  value = mean(sqrt(sum(delta .^ 2, 2)));
end
%=============================================================================
function value = euclideanDistance(a, b)
  delta = a - b;
  value = sqrt(sum(delta(:) .^ 2));
end
%=============================================================================
function [optimalK, optimalColumn] = chooseOptimal(inspectedK, values, criterion)
  valid = find(~isnan(values));
  if isempty(valid)
    optimalK = NaN;
    optimalColumn = 1;
    return
  end
  if strcmp(criterion, 'DaviesBouldin')
    bestValue = min(values(valid));
  else
    bestValue = max(values(valid));
  end
  candidates = valid(values(valid) == bestValue);
  [optimalK, order] = min(inspectedK(candidates));
  optimalColumn = candidates(order);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [lambda, psi, T, stats, F] = factoran(X, m, varargin)
  narginchk(2, Inf);
  nargoutchk(0, 5);
  [X, m, opts] = parseInputsLocal(X, m, convertStringToCharArgs(varargin));
  [S, Z, nobs] = covarianceInputLocal(X, opts.Xtype);
  [lambda, psi] = loadingsLocal(S, m);
  if strcmp(opts.Rotate, 'none')
    T = eye(m);
  else
    [lambda, T] = rotateLoadingsLocal(lambda, opts);
  end
  stats = statsLocal(S, lambda, psi, nobs);
  F = scoresLocal(Z, lambda, psi, opts.Scores);
end
%=============================================================================
function [X, m, opts] = parseInputsLocal(X, m, args)
  if ~(isnumeric(X) && isreal(X) && ~issparse(X) && ndims(X) == 2)
    error('Nelson:statistics:xRealNumericMatrix', '%s must be a real numeric matrix.', 'X');
  end
  X = double(X);
  if isempty(X) || size(X, 2) < 2
    error('Nelson:statistics:xContainLeastTwoVariables', 'X must contain at least two variables.');
  end
  if ~(isnumeric(m) && isreal(m) && isscalar(m) && isfinite(m) && floor(m) == m && m > 0)
    error('Nelson:statistics:mPositiveIntegerScalar', '%s must be a positive integer scalar.', 'M');
  end
  m = double(m);
  opts = defaultOptionsLocal();
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  for k = 1:2:length(args)
    if ~isTextScalarLocal(args{k})
      error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Name');
    end
    opts = setOptionLocal(opts, lower(char(args{k})), args{k + 1});
  end
end
%=============================================================================
function opts = defaultOptionsLocal()
  opts = struct('Xtype', 'data', 'Rotate', 'varimax', 'Scores', 'wls', ...
    'MaxIt', 250, 'RelTol', sqrt(eps), 'RotateCoeff', 1, ...
    'Normalize', true, 'Power', 4, 'Target', [], 'Type', 'oblique');
end
%=============================================================================
function opts = setOptionLocal(opts, name, value)
  switch name
    case 'xtype'
      opts.Xtype = parseChoiceLocal(value, {'data', 'covariance', 'correlation'}, 'Xtype');
      if strcmp(opts.Xtype, 'correlation')
        opts.Xtype = 'covariance';
      end
    case 'rotate'
      opts.Rotate = parseChoiceLocal(value, ...
        {'varimax', 'none', 'quartimax', 'equamax', 'parsimax', 'orthomax', ...
         'promax', 'procrustes', 'pattern'}, 'Rotate');
    case 'scores'
      opts.Scores = parseChoiceLocal(value, {'wls', 'bartlett', 'regression', 'thomson', 'none'}, 'Scores');
      if strcmp(opts.Scores, 'bartlett')
        opts.Scores = 'wls';
      elseif strcmp(opts.Scores, 'thomson')
        opts.Scores = 'regression';
      end
    case 'options'
      opts = parseOptionsLocal(opts, value);
    case 'start'
      validateStartLocal(value);
    case 'coeff'
      opts.RotateCoeff = validateCoeffLocal(value);
    case 'normalize'
      opts.Normalize = parseOnOffLocal(value, 'Normalize');
    case 'reltol'
      opts.RelTol = validatePositiveScalarLocal(value, 'RelTol');
    case 'maxit'
      opts.MaxIt = validatePositiveIntegerLocal(value, 'MaxIt');
    case 'power'
      opts.Power = validatePositiveScalarLocal(value, 'Power');
    case 'target'
      opts.Target = validateTargetLocal(value, [0 0]);
    case 'type'
      opts.Type = parseChoiceLocal(value, {'oblique', 'orthogonal'}, 'Type');
    otherwise
      error('Nelson:statistics:unknownOption', 'Unknown option.');
  end
end
%=============================================================================
function value = parseChoiceLocal(value, choices, name)
  if ~isTextScalarLocal(value)
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', name);
  end
  value = lower(char(value));
  matches = find(startsWith(choices, value));
  if length(matches) ~= 1
    error('Nelson:statistics:invalidValue:valueHasUnsupportedValue', '%s has an unsupported value.', name);
  end
  value = choices{matches};
end
%=============================================================================
function opts = parseOptionsLocal(opts, options)
  if isempty(options)
    return
  end
  if ~(isstruct(options) && isscalar(options))
    error('Nelson:statistics:invalidOptions', '%s must be a scalar structure.', 'Options');
  end
  opts.MaxIt = statget(options, 'MaxIter', opts.MaxIt);
  opts.RelTol = statget(options, 'TolX', opts.RelTol);
  if ~isPositiveIntegerLocal(opts.MaxIt)
    error('Nelson:statistics:optionsMaxIterPositiveIntegerScalar', '%s must be a positive integer scalar.', 'Options MaxIter');
  end
  if ~isPositiveScalarLocal(opts.RelTol)
    error('Nelson:statistics:optionsTolXPositiveScalar', '%s must be a positive scalar.', 'Options TolX');
  end
end
%=============================================================================
function validateStartLocal(value)
  if isTextScalarLocal(value)
    parseChoiceLocal(value, {'rsquared', 'random'}, 'Start');
    return
  end
  if ~(isnumeric(value) && isreal(value) && ~issparse(value) && all(isfinite(double(value(:)))))
    error('Nelson:statistics:startSupportedValueFiniteNumeric', 'Start must be a supported value or a finite numeric array.');
  end
  if isscalar(value) && (value <= 0 || floor(value) ~= value)
    error('Nelson:statistics:startPositiveIntegerScalar', '%s must be a positive integer scalar.', 'Start');
  end
end
%=============================================================================
function value = validateCoeffLocal(value)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) && value >= 0)
    error('Nelson:statistics:coeffNonnegativeFiniteScalar', 'Coeff must be a nonnegative finite scalar.');
  end
  value = double(value);
end
%=============================================================================
function value = validatePositiveScalarLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) && value > 0)
    error('Nelson:statistics:mustBePositiveFinite', '%s must be a positive finite scalar.', name);
  end
  value = double(value);
end
%=============================================================================
function value = validatePositiveIntegerLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) ...
      && floor(value) == value && value > 0)
    error('Nelson:statistics:mustBePositiveInteger', '%s must be a positive integer scalar.', name);
  end
  value = double(value);
end
%=============================================================================
function target = validateTargetLocal(target, expectedSize)
  if ~(isnumeric(target) && isreal(target) && ~issparse(target) && ndims(target) == 2)
    error('Nelson:statistics:targetRealNumericMatrix', '%s must be a real numeric matrix.', 'Target');
  end
  target = double(target);
  if ~isequal(expectedSize, [0 0]) && ~isequal(size(target), expectedSize)
    error('Nelson:statistics:targetSameSizeLoadings', 'Target must have the same size as loadings.');
  end
  if any(~isfinite(target(:)))
    error('Nelson:statistics:targetContainFiniteValues', '%s must contain finite values.', 'Target');
  end
end
%=============================================================================
function tf = parseOnOffLocal(value, name)
  if islogical(value) && isscalar(value)
    tf = value ~= 0;
  elseif isnumeric(value) && isreal(value) && isscalar(value) && (value == 0 || value == 1)
    tf = value ~= 0;
  elseif isTextScalarLocal(value)
    value = lower(char(value));
    if strcmp(value, 'on')
      tf = true;
    elseif strcmp(value, 'off')
      tf = false;
    else
      error('Nelson:statistics:invalidValue:valueHasUnsupportedValue', '%s has an unsupported value.', name);
    end
  else
    error('Nelson:statistics:invalidValue:valueOffTrueFalse', '%s must be on, off, true, or false.', name);
  end
end
%=============================================================================
function [S, Z, nobs] = covarianceInputLocal(X, xtype)
  if strcmp(xtype, 'covariance')
    S = validateCovarianceLocal(X);
    Z = [];
    nobs = NaN;
    return
  end
  if any(isinf(X(:)))
    error('Nelson:statistics:xMustBeFinite', '%s must contain finite values.', 'X');
  end
  keep = ~any(isnan(X), 2);
  X = X(keep, :);
  if size(X, 1) < 2
    error('Nelson:statistics:xContainLeastTwoComplete', 'X must contain at least two complete observations.');
  end
  mu = mean(X, 1);
  X = X - repmat(mu, size(X, 1), 1);
  scale = sqrt(sum(X .^ 2, 1) / max(size(X, 1) - 1, 1));
  if any(scale <= 0)
    error('Nelson:statistics:variablePositiveVariance', 'Each variable must have positive variance.');
  end
  Z = X ./ repmat(scale, size(X, 1), 1);
  S = (Z' * Z) / max(size(Z, 1) - 1, 1);
  S = (S + S') / 2;
  nobs = size(Z, 1);
end
%=============================================================================
function S = validateCovarianceLocal(S)
  if size(S, 1) ~= size(S, 2)
    error('Nelson:statistics:xSquareMatrixXtypeCovariance', 'X must be a square matrix when Xtype is covariance.');
  end
  if any(~isfinite(S(:)))
    error('Nelson:statistics:xMustBeFinite', '%s must contain finite values.', 'X');
  end
  tolerance = 100 * eps(max(1, max(abs(S(:)))));
  if any(any(abs(S - S') > tolerance))
    error('Nelson:statistics:xSymmetricXtypeCovariance', 'X must be symmetric when Xtype is covariance.');
  end
  S = (S + S') / 2;
  if any(diag(S) <= 0)
    error('Nelson:statistics:xPositiveDiagonal', 'X must have a positive diagonal.');
  end
end
%=============================================================================
function [lambda, psi] = loadingsLocal(S, m)
  p = size(S, 1);
  if m >= p
    error('Nelson:statistics:mSmallerNumberVariables', 'M must be smaller than the number of variables.');
  end
  [V, D] = eig(S);
  latent = real(diag(D));
  [latent, order] = sort(latent, 'descend');
  V = real(V(:, order));
  tolerance = 100 * eps(max(1, max(abs(latent))));
  if any(latent <= tolerance)
    error('Nelson:statistics:xPositiveDefinite', 'X must be positive definite.');
  end
  lambda = V(:, 1:m) * diag(sqrt(max(latent(1:m), 0)));
  lambda = orientColumnsLocal(lambda);
  psi = diag(S) - (lambda .^ 2) * ones(m, 1);
  minPsi = eps(max(diag(S)));
  psi(psi < minPsi) = minPsi;
end
%=============================================================================
function lambda = orientColumnsLocal(lambda)
  for k = 1:size(lambda, 2)
    [~, idx] = max(abs(lambda(:, k)));
    if lambda(idx, k) < 0
      lambda(:, k) = -lambda(:, k);
    end
  end
end
%=============================================================================
function [lambda, T] = rotateLoadingsLocal(lambda, opts)
  args = {'Method', opts.Rotate, 'Normalize', opts.Normalize, 'RelTol', opts.RelTol, ...
    'MaxIt', opts.MaxIt, 'Coeff', opts.RotateCoeff, 'Power', opts.Power, 'Type', opts.Type};
  if ~isempty(opts.Target)
    if ~isequal(size(opts.Target), size(lambda))
      error('Nelson:statistics:targetSameSizeLoadings', 'Target must have the same size as loadings.');
    end
    args = [args, {'Target', opts.Target}];
  end
  [lambda, T] = rotatefactors(lambda, args{:});
end
%=============================================================================
function stats = statsLocal(S, lambda, psi, nobs)
  sigma = lambda * lambda' + diag(psi);
  residual = S - sigma;
  residual(1:size(residual, 1) + 1:end) = 0;
  p = size(S, 1);
  m = size(lambda, 2);
  dfe = ((p - m) ^ 2 - p - m) / 2;
  objective = likelihoodObjectiveLocal(S, sigma);
  chisq = NaN;
  prob = NaN;
  if isfinite(nobs) && dfe > 0 && isfinite(objective)
    scale = max(nobs - 1 - (2 * p + 5) / 6 - (2 * m) / 3, 1);
    chisq = scale * objective;
    prob = 1 - chi2cdf(chisq, dfe);
  end
  stats = struct('loglike', -0.5 * max(nobs, 1) * objective, ...
    'dfe', dfe, 'chisq', chisq, 'p', prob, 'residual', residual);
end
%=============================================================================
function objective = likelihoodObjectiveLocal(S, sigma)
  [signS, logS] = logdetLocal(S);
  [signSigma, logSigma] = logdetLocal(sigma);
  if signS <= 0 || signSigma <= 0
    objective = NaN;
  else
    objective = logSigma + trace(sigma \ S) - logS - size(S, 1);
  end
end
%=============================================================================
function [sgn, value] = logdetLocal(A)
  [~, U, P] = lu(A);
  sgn = det(P);
  diagonal = diag(U);
  sgn = sgn * prod(sign(diagonal));
  value = sum(log(abs(diagonal)));
end
%=============================================================================
function F = scoresLocal(Z, lambda, psi, method)
  if isempty(Z) || strcmp(method, 'none')
    F = [];
    return
  end
  psi = max(psi(:), eps);
  if strcmp(method, 'wls')
    weightedLambda = lambda ./ repmat(psi, 1, size(lambda, 2));
    B = (lambda' * weightedLambda) \ weightedLambda';
    F = Z * B';
  else
    sigma = lambda * lambda' + diag(psi);
    F = Z * (sigma \ lambda);
  end
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || isStringScalar(value);
end
%=============================================================================
function tf = isPositiveIntegerLocal(value)
  tf = isnumeric(value) && isreal(value) && isscalar(value) ...
    && isfinite(value) && floor(value) == value && value > 0;
end
%=============================================================================
function tf = isPositiveScalarLocal(value)
  tf = isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) && value > 0;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [B, TF, L, U, C] = filloutliers(A, fillmethod, varargin)
  narginchk(2, Inf);
  nargoutchk(0, 5);
  if ~(isnumeric(A) && isreal(A) && ~issparse(A))
    error('Nelson:statistics:aMustBeRealArray', '%s must be a real numeric array.', 'A');
  end
  [opts, fill] = parseInputsLocal(fillmethod, convertStringToCharArgs(varargin));
  [TF, L, U, C] = detectOutliersLocal(A, opts);
  B = fillOutliersAlongDimensionLocal(A, TF, L, U, C, fill, opts);
end
%=============================================================================
function [opts, fill] = parseInputsLocal(fillmethod, args)
  opts = struct('DetectArgs', {{}}, 'Dim', [], 'NameValueArgs', {{}}, 'OutlierLocations', []);
  fill = parseFillMethodLocal(fillmethod);
  idx = 1;
  if idx <= length(args)
    value = args{idx};
    if isTextScalarLocal(value) && ~isLeadingNameValueLocal(value)
      method = parseDetectionMethodLocal(value);
      opts.DetectArgs{end + 1} = value;
      idx = idx + 1;
      if any(strcmp(method, {'percentiles', 'movmedian', 'movmean'}))
        if idx > length(args)
          error('Nelson:statistics:detectionMethodArgumentIncomplete', 'Detection method argument is incomplete.');
        end
        opts.DetectArgs{end + 1} = args{idx};
        idx = idx + 1;
      end
    elseif isDimScalarLocal(value)
      opts.Dim = double(value);
      idx = idx + 1;
    end
  end
  if idx <= length(args) && isDimScalarLocal(args{idx})
    opts.Dim = double(args{idx});
    idx = idx + 1;
  end
  [opts, fill] = parseNameValuesLocal(opts, fill, args(idx:end));
end
%=============================================================================
function [opts, fill] = parseNameValuesLocal(opts, fill, args)
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  for k = 1:2:length(args)
    name = matchedNameLocal(args{k});
    switch name
      case 'outlierlocations'
        opts.OutlierLocations = args{k + 1};
      case 'samplepoints'
        opts.NameValueArgs{end + 1} = args{k};
        opts.NameValueArgs{end + 1} = args{k + 1};
        fill.SamplePoints = parseSamplePointsLocal(args{k + 1});
      case {'thresholdfactor', 'maxnumoutliers'}
        opts.NameValueArgs{end + 1} = args{k};
        opts.NameValueArgs{end + 1} = args{k + 1};
      case {'datavariables', 'outputformat'}
        error('Nelson:statistics:invalidUsage', '%s is not supported for numeric array input.', canonicalNameLocal(name));
    end
  end
end
%=============================================================================
function [TF, L, U, C] = detectOutliersLocal(A, opts)
  if isempty(opts.Dim)
    dim = firstNonsingletonLocal(size(A));
  else
    dim = opts.Dim;
  end
  if isempty(opts.OutlierLocations)
    [TF, L, U, C] = isoutlier(A, opts.DetectArgs{:}, dim, opts.NameValueArgs{:});
  else
    TF = parseOutlierLocationsLocal(opts.OutlierLocations, size(A));
    [L, U, C] = emptyThresholdsLocal(size(A), dim);
  end
end
%=============================================================================
function B = fillOutliersAlongDimensionLocal(A, TF, L, U, C, fill, opts)
  if isempty(opts.Dim)
    dim = firstNonsingletonLocal(size(A));
  else
    dim = opts.Dim;
  end
  sz = size(A);
  originalRank = max(2, length(sz));
  nd = max(originalRank, dim);
  sz(end + 1:nd) = 1;
  fill = validateSamplePointsLocal(fill, sz(dim));
  perm = [dim, setdiff(1:nd, dim, 'stable')];
  Ap = permute(reshape(A, sz), perm);
  TFp = permute(reshape(TF, sz), perm);
  psize = size(Ap);
  psize(end + 1:nd) = 1;
  n = psize(1);
  cols = prod(psize(2:end));
  Br = reshape(Ap, n, cols);
  TFr = reshape(TFp, n, cols);
  thresholds = thresholdsToRowsLocal(L, U, C, fill, perm, psize, sz, dim);
  for col = 1:cols
    Br(:, col) = fillVectorLocal(Br(:, col), TFr(:, col), thresholds, col, fill);
  end
  B = reshape(ipermute(reshape(Br, psize), perm), sz(1:originalRank));
end
%=============================================================================
function thresholds = thresholdsToRowsLocal(L, U, C, fill, perm, psize, sz, dim)
  thresholds = struct('L', [], 'U', [], 'C', []);
  if strcmp(fill.Method, 'clip')
    if isequal(size(L), sz)
      thresholds.L = reshape(permute(reshape(L, sz), perm), psize);
      thresholds.U = reshape(permute(reshape(U, sz), perm), psize);
      thresholds.C = reshape(permute(reshape(C, sz), perm), psize);
      thresholds.L = reshape(thresholds.L, psize(1), []);
      thresholds.U = reshape(thresholds.U, psize(1), []);
      thresholds.C = reshape(thresholds.C, psize(1), []);
    else
      thresholds.L = reshapeThresholdLocal(L, perm, psize, sz, dim);
      thresholds.U = reshapeThresholdLocal(U, perm, psize, sz, dim);
      thresholds.C = reshapeThresholdLocal(C, perm, psize, sz, dim);
    end
  end
end
%=============================================================================
function values = reshapeThresholdLocal(T, perm, psize, sz, dim)
  outSize = sz;
  outSize(dim) = 1;
  Tp = permute(reshape(T, outSize), perm);
  values = reshape(Tp, 1, prod(psize(2:end)));
end
%=============================================================================
function y = fillVectorLocal(x, mask, thresholds, col, fill)
  y = x;
  if ~any(mask)
    return
  end
  switch fill.Method
    case 'constant'
      y(mask) = castConstantLocal(fill.Constant, x);
    case 'clip'
      y = fillClipLocal(y, mask, thresholds, col);
    case 'previous'
      y = fillPreviousLocal(y, mask);
    case 'next'
      y = fillNextLocal(y, mask);
    case 'nearest'
      y = fillNearestLocal(y, mask);
    otherwise
      y = fillInterpLocal(y, mask, fill);
  end
end
%=============================================================================
function y = fillClipLocal(y, mask, thresholds, col)
  idx = find(mask);
  for k = idx(:)'
    if size(thresholds.L, 1) == 1
      lo = thresholds.L(1, col);
      hi = thresholds.U(1, col);
    else
      lo = thresholds.L(k, col);
      hi = thresholds.U(k, col);
    end
    y(k) = min(max(y(k), lo), hi);
  end
end
%=============================================================================
function y = fillPreviousLocal(y, mask)
  for k = 1:length(y)
    if mask(k)
      previous = find(~mask(1:k - 1), 1, 'last');
      if ~isempty(previous)
        y(k) = y(previous);
      end
    end
  end
end
%=============================================================================
function y = fillNextLocal(y, mask)
  for k = length(y):-1:1
    if mask(k)
      next = find(~mask(k + 1:end), 1, 'first');
      if ~isempty(next)
        y(k) = y(k + next);
      end
    end
  end
end
%=============================================================================
function y = fillNearestLocal(y, mask)
  known = find(~mask);
  for k = find(mask(:)).'
    if isempty(known)
      continue
    end
    [~, pos] = min(abs(known - k));
    y(k) = y(known(pos));
  end
end
%=============================================================================
function y = fillInterpLocal(y, mask, fill)
  known = find(~mask);
  missing = find(mask);
  if length(known) < 2
    return
  end
  x = samplePointsForLengthLocal(fill, length(y));
  yi = interp1(x(known), double(y(known)), x(missing), fill.Method);
  finiteValues = ~isnan(yi);
  y(missing(finiteValues)) = cast(yi(finiteValues), class(y));
end
%=============================================================================
function fill = parseFillMethodLocal(value)
  fill = struct('Method', '', 'Constant', [], 'SamplePoints', []);
  if isTextScalarLocal(value)
    choices = {'previous', 'next', 'nearest', 'linear', 'spline', 'pchip', 'makima', 'clip'};
    text = lower(char(value));
    matches = choices(startsWith(choices, text));
    if length(matches) ~= 1
      error('Nelson:statistics:FILLMETHODUnsupportedValue', '%s has an unsupported value.', 'FILLMETHOD');
    end
    fill.Method = matches{1};
    if any(strcmp(fill.Method, {'spline', 'makima'}))
      error('Nelson:statistics:unsupportedFillMethod', 'Unsupported %s.', 'fill method');
    end
  elseif isnumeric(value) && isreal(value) && isscalar(value)
    fill.Method = 'constant';
    fill.Constant = value;
  else
    error('Nelson:statistics:FILLMETHODSupportedMethodNameNumeric', 'FILLMETHOD must be a supported method name or numeric scalar.');
  end
end
%=============================================================================
function method = parseDetectionMethodLocal(value)
  choices = {'median', 'mean', 'quartiles', 'grubbs', 'gesd', ...
    'percentiles', 'movmedian', 'movmean'};
  text = lower(char(value));
  matches = choices(startsWith(choices, text));
  if length(matches) ~= 1
    error('Nelson:statistics:METHODUnsupportedValue', '%s has an unsupported value.', 'METHOD');
  end
  method = matches{1};
end
%=============================================================================
function value = castConstantLocal(value, target)
  value = cast(value, class(target));
end
%=============================================================================
function x = samplePointsForLengthLocal(fill, n)
  if isempty(fill.SamplePoints)
    x = (1:n)';
  else
    x = fill.SamplePoints(:);
  end
end
%=============================================================================
function fill = validateSamplePointsLocal(fill, n)
  if isempty(fill.SamplePoints)
    return
  end
  if length(fill.SamplePoints) ~= n
    error('Nelson:statistics:samplePointsOneElementInputElement', 'SamplePoints must have one element for each input element along the operating dimension.');
  end
  if any(diff(fill.SamplePoints) <= 0)
    error('Nelson:statistics:samplePointsSortedContainUniqueValues', 'SamplePoints must be sorted and contain unique values.');
  end
end
%=============================================================================
function samplePoints = parseSamplePointsLocal(value)
  if ~(isnumeric(value) && isreal(value) && isvector(value) && all(isfinite(value)))
    error('Nelson:statistics:samplePointsFiniteRealNumericVector', 'SamplePoints must be a finite real numeric vector.');
  end
  samplePoints = double(value(:));
end
%=============================================================================
function locations = parseOutlierLocationsLocal(value, sz)
  if ~(islogical(value) && isequal(size(value), sz))
    error('Nelson:statistics:outlierLocationsLogicalArraySameSize', 'OutlierLocations must be a logical array the same size as A.');
  end
  locations = value;
end
%=============================================================================
function [L, U, C] = emptyThresholdsLocal(sz, dim)
  outSize = sz;
  outSize(end + 1:dim) = 1;
  outSize(dim) = 1;
  L = NaN(outSize);
  U = NaN(outSize);
  C = NaN(outSize);
end
%=============================================================================
function dim = firstNonsingletonLocal(sz)
  dim = 1;
  for k = 1:length(sz)
    if sz(k) ~= 1
      dim = k;
      return
    end
  end
end
%=============================================================================
function tf = isDimScalarLocal(value)
  tf = isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) ...
    && value == fix(value) && value >= 1;
end
%=============================================================================
function name = matchedNameLocal(value)
  if ~isTextScalarLocal(value)
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Name');
  end
  names = {'thresholdfactor', 'maxnumoutliers', 'samplepoints', 'outlierlocations', ...
    'datavariables', 'outputformat'};
  text = lower(char(value));
  matches = names(startsWith(names, text));
  if length(matches) ~= 1
    error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
  end
  name = matches{1};
end
%=============================================================================
function tf = isLeadingNameValueLocal(value)
  names = {'thresholdfactor', 'maxnumoutliers', 'samplepoints', 'outlierlocations', ...
    'datavariables', 'outputformat'};
  text = lower(char(value));
  matches = names(startsWith(names, text));
  tf = length(matches) == 1;
end
%=============================================================================
function name = canonicalNameLocal(name)
  switch name
    case 'datavariables'
      name = 'DataVariables';
    otherwise
      name = 'OutputFormat';
  end
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [h, p, stats] = fishertest(x, varargin)
  narginchk(1, Inf);
  nargoutchk(0, 3);
  opts = parseOptionsLocal(convertStringToCharArgs(varargin));
  tableCounts = validateTableLocal(x);
  p = fisherPValueLocal(tableCounts, opts.Tail);
  h = p <= opts.Alpha;
  oddsRatio = oddsRatioLocal(tableCounts);
  ci = confidenceIntervalLocal(tableCounts, opts.Alpha, oddsRatio);
  stats = struct('OddsRatio', oddsRatio, 'ConfidenceInterval', ci);
end
%=============================================================================
function opts = parseOptionsLocal(args)
  opts = struct('Alpha', 0.05, 'Tail', 'both');
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  for k = 1:2:length(args)
    if ~isTextScalarLocal(args{k})
      error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Name');
    end
    name = lower(char(args{k}));
    switch name
      case 'alpha'
        opts.Alpha = parseAlphaLocal(args{k + 1});
      case 'tail'
        opts.Tail = parseChoiceLocal(args{k + 1}, {'both', 'right', 'left'}, 'TAIL');
      otherwise
        error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
    end
  end
end
%=============================================================================
function counts = validateTableLocal(x)
  if istable(x)
    x = table2array(x);
  end
  if ~(isnumeric(x) && isreal(x) && isequal(size(x), [2 2]))
    error('Nelson:statistics:x22NumericMatrix', 'X must be a 2-by-2 numeric matrix or table.');
  end
  counts = double(x);
  if any(counts(:) < 0) || any(counts(:) ~= fix(counts(:))) || any(~isfinite(counts(:)))
    error('Nelson:statistics:xContainNonnegativeIntegerCounts', 'X must contain nonnegative integer counts.');
  end
  if sum(counts(:)) == 0
    error('Nelson:statistics:xContainLeastOneObservation', 'X must contain at least one observation.');
  end
end
%=============================================================================
function p = fisherPValueLocal(counts, tail)
  a = counts(1, 1);
  row1 = sum(counts(1, :));
  row2 = sum(counts(2, :));
  col1 = sum(counts(:, 1));
  lo = max(0, col1 - row2);
  hi = min(row1, col1);
  values = lo:hi;
  logp = arrayfun(@(v) hypergeometricLogProbabilityLocal(v, row1, col1, row1 + row2), values);
  probs = exp(logp - max(logp));
  probs = probs / sum(probs);
  observed = probs(values == a);
  switch tail
    case 'right'
      p = sum(probs(values >= a));
    case 'left'
      p = sum(probs(values <= a));
    otherwise
      p = sum(probs(probs <= observed + 100 * eps));
  end
  p = min(max(p, 0), 1);
end
%=============================================================================
function value = hypergeometricLogProbabilityLocal(a, row1, col1, total)
  value = gammaln(col1 + 1) - gammaln(a + 1) - gammaln(col1 - a + 1) ...
    + gammaln(total - col1 + 1) - gammaln(row1 - a + 1) ...
    - gammaln(total - col1 - row1 + a + 1) ...
    - gammaln(total + 1) + gammaln(row1 + 1) + gammaln(total - row1 + 1);
end
%=============================================================================
function value = oddsRatioLocal(counts)
  if counts(1, 2) == 0 || counts(2, 1) == 0
    if counts(1, 1) == 0 || counts(2, 2) == 0
      value = NaN;
    else
      value = Inf;
    end
  else
    value = counts(1, 1) * counts(2, 2) / (counts(1, 2) * counts(2, 1));
  end
end
%=============================================================================
function ci = confidenceIntervalLocal(counts, alpha, oddsRatio)
  if any(counts(:) == 0) || isnan(oddsRatio)
    ci = [-Inf Inf];
    return
  end
  logOdds = log(oddsRatio);
  se = sqrt(sum(1 ./ counts(:)));
  z = norminv(1 - alpha / 2, 0, 1);
  ci = exp([logOdds - z * se, logOdds + z * se]);
end
%=============================================================================
function value = parseAlphaLocal(value)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) ...
      && value > 0 && value < 1)
    error('Nelson:statistics:alphaOutOfRange', '%s must be a scalar in the range (0,1).', 'ALPHA');
  end
  value = double(value);
end
%=============================================================================
function value = parseChoiceLocal(value, choices, name)
  if ~isTextScalarLocal(value)
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', name);
  end
  text = lower(char(value));
  matches = choices(startsWith(choices, text));
  if length(matches) ~= 1
    error('Nelson:statistics:invalidValue:valueHasUnsupportedValue', '%s has an unsupported value.', name);
  end
  value = matches{1};
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function mdl = fitcdiscr(X, Y, varargin)
  narginchk(2, Inf);
  nargoutchk(0, 1);
  [X, yIndex, classNames] = __classification_training_data__(X, Y);
  if rem(length(varargin), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  opts = parseOptionsLocal(varargin, classNames);
  [yIndex, classNames] = __reorder_class_names__(yIndex, classNames, opts.ClassNames);
  prior = priorLocal(opts.Prior, yIndex, length(classNames));
  [mu, Sigma] = fitDiscriminantParametersLocal(X, yIndex, length(classNames), opts);
  mdl = ClassificationDiscriminant();
  mdl.ClassNames = classNames;
  mdl.Prior = prior;
  mdl.Mu = mu;
  mdl.Sigma = Sigma;
  mdl.DiscrimType = opts.DiscrimType;
  mdl.Gamma = opts.Gamma;
  mdl.Delta = opts.Delta;
  mdl.NumObservations = size(X, 1);
  mdl.NumPredictors = size(X, 2);
end
%=============================================================================
function opts = parseOptionsLocal(args, classNames)
  opts = struct('ClassNames', {classNames}, 'Prior', 'empirical', ...
    'DiscrimType', 'linear', 'Gamma', 0, 'Delta', 0);
  for k = 1:2:length(args)
    name = __option_name__(args{k}, {'classnames', 'prior', 'discrimtype', 'gamma', 'delta'});
    value = args{k + 1};
    switch name
      case 'classnames'
        opts.ClassNames = __class_names__(value, classNames);
      case 'prior'
        opts.Prior = priorOptionLocal(value, length(classNames));
      case 'discrimtype'
        opts.DiscrimType = discrimTypeLocal(value);
      case 'gamma'
        opts.Gamma = scalarRangeLocal(value, 'Gamma');
      case 'delta'
        opts.Delta = nonnegativeScalarLocal(value, 'Delta');
    end
  end
end
%=============================================================================
function [mu, Sigma] = fitDiscriminantParametersLocal(X, yIndex, kClasses, opts)
  p = size(X, 2);
  mu = zeros(kClasses, p);
  classSigma = zeros(p, p, kClasses);
  counts = zeros(1, kClasses);
  for j = 1:kClasses
    xj = X(yIndex == j, :);
    counts(j) = size(xj, 1);
    if counts(j) <= 1
      error('Nelson:statistics:classContainLeastTwoObservations', 'Each class must contain at least two observations.');
    end
    mu(j, :) = mean(xj, 1);
    centered = xj - repmat(mu(j, :), counts(j), 1);
    classSigma(:, :, j) = centered' * centered / max(counts(j) - 1, 1);
  end
  Sigma = covarianceForTypeLocal(classSigma, counts, opts);
end
%=============================================================================
function Sigma = covarianceForTypeLocal(classSigma, counts, opts)
  pooled = pooledCovarianceLocal(classSigma, counts);
  switch opts.DiscrimType
    case 'linear'
      Sigma = regularizeCovarianceLocal(pooled, opts);
      Sigma = reshape(Sigma, size(Sigma, 1), size(Sigma, 2), 1);
    case 'diaglinear'
      Sigma = diag(diag(regularizeCovarianceLocal(pooled, opts)));
      Sigma = reshape(Sigma, size(Sigma, 1), size(Sigma, 2), 1);
    case 'quadratic'
      Sigma = regularizePagesLocal(classSigma, opts, false);
    otherwise
      Sigma = regularizePagesLocal(classSigma, opts, true);
  end
end
%=============================================================================
function S = pooledCovarianceLocal(classSigma, counts)
  totalDf = sum(counts - 1);
  S = zeros(size(classSigma, 1), size(classSigma, 2));
  for j = 1:length(counts)
    S = S + classSigma(:, :, j) * (counts(j) - 1);
  end
  S = S / totalDf;
end
%=============================================================================
function pages = regularizePagesLocal(pages, opts, diagonalOnly)
  for j = 1:size(pages, 3)
    S = regularizeCovarianceLocal(pages(:, :, j), opts);
    if diagonalOnly
      S = diag(diag(S));
    end
    pages(:, :, j) = S;
  end
end
%=============================================================================
function S = regularizeCovarianceLocal(S, opts)
  if opts.Gamma > 0
    D = diag(diag(S));
    S = (1 - opts.Gamma) * S + opts.Gamma * D;
  end
  scale = max(mean(diag(S)), eps);
  S = S + (opts.Delta + 1e-9 * scale) * eye(size(S));
end
%=============================================================================
function prior = priorLocal(option, yIndex, kClasses)
  if ischar(option)
    if strcmp(option, 'uniform')
      prior = ones(1, kClasses) / kClasses;
    else
      counts = zeros(1, kClasses);
      for j = 1:kClasses
        counts(j) = sum(yIndex == j);
      end
      prior = counts / sum(counts);
    end
  else
    prior = double(option(:).');
    prior = prior / sum(prior);
  end
end
%=============================================================================
function value = discrimTypeLocal(value)
  if ~(ischar(value) || (isstring(value) && isscalar(value)))
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'DiscrimType');
  end
  text = lower(char(value));
  names = {'linear', 'quadratic', 'diaglinear', 'diagquadratic'};
  exact = names(strcmp(names, text));
  if length(exact) == 1
    value = exact{1};
    return
  end
  matches = names(startsWith(names, text));
  if length(matches) ~= 1
    error('Nelson:statistics:invalidDiscrimTypeValue', 'Invalid %s value.', 'DiscrimType');
  end
  value = matches{1};
end
%=============================================================================
function value = priorOptionLocal(value, kClasses)
  if ischar(value) || (isstring(value) && isscalar(value))
    text = lower(char(value));
    choices = {'empirical', 'uniform'};
    matches = choices(startsWith(choices, text));
    if length(matches) ~= 1
      error('Nelson:statistics:invalidPriorValue', 'Invalid %s value.', 'Prior');
    end
    value = matches{1};
  elseif isnumeric(value) && isreal(value) && isvector(value) && length(value) == kClasses ...
      && all(isfinite(value)) && all(value >= 0) && sum(value) > 0
    value = double(value(:).');
  else
    error('Nelson:statistics:invalidPriorValue', 'Invalid %s value.', 'Prior');
  end
end
%=============================================================================
function value = scalarRangeLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) ...
      && value >= 0 && value <= 1)
    error('Nelson:statistics:mustBeInRange:valueAScalarRange01', '%s must be a scalar in the range [0,1].', name);
  end
  value = double(value);
end
%=============================================================================
function value = nonnegativeScalarLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) && value >= 0)
    error('Nelson:statistics:mustBeNonnegative', '%s must be a nonnegative scalar.', name);
  end
  value = double(value);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function mdl = fitcecoc(X, Y, varargin)
  narginchk(2, Inf);
  nargoutchk(0, 1);
  [X, yIndex, classNames, Yclean] = __classification_training_data__(X, Y);
  if rem(length(varargin), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  opts = parseOptionsLocal(varargin, X, classNames);
  [yIndex, classNames] = __reorder_class_names__(yIndex, classNames, opts.ClassNames);
  learners = trainLearnersLocal(X, yIndex, classNames, Yclean, opts);
  mdl = ClassificationECOC();
  mdl.ClassNames = classNames;
  mdl.BinaryLearners = learners.BinaryLearners;
  mdl.CodingMatrix = learners.CodingMatrix;
  mdl.NumObservations = size(X, 1);
  mdl.NumPredictors = size(X, 2);
  mdl.LearnerOptions = rmfield(opts, 'ClassNames');
end
%=============================================================================
function opts = parseOptionsLocal(args, X, classNames)
  opts = struct('ClassNames', {classNames}, 'KernelFunction', 'linear', ...
    'KernelScale', sqrt(size(X, 2)), 'PolynomialOrder', 3, 'BoxConstraint', 1, ...
    'Standardize', false, 'IterationLimit', 1000, 'Tolerance', 1e-3);
  for k = 1:2:length(args)
    name = __option_name__(args{k}, {'classnames', 'kernelfunction', 'kernelscale', ...
      'polynomialorder', 'boxconstraint', 'standardize', 'iterationlimit', 'tolerance'});
    value = args{k + 1};
    switch name
      case 'classnames'
        opts.ClassNames = __class_names__(value, classNames);
      case 'kernelfunction'
        opts.KernelFunction = kernelFunctionLocal(value);
      case 'kernelscale'
        opts.KernelScale = kernelScaleLocal(value, X);
      case 'polynomialorder'
        opts.PolynomialOrder = positiveIntegerLocal(value, 'PolynomialOrder');
      case 'boxconstraint'
        opts.BoxConstraint = positiveScalarLocal(value, 'BoxConstraint');
      case 'standardize'
        opts.Standardize = logicalScalarLocal(value, 'Standardize');
      case 'iterationlimit'
        opts.IterationLimit = positiveIntegerLocal(value, 'IterationLimit');
      case 'tolerance'
        opts.Tolerance = positiveScalarLocal(value, 'Tolerance');
    end
  end
  if ~isequal(opts.ClassNames, classNames)
    __check_class_names__(classNames, opts.ClassNames, true);
  end
end
%=============================================================================
function learners = trainLearnersLocal(X, yIndex, classNames, Yclean, opts)
  k = length(classNames);
  nLearners = k * (k - 1) / 2;
  binaryLearners = cell(1, nLearners);
  coding = zeros(k, nLearners);
  m = 0;
  for i = 1:k
    for j = i + 1:k
      m = m + 1;
      rows = yIndex == i | yIndex == j;
      pairNames = __labels_from_class_index__(classNames, [i; j], 2);
      binaryLearners{m} = fitcsvm(X(rows, :), Yclean(rows), ...
        'ClassNames', pairNames, 'KernelFunction', opts.KernelFunction, ...
        'KernelScale', opts.KernelScale, 'PolynomialOrder', opts.PolynomialOrder, ...
        'BoxConstraint', opts.BoxConstraint, 'Standardize', opts.Standardize, ...
        'IterationLimit', opts.IterationLimit, 'Tolerance', opts.Tolerance);
      coding(i, m) = -1;
      coding(j, m) = 1;
    end
  end
  learners = struct('BinaryLearners', {binaryLearners}, 'CodingMatrix', coding);
end
%=============================================================================
function name = kernelFunctionLocal(value)
  if ~(ischar(value) || (isstring(value) && isscalar(value)))
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'KernelFunction');
  end
  text = lower(char(value));
  names = {'linear', 'gaussian', 'rbf', 'polynomial'};
  exact = names(strcmp(names, text));
  if length(exact) == 1
    name = exact{1};
  else
    matches = names(startsWith(names, text));
    if length(matches) ~= 1
      error('Nelson:statistics:invalidKernelFunctionValue', 'Invalid %s value.', 'KernelFunction');
    end
    name = matches{1};
  end
  if strcmp(name, 'rbf')
    name = 'gaussian';
  end
end
%=============================================================================
function value = kernelScaleLocal(value, X)
  if ischar(value) || (isstring(value) && isscalar(value))
    if strcmpi(char(value), 'auto')
      value = sqrt(size(X, 2));
      return
    end
  end
  value = positiveScalarLocal(value, 'KernelScale');
end
%=============================================================================
function value = positiveIntegerLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) ...
      && value > 0 && value == fix(value))
    error('Nelson:statistics:mustBePositiveInteger', '%s must be a positive integer scalar.', name);
  end
  value = double(value);
end
%=============================================================================
function value = positiveScalarLocal(value, name)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) && value > 0)
    error('Nelson:statistics:mustBePositive', '%s must be a positive scalar.', name);
  end
  value = double(value);
end
%=============================================================================
function value = logicalScalarLocal(value, name)
  if islogical(value) && isscalar(value)
    return
  end
  if isnumeric(value) && isscalar(value) && (value == 0 || value == 1)
    value = logical(value);
    return
  end
  error('Nelson:statistics:mustBeTrueOrFalse', '%s must be true or false.', name);
end
