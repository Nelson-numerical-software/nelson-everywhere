%=============================================================================
function y = polyvalm(c, x)
  narginchk(2, 2);
  nargoutchk(0, 1);

  if ~(isvector(c) || isempty(c))
    error('Nelson:polyvalm:InvalidP', 'First argument must be a vector.');
  end

  [m, n] = size(x);
  if m ~= n
    error('Nelson:polyvalm:NonSquareMatrix', 'Second argument must be a square matrix.');
  end

  n = length(c);
  r = size(x, 1);
  if (n == 0)
    y = zeros(r, class(x));
  else
    id = eye(r, class(x));
    y = c(1) * id;
    for i = 2:n
      y = y * x + c(i) * id;
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function v = ppval(pp, xq)
  narginchk(2, 2);
  nargoutchk(0, 1);
  if ~isstruct(pp) || ~isfield(pp, 'form') || ~strcmp(pp.form, 'pp')
    error('Nelson:ppval:invalidStructure', 'Piecewise polynomial structure expected.');
  end
  breaks = pp.breaks;
  coefs = pp.coefs;
  pieces = pp.pieces;
  if isfield(pp, 'dim')
    d = prod(pp.dim);
  else
    d = 1;
  end
  order = size(coefs, 2);
  xqSize = size(xq);
  q = xq(:);
  nq = numel(q);
  v = zeros(d, nq) + 0 * coefs(1);
  for k = 1:nq
    x = q(k);
    if x <= breaks(1)
      piece = 1;
    elseif x >= breaks(end)
      piece = pieces;
    else
      piece = find(breaks <= x, 1, 'last');
      if piece > pieces
        piece = pieces;
      end
    end
    dx = x - breaks(piece);
    baseRow = (piece - 1) * d;
    for r = 1:d
      c = coefs(baseRow + r, :);
      val = 0;
      for j = 1:order
        val = val * dx + c(j);
      end
      v(r, k) = val;
    end
  end
  if d == 1
    v = reshape(v, xqSize);
  end
end
