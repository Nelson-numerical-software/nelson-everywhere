function B = squeeze(A)
  if ismatrix(A)
    B = A;
    return
  end
  outputShape = size(A);
  outputShape(outputShape == 1) = [];
  B = reshape(A, matrixShape(outputShape));
end
%=============================================================================
function outputShape = matrixShape(outputShape)
  if isscalar(outputShape)
    outputShape = [outputShape, 1];
  end
end
