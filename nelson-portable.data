%=============================================================================
function mf = memoize(fh)
  narginchk(1, 1);
  nargoutchk(0, 1);
  if ~isa(fh, 'function_handle')
    error('Nelson:memoize:invalidInput', '%s must be a function handle.', 'Input');
  end
  mf = MemoizedFunction(fh);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
