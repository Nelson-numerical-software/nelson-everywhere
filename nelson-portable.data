% LICENCE_BLOCK_END
%=============================================================================
function variable = ltiMergeTfVariable(left, right, fallback)
  if nargin < 3
    fallback = '';
  end
  if strcmp(left.Variable, right.Variable)
    variable = right.Variable;
    return
  end
  if isstatic(left) && ~isstatic(right)
    variable = right.Variable;
    return
  end
  if isstatic(right) && ~isstatic(left)
    variable = left.Variable;
    return
  end
  if strcmp(left.Variable, 'z^-1') || strcmp(right.Variable, 'z^-1')
    variable = 'z^-1';
    return
  end
  switch fallback
    case 'left'
      variable = left.Variable;
    case 'right'
      variable = right.Variable;
    otherwise
      variable = '';
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function timeUnit = ltiMergeTimeUnit(left, right)
  timeUnit = left.TimeUnit;
  if strcmp(left.TimeUnit, right.TimeUnit)
    timeUnit = right.TimeUnit;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function userData = ltiMergeUserData(left, right)
  userData = [];
  if ~isempty(left.UserData) && ~isempty(right.UserData)
    userData = right.UserData;
    return
  end
  if ~isempty(left.UserData)
    userData = left.UserData;
    return
  end
  if ~isempty(right.UserData)
    userData = right.UserData;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function props = ltiPropertyNames(className)
  switch className
    case 'tf'
      props = {'Numerator'; 'Denominator'; 'Variable'; 'IODelay'; ...
        'InputDelay'; 'OutputDelay'; 'InputName'; 'InputUnit'; 'InputGroup'; ...
        'OutputName'; 'OutputUnit'; 'OutputGroup'; 'Notes'; 'UserData'; ...
        'Name'; 'Ts'; 'TimeUnit'; 'SamplingGrid'};
    case 'ss'
      props = {'A'; 'B'; 'C'; 'D'; 'E'; 'Offsets'; 'Scaled'; 'StateName'; ...
        'StatePath'; 'StateUnit'; 'InternalDelay'; 'InputDelay'; 'OutputDelay'; ...
        'InputName'; 'InputUnit'; 'InputGroup'; 'OutputName'; 'OutputUnit'; ...
        'OutputGroup'; 'Notes'; 'UserData'; 'Name'; 'Ts'; 'TimeUnit'; ...
        'SamplingGrid'};
    otherwise
      error('Nelson:control_system:invalidType', '%s expected.', 'LTI model');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function Ts = ltiResolveSampleTime(left, right)
  ltiCheckSampleTimeCompatibility(left, right);
  if isstatic(left)
    Ts = right.Ts;
    return
  end
  if isstatic(right)
    Ts = left.Ts;
    return
  end
  if left.Ts == -1 && right.Ts ~= -1
    Ts = right.Ts;
    return
  end
  if right.Ts == -1 && left.Ts ~= -1
    Ts = left.Ts;
    return
  end
  Ts = left.Ts;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function value = ltiSelectIOProperty(value, indices, dim)
  if nargin > 2
    if length(indices) < dim
      return
    end
    indices = indices{dim};
  end
  if isempty(value) || ~iscell(value) || ischar(indices)
    return
  end
  value = value(indices);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function value = ltiSubscriptGet(obj, name)
  className = class(obj);
  switch className
    case 'tf'
      value = getTfProperty(obj, name);
    case 'ss'
      value = getSsProperty(obj, name);
    otherwise
      error('Nelson:control_system:unknownProperty', 'No property of the class ''%s'' matches the identifier ''%s''.', className, name);
  end
end
%=============================================================================
function value = getTfProperty(obj, name)
  switch name
    case 'Numerator'
      value = obj.Numerator;
    case 'Denominator'
      value = obj.Denominator;
    case 'Variable'
      value = obj.Variable;
    case 'IODelay'
      value = obj.IODelay;
    case 'InputDelay'
      value = obj.InputDelay;
    case 'OutputDelay'
      value = obj.OutputDelay;
    case 'InputName'
      value = obj.InputName;
    case 'InputUnit'
      value = obj.InputUnit;
    case 'InputGroup'
      value = obj.InputGroup;
    case 'OutputName'
      value = obj.OutputName;
    case 'OutputUnit'
      value = obj.OutputUnit;
    case 'OutputGroup'
      value = obj.OutputGroup;
    case 'Notes'
      value = obj.Notes;
    case 'UserData'
      value = obj.UserData;
    case 'Name'
      value = obj.Name;
    case 'Ts'
      value = obj.Ts;
    case 'TimeUnit'
      value = obj.TimeUnit;
    case 'SamplingGrid'
      value = obj.SamplingGrid;
    case 'Internal'
      value = obj.Internal;
    otherwise
      error('Nelson:control_system:unknownProperty', 'No property of the class ''%s'' matches the identifier ''%s''.', 'tf', name);
  end
end
%=============================================================================
function value = getSsProperty(obj, name)
  switch name
    case 'A'
      value = obj.A;
    case 'B'
      value = obj.B;
    case 'C'
      value = obj.C;
    case 'D'
      value = obj.D;
    case 'E'
      value = obj.E;
    case 'Offsets'
      value = obj.Offsets;
    case 'Scaled'
      value = obj.Scaled;
    case 'StateName'
      value = obj.StateName;
    case 'StatePath'
      value = obj.StatePath;
    case 'StateUnit'
      value = obj.StateUnit;
    case 'InternalDelay'
      value = obj.InternalDelay;
    case 'InputDelay'
      value = obj.InputDelay;
    case 'OutputDelay'
      value = obj.OutputDelay;
    case 'InputName'
      value = obj.InputName;
    case 'InputUnit'
      value = obj.InputUnit;
    case 'InputGroup'
      value = obj.InputGroup;
    case 'OutputName'
      value = obj.OutputName;
    case 'OutputUnit'
      value = obj.OutputUnit;
    case 'OutputGroup'
      value = obj.OutputGroup;
    case 'Notes'
      value = obj.Notes;
    case 'UserData'
      value = obj.UserData;
    case 'Name'
      value = obj.Name;
    case 'Ts'
      value = obj.Ts;
    case 'TimeUnit'
      value = obj.TimeUnit;
    case 'SamplingGrid'
      value = obj.SamplingGrid;
    case 'Internal'
      value = obj.Internal;
    otherwise
      error('Nelson:control_system:unknownProperty', 'No property of the class ''%s'' matches the identifier ''%s''.', 'ss', name);
  end
end
