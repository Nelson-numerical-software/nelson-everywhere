% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [n, wn] = cheb1ord(varargin)
  narginchk(4, 4);
  nargoutchk(0, 2);
  wp = varargin{1};
  ws = varargin{2};
  rp = varargin{3};
  rs = varargin{4};
  if length(wp) == 2 && length(ws) == 2
    passband = tan(pi * wp(:).' / 2);
    stopband = tan(pi * ws(:).' / 2);
    if ws(1) < wp(1) && wp(2) < ws(2)
      bandwidth = passband(2) - passband(1);
      center2 = passband(1) * passband(2);
      ratio = min(abs((stopband .^ 2 - center2) ./ (bandwidth * stopband)));
    elseif wp(1) < ws(1) && ws(2) < wp(2)
      bandwidth = stopband(2) - stopband(1);
      center2 = stopband(1) * stopband(2);
      ratio = min(abs((passband .^ 2 - center2) ./ (bandwidth * passband)));
    else
      error('Nelson:signal:inconsistentFrequencies', 'Passband and stopband frequencies are inconsistent.');
    end
    epsilon = sqrt(10 ^ (rp / 10) - 1);
    stopbandFactor = sqrt(10 ^ (rs / 10) - 1);
    n = ceil(acosh(stopbandFactor / epsilon) / acosh(ratio));
    wn = wp;
    return;
  end
  if length(wp) ~= 1 || length(ws) ~= 1
    error('Nelson:dimagree:valueLength', '%s must have the same length.', 'Passband and stopband frequencies');
  end
  passband = tan(pi * wp / 2);
  stopband = tan(pi * ws / 2);
  if ws > wp
    ratio = stopband / passband;
  else
    ratio = passband / stopband;
  end
  epsilon = sqrt(10 ^ (rp / 10) - 1);
  stopbandFactor = sqrt(10 ^ (rs / 10) - 1);
  n = ceil(acosh(stopbandFactor / epsilon) / acosh(ratio));
  wn = wp;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [n, wn] = cheb2ord(varargin)
  narginchk(4, 4);
  nargoutchk(0, 2);
  wp = varargin{1};
  ws = varargin{2};
  rp = varargin{3};
  rs = varargin{4};
  passband = tan(pi * wp / 2);
  stopband = tan(pi * ws / 2);
  passbandFactor = sqrt(10 ^ (rp / 10) - 1);
  stopbandFactor = sqrt(10 ^ (rs / 10) - 1);
  if length(wp) == 1 && length(ws) == 1
    if ws > wp
      ratio = stopband / passband;
    else
      ratio = passband / stopband;
    end
    wn = ws;
  elseif length(wp) == 2 && length(ws) == 2
    if ws(1) < wp(1) && wp(2) < ws(2)
      bandwidth = passband(2) - passband(1);
      center = sqrt(passband(1) * passband(2));
      values = abs((stopband .^ 2 - center ^ 2) ./ (bandwidth * stopband));
    elseif wp(1) < ws(1) && ws(2) < wp(2)
      bandwidth = stopband(2) - stopband(1);
      center = sqrt(stopband(1) * stopband(2));
      values = abs((passband .^ 2 - center ^ 2) ./ (bandwidth * passband));
    else
      error('Nelson:signal:inconsistentFrequencies', 'Passband and stopband frequencies are inconsistent.');
    end
    ratio = min(values);
    wn = ws;
  else
    error('Nelson:dimagree:valueLength', '%s must have the same length.', 'Passband and stopband frequencies');
  end
  n = ceil(acosh(stopbandFactor / passbandFactor) / acosh(ratio));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function w = chebwin(varargin)
  narginchk(1, 2);
  nargoutchk(0, 1);
  m = varargin{1};
  if nargin < 2
    ripple = 100;
  else
    ripple = varargin{2};
  end
  signalValidateWindowLength(m);
  if isempty(m)
    w = zeros(0, 1);
  elseif m == 1
    w = 1;
  else
    tg = 10 ^ (abs(ripple) / 20);
    beta = cosh(acosh(tg) / (m - 1));
    k = (0:m - 1)';
    x = beta * cos(pi * k / m);
    p = signalChebpoly(m - 1, x);
    if mod(m, 2) == 1
      w = real(fft(p));
      w = w(1:m);
      w = [w((m + 1) / 2:m); w(1:(m - 1) / 2)];
    else
      p = p .* exp(complex(0, 1) * pi * k / m);
      w = real(fft(p));
      w = [w(m / 2 + 1:m); w(1:m / 2)];
    end
    w = [w(2:end); w(1)];
    w = w ./ max(w);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = cheby1(varargin)
  narginchk(3, 4);
  nargoutchk(0, 3);
  n = varargin{1};
  rp = varargin{2};
  wn = varargin{3};
  ftype = '';
  if nargin == 4
    ftype = varargin{4};
  end
  mustBeInteger(n);
  mustBePositive(n);
  prototypePoles = signalCheby1PrototypePoles(n, rp);
  if length(wn) ~= 1
    if length(wn) ~= 2
      error('Nelson:signal:invalidCutoffFrequency', 'Cutoff frequency must be a scalar or a two-element vector.');
    end
    if ~(isempty(ftype) || strcmpi(ftype, 'bandpass') || strcmpi(ftype, 'pass') || strcmpi(ftype, 'stop'))
      error('Nelson:signal:cutoffVectorBandpassBandstop', 'Cutoff frequency must be a two-element vector for bandpass and bandstop filters.');
    end
    warped = 2 * tan(pi * wn(:).' / 2);
    bandwidth = warped(2) - warped(1);
    center = sqrt(warped(1) * warped(2));
    analogPoles = zeros(2 * n, 1);
    if strcmpi(ftype, 'stop')
      for k = 1:n
        rootsPair = roots([prototypePoles(k), -bandwidth, prototypePoles(k) * center ^ 2]);
        analogPoles(2 * k - 1:2 * k) = rootsPair;
      end
      analogZeros = [1i * center * ones(n, 1); -1i * center * ones(n, 1)];
      normalizeAt = 1;
    else
      for k = 1:n
        rootsPair = roots([1, -bandwidth * prototypePoles(k), center ^ 2]);
        analogPoles(2 * k - 1:2 * k) = rootsPair;
      end
      analogZeros = zeros(n, 1);
      normalizeAt = exp(1i * 2 * atan(center / 2));
    end
    digitalPoles = (1 + analogPoles / 2) ./ (1 - analogPoles / 2);
    digitalZeros = (1 + analogZeros / 2) ./ (1 - analogZeros / 2);
    if ~strcmpi(ftype, 'stop')
      digitalZeros = [digitalZeros; -ones(n, 1)];
    end
    b = real(poly(digitalZeros));
    a = real(poly(digitalPoles));
    gain = abs(polyval(a, normalizeAt) / polyval(b, normalizeAt));
    if mod(n, 2) == 0
      gain = gain * 10 ^ (-rp / 20);
    end
    b = b * gain;
    if nargout <= 2
      varargout{1} = b;
      if nargout > 1
        varargout{2} = a;
      end
    else
      varargout{1} = digitalZeros;
      varargout{2} = digitalPoles;
      varargout{3} = gain;
    end
    return;
  end
  warped = 2 * tan(pi * wn / 2);
  if ~(isempty(ftype) || strcmpi(ftype, 'low') || strcmpi(ftype, 'high'))
    error('Nelson:signal:cutoffScalarLowpassHighpass', 'Cutoff frequency must be a scalar for lowpass and highpass filters.');
  end
  if strcmpi(ftype, 'high')
    analogPoles = warped ./ prototypePoles;
    zerosArray = ones(n, 1);
    normalizeAt = -1;
  else
    analogPoles = warped * prototypePoles;
    zerosArray = -ones(n, 1);
    normalizeAt = 1;
  end
  digitalPoles = (1 + analogPoles / 2) ./ (1 - analogPoles / 2);
  b = real(poly(zerosArray));
  a = real(poly(digitalPoles));
  gain = real(polyval(a, normalizeAt) / polyval(b, normalizeAt));
  if mod(n, 2) == 0
    gain = gain * 10 ^ (-rp / 20);
  end
  b = b * gain;
  if nargout <= 2
    varargout{1} = b;
    if nargout > 1
      varargout{2} = a;
    end
  else
    varargout{1} = zerosArray;
    varargout{2} = digitalPoles;
    varargout{3} = gain;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = cheby2(varargin)
  narginchk(3, 4);
  nargoutchk(0, 3);
  n = varargin{1};
  rs = varargin{2};
  wn = varargin{3};
  ftype = '';
  if nargin == 4
    ftype = varargin{4};
  end
  mustBeInteger(n);
  mustBePositive(n);
  [prototypeZeros, prototypePoles] = signalCheby2Prototype(n, rs);
  missingZeros = n - length(prototypeZeros);
  if length(wn) ~= 1
    if length(wn) ~= 2
      error('Nelson:signal:invalidCutoffFrequency', 'Cutoff frequency must be a scalar or a two-element vector.');
    end
    if ~(isempty(ftype) || strcmpi(ftype, 'bandpass') || strcmpi(ftype, 'pass') || strcmpi(ftype, 'stop'))
      error('Nelson:signal:cutoffVectorBandpassBandstop', 'Cutoff frequency must be a two-element vector for bandpass and bandstop filters.');
    end
    warped = 2 * tan(pi * wn(:).' / 2);
    bandwidth = warped(2) - warped(1);
    center = sqrt(warped(1) * warped(2));
    analogPoles = zeros(2 * n, 1);
    analogZeros = [];
    if strcmpi(ftype, 'stop')
      for k = 1:n
        rootsPair = roots([prototypePoles(k), -bandwidth, prototypePoles(k) * center ^ 2]);
        analogPoles(2 * k - 1:2 * k) = rootsPair;
      end
      for k = 1:length(prototypeZeros)
        analogZeros = [analogZeros; roots([prototypeZeros(k), -bandwidth, prototypeZeros(k) * center ^ 2])];
      end
      analogZeros = [analogZeros; 1i * center * ones(missingZeros, 1); -1i * center * ones(missingZeros, 1)];
      normalizeAt = 1;
    else
      for k = 1:n
        rootsPair = roots([1, -bandwidth * prototypePoles(k), center ^ 2]);
        analogPoles(2 * k - 1:2 * k) = rootsPair;
      end
      for k = 1:length(prototypeZeros)
        analogZeros = [analogZeros; roots([1, -bandwidth * prototypeZeros(k), center ^ 2])];
      end
      analogZeros = [analogZeros; zeros(missingZeros, 1)];
      digitalZerosAtInfinity = -ones(missingZeros, 1);
      normalizeAt = exp(1i * 2 * atan(center / 2));
    end
    digitalPoles = (1 + analogPoles / 2) ./ (1 - analogPoles / 2);
    digitalZeros = (1 + analogZeros / 2) ./ (1 - analogZeros / 2);
    if ~strcmpi(ftype, 'stop')
      digitalZeros = [digitalZeros; digitalZerosAtInfinity];
    end
    b = real(poly(digitalZeros));
    a = real(poly(digitalPoles));
    gain = abs(polyval(a, normalizeAt) / polyval(b, normalizeAt));
    b = b * gain;
    if nargout <= 2
      varargout{1} = b;
      if nargout > 1
        varargout{2} = a;
      end
    else
      varargout{1} = digitalZeros;
      varargout{2} = digitalPoles;
      varargout{3} = gain;
    end
    return;
  end
  warped = 2 * tan(pi * wn / 2);
  if ~(isempty(ftype) || strcmpi(ftype, 'low') || strcmpi(ftype, 'high'))
    error('Nelson:signal:cutoffScalarLowpassHighpass', 'Cutoff frequency must be a scalar for lowpass and highpass filters.');
  end
  if strcmpi(ftype, 'high')
    analogPoles = warped ./ prototypePoles;
    analogZeros = warped ./ prototypeZeros;
    analogZeros = [analogZeros; zeros(missingZeros, 1)];
    normalizeAt = -1;
  else
    analogPoles = warped * prototypePoles;
    analogZeros = warped * prototypeZeros;
    digitalZerosAtInfinity = -ones(missingZeros, 1);
    normalizeAt = 1;
  end
  digitalPoles = (1 + analogPoles / 2) ./ (1 - analogPoles / 2);
  if strcmpi(ftype, 'high')
    digitalZeros = (1 + analogZeros / 2) ./ (1 - analogZeros / 2);
  else
    digitalZeros = (1 + analogZeros / 2) ./ (1 - analogZeros / 2);
    digitalZeros = [digitalZeros; digitalZerosAtInfinity];
  end
  b = real(poly(digitalZeros));
  a = real(poly(digitalPoles));
  gain = real(polyval(a, normalizeAt) / polyval(b, normalizeAt));
  b = b * gain;
  if nargout <= 2
    varargout{1} = b;
    if nargout > 1
      varargout{2} = a;
    end
  else
    varargout{1} = digitalZeros;
    varargout{2} = digitalPoles;
    varargout{3} = gain;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
