function y = skewness(x, varargin)
  narginchk(1, 3);
  nargoutchk(0, 1);
  y = __moment_stats__(x, 3, varargin{:});
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
