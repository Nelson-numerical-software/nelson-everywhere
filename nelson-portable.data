C = tf([5, 10], [1, 10]);
sys = feedback(G, C, -1);
asserts.isequal(sys.Numerator, {[2 25 51 10]});
asserts.isequal(sys.Denominator, {[11 57 78 40]});
%=============================================================================
G = tf(1, [1 -0.5], 0.2);
sys = feedback(tf(2), G);
asserts.isequal(sys.Ts, 0.2);
