      "render": {
        "type": "image",
        "src": "PlanarDistance.svg"
      },
      "help": "Rigid rod: holds a fixed distance L between the points at frames a and b."
    },
    {
      "type": "PlanarRollingWheel",
      "label": "PlanarRollingWheel",
      "acausal": true,
      "domain": "planar",
      "width": 90,
      "height": 70,
