%=============================================================================
function applyContourAxesState(ax, h)
  limits = [min(h.XData(:)), max(h.XData(:)), min(h.YData(:)), max(h.YData(:))];
  if isempty(limits)
    return
  end
  axis(ax, limits);
  if strcmp(ax.XTickMode, 'auto')
    ticks = contourAxisTicks(limits(1:2), contourAxisTarget(ax, true, limits(1:2)));
    if ~isempty(ticks)
      ax.XTick = ticks;
    end
  end
  if strcmp(ax.YTickMode, 'auto')
    ticks = contourAxisTicks(limits(3:4), contourAxisTarget(ax, false, limits(3:4)));
    if ~isempty(ticks)
      ax.YTick = ticks;
    end
  end
end
%=============================================================================
function ticks = contourAxisTicks(limits, targetIntervals)
  ticks = [];
  span = diff(limits);
  if ~isfinite(span) || span <= 0
    return
  end
  step = contourNiceStep(span / targetIntervals);
  first = ceil(limits(1) / step) * step;
  last = floor(limits(2) / step) * step;
  ticks = first:step:last;
  ticks(abs(ticks) < step * 1e-10) = 0;
end
%=============================================================================
function targetIntervals = contourAxisTarget(ax, horizontalAxis, limits)
  span = diff(limits);
  if horizontalAxis
    targetIntervals = 9;
    if span > 10 && span <= 15
      targetIntervals = 6;
    end
    if ax.Position(3) < 0.5
      if span <= 2.5 || span > 20
        targetIntervals = 4;
      else
        targetIntervals = 3;
      end
    end
    return
  end
  targetIntervals = 9;
  if span > 10 && span <= 15
    targetIntervals = 6;
  end
  if ax.Position(4) < 0.5
    if span <= 2.5 || span > 20
      targetIntervals = 10;
    else
      targetIntervals = 6;
    end
  end
end
%=============================================================================
function step = contourNiceStep(value)
  if ~isfinite(value) || value <= 0
    step = 1;
    return
  end
  scale = 10 ^ floor(log10(value));
  normalized = value / scale;
  if normalized < sqrt(2)
    nice = 1;
  elseif normalized < sqrt(10)
    nice = 2;
  elseif normalized <= 5.8
    nice = 5;
  else
    nice = 10;
  end
  step = nice * scale;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% Puts the requested axis ('x', 'y' or 'z') into date mode after data that was
% originally a datetime array has been plotted as serial date numbers. The
% ruler keeps numeric coordinates but the tick labels are formatted as dates,
% so the axis reads as a temporal axis.
function applyDatetimeAxis(parent, whichAxis)
  if isgraphics(parent, 'hggroup')
    ax = ancestor(parent, 'axes');
  else
    ax = parent;
  end
  if isempty(ax) || ~isgraphics(ax, 'axes')
    return
  end
  % Visible labels: datetick pins the ticks/labels to manual date strings (as
  % today). This must run first so the manual label mode is set before the
  % format is stored.
  datetick(ax, whichAxis);
  % Persistent date mode: flip the matching axis into datetime mode and store a
  % sensible display format. The axis surfaces both through its ruler
  % (Axes.XAxis / YAxis / ZAxis), which then reports a DatetimeRuler type/class
  % and this TickLabelFormat, persistently across later updateState re-runs.
  upperAxis = upper(whichAxis);
  scaleKindProperty = [upperAxis, 'AxisScaleKind'];
  formatProperty = [upperAxis, 'TickLabelFormat'];
  limits = get(ax, [upperAxis, 'Lim']);
  set(ax, scaleKindProperty, 'datetime');
  set(ax, formatProperty, defaultDatetimeFormat(limits(2) - limits(1)));
end
%=============================================================================
% Mirrors datetick's span-based default so the stored format matches the visible
% labels. Kept in step with datetick.m's defaultDateFormat.
function fmt = defaultDatetimeFormat(spanDays)
  if spanDays >= 730
    fmt = 'yyyy';
  elseif spanDays >= 62
    fmt = 'mmm-yy';
  elseif spanDays >= 2
    fmt = 'mm/dd';
  elseif spanDays >= 1 / 24
    fmt = 'HH:MM';
  else
    fmt = 'HH:MM:SS';
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function value = automaticIsosurfaceLevel(V)
  finiteValues = V(isfinite(V));
  if isempty(finiteValues)
    value = [];
    return
  end
  minValue = min(finiteValues(:));
  maxValue = max(finiteValues(:));
  if minValue == maxValue
    value = [];
    return
  end
  edges = automaticIsosurfaceEdges(finiteValues, minValue, maxValue);
  counts = automaticIsosurfaceCounts(finiteValues, edges);
  value = medianHistogramLevel(edges, counts);
end
%=============================================================================
function edges = automaticIsosurfaceEdges(values, minValue, maxValue)
  binCount = min(64, max(8, ceil(sqrt(numel(values)))));
  edges = linspace(minValue, maxValue, binCount + 1);
end
%=============================================================================
function counts = automaticIsosurfaceCounts(values, edges)
  binCount = numel(edges) - 1;
  counts = zeros(1, binCount);
  for k = 1:binCount
    if k == binCount
      counts(k) = sum(values >= edges(k) & values <= edges(k + 1));
    else
      counts(k) = sum(values >= edges(k) & values < edges(k + 1));
    end
  end
end
%=============================================================================
function value = medianHistogramLevel(edges, counts)
  target = sum(counts) / 2;
  cumulative = cumsum(counts);
  idx = find(cumulative >= target, 1);
  value = (edges(idx) + edges(idx + 1)) / 2;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
