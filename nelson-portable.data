%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function mu = lin2mu(y)
  % https://en.wikipedia.org/wiki/%CE%9C-law_algorithm
  sample = 32768 .* y;
  polarity = samplePolarity(sample);
  magnitudeCode = compressedMagnitude(abs(sample));
  mu = magnitudeCode + 64 .* polarity;
end
%=============================================================================
function polarity = samplePolarity(sample)
  polarity = sign(sample);
  polarity(sample == 0) = 1;
end
%=============================================================================
function code = compressedMagnitude(sampleMagnitude)
  clippedMagnitude = min(sampleMagnitude, 32635);
  biasedMagnitude = clippedMagnitude + 132;
  exponent = floor(log2(biasedMagnitude)) + 1;
  fraction = biasedMagnitude ./ pow2(exponent);
  code = 335 - 16 .* exponent - fix(32 .* fraction);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = mu2lin(mu)
  % https://en.wikipedia.org/wiki/%CE%9C-law_algorithm
  code = 255 - mu;
  signMask = code > 127;
  segment = floor(code ./ 16);
  exponent = segment - 8 * double(signMask) + 1;
  mantissa = rem(code, 16);
  magnitude = muLawMagnitude(mantissa, exponent);
  y = applyMuLawSign(magnitude, signMask) ./ 32768;
end
%=============================================================================
function magnitude = muLawMagnitude(mantissa, exponent)
  segmentBias = [0 132 396 924 1980 4092 8316 16764];
  bias = exponent;
  bias(:) = segmentBias(exponent);
  magnitude = bias + pow2(mantissa, exponent + 2);
end
%=============================================================================
function y = applyMuLawSign(magnitude, signMask)
  y = magnitude;
  y(signMask) = -y(signMask);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function webAudioPlay(y, fs)
  action = struct();
  action.type = 'audio-buffer-begin';
  action.id = 0;
  action.sampleRate = double(fs);
  action.channels = size(y, 2);
  action.frames = size(y, 1);
  fprintf('%s%s%s\n', '__NELSON_UI_ACTION_BEGIN__', jsonencode(action), '__NELSON_UI_ACTION_END__');

  chunkFrames = 8192;
  for offset = 0:chunkFrames:(action.frames - 1)
    count = min(chunkFrames, action.frames - offset);
    chunk = struct();
    chunk.type = 'audio-buffer-chunk';
    chunk.id = action.id;
    chunk.offset = offset;
    chunk.frames = count;
    samples = y((offset + 1):(offset + count), :);
    chunk.samples = samples(:).';
    fprintf('%s%s%s\n', '__NELSON_UI_ACTION_BEGIN__', jsonencode(chunk), ...
      '__NELSON_UI_ACTION_END__');
  end

  playAction = struct();
  playAction.type = 'audio-buffer-play';
  playAction.id = action.id;
  fprintf('%s%s%s\n', '__NELSON_UI_ACTION_BEGIN__', jsonencode(playAction), ...
    '__NELSON_UI_ACTION_END__');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function sound(varargin)
  narginchk(1, 3);
  y = varargin{1};
  if (~isreal(y) || issparse(y) || ~isfloat(y))
    error('Nelson:sound:invalidAudioData', 'Audio data must be real and floating point.');
  else
    y = double(y);
  end
  if nargin > 1
    fs = varargin{2};
  else
    fs = 8192;
  end
  if nargin > 2
    nbits = varargin{3};
  else
    nbits = 16;
  end
  if (~(isscalar(fs) && (fs > 0)))
    error('Nelson:sound:invalidSampleRate', 'Sample rate FS must be a positive number.');
  end
  isSupportedBits = isscalar(nbits) && ((nbits == 8) || (nbits == 16) || (nbits == 24));
  if (~isSupportedBits)
    error('Nelson:sound:invalidNBits', 'NBITS must be 8, 16, or 24.');
  end
  if (isempty(y))
    return;
  end
  y = max(-1, min(y, 1));
  if ndims(y) > 2
    error('Nelson:sound:requires2D', 'Argument #%d: Requires 2-D values only.', 1);
  end
  if (size(y, 1) == 1)
    y = y.';
  end
  if (exist('audioplayer', 'builtin') == 0)
    webAudioPlay(y, fs);
    return;
  end
  play = audioplayer(y, fs, nbits);
  playblocking(play);
  delete(play);
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function soundsc(varargin)
  narginchk(1, 4);
  y = varargin{1};
  if (~isreal(y) || issparse(y) || ~isfloat(y))
    error('Nelson:sound:invalidAudioData', 'Audio data must be real and floating point.');
  else
    y = double(y);
  end
  if nargin > 1
    fs = varargin{2};
  else
    fs = 8192;
  end
  if nargin > 2
    nbits = varargin{3};
  else
    nbits = 16;
  end
  if nargin > 3
    yrange = varargin{4};
  else
    yrange = [-max(abs(y)), max(abs(y))];
  end

  if (~(isscalar(fs) && (fs > 0)))
    error('Nelson:sound:invalidSampleRate', 'Sample rate FS must be a positive number.');
  end
  isSupportedBits = isscalar(nbits) && ((nbits == 8) || (nbits == 16) || (nbits == 24));
  if (~isSupportedBits)
    error('Nelson:sound:invalidNBits', 'NBITS must be 8, 16, or 24.');
  end
  if (isempty(yrange))
    yrange = [-max(abs(y)), max(abs(y))];
  end
  isMinMaxVector = isreal(yrange) && (numel(yrange) == 2) && (yrange(1) <= yrange(2));
  if ~isMinMaxVector
    error('Nelson:soundsc:invalidRange', 'RANGE must be a 2-element [YMIN, YMAX] vector.');
  end
  ymin = double(yrange(1));
  ymax = double(yrange(2));
  ymedian = (ymax + ymin) / 2;
  yscale = 2 / (ymax - ymin);
  y = (y - ymedian) .* yscale;
  sound(y, fs, nbits);
end
