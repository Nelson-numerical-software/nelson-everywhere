  y = movingWindowApply(x, window, 'max', @maxAlongFirst, varargin{:});
end
%=============================================================================
function y = maxAlongFirst(x, nanflag)
  y = max(x, [], 1);
  if strcmp(nanflag, 'includenan') && isfloat(x)
    y(any(isnan(x), 1)) = NaN;
  end
end
