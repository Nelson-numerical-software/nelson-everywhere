%=============================================================================
classdef odeEvent
  properties
    EventFcn = []
    Direction = 'both'
    Response = 'proceed'
    CallbackFcn = []
  end

  methods
    function obj = odeEvent(varargin)
      if nargin == 1 && isa(varargin{1}, 'function_handle')
        obj.EventFcn = varargin{1};
        return
      end
      if mod(nargin, 2) ~= 0
        error('Nelson:ode_solvers:nameValueArgumentsExpected', 'Name-value arguments expected.');
      end
      for k = 1:2:nargin
        name = char(varargin{k});
        obj = odeAssignEventProperty(obj, name, varargin{k + 1});
      end
    end

    function obj = set.EventFcn(obj, value)
      if ~(isempty(value) || isa(value, 'function_handle'))
        error('Nelson:ode_solvers:functionHandleExpected', '%s must be a function handle.', 'Value');
      end
      obj.EventFcn = value;
    end

    function obj = set.Direction(obj, value)
      obj.Direction = odeValidateEventChoice(value, 'Direction', {'both', 'increasing', 'decreasing'});
    end

    function obj = set.Response(obj, value)
      obj.Response = odeValidateEventChoice(value, 'Response', {'proceed', 'stop', 'callback'});
    end

    function obj = set.CallbackFcn(obj, value)
      if ~(isempty(value) || isa(value, 'function_handle'))
        error('Nelson:ode_solvers:functionHandleExpected', '%s must be a function handle.', 'Value');
      end
      obj.CallbackFcn = value;
    end
  end
end
%=============================================================================
function obj = odeAssignEventProperty(obj, name, value)
  switch lower(name)
    case 'eventfcn'
      if ~(isempty(value) || isa(value, 'function_handle'))
        error('Nelson:ode_solvers:functionHandleExpected', '%s must be a function handle.', 'Value');
      end
      obj.EventFcn = value;
    case 'direction'
      obj.Direction = odeValidateEventChoice(value, 'Direction', {'both', 'increasing', 'decreasing'});
    case 'response'
      obj.Response = odeValidateEventChoice(value, 'Response', {'proceed', 'stop', 'callback'});
    case 'callbackfcn'
      if ~(isempty(value) || isa(value, 'function_handle'))
        error('Nelson:ode_solvers:functionHandleExpected', '%s must be a function handle.', 'Value');
      end
      obj.CallbackFcn = value;
    otherwise
      error('Nelson:ode_solvers:unknownEventProperty', 'Unknown %s property.', 'event');
  end
end
%=============================================================================
function value = odeValidateEventChoice(value, name, choices)
  if isstring(value)
    if isscalar(value)
      value = char(value);
    else
      values = cell(numel(value), 1);
      for k = 1:numel(value)
        values{k} = odeValidateEventChoiceOne(char(value(k)), name, choices);
      end
      value = values;
      return
    end
  end
  if iscell(value)
    values = cell(numel(value), 1);
    for k = 1:numel(value)
      values{k} = odeValidateEventChoiceOne(value{k}, name, choices);
    end
    value = values;
    return
  end
  if ischar(value) && size(value, 1) > 1
    values = cell(size(value, 1), 1);
    for k = 1:size(value, 1)
      values{k} = odeValidateEventChoiceOne(deblank(value(k, :)), name, choices);
    end
    value = values;
    return
  end
  value = odeValidateEventChoiceOne(value, name, choices);
end
%=============================================================================
function value = odeValidateEventChoiceOne(value, name, choices)
  if isstring(value)
    value = char(value);
  end
  if ~ischar(value)
    error('Nelson:ode_solvers:invalidValue', '%s has an invalid value.', name);
  end
  for k = 1:length(choices)
    if strcmpi(value, choices{k})
      value = choices{k};
      return
    end
  end
  error('Nelson:ode_solvers:invalidValue', '%s has an invalid value.', name);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
classdef odeJacobian
  properties
    Jacobian = []
    SparsityPattern = []
  end

  properties (Hidden)
    Constant = []
  end

  methods
    function obj = odeJacobian(varargin)
      startIndex = 1;
      if nargin > 0 && ~ischar(varargin{1}) && ~isstring(varargin{1})
        value = varargin{1};
        if iscell(value)
          odeValidateJacobianCell(value);
        elseif ~(isempty(value) || isnumeric(value) || isa(value, 'function_handle'))
          error('Nelson:ode_solvers:invalidType:valueNumericAFunctionHandle', '%s must be numeric or a function handle.', 'Jacobian');
        end
        obj.Jacobian = value;
        startIndex = 2;
      end
      if mod(nargin - startIndex + 1, 2) ~= 0
        error('Nelson:ode_solvers:nameValueArgumentsExpected', 'Name-value arguments expected.');
      end
      for k = startIndex:2:nargin
        name = char(varargin{k});
        obj = odeAssignJacobianProperty(obj, name, varargin{k + 1});
      end
    end

    function obj = set.Jacobian(obj, value)
      if iscell(value)
        odeValidateJacobianCell(value);
      elseif ~(isempty(value) || isnumeric(value) || isa(value, 'function_handle'))
        error('Nelson:ode_solvers:invalidType:valueNumericAFunctionHandle', '%s must be numeric or a function handle.', 'Jacobian');
      end
      obj.Jacobian = value;
    end

    function obj = set.SparsityPattern(obj, value)
      odeValidateJacobianPattern(value);
      obj.SparsityPattern = value;
    end

    function obj = set.Constant(obj, value)
      odeValidateJacobianConstant(value);
      obj.Constant = value;
    end
  end
end
%=============================================================================
function obj = odeAssignJacobianProperty(obj, name, value)
  switch lower(name)
    case 'jacobian'
      obj.Jacobian = value;
    case {'sparsitypattern', 'pattern'}
      odeValidateJacobianPattern(value);
      obj.SparsityPattern = value;
    case 'constant'
      obj.Constant = odeValidateJacobianConstant(value);
    otherwise
      error('Nelson:ode_solvers:unknownJacobianProperty', 'Unknown %s property.', 'Jacobian');
  end
end
%=============================================================================
function odeValidateJacobianPattern(value)
  if iscell(value)
    odeValidatePatternCell(value);
  elseif ~(isempty(value) || isnumeric(value) || islogical(value))
    error('Nelson:validators:mustBeNumericOrLogical', '%s must be numeric or logical.', 'Jacobian pattern');
  end
end
%=============================================================================
function odeValidateJacobianCell(value)
  if numel(value) ~= 2 || ~isnumeric(value{1}) || ~isnumeric(value{2})
    error('Nelson:ode_solvers:invalidType:valueNumericAFunctionHandle', '%s must be numeric or a function handle.', 'Jacobian');
  end
end
%=============================================================================
function odeValidatePatternCell(value)
  if numel(value) ~= 2 ...
      || ~(isnumeric(value{1}) || islogical(value{1})) ...
      || ~(isnumeric(value{2}) || islogical(value{2}))
    error('Nelson:validators:mustBeNumericOrLogical', '%s must be numeric or logical.', 'Jacobian pattern');
  end
end
%=============================================================================
function value = odeValidateJacobianConstant(value)
  if isempty(value)
    value = [];
    return
  end
  if isstring(value)
    value = char(value);
  end
  if ~ischar(value) || ~(strcmpi(value, 'on') || strcmpi(value, 'off'))
    error('Nelson:ode_solvers:jacobianConstantFlagOff', 'Jacobian constant flag must be ''on'' or ''off''.');
  end
  if strcmpi(value, 'on')
    value = 'on';
  else
    value = 'off';
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
classdef odeMassMatrix
  properties
    MassMatrix = []
    Singular = 'maybe'
    StateDependence = 'weak'
    SparsityPattern = []
  end

  methods
    function obj = odeMassMatrix(varargin)
      startIndex = 1;
      hasMassMatrix = false;
      hasSingular = false;
      hasStateDependence = false;
      if nargin > 0 && ~ischar(varargin{1}) && ~isstring(varargin{1})
        value = varargin{1};
        if ~(isempty(value) || isnumeric(value) || isa(value, 'function_handle'))
          error('Nelson:ode_solvers:invalidType:valueNumericAFunctionHandle', '%s must be numeric or a function handle.', 'Mass matrix');
        end
        obj.MassMatrix = value;
        hasMassMatrix = true;
        startIndex = 2;
      end
      if mod(nargin - startIndex + 1, 2) ~= 0
        error('Nelson:ode_solvers:nameValueArgumentsExpected', 'Name-value arguments expected.');
      end
      for k = startIndex:2:nargin
        name = char(varargin{k});
        lname = lower(name);
        hasMassMatrix = hasMassMatrix || strcmp(lname, 'massmatrix');
        hasSingular = hasSingular || strcmp(lname, 'singular') || strcmp(lname, 'masssingular');
        hasStateDependence = hasStateDependence ...
          || strcmp(lname, 'statedependence') || strcmp(lname, 'mstatedependence');
        obj = odeAssignMassProperty(obj, name, varargin{k + 1});
      end
      obj = odeApplyMassDefaults(obj, hasMassMatrix, hasSingular, hasStateDependence);
    end

    function obj = set.MassMatrix(obj, value)
      if ~(isempty(value) || isnumeric(value) || isa(value, 'function_handle'))
        error('Nelson:ode_solvers:invalidType:valueNumericAFunctionHandle', '%s must be numeric or a function handle.', 'Mass matrix');
      end
      obj.MassMatrix = value;
    end

    function obj = set.Singular(obj, value)
      obj.Singular = odeValidateMassChoice(value, 'Singular', {'yes', 'no', 'maybe'});
    end

    function obj = set.StateDependence(obj, value)
      obj.StateDependence = odeValidateMassChoice(value, 'StateDependence', {'none', 'weak', 'strong'});
    end

    function obj = set.SparsityPattern(obj, value)
      odeValidateMassPattern(value);
      obj.SparsityPattern = value;
    end
  end
end
%=============================================================================
function obj = odeApplyMassDefaults(obj, hasMassMatrix, hasSingular, hasStateDependence)
  if ~hasMassMatrix || isempty(obj.MassMatrix)
    return
  end
  if isnumeric(obj.MassMatrix)
    if ~hasStateDependence
      obj.StateDependence = 'none';
    end
    if ~hasSingular
      obj.Singular = odeMassSingularDefault(obj.MassMatrix);
    end
  elseif isa(obj.MassMatrix, 'function_handle') && ~hasStateDependence
    if nargin(obj.MassMatrix) <= 1
      obj.StateDependence = 'none';
    end
  end
end
%=============================================================================
function value = odeMassSingularDefault(M)
  if isscalar(M)
    if M == 0
      value = 'yes';
    else
      value = 'no';
    end
    return
  end
  if size(M, 1) ~= size(M, 2)
    value = 'maybe';
  elseif rank(M) < size(M, 2)
    value = 'yes';
  else
    value = 'no';
  end
end
%=============================================================================
function obj = odeAssignMassProperty(obj, name, value)
  switch lower(name)
    case {'singular', 'masssingular'}
      obj.Singular = odeValidateMassChoice(value, 'MassSingular', {'yes', 'no', 'maybe'});
    case {'statedependence', 'mstatedependence'}
      obj.StateDependence = odeValidateMassChoice(value, 'MStateDependence', {'none', 'weak', 'strong'});
    case {'sparsitypattern', 'mvpattern'}
      odeValidateMassPattern(value);
      obj.SparsityPattern = value;
    case 'massmatrix'
      obj.MassMatrix = value;
    otherwise
      error('Nelson:ode_solvers:unknownMassMatrixProperty', 'Unknown %s property.', 'mass matrix');
  end
end
%=============================================================================
function value = odeValidateMassChoice(value, name, choices)
  if isempty(value)
    value = [];
    return
  end
  if isstring(value)
    value = char(value);
  end
  if ~ischar(value)
    error('Nelson:ode_solvers:invalidValue', '%s has an invalid value.', name);
  end
  valid = false;
  for k = 1:length(choices)
    if strcmpi(value, choices{k})
      value = choices{k};
      valid = true;
      break
    end
  end
  if ~valid
    error('Nelson:ode_solvers:invalidValue', '%s has an invalid value.', name);
  end
end
%=============================================================================
function odeValidateMassPattern(value)
  if ~(isempty(value) || isnumeric(value) || islogical(value))
    error('Nelson:validators:mustBeNumericOrLogical', '%s must be numeric or logical.', 'Mass vector pattern');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
classdef odeSensitivity
  properties
    Method = 'direct'
    ParameterIndices = []
    Jacobian = []
    InitialValue = []
    InitialSlope = []
    ObjectiveFcn = []
    QuadratureFcn = []
    ObjectiveTime = []
    AdjointRelativeTolerance = []
    AdjointAbsoluteTolerance = []
  end

  methods
    function obj = odeSensitivity(varargin)
      if mod(nargin, 2) ~= 0
        error('Nelson:ode_solvers:nameValueArgumentsExpected', 'Name-value arguments expected.');
      end
      for k = 1:2:nargin
        name = varargin{k};
        if isstring(name)
          name = char(name);
        end
        obj = odeAssignSensitivityProperty(obj, name, varargin{k + 1});
      end
    end

    function obj = set.Method(obj, value)
      obj.Method = odeNormalizeSensitivityMethod(value);
    end

    function obj = set.ParameterIndices(obj, value)
      obj.ParameterIndices = odeNormalizeParameterIndices(value);
    end

    function obj = set.Jacobian(obj, value)
      if isempty(value) || isa(value, 'odeJacobian')
        obj.Jacobian = value;
      else
        obj.Jacobian = odeJacobian(value);
      end
    end

    function obj = set.InitialValue(obj, value)
      obj.InitialValue = odeNormalizeSensitivityInitial(value, 'InitialValue');
    end

    function obj = set.InitialSlope(obj, value)
      obj.InitialSlope = odeNormalizeSensitivityInitial(value, 'InitialSlope');
    end

    function obj = set.ObjectiveFcn(obj, value)
      obj.ObjectiveFcn = odeNormalizeSensitivityFunction(value, 'ObjectiveFcn');
    end

    function obj = set.QuadratureFcn(obj, value)
      obj.QuadratureFcn = odeNormalizeSensitivityFunction(value, 'QuadratureFcn');
    end

    function obj = set.ObjectiveTime(obj, value)
      obj.ObjectiveTime = odeNormalizeObjectiveTime(value);
    end

    function obj = set.AdjointRelativeTolerance(obj, value)
      obj.AdjointRelativeTolerance = odeNormalizeAdjointTolerance(value, 'AdjointRelativeTolerance');
    end

    function obj = set.AdjointAbsoluteTolerance(obj, value)
      obj.AdjointAbsoluteTolerance = odeNormalizeAdjointTolerance(value, 'AdjointAbsoluteTolerance');
    end
  end
end

function obj = odeAssignSensitivityProperty(obj, name, value)
  switch lower(name)
    case 'method'
      obj.Method = odeNormalizeSensitivityMethod(value);
    case 'parameterindices'
      obj.ParameterIndices = odeNormalizeParameterIndices(value);
    case 'jacobian'
      obj.Jacobian = value;
    case 'initialvalue'
      obj.InitialValue = odeNormalizeSensitivityInitial(value, 'InitialValue');
    case 'initialslope'
      obj.InitialSlope = odeNormalizeSensitivityInitial(value, 'InitialSlope');
    case 'objectivefcn'
      obj.ObjectiveFcn = odeNormalizeSensitivityFunction(value, 'ObjectiveFcn');
    case 'quadraturefcn'
      obj.QuadratureFcn = odeNormalizeSensitivityFunction(value, 'QuadratureFcn');
    case 'objectivetime'
      obj.ObjectiveTime = odeNormalizeObjectiveTime(value);
    case 'adjointrelativetolerance'
      obj.AdjointRelativeTolerance = odeNormalizeAdjointTolerance(value, 'AdjointRelativeTolerance');
    case 'adjointabsolutetolerance'
      obj.AdjointAbsoluteTolerance = odeNormalizeAdjointTolerance(value, 'AdjointAbsoluteTolerance');
    otherwise
      error('Nelson:ode_solvers:unknownSensitivityProperty', 'Unknown %s property.', 'sensitivity');
  end
end

function value = odeNormalizeSensitivityMethod(value)
  if isstring(value)
    value = char(value);
  end
  if ~ischar(value)
    error('Nelson:ode_solvers:sensitivityMethodDirectAdjoint', 'Sensitivity method must be direct or adjoint.');
  end
  switch lower(value)
    case {'direct', 'forward'}
      value = 'direct';
    case 'adjoint'
      value = 'adjoint';
    otherwise
      error('Nelson:ode_solvers:sensitivityMethodDirectAdjoint', 'Sensitivity method must be direct or adjoint.');
  end
end

function value = odeNormalizeParameterIndices(value)
  if isempty(value)
    value = [];
    return
  end
  if ~isnumeric(value) || ~isreal(value) || any(~isfinite(value(:))) ...
      || any(value(:) ~= fix(value(:))) || any(value(:) < 1)
    error('Nelson:ode_solvers:parameterindicesContainPositiveIntegerValues', 'ParameterIndices must contain positive integer values.');
  end
  value = value(:);
end

function value = odeNormalizeSensitivityInitial(value, name)
  if ~isempty(value) && (~isnumeric(value) || any(~isfinite(value(:))))
    error('Nelson:ode_solvers:mustBeFiniteNumeric', '%s must contain finite numeric values.', name);
  end
end
%=============================================================================
function value = odeNormalizeSensitivityFunction(value, name)
  if ~isempty(value) && ~isa(value, 'function_handle')
    error('Nelson:ode_solvers:functionHandleExpected', '%s must be a function handle.', name);
  end
end
%=============================================================================
function value = odeNormalizeObjectiveTime(value)
  if isempty(value)
    return
  end
  if ~isnumeric(value) || ~isreal(value) || ~isscalar(value) || ~isfinite(value)
    error('Nelson:ode_solvers:mustBeFiniteScalar', '%s must be a finite scalar.', 'ObjectiveTime');
  end
end
%=============================================================================
function value = odeNormalizeAdjointTolerance(value, name)
  if isempty(value)
    return
  end
  if ~isnumeric(value) || ~isreal(value) || ~isscalar(value) || ~isfinite(value) || value <= 0
    error('Nelson:ode_solvers:mustBePositiveFinite', '%s must be a positive finite scalar.', name);
  end
end
