%=============================================================================
function varargout = flag(varargin)
  narginchk(0, 1);
  nargoutchk(0, 1);
  colorCount = requestedColorCount(varargin{:});
  pattern = [1 0 0;
             1 1 1;
             0 0 1;
             0 0 0];
  rowIndex = rem(0:colorCount - 1, size(pattern, 1)) + 1;
  varargout{1} = pattern(rowIndex, :);
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
