%=============================================================================
function display(obj, name)
  if ~isempty(name)
    disp([char(10), name, ' = ', char(10)])
  end
  disp('complexObj_disp:')
  disp('real part');
  disp(obj.r);
  disp('imag part');
  disp(obj.i);
end
