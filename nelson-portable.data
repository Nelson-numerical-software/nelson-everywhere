% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = size(obj, varargin)
  st = struct(obj);
  sz = [localHeight(st), length(st.Properties.VariableNames)];
  if nargin == 1
    if nargout <= 1
      varargout{1} = sz;
    else
      for k = 1:nargout
        if k <= length(sz)
          varargout{k} = sz(k);
        else
          varargout{k} = 1;
        end
      end
    end
  else
    dim = varargin{1};
    if dim <= length(sz)
      varargout{1} = sz(dim);
    else
      varargout{1} = 1;
    end
  end
end
%=============================================================================
function n = localHeight(st)
  names = st.Properties.VariableNames;
  if isempty(names)
    n = 0;
  else
    n = size(st.data.(names{1}), 1);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function obj = subsasgn(obj, sasgn, value)
  if strcmp(sasgn(1).type, '.') && strcmp(sasgn(1).subs, 'Properties')
    if length(sasgn) == 1
      obj.Properties = value;
    else
      props = obj.Properties;
      props = subsasgn(props, sasgn(2:end), value);
      obj.Properties = props;
    end
    return
  end
  if strcmp(sasgn(1).type, '.') && length(sasgn) == 1
    st = struct(obj);
    name = sasgn(1).subs;
    if any(strcmp(st.Properties.VariableNames, name))
      obj.data.(name) = value;
      return
    end
  end
  error('Nelson:eventtable:unsupportedSubscriptType', 'Unsupported %s type.', 'subsasgn');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function R = subsref(obj, sref)
  st = struct(obj);
  switch sref(1).type
    case '.'
      R = localDotSubsref(st, sref);
    case '{}'
      R = localBraceSubsref(st, sref);
    case '()'
      R = localParenSubsref(st, sref);
    otherwise
      error('Nelson:eventtable:unsupportedSubscriptType', 'Unsupported %s type.', 'subsref');
  end
end
%=============================================================================
function R = localDotSubsref(st, sref)
  field = sref(1).subs;
  names = st.Properties.VariableNames;
  if strcmp(field, 'Properties')
    R = st.Properties;
  elseif any(strcmp(names, field))
    R = st.data.(field);
  elseif strcmp(field, st.Properties.DimensionNames{1})
    R = st.Properties.RowNames(:);
  elseif strcmp(field, st.Properties.DimensionNames{2})
    R = localBraceSubsref(st, struct('type', '{}', 'subs', {{':', ':'}}));
  else
    error('Nelson:eventtable:unrecognizedVariable', 'Unrecognized table variable name.');
  end
  if length(sref) > 1
    R = subsref(R, sref(2:end));
  end
end
%=============================================================================
function R = localBraceSubsref(st, sref)
  if length(sref(1).subs) ~= 2
    error('Nelson:eventtable:invalidSubscript', '%s indexing requires row and variable subscripts.', 'Brace');
  end
  rows = localRows(st, sref(1).subs{1});
  vars = localVars(st, sref(1).subs{2});
  R = [];
  for k = 1:length(vars)
    name = st.Properties.VariableNames{vars(k)};
    value = localSliceRows(st.data.(name), rows);
    if isempty(R)
      R = value;
    else
      R = [R, value];
    end
  end
  if length(sref) > 1
    R = subsref(R, sref(2:end));
  end
end
%=============================================================================
function R = localParenSubsref(st, sref)
  if length(sref(1).subs) ~= 2
    error('Nelson:eventtable:invalidSubscript', '%s indexing requires row and variable subscripts.', 'Parentheses');
  end
  rows = localRows(st, sref(1).subs{1});
  vars = localVars(st, sref(1).subs{2});
  names = st.Properties.VariableNames(vars);
  timeName = localEventTimeName(st);
  eventTimes = localSliceRows(st.data.(timeName), rows);
  dataArgs = {};
  dataNames = {};
  for k = 1:length(names)
    name = names{k};
    if strcmp(name, timeName)
      continue
    end
    dataArgs{end + 1} = localSliceRows(st.data.(name), rows);
    dataNames{end + 1} = name;
  end
  eventData = timetable(eventTimes, dataArgs{:}, 'VariableNames', dataNames);
  R = eventtable(eventData);
  R = localApplyProperties(R, st, dataNames);
  if length(sref) > 1
    R = subsref(R, sref(2:end));
  end
end
%=============================================================================
function rows = localRows(st, rows)
  if ischar(rows) && strcmp(rows, ':')
    rows = 1:localHeight(st);
  end
end
%=============================================================================
function vars = localVars(st, vars)
  names = st.Properties.VariableNames;
  if ischar(vars)
    if strcmp(vars, ':')
      vars = 1:length(names);
    else
      vars = find(strcmp(names, vars));
    end
  elseif isstring(vars)
    vars = cellstr(vars);
    vars = localNamesToIndices(names, vars);
  elseif iscellstr(vars)
    vars = localNamesToIndices(names, vars);
  elseif islogical(vars)
    vars = find(vars);
  end
  if isempty(vars)
    error('Nelson:eventtable:unrecognizedVariable', 'Unrecognized table variable name.');
  end
end
%=============================================================================
function indices = localNamesToIndices(names, requested)
  indices = zeros(1, length(requested));
  for k = 1:length(requested)
    idx = find(strcmp(names, requested{k}));
    if isempty(idx)
      error('Nelson:eventtable:unrecognizedVariable', 'Unrecognized table variable name.');
    end
    indices(k) = idx(1);
  end
end
%=============================================================================
function value = localSliceRows(value, rows)
  if ischar(rows) && strcmp(rows, ':')
    rows = 1:size(value, 1);
  end
  if isvector(value)
    value = value(rows);
    value = value(:);
  else
    value = value(rows, :);
  end
end
%=============================================================================
function n = localHeight(st)
  names = st.Properties.VariableNames;
  if isempty(names)
    n = 0;
  else
    n = size(st.data.(names{1}), 1);
  end
end
%=============================================================================
function timeName = localEventTimeName(st)
  timeName = 'Time';
  if isfield(st.Properties, 'CustomProperties') ...
      && isfield(st.Properties.CustomProperties, 'EventTimeVariable')
    timeName = st.Properties.CustomProperties.EventTimeVariable;
  end
end
%=============================================================================
function R = localApplyProperties(R, st, dataNames)
  props = R.Properties;
  props.Description = st.Properties.Description;
  props.UserData = st.Properties.UserData;
  props.CustomProperties = st.Properties.CustomProperties;
  if isfield(props.CustomProperties, 'EventLabelsVariable') ...
      && ~any(strcmp(dataNames, props.CustomProperties.EventLabelsVariable))
    props.CustomProperties.EventLabelsVariable = '';
  end
  if isfield(props.CustomProperties, 'EventLengthsVariable') ...
      && ~any(strcmp(dataNames, props.CustomProperties.EventLengthsVariable))
    props.CustomProperties.EventLengthsVariable = '';
  end
  if isfield(props.CustomProperties, 'EventEndsVariable') ...
      && ~any(strcmp(dataNames, props.CustomProperties.EventEndsVariable))
    props.CustomProperties.EventEndsVariable = '';
  end
  R.Properties = props;
end
