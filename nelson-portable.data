% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = xcorr2(varargin)
  narginchk(1, 2);
  nargoutchk(0, 1);
  A = varargin{1};
  if nargin == 1
    B = A;
  else
    B = varargin{2};
  end
  varargout{1} = conv2(A, rot90(conj(B), 2));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = xcov(varargin)
  narginchk(1, 4);
  nargoutchk(0, 2);

  xInput = varargin{1};
  if isvector(xInput)
    x = xInput(:) - mean(xInput(:));
  else
    x = xInput - mean(xInput, 1);
  end
  args = varargin(2:end);
  if ~isempty(args) && ~(ischar(args{1}) || isstring(args{1})) && ~isscalar(args{1})
    y = args{1};
    args{1} = y(:) - mean(y(:));
    [c, lags] = xcorr(x, args{:});
  else
    [c, lags] = xcorr(x, args{:});
  end

  if size(xInput, 1) == 1
    c = c.';
    lags = lags.';
  end

  varargout{1} = c;
  if nargout > 1
    varargout{2} = lags;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function sos = zp2sos(varargin)
  narginchk(3, 3);
  nargoutchk(0, 1);
  z = varargin{1};
  p = varargin{2};
  k = varargin{3};
  z = z(:);
  p = p(:);
  sectionCount = max(1, ceil(max(length(z), length(p)) / 2));
  sos = zeros(sectionCount, 6);
  gain = prod(k(:));
  for section = 1:sectionCount
    zi = signalTakePair(z, section);
    pi = signalTakePair(p, section);
    b = real(poly(zi));
    a = real(poly(pi));
    b = [zeros(1, 3 - length(b)), b];
    a = [zeros(1, 3 - length(a)), a];
    if section == 1
      b = b * gain;
    end
    sos(section, :) = [b, a];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = zp2tf(varargin)
  narginchk(3, 3);
  nargoutchk(0, 2);
  zerosArray = varargin{1};
  polesArray = varargin{2};
  gain = varargin{3};
  if ~isvector(gain)
    error('Nelson:validators:mustBeVector', '%s must be a vector.', 'Third argument');
  end

  denominator = findDenominator(polesArray);
  varargout{1} = findNumerator(zerosArray, gain, denominator);

  if (nargout > 1)
    varargout{2} = denominator;
  end
end
%=============================================================================
function denominator = findDenominator(polesArray)
  denominator = real(poly(polesArray(:)));
end
%=============================================================================
function numerator = findNumerator(zerosArray, gain, denominator)
  numerator = [];
  denominator_cols = size(denominator, 2);
  gain = gain(:);
  gain_rows = size(gain, 1);
  if isempty(zerosArray)
    if (denominator_cols - 1 > 0)
      numerator = [zeros(gain_rows, denominator_cols - 1), gain];
    else
      numerator = gain;
    end
  else
    [zeros_rows, zeros_cols] = size(zerosArray);
    if (gain_rows ~= zeros_cols)
      if ((zeros_rows - 1) ~= 0)
        error('Nelson:dimagree:inputArgumentNNShouldColumn', 'Input argument #%d and #%d should have the same column size.', 1, 3);
      else
        error('Nelson:validators:mustBeColumn', '%s must be a column vector.', 'First argument');
      end
    else
      numerator = findNumeratorStandardImpl(zerosArray, zeros_cols, gain, denominator_cols);
    end
  end
end
%=============================================================================
function numerator = findNumeratorStandardImpl(zerosArray, zeros_cols, gain, denominator_cols)
  numerator = [];
  for nidx = 1:zeros_cols
    zeros_index = zerosArray(:, nidx);
    poles_index = real(poly(zeros_index) * gain(nidx));
    zeros_rows = zeros(1, denominator_cols - length(poles_index));
    if isempty(numerator)
      numerator = [zeros_rows, poles_index];
    else
      numerator(nidx, :) = [zeros_rows, poles_index];
    end
  end
end
