function varargout = xmldocchecker(varargin)
    narginchk(0, 1);
    nargoutchk(0, 3);
    varargout = {};
    if nargin == 0
        modules_path = [nelsonroot(), '/modules/'];
        module_list = get_modules_help_list();
        disp(_('Checking XML documentation...'));
        for i = 1:length(module_list)
            module_name = module_list{i};
            for lang = getavailablelanguages()'
                help_path = [modules_path, module_name, '/help/', lang{1}, '/xml/'];
                if isdir(help_path)
                    xmlfiles = dir([help_path, '/*.xml'], '-s');
                    for j = 1:length(xmlfiles)
                        xmlfile = [xmlfiles(j).folder, '/', xmlfiles(j).name];
                        switch nargout()
                        case 0
                            try
                              xmldocchecker(xmlfile);
                              msg = sprintf(_('XML documentation file "%s" is valid.'), xmlfile);
                              disp(msg);
                            catch ME
                                msg = sprintf('XML documentation file "%s" is invalid.', xmlfile);
                                disp(msg);
                                throw(ME);
                            end
                        case 1
                            state = xmldocchecker(xmlfile);
                            if ~state
                                varargout{1} = state;
                                return
                            end
                        case 2
                            [state, errors_detected] = xmldocchecker(xmlfile);
                            if ~state
                                varargout{1} = state;
                                varargout{2} = errors_detected;
                                return
                            end
                        case 3
                            [state, errors_detected, warnings_detected] = xmldocchecker(xmlfile);
                            if ~state
                                varargout{1} = state;
                                varargout{2} = errors_detected;
                                varargout{3} = warnings_detected;
                                return
                            end
                        otherwise
                            varargout = {};
                        end
                    end
                end
            end
        end
        switch nargout()
            case 0
                varargout = {};
            case 1
                varargout{1} = true;
            case 2
                varargout{1} = true;
                varargout{2} = {};
            case 3
                varargout{1} = true;
                varargout{2} = {};
                varargout{3} = {};
            otherwise
                varargout = {};
        end
        return;
    end

    xmldocfilename = varargin{1};
    if isdir(xmldocfilename)
        xmlfiles = dir([xmldocfilename, '/*.xml'], '-s');
        for j = 1:length(xmlfiles)
            xmlfile = [xmlfiles(j).folder, '/', xmlfiles(j).name];
            switch nargout()
            case 0
                xmldocchecker(xmlfile);
            case 1
                state = xmldocchecker(xmlfile);
                if ~state
                    varargout{1} = state;
                    return
                end
            case 2
                [state, errors_detected] = xmldocchecker(xmlfile);
                if ~state
                    varargout{1} = state;
                    varargout{2} = errors_detected;
                    return
                end
            case 3
                [state, errors_detected, warnings_detected] = xmldocchecker(xmlfile);
                if ~state
                    varargout{1} = state;
                    varargout{2} = errors_detected;
                    varargout{3} = warnings_detected;
                    return
                end
            end
        end
        switch nargout()
            case 0
                varargout = {};
            case 1
                varargout{1} = true;
            case 2
                varargout{1} = true;
                varargout{2} = {};
            case 3
                varargout{1} = true;
                varargout{2} = {};
                varargout{3} = {};
            otherwise
                varargout = {};
        end
        return;
    end
    % Check if the file exists
    if ~isfile(xmldocfilename)
        error('Nelson:FileNotFound', 'File ''%s'' not found.', xmldocfilename);
    end
    switch nargout()
        case 0
            [state, errors_detected] = checkXmlDocFile(xmldocfilename);
            if ~state
                error('Nelson:xmldocchecker:validationError', errors_detected{1});
            end
        case 1
            state = checkXmlDocFile(xmldocfilename);
            varargout{1} = state;
        case 2
            [state, errors_detected] = checkXmlDocFile(xmldocfilename);
            varargout = {state, errors_detected};
        case 3
            [state, errors_detected, warnings_detected] = checkXmlDocFile(xmldocfilename);
            varargout = {state, errors_detected, warnings_detected};
        otherwise
            varargout = {};
    end
end
%=============================================================================
function [state, errors_detected, warnings_detected] = checkXmlDocFile(xmldocfilename)
    xsd_xmldoc = [modulepath('help_tools'), '/resources/nelson_help.xsd'];
    [state, errors_detected, warnings_detected] = xmlchecker(xmldocfilename, xsd_xmldoc);
    if ~state
        errors_detected = addXmlDocFilenameToMessages(xmldocfilename, errors_detected);
    end
end
%=============================================================================
function messages = addXmlDocFilenameToMessages(xmldocfilename, messages)
    prefix = sprintf('XML documentation file "%s" is invalid.', xmldocfilename);
    if isempty(messages)
        messages = {prefix};
        return
    end
    if ischar(messages)
        messages = {[prefix, newline(), messages]};
        return
    end
    for k = 1:length(messages)
        messages{k} = [prefix, newline(), messages{k}];
    end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = xmldoclinkchecker(varargin)
    narginchk(0, 1);
    nargoutchk(0, 3);

    if nargin == 0
        modules_path = [nelsonroot(), '/modules/'];
        module_list = get_modules_help_list();
        disp(_('Checking XML documentation links...'));
        for i = 1:length(module_list)
            module_name = module_list{i};
            for lang = getavailablelanguages()'
                help_path = [modules_path, module_name, '/help/', lang{1}, '/xml/'];
                if isdir(help_path) && isfile([help_path, 'chapter.xml'])
                    switch nargout()
                    case 0
                        xmldoclinkchecker(help_path);
                    case 1
                        state = xmldoclinkchecker(help_path);
                        if ~state
                            varargout{1} = state;
                            return
                        end
                    case 2
                        [state, errors_detected] = xmldoclinkchecker(help_path);
                        if ~state
                            varargout{1} = state;
                            varargout{2} = errors_detected;
                            return
                        end
                    case 3
                        [state, errors_detected, warnings_detected] = xmldoclinkchecker(help_path);
                        if ~state
                            varargout{1} = state;
                            varargout{2} = errors_detected;
                            varargout{3} = warnings_detected;
                            return
                        end
                    end
                end
            end
        end
        switch nargout()
            case 0
                varargout = {};
            case 1
                varargout{1} = true;
            case 2
                varargout{1} = true;
                varargout{2} = {};
            case 3
                varargout{1} = true;
                varargout{2} = {};
                varargout{3} = {};
            otherwise
                varargout = {};
        end
        return;
    else
        target = varargin{1};
        if isdir(target)
            xmlfiles = dir([target, '/*.xml'], '-s');
            files_to_check = cell(1, length(xmlfiles));
            for j = 1:length(xmlfiles)
                files_to_check{j} = [xmlfiles(j).folder, '/', xmlfiles(j).name];
            end
            index_dirs = localResolveIndexDirectories(target);
        else
            if ~isfile(target)
                error('Nelson:FileNotFound', 'File ''%s'' not found.', target);
            end
            files_to_check = {target};
            index_dirs = localResolveIndexDirectories(fileparts(target));
        end
    end

    [state, errors_detected, warnings_detected] = __xmldoclinkchecker__(index_dirs, files_to_check);

    if nargout == 0
        if ~state
            error('Nelson:xmldoclinkchecker:validationError', errors_detected{1});
        end
        return;
    end

    switch nargout()
    case 1
        varargout = {state};
    case 2
        varargout = {state, errors_detected};
    case 3
        varargout = {state, errors_detected, warnings_detected};
    otherwise
        varargout = {};
    end
end

%=============================================================================
function index_dirs = localGetAllModuleXmlDirectories(language)
    if nargin < 1
        language = '';
    end
    modules_path = [nelsonroot(), '/modules/'];
    module_list = dir(modules_path);
    index_dirs = {};
    for i = 1:length(module_list)
        if module_list(i).isdir && ~ismember(module_list(i).name, {'.', '..'})
            module_name = module_list(i).name;
            if isempty(language)
                languages = getavailablelanguages();
            else
                languages = {language};
            end
            for lang = languages(:)'
                help_path = [modules_path, module_name, '/help/', lang{1}, '/xml'];
                if isdir(help_path) && isfile([help_path, '/chapter.xml'])
                    index_dirs{end + 1} = help_path; %#ok<AGROW>
                end
            end
        end
    end
end

%=============================================================================
function index_dirs = localResolveIndexDirectories(pathname)
    normalized = strrep(pathname, '\', '/');
    modules_index = strfind(normalized, '/modules/');
    if ~isempty(modules_index)
        help_index = strfind(normalized, '/help/');
        xml_index = strfind(normalized, '/xml');
        if ~isempty(help_index) && ~isempty(xml_index)
            help_index = help_index(length(help_index));
            xml_index = xml_index(length(xml_index));
            if xml_index > help_index
                language = normalized(help_index + length('/help/'):xml_index - 1);
                if ~isempty(language) && isempty(strfind(language, '/'))
                    index_dirs = localGetAllModuleXmlDirectories(language);
                    return;
                end
            end
        end
    end

    xml_root = localFindXmlRoot(pathname);
    if isempty(xml_root)
        error('Nelson:xmldoclinkchecker:rootNotFound', 'No XML documentation root found from: %s', pathname);
    end
    index_dirs = {xml_root};
end

%=============================================================================
function xml_root = localFindXmlRoot(pathname)
    xml_root = '';
    current = pathname;
    while ~isempty(current)
        if isfile([current, '/chapter.xml'])
            xml_root = current;
        end
        parent = fileparts(current);
        if strcmp(parent, current)
            break;
        end
        current = parent;
    end
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function xmldocrenderimages(varargin)
  % currently internal function only (not documented)
  % xmldocrenderimages() build images for Nelson help files
  % xmldocrenderimages(module_name) build images for a module loaded in Nelson
  % xmldocrenderimages([], []) build images for all modules in all languages
  % xmldocrenderimages([], [], force) force image generation for all modules in all languages
  % xmldocrenderimages(module_name, []) build images for a module in all languages
  % xmldocrenderimages(module_name, language) build images for a module in a specific language
  % xmldocrenderimages(module_name, language, force) force image generation
  narginchk(0, 3);
   currentLang = getlanguage();
   force = false;

   if (nargin() == 0)
    render_all_modules([], force);
    setlanguage(currentLang);
    return;
  end
  if (nargin() == 2 || nargin() == 3)
    module = varargin{1};
    language = varargin{2};
    if (nargin() == 3)
      force = varargin{3};
      if ~islogical(force) || ~isscalar(force)
        error('Nelson:xmldocrenderimages:invalidInputType', 'Wrong type for argument #%d: %s expected.', 3, 'logical');
      end
    end
    if is_all_modules_request(module)
      render_all_modules(language, force);
      setlanguage(currentLang);
      return;
    end
    if ~ismodule(module)
      error('Nelson:xmldocrenderimages:invalidModuleName', 'Invalid module name.');
    end
    if isempty(language)
      render_module_all_languages(module, force);
      setlanguage(currentLang);
      return;
    end
    if ~is_valid_language(language)
      error('Nelson:xmldocrenderimages:invalidLanguage', 'Invalid language');
    end
    xmldocrenderimages_module(module, language, force);
    setlanguage(currentLang);
    return;
  end
  module = varargin{1};
  if ~ismodule(module)
    error('Nelson:xmldocrenderimages:invalidModuleName', 'Invalid module name.');
  end
  render_module_all_languages(module, force);
  setlanguage(currentLang);
end
%=============================================================================
function render_all_modules(language, force)
  if isempty(language)
    modules_help_list = get_modules_help_list();
    for lang = getavailablelanguages()'
      setlanguage(lang{1});
      for m = modules_help_list'
        xmldocrenderimages_module(m{1}, lang{1}, force);
      end
    end
    return;
  end
  if ~is_valid_language(language)
    error('Nelson:xmldocrenderimages:invalidLanguage', 'Invalid language');
  end
  modules_help_list = get_modules_help_list();
  setlanguage(language);
  for m = modules_help_list'
    xmldocrenderimages_module(m{1}, language, force);
  end
end
%=============================================================================
function tf = is_all_modules_request(module)
  tf = isnumeric(module) && isempty(module);
end
%=============================================================================
function tf = is_valid_language(language)
  tf = ischar(language) && ~isempty(language) && any(strcmp(language, getavailablelanguages()));
end
%=============================================================================
function render_module_all_languages(module, force)
  for lang = getavailablelanguages()'
    xmldocrenderimages_module(module, lang{1}, force);
  end
end
%=============================================================================
function xmldocrenderimages_module(module, language, force)
  fprintf('Rendering images for module %s language %s\n', module, language);
  if ~ismodule(module)
    return;
  end
  module_path = modulepath(module);
  xml_module_path = fullfile(module_path, 'help', language, 'xml');
  if ~isdir(xml_module_path)
    return;
  end
  TMP = [tempname() '_xmldocrenderimages'];
  mkdir(TMP);
  [status, scriptFiles, msg] = generate_image_scripts(xml_module_path, TMP, force);
  if ~status
    error('Nelson:xmldocrenderimages:scriptGenerationFailed', msg);
  end
  TIMEOUT = 120;
  if isempty(scriptFiles)
    rmdir(TMP, 's');
    return;
  end
  commands = build_render_commands(scriptFiles, TIMEOUT);
  nbWorkers = get_render_workers();
  fprintf('Rendering %d images on %d workers.\n', numel(scriptFiles), nbWorkers);
  for firstIndex = 1:nbWorkers:numel(scriptFiles)
    lastIndex = min(firstIndex + nbWorkers - 1, numel(scriptFiles));
    batchCommands = commands(firstIndex:lastIndex);
    batchScriptFiles = scriptFiles(firstIndex:lastIndex);
    [status, output] = system(batchCommands, ones(1, numel(batchCommands)) * (TIMEOUT + 10));
    failedIndex = find(status ~= 0);
    for k = 1:numel(failedIndex)
      i = failedIndex(k);
      retry_render_command(batchCommands(i), batchScriptFiles{i}, TIMEOUT);
    end
  end
  rmdir(TMP, 's');
end
%=============================================================================
function commands = build_render_commands(scriptFiles, timeout)
  nelson_bin_path = modulepath('nelson', 'bin');
  nelson_exe_name = 'nelson-adv-cli';
  if ispc()
    nelson_exe_name = 'nelson-adv-cli.exe';
  end
  nelson_exe_path = ['"', nelson_bin_path, '/', nelson_exe_name, '"'];
  commands = string({});
  for i = 1:numel(scriptFiles)
    cmd = [nelson_exe_path, ' --timeout ', num2str(timeout), ...
      ' --quiet --nouserstartup --nousermodules --noipc --file "', scriptFiles{i}, '"'];
    commands = [commands, string(cmd)];
  end
end
%=============================================================================
function nbWorkers = get_render_workers()
  nbWorkers = min(maxNumCompThreads(), 4);
  if nbWorkers < 1
    nbWorkers = 1;
  end
end
%=============================================================================
function retry_render_command(command, scriptFile, timeout)
  maxAttempts = 5;
  lastOutput = '';
  for attempt = 1:maxAttempts
    [status, output] = system(command, 2 * timeout + 10);
    if (status == 0)
      return;
    end
    lastOutput = output;
  end
  msg = sprintf('Error while rendering image: %s', scriptFile);
  if ~isempty(lastOutput)
    msg = [msg, newline, char(lastOutput)];
  end
  error('Nelson:xmldocrenderimages:renderFailed', msg);
end
%=============================================================================
function [status, scriptFiles, msg] = generate_image_scripts(xml_module_path, tmp_dir, force)
  [status, scriptFiles, msg] = __xmldocgenerateimages__(xml_module_path, tmp_dir, force);
  if ~status
    return;
  end
  entries = dir(xml_module_path);
  for k = 1:numel(entries)
    entry = entries(k);
    if entry.isdir && ~strcmp(entry.name, '.') && ~strcmp(entry.name, '..')
      child_path = [xml_module_path, '/', entry.name];
      [child_status, child_scriptFiles, child_msg] = generate_image_scripts(child_path, tmp_dir, force);
      if ~child_status
        status = child_status;
        msg = child_msg;
        return;
      end
      scriptFiles = [scriptFiles(:); child_scriptFiles(:)];
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function file_generated = xmldoctohelp(varargin)
  narginchk(3, 4);
  dirs_input = varargin{1}
  dir_output = varargin{2};
  main_title = varargin{3};
  if nargin() == 4
    overwrite = varargin{4};
  else
    overwrite = true;
  end
  dir_output_tmp = [dir_output, 'nelson_help'];
  mkdir(dir_output_tmp);
  module_name = xmldocbuild(dirs_input, dir_output_tmp, main_title, 'html', overwrite);
  destination_file = '';
  if strcmp(module_name, '')
    destination_file = [nelsonappid(), '.modules.', 'manual', '.help', '.nhz'];
  else
    destination_file = [nelsonappid(), '.modules.', module_name, '.help', '.nhz'];
  end
  file_generated =  [dir_output, destination_file];

  qhelpgenerator(dir_output_tmp, dir_output, destination_file);
  file_generated =  [dir_output, destination_file];
  if ~isfile(file_generated)
    file_generated = '';
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = xmldoctohtml(varargin)
  narginchk(3, 4);
  nargoutchk(0, 2);
  dirs_input = varargin{1};
  dir_output = varargin{2};
  main_title = varargin{3};
  html_type = 'html';
   if nargin() == 4
    overwrite = varargin{4};
  else
    overwrite = true;
  end
  [status, msg] = xmldocbuild(dirs_input, dir_output, main_title, html_type, overwrite);
  copyfile([modulepath('help_tools'), '/resources/highlight.pack.js'], dir_output);
  copyfile([modulepath('help_tools'), '/resources/highlight.css'], dir_output);
  copyfile([modulepath('help_tools'), '/resources/nelson_common.css'], dir_output);
  copyfile([modulepath('help_tools'), '/resources/nelson_help.js'], dir_output);

  varargout{1} = status;
  if nargout > 1
    varargout{2} = msg;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function tf = xmldoctomd(varargin)
  if nargin() < 3
    error('Nelson:notEnoughInputs', 'Not enough input arguments.');
  end
  if nargin() > 4
    error('Nelson:tooManyInputs', 'Too many input arguments.');
  end
  dirs_input = varargin{1};
  dir_output = varargin{2};
  main_title = varargin{3};
  if nargin() == 4
    overwrite = varargin{4};
  else
    overwrite = true;
  end
  mkdir(dir_output);
   xmldocbuild(dirs_input, dir_output, main_title, 'md', overwrite);
   tf = true;
end
