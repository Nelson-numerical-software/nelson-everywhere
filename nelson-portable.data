% LICENCE_BLOCK_END
function txt = report_xmlEscape(txt)
  txt = replace(txt, '&', '&amp;');
  txt = replace(txt, '<', '&lt;');
  txt = replace(txt, '>', '&gt;');
  txt = replace(txt, '"', '&quot;');
end
﻿%=============================================================================
