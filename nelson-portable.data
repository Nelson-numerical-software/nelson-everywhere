%=============================================================================
% catalog = NFlow.internal.acausalCatalog()
%
% Acausal palette N0.2: the single-source component registry. Each entry is a
% curated palette component (a Coselica-parity block) described declaratively:
% its palette name and group, its physical domain, the island block + `kind` it
% lowers to, its physical pins (with the node param each occupies), its
% parameters (palette name -> island param + default + unit), and a one-line
% description for the help pages. Everything downstream is generated from this
% table: the GUI palette manifests (library.json), the help-page skeletons
% (en/fr), the per-block unit-test scaffolds, and the netlist->island lowering.
%
% This is a *catalog* (facts about which components exist and how they map),
% authored clean-room from textbook physics; no Coselica source is copied.
%
% Fields per entry:
%   name        palette display name (Coselica-parity)
%   group       palette group ('Electrical' | 'Thermal' | 'Translational' |
%               'Rotational')
%   domain      physical domain ('electrical'|'thermal'|'translational'|
%               'rotational')
%   island      target island block type ('physicalIsland' |
%               'mechanicalTranslationalIsland')
%   kind        island component `kind`
%   pins        cell of {pinName, nodeField}: the physical pins and which island
%               component node field ('a'|'b'|'c'|'d'|'node') each maps to
%   params      cell of {paletteName, islandName, default, unit}: parameter map
%   signalIn    input-port param name driving a source ('' = none)
%   signalOut   output-port kind for a sensor ('' = none)
%   desc        one-line help description
%=============================================================================
function catalog = acausalCatalog()
  c = {};

  % ---------------------------------------------------------------- Electrical
  c{end + 1} = entry('Ground', 'Electrical', 'electrical', 'physicalIsland', ...
    'ground', {{'p', 'a'}}, {}, '', '', ...
    'Reference node (0 V) for an electrical island.');
  c{end + 1} = entry('Resistor', 'Electrical', 'electrical', 'physicalIsland', ...
    'resistor', {{'p', 'a'}, {'n', 'b'}}, {{'R', 'R', 1000, 'ohm'}}, '', '', ...
    'Ideal linear resistor: i = (v_p - v_n) / R.');
  % Cross-domain: expanded (NFlow.internal.acausalExpand) into an electrical resistor plus
  % a thermal heat-flow source carrying P = v^2 / R; island/kind are placeholders.
  c{end + 1} = entry('HeatingResistor', 'Electrical', 'electrical', 'physicalIsland', ...
    'resistor', {{'p', 'a'}, {'n', 'b'}, {'heatPort', 'a', 'thermal'}}, {{'R', 'R', 1000, 'ohm'}}, '', '', ...
    'Resistor that dissipates its power P = v^2 / R as heat into a thermal port.');
  % Cross-domain electro-mechanical converters (expanded in NFlow.internal.acausalExpand
  % into an electrical back-emf source + ammeter bridged to a rotational/linear
  % flange via the causal signal layer); island/kind are placeholders. Use the DAE
  % solver: the electrical DAE island sits next to a mechanical ODE island.
  c{end + 1} = entry('EMF', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'force', {{'p', 'a'}, {'n', 'b'}, {'flange', 'node'}}, {{'k', 'k', 1, 'N.m/A'}}, '', '', ...
    'Electro-mechanical converter (motor/generator): back-emf v = k w, torque tau = k i.');
  c{end + 1} = entry('TranslationalEMF', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'force', {{'p', 'a'}, {'n', 'b'}, {'flange', 'node'}}, {{'k', 'k', 1, 'N/A'}}, '', '', ...
    'Linear electro-mechanical converter: back-emf v = k v_flange, force F = k i.');
  c{end + 1} = entry('Conductor', 'Electrical', 'electrical', 'physicalIsland', ...
    'conductor', {{'p', 'a'}, {'n', 'b'}}, {{'G', 'G', 1e-3, 'S'}}, '', '', ...
    'Ideal linear conductor: i = G (v_p - v_n).');
  c{end + 1} = entry('VariableResistor', 'Electrical', 'electrical', 'physicalIsland', ...
    'variableResistor', {{'p', 'a'}, {'n', 'b'}}, {}, 'R', '', ...
    'Resistor whose resistance R is set by the input signal.');
  c{end + 1} = entry('VariableConductor', 'Electrical', 'electrical', 'physicalIsland', ...
    'variableConductor', {{'p', 'a'}, {'n', 'b'}}, {}, 'G', '', ...
    'Conductor whose conductance G is set by the input signal.');
  c{end + 1} = entry('VariableCapacitor', 'Electrical', 'electrical', 'physicalIsland', ...
    'variableCapacitor', {{'p', 'a'}, {'n', 'b'}}, {{'q0', 'ic', 0, 'C'}}, 'C', '', ...
    'Capacitor whose capacitance C is set by a signal (exact charge Q formulation).');
  c{end + 1} = entry('VariableInductor', 'Electrical', 'electrical', 'physicalIsland', ...
    'variableInductor', {{'p', 'a'}, {'n', 'b'}}, {{'phi0', 'ic', 0, 'Wb'}}, 'L', '', ...
    'Inductor whose inductance L is set by a signal (exact flux phi formulation).');
  c{end + 1} = entry('Capacitor', 'Electrical', 'electrical', 'physicalIsland', ...
    'capacitor', {{'p', 'a'}, {'n', 'b'}}, ...
    {{'C', 'C', 1e-6, 'F'}, {'v0', 'ic', 0, 'V'}}, '', '', ...
    'Ideal linear capacitor: i = C dv/dt.');
  c{end + 1} = entry('Inductor', 'Electrical', 'electrical', 'physicalIsland', ...
    'inductor', {{'p', 'a'}, {'n', 'b'}}, ...
    {{'L', 'L', 1e-3, 'H'}, {'i0', 'ic', 0, 'A'}}, '', '', ...
    'Ideal linear inductor: v = L di/dt.');
  c{end + 1} = entry('ConstantVoltage', 'Electrical', 'electrical', 'physicalIsland', ...
    'vsource', {{'p', 'a'}, {'n', 'b'}}, {{'V', 'V', 1, 'V'}}, '', '', ...
    'Constant voltage source: v_p - v_n = V.');
  c{end + 1} = entry('SignalVoltage', 'Electrical', 'electrical', 'physicalIsland', ...
    'vsource', {{'p', 'a'}, {'n', 'b'}}, {}, 'V', '', ...
    'Voltage source driven by the input signal.');
  c{end + 1} = entry('ConstantCurrent', 'Electrical', 'electrical', 'physicalIsland', ...
    'isource', {{'p', 'a'}, {'n', 'b'}}, {{'I', 'I', 1, 'A'}}, '', '', ...
    'Constant current source: current I flows p -> n.');
  c{end + 1} = entry('SignalCurrent', 'Electrical', 'electrical', 'physicalIsland', ...
    'isource', {{'p', 'a'}, {'n', 'b'}}, {}, 'I', '', ...
    'Current source driven by the input signal.');
  % Waveform sources: expanded (NFlow.internal.acausalExpand) into a causal generator
  % feeding a SignalVoltage / SignalCurrent, so they need no external input.
  c{end + 1} = entry('SineVoltage', 'Electrical', 'electrical', 'physicalIsland', ...
    'vsource', {{'p', 'a'}, {'n', 'b'}}, ...
    {{'Amplitude', 'Amplitude', 1, 'V'}, {'Frequency', 'Frequency', 1, 'Hz'}, {'Phase', 'Phase', 0, 'rad'}}, ...
    '', '', 'Sine voltage source: v = Amplitude sin(2 pi Frequency t + Phase).');
  c{end + 1} = entry('SineCurrent', 'Electrical', 'electrical', 'physicalIsland', ...
    'isource', {{'p', 'a'}, {'n', 'b'}}, ...
    {{'Amplitude', 'Amplitude', 1, 'A'}, {'Frequency', 'Frequency', 1, 'Hz'}, {'Phase', 'Phase', 0, 'rad'}}, ...
    '', '', 'Sine current source: i = Amplitude sin(2 pi Frequency t + Phase).');
  c{end + 1} = entry('ExpSineVoltage', 'Electrical', 'electrical', 'physicalIsland', ...
    'vsource', {{'p', 'a'}, {'n', 'b'}}, ...
    {{'Amplitude', 'Amplitude', 1, 'V'}, {'Frequency', 'Frequency', 2, 'Hz'}, ...
     {'Damping', 'Damping', 0.5, '1/s'}, {'Phase', 'Phase', 0, 'rad'}}, ...
    '', '', 'Exponentially damped sine voltage source.');
  c{end + 1} = entry('ExpSineCurrent', 'Electrical', 'electrical', 'physicalIsland', ...
    'isource', {{'p', 'a'}, {'n', 'b'}}, ...
    {{'Amplitude', 'Amplitude', 1, 'A'}, {'Frequency', 'Frequency', 2, 'Hz'}, ...
     {'Damping', 'Damping', 0.5, '1/s'}, {'Phase', 'Phase', 0, 'rad'}}, ...
    '', '', 'Exponentially damped sine current source.');
  c{end + 1} = entry('TrapezoidVoltage', 'Electrical', 'electrical', 'physicalIsland', ...
    'vsource', {{'p', 'a'}, {'n', 'b'}}, ...
    {{'Amplitude', 'Amplitude', 1, 'V'}, {'Rising', 'Rising', 0.2, 's'}, {'Width', 'Width', 0.3, 's'}, ...
     {'Falling', 'Falling', 0.2, 's'}, {'Period', 'Period', 1, 's'}}, ...
    '', '', 'Trapezoidal voltage source (continuous ramp-up / hold / ramp-down).');
  c{end + 1} = entry('TrapezoidCurrent', 'Electrical', 'electrical', 'physicalIsland', ...
    'isource', {{'p', 'a'}, {'n', 'b'}}, ...
    {{'Amplitude', 'Amplitude', 1, 'A'}, {'Rising', 'Rising', 0.2, 's'}, {'Width', 'Width', 0.3, 's'}, ...
     {'Falling', 'Falling', 0.2, 's'}, {'Period', 'Period', 1, 's'}}, ...
    '', '', 'Trapezoidal current source (continuous ramp-up / hold / ramp-down).');
  c{end + 1} = entry('VCV', 'Electrical', 'electrical', 'physicalIsland', ...
    'vcvs', {{'p', 'a'}, {'n', 'b'}, {'cp', 'c'}, {'cn', 'd'}}, ...
    {{'gain', 'gain', 1, '1'}}, '', '', ...
    'Voltage-controlled voltage source: v_pn = gain (v_cp - v_cn).');
  c{end + 1} = entry('VCC', 'Electrical', 'electrical', 'physicalIsland', ...
    'vccs', {{'p', 'a'}, {'n', 'b'}, {'cp', 'c'}, {'cn', 'd'}}, ...
    {{'gain', 'gain', 1, 'S'}}, '', '', ...
    'Voltage-controlled current source: i = gain (v_cp - v_cn).');
  c{end + 1} = entry('CCV', 'Electrical', 'electrical', 'physicalIsland', ...
    'ccvs', {{'p', 'a'}, {'n', 'b'}, {'cp', 'c'}, {'cn', 'd'}}, ...
    {{'gain', 'gain', 1, 'ohm'}}, '', '', ...
    'Current-controlled voltage source: v_pn = gain i_cp (the sense branch cp-cn is a short).');
  c{end + 1} = entry('CCC', 'Electrical', 'electrical', 'physicalIsland', ...
    'cccs', {{'p', 'a'}, {'n', 'b'}, {'cp', 'c'}, {'cn', 'd'}}, ...
    {{'gain', 'gain', 1, '1'}}, '', '', ...
    'Current-controlled current source: i_pn = gain i_cp (the sense branch cp-cn is a short).');
  c{end + 1} = entry('Diode', 'Electrical', 'electrical', 'physicalIsland', ...
    'diode', {{'p', 'a'}, {'n', 'b'}}, ...
    {{'Is', 'Is', 1e-9, 'A'}, {'Vt', 'Vt', 0.025, 'V'}}, '', '', ...
    'Exponential (Shockley) diode: i = Is (exp(vd/Vt) - 1).');
  c{end + 1} = entry('ZDiode', 'Electrical', 'electrical', 'physicalIsland', ...
    'zdiode', {{'p', 'a'}, {'n', 'b'}}, ...
    {{'Is', 'Is', 1e-9, 'A'}, {'Vt', 'Vt', 0.04, 'V'}, {'Vz', 'Vz', 5, 'V'}}, '', '', ...
    'Zener diode: forward Shockley conduction plus reverse breakdown at -Vz.');
  c{end + 1} = entry('RampVoltage', 'Electrical', 'electrical', 'physicalIsland', ...
    'vsource', {{'p', 'a'}, {'n', 'b'}}, ...
    {{'Slope', 'slope', 1, 'V/s'}, {'StartTime', 'start', 0, 's'}}, '', '', ...
    'Ramp voltage source: v = Slope (t - StartTime) for t >= StartTime, else 0.');
  c{end + 1} = entry('RampCurrent', 'Electrical', 'electrical', 'physicalIsland', ...
    'isource', {{'p', 'a'}, {'n', 'b'}}, ...
    {{'Slope', 'slope', 1, 'A/s'}, {'StartTime', 'start', 0, 's'}}, '', '', ...
    'Ramp current source: i = Slope (t - StartTime) for t >= StartTime, else 0.');
  c{end + 1} = entry('NPN', 'Electrical', 'electrical', 'physicalIsland', ...
    'npn', {{'C', 'a'}, {'B', 'c'}, {'E', 'b'}}, ...
    {{'Is', 'Is', 1e-16, 'A'}, {'Vt', 'Vt', 0.025, 'V'}, ...
     {'Bf', 'Bf', 100, '1'}, {'Br', 'Br', 1, '1'}}, '', '', ...
    'NPN bipolar transistor (Ebers-Moll): collector, base and emitter pins.');
  c{end + 1} = entry('PNP', 'Electrical', 'electrical', 'physicalIsland', ...
    'pnp', {{'C', 'a'}, {'B', 'c'}, {'E', 'b'}}, ...
    {{'Is', 'Is', 1e-16, 'A'}, {'Vt', 'Vt', 0.025, 'V'}, ...
     {'Bf', 'Bf', 100, '1'}, {'Br', 'Br', 1, '1'}}, '', '', ...
    'PNP bipolar transistor (Ebers-Moll): collector, base and emitter pins.');
  c{end + 1} = entry('NMOS', 'Electrical', 'electrical', 'physicalIsland', ...
    'nmos', {{'D', 'a'}, {'G', 'c'}, {'S', 'b'}}, ...
    {{'Beta', 'Beta', 1e-3, 'A/V^2'}, {'Vt', 'Vt', 1, 'V'}}, '', '', ...
    'N-channel MOSFET (square law): drain, gate and source pins.');
  c{end + 1} = entry('PMOS', 'Electrical', 'electrical', 'physicalIsland', ...
    'pmos', {{'D', 'a'}, {'G', 'c'}, {'S', 'b'}}, ...
    {{'Beta', 'Beta', 1e-3, 'A/V^2'}, {'Vt', 'Vt', 1, 'V'}}, '', '', ...
    'P-channel MOSFET (square law): drain, gate and source pins.');
  c{end + 1} = entry('IdealTransformer', 'Electrical', 'electrical', 'physicalIsland', ...
    'transformer', {{'p1', 'a'}, {'n1', 'b'}, {'p2', 'c'}, {'n2', 'd'}}, ...
    {{'n', 'n', 1, '1'}}, '', '', ...
    'Ideal transformer: v1 = n v2, i2 = -n i1 (structural, no state storage).');
  c{end + 1} = entry('Gyrator', 'Electrical', 'electrical', 'physicalIsland', ...
    'gyrator', {{'p1', 'a'}, {'n1', 'b'}, {'p2', 'c'}, {'n2', 'd'}}, ...
    {{'G1', 'G1', 1, 'S'}, {'G2', 'G2', 1, 'S'}}, '', '', ...
    'Gyrator: i1 = G2 v2, i2 = -G1 v1 (across<->through transducer).');
  c{end + 1} = entry('IdealOpAmp', 'Electrical', 'electrical', 'physicalIsland', ...
    'opAmp', {{'in_p', 'a'}, {'in_n', 'b'}, {'out', 'c'}}, {}, '', '', ...
    'Ideal op-amp (nullor): virtual short e_+ = e_-, output current free.');
  c{end + 1} = entry('Short', 'Electrical', 'electrical', 'physicalIsland', ...
    'short', {{'p', 'a'}, {'n', 'b'}}, {}, '', '', ...
    'Ideal short circuit: e_p = e_n (branch current free).');
  c{end + 1} = entry('Idle', 'Electrical', 'electrical', 'physicalIsland', ...
    'idle', {{'p', 'a'}, {'n', 'b'}}, {}, '', '', ...
    'Ideal open branch: i = 0 (branch voltage free).');
  c{end + 1} = entry('IdealSwitch', 'Electrical', 'electrical', 'physicalIsland', ...
    'switch', {{'p', 'a'}, {'n', 'b'}}, {}, 'control', '', ...
    'Ideal switch: control > 0.5 -> closed short, else open (i = 0).');
  c{end + 1} = entry('VoltageSensor', 'Electrical', 'electrical', 'physicalIsland', ...
    'voltageSensor', {{'p', 'a'}, {'n', 'b'}}, {}, '', 'voltage', ...
    'Measures the voltage v_p - v_n (ideal, no loading).');
  c{end + 1} = entry('CurrentSensor', 'Electrical', 'electrical', 'physicalIsland', ...
    'currentSensor', {{'p', 'a'}, {'n', 'b'}}, {}, '', 'current', ...
    'Measures the branch current p -> n (ideal ammeter).');
  c{end + 1} = entry('PotentialSensor', 'Electrical', 'electrical', 'physicalIsland', ...
    'potentialSensor', {{'p', 'a'}}, {}, '', 'potential', ...
    'Measures the absolute node potential.');

  % ------------------------------------------------------------------- Thermal
  c{end + 1} = entry('HeatCapacitor', 'Thermal', 'thermal', 'physicalIsland', ...
    'capacitor', {{'port', 'a'}}, ...
    {{'C', 'C', 1, 'J/K'}, {'T0', 'ic', 293.15, 'K'}}, '', '', ...
    'Lumped heat capacity: C dT/dt = Q_flow (port referenced to 0).');
  c{end + 1} = entry('ThermalConductor', 'Thermal', 'thermal', 'physicalIsland', ...
    'conductor', {{'a', 'a'}, {'b', 'b'}}, {{'G', 'G', 1, 'W/K'}}, '', '', ...
    'Thermal conductor: Q_flow = G (T_a - T_b).');
  c{end + 1} = entry('ThermalResistor', 'Thermal', 'thermal', 'physicalIsland', ...
    'resistor', {{'a', 'a'}, {'b', 'b'}}, {{'R', 'R', 1, 'K/W'}}, '', '', ...
    'Thermal resistor: Q_flow = (T_a - T_b) / R.');
  c{end + 1} = entry('ConvectiveResistor', 'Thermal', 'thermal', 'physicalIsland', ...
    'variableResistor', {{'a', 'a'}, {'b', 'b'}}, {}, 'R', '', ...
    'Convective resistor: Q_flow = (T_a - T_b) / Rc with a signal-driven Rc.');
  c{end + 1} = entry('Convection', 'Thermal', 'thermal', 'physicalIsland', ...
    'variableConductor', {{'a', 'a'}, {'b', 'b'}}, {}, 'G', '', ...
    'Convection: Q_flow = Gc (T_a - T_b) with a signal-driven coefficient Gc.');
  c{end + 1} = entry('BodyRadiation', 'Thermal', 'thermal', 'physicalIsland', ...
    'radiation', {{'a', 'a'}, {'b', 'b'}}, {{'Gr', 'Gr', 1, 'W/K4'}}, '', '', ...
    'Radiation (Stefan-Boltzmann): Q_flow = Gr (T_a^4 - T_b^4).');
  c{end + 1} = entry('FixedTemperature', 'Thermal', 'thermal', 'physicalIsland', ...
    'vsource', {{'port', 'a'}}, {{'T', 'V', 293.15, 'K'}}, '', '', ...
    'Boundary at a fixed temperature T.');
  c{end + 1} = entry('PrescribedTemperature', 'Thermal', 'thermal', 'physicalIsland', ...
    'vsource', {{'port', 'a'}}, {}, 'V', '', ...
    'Temperature boundary driven by the input signal.');
  c{end + 1} = entry('FixedHeatFlow', 'Thermal', 'thermal', 'physicalIsland', ...
    'isource', {{'port', 'b'}}, {{'Q', 'I', 0, 'W'}}, '', '', ...
    'Constant heat flow Q into the connected port.');
  c{end + 1} = entry('PrescribedHeatFlow', 'Thermal', 'thermal', 'physicalIsland', ...
    'isource', {{'port', 'b'}}, {}, 'I', '', ...
    'Heat flow into the port driven by the input signal.');
  c{end + 1} = entry('TemperatureSensor', 'Thermal', 'thermal', 'physicalIsland', ...
    'potentialSensor', {{'port', 'a'}}, {}, '', 'potential', ...
    'Measures the absolute temperature of a port.');
  c{end + 1} = entry('RelTemperatureSensor', 'Thermal', 'thermal', 'physicalIsland', ...
    'voltageSensor', {{'a', 'a'}, {'b', 'b'}}, {}, '', 'voltage', ...
    'Measures the temperature difference T_a - T_b.');
  c{end + 1} = entry('HeatFlowSensor', 'Thermal', 'thermal', 'physicalIsland', ...
    'currentSensor', {{'a', 'a'}, {'b', 'b'}}, {}, '', 'current', ...
    'Measures the heat flow through the connection.');

  % ------------------------------------------------------------- Translational
  c{end + 1} = entry('Mass', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'mass', {{'flange', 'node'}}, ...
    {{'m', 'm', 1, 'kg'}, {'s0', 's0', 0, 'm'}, {'v0', 'v0', 0, 'm/s'}}, '', '', ...
    'Sliding mass with inertia: m dv/dt = F_net.');
  c{end + 1} = entry('SlidingMass', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'mass', {{'flange', 'node'}}, ...
    {{'m', 'm', 1, 'kg'}, {'L', 'L', 0, 'm'}, {'s0', 's0', 0, 'm'}, {'v0', 'v0', 0, 'm/s'}}, '', '', ...
    'Sliding mass of length L: m dv/dt = F_net (L is geometric, does not affect the dynamics).');
  c{end + 1} = entry('MassWithWeight', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'mass', {{'flange', 'node'}}, ...
    {{'m', 'm', 1, 'kg'}, {'g', 'g', 9.81, 'm/s2'}, {'s0', 's0', 0, 'm'}, {'v0', 'v0', 0, 'm/s'}}, '', '', ...
    'Sliding mass under gravity: m dv/dt = F_net - m g (expands to Mass + ConstantForce).');
  c{end + 1} = entry('Spring', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'spring', {{'a', 'a'}, {'b', 'b'}}, {{'k', 'k', 1, 'N/m'}}, '', '', ...
    'Linear translational spring: F = k (s_a - s_b).');
  c{end + 1} = entry('ElastoGap', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'elastoGap', {{'a', 'a'}, {'b', 'b'}}, ...
    {{'c', 'c', 100, 'N/m'}, {'d', 'd', 1, 'N.s/m'}, {'s_rel0', 's_rel0', 0, 'm'}}, '', '', ...
    'One-sided contact spring-damper: acts only while the gap is closed (s_rel < s_rel0).');
  c{end + 1} = entry('Damper', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'damper', {{'a', 'a'}, {'b', 'b'}}, {{'d', 'd', 1, 'N.s/m'}}, '', '', ...
    'Linear translational damper: F = d (v_a - v_b).');
  c{end + 1} = entry('SpringDamper', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'spring', {{'a', 'a'}, {'b', 'b'}}, {{'k', 'k', 1, 'N/m'}, {'d', 'd', 1, 'N.s/m'}}, '', '', ...
    'Parallel spring and damper: F = k (s_a - s_b) + d (v_a - v_b).');
  c{end + 1} = entry('Brake', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'brake', {{'flange', 'node'}}, {{'vEps', 'vEps', 0.001, 'm/s'}}, 'f', '', ...
    'Signal-actuated friction brake to ground: the input sets the peak braking force.');
  c{end + 1} = entry('Friction', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'friction', {{'flange', 'node'}}, {{'Fc', 'Fc', 1, 'N'}, {'vEps', 'vEps', 0.001, 'm/s'}}, '', '', ...
    'Regularised Coulomb friction (event-free): F = -Fc tanh(v / vEps).');
  c{end + 1} = entry('LinearSpeedDependentForce', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'linearSpeedForce', {{'flange', 'node'}}, {{'d', 'd', 1, 'N.s/m'}}, '', '', ...
    'Speed-proportional resistance to ground: F = -d v.');
  c{end + 1} = entry('QuadraticSpeedDependentForce', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'quadraticSpeedForce', {{'flange', 'node'}}, {{'d', 'd', 1, 'N.s2/m2'}}, '', '', ...
    'Quadratic (drag) resistance to ground: F = -d v |v|.');
  c{end + 1} = entry('Fixed', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'fixed', {{'flange', 'node'}}, {{'s0', 's0', 0, 'm'}}, '', '', ...
    'Flange fixed at a prescribed position s0.');
  c{end + 1} = entry('Force', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'force', {{'flange', 'node'}}, {}, 'F', '', ...
    'External force on a flange, driven by the input signal.');
  c{end + 1} = entry('ConstantForce', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'force', {{'flange', 'node'}}, {{'F', 'F', 0, 'N'}}, '', '', ...
    'Constant force on a flange.');
  c{end + 1} = entry('SineForce', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'force', {{'flange', 'node'}}, ...
    {{'Amplitude', 'Amplitude', 1, 'N'}, {'Frequency', 'Frequency', 1, 'Hz'}, {'Phase', 'Phase', 0, 'rad'}}, ...
    '', '', 'Sine force on a flange: F = Amplitude sin(2 pi Frequency t + Phase).');
  c{end + 1} = entry('RampForce', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'force', {{'flange', 'node'}}, ...
    {{'Slope', 'slope', 1, 'N/s'}, {'StartTime', 'start', 0, 's'}}, ...
    '', '', 'Ramp force on a flange: F = Slope (t - StartTime) for t >= StartTime, else 0.');
  c{end + 1} = entry('ExpSineForce', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'force', {{'flange', 'node'}}, ...
    {{'Amplitude', 'Amplitude', 1, 'N'}, {'Frequency', 'Frequency', 2, 'Hz'}, ...
     {'Damping', 'Damping', 0.5, '1/s'}, {'Phase', 'Phase', 0, 'rad'}}, ...
    '', '', 'Exponentially damped sine force on a flange.');
  c{end + 1} = entry('TrapezoidForce', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'force', {{'flange', 'node'}}, ...
    {{'Amplitude', 'Amplitude', 1, 'N'}, {'Rising', 'Rising', 0.2, 's'}, {'Width', 'Width', 0.3, 's'}, ...
     {'Falling', 'Falling', 0.2, 's'}, {'Period', 'Period', 1, 's'}}, ...
    '', '', 'Trapezoidal force on a flange (continuous ramp-up / hold / ramp-down).');
  c{end + 1} = entry('Force2', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'force2', {{'a', 'a'}, {'b', 'b'}}, {}, 'F', '', ...
    'Equal and opposite force between two flanges: +F on a, -F on b (signal-driven).');
  c{end + 1} = entry('Accelerate', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'accelerate', {{'flange', 'node'}}, {{'s0', 's0', 0, 'm'}, {'v0', 'v0', 0, 'm/s'}}, 'a', '', ...
    'Prescribed motion: the flange acceleration follows the input signal.');
  c{end + 1} = entry('Speed', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'prescribedSpeed', {{'flange', 'node'}}, {{'s0', 's0', 0, 'm'}}, 'v', '', ...
    'Prescribed motion: the flange velocity follows the input signal.');
  c{end + 1} = entry('ConstantSpeed', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'prescribedSpeed', {{'flange', 'node'}}, {{'v', 'v', 1, 'm/s'}, {'s0', 's0', 0, 'm'}}, '', '', ...
    'Prescribed motion: the flange moves at a constant velocity v.');
  c{end + 1} = entry('PositionSensor', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'positionSensor', {{'flange', 'node'}}, {}, '', 'position', ...
    'Measures the absolute position of a flange.');
  c{end + 1} = entry('SpeedSensor', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'speedSensor', {{'flange', 'node'}}, {}, '', 'speed', ...
    'Measures the absolute velocity of a flange.');
  c{end + 1} = entry('RelPositionSensor', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'relPositionSensor', {{'a', 'a'}, {'b', 'b'}}, {}, '', 'position', ...
    'Measures the relative position s_a - s_b between two flanges.');
  c{end + 1} = entry('RelSpeedSensor', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'relSpeedSensor', {{'a', 'a'}, {'b', 'b'}}, {}, '', 'speed', ...
    'Measures the relative velocity v_a - v_b between two flanges.');

  % ---------------------------------------------------------------- Rotational
  c{end + 1} = entry('Inertia', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'mass', {{'flange', 'node'}}, ...
    {{'J', 'm', 1, 'kg.m2'}, {'phi0', 's0', 0, 'rad'}, {'w0', 'v0', 0, 'rad/s'}}, '', '', ...
    'Rotational inertia: J dw/dt = tau_net.');
  c{end + 1} = entry('RotSpring', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'spring', {{'a', 'a'}, {'b', 'b'}}, {{'c', 'k', 1, 'N.m/rad'}}, '', '', ...
    'Rotational spring: tau = c (phi_a - phi_b).');
  c{end + 1} = entry('RotDamper', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'damper', {{'a', 'a'}, {'b', 'b'}}, {{'d', 'd', 1, 'N.m.s/rad'}}, '', '', ...
    'Rotational damper: tau = d (w_a - w_b).');
  c{end + 1} = entry('ElastoBacklash', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'backlash', {{'a', 'a'}, {'b', 'b'}}, {{'c', 'c', 1, 'N.m/rad'}, {'b', 'play', 0, 'rad'}}, '', '', ...
    'Rotational backlash: elastic torque with a dead zone of total play b.');
  c{end + 1} = entry('RotSpringDamper', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'spring', {{'a', 'a'}, {'b', 'b'}}, {{'c', 'c', 1, 'N.m/rad'}, {'d', 'd', 1, 'N.m.s/rad'}}, '', '', ...
    'Parallel rotational spring and damper: tau = c (phi_a - phi_b) + d (w_a - w_b).');
  c{end + 1} = entry('RotBrake', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'brake', {{'flange', 'node'}}, {{'w_eps', 'vEps', 0.001, 'rad/s'}}, 'f', '', ...
    'Signal-actuated rotational brake to ground: the input sets the peak braking torque.');
  c{end + 1} = entry('BearingFriction', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'friction', {{'flange', 'node'}}, {{'tau_c', 'Fc', 1, 'N.m'}, {'w_eps', 'vEps', 0.001, 'rad/s'}}, '', '', ...
    'Regularised bearing friction (event-free): tau = -tau_c tanh(w / w_eps).');
  c{end + 1} = entry('LinearSpeedDependentTorque', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'linearSpeedForce', {{'flange', 'node'}}, {{'d', 'd', 1, 'N.m.s/rad'}}, '', '', ...
    'Speed-proportional resistance to ground: tau = -d w.');
  c{end + 1} = entry('QuadraticSpeedDependentTorque', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'quadraticSpeedForce', {{'flange', 'node'}}, {{'d', 'd', 1, 'N.m.s2/rad2'}}, '', '', ...
    'Quadratic (drag) resistance to ground: tau = -d w |w|.');
  c{end + 1} = entry('Freewheel', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'freewheel', {{'a', 'a'}, {'b', 'b'}}, {{'d', 'd', 100, 'N.m.s/rad'}, {'w_eps', 'vEps', 0.001, 'rad/s'}}, '', '', ...
    'One-way clutch: couples flange a to b only while a overruns b (freewheels otherwise).');
  c{end + 1} = entry('Clutch', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'clutch', {{'a', 'a'}, {'b', 'b'}}, {{'tau_max', 'Fc', 1, 'N.m'}, {'w_eps', 'vEps', 0.001, 'rad/s'}}, '', '', ...
    'Rotational clutch (event-free stick-slip): tau = tau_max tanh((w_a - w_b) / w_eps) reduces the slip toward a common speed.');
  c{end + 1} = entry('RotFixed', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'fixed', {{'flange', 'node'}}, {{'phi0', 's0', 0, 'rad'}}, '', '', ...
    'Flange fixed at a prescribed angle phi0.');
  c{end + 1} = entry('IdealGear', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'gear', {{'a', 'a'}, {'b', 'b'}}, {{'ratio', 'ratio', 1, '1'}}, '', '', ...
    'Ideal gear phi_a = ratio phi_b (structural node merge, inertia folded).');
  % Rod / Lever map to the same structural gear merge (ratio 1 / arm ratio).
  c{end + 1} = entry('Rod', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'gear', {{'a', 'a'}, {'b', 'b'}}, {{'ratio', 'ratio', 1, '1'}}, '', '', ...
    'Rigid massless rod: s_a = s_b (structural merge; ratio defaults to 1).');
  c{end + 1} = entry('Lever', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'gear', {{'a', 'a'}, {'b', 'b'}}, {{'ratio', 'ratio', 1, '1'}}, '', '', ...
    'Lever (small-angle): s_a = ratio s_b, the arm ratio (structural merge).');
  c{end + 1} = entry('Pulley', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'gear', {{'a', 'a'}, {'b', 'b'}}, {{'ratio', 'ratio', 1, '1'}}, '', '', ...
    'Ideal pulley: s_a = ratio s_b (structural merge; ratio = radius ratio).');
  c{end + 1} = entry('Torque', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'force', {{'flange', 'node'}}, {}, 'F', '', ...
    'External torque on a flange, driven by the input signal.');
  c{end + 1} = entry('Torque2', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'force2', {{'a', 'a'}, {'b', 'b'}}, {}, 'F', '', ...
    'Equal and opposite torque between two flanges: +tau on a, -tau on b (signal-driven).');
  c{end + 1} = entry('ConstantTorque', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'force', {{'flange', 'node'}}, {{'tau', 'F', 0, 'N.m'}}, '', '', ...
    'Constant torque on a flange.');
  c{end + 1} = entry('SineTorque', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'force', {{'flange', 'node'}}, ...
    {{'Amplitude', 'Amplitude', 1, 'N.m'}, {'Frequency', 'Frequency', 1, 'Hz'}, {'Phase', 'Phase', 0, 'rad'}}, ...
    '', '', 'Sine torque on a flange: tau = Amplitude sin(2 pi Frequency t + Phase).');
  c{end + 1} = entry('RampTorque', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'force', {{'flange', 'node'}}, ...
    {{'Slope', 'slope', 1, 'N.m/s'}, {'StartTime', 'start', 0, 's'}}, ...
    '', '', 'Ramp torque on a flange: tau = Slope (t - StartTime) for t >= StartTime, else 0.');
  c{end + 1} = entry('ExpSineTorque', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'force', {{'flange', 'node'}}, ...
    {{'Amplitude', 'Amplitude', 1, 'N.m'}, {'Frequency', 'Frequency', 2, 'Hz'}, ...
     {'Damping', 'Damping', 0.5, '1/s'}, {'Phase', 'Phase', 0, 'rad'}}, ...
    '', '', 'Exponentially damped sine torque on a flange.');
  c{end + 1} = entry('TrapezoidTorque', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'force', {{'flange', 'node'}}, ...
    {{'Amplitude', 'Amplitude', 1, 'N.m'}, {'Rising', 'Rising', 0.2, 's'}, {'Width', 'Width', 0.3, 's'}, ...
     {'Falling', 'Falling', 0.2, 's'}, {'Period', 'Period', 1, 's'}}, ...
    '', '', 'Trapezoidal torque on a flange (continuous ramp-up / hold / ramp-down).');
  c{end + 1} = entry('RotAccelerate', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'accelerate', {{'flange', 'node'}}, {{'phi0', 's0', 0, 'rad'}, {'w0', 'v0', 0, 'rad/s'}}, 'a', '', ...
    'Prescribed motion: the flange angular acceleration follows the input signal.');
  c{end + 1} = entry('RotSpeed', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'prescribedSpeed', {{'flange', 'node'}}, {{'phi0', 's0', 0, 'rad'}}, 'w', '', ...
    'Prescribed motion: the flange angular velocity follows the input signal.');
  c{end + 1} = entry('ConstantRotSpeed', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'prescribedSpeed', {{'flange', 'node'}}, {{'w', 'v', 1, 'rad/s'}, {'phi0', 's0', 0, 'rad'}}, '', '', ...
    'Prescribed motion: the flange rotates at a constant angular velocity w.');
  c{end + 1} = entry('AngleSensor', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'positionSensor', {{'flange', 'node'}}, {}, '', 'angle', ...
    'Measures the absolute angle of a flange.');
  c{end + 1} = entry('RotSpeedSensor', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'speedSensor', {{'flange', 'node'}}, {}, '', 'speed', ...
    'Measures the absolute angular velocity of a flange.');
  c{end + 1} = entry('RelAngleSensor', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'relPositionSensor', {{'a', 'a'}, {'b', 'b'}}, {}, '', 'angle', ...
    'Measures the relative angle phi_a - phi_b between two flanges.');
  c{end + 1} = entry('RelRotSpeedSensor', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'relSpeedSensor', {{'a', 'a'}, {'b', 'b'}}, {}, '', 'speed', ...
    'Measures the relative angular velocity w_a - w_b between two flanges.');

  catalog = [c{:}];
end
%=============================================================================
function e = entry(name, group, domain, island, kind, pins, params, signalIn, signalOut, desc)
  e = struct('name', name, 'group', group, 'domain', domain, 'island', island, ...
    'kind', kind, 'pins', {pins}, 'params', {params}, 'signalIn', signalIn, ...
    'signalOut', signalOut, 'desc', desc);
end
