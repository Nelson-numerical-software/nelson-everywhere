  persistent have_64_bit_index %#ok<NLS0005>
  if isempty(have_64_bit_index)
    compiler_info = version('-compiler');
    have_64_bit_index = strcmp(compiler_info{3}, '64');
  end
  r = have_64_bit_index;
end
