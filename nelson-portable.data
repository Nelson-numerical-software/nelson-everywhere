asserts.isequal(nargin('kmedoids'), -1);
asserts.isequal(nargout('kmedoids'), 6);
%=============================================================================
X = [0; 1; 10; 11];
[idx, C, sumd, D, midx, info] = kmedoids(X, 2, 'Start', [1; 3]);
asserts.isequal(idx, [1; 1; 2; 2]);
asserts.isequal(C, [0; 10]);
asserts.isequal(sumd, [1; 1]);
asserts.isequal(size(D), [4 2]);
asserts.isequal(midx, [1; 3]);
asserts.istrue(isfield(info, 'Iterations'));
asserts.istrue(isfield(info, 'BestSum'));
%=============================================================================
X2 = [0 0; 0 1; 5 5; 5 6];
[idx, C] = kmedoids(X2, 2, 'Start', [0 0; 5 5], 'Distance', 'cityblock');
asserts.isequal(idx, [1; 1; 2; 2]);
asserts.isequal(C, [0 0; 5 5]);
%=============================================================================
S = zeros(2, 2, 2);
S(:, :, 1) = [0 0; 5 5];
S(:, :, 2) = [5 5; 0 0];
[idx, C] = kmedoids(X2, 2, 'Start', S, 'Replicates', 2);
asserts.isequal(size(idx), [4 1]);
asserts.isequal(size(C), [2 2]);
%=============================================================================
rng(11);
idx1 = kmedoids(X, 2, 'Replicates', 2);
rng(11);
idx2 = kmedoids(X, 2, 'Replicates', 2);
asserts.isequal(idx1, idx2);
%=============================================================================
opts = statset('kmedoids');
asserts.isequal(opts.Display, 'off');
[idx, C] = kmedoids(X, 2, 'Start', [1; 3], 'Options', opts, 'MaxIter', 2);
asserts.isequal(size(idx), [4 1]);
asserts.isequal(size(C), [2 1]);
%=============================================================================
asserts.checkerror('kmedoids()', _('Not enough input arguments.'));
asserts.checkerror('kmedoids([], 1)', sprintf(_('%s must be a nonempty numeric matrix.'), 'X'));
asserts.checkerror('kmedoids([1; 2], 3)', _('K must not exceed the number of rows in X.'));
asserts.checkerror('kmedoids([1; 2], 0)', sprintf(_('%s must be a positive integer scalar.'), 'K'));
asserts.checkerror('kmedoids([1; 2], 1, ''Distance'')', _('Name-value arguments must be paired.'));
asserts.checkerror('kmedoids([1; 2], 1, ''Unknown'', 1)', _('Invalid name-value argument name.'));
asserts.checkerror('kmedoids([1; 2], 1, ''Display'', ''bad'')', _('Display must be off, final, or iter.'));
asserts.checkerror('kmedoids([1; 2], 1, ''Options'', 1)', _('Options must be a structure.'));
asserts.checkerror('kmedoids([1; 2], 1, ''Start'', ''bad'')', sprintf(_('Invalid %s value.'), 'Start'));
asserts.checkerror('kmedoids([1; 2], 1, ''Start'', 3)', sprintf(_('Invalid %s value.'), 'Start'));
asserts.checkerror('kmedoids([1; 2], 1, ''Start'', 1.5)', sprintf(_('Invalid %s value.'), 'Start'));
asserts.checkerror('kmedoids([1; 2], 1, ''Replicates'', 0)', sprintf(_('%s must be a positive integer scalar.'), 'Replicates'));
asserts.checkerror('kmedoids([1; 2], 1, ''MaxIter'', 0)', sprintf(_('%s must be a positive integer scalar.'), 'MaxIter'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('knnsearch'), -1);
asserts.isequal(nargout('knnsearch'), 2);
%=============================================================================
X = [0 0; 1 0; 0 2; 4 4];
Y = [0 1; 3 4];
idx = knnsearch(X, Y);
asserts.isequal(idx, [1; 4]);
%=============================================================================
[idx, D] = knnsearch(X, Y, 'K', 2);
asserts.isequal(idx, [1 3; 4 3]);
asserts.isapprox(D, [1 1; 1 sqrt(13)], 1e-12);
%=============================================================================
[idx, D] = knnsearch(X, Y, 'K', 2, 'Distance', 'cityblock');
asserts.isequal(idx, [1 3; 4 3]);
asserts.isequal(D, [1 1; 1 5]);
%=============================================================================
[idx, D] = knnsearch(X, Y, 'K', 2, 'Distance', 'minkowski', 'P', 1);
asserts.isequal(idx, [1 3; 4 3]);
asserts.isequal(D, [1 1; 1 5]);
%=============================================================================
[idx, D] = knnsearch(X, Y, 'Distance', 'seuclidean', 'Scale', [1 2]);
asserts.isequal(idx, [1; 4]);
asserts.isapprox(D, [0.5; 1], 1e-12);
%=============================================================================
X = [0; 2; 4];
Y = [1; 3];
[idx, D] = knnsearch(X, Y, 'K', 1, 'IncludeTies', true);
asserts.isequal(size(idx), [2 1]);
asserts.isequal(idx{1}, [1 2]);
asserts.isequal(idx{2}, [2 3]);
asserts.isequal(D{1}, [1 1]);
asserts.isequal(D{2}, [1 1]);
%=============================================================================
idx = knnsearch([0; 1; 2], [0.2; 1.8], 'NSMethod', 'exhaustive', 'SortIndices', false);
asserts.isequal(idx, [1; 3]);
%=============================================================================
asserts.checkerror('knnsearch()', _('Not enough input arguments.'));
asserts.checkerror('knnsearch([1; 2], [1], ''K'')', _('Name-value arguments must be paired.'));
asserts.checkerror('knnsearch({1}, [1])', sprintf(_('%s must be a real numeric matrix.'), 'X'));
asserts.checkerror('knnsearch([1 2], [1])', sprintf(_('X and Y must have %s.'), 'the same number of columns'));
asserts.checkerror('knnsearch([1; 2], [1], ''K'', 3)', _('K must not exceed the number of rows in X.'));
asserts.checkerror('knnsearch([1; 2], [1], ''K'', 1.5)', sprintf(_('%s must be a positive integer scalar.'), 'K'));
asserts.checkerror('knnsearch([1; 2], [1], ''Distance'', ''bad'')', sprintf(_('Invalid %s value.'), 'Distance'));
asserts.checkerror('knnsearch([1; 2], [1], ''Distance'', ''minkowski'', ''P'', 0)', sprintf(_('%s must be a positive scalar.'), 'P'));
asserts.checkerror('knnsearch([1; 2], [1], ''NSMethod'', ''bad'')', sprintf(_('Invalid %s value.'), 'NSMethod'));
asserts.checkerror('knnsearch([1; 2], [1], ''IncludeTies'', 2)', sprintf(_('%s must be true or false.'), 'IncludeTies'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('kruskalwallis'), 3);
asserts.isequal(nargout('kruskalwallis'), 3);
%=============================================================================
X = [6 7 8; 5 7 9; 4 8 NaN; 6 9 10];
[p, tbl, stats] = kruskalwallis(X, [], 'off');
asserts.isapprox(p, 0.018372255965478, 1e-12);
asserts.isequal(tbl{1, 1}, 'Source');
asserts.isequal(tbl{1, 5}, 'Prob>Chi-sq');
asserts.isapprox(tbl{2, 2}, 86.333333333333314, 1e-12);
asserts.isapprox(tbl{3, 2}, 23.666666666666686, 1e-12);
asserts.isapprox(tbl{4, 2}, 110.000000000000000, 1e-12);
asserts.isequal([tbl{2, 3} tbl{3, 3} tbl{4, 3}], [2 8 10]);
asserts.isapprox(tbl{2, 4}, 7.993827160493830, 1e-12);
asserts.isapprox(tbl{2, 5}, p, 1e-12);
asserts.isequal(stats.gnames, {'1'; '2'; '3'});
asserts.isequal(stats.n, [4 4 3]);
asserts.isapprox(stats.meanranks, [2.500000000000000 7.000000000000000 9.333333333333334], 1e-12);
asserts.isequal(stats.sumranks, [10 28 28]);
asserts.isequal(stats.df, 2);
asserts.isequal(stats.source, 'kruskalwallis');
%=============================================================================
y = [1 2 3 4 NaN 1.5 2.5 3.5 5 6]';
g = {'b', 'b', 'a', 'a', 'a', 'b', 'b', 'a', 'c', 'c'}';
[p2, tbl2, stats2] = kruskalwallis(y, g, 'off');
asserts.isapprox(p2, 0.030197383422319, 1e-12);
asserts.isapprox(tbl2{2, 2}, 52.500000000000000, 1e-12);
asserts.isapprox(tbl2{3, 2}, 7.500000000000000, 1e-12);
asserts.isapprox(tbl2{4, 2}, 60.000000000000000, 1e-12);
asserts.isapprox(tbl2{2, 4}, 7.000000000000000, 1e-12);
asserts.isequal(stats2.gnames, {'a'; 'b'; 'c'});
asserts.isequal(stats2.n, [3 4 2]);
asserts.isapprox(stats2.meanranks, [6.000000000000000 2.500000000000000 8.500000000000000], 1e-12);
%=============================================================================
[p3, tbl3, stats3] = kruskalwallis([1 1 1; 1 1 1], [], 'off');
asserts.isequal(p3, 1);
asserts.isequal(tbl3{2, 2}, 0);
asserts.isequal(tbl3{2, 4}, 0);
asserts.isapprox(stats3.meanranks, [3.5 3.5 3.5], 1e-12);
%=============================================================================
[p4, ~, stats4] = kruskalwallis([1 2; 3 NaN; 5 7], ['left '; 'right'], 'off');
asserts.isequal(stats4.gnames, {'left'; 'right'});
asserts.isequal(stats4.n, [3 2]);
asserts.istrue(p4 >= 0 && p4 <= 1);
%=============================================================================
[ps, ~, statss] = kruskalwallis(single(X), [], 'off');
asserts.isequal(class(ps), 'double');
asserts.isapprox(ps, p, 1e-12);
asserts.isapprox(statss.meanranks, stats.meanranks, 1e-12);
%=============================================================================
asserts.checkerror('kruskalwallis()', _('Not enough input arguments.'));
asserts.checkerror('kruskalwallis({1}, [], ''off'')', sprintf(_('%s must be a real numeric vector or matrix.'), 'X'));
asserts.checkerror('kruskalwallis([1 2 3], [1 2], ''off'')', _('GROUP must have the expected number of labels.'));
asserts.checkerror('kruskalwallis([1 2; 3 4], {''only''}, ''off'')', _('GROUP must have the expected number of labels.'));
asserts.checkerror('kruskalwallis([1 2; 3 4], {1}, ''off'')', sprintf(_('%s must be a vector or text array.'), 'GROUP'));
asserts.checkerror('kruskalwallis([1 2; 3 4], [], ''bad'')', _('Display option must be ''on'' or ''off''.'));
asserts.checkerror('kruskalwallis([1 NaN], [1 2], ''off'')', _('At least two groups with more observations than groups are required.'));
