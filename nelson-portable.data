% LICENCE_BLOCK_END
%=============================================================================
function count = requestedColorCount(varargin)
  if nargin > 0
    count = varargin{1};
    return
  end
  rootHandle = groot();
  currentFigure = rootHandle.CurrentFigure;
  if isempty(currentFigure)
    count = size(rootHandle.DefaultFigureColormap, 1);
  else
    count = size(currentFigure.Colormap, 1);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function map = sky(varargin)
  narginchk(0, 1);
  if nargin < 1
    R = groot();
    f = R.CurrentFigure;
    if isempty(f)
      m = size(R.DefaultFigureColormap, 1);
    else
      m = size(f.Colormap, 1);
    end
  else
    m = varargin{1};
  end
  firstColor = [0, 0.4470, 0.7410];
  vector = linspace(0.1, 1, m)';
  map = firstColor .* vector + (1 - vector);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
