KRONR_REF(1) = int32(2);
KRONR_REF(3) = int32(1);
asserts.isequal(KRONR, KRONR_REF);
%=============================================================================
INFE_REF = int32([1, 1, 1, 1, 3, 0, 0, 0, 0, 0, 0, 0, 0]);
asserts.isequal(INFE, INFE_REF);
%=============================================================================
