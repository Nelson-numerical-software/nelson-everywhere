classdef vartype
  properties (Hidden)
    TypeName
  end
  methods
    function obj = vartype(typeName)
      narginchk(1, 1);
      obj.TypeName = char(typeName);
    end
    function idx = resolve(obj, T)
      st = struct(T);
      types = st.Properties.VariableTypes;
      idx = find(strcmp(types, obj.TypeName));
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function Tout = addprop(T, name, propertyType)
  if nargin == 2 && isa(T, 'handle')
    if isstring(name)
      name = char(name);
    end
    Tout = __classdef_add_dynamic_property__(T, name);
    return
  end
  narginchk(3, 3);
  mustBeA(T, 'table', 1);
  names = localCellstr(name);
  propertyTypes = localCellstr(propertyType);
  if length(propertyTypes) == 1 && length(names) > 1
    propertyTypes = repmat(propertyTypes, 1, length(names));
  end
  if length(propertyTypes) ~= length(names)
    error('Nelson:table:dimagree:propertyTypesMatchPropertyNames', 'Property types must match property names.');
  end
  st = struct(T);
  if ~isfield(st.Properties, 'CustomProperties') || isempty(st.Properties.CustomProperties)
    st.Properties.CustomProperties = struct();
  end
  for k = 1:length(names)
    if isfield(st.Properties.CustomProperties, names{k})
      error('Nelson:table:propertyExists', 'Custom property already exists.');
    end
    if ~any(strcmpi(propertyTypes{k}, {'table', 'variable'}))
      error('Nelson:table:invalidValue:propertyTypeTableVariable', 'Property type must be ''table'' or ''variable''.');
    end
    st.Properties.CustomProperties.(names{k}) = [];
  end
  Tout = table.fromStruct(st);
end
%=============================================================================
function names = localCellstr(names)
  if ischar(names)
    names = {names};
  elseif isstring(names)
    names = cellstr(names);
  end
  names = names(:)';
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function Tout = addvars(T, varargin)
  narginchk(2, Inf);
  mustBeA(T, 'table', 1);

  before = '';
  after = '';
  newNames = {};
  values = {};

  k = 1;
  while k <= length(varargin)
    if (ischar(varargin{k}) || (isstring(varargin{k}) && isscalar(varargin{k}))) && ~isempty(values)
      name = char(varargin{k});
      if any(strcmpi(name, {'Before', 'After', 'NewVariableNames'}))
        if k == length(varargin)
          error('Nelson:table:nameValuePair:nameValueArgumentFollowedByA', 'Name-value argument must be followed by a value.');
        end
        switch lower(name)
          case 'before'
            before = varargin{k + 1};
          case 'after'
            after = varargin{k + 1};
          case 'newvariablenames'
            newNames = localCellstr(varargin{k + 1});
        end
        k = k + 2;
        continue
      end
    end
    values{end + 1} = varargin{k};
    k = k + 1;
  end

  if isempty(newNames)
    newNames = cell(1, length(values));
    for k = 1:length(values)
      newNames{k} = ['Var', num2str(width(T) + k)];
    end
  end
  if length(newNames) ~= length(values)
    error('Nelson:table:dimagree:newVariableNamesMatchNumberAddedVariables', 'NewVariableNames must match the number of added variables.');
  end

  st = struct(T);
  insertAt = length(st.Properties.VariableNames) + 1;
  if ~isempty(before)
    insertAt = localFindVariable(st.Properties.VariableNames, before);
  elseif ~isempty(after)
    insertAt = localFindVariable(st.Properties.VariableNames, after) + 1;
  end

  if isempty(st.data)
    st.data = struct();
  end
  for k = 1:length(newNames)
    if any(strcmp(st.Properties.VariableNames, newNames{k}))
      error('Nelson:table:duplicateVariableNames', 'Duplicate table variable name.');
    end
    st.data.(newNames{k}) = values{k};
  end
  leftNames = st.Properties.VariableNames(1:insertAt - 1);
  rightNames = st.Properties.VariableNames(insertAt:length(st.Properties.VariableNames));
  st.Properties.VariableNames = [leftNames(:)', newNames(:)', rightNames(:)'];
  st.data = localReorderData(st.data, st.Properties.VariableNames);
  Tout = table.fromStruct(st);
end
%=============================================================================
function names = localCellstr(names)
  if ischar(names)
    names = {names};
  elseif isstring(names)
    names = cellstr(names);
  end
  names = names(:)';
end
%=============================================================================
function idx = localFindVariable(variableNames, name)
  if isnumeric(name) && isscalar(name)
    idx = name;
    if idx < 1 || idx > length(variableNames)
      error('Nelson:table:indexOutOfRange', 'Variable index out of range.');
    end
    return
  end
  names = localCellstr(name);
  if length(names) ~= 1
    error('Nelson:table:singleVariableExpected', 'A single variable name is expected.');
  end
  idx = find(strcmp(variableNames, names{1}));
  if isempty(idx)
    error('Nelson:table:unrecognizedVariable', 'Unrecognized table variable name.');
  end
  idx = idx(1);
end
%=============================================================================
function data = localReorderData(data, variableNames)
  reordered = struct();
  for k = 1:length(variableNames)
    reordered.(variableNames{k}) = data.(variableNames{k});
  end
  data = reordered;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = array2table(varargin)
  narginchk(1, inf);
  nargoutchk(0, 1);
  X = varargin{1};
  if ~ismatrix(X)
    error('Nelson:table:invalidType:xA2DMatrix', 'X must be a 2-D matrix.');
  end
  if mod(nargin - 1, 2) ~= 0
    error('Nelson:table:nameValuePair:nameValueArgumentsComePairs', 'Name-value arguments must come in pairs.');
  end
  varNames = {};
  rowNames = {};
  dimNames = {};
  hasVarNames = false;
  for k = 2:2:nargin
    name = varargin{k};
    if ~(ischar(name) && isrow(name)) && ~(isstring(name) && isscalar(name))
      error('Nelson:table:invalidType:parameterNameACharacterVectorString', 'Parameter name must be a character vector or string scalar.');
    end
    value = varargin{k + 1};
    switch lower(char(name))
      case 'variablenames'
        varNames = value;
        hasVarNames = true;
      case 'rownames'
        rowNames = value;
      case 'dimensionnames'
        dimNames = value;
      otherwise
        error('Nelson:table:unknownParameter', 'Unknown parameter name.');
    end
  end
  nCols = size(X, 2);
  values = cell(1, nCols);
  for iCol = 1:nCols
    values{iCol} = X(:, iCol);
  end
  if ~hasVarNames
    prefix = inputname(1);
    if isempty(prefix)
      prefix = 'Var';
    end
    varNames = cell(1, nCols);
    for iCol = 1:nCols
      varNames{iCol} = sprintf('%s%d', prefix, iCol);
    end
  end
  args = [values, {'VariableNames', varNames}];
  if nCols == 0
    args = [args, {'Size', [size(X, 1), 0], 'VariableTypes', {}}];
  end
  if ~isempty(rowNames)
    args = [args, {'RowNames', rowNames}];
  end
  if ~isempty(dimNames)
    args = [args, {'DimensionNames', dimNames}];
  end
  varargout{1} = table(args{:});
end
