        }
      ],
      "inputs": [],
      "outputs": [
        {
          "x": 45,
          "y": 70,
          "side": "bottom",
          "name": "out"
        }
      ],
      "defaultParams": {
        "axis": "x"
      },
      "icon": "PlanarAccelerationSensor.svg",
      "render": {
        "type": "image",
        "src": "PlanarAccelerationSensor.svg"
      },
      "help": "Absolute acceleration of the body at frame a along the chosen axis (x, y) or the angular acceleration (alpha)."
    },
    {
