function [C, ia, ib] = union(A, B, varargin)
  n = max(nargout, 1);
  outputs = cell(1, n);
  [outputs{:}] = setOperation('union', A, B, varargin{:});
  C = outputs{1};
  if n >= 2
    ia = outputs{2};
  end
  if n >= 3
    ib = outputs{3};
  end
end
