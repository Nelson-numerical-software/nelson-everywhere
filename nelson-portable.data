function tf = isprime(x)
  narginchk(1, 1);
  nargoutchk(0, 1);
  if ~isnumeric(x) && ~islogical(x)
    error('Nelson:isprime:nonNumericInput', 'Input must be numeric or logical.');
  end
  if ~isreal(x) || any(x(:) < 0) || any(x(:) ~= fix(x(:)))
    error('Nelson:isprime:nonNonnegativeInteger', 'Input must contain nonnegative integers.');
  end
  d = double(x);
  tf = (d >= 2);
  if ~any(tf(:))
    return;
  end
  mx = max(d(:));
  p = primes(floor(sqrt(mx)));
  for k = 1:numel(p)
    pk = p(k);
    tf = tf & ((mod(d, pk) ~= 0) | (d == pk));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function l = lcm(a, b)
  narginchk(2, 2);
  nargoutchk(0, 1);
  if ~isnumeric(a) || ~isnumeric(b)
    error('Nelson:lcm:nonNumericInput', 'Inputs must be numeric.');
  end
  if ~isreal(a) || ~isreal(b) || any(a(:) ~= fix(a(:))) || any(b(:) ~= fix(b(:)))
    error('Nelson:gcd:mustBeRealIntegers', 'Inputs must be real integers.');
  end
  g = gcd(a, b);
  l = abs(a ./ g .* b);
  l(g == 0) = 0;
end
