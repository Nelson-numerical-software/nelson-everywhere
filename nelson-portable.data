function M = magic(N)
  narginchk(1, 1);
  nargoutchk(0, 1);
  M = [];
  N = double(fix(real(N(1))));
  if N < 0
    N = 0;
  end
  if N == 0
    M = [];
  elseif mod(N, 2) == 1
    M = caseModN2(N);
  elseif mod(N, 4) == 0
    M = caseModN4(N);
  elseif mod(N, 4) == 2
    M = caseModOther(N);
  end
end
%=============================================================================
function M = caseModN2(N)
  s = floor((0:N * N - 1) / N);
  c = mod([1:N * N] - s + (N - 3) / 2, N);
  r = mod([N * N:-1:1] + 2 * s, N);
  M(c * N + r + 1) = 1:N * N;
  M = reshape(M, N, N);
end
%=============================================================================
function M = caseModN4(N)
  M = reshape(1:N * N, N, N)';
  I = [1:4:N, 4:4:N];
  J = fliplr(I);
  M(I, I) = M(J, J);
  I = [2:4:N, 3:4:N];
  J = fliplr(I);
  M(I, I) = M(J, J);
end
%=============================================================================
function M = caseModOther(N)
  M = zeros(N, N);
  if mod(N, 2) == 0
    m = N / 2;
  else
    m = N;
  end
  i = 1;
  j = (m + 1) / 2;
  mm = m * m;
  for k = 1:mm
    M(i, j) = k;
    i1 = i - 1;
    j1 = j + 1;
    if i1 < 1
      i1 = m;
    end
    if j1 > m
      j1 = 1;
    end
    if (fix(M(i1, j1)) ~= 0)
      i1 = i + 1;
      j1 = j;
    end
    i = i1;
    j = j1;
  end
  if (mod(N, 2) ~= 0)
    return
  end
  t = m * m;
  for i = 1:m
    for j = 1:m
      im = i + m;
      jm = j + m;
      M(i, jm) = M(i, j) + 2 * t;
      M(im, j) = M(i, j) + 3 * t;
      M(im, jm) = M(i, j) + t;
    end
  end
  m1 = (m - 1) / 2;
  if m1 == 0
    return
  end
  for j = 1:m1
    t = M(1:m, j);
    M(1:m, j) = M(m + 1:m + m, j);
    M(m + 1:m + m, j) = t;
  end
  m1 = (m + 1) / 2;
  m2 = m1 + m;
  t = M(m1, 1);
  M(m1, 1) = M(m2, 1);
  M(m2, 1) = t;
  t = M(m1, m1);
  M(m1, m1) = M(m2, m1);
  M(m2, m1) = t;
  m1 = N + 1 - (m - 3) / 2;
  if m1 > N
    return
  end
  for j = m1:N
    t = M(1:m, j);
    M(1:m, j) = M(m + 1:m + m, j);
    M(m + 1:m + m, j) = t;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = maxk(varargin)
  narginchk(2, 3);
  nargoutchk(0, 2);

  A = varargin{1};
  k = varargin{2};

  % Determine dimension argument if provided, otherwise compute default
  if nargin >= 3
    dim = varargin{3};
  else
    if min(size(A)) != 1
      % For matrices (both dims > 1) keep original behavior: work along columns
      dim = 1;
    else
      % For vectors use the vector's non-singleton dimension
      dim = find(size(A) != 1, 1);
      if isempty(dim)
        dim = 1;
      end
    end
  end

  sz = size(A);
  if k > sz(dim)
    % k larger than the dimension: return all elements sorted (reference-implementation semantics)
    k = sz(dim);
  end

  % Sort along requested dimension in descending order and take first k entries
  % NaN values must be considered smaller than any other value (placed last),
  % so sort on keys where NaN is replaced by -Inf, then gather values from A.
  subs = repmat({':'}, 1, ndims(A));
  subs{dim} = 1:k;
  if isfloat(A) && any(isnan(A(:)))
    Akey = A;
    Akey(isnan(Akey)) = -Inf;
    [~, ind] = sort(Akey, dim, 'descend');
    idx = ind(subs{:});
    % gather values of A pointed by idx along dim
    n1 = prod(sz(1:dim - 1));
    n2 = sz(dim);
    n3 = prod(sz(dim + 1:end));
    Ar = reshape(A, [n1, n2, n3]);
    idxr = reshape(idx, [n1, k, n3]);
    i1 = repmat((1:n1)', [1, k, n3]);
    i3 = repmat(reshape(1:n3, [1, 1, n3]), [n1, k, 1]);
    lin = i1 + (idxr - 1) * n1 + (i3 - 1) * (n1 * n2);
    szOut = sz;
    szOut(dim) = k;
    val = reshape(Ar(lin), szOut);
  else
    [s, ind] = sort(A, dim, 'descend');
    val = s(subs{:});
    idx = ind(subs{:});
  end

  % Assign outputs via varargout
  varargout{1} = val;
  if nargout > 1
    varargout{2} = idx;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = mink(varargin)
  narginchk(2, 3);
  nargoutchk(0, 2);
  A = varargin{1};
  k = varargin{2};

  % Determine dimension argument if provided, otherwise compute default
  if nargin >= 3
    dim = varargin{3};
  else
    if min(size(A)) != 1
      % For matrices (both dims > 1) keep original behavior: work along columns
      dim = 1;
    else
      % For vectors use the vector's non-singleton dimension
      dim = find(size(A) != 1, 1);
      if isempty(dim)
        dim = 1;
      end
    end
  end

  % Validate dim
  if dim < 1 || floor(dim) != dim || dim > ndims(A)
    error('Nelson:mink:dimensionArgumentOutRange2', 'Dimension argument out of range.');
  end

  sz = size(A);
  if k > sz(dim)
    % k larger than the dimension: return all elements sorted (reference-implementation semantics)
    k = sz(dim);
  end

  % Sort along requested dimension in ascending order and take first k entries
  [s, ind] = sort(A, dim, 'ascend');

  subs = repmat({':'}, 1, ndims(A));
  subs{dim} = 1:k;
  val = s(subs{:});
  idx = ind(subs{:});

  % Assign outputs via varargout
  varargout{1} = val;
  if nargout > 1
    varargout{2} = idx;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function C = nchoosek(v, k)
  narginchk(2, 2);
  nargoutchk(0, 1);
  if ~isscalar(k) || ~isreal(k) || (double(k) ~= fix(double(k))) || (double(k) < 0)
    error('Nelson:elementary_functions:kNonNegativeInteger', 'K must be a nonnegative integer.');
  end
  k = double(k);
  if isscalar(v) && isreal(v) && (double(v) == fix(double(v))) && (double(v) >= 0)
    % scalar nonnegative integer: binomial coefficient
    n = double(v);
    if k > n
      error('Nelson:elementary_functions:kIntegerBetween0N', 'K must be an integer between 0 and N.');
    end
    % exact via iterative product
    kk = min(k, n - k);
    if kk == 0
      c = 1;
    else
      c = round(prod((n - kk + 1:n) ./ (1:kk)));
    end
    C = cast(c, class(v));
  else
    % vector (or non-integer scalar treated as a one-element vector):
    % matrix of all k-combinations, rows in the reference implementation's (lexicographic) order
    if ~isvector(v) && ~isempty(v)
      error('Nelson:elementary_functions:firstInputScalarVector', 'First input must be a scalar or a vector.');
    end
    n = numel(v);
    v = reshape(v, 1, n);
    if k > n
      C = reshape(v([]), 0, k);
    elseif k == 0
      C = reshape(v([]), 1, 0);
    elseif k == n
      C = v;
    else
      idx = local_combinations_indices(n, k);
      C = reshape(v(idx), size(idx));
    end
  end
end
%=============================================================================
function idx = local_combinations_indices(n, k)
  % all k-combinations of 1:n in lexicographic order (the reference implementation's order)
  m = round(prod((n - k + 1:n) ./ (1:k)));
  idx = zeros(m, k);
  c = 1:k;
  for r = 1:m
    idx(r, :) = c;
    j = k;
    while (j >= 1) && (c(j) == n - k + j)
      j = j - 1;
    end
    if j >= 1
      c(j) = c(j) + 1;
      c(j + 1:k) = c(j) + (1:(k - j));
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = nextpow2(varargin)
  % next higher power of 2.
  narginchk(1, 1);
  nargoutchk(0, 1);
  X = varargin{1};
  mustBeNumeric(X, 1);
  classname = class(X);
  [f, n] = log2(abs(double(X)));
  idx = (n == 0);
  if ~isempty(f(idx))
    n(idx) = f(idx);
  end
  k = (f == 0.5);
  if ~isempty(n(k))
    n(k) = n(k) - 1;
  end
  k = ~isfinite(f);
  if ~isempty(f(k))
    n(k) = f(k);
  end
  varargout{1} = cast(n, classname);
end
%=============================================================================

%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = normest(varargin)
  nargoutchk(0, 2);
  narginchk(1, 2);

  A = varargin{1};

  if ((~isnumeric(A) && ~islogical(A)) || (ndims(A) ~= 2))
    error('Nelson:elementary_functions:numeric2DMatrixExpected', 'An numeric 2-D matrix expected.');
  end
  if (islogical(A))
    A = double(A);
  end

  if nargin == 2
    tolerance = varargin{2};
    if (~isempty(tolerance) && ~(isscalar(tolerance) && isnumeric(tolerance)))
      error('Nelson:elementary_functions:toleranceNumericScalar', '%s must be a numeric scalar.', 'tolerance');
    end
    tolerance = real(tolerance);
    if (~isempty(tolerance) && (~isfinite(tolerance) || tolerance < 0))
      error('Nelson:elementary_functions:toleranceNonNegativeFiniteScalar', 'tolerance must be a nonnegative finite scalar.');
    end
  else
    tolerance = 1.e-6;
  end
  maxIteration = 100;
  x = full(sum(abs(A), 1))';
  if (~isreal(A))
    x = x + zeros(size(x), class(x)) * 1i;
  end
  count = 0;
  matrixNorm = norm(x);
  if (matrixNorm == 0)
    varargout{1} = matrixNorm;
    varargout{2} = count;
    return;
  end
  if (isempty(tolerance))
    varargout{1} = matrixNorm;
    varargout{2} = count;
    return;
  end
  x = x / matrixNorm;
  n0 = 0;
  while (abs(matrixNorm - n0) > (tolerance * matrixNorm))
    Ax = A * x;
    if (nnz(Ax) == 0)
      Ax = rand(size(Ax), class(Ax));
    end
    x = A' * Ax;
    normx = norm(x);
    n0 = matrixNorm;
    matrixNorm = normx / norm(Ax);
    x = x / normx;
    count = count + 1;
    if (count > maxIteration)
      warning('Nelson:normest:notconverge', 'normest did not converge for %d iterations with tolerance %g', maxIteration, tolerance);
      break;
    end
  end
  varargout{1} = matrixNorm;
  varargout{2} = count;
end
