%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [linespec, colorspec, markerspec, msg] = colstyle(varargin)
  narginchk(1, 3);
  nargoutchk(0, 4);
  style = varargin{1};
  emptyAsNone = false;
  raiseError = true;
  if nargin == 2
    if ~(ischar(varargin{2}) || isStringScalar(varargin{2}))
      error('Nelson:colstyle:plotArgumentExpected', '"plot" argument expected.');
    end
    option = convertStringsToChars(varargin{2});

    if strcmp('plot', option) || strcmp('', option)
      emptyAsNone = strcmp('plot', option);
    else
      error('Nelson:colstyle:plotArgumentExpected', '"plot" argument expected.');
    end
  elseif nargin == 3
    raiseError = varargin{3};
  end
  if ~ischar(style) && ~isStringScalar(style)
    if raiseError
      error('Nelson:colstyle:requiresAStringScalar', 'Requires a string scalar or a character vector argument.');
    else
      colorspec = '';
      markerspec = '';
      linespec = '';
      msg.message = 'Invalid LineSpec string.';
      msg.Identifier = 'Nelson:colstyle:InvalidLinespec';
      return
    end
  end
  style = convertStringsToChars(style);
  giveup = 0;
  colorspec = '';
  markerspec = '';
  linespec = '';
  msg = [];
  if isempty(style)
    return;
  end
  orig_t = style;
  while (~giveup && length(style) > 0)
    giveup = 1;
    if (matchit(getColorShortName(style), getColorShortNameList()))
      [colorspec, style] = parseit(getColorShortName(style), getColorShortNameList());
      giveup = 0;
    end;
    if (matchit(style, getMarkerNameList()))
      [markerspec, style] = parseit(style, getMarkerNameList());
      giveup = 0;
    end
    if (matchit(style, styleset()))
      [linespec, style] = parseit(style, styleset());
      giveup = 0;
    end
  end
  if (strcmp(markerspec, '') && strcmp(linespec, ''))
    linespec = '-';
  end
  if giveup
    colorspec = '';
    markerspec = '';
    linespec = '';
    msg.message = 'Invalid LineSpec string.';
    msg.Identifier = 'Nelson:colstyle:InvalidLinespec';
    return
  end
  if isempty(linespec)
    if emptyAsNone
      linespec = 'none';
    else
      linespec = '';
    end
  end
end
%=============================================================================
function b = matchit(t, dictionary)
  b = any(stcmp(dictionary, t));
end
%=============================================================================
function [b, t] = parseit(t, dictionary)
  n = stcmp(dictionary, t);
  b = dictionary{min(find(n))};
  t(1:length(b)) = [];
end
%=============================================================================
function c = styleset()
  c = {'--', ':', '-.', '-'};
end
%=============================================================================
function b = stcmp(source, pattern)
  b = zeros(size(source), 'logical');
  for i = 1:numel(source)
    b(i) = strncmp(source{i}, pattern, length(source{i}));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function comet(varargin)
  narginchk(1, 4);
  nargoutchk(0, 0);
  args = convertStringToCharArgs(varargin);
  [ax, args] = parseCometParent(args);
  [x, y, p] = parseCometData(args);
  cometAnimate(ax, x, y, [], p);
end
%=============================================================================
function [ax, args] = parseCometParent(args)
  if ~isempty(args) && isscalar(args{1}) && isgraphics(args{1}, 'axes')
    ax = args{1};
    args = args(2:end);
  else
    ax = [];
  end
end
%=============================================================================
function [x, y, p] = parseCometData(args)
  p = 0.1;
  if numel(args) == 1
    y = args{1};
    x = 1:numel(y);
  elseif numel(args) == 2
    x = args{1};
    y = args{2};
  elseif numel(args) == 3
    x = args{1};
    y = args{2};
    p = args{3};
  else
    error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
  end
  if ~isnumeric(x) || ~isnumeric(y) || ~isvector(x) || ~isvector(y) || numel(x) ~= numel(y) || isempty(x)
    error('Nelson:comet:invalidXAndY', 'X and Y must be nonempty numeric vectors with the same number of elements.');
  end
  if ~isnumeric(p) || ~isscalar(p) || ~isfinite(p) || p < 0 || p >= 1
    error('Nelson:comet:invalidP', 'P must be a scalar value in the interval [0, 1).');
  end
  x = x(:).';
  y = y(:).';
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function comet3(varargin)
  narginchk(1, 5);
  nargoutchk(0, 0);
  args = convertStringToCharArgs(varargin);
  [ax, args] = parseComet3Parent(args);
  [x, y, z, p] = parseComet3Data(args);
  cometAnimate(ax, x, y, z, p);
end
%=============================================================================
function [ax, args] = parseComet3Parent(args)
  if ~isempty(args) && isscalar(args{1}) && isgraphics(args{1}, 'axes')
    ax = args{1};
    args = args(2:end);
  else
    ax = [];
  end
end
%=============================================================================
function [x, y, z, p] = parseComet3Data(args)
  p = 0.1;
  if numel(args) == 1
    z = args{1};
    x = 1:numel(z);
    y = 1:numel(z);
  elseif numel(args) == 3
    x = args{1};
    y = args{2};
    z = args{3};
  elseif numel(args) == 4
    x = args{1};
    y = args{2};
    z = args{3};
    p = args{4};
  else
    error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
  end
  if ~isnumeric(x) || ~isnumeric(y) || ~isnumeric(z) || ~isvector(x) || ...
      ~ isvector(y) || ~isvector(z) || numel(x) ~= numel(y) || ...
      numel(x) ~= numel(z) || isempty(x)
    error('Nelson:comet3:invalidXYAnd', 'X, Y, and Z must be nonempty numeric vectors with the same number of elements.');
  end
  if ~isnumeric(p) || ~isscalar(p) || ~isfinite(p) || p < 0 || p >= 1
    error('Nelson:comet:invalidP', 'P must be a scalar value in the interval [0, 1).');
  end
  x = x(:).';
  y = y(:).';
  z = z(:).';
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = compass(varargin)
  narginchk(1, 1000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [parent, args] = graphicsParseParent(args);
  [u, v, lineSpec, colorSpec, markerSpec, propertiesList] = parseCompassArgs(args);
  % Each vector is drawn as a single arrow (shaft plus a two-segment head)
  % from the origin, scaled by the complex value it represents.
  arrow = [0; 1; 0.8 + 0.08i; 1; 0.8 - 0.08i];
  z = u + v .* 1i;
  a = arrow * z;
  if isempty(parent)
    ax = newplot();
  else
    ax = newplot(parent);
  end
  holdState = ishold(ax);
  maxr = max(abs(z));
  if isempty(maxr) || ~isfinite(maxr) || maxr <= 0
    maxr = 1;
  end
  if ~holdState
    hold(ax, 'on');
    drawCompassGrid(ax, maxr);
  end
  h = plot(ax, real(a), imag(a), lineSpec, propertiesList{:});
  if ~holdState
    set(ax, 'DataAspectRatio', [1 1 1]);
    axis(ax, 'off');
    hold(ax, 'off');
  end
  if isempty(colorSpec) && ~hasPropertyName(propertiesList, 'Color')
    colorOrder = get(ax, 'ColorOrder');
    if ~isempty(colorOrder)
      for k = 1:numel(h)
        h(k).Color = colorOrder(1, :);
      end
    end
  end
  if isempty(markerSpec) && ~hasPropertyName(propertiesList, 'Marker')
    for k = 1:numel(h)
      h(k).Marker = 'none';
    end
  end
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [u, v, lineSpec, colorSpec, markerSpec, propertiesList] = parseCompassArgs(args)
  if isempty(args)
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Value');
  end
  if numel(args) >= 2 && isnumeric(args{2})
    u = args{1};
    v = args{2};
    args = args(3:end);
  else
    if ~isnumeric(args{1})
      error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Value');
    end
    z = args{1};
    u = real(z);
    v = imag(z);
    args = args(2:end);
  end
  if numel(u) ~= numel(v)
    error('Nelson:dimagree:valueValueNumberElements', '%s and %s must have the same number of elements.', 'U', 'V');
  end
  if ~(isnumeric(u) && isnumeric(v))
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Value');
  end
  u = double(u(:).');
  v = double(v(:).');
  [lineSpec, colorSpec, markerSpec, propertiesList] = parseCompassLineSpec(args);
end
%=============================================================================
function [lineSpec, colorSpec, markerSpec, propertiesList] = parseCompassLineSpec(args)
  lineSpec = '-';
  colorSpec = '';
  markerSpec = '';
  if ~isempty(args) && (ischar(args{1}) || isStringScalar(args{1}))
    [~, colorSpec, markerSpec, msg] = colstyle(args{1}, 'plot', false);
    if isempty(msg)
      lineSpec = args{1};
      args = args(2:end);
    else
      colorSpec = '';
      markerSpec = '';
    end
  end
  if mod(numel(args), 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  propertiesList = args;
end
%=============================================================================
function drawCompassGrid(ax, dataMaxRadius)
  gridColor = [0.85 0.85 0.85];
  % Let the axes auto-scale a spanning segment to pick the radial tick step,
  % then reproduce the reference's radial grid layout from it.
  probe = line(ax, 'XData', [-dataMaxRadius dataMaxRadius NaN 0 0], ...
    'YData', [0 0 NaN -dataMaxRadius dataMaxRadius], ...
    'Color', gridColor, 'HandleVisibility', 'off');
  yLimits = get(ax, 'YLim');
  yTicks = get(ax, 'YTick');
  delete(probe);
  radiusMin = 0;
  radiusMax = yLimits(2);
  radiusTicks = max(yTicks);
  if radiusTicks > 5
    if rem(radiusTicks, 2) == 0
      radiusTicks = radiusTicks / 2;
    elseif rem(radiusTicks, 3) == 0
      radiusTicks = radiusTicks / 3;
    end
  end
  if ~isfinite(radiusTicks) || radiusTicks <= 0
    radiusTicks = 1;
  end
  if ~isfinite(radiusMax) || radiusMax <= 0
    radiusMax = dataMaxRadius;
  end
  % Unit circle, with the four axis-crossing points forced exactly onto the axes.
  th = 0:pi / 50:2 * pi;
  xUnit = cos(th);
  yUnit = sin(th);
  crossings = 1:(numel(th) - 1) / 4:numel(th);
  xUnit(crossings(2:2:4)) = 0;
  yUnit(crossings(1:2:5)) = 0;
  radiusStep = (radiusMax - radiusMin) / radiusTicks;
  for radius = (radiusMin + radiusStep):radiusStep:radiusMax
    line(ax, 'XData', xUnit * radius, 'YData', yUnit * radius, ...
      'LineStyle', '-', 'Color', gridColor, 'LineWidth', 1, 'HandleVisibility', 'off');
    text(ax, 0, radius + radiusStep / 20, ['  ' num2str(radius)], ...
      'VerticalAlignment', 'bottom', 'HandleVisibility', 'off');
  end
  % Radial spokes every 30 degrees, drawn as full diameters.
  spokeAngles = (1:6) * 2 * pi / 12;
  cosAngles = cos(spokeAngles);
  sinAngles = sin(spokeAngles);
  for k = 1:numel(spokeAngles)
    line(ax, 'XData', [-cosAngles(k) cosAngles(k)] * radiusMax, ...
      'YData', [-sinAngles(k) sinAngles(k)] * radiusMax, ...
      'LineStyle', '-', 'Color', gridColor, 'LineWidth', 1, 'HandleVisibility', 'off');
  end
  % Degree annotations around the outer rim.
  labelRadius = 1.1 * radiusMax;
  for k = 1:numel(spokeAngles)
    text(ax, labelRadius * cosAngles(k), labelRadius * sinAngles(k), int2str(k * 30), ...
      'HorizontalAlignment', 'center', 'HandleVisibility', 'off');
    if k == numel(spokeAngles)
      oppositeLabel = int2str(0);
    else
      oppositeLabel = int2str(180 + k * 30);
    end
    text(ax, -labelRadius * cosAngles(k), -labelRadius * sinAngles(k), oppositeLabel, ...
      'HorizontalAlignment', 'center', 'HandleVisibility', 'off');
  end
  view(ax, 2);
  axis(ax, radiusMax * [-1 1 -1.15 1.15]);
  xTicks = ceil(-radiusMax):floor(radiusMax);
  if ~isempty(xTicks)
    ax.XTick = xTicks;
  end
end
%=============================================================================
function tf = hasPropertyName(propertiesList, name)
  tf = false;
  for k = 1:2:numel(propertiesList)
    propertyName = propertiesList{k};
    if (ischar(propertyName) || isStringScalar(propertyName)) && strcmpi(propertyName, name)
      tf = true;
      return
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = compassplot(varargin)
  narginchk(1, 1000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [ax, args] = parseCompassParent(args);
  [theta, radius, source, args] = parseCompassData(args);
  props = parseCompassProperties(args);
  [fig, previousDrawLater] = polarBeginDrawLater(ax);
  try
    ax = polarPrepareDataAxes(ax);
    [h, allHandles] = drawCompassVectors(ax, theta, radius, source, props);
    polarAppendDataHandles(ax, allHandles);
    polarEndDrawLater(fig, previousDrawLater);
  catch exception
    polarEndDrawLater(fig, previousDrawLater);
    error(exception.message);
  end
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [ax, args] = parseCompassParent(args)
  if ~isempty(args) && isscalar(args{1}) && isgraphics(args{1})
    if ~isgraphics(args{1}, 'polaraxes')
      error('Nelson:graphics:invalidParentInput', 'Parent input must be a polaraxes object.');
    end
    ax = args{1};
    args = args(2:end);
    if isempty(args)
      error('Nelson:validators:mustBeVector', '%s must be a vector.', 'Value');
    end
    return
  end
  [ax, args] = polarParseTargetAxes(args);
end
%=============================================================================
function [theta, radius, source, args] = parseCompassData(args)
  source = struct('Table', [], 'ThetaVariable', [], 'RVariable', []);
  if isempty(args)
    error('Nelson:validators:mustBeVector', '%s must be a vector.', 'Value');
  end
  if (istable(args{1}) || istimetable(args{1})) && numel(args) >= 3
    [theta, radius, source] = parseCompassTableData(args);
    [theta, radius] = matchCompassData(theta, radius);
    args = args(4:end);
  elseif istable(args{1}) || istimetable(args{1})
    error('Nelson:validators:mustBeVector', '%s must be a vector.', 'Value');
  elseif isnumeric(args{1}) && (numel(args) == 1 || isCompassPropertyName(args{2}))
    z = args{1};
    theta = angle(z);
    radius = abs(z);
    args = args(2:end);
  elseif numel(args) >= 2 && isnumeric(args{1}) && isnumeric(args{2})
    theta = args{1};
    radius = args{2};
    [theta, radius] = matchCompassData(theta, radius);
    args = args(3:end);
  else
    error('Nelson:compassplot:numericVectorDataExpected', '%s must be a numeric vector.', 'Value');
  end
  if ~(isnumeric(theta) && isnumeric(radius)) || ~isreal(theta) || ~isreal(radius)
    error('Nelson:compassplot:numericRealVectorExpected', 'Numeric real vector data expected.');
  end
end
%=============================================================================
function [theta, radius, source] = parseCompassTableData(args)
  tbl = args{1};
  thetaNames = graphicsTableVariableNames(tbl, args{2});
  radiusNames = graphicsTableVariableNames(tbl, args{3});
  nSeries = max(numel(thetaNames), numel(radiusNames));
  validateTableVariableCounts(thetaNames, radiusNames, nSeries);
  [theta, radius, thetaVars, radiusVars] = compassTableSeries(tbl, thetaNames, radiusNames, nSeries);
  source = struct('Table', tbl, 'ThetaVariable', {thetaVars}, 'RVariable', {radiusVars});
end
%=============================================================================
function validateTableVariableCounts(thetaNames, radiusNames, nSeries)
  counts = [numel(thetaNames), numel(radiusNames)];
  if any(counts ~= 1 & counts ~= nSeries)
    error('Nelson:dimagree:tableVariableCountsMatch', 'Table variable counts must match.');
  end
end
%=============================================================================
function [theta, radius, thetaVars, radiusVars] = compassTableSeries(tbl, thetaNames, radiusNames, nSeries)
  theta = [];
  radius = [];
  thetaVars = cell(1, nSeries);
  radiusVars = cell(1, nSeries);
  for k = 1:nSeries
    thetaName = selectName(thetaNames, k);
    radiusName = selectName(radiusNames, k);
    theta = appendColumn(theta, numericColumn(tbl.(thetaName), thetaName));
    radius = appendColumn(radius, numericColumn(tbl.(radiusName), radiusName));
    thetaVars{k} = thetaName;
    radiusVars{k} = radiusName;
  end
end
%=============================================================================
function [theta, radius] = matchCompassData(theta, radius)
  if isvector(theta) && isvector(radius)
    if numel(theta) ~= numel(radius)
      error('Nelson:dimagree:valueValueNumberElements', '%s and %s must have the same number of elements.', 'Theta', 'R');
    end
    theta = theta(:);
    radius = radius(:);
    return
  end
  if isvector(theta) && ismatrix(radius)
    theta = expandCompassVector(theta, size(radius));
    return
  end
  if ismatrix(theta) && isvector(radius)
    radius = expandCompassVector(radius, size(theta));
    return
  end
  if ~isequal(size(theta), size(radius))
    error('Nelson:dimagree:thetaRCompatibleSizes', 'Theta and R must have compatible sizes.');
  end
end
%=============================================================================
function data = appendColumn(data, value)
  value = value(:);
  if isempty(data)
    data = value;
  else
    data = [data, value];
  end
end
%=============================================================================
function value = numericColumn(value, name)
  if ~isnumeric(value)
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', name);
  end
  value = value(:);
end
%=============================================================================
function name = selectName(names, k)
  if numel(names) == 1
    name = names{1};
  else
    name = names{k};
  end
end
%=============================================================================
function values = expandCompassVector(values, targetSize)
  n = numel(values);
  if n == targetSize(1)
    values = repmat(values(:), 1, targetSize(2));
  elseif n == targetSize(2)
    values = repmat(values(:).', targetSize(1), 1);
  else
    error('Nelson:dimagree:thetaRCompatibleSizes', 'Theta and R must have compatible sizes.');
  end
end
%=============================================================================
function props = parseCompassProperties(args)
  props = {};
  if isempty(args)
    return
  end
  if numel(args) == 1 && (ischar(args{1}) || isStringScalar(args{1}))
    props = {'Color', validatecolor(args{1})};
    return
  end
  if rem(length(args), 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  for k = 1:2:length(args)
    name = char(args{k});
    value = args{k + 1};
    switch lower(name)
      case {'color', 'linewidth', 'linestyle', 'displayname', 'visible', 'tag', 'userdata', ...
          'thetadatasource', 'rdatasource'}
        props = [props, {name, value}];
      otherwise
        error('Nelson:graphics:unsupportedProperty', 'Unsupported "%s" option.', 'compassplot');
    end
  end
end
%=============================================================================
function tf = isCompassPropertyName(value)
  tf = false;
  if ~(ischar(value) || isStringScalar(value))
    return
  end
  names = {'Color', 'LineWidth', 'LineStyle', 'DisplayName', 'Visible', 'Tag', 'UserData', ...
    'ThetaDataSource', 'RDataSource'};
  tf = any(strcmpi(char(value), names));
end
%=============================================================================
function [mainHandles, allHandles] = drawCompassVectors(ax, theta, radius, source, props)
  if isvector(theta)
    theta = theta(:);
    radius = radius(:);
  end
  mainHandles = gobjects(size(theta, 2), 1);
  allHandles = gobjects(0, 1);
  for k = 1:size(theta, 2)
    color = getColorAndUpdateIndex(ax);
    vectorProps = [{'Color', color}, props];
    sourceProps = {};
    if ~isempty(source.Table)
      sourceProps = {'SourceTable', source.Table, 'ThetaVariable', selectSourceName(source.ThetaVariable, k), ...
        'RVariable', selectSourceName(source.RVariable, k)};
    end
    mainHandles(k) = __compassplot__('Parent', ax, 'XData', [], 'YData', [], ...
      'ThetaData', theta(:, k), 'RData', radius(:, k), sourceProps{:}, vectorProps{:});
    allHandles = [allHandles; mainHandles(k)];
  end
end
%=============================================================================
function name = selectSourceName(names, k)
  if iscell(names)
    name = selectName(names, k);
  else
    name = names;
  end
end
