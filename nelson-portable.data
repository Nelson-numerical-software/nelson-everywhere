%=============================================================================
function varargout = length(varargin)
  narginchk(1, 1);
  nargoutchk(0, 1);
  [m, n] = size(varargin{1}.Numerator);
  varargout{1} = m * n;
end
%=============================================================================

%=============================================================================
% Copyright (c) 2017 October Daniel Mårtensson (Swedish Embedded Control Systems Toolbox)
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = lqr(varargin)
  % Compute the LQR gain matrix control law L with the weighing matrices Q and R
  % [K, S, e] = lqr(SYS, Q, R, N)
  narginchk(3, 4);
  nargoutchk(0, 3);
  sys = ss(varargin{1});
  Q = varargin{2};
  R = varargin{3};
  if nargin > 3
    N = varargin{4};
    [K, S, e] = lqr(sys, Q, R, N);
  else
    [K, S, e] = lqr(sys, Q, R);
  end
  varargout{1} = K;
  if nargout > 1
    varargout{2} = S;
  end
  if nargout > 2
    varargout{3} = e;
  end
end

%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = lqry(varargin)
  % Form linear-quadratic (LQ) state-feedback regulator with output weighting
  % [K, S, e] = lqry(sys, Q, R)
  % [K, S, e] = lqry(sys, Q, R, N)
  narginchk(3, 4);
  nargoutchk(0, 3);

  sys = ss(varargin{1});
  Q = varargin{2};
  R = varargin{3};

  mustBeNumeric(Q, 2);
  mustBeNumeric(R, 3);

  if nargin == 4
    N = varargin{4};
  else
    N = zeros(size(Q, 1), size(R, 1));
  end
  mustBeNumeric(R, 4);

  [K, S, e] = lqry(sys, Q, R, N);
  varargout{1} = K;
  if nargout > 1
    varargout{2} = S;
  end
  if nargout > 2
    varargout{3} = e;
  end
end
%=============================================================================
% Copyright (c) 2017 October Daniel Mårtensson (Swedish Embedded Control Systems Toolbox)
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = minreal(varargin)
  % Minimal realization and pole-zero cancellation.
  % sysOut = minreal(sysIn)
  % sysOut = minreal(sysIn, tol)
  narginchk(1, 2);
  nargoutchk(0, 1);

  sysIn = varargin{1};
  [a, b, c, d] = ssdata(sysIn);
  if nargin < 2
    tol = 1e-6;
  else
    tol = varargin{2};
  end

  [am, bm, cm, dm] = minreal(a, b, c, d);
  sysOut = ss(am, bm, cm, dm, sysIn.Ts);
  varargout{1} = tf(sysOut);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function sys = minus(sysA, sysB)
  sysA = tf(sysA);
  sysB = tf(sysB);
  if ~issiso(sysA) || ~issiso(sysB)
    error('Nelson:control_system:invalidType', '%s expected.', 'SISO lti');
  end

  sys = minus_siso(sysA, sysB);

  variable = ltiMergeTfVariable(sysA, sysB);
  if ~isempty(variable)
    sys.Variable = variable;
  end
  sys = ltiApplyCommonMetadata(sys, sysA, sysB);
  userData = ltiMergeUserData(sysA, sysB);
  if ~isempty(userData)
    sys.UserData = userData;
  end
end
%=============================================================================
function sys = minus_siso(sysA, sysB)

  Ts = ltiResolveSampleTime(sysA, sysB);
  numerator = [];
  denominator = [];
  for idx = 1:size(sysA.Numerator{1}, 1)
    numeratorA = sysA.Numerator{1};
    numeratorB = sysB.Numerator{1};
    denominatorA = sysA.Denominator{1};
    denominatorB = sysB.Denominator{1};

    numerator1 = conv(numeratorA(idx, :), denominatorB);
    numerator2 = conv(numeratorB(idx, :), denominatorA);
    len = length(numerator1) - length(numerator2);

    if (len > 0)
      numerator2 = [zeros(1, len), numerator2];
    elseif (len < 0)
      numerator1 = [zeros(1, -len), numerator1];
    end
    if isempty(numerator)
      numerator = numerator1 - numerator2;
    else
      numerator(idx, :) = numerator1 - numerator2;
    end
    denominator = conv(denominatorA, denominatorB);
  end
  sys = tf(numerator, denominator, Ts);
end
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = mldivide(varargin)
  narginchk(2, 2),
  nargoutchk(0, 1);
  sysA = tf(varargin{1});
  sysB = tf(varargin{2});
  sys = inv(sysA) * sysB;
  varargout{1} = sys;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = mpower(varargin)
  narginchk(2, 2)
  nargoutchk(0, 1)
  sysA = tf(varargin{1});
  n = varargin{2};
  mustBeNumeric(n, 2);
  mustBeInteger(n, 2);
  mustBeScalarOrEmpty(n, 2);
  mustBeNonempty(n, 2);
  if (n == 0)
    varargout{1} = ss(1);
    return;
  end

  if (n < 0)
    n = -n;
    sysA = inv(sysA);
  end
  sys = sysA;
  for i = 2:n
    sys = sys * sysA;
  end
  varargout{1} = sys;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = mrdivide(varargin)
  narginchk(2, 2);
  nargoutchk(0, 1);
  sysA = tf(varargin{1});
  sysB = tf(varargin{2});
  if ~issiso(sysA) && ~issiso(sysB)
    error('Nelson:control_system:invalidType', '%s expected.', 'SISO LTI model');
  end
  Ts = ltiResolveSampleTime(sysA, sysB);

  numeratorA = sysA.Numerator{1};
  denominatorA = sysA.Denominator{1};
  numeratorB = sysB.Numerator{1};
  denominatorB = sysB.Denominator{1};

  if isempty(numeratorA) || isempty(numeratorB) || isempty(denominatorA) || isempty(denominatorB)
    error('Nelson:control_system:dimagree:matrixDimensionsAgree', 'Matrix dimensions must agree.');
  end

  if isstatic(sysA) && isstatic(sysB)
    numerator = numeratorA / numeratorB;
    sys = tf(numerator, 1, Ts);
  else
    numerator = conv(numeratorA, denominatorB);
    denominator = conv(denominatorA, numeratorB);
    sys = tf(numerator, denominator, Ts);
  end

  variable = ltiMergeTfVariable(sysA, sysB);
  if ~isempty(variable)
    sys.Variable = variable;
  end
  sys = ltiApplyCommonMetadata(sys, sysA, sysB);

  userData = ltiMergeUserData(sysA, sysB);
  if ~isempty(userData)
    sys.UserData = userData;
  end
  varargout{1} = sys;
end
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function sys = mtimes(sys1, sys2)
  sysA = tf(sys1);
  sysB = tf(sys2);

  if ~issiso(sysA) && ~issiso(sysB)
    error('Nelson:control_system:invalidType', '%s expected.', 'SISO LTI model');
  end

  numeratorA = sysA.Numerator{1};
  denominatorA = sysA.Denominator{1};
  numeratorB = sysB.Numerator{1};
  denominatorB = sysB.Denominator{1};

  numerator = conv(numeratorA, numeratorB);
  denominator = conv(denominatorA, denominatorB);

  Ts = ltiResolveSampleTime(sysA, sysB);
  sys = tf(numerator, denominator, Ts);

  variable = ltiMergeTfVariable(sysA, sysB);
  if ~isempty(variable)
    sys.Variable = variable;
  end
  sys = ltiApplySeriesMetadata(sys, sysA, sysB);

  userData = ltiMergeUserData(sysA, sysB);
  if ~isempty(userData)
    sys.UserData = userData;
  end
end
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function sys = plus(sysA, sysB)
  sysA = tf(sysA);
  sysB = tf(sysB);
  if ~issiso(sysA) || ~issiso(sysB)
    error('Nelson:control_system:invalidType', '%s expected.', 'SISO lti');
  end

  sys = plus_siso(sysA, sysB);

  variable = ltiMergeTfVariable(sysA, sysB);
  if ~isempty(variable)
    sys.Variable = variable;
  end
  sys = ltiApplyCommonMetadata(sys, sysA, sysB);
  userData = ltiMergeUserData(sysA, sysB);
  if ~isempty(userData)
    sys.UserData = userData;
  end
end
%=============================================================================
function sys = plus_siso(sysA, sysB)

  Ts = ltiResolveSampleTime(sysA, sysB);
  numerator = [];
  denominator = [];
  for idx = 1:size(sysA.Numerator{1}, 1)
    numeratorA = sysA.Numerator{1};
    numeratorB = sysB.Numerator{1};
    denominatorA = sysA.Denominator{1};
    denominatorB = sysB.Denominator{1};

    numerator1 = conv(numeratorA(idx, :), denominatorB);
    numerator2 = conv(numeratorB(idx, :), denominatorA);
    len = length(numerator1) - length(numerator2);

    if (len > 0)
      numerator2 = [zeros(1, len), numerator2];
    elseif (len < 0)
      numerator1 = [zeros(1, -len), numerator1];
    end
    if isempty(numerator)
      numerator = numerator1 + numerator2;
    else
      numerator(idx, :) = numerator1 + numerator2;
    end
    denominator = conv(denominatorA, denominatorB);
  end

  sys = tf(numerator, denominator, Ts);
end
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = properties(obj)
  props = ltiPropertyNames(class(obj));
  if (nargout == 0)
    currentFormat = format();
    if strcmp(currentFormat.LineSpacing, 'loose')
      disp(' ');
    end
    disp('Properties for class tf:');
    if strcmp(currentFormat.LineSpacing, 'loose')
      disp(' ');
    end
    for p = props'
      disp(['    ', p{1}]);
    end
    if strcmp(currentFormat.LineSpacing, 'loose')
      disp(' ');
    end
  else
    varargout{1} = props;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = size(varargin)
  narginchk(1, 2);
  nargoutchk(0, 2);
  [m, n] = size(varargin{1}.Numerator);
  if (nargout == 0 && nargin == 1)
    disp(sprintf(_('Transfer function with %d outputs and %d inputs.'), m, n));
  else
    if (nargin == 1)
      if (nargout == 1)
        varargout{1} = [m, n];
      else
        varargout{1} = m;
        varargout{2} = n;
      end
    else
      pos = varargin{2};
      if (pos < 1)
        error('Nelson:validators:mustBePositiveInteger', '%s must be a positive integer.', 'Second argument');
      end
      switch pos
        case 1
          varargout{1} = m;
        case 2
          varargout{1} = n;
        otherwise
          varargout{1} = 1;
      end
    end
  end
end
%=============================================================================

%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = subsasgn(varargin)
  obj = varargin{1};
  s = varargin{2};
  value = varargin{3};
  if strcmp(s(1).type, '()')
    if length(s) > 1
      currentValue = subsref(obj, s(1));
      value = subsasgn(currentValue, s(2:end), value);
    end
    obj = assignSubsystem(obj, s(1).subs, value);
    varargout{1} = obj;
    return
  end
  if strcmp(s(1).type, '{}')
    error('Nelson:control_system:invalidSubscript:illegalIndexingStructureArgumentTypeValue', 'Illegal indexing structure argument: type %s expected.', "'.' or '()'");
  end
  if ~strcmp(s(1).type, '.')
    error('Nelson:control_system:invalidSubscript:notAValidIndexingExpression', 'Not a valid indexing expression');
  end
  name = s(1).subs;
  if ~isprop(obj, name)
    msg = _('No property of the class ''%s'' matches the identifier ''%s''.');
    error('Nelson:control_system:unknownProperty', sprintf(msg, 'tf', name));
  end
  if length(s) > 1
    currentValue = ltiSubscriptGet(obj, name);
    value = subsasgn(currentValue, s(2:end), value);
  end
  switch name
    case 'Numerator'
      if ~iscell(value)
        value = {value};
      end
      obj.Numerator = value;
    case 'Denominator'
      if ~iscell(value)
        value = {value};
      end
      obj.Denominator = value;
    case 'Variable'
      obj.Variable = validateVariable(obj, value);
    case 'Ts'
      obj.Ts = ltiValidateSampleTime(value);
      obj.Internal.Ts = obj.Ts;
      obj.Internal.IsStatic = false;
    case 'TimeUnit'
      obj.TimeUnit = ltiValidateTimeUnit(value);
    case 'Name'
      obj.Name = ltiValidateTextScalar('Name', value);
    otherwise
      obj = ltiSubscriptSet(obj, name, value);
  end
  varargout{1} = obj;
end
%=============================================================================
function obj = assignSubsystem(obj, indices, value)
  value = tf(value);
  ltiCheckSampleTimeCompatibility(obj, value);
  numerator = obj.Numerator;
  denominator = obj.Denominator;
  replacementNumerator = expandReplacement(value.Numerator, numerator(indices{:}));
  replacementDenominator = expandReplacement(value.Denominator, denominator(indices{:}));
  numerator(indices{:}) = replacementNumerator;
  denominator(indices{:}) = replacementDenominator;
  obj.Numerator = numerator;
  obj.Denominator = denominator;
  if ~isempty(value.Variable)
    obj.Variable = value.Variable;
  end
end
%=============================================================================
function replacement = expandReplacement(replacement, target)
  if isequal(size(replacement), size(target))
    return
  end
  if isscalar(replacement)
    scalarValue = replacement{1};
    replacement = cell(size(target));
    replacement(:) = {scalarValue};
    return
  end
  error('Nelson:control_system:dimagree:matrixDimensionsAgree', 'Matrix dimensions must agree.');
end
function value = validateVariable(obj, value)
  value = ltiValidateTextScalar('Variable', value);
  supported = {'s', 'p', 'z', 'q', 'z^-1', 'q^-1'};
  if ~any(strcmp(value, supported))
    error('Nelson:control_system:invalidVariable', '%s expected.', "'s', 'p', 'z', 'q', 'z^-1', or 'q^-1'");
  end
  if obj.Ts == 0 && any(strcmp(value, {'z', 'q', 'z^-1', 'q^-1'})) && ~isstatic(obj)
    error('Nelson:control_system:invalidVariable:discreteTimeVariableRequiresADiscrete', 'Discrete-time variable requires a discrete-time model.');
  end
  if (obj.Ts > 0 || obj.Ts == -1) && any(strcmp(value, {'s', 'p'}))
    error('Nelson:control_system:invalidVariable:continuousTimeVariableRequiresAContinuous', 'Continuous-time variable requires a continuous-time model.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = subsref(varargin)
  obj = varargin{1};
  s = varargin{2};
  if strcmp(s(1).type, '()')
    if length(s) > 1
      partial = subsref(obj, s(1));
      [varargout{1:nargout}] = subsref(partial, s(2:end));
      return
    end
    indices = s(1).subs;
    numerator = ltiSubscriptGet(obj, 'Numerator');
    denominator = ltiSubscriptGet(obj, 'Denominator');
    sampleTime = ltiSubscriptGet(obj, 'Ts');
    sys = tf(numerator(indices{:}), denominator(indices{:}), sampleTime);
    sys.Variable = ltiSubscriptGet(obj, 'Variable');
    sys.TimeUnit = ltiSubscriptGet(obj, 'TimeUnit');
    sys.UserData = ltiSubscriptGet(obj, 'UserData');
    sys.InputName = ltiSelectIOProperty(ltiSubscriptGet(obj, 'InputName'), indices, 2);
    sys.InputUnit = ltiSelectIOProperty(ltiSubscriptGet(obj, 'InputUnit'), indices, 2);
    sys.OutputName = ltiSelectIOProperty(ltiSubscriptGet(obj, 'OutputName'), indices, 1);
    sys.OutputUnit = ltiSelectIOProperty(ltiSubscriptGet(obj, 'OutputUnit'), indices, 1);
    varargout{1} = sys;
    return
  end
  if strcmp(s(1).type, '{}')
    error('Nelson:control_system:invalidSubscript:illegalIndexingStructureArgumentTypeValue', 'Illegal indexing structure argument: type %s expected.', "'.' or '()'");
  end
  if ~strcmp(s(1).type, '.')
    error('Nelson:control_system:invalidSubscript:notAValidIndexingExpression', 'Not a valid indexing expression');
  end
  value = ltiSubscriptGet(obj, s(1).subs);
  if length(s) > 1
    [varargout{1:nargout}] = subsref(value, s(2:end));
  else
    varargout{1} = value;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2017 September Daniel Mårtensson (Swedish Embedded Control Systems Toolbox)
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
classdef tf
  properties
    IODelay = 0
    InputDelay = 0
    OutputDelay = 0
    InputName = {}
    InputUnit = {}
    InputGroup = []
    OutputName = {}
    OutputUnit = {}
    OutputGroup = []
    Notes = []
    UserData = []
    SamplingGrid = []
  end

  properties (Dependent)
    Numerator
    Denominator
    Variable
    Name
    Ts
    TimeUnit
  end

  properties (Hidden)
    NumeratorValue = {}
    DenominatorValue = {}
    VariableValue = 's'
    NameValue = ''
    TsValue = 0
    TimeUnitValue = 'seconds'
    Internal = []
  end

  methods
    function obj = tf(varargin)
      nargoutchk(0, 1);
      obj.Internal.Version = 1;
      obj.Internal.Ts = 0;
      obj.Internal.IsStatic = false;
      if nargin == 0
        return
      end
      [dataArgs, propertyArgs] = splitConstructorArguments(varargin);
      obj = constructTransferFunction(obj, dataArgs);
      obj = applyPropertyPairs(obj, propertyArgs);
    end

    function value = get.Numerator(obj)
      value = obj.NumeratorValue;
    end

    function obj = set.Numerator(obj, value)
      if ~iscell(value)
        value = {value};
      end
      obj.NumeratorValue = value;
    end

    function value = get.Denominator(obj)
      value = obj.DenominatorValue;
    end

    function obj = set.Denominator(obj, value)
      if ~iscell(value)
        value = {value};
      end
      obj.DenominatorValue = value;
    end

    function value = get.Variable(obj)
      value = obj.VariableValue;
    end

    function obj = set.Variable(obj, value)
      value = ltiValidateTextScalar('Variable', value);
      supported = {'s', 'p', 'z', 'q', 'z^-1', 'q^-1'};
      if ~any(strcmp(value, supported))
        error('Nelson:control_system:invalidVariable', '%s expected.', "'s', 'p', 'z', 'q', 'z^-1', or 'q^-1'");
      end
      if obj.Ts == 0 && any(strcmp(value, {'z', 'q', 'z^-1', 'q^-1'})) && ~isstatic(obj)
        error('Nelson:control_system:invalidVariable:discreteTimeVariableRequiresADiscrete', 'Discrete-time variable requires a discrete-time model.');
      end
      if (obj.Ts > 0 || obj.Ts == -1) && any(strcmp(value, {'s', 'p'}))
        error('Nelson:control_system:invalidVariable:continuousTimeVariableRequiresAContinuous', 'Continuous-time variable requires a continuous-time model.');
      end
      obj.VariableValue = value;
    end

    function value = get.Ts(obj)
      value = obj.TsValue;
    end

    function obj = set.Ts(obj, value)
      value = ltiValidateSampleTime(value);
      obj.TsValue = value;
      obj.Internal.Ts = value;
      obj.Internal.IsStatic = false;
    end

    function value = get.TimeUnit(obj)
      value = obj.TimeUnitValue;
    end

    function obj = set.TimeUnit(obj, value)
      value = ltiValidateTimeUnit(value);
      obj.TimeUnitValue = value;
    end

    function value = get.Name(obj)
      value = obj.NameValue;
    end

    function obj = set.Name(obj, value)
      obj.NameValue = ltiValidateTextScalar('Name', value);
    end

    function st = struct(obj)
      st = builtin('struct');
      names = ltiPropertyNames('tf');
      for k = 1:length(names)
        name = names{k};
        st.(name) = obj.(name);
      end
      st.Internal = obj.Internal;
    end
  end
end
%=============================================================================
function [dataArgs, propertyArgs] = splitConstructorArguments(args)
  propertyStart = length(args) + 1;
  if isempty(args)
    dataArgs = {};
    propertyArgs = {};
    return
  end
  if isVariableName(args{1})
    if length(args) >= 2 && isnumeric(args{2})
      propertyStart = 3;
    else
      propertyStart = 2;
    end
  else
    for k = 2:length(args)
      if isTextScalar(args{k})
        propertyStart = k;
        break
      end
    end
  end
  dataArgs = args(1:propertyStart - 1);
  propertyArgs = args(propertyStart:end);
end
%=============================================================================
function obj = constructTransferFunction(obj, args)
  switch length(args)
    case 0
      return
    case 1
      obj = tfOneArgument(obj, args{1});
    case 2
      obj = tfTwoArguments(obj, args{1}, args{2});
    case 3
      obj = tfNumeratorDenominator(obj, args{1}, args{2}, args{3});
    otherwise
      error('Nelson:control_system:wrongNumberOfArguments', 'Wrong number of input arguments.');
  end
end
%=============================================================================
function obj = tfOneArgument(obj, value)
  if islti(value)
    if isa(value, 'tf')
      obj = value;
    elseif isa(value, 'ss')
      obj = ssToTf(value);
    else
      error('Nelson:control_system:invalidType', '%s expected.', 'Supported LTI model')
    end
    return
  end
  if isVariableName(value)
    obj = tfVariable(obj, value);
    return
  end
  if ~isnumeric(value)
    error('Nelson:control_system:invalidType', '%s expected.', 'numeric value');
  end
  obj = tfStaticGain(obj, value);
end
%=============================================================================
function obj = tfTwoArguments(obj, first, second)
  if isVariableName(first)
    obj = tfVariable(obj, first, second);
  else
    obj = tfNumeratorDenominator(obj, first, second, 0);
  end
end
%=============================================================================
function obj = tfNumeratorDenominator(obj, numerator, denominator, Ts)
  ltiValidateSampleTime(Ts);
  [num, den, variableName, isStatic] = adjustTransferFunctionParameters(numerator, denominator, Ts);
  obj = tfConstructor(obj, num, den, Ts, variableName, isStatic);
end
%=============================================================================
function obj = tfStaticGain(obj, value)
  obj.Denominator = num2cell(ones(size(value)));
  obj.Numerator = num2cell(value);
  obj.Variable = 's';
  obj.Ts = 0;
  obj.Internal.Ts = -2;
  obj.Internal.IsStatic = true;
end
%=============================================================================
function obj = tfVariable(obj, value, Ts)
  value = ltiValidateTextScalar('Variable', value);
  if nargin < 3
    Ts = defaultSampleTimeForVariable(value);
  end
  ltiValidateSampleTime(Ts);
  obj = tfConstructor(obj, [1 0], [1], Ts, value, false);
end
%=============================================================================
function Ts = defaultSampleTimeForVariable(value)
  if any(strcmp(value, {'z', 'q'}))
    Ts = -1;
  else
    Ts = 0;
  end
end
%=============================================================================
function obj = ssToTf(sysIn)
  if isstatic(sysIn)
    obj = tf(sysIn.D);
    obj = ltiCopyModelMetadata(obj, sysIn);
    return
  end
  [A, B, C, D, Ts] = ssdata(sysIn);
  obj = tf();
  for i = 1:size(B, 2)
    for j = 1:size(C, 1)
      [a, b, c, d] = minreal(A, B(:, i), C(j, :), D(j, i));
      [N, D] = ss2tf(a, b, c, d);
      partialG = tf(N, D, Ts);
      obj.Numerator(j, i) = partialG.Numerator;
      obj.Denominator(j, i) = partialG.Denominator;
    end
  end
  obj.Ts = sysIn.Ts;
  obj = ltiCopyModelMetadata(obj, sysIn);
end
%=============================================================================
function [numerator, denominator, variableName, isStaticGain] = adjustTransferFunctionParameters(numerator, denominator, Ts)
  variableName = '';
  isStaticGain = false;
  if isempty(denominator)
    if isempty(numerator)
      numerator = {};
      denominator = {};
      isStaticGain = true;
    elseif isnumeric(numerator) && ismatrix(numerator) && isreal(numerator)
      numerator = num2cell(numerator);
      denominator = num2cell(ones(size(numerator)));
      isStaticGain = true;
    end
  end
  if ~iscell(numerator)
    numerator = {numerator};
  end
  if ~iscell(denominator)
    denominator = {denominator};
  end
  checkAllZeros = @(x) all(x == 0.);
  zeroNumerator = cellfun(checkAllZeros, numerator);
  zeroDenominator = cellfun(checkAllZeros, denominator);
  isAllZeroNumerator = all(zeroNumerator(:));
  isAllZeroDenominator = all(zeroDenominator(:));
  checkScalar = @(x) isempty(find(x ~= 0, 1)) || (find(x ~= 0, 1) == length(x));
  scalarNumerator = cellfun(checkScalar, numerator);
  scalarDenominator = cellfun(checkScalar, denominator);
  isAllScalarNumerator = ~isAllZeroNumerator && all(scalarNumerator(:));
  isAllScalarDenominator = ~isAllZeroDenominator && all(scalarDenominator(:));
  if isAllScalarNumerator && isAllScalarDenominator
    isStaticGain = true;
  end
  if isStaticGain || Ts == 0
    variableName = 's';
  else
    variableName = 'z';
  end
end
%=============================================================================
function obj = tfConstructor(obj, numerator, denominator, Ts, variableName, isStaticGain)
  ltiValidateSampleTime(Ts);
  numerator = checkFractionPart(numerator);
  denominator = checkFractionPart(denominator);
  if length(numerator) == 1
    for k = 2:length(denominator)
      numerator{k} = numerator{1};
    end
  end
  if length(denominator) == 1
    for k = 2:length(numerator)
      denominator{k} = denominator{1};
    end
  end
  if length(numerator) ~= length(denominator)
    error('Nelson:control_system:dimagree:numeratorDenominatorCompatibleSizes', 'Numerator and Denominator must have compatible sizes.');
  end
  for k = 1:length(numerator)
    [N, D] = arrangeVectors(numerator{k}, denominator{k});
    numerator{k} = N;
    denominator{k} = D;
  end
  obj.Denominator = denominator;
  obj.Numerator = numerator;
  obj.Ts = Ts;
  obj.Variable = variableName;
  obj.Internal.IsStatic = isStaticGain;
  if isStaticGain && Ts == 0
    obj.Internal.Ts = -2;
  end
end
%=============================================================================
function modifiedPart = checkFractionPart(part)
  if iscell(part)
    part = part;
  elseif isnumeric(part)
    if isvector(part) || isempty(part)
      part = part(:)';
      part = {part};
    else
      error('Nelson:control_system:invalidSyntax', 'Invalid syntax.');
    end
  else
    error('Nelson:control_system:invalidSyntax', 'Invalid syntax.');
  end
  for j = 1:numel(part)
    part{j} = part{j}(:)';
    for i = 1:length(part{j})
      if part{j}(i) > 0 || part{j}(i) < 0
        part{j} = part{j}(1, i:length(part{j}));
        break
      end
    end
  end
  modifiedPart = part;
end
%=============================================================================
function [v1, v2] = arrangeVectors(v1, v2)
  v1 = v1(:)';
  v2 = v2(:)';
  lenV1 = length(v1);
  lenV2 = length(v2);
  if lenV2 ~= lenV1
    if lenV2 > lenV1
      v1 = [zeros(1, lenV2 - lenV1), v1];
    end
    if lenV2 < lenV1
      v2 = [zeros(1, lenV1 - lenV2), v2];
    end
  end
end
%=============================================================================
function obj = applyPropertyPairs(obj, args)
  if isempty(args)
    return
  end
  if mod(length(args), 2) ~= 0
    error('Nelson:control_system:nameValuePair', '%s expected.', 'Name-value arguments');
  end
  for k = 1:2:length(args)
    name = resolvePropertyName(args{k}, ltiPropertyNames('tf'));
    obj.(name) = args{k + 1};
  end
end
function tf = isVariableName(value)
  tf = false;
  if isTextScalar(value)
    value = char(value);
    tf = any(strcmp(value, {'s', 'p', 'z', 'q'}));
  end
end
%=============================================================================
function tf = isTextScalar(value)
  tf = ischar(value) || isStringScalar(value);
end
function name = resolvePropertyName(value, supported)
  value = ltiValidateTextScalar('Name', value);
  matches = startsWith(upper(supported), upper(value));
  if sum(matches) == 0
    error('Nelson:control_system:unknownParameter', '"%s" is not a recognized parameter.', value);
  end
  if sum(matches) > 1
    error('Nelson:control_system:ambiguousParameter', '"%s" matches multiple parameters.', value);
  end
  name = supported{find(matches, 1)};
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function sys = uminus(sys)
  numerators = sys.Numerator;
  for k = 1:length(numerators)'
    sys.Numerator{k} = -numerators{k};
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function sysOut = vertcat(varargin)
  % [A; B]
  sys = tf(varargin{1});
  for k = 2:1:nargin
    sysA = sys;
    sysB = tf(varargin{k});

    sys = tf();

    [pA, mA] = size(sysA.Numerator);
    [pB, mB] = size(sysB.Numerator);

    if (mA ~= mB)
      error('Nelson:control_system:systemsInputIncompatible', 'dimensions of systems input is incompatible.')
    end

    sys.Numerator = [sysA.Numerator; sysB.Numerator];
    sys.Denominator = [sysA.Denominator; sysB.Denominator];

    sys.Ts = ltiResolveSampleTime(sysA, sysB);
    sys.Variable = ltiMergeTfVariable(sysA, sysB, 'left');
    sys.TimeUnit = ltiMergeTimeUnit(sysA, sysB);
    sys.InputName = ltiMergeCellMetadata(sysA.InputName, mA, sysB.InputName, mB, 'match');
    sys.InputUnit = ltiMergeCellMetadata(sysA.InputUnit, mA, sysB.InputUnit, mB, 'match');
    sys.OutputName = ltiMergeCellMetadata(sysA.OutputName, pA, sysB.OutputName, pB, 'concat');
    sys.OutputUnit = ltiMergeCellMetadata(sysA.OutputUnit, pA, sysB.OutputUnit, pB, 'concat');
    userData = ltiMergeUserData(sysA, sysB);
    if ~isempty(userData)
      sys.UserData = userData;
    end
  end
  sysOut = sys;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = abcdchk(varargin)
  narginchk(0, 5);
  nargoutchk(0, 6);

  if nargin < 5, E = []; else E = varargin{5}; end
  if nargin < 4, D = []; else D = varargin{4}; end
  if nargin < 3, C = []; else C = varargin{3}; end
  if nargin < 2, B = []; else B = varargin{2}; end
  if nargin < 1, A = []; else A = varargin{1}; end

  [ME, NE] = size(E);
  E_MODIFIED = E;
  [MD, ND] = size(D);
  D_MODIFIED = D;
  [MC, NC] = size(C);
  C_MODIFIED = C;
  [MB, NB] = size(B);
  B_MODIFIED = B;
  [MA, NA] = size(A);
  A_MODIFIED = A;
  if (MC == 0) && (NC == 0) && (MD == 0 || NA == 0)
    MC = MD;
    NC = NA;
    C_MODIFIED = zeros(MC, NC, 'like', C);
  end
  if (MB == 0) && (NB == 0) && (MA == 0 || ND == 0)
    MB = MA;
    NB = ND;
    B_MODIFIED = zeros(MB, NB, 'like', B);
  end
  if (MD == 0) && (ND == 0) && (MC == 0 || NB == 0)
    MD = MC;
    ND = NB;
    D_MODIFIED = zeros(MD, ND, 'like', D);
  end
  if (MA == 0) && (NA == 0) && (MB == 0 || NC == 0)
    MA = MB;
    NA = NC;
    A_MODIFIED = zeros(MA, NA, 'like', A);
  end

  msg.message = '';
  msg.identifier = '';
  msg = msg(zeros(0, 1));
  if (MA ~= NA) && (nargin >= 1)
    msg = checkABCDE(A, B, C, D, E);
  elseif (MA ~= MB) && (nargin >= 2)
    msg = checkABCDE(A, B, C, D, E);
  elseif (NA ~= NC) && (nargin >= 3)
    msg = checkABCDE(A, B, C, D, E);
  elseif (MD ~= MC) && (nargin >= 4)
    msg = checkABCDE(A, B, C, D, E);
  elseif (ND ~= NB) && (nargin >= 4)
    msg = checkABCDE(A, B, C, D, E);
  end

  if (nargin > 4)
    if (~((MA == ME) && (NA == NE)) && isempty(E))
      msg.message = sprintf(_('Matrices %s and %s should have an identical size.'), 'A', 'E');
      msg.identifier = 'Nelson:control_system:AAndESizeMismatch';
    end
  else
    ME = MA;
    NE = NA;
    E_MODIFIED = zeros(MA, NA, 'like', A);
  end

  varargout{1} = msg;
  if nargout > 1
    varargout{2} = A_MODIFIED;
  end
  if nargout > 2
    varargout{3} = B_MODIFIED;
  end
  if nargout > 3
    varargout{4} = C_MODIFIED;
  end
  if nargout > 4
    varargout{5} = D_MODIFIED;
  end
  if nargout > 5
    varargout{6} = E_MODIFIED;
  end

end
%=============================================================================
%=============================================================================
% Copyright (c) 2017 October Daniel Mårtensson (Swedish Embedded Control Systems Toolbox)
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = acker(varargin)
  % K = acker(A, B, P)
  % Source from Modern Control Engineering, Ogata, 3th edition.
  narginchk(3, 3)
  nargoutchk(0, 1)

  A = varargin{1};
  B = varargin{2};
  P = varargin{3};

  [mA, nA] = size(A);
  [mB, nB] = size(B);
  if (mA ~= nA)
    error('Nelson:expectedSquare', '%s must be square.', 'Matrix A');
  end

  if (mB ~= mA)
    error('Nelson:control_system:AAndBNumRowsMismatch', 'The number of rows in matrices %s and %s must be equal.', 'A', 'B');
  end
  if nB ~= 1
    error('Nelson:control_system:invalidType', '%s expected.', 'SISO LTI model');
  end

  % Vectorize P
  P = P(:);
  if (size(A, 1) ~= length(P))
    error('Nelson:control_system:dimagree:polesNeedDimensionMatrixA', 'Poles need to have the same dimension as matrix A')
  end

  % Create the control law gain matrix L
  %Formula from Ogata Modern Control Engineering
  Cm = ctrb(A, B); % Controllability matrix
  RealPoly = real(poly(P)); % Real polynomial of P
  L = Cm \ polyvalm(RealPoly, A);
  L = L(nA, :);

  % Check if the user has put in very bad pole locations
  P = sort(P);
  nonZeroPoles = find(P ~= 0);
  P = P(nonZeroPoles);
  % Sort the eigen values
  eigenvalues = sort(eig(A - B * L));
  % Ge the egenvalues which has non zero poles
  eigenvalues = eigenvalues(nonZeroPoles);
  % Get the absolute maximum value of P
  M = abs(P);

  % Get the difference between pole locations and eigen values
  Diff = abs(P - eigenvalues);
  if (max(Diff ./ M) > .1)
    warning('Nelson:acker:poleLocationError', 'Pole locations are in more that 10% error');
  end
  varargout{1} = L;
end
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function X = are(A, B, C)
  arguments
    A {mustBeNumeric}
    B {mustBeNumeric}
    C {mustBeNumeric}
  end
  % Algebraic Riccati equation.
  % X = are(A, B, C)

  nargoutchk(0, 1);

  [rA, cA] = size(A);
  if rA ~= cA
    error('Nelson:control_system:wrongSize', 'Wrong size for argument #%d: %s expected.', 1, 'square matrix');
  end
  if ~isequal(size(B), size(A))
    error('Nelson:control_system:wrongSize:wrongSizeArgumentNSizeArgument', 'Wrong size for argument #%d: same size as argument #%d expected.', 2, 1);
  end
  if ~isequal(size(C), size(A))
    error('Nelson:control_system:wrongSize:wrongSizeArgumentNSizeArgument', 'Wrong size for argument #%d: same size as argument #%d expected.', 3, 1);
  end
  if ~ishermitian(B)
    error('Nelson:control_system:wrongValue', 'Wrong value for argument #%d: %s expected.', 2, 'symmetric matrix');
  end
  if ~ishermitian(C)
    error('Nelson:control_system:wrongValue', 'Wrong value for argument #%d: %s expected.', 3, 'symmetric matrix');
  end

  G = localSymmetricSquareRoot(B);
  X = care(A, G, C);
end
%=============================================================================
function G = localSymmetricSquareRoot(B)
  B = (B + B') / 2;
  [V, D] = eig(B);
  values = real(diag(D));
  tolerance = 100 * eps() * max(1, max(abs(values)));
  if any(values < -tolerance)
    error('Nelson:control_system:wrongValue', 'Wrong value for argument #%d: %s expected.', 2, 'nonnegative matrix');
  end
  values(values < 0) = 0;
  G = V * diag(sqrt(values));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = augstate(varargin)
  narginchk(4, 4);
  nargoutchk(0, 4);

  A = varargin{1};
  B = varargin{2};
  C = varargin{3};
  D = varargin{4};

  msg = abcdchk(A, B);
  if ~isempty(msg)
    error(msg.id, msg.message);
  end

  rA = size(A, 1);
  cB = size(B, 2);

  varargout{1} = A;
  if nargout > 1
    varargout{2} = B;
  end
  if nargout > 2
    varargout{3} = [C; eye(rA)];
  end
  if nargout > 2
    varargout{4} = [D; zeros(rA, cB)];
  end
end
%=============================================================================
% Copyright (c) 2017 October Daniel Mårtensson (Swedish Embedded Control Systems Toolbox)
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = balreal(varargin)
  narginchk(3, 3);
  nargoutchk(0, 6);

  A = varargin{1};
  B = varargin{2};
  C = varargin{3};
  rD = size(C, 1);
  cD = size(D, 2);
  D = zeros(rD, cD);
  sysIn = ss(A, B, C, D);

  [sysOut, g, Ti, T] = balreal(sysIn);
  [abal, bbal, cbal] = ssdata(sysOut);

  varargout{1} = abal;
  if nargout > 1
    varargout{2} = bbal;
  end
  if nargout > 2
    varargout{3} = cbal;
  end
  if nargout > 3
    varargout{4} = g;
  end
  if nargout > 4
    varargout{5} = T;
  end
  if nargout > 5
    varargout{6} = Ti;
  end
end
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = bdschur(varargin)
  % Block-diagonal Schur factorization
  % [T, B] = bdschur(A)
  % [T, B] = bdschur(A, CONDMAX)

  narginchk(1, 2);
  nargoutchk(0, 2);

  A = varargin{1};
  mustBeReal(A, 1);
  mustBeFinite(A, 1);

  if nargin > 1
    CONDMAX = varargout{2};
  else
    CONDMAX = 1e4;
  end
  mustBeReal(CONDMAX, 2);
  mustBeScalarOrEmpty(CONDMAX, 2);

  if isempty(A)
    T = A;
    B = A;
    varargout{1} = T;
    if nargout > 1
      varargout{2} = B;
    end
    return;
  end

  [rA, cA] = size(A);
  if (rA ~= cA)
    error('Nelson:control_system:wrongSize', 'Wrong size for argument #%d: %s expected.', 1, 'square matrix');
  end

  JOBX = 'U';
  SORT = 'S';
  PMAX = CONDMAX;
  [U, ~] = schur(A);
  TOL = 0; % default lapack tolerance
  [A_OUT, X_OUT, NBLCKS, BLSIZE, WR, WI, INFO] = slicot_mb03rd(JOBX, SORT, CONDMAX, A, U, TOL);

  if (INFO(1) ~= 0)
    error('Nelson:control_system:slicotMb03rdError', 'slicot_mb03rd returned info = %d', INFO(1));
  end

  T = X_OUT;
  B = A_OUT;
  varargout{1} = T;
  if nargout > 1
    varargout{2} = B;
  end
end
%=============================================================================
% Copyright (c) 2017 October Daniel Mårtensson (Swedish Embedded Control Systems Toolbox)
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = bode(varargin)
  % Plot the bode diagram of a state space model or a
  % transfer function
  % currently only one SISO system is allowed

  % bode()
  % bode(H)
  % bode(H, w)
  % bode(H, w, lineSpec)
  % [magnitude, phase, w] = bode(H)
  % [magnitude, phase, w] = bode(H, wIn)

  narginchk(0, 3);
  nargoutchk(0, 3);

  w = [];
  lineSpec = '';
  switch nargin
    case 0
      if (nargout != 0)
        error('Nelson:control_system:invalidOutputArgument', 'bode without input argument does not return output arguments.');
      end
      numerator = -1;
      denominator = [1 12 58 139 174 102 19];
      TF = tf(numerator, denominator);
      display(TF);
      disp(_('Call bode using the following command:'))
      disp('bode(tf(num, den));')
      disp(' ')
      bode(TF);
      return
    case 1
      sys = varargin{1};
    case 2
      sys = varargin{1};
      if ischar(varargin{2})
        lineSpec = varargin{2};
      else
        w = varargin{2};
      end
    case 3
      sys = varargin{1};
      if ischar(varargin{2})
        lineSpec = varargin{2};
      else
        w = varargin{2};
      end
      if ischar(varargin{3})
        lineSpec = varargin{3};
      else
        w = varargin{3};
      end
    otherwise
      error('Nelson:control_system:wrongNumberOfArguments', 'Wrong number of input arguments.');
  end

  if isempty(lineSpec)
    lineSpec = '-';
  end
  [res, lineSpec] = checkLineSpec(lineSpec);
  if ~res
    error('Nelson:control_system:invalidLineSpec', 'invalid line specification.');
  end

  if ~islti(sys)
    error('Nelson:control_system:invalidType', '%s expected.', 'LTI model');
  end
  if ~issiso(sys)
    error('Nelson:control_system:invalidType', '%s expected.', 'SISO LTI model');
  end

  L = 1000; % Number of frequency elements
  if isempty(w)
    w = [0.01 100];
    w = log10(w);
    w = logspace(w(1), w(2), L);
  else
    w = checkW(w, L);
  end

  phase = {};
  magnitude = {};

  a = sys.Numerator;
  b = sys.Denominator;
  a = a{1};
  b = b{1};
  H = zeros(1, length(w));
  h = sys.Ts;
  delay = 0;
  N = length(b);

  H = [];
  if (sys.Ts > 0)
    for k = 1:L
      cc = fliplr((exp(1i * w(k) * h)) .^ (0:N - 1)).';
      X = (a * cc);
      Y = (b * cc);
      Z = exp(-delay * exp(1i * w(k) * h));
      H(k) = X / Y * Z;
    end
  else
    for k = 1:L
      cc = fliplr((1i * w(k)) .^ (0:N - 1)).';
      X = (a * cc);
      Y = (b * cc);
      Z = exp(-delay * 1i * w(k));
      H(k) = X / Y * Z;

    end
  end
  phase = unwrapPhase(angle(H)) * 180 / pi;
  magnitude = 20 * log10(abs(H));

  if (nargout == 0)
    f = figure('Visible', 'off');
    magnitudeAxes = subplot(2, 1, 1);
    title(_('Bode Diagram'));
    semilogx(w, magnitude, lineSpec);
    ylabel(_('Magnitude [dB]'));
    phaseAxes = subplot(2, 1, 2);

    semilogx(w, phase, lineSpec);
    phaseAxes.YLim = phasePlotLimits(phase);
    phaseAxes.YTick = phasePlotTicks(phaseAxes.YLim);
    ylabel(_('Phase [deg]'));
    xlabel(_('Frequency [rad/s]'));
    setBodeAxesLayout(magnitudeAxes, phaseAxes);
    f.Visible = 'on';
  end

  if (nargout > 0)
    varargout{1} = reshape(magnitude, 1, 1, []);
  end
  if (nargout > 1)
    varargout{2} = reshape(phase, 1, 1, []);
  end
  if (nargout > 2)
    varargout{3} = w;
  end

end
%=============================================================================
function w = checkW(w_maybe, N)
  if (iscell(w_maybe) && (length(w_maybe) == 2))
    w_min = log10(w_maybe{1});
    w_max = log10(w_maybe{2});
    if (w_min > w_max)
      error('Nelson:control_system:invalidFrequencyInterval', '%s frequency interval must be specified as {wmin, wmax} real.', '')
    end
    w = logspace(w_min, w_max, N);
  elseif (isnumeric(w_maybe) && isvector(w_maybe))
    if ~isreal(w_maybe)
      error('Nelson:control_system:invalidType', '%s expected.', 'real');
    else
      w = sort(w_maybe);
    end
  else
    error('Nelson:control_system:invalidFrequencyInterval', '%s frequency interval must be specified as {wmin, wmax} real.', '')
  end
end
%=============================================================================
function [res, lineSpec] = checkLineSpec(var)
  res = false;
  lineSpec = [];
  if ischar(var)
    if ismodule('graphics')
      [l, c, m, msg] = colstyle(var);
      if isempty(msg)
        res = true;
        lineSpec = var;
      end
    else
      res = true;
      lineSpec = var;
    end
  end
end
%=============================================================================
function w = computesW(sys, N)
  numerator = sys.Numerator{1};
  denominator = sys.Denominator{1};
  zp = [roots(numerator(:)); roots(denominator(:))];

  if ~isdt(sys)
    zp = zp(find(abs(zp) > norm(zp) * eps));
    w_min = min(abs(zp));
    w_min = floor(log10(w_min));
    w_max = max(abs(zp));
    w_max = ceil(log10(w_max));
  else
    zp = zp(find(abs(zp - 1.0) > norm(zp) * eps & abs(zp) > norm(zp) * eps));
    zp = min(abs(log(zp) / (2 * pi * sys.Ts)));
    w_min = floor(log10(zp));
    w_max = log10(1 / (2 * sys.Ts));
  end

  if (abs(denominator(end)) >= norm(denominator) * eps)
    w_min = w_min - 2;
    if isct(sys)
      w_max = w_max + 1;
    end
  else
    w_min = w_min - 1;
    if isct(sys)
      w_max = w_max + 1;
    end
  end
  w = logspace(w_min, w_max, N)';
end
%=============================================================================
function u = unwrapPhase(p)
  if length(p) > 1
    twopi = 2 * pi;
    p(2:end) = p(2:end) - cumsum(twopi * round(diff(p) / twopi));
  end
  u = p;
end
%=============================================================================
function lim = phasePlotLimits(phase)
  step = 45;
  lower = step * floor(min(phase) / step);
  upper = step * ceil(max(phase) / step);
  if lower == upper
    lower = lower - step;
    upper = upper + step;
  end
  lim = [lower upper];
end
%=============================================================================
function ticks = phasePlotTicks(lim)
  step = 45;
  ticks = lim(1):step:lim(2);
end
%=============================================================================
function setBodeAxesLayout(magnitudeAxes, phaseAxes)
  magnitudeAxes.Position = [0.13 0.56 0.775 0.34];
  phaseAxes.Position = [0.13 0.12 0.775 0.34];
end
%=============================================================================
%=============================================================================
% Copyright (c) 2017 September Daniel Mårtensson (Swedish Embedded Control Systems Toolbox)
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = c2d(varargin)
  narginchk(3, 3);
  nargoutchk(0, 2);

  A = varargin{1};
  B = varargin{2};
  T = varargin{3};

  mustBeNumeric(A, 1);
  mustBeNumeric(B, 2);
  mustBeNumeric(T, 3);

  msg = abcdchk(A, B);
  if ~isempty(msg)
    error(msg.id, msg.message);
  end
  [mA, nA] = size(A);
  [mB, nB] = size(B);
  S = expm([[A, B] * T; zeros(nB, mB + nB)]);
  varargout{1} = S(1:nA, 1:nA);
  if nargout > 1
    varargout{2} = S(1:nA, nA + 1:nA + nB);
  end
end
%=============================================================================
% Copyright (c) 2017 October Daniel Mårtensson (Swedish Embedded Control Systems Toolbox)
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = care(varargin)
  % Solves the Continuous-time Algebraic Riccati Equation
  % [X, L, G] = care(A, B, Q)
  % [X, L, G] = care(A, B, Q, R)
  % [X, L, G] = care(A, B, Q, R, S, E)

  narginchk(3, 6);
  nargoutchk(0, 3);

  A = varargin{1};
  B = varargin{2};
  Q = varargin{3};
  mustBeNumeric(A, 1);
  mustBeNumeric(B, 2);
  mustBeNumeric(Q, 3);

  [m, n] = size(B);

  R = [];
  S = [];
  E = [];

  if nargin > 3
    R = varargin{4};
    mustBeNumeric(R, 4);
    if ~issymmetric(R, 0)
      error('Nelson:control_system:wrongValue', 'Wrong value for argument #%d: %s expected.', 4, 'symmetric matrix');
    end
  else
    R = eye(n, n);
  end
  if nargin > 4
    S = varargin{5};
  else
    S = zeros(m, n);
  end
  if nargin > 5
    E = varargin{6};
  else
    E = eye(m, m);
  end
  mustBeNumeric(S, 5);
  mustBeNumeric(E, 6);

  [rA, cA] = size(A);
  if (rA ~= m) || (cA ~= m)
    error('Nelson:control_system:wrongSize', 'Wrong size for argument #%d: %s expected.', 1, 'square matrix');
  end

  if ((size(Q, 1) ~= size(Q, 2)) || (size(R, 1) ~= size(R, 2)))
    error('Nelson:control_system:wrongSize:wrongSizeArgumentsQRSquare', 'Wrong size for arguments: Q, R square matrix expected.');
  end

  if (size(A, 1) ~= m)
    error('Nelson:control_system:wrongSize:wrongSizeArgumentsNNNumberX', 'Wrong size for arguments #%d and #%d: Same number of rows expected.', 1, 2);
  end

  if (size(R, 2) ~= n)
    error('Nelson:control_system:wrongSize:wrongSizeArgumentsNNNumber', 'Wrong size for arguments #%d and #%d: Same number of columns expected.', 2, 4);
  end

  if ~isempty(S) && ((size(S, 1) ~= m) || (size(S, 2) ~= n))
    error('Nelson:control_system:wrongSize:wrongSizeArgumentsNNSize', 'Wrong size for arguments #%d and #%d: Same size expected.', 2, 5);
  end

  if ~isempty(E) && ((size(E, 1) ~= size(A, 1)) || (size(E, 2) ~= size(A, 2)))
    error('Nelson:control_system:wrongSize:wrongSizeArgumentsNNNumberX', 'Wrong size for arguments #%d and #%d: Same number of rows expected.', 1, 6);
  end

  if (size(A, 1) ~= size(Q, 1)) && (size(A, 2) ~= size(Q, 2))
    error('Nelson:control_system:wrongSize:wrongSizeArgumentsNNSize', 'Wrong size for arguments #%d and #%d: Same size expected.', 1, 3);
  end

  mustBeFinite(A, 1);
  mustBeFinite(B, 2);
  mustBeFinite(Q, 3);
  mustBeFinite(R, 4);

  X = [];
  L = [];
  G = [];

  DICO = 'C';
  JOBB = 'B';
  FACT = 'N';
  UPLO = 'U';
  SORT = 'S';
  P = 0;
  TOL = 0;

  JOBL = 'N';
  SorB = S;
  if isempty(S)
    JOBL = 'Z';
    SorB = B;
  end

  if isempty(E)
    [RCOND, X, ALFAR, ALFAI, BETA, S_OUT, T, U, INFO] = slicot_sb02od(DICO, JOBB, FACT, UPLO, JOBL, SORT, P, A, B, Q, R, SorB, TOL);
    if (INFO(1) ~= 0)
      error('Nelson:control_system:riccatiSolveFailure', 'Unable to solve the specified Riccati equation.');
    end
  else
    SCAL = 'N';
    ACC = 'N';
    [RCONDU, X, ALFAR, ALFAI, BETA, S_OUT, T, U, IWARN, INFO] = slicot_sg02ad(DICO, JOBB, FACT, UPLO, JOBL, SCAL, SORT, ACC, P, A, E, B, Q, R, SorB, TOL);
    if (INFO(1) ~= 0)
      error('Nelson:control_system:riccatiSolveFailure', 'Unable to solve the specified Riccati equation.');
    end
    if (IWARN(1) == 1)
      warning('Nelson:control_system:accuracyCompromised', 'The accuracy of the solution could be compromised by inadequate scaling or eigenvalues that are in close proximity to the stability domain''s boundary.');
    end
  end
  N = size(A, 1);
  ALFAR = ALFAR([1:N]);
  ALFAI = ALFAI([1:N]);
  BETA = BETA([1:N]);
  L = ((ALFAR + ALFAI * i) ./ BETA).';
  L = sort(L);
  if isempty(S)
    G = R \ ((B)' * X);
  else
    G = R \ ((B)' * X + (S)');
  end
  varargout{1} = X;
  if nargout > 1
    varargout{2} = L;
  end
  if nargout > 2
    varargout{3} = G;
  end
end
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
%#ok<NLS0026>
function model = cloop(varargin)
  narginchk(1, 3);
  nargoutchk(0, 1);

  sys = varargin{1};

  if nargin == 1
    sgn = -1;
  elseif nargin == 2
    sgn = sign(varargin{2});
  else
    inputs = varargin{2};
    outputs = varargin{3};
    sgn = sign(varargin{3});
  end
  if ~islti(sys)
    error('Nelson:control_system:invalidType', '%s expected.', 'LTI model');
  end

  if isa(sys, 'ss')
    a = sys.A;
    b = sys.B;
    c = sys.C;
    d = sys.D;
    outputCount = size(d, 1);
    inputCount = size(d, 2);
    if (nargin == 1)
      outputs = 1:outputCount;
      inputs = 1:inputCount;
      sgn = -ones(1, length(inputs));
    end
    if (nargin == 2)
      outputs = 1:outputCount;
      inputs = 1:inputCount;
      sgn = sgn * ones(1, length(inputs));
    end

    feedbackInputCount = length(inputs);
    feedbackOutputCount = length(outputs);
    if feedbackInputCount ~= feedbackOutputCount
      error('Nelson:control_system:dimagree:numberFeedbackInputsOutputsAreNot', 'The number of feedback inputs and outputs are not equal.');
    end
    stateCount = size(a, 1);

    S = [a, b; c, d];
    Bu = S(:, stateCount + inputs);
    Cy = S(stateCount + outputs, :);
    if ~isempty(Cy)
      Cy(sgn == -1, :) = -Cy(sgn == -1, :);
      E = eye(feedbackOutputCount) - Cy(:, stateCount + inputs);
      Cy = E \ Cy;
      Sc = S + Bu * Cy;

      ac = Sc(1:stateCount, 1:stateCount);
      bc = Sc(1:stateCount, stateCount + 1:stateCount + inputCount);
      cc = Sc(stateCount + 1:stateCount + outputCount, 1:stateCount);
      dc = Sc(stateCount + 1:stateCount + outputCount, stateCount + 1:stateCount + inputCount);
      model = ss(ac, bc, cc, dc, sys.Ts);
    else
      model = sys;
    end
  else % isa(sys, 'tf')
    numerator = sys.Numerator{1};
    denominator = sys.Denominator{1} - sgn * sys.Numerator{1};
    model = tf(numerator, denominator, sys.Ts);
    model.Variable = sys.Variable;
  end
end
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = compreal(varargin)
  narginchk(2, 2);
  nargoutchk(0, 5);
  numerator = varargin{1};
  denominator = varargin{2};
  numeratorShape = size(numerator);
  outputCount = numeratorShape(1);
  coefficientCount = numeratorShape(2);

  if coefficientCount == 1 || norm(numerator, 1) == 0
    realization = pureGainRealization(numerator, denominator, outputCount);
  else
    realization = companionRealization(numerator, denominator, coefficientCount, outputCount);
  end
  realization = scaledRealization(realization);

  varargout{1} = realization.A;
  if nargout > 1
    varargout{2} = realization.B;
  end
  if nargout > 2
    varargout{3} = realization.C;
  end
  if nargout > 3
    varargout{4} = realization.D;
  end
  if nargout > 4
    varargout{5} = realization.E;
  end
end
%=============================================================================
function realization = pureGainRealization(numerator, denominator, outputCount)
  realization.A = [];
  realization.B = zeros(0, 1);
  realization.C = zeros(outputCount, 0);
  realization.D = numerator(:, 1) / denominator(:, 1);
  realization.E = [];
  realization.kE = 0;
end
%=============================================================================
function realization = companionRealization(numerator, denominator, coefficientCount, outputCount)
  leadingIndex = find(denominator ~= 0, 1);
  leadingCoefficient = denominator(leadingIndex);
  scaledNumerator = numerator / leadingCoefficient;
  scaledDenominator = denominator(leadingIndex + 1:coefficientCount) / leadingCoefficient;

  if leadingIndex == 1
    realization = properCompanion(scaledNumerator, scaledDenominator, coefficientCount);
  else
    realization = improperCompanion(scaledNumerator, scaledDenominator, leadingIndex, outputCount);
  end
end
%=============================================================================
function realization = properCompanion(numerator, denominator, coefficientCount)
  denominatorLength = length(denominator);
  realization.A = [-denominator; eye(denominatorLength - 1, denominatorLength)];
  realization.B = eye(denominatorLength, 1);
  realization.D = numerator(:, 1);
  realization.C = numerator(:, 2:coefficientCount) - realization.D * denominator;
  realization.E = [];
  realization.kE = 0;
end
%=============================================================================
function realization = improperCompanion(numerator, denominator, leadingIndex, outputCount)
  denominatorLength = length(denominator);
  shiftRows = min(1, denominatorLength);
  realization.A = blkdiag(eye(leadingIndex), diag(ones(shiftRows, denominatorLength - 1), -1));
  realization.A(leadingIndex + shiftRows, leadingIndex + 1:leadingIndex + denominatorLength) ...
    = -denominator;
  realization.B = zeros(leadingIndex + denominatorLength, 1);
  if denominatorLength <= 0
    realization.B(leadingIndex) = -1;
  else
    realization.B(leadingIndex + 1) = 1;
  end
  realization.C = numerator;
  realization.D = zeros(outputCount, 1);
  realization.E = diag([zeros(leadingIndex, 1); ones(denominatorLength, 1)]);
  stride = leadingIndex + denominatorLength + 1;
  realization.E(stride:stride:(leadingIndex - 1 + shiftRows) * stride) = 1;
  realization.kE = leadingIndex;
end
%=============================================================================
function realization = scaledRealization(realization)
  stateCount = size(realization.A, 1);
  descriptorCount = realization.kE;

  scaleRatios = stateScaleRatios(realization.A, descriptorCount, stateCount);
  if descriptorCount > 0
    descriptorScales = descriptorScaleRatios(realization.C, descriptorCount, stateCount);
    descriptorCount = descriptorScales.descriptorCount;
    scaleRatios = [descriptorScales.ratios; scaleRatios];
  end

  realization = applyStateScaling(realization, scaleRatios);
  realization = normalizeInputOutputGain(realization);
end
%=============================================================================
function realization = applyStateScaling(realization, ratios)
  stateScales = cumprod([1; ratios]);
  inverseScales = 1 ./ stateScales;
  realization.A = scaleMatrix(realization.A, stateScales, inverseScales);
  realization.B = scaleMatrix(realization.B, stateScales, []);
  realization.C = scaleMatrix(realization.C, [], inverseScales);
  if ~isempty(realization.E)
    realization.E = scaleMatrix(realization.E, stateScales, inverseScales);
  end
end
%=============================================================================
function realization = normalizeInputOutputGain(realization)
  outputMagnitude = norm(realization.C, 1);
  inputMagnitude = norm(realization.B, 1);
  if outputMagnitude > 0
    gainScale = pow2(round(log2(outputMagnitude / inputMagnitude) / 2));
    realization.C = realization.C / gainScale;
    realization.B = realization.B * gainScale;
  end
end
%=============================================================================
function ratios = stateScaleRatios(A, descriptorCount, stateCount)
  if stateCount - descriptorCount < 2
    ratios = zeros(0, 1);
  else
    %#ok<NLS0004>
    [~, ~, balanceMatrix] = balance(A(descriptorCount + 1:stateCount, ...
      descriptorCount + 1:stateCount), 'noperm');
    ratios = diag(balanceMatrix, -1);
  end

  smallDrop = find(ratios(2:end) < min(1, 1e-3 * ratios(1:end - 1)));
  if ~isempty(smallDrop)
    floorValue = min(1, ratios(smallDrop(1)));
    ratios = max(ratios, floorValue);
  end
end
%=============================================================================
function result = descriptorScaleRatios(C, initialDescriptorCount, stateCount)
  descriptorCount = initialDescriptorCount;
  if descriptorCount < stateCount
    descriptorCount = descriptorCount + 1;
  end
  columnNorms = max(abs(C(:, 1:descriptorCount)), [], 1);
  columnNorms = columnNorms / columnNorms(1);
  %#ok<NLS0004>
  [~, ~, balanceMatrix] = balance([columnNorms; eye(descriptorCount - 1, descriptorCount)], ...
    'noperm');
  result.ratios = diag(balanceMatrix, -1);
  result.descriptorCount = descriptorCount;
end
%=============================================================================
function scaled = scaleMatrix(X, requestedRowScales, requestedColumnScales)
  rowScales = completeRowScales(X, requestedRowScales);
  columnScales = completeColumnScales(X, requestedColumnScales);
  scaled = X .* (rowScales * columnScales);
end
%=============================================================================
function rowScales = completeRowScales(X, rowScales)
  if size(rowScales, 2) == 0
    rowCount = size(X, 1);
    if rowCount > 0
      rowScales = ones(rowCount, 1);
    else
      rowScales = [];
    end
  elseif size(rowScales, 2) > 1
    rowScales = rowScales.';
  end
end
%=============================================================================
function columnScales = completeColumnScales(X, columnScales)
  if size(columnScales, 1) == 0
    columnCount = size(X, 2);
    if columnCount > 0
      columnScales = ones(1, columnCount);
    else
      columnScales = [];
    end
  elseif size(columnScales, 1) > 1
    columnScales = columnScales.';
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2017 October Daniel Mårtensson (Swedish Embedded Control Systems Toolbox)
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = ctrb(varargin)
  % Generates the controllability matrix of a state space model
  % Co = ctrb(A,B)
  % Co = ctrb(sys)
  narginchk(1, 2);
  nargoutchk(0, 1);

  if nargin == 1
    sys = varargin{1};
    sys = ss(sys);
    A = sys.A;
    B = sys.B;
  else
    A = varargin{1};
    B = varargin{2};
    [mA, nA] = size(A);
    [mB, nB] = size(B);
    if (mA ~= nA)
      error('Nelson:expectedSquare', '%s must be square.', 'Matrix A');
    end

    if (mB ~= mA)
      error('Nelson:control_system:AAndBNumRowsMismatch', 'The number of rows in matrices %s and %s must be equal.', 'A', 'B');
    end
  end

  n = size(A, 1); % We only check the dimension of A
  % Compute the controllability matrix now!
  Cs = [];
  for i = 0:(n - 1)
    Cs = [Cs, A ^ i * B];
  end
  varargout{1} = Cs;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = ctrbf(varargin)
  % Compute controllability staircase form
  % [Abar, Bbar, Cbar, T, k] = ctrbf(A, B, C)
  % [Abar, Bbar, Cbar, T, k] = ctrbf(A, B, C, tol)

  % Check input and output arguments
  narginchk(3, 4);
  nargoutchk(0, 5);

  % Extract input matrices
  A = varargin{1};
  B = varargin{2};
  C = varargin{3};

  % Set tolerance based on input or default
  if nargin == 3
    tol = size(A, 1) * norm(A, 1) * eps;
  else
    tol = varargin{4};
  end

  % Initialize variables
  P_t_minus_1 = eye(size(A, 1));
  A_current = A;
  B_current = B;
  ro_j_minus_1 = size(B, 2);
  delta_j_minus_1 = 0;
  sigma_j_minus_1 = size(A, 1);
  k_values = zeros(1, size(A, 1));

  % Main loop for controllability staircase form
  for j = 1:size(A, 1)
    % Singular value decomposition of B_current
    [U_j, S_j, ~] = svd(B_current);
    [row_S_j, ~] = size(S_j);

    % Rotate the singular vectors
    rotation_matrix = rot90(eye(row_S_j), 1);
    U_j = U_j * rotation_matrix;

    % Update B_current using the rotated singular vectors
    B_current = U_j' * B_current;

    % Compute the rank of B_current
    ro_j = rank(B_current, tol);
    [row_B_current, ~] = size(B_current);

    % Update variables
    sigma_j = row_B_current - ro_j;
    sigma_j_minus_1 = sigma_j;
    k_values(j) = ro_j;

    % Check termination conditions
    if (ro_j == 0 || sigma_j == 0)
      break;
    end

    % Update A_current and B_current based on rotated singular vectors
    A_and_B_rotated = U_j' * A_current * U_j;
    A_current = A_and_B_rotated(1:sigma_j, 1:sigma_j);
    B_current = A_and_B_rotated(1:sigma_j, sigma_j + 1:sigma_j + ro_j);

    % Update P_t_minus_1 matrix
    [row_U_j, col_U_j] = size(U_j);
    P_t = P_t_minus_1 * [U_j zeros(row_U_j, delta_j_minus_1); zeros(delta_j_minus_1, col_U_j) eye(delta_j_minus_1)];
    P_t_minus_1 = P_t;

    % Update delta_j_minus_1
    delta_j = delta_j_minus_1 + ro_j;
    delta_j_minus_1 = delta_j;
  end

  % Compute the controllability transformation matrix T
  T = P_t_minus_1';

  % Transform the system matrices to controllability form
  A_bar = T * A * T';
  B_bar = T * B;
  C_bar = C * T';

  % Output results
  varargout{1} = A_bar;
  varargout{2} = B_bar;
  varargout{3} = C_bar;
  varargout{4} = T;
  varargout{5} = k_values;
end
%=============================================================================
% Copyright (c) 2017 September Daniel Mårtensson (Swedish Embedded Control Systems Toolbox)
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = d2c(varargin)
  % [a, b] = d2c(phi, gamma, t)

  narginchk(3, 3);
  nargoutchk(0, 2);

  phi = varargin{1};
  gamma = varargin{2};
  T = varargin{3};

  [msg, phi, gamma] = abcdchk(phi, gamma); %#ok<NLS0004>
  if ~isempty(msg)
    error('Nelson:control_system:invalidStateSpace', msg);
  end

  rowCount = size(phi, 1);
  columnCount = size(phi, 2);
  inputCount = size(gamma, 2);

  if rowCount == 1 && phi == 1
    a = 0;
    b = gamma / T;
    return
  end

  b = zeros(rowCount, inputCount);
  nonzero = find(any(gamma ~= 0, 1));
  nonzeroCount = length(nonzero);

  augmentedMatrix = [[phi, gamma(:, nonzero)]; zeros(nonzeroCount, columnCount), eye(nonzeroCount)];
  [logMatrix, ~] = logm(augmentedMatrix); %#ok<NLS0004>
  logMatrix = real(logMatrix / T);
  a = logMatrix(1:columnCount, 1:columnCount);
  if length(b)
    b(:, nonzero) = logMatrix(1:columnCount, columnCount + 1:columnCount + nonzeroCount);
  end
end
%=============================================================================
% Copyright (c) 2017 September Daniel Mårtensson (Swedish Embedded Control Systems Toolbox)
% Copyright (c) 2023-present Allan CORNET (Nelson)
