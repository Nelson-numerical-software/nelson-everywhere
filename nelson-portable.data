function status = bench_run(varargin)
  targets = [];
  options = {};
  if nargin > 0
    targets = varargin{1};
    options = varargin(2:end);
  end
  results = nelson.unittest.run(targets, options{:}, 'Kind', 'bench');
  status = results.status;
end
