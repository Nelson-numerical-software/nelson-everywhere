requiremodule('core');
%=============================================================================
missingModule = ['nelson_missing_', strrep(createGUID(), '-', '_')];
asserts.checkerror(['requiremodule(''', missingModule, ''');'], ...
  sprintf(_('%s is not installed.'), ['''', missingModule, ''' ']));
%=============================================================================
% Generated portable test module boundary.
{
  "schemaVersion": 1,
  "examples": [
    {
      "file": "netcdf_roundtrip.m",
      "title": "NetCDF variable round trip",
      "description": "Create a temporary NetCDF variable and read its values back.",
      "tags": [
        "netcdf",
        "data"
      ],
      "requirements": []
    }
  ]
}
% Store a short time series in NetCDF and read it back.
filename = [tempdir(), 'nelson-example.nc'];
if isfile(filename), rmfile(filename); end
nccreate(filename, 'temperature', 'Dimensions', {'time', 5});
ncwrite(filename, 'temperature', [18.1; 19.4; 20.0; 19.7; 18.9]);
restored = ncread(filename, 'temperature');
disp(restored);
