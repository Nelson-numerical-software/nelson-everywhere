%=============================================================================
function [r, q] = iqr(A, varargin)
  if nargout > 1
    [r, q] = iqr(A.SecondsValue, varargin{:});
    q = duration.fromSeconds(q, A.FormatValue);
  else
    r = iqr(A.SecondsValue, varargin{:});
  end
  r = duration.fromSeconds(r, A.FormatValue);
end
