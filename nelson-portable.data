function out = durationFormatText(obj)
  % Display text of each element; NaN stays the text 'NaN' here, string()
  % turns it into <missing>.
  values = obj.SecondsValue;
  out = strings(size(values));
  for k = 1:numel(values)
    out(k) = duration.formatOne(values(k), obj.FormatValue);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = durationSizeValue(secondsValue, requestedOutputs, varargin)
  if isempty(varargin)
    if requestedOutputs <= 1
      varargout{1} = size(secondsValue);
    else
      [varargout{1:requestedOutputs}] = size(secondsValue);
    end
  else
    varargout{1} = size(secondsValue, varargin{1});
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function P = quantile(A, varargin)
  values = quantile(A.SecondsValue, varargin{:});
  P = duration.fromSeconds(values, A.FormatValue);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = size(obj, varargin)
  outputCount = max(nargout, 1);
  [varargout{1:outputCount}] = durationSizeValue(obj.SecondsValue, outputCount, varargin{:});
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = datestr(varargin)
  narginchk(1, 4);
  nargoutchk(0, 1);
  dateStringIn = varargin{1};
  epochs = [];

  if nargin == 1
    % DateString = datestr(DateStringIn)
    epochs = datenum(dateStringIn);
    varargout{1} = datestr(epochs);
    return
  end
  if nargin == 2
    mustBeTextScalar(varargin{2}, 2);
    formatOutOrLocal = convertStringsToChars(varargin{2});
    if (~ischar(formatOutOrLocal))
      error('Nelson:time:secondArgumentScalarStringRow', 'Second argument must be a scalar string or row vector of characters.');
    end
    if strcmp(formatOutOrLocal, 'local')
      % DateString = datestr(DateStringIn, 'local')
      epochs = datenum(dateStringIn);
      varargout{1} = datestr(epochs, 'local');
    else
      % DateString = datestr(DateStringIn, formatOut)
      try
        epochs = datenum(dateStringIn);
      catch
        epochs = datenum(dateStringIn, formatOutOrLocal);
      end
      varargout{1} = datestr(epochs, formatOutOrLocal);
    end
    return
  end
  if nargin == 3
    formatOut = convertStringsToChars(varargin{2});
    formatOutOrLocal = convertStringsToChars(varargin{3});
    if ischar(formatOutOrLocal)
      if ~strcmp(formatOutOrLocal, 'local')
        error('Nelson:time:thirdArgumentLocal', 'Third argument must be a ''local''.');
      end
      % DateString = datestr(DateStringIn, formatOut, 'local')
      epochs = datenum(dateStringIn, formatOut);
      varargout{1} = datestr(epochs, formatOut, 'local');
    elseif (isnumeric(formatOutOrLocal) && isscalar(formatOutOrLocal))
      % DateString = datestr(DateStringIn, formatOut, PivotYear)
      epochs = datenum(dateStringIn, formatOutOrLocal);
      varargout{1} = datestr(epochs, formatOut);
    else
      error('Nelson:time:thirdArgumentNumericScalar', '%s must be a numeric scalar.', 'Third argument');
    end
    return
  end
  if nargin == 4
    % DateString = datestr(DateStringIn, formatOut, PivotYear, 'local')
    mustBeTextScalar(varargin{2}, 2);
    formatOut = convertStringsToChars(varargin{2});
    mustBeNumeric(varargin{3}, 3);
    pivotYear = varargin{3};
    if (~isscalar(pivotYear))
      error('Nelson:time:thirdArgumentNumericScalar', '%s must be a numeric scalar.', 'Third argument');
    end
    mustBeTextScalar(varargin{4}, 4);
    local = convertStringsToChars(varargin{4});
    if (~ischar(local))
      error('Nelson:time:fourthArgumentLocal', 'Fourth argument must be a ''local''.');
    end
    if (strcmp(local, 'local') == false)
      error('Nelson:time:fourthArgumentLocal', 'Fourth argument must be a ''local''.');
    end
    epochs = datenum(dateStringIn, formatOut, pivotYear);
    varargout{1} = datestr(epochs, formatOut, 'local');
    return
  end
end
