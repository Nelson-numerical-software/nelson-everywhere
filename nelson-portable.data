%=============================================================================
function [C, ia] = setdiff(A, B, varargin)
  n = max(nargout, 1);
  outputs = cell(1, n);
  [outputs{:}] = setOperation('setdiff', A, B, varargin{:});
  C = outputs{1};
  if n >= 2
    ia = outputs{2};
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
