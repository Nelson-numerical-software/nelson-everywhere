%=============================================================================
function d = lweekdate(weekdayNumber, yearNumber, monthNumber)
  narginchk(3, 3);
  last = datenum(yearNumber, monthNumber, eomday(yearNumber, monthNumber));
  lastWeekday = weekday(last);
  d = last - mod(lastWeekday - weekdayNumber, 7);
end
