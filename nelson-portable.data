% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
odeCheckSolverForTest(@ode23);
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
odeCheckSolverForTest(@ode23s);
%=============================================================================
% Stiff accuracy: the modified Rosenbrock (2,3) must track the requested
% tolerance on stiff problems (guards against a low-order approximation).
% Stiff linear system with a fast (lambda = -100) and a slow (lambda = -1) mode.
A = [-100 1; 0 -1];
yexact = @(t)[exp(-100 * t) + (exp(-t) - exp(-100 * t)) / 99; exp(-t)];
solLoose = ode23s(@(t, y) A * y, [0 1], [1; 1], odeset('RelTol', 1e-3, 'AbsTol', 1e-6));
asserts.istrue(max(abs(solLoose.y(:, end) - yexact(1))) < 1e-2);
solTight = ode23s(@(t, y) A * y, [0 1], [1; 1], odeset('RelTol', 1e-6, 'AbsTol', 1e-9));
asserts.istrue(max(abs(solTight.y(:, end) - yexact(1))) < 1e-4);
%=============================================================================
% Very stiff decay (lambda = -1000) resolved to a tight tolerance.
Ad = [-1000 0; 0 -1];
solDecay = ode23s(@(t, y) Ad * y, [0 0.5], [1; 1], odeset('RelTol', 1e-6, 'AbsTol', 1e-9));
asserts.istrue(abs(solDecay.y(2, end) - exp(-0.5)) < 1e-4);
%=============================================================================

%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
odeCheckSolverForTest(@ode23t);
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
odeCheckSolverForTest(@ode23tb);
%=============================================================================
% Stiff accuracy: the embedded third-order estimate must keep the error near
% the requested tolerance without over-stepping.
A = [-100 1; 0 -1];
yexact = @(t)[exp(-100 * t) + (exp(-t) - exp(-100 * t)) / 99; exp(-t)];
solLoose = ode23tb(@(t, y) A * y, [0 1], [1; 1], odeset('RelTol', 1e-3, 'AbsTol', 1e-6));
asserts.istrue(max(abs(solLoose.y(:, end) - yexact(1))) < 1e-2);
solTight = ode23tb(@(t, y) A * y, [0 1], [1; 1], odeset('RelTol', 1e-6, 'AbsTol', 1e-9));
asserts.istrue(max(abs(solTight.y(:, end) - yexact(1))) < 1e-4);
asserts.istrue(solTight.stats.nsteps < 1000);
%=============================================================================
% An inexact user-supplied Jacobian must not degrade the solution.
wrongJac = ode23tb(@(t, y) 1, [0 1], 0, odeset('Jacobian', -1, 'RelTol', 1e-3, 'AbsTol', 1e-6));
asserts.istrue(abs(wrongJac.y(end) - 1) < 1e-4);
%=============================================================================

%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
odeCheckSolverForTest(@ode45);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
f = @(t, y) - y;
[t, y] = ode45(f, [0 1], 1);
asserts.istrue(abs(t(1)) < eps);
asserts.istrue(abs(t(length(t)) - 1) < 1e-12);
asserts.istrue(abs(y(size(y, 1), 1) - exp(-1)) < 5e-4);
%=============================================================================
sol = ode45(f, [0 0.5 1], 1, odeset('RelTol', 1e-5));
asserts.istrue(length(sol.x) >= 2);
asserts.istrue(abs(sol.x(1)) < eps);
asserts.istrue(abs(sol.x(length(sol.x)) - 1) < 1e-12);
asserts.istrue(abs(sol.y(1, size(sol.y, 2)) - exp(-1)) < 5e-4);
%=============================================================================
[v, vp] = deval(sol, 0.25);
asserts.istrue(abs(v - exp(-0.25)) < 5e-3);
asserts.istrue(abs(vp + v) < 5e-2);
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
[t, y] = ode45(@odeParameterizedRhs, [0 0.1], 1, [], 2);
asserts.istrue(size(t, 1) > 1);
asserts.isapprox(y(end), exp(0.2), 1e-3);
[t, y] = ode45('odeLegacyTextRhs', [0 0.1], 1, [], 2);
asserts.istrue(size(t, 1) > 1);
asserts.isapprox(y(end), exp(0.2), 1e-3);
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
odeCheckSolverForTest(@ode78);
%=============================================================================
% High-order accuracy: the Verner 7(6) pair must track a tight tolerance
% (guards the Butcher tableau transcription).
sol = ode78(@(t, y)[y(2); -y(1)], [0 10], [1; 0], odeset('RelTol', 1e-8, 'AbsTol', 1e-10));
asserts.istrue(max(abs(sol.y(:, end) - [cos(10); -sin(10)])) < 1e-8);
%=============================================================================

