%=============================================================================
function varargout = gram(varargin)
  % Wc = gram(sys, 'c')
  % Wc = gram(sys, 'o')
  narginchk(2, 2);
  nargoutchk(0, 1);
  option = varargin{2};
  option = tolower(convertStringsToChars(option));

  sys = varargin{1};

  % Get sample time
  sampleTime = sys.Ts;

  if (sampleTime > 0)
    % Discrete way
    A = sys.A;
    B = sys.B;
    C = sys.C;

    if (strcmp(option, 'c'))
      X = dlyap(A, B * B');
    elseif (strcmp(option, 'o'))
      X = dlyap(A', C' * C);
    else
      error('Nelson:control_system:wrongArgumentValue', '%s expected.', "'o', 'c' second argument");
    end
  else
    % Continuous way
    A = sys.A;
    B = sys.B;
    C = sys.C;

    if (strcmp(option, 'c'))
      X = lyap(A, B * B');
    elseif (strcmp(option, 'o'))
      X = lyap(A', C' * C);
    else
      error('Nelson:control_system:wrongArgumentValue', '%s expected.', "'o', 'c' second argument");
    end
  end
  varargout{1} = X;
end
%=============================================================================
% Copyright (c) 2017 October Daniel MÃ¥rtensson (Swedish Embedded Control Systems Toolbox)
