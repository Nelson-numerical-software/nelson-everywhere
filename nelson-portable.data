%#ok<NLS0026>
function status = odeprint(t, y, flag, varargin)
  hasNoFlag = nargin < 3 || isempty(flag);
  if hasNoFlag
    t
    y
  else
    if isstring(flag) || ischar(flag)
      activeFlag = char(flag);
    else
      activeFlag = flag;
    end
    if strcmp(activeFlag, 'init')
      disp('t =')
      disp(t(1))
      y
    elseif strcmp(activeFlag, 'done')
      fprintf('\n\n');
    end
  end
  status = 0;
end
%=============================================================================
%=============================================================================
