function results = run_writeLogs(results, logDir)
  if isempty(logDir)
    return
  end
  if ~isdir(logDir)
    mkdir(logDir);
  end
  cases = results.cases;
  for k = 1:length(cases)
    logFile = [logDir, '/', cases(k).id, '.json'];
    cases(k).artifacts = {logFile};
    filewrite(logFile, jsonprettyprint(jsonencode(cases(k))));
  end
  results.cases = cases;
end
