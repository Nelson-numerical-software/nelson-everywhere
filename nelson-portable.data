% LICENCE_BLOCK_END
function test_case = applyManualSkipPolicy(test_case)
  if (test_case.options.not_fixed)
    test_case = markSkipped(test_case, 'Skip');
  end
  if (test_case.options.interactive_test)
    test_case = markSkipped(test_case, 'Interactive');
  end
end
