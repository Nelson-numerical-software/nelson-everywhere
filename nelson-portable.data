%=============================================================================
function buildhelpweb(varargin)
  % buildhelpweb(destdir, [currentlang])
  narginchk(1, 2);

  if nargin() == 2
    lang = varargin{2};
  else
    lang = getdefaultlanguage();
  end

  dirdest = varargin{1};
  if ~isdir(dirdest)
    error('Nelson:buildhelpweb:directoryDoesNotExist', 'Existing directory expected.');
  end

  modules_help_list = get_modules_help_list();
  for m = modules_help_list'
    help_file = [nelsonroot() '/modules/' m{1} '/help/' nelsonappid() '.modules.' m{1} '.help.' lang '.nhz'];
    if ~isfile(help_file)
      help_file = [nelsonroot() '/modules/' m{1} '/help/' nelsonappid() '.modules.' m{1} '.help.' getdefaultlanguage() '.nhz'];
    end
    if ~isfile(help_file)
      continue
    end
    unzip(help_file, dirdest);
  end
  lang_used = lang;
  main_help_file = [nelsonroot() '/modules/main/help/' nelsonappid() '.modules.main.help.' lang_used '.nhz'];
  if ~isfile(main_help_file)
    lang_used = getdefaultlanguage();
    main_help_file = [nelsonroot() '/modules/main/help/' nelsonappid() '.modules.main.help.' lang_used '.nhz'];
  end
  unzip(main_help_file, dirdest);
  if ~isdir([dirdest, '/main'])
    error('Nelson:buildhelpweb:directoryExpected', 'Directory expected: %s', [dirdest, '/main']);
  end
  d = dir([dirdest, '/main/*.*']);
  for k = 1:length(d)
    if ~d(k).isdir
      copyfile([dirdest, '/main/' , d(k).name], dirdest);
    end
  end
  rmdir([dirdest, '/main'], 's');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = deployhelp(varargin)
    % deployhelp('install')
    % deployhelp('add', module_name, module_help_dir)
    % deployhelp('remove', module_name)
    % [status, message] = deployhelp('uninstall')
    % status = deployhelp('status')
    % [status, message] = deployhelp('refresh')
    if nargin() == 0
        action = 'install';
    else
        action = varargin{1};
    end
    status = false;
    message = '';
    switch lower(action)
        case 'add'
            if ~deployhelp_status()
                install_help(true);
                if ~using_help_cache_override()
                    docroot('.');
                end
            end
            [status, message] = deployhelp_add(varargin{2}, varargin{3});
            if status
                [status, message] = refresh_help(varargin{2});
            end
        case 'remove'
            [status, message] = deployhelp_remove(varargin{2});
            if status
                [status, message] = refresh_help();
            end
        case 'install'
            narginchk(0, 2);
            if nargin == 2
                verbose = varargin{2};
                mustBeLogicalScalar(verbose, 2);
            else
                verbose = true;
            end
            if ~using_help_cache_override()
                docroot('.');
            end
            install_help(verbose);
            status = deployhelp_status();
        case 'uninstall'
            [status, message] = uninstall_help();
        case 'status'
            narginchk(1, 1);
            nargoutchk(0, 1);
            status = deployhelp_status();
            message = '';
        case 'refresh'
            install_help(false);
            [status, message] = refresh_help();
        otherwise
            status = false;
            message = sprintf('Unknown action: %s', action);
    end

    if (nargout == 0 && ~status)
      error('Nelson:deployhelp:deployFailed', message);
    end
    if nargout >= 1
      varargout{1} = status;
    end
    if nargout >= 2
      varargout{2} = message;
    end
 end
%=============================================================================
function status = deployhelp_status()
  ver_number = version('-number');
  version_string = sprintf('%d.%d.%d', ver_number(1), ver_number(2), ver_number(3));
  help_dir = deployhelp_cache_dir(version_string);
  language_dir = [help_dir, getlanguage()];
  if ~isdir(language_dir)
    language_dir = [help_dir, getdefaultlanguage()];
  end
  status = isfile([language_dir, '/index.html']) && isfile([language_dir, '/index.json']);
end
%=============================================================================
function [status, message] = deployhelp_add(module_name, module_help_dir)
  status = false;
  message = '';

  ver_number = version('-number');
  version_string = sprintf('%d.%d.%d', ver_number(1), ver_number(2), ver_number(3));
  help_dir = deployhelp_cache_dir(version_string);
  if ~isdir(help_dir)
    status = false;
    message = 'Help directory does not exist.';
    return;
  end
  for lang = getavailablelanguages()'
    lang_dir = [help_dir, '/', lang{1}];

    help_archive_name = [module_help_dir, '/help/', nelsonappid(), '.modules.', module_name, '.help.', lang{1}, '.nhz'];
    if ~isfile(help_archive_name)
      continue;
    end
    unzip(help_archive_name, lang_dir);
  end
  status = true;
  message = '';
end
%=============================================================================
function [status, message] = deployhelp_remove(module_name)
  status = true;
  message = '';
  ver_number = version('-number');
  version_string = sprintf('%d.%d.%d', ver_number(1), ver_number(2), ver_number(3));
  help_dir = deployhelp_cache_dir(version_string);
  if ~isdir(help_dir)
    status = false;
    message = 'Help directory does not exist.';
    return;
  end
  for lang = getavailablelanguages()'
    lang_dir = [help_dir, '/', lang{1}];
    if isdir(lang_dir)
      module_help_dir = [lang_dir, '/', module_name];
      if isdir(module_help_dir)
        [status, message] = rmdir(module_help_dir, 's');
        if ~status
          return;
        end
      end
    end
  end
end
%=============================================================================
function help_dir = deployhelp_cache_dir(version_string)
  help_dir = getenv('NELSON_HELP_CACHE_DIR');
  if ~isempty(help_dir)
    help_dir = ensureTrailingFileSeparator(help_dir);
    return
  end
  if ~isempty(getenv('NELSON_PREFERENCES_PATH'))
    help_dir = [prefdir(), '/help/'];
    return
  end
  help_dir = [userdir(), '/Nelson/', version_string, '/help/'];
end
%=============================================================================
function tf = using_help_cache_override()
  tf = ~isempty(getenv('NELSON_HELP_CACHE_DIR'));
end
%=============================================================================
function path = ensureTrailingFileSeparator(path)
  if ~endsWith(path, '/')
    path = [path, '/'];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function doc(varargin)
  dryRun = strcmp(getenv('NELSON_DOC_DRY_RUN'), 'TRUE');
  if contains(getnelsonmode(), {'BASIC_ENGINE', 'BASIC_TERMINAL'}) && ~dryRun
    warning('Nelson:doc:notAvailableInMode', 'Documentation is not available in this mode. See "help" command for more information.');
    return
  end
  mainUrl = docroot();
  islocalhelp = strcmp(mainUrl, '.');
  ver_number = version('-number');
  version_string = sprintf('%d.%d.%d', ver_number(1), ver_number(2), ver_number(3));

  if islocalhelp
    version_string = sprintf('%d.%d.%d', ver_number(1), ver_number(2), ver_number(3));
    mainUrl = getLocalHelpCacheDir(version_string);
    if endsWith(mainUrl, '/')
      mainUrl = mainUrl(1:end - 1);
    end
    if ~isdir(mainUrl)
      warning('Nelson:doc:localHelpNotInstalled:localHelpNotInstalledOpenWeb', 'Local help not installed. Open web help instead.');
      islocalhelp = false;
      mainUrl = getDefaultUrl();
    end
  else
    version_string = sprintf('v%d.%d.%d', ver_number(1), ver_number(2), ver_number(3));
  end
  txt = joinText(varargin);
  language = getlanguage();
  [stSearchResults, baseUrl] = getSearchBase(mainUrl, language, version_string, islocalhelp);
  url = buildUrl(baseUrl, txt, islocalhelp, stSearchResults);
  if dryRun
    disp(url);
    return;
  end
  openBrowser(url, islocalhelp);
end
%=============================================================================
function [stSearchResults, baseUrl] = getSearchBase(mainUrl, language, version_string, islocalhelp)
  if islocalhelp
    baseUrl = [mainUrl, '/', language];
    jsonFile = [baseUrl, '/', 'index.json'];
    if ~isfile(jsonFile)
      jsonFile = [mainUrl, '/', getdefaultlanguage(), '/', 'index.json'];
      baseUrl = [mainUrl, '/', getdefaultlanguage()];
    end
    if ~isfile(jsonFile)
      error('Nelson:doc:localHelpNotInstalled', 'Local help not installed.');
    end
  else
    baseUrl = [mainUrl, '/', language, '/', version_string];
    jsonFile = getCacheFileHelpLang(baseUrl, language);
  end
  try
    stSearchResults = jsondecode(jsonFile, '-file');
  catch
    stSearchResults = struct([]);
  end
end
%=============================================================================
function jsonFile = getCacheFileHelpLang(baseUrl, lang)
  jsonFile = '';
  ver_number = version('-number');
  version_string = sprintf('%d.%d.%d', ver_number(1), ver_number(2), ver_number(3));
  cachedir = [userdir(), 'Nelson/', version_string, '/cache/help/', lang, '/'];
  if ~isfolder(cachedir)
    mkdir(cachedir);
  end
  cacheFile = [cachedir, 'index.json'];
  if isfile(cacheFile) && ~isCacheFileExpired(cacheFile)
    jsonFile = cacheFile;
    return;
  end
  jsonSearchUrl = [baseUrl, '/', 'index.json'];
  try
    jsonFile = websave(cacheFile, jsonSearchUrl, weboptions('ContentType','json'));
  catch
    % keep serving a stale index rather than nothing when offline.
    if isfile(cacheFile)
      jsonFile = cacheFile;
    else
      jsonFile = '';
    end
  end
end
%=============================================================================
function tf = isCacheFileExpired(cacheFile)
  CACHE_LIFETIME_IN_DAYS = 7;
  tf = true;
  try
    info = dir(cacheFile);
    if ~isempty(info) && info(1).datenum > 0
      tf = (now() - info(1).datenum) > CACHE_LIFETIME_IN_DAYS;
    end
  catch
    tf = true;
  end
end
%=============================================================================
function txt = joinText(args)
  txt = '';
  for i = 1:length(args)
    name = args{i};
    mustBeTextScalar(name, i);
    if i == 1
      txt = name;
    else
      txt = [txt, ' ', name];
    end
  end
end
%=============================================================================
function url = buildUrl(baseUrl, txt, islocalhelp, stSearchResults)
  if isempty(txt)
    url = [baseUrl, '/', 'index.html'];
    return;
  end
  urlfound = '';
  if ismacro(txt) || isbuiltin(txt)
    urlfound = searchMacroOrBuiltin(stSearchResults, txt);
  end
  if isempty(urlfound) && ismodule(txt)
    urlfound = searchModule(stSearchResults, txt);
  end
  if isempty(urlfound)
    urlfound = searchAny(stSearchResults, txt);
  end
  if ~isempty(urlfound)
    url = buildViewerUrl(baseUrl, 'open', urlfound, islocalhelp);
  else
    url = buildViewerUrl(baseUrl, 'search', txt, islocalhelp);
  end
end
%=============================================================================
function url = buildViewerUrl(baseUrl, key, value, islocalhelp)
  if islocalhelp
    url = buildLocalViewerLauncherUrl(baseUrl, key, value);
  else
    url = [baseUrl, '/', 'index.html?', key, '=', urlencode(value)];
  end
end
%=============================================================================
function url = buildLocalViewerLauncherUrl(baseUrl, key, value)
  target = ['file://', baseUrl, '/', 'index.html#', key, '=', urlencode(value)];
  url = [tempdir(), 'nelson_doc_open.html'];
  html = ['<!DOCTYPE html>', newline(), ...
  '<html><head><meta charset="utf-8">', newline(), ...
  '<meta http-equiv="refresh" content="0; url=', target, '">', newline(), ...
  '<script>window.location.replace(', jsonencode(target), ');</script>', newline(), ...
  '</head><body><a href="', target, '">Open documentation</a></body></html>', newline()];
  try
    filewrite(url, html);
  catch
    url = [baseUrl, '/', 'index.html#', key, '=', urlencode(value)];
  end
end
%=============================================================================
function urlfound = searchMacroOrBuiltin(stSearchResults, query)
  urlfound = '';
  for i = 1:length(stSearchResults)
    entry = stSearchResults(i);
    if strcmp(entry.title, query)
      urlfound = entry.url;
      return;
    end
  end
end
%=============================================================================
function urlfound = searchModule(stSearchResults, query)
  urlfound = '';
  for i = 1:length(stSearchResults)
    entry = stSearchResults(i);
    if strcmp(entry.path, ['sections/', query])
      urlfound = ['./', query, '/index.html'];
      return;
    end
  end
end
%=============================================================================
function urlfound = searchAny(stSearchResults, query)
  urlfound = '';
  preparedQuery = strtrim(query);
  if isempty(preparedQuery)
    return;
  end
  % match on a word boundary, so that 'plot' also matches 'plot,' or a title
  % which is exactly 'plot' (the previous space padding matched neither).
  pattern = ['\b', regexptranslate('escape', preparedQuery), '\b'];
  for i = 1:length(stSearchResults)
    entry = stSearchResults(i);
    if ~isempty(regexpi(entry.title, pattern, 'once')) || ~isempty(regexpi(entry.content, pattern, 'once'))
      urlfound = entry.url;
      if strcmp(urlfound,  '/./index.html') && startsWith(entry.path, 'sections/')
        urlfound = ['./', entry.path(strlength('sections/'):end), '/index.html'];
      end
      return;
    end
  end
end
%=============================================================================
function help_dir = getLocalHelpCacheDir(version_string)
  help_dir = getenv('NELSON_HELP_CACHE_DIR');
  if ~isempty(help_dir)
    help_dir = ensureTrailingFileSeparator(help_dir);
  elseif ~isempty(getenv('NELSON_PREFERENCES_PATH'))
    help_dir = [prefdir(), '/help/'];
  else
    help_dir = [userdir(), '/Nelson/', version_string, '/help/'];
  end
end
%=============================================================================
function path = ensureTrailingFileSeparator(path)
  if ~endsWith(path, '/')
    path = [path, '/'];
  end
end
%=============================================================================
function openBrowser(url, islocalhelp)
  browser = '';
  if ispc()
    browser = findWindowsBrowser();
  elseif ismac()
    browser = findMacOsBrowser();
  else
    browser = findLinuxBrowser();
  end

  prefix = '';
  if islocalhelp
    prefix = 'file://';
  end

  if ~isempty(browser)
    if ispc()
      system(['start ', browser, ' "', prefix, url, '"']);
      return
    end

    if ismac()
      status = system(['open -a ''', browser, ''' "', prefix, url, '" 2>/dev/null']);
      if status == 0
        return
      end
      browser = '';
    end

    if isunix()
      system([browser, ' "', prefix, url, '" &']);
      return
    end
  else
    if ispc()
      % the empty title argument is required, otherwise 'start' consumes the
      % quoted url as the console window title.
      system(['start "" "', prefix, url, '"']);
      return
    end

    if ismac()
      status = system(['open "', prefix, url, '" 2>/dev/null']);
      if status ~= 0
        warning('Nelson:doc:cannotOpenUrl', 'Unable to open documentation URL: %s', [prefix, url]);
      end
      return
    end

    if isunix()
      system(['xdg-open ', prefix, url]);
      return
    end
  end
end
%==============================================================================
function browser = findWindowsBrowser()
  % On Windows, 'start' already honours the browser the user registered as
  % default: do not force a particular one.
  browser = '';
end
%==============================================================================
function browser = findMacOsBrowser()
  % Try to get the default browser using plutil and jq
  cmd = ['plutil -extract LSHandlers json -o - ~/Library/Preferences/com.apple.LaunchServices/com.apple.launchservices.secure.plist | ', ...
         'jq -r ''.[] | select(.LSHandlerURLScheme=="http") | .LSHandlerRoleAll'' 2>/dev/null'];
  [status, output] = unix(cmd);

  if status ~= 0 || isempty(output)
    % Try fallback method with defaults command
    cmd = ['defaults read com.apple.LaunchServices/com.apple.launchservices.secure LSHandlers | ', ...
           'grep "LSHandlerURLScheme = http" -A 3 -B 2 | ', ...
           'grep LSHandlerRoleAll | ', ...
           'awk -F= ''{print $NF}'' | ', ...
           'tr -d '' ";\'' 2>/dev/null'];
    [status, output] = unix(cmd);
  end

  if status == 0 && ~isempty(output)
    browser_id = strtrim(output);

    % Map browser bundle identifiers to browser names
    if contains(browser_id, 'com.google.chrome')
      browser = 'Google Chrome';
    elseif contains(browser_id, 'org.mozilla.firefox')
      browser = 'Firefox';
    elseif contains(browser_id, 'com.apple.safari')
      browser = 'Safari';
    elseif contains(browser_id, 'com.operasoftware.opera')
      browser = 'Opera';
    elseif contains(browser_id, 'com.brave.browser')
      browser = 'Brave Browser';
    elseif contains(browser_id, 'com.microsoft.edgemac')
      browser = 'Microsoft Edge';
    elseif contains(browser_id, 'com.vivaldi.vivaldi')
      browser = 'Vivaldi';
    else
      browser = '';  % Default to empty if bundle ID not recognized
    end

    % If we found a browser and LaunchServices can resolve it, return it.
    if ~isempty(browser) && unix(['open -Ra ''', browser, ''' >/dev/null 2>&1']) == 0
      return;
    end
    browser = '';
  end

  % Fall back to checking common browser locations
  possibleBrowsers = {'Google Chrome', ...
  'Firefox', ...
  'Safari', ...
  'Opera', ...
  'Brave Browser', ...
  'Microsoft Edge', ...
  'Vivaldi'};

  browser = '';

  % Also check user Applications folder
  for i = 1:length(possibleBrowsers)
    b = possibleBrowsers{i};
    if unix(['open -Ra ''', b, ''' >/dev/null 2>&1']) == 0
      browser = b;
      return;
    end
  end

  for i = 1:length(possibleBrowsers)
    b = possibleBrowsers{i};
    if unix(['open -Ra ''', b, ''' >/dev/null 2>&1']) == 0
      browser = b;
      return;
    end
  end
end
%==============================================================================
function browser = findLinuxBrowser()
  [status, output] = unix('xdg-mime query default x-scheme-handler/http 2>/dev/null');
  if status == 0 && ~isempty(output)
    desktop_file = strtrim(output);
    browser_name = strrep(desktop_file, '.desktop', '');

    if contains(browser_name, 'chrome')
      browser = 'google-chrome';
    elseif contains(browser_name, 'chromium')
      browser = 'chromium-browser';
    elseif contains(browser_name, 'firefox')
      browser = 'firefox';
    elseif contains(browser_name, 'brave')
      browser = 'brave-browser';
    elseif contains(browser_name, 'opera')
      browser = 'opera';
    elseif contains(browser_name, 'midori')
      browser = 'midori';
    elseif contains(browser_name, 'vivaldi')
      browser = 'vivaldi';
    else
      browser = browser_name;
    end

    check_status = unix(['which ', browser, ' 2>/dev/null']);
    if check_status == 0
      return;
    end
  end

  possibleBrowsers = {'google-chrome', 'chromium-browser', 'firefox', 'opera', 'brave-browser', 'vivaldi', 'midori'};
  browser = '';
  for i = 1:length(possibleBrowsers)
    b = possibleBrowsers{i};
    status = unix(['which ', b, ' 2>/dev/null']);
    if status == 0
      browser = b;
      return;
    end
  end
end
%==============================================================================
function url = getDefaultUrl()
  defaultsConf = [modulepath('nelson','etc'), '/defaults.conf'];
  defaults = jsondecode(defaultsConf, '-file');
  url = defaults.docbook_url;
end
%==============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = help(varargin)
    % HELP Display help about Nelson macros and built-in functions.
    %
    %   help function_name
    %   help('function_name')
    %   HELP keyword
    %   Displays indexed help or an XML page of a loaded external module.
    %   If no keyword is provided, a general help message is displayed.
    %   txt = HELP(keyword)
    %   Returns the help text as a string instead of displaying it.
    %   Example:
    %       help('plot')
    %       txt = help('plot')
    %   See also ismacro, isbuiltin, getlanguage, nelsonroot, jsondecode, terminal_size.
    varargout = {};
    if nargin == 0
        fprintf([_('Type help ''help'' for more information.'), '\n']);
        return
    end
    keyword = varargin{1};
    json = [nelsonroot(), filesep(), 'modules', filesep(), 'help_tools', filesep(), 'help', filesep(), 'nelson_help_', getlanguage(), '.json'];
    indexExists = isfile(json);
    helpData = [];
    found = false;
    completeDescription = false;
    if indexExists
        helpData = jsondecode(json, '-file');
        found = isfield(helpData, keyword);
        if found
            page = helpData.(keyword);
        end
    end
    if ~found
        [page, found] = externalHelpPage(keyword);
        completeDescription = found;
    end
    if found
        [r, c] = terminal_size();
        txt = formatStruct(page, c - 4, completeDescription);
        if nargout == 0
            fprintf('%s', txt);
        else
            varargout{1} = txt;
        end
        return
    end
    if ~indexExists
        if ~(ismacro(keyword) || isbuiltin(keyword))
            if nargout > 0
                varargout{1} = '';
            end
            return
        end
        warning('Nelson:help:fileNotFound', 'Help file not found: "%s".', json);
        if nargout > 0
            varargout{1} = '';
        end
        return
    end
    if isempty(helpData)
        warning('Nelson:help:notAvailable', 'No help available for "%s".', keyword);
        if nargout > 0
            varargout{1} = '';
        end
        return
    end
    if ~(ismacro(keyword) || isbuiltin(keyword))
        if nargout > 0
            varargout{1} = '';
        end
        return
    end
    if ismacro(keyword)
        ce = headcomments(keyword);
        if isempty(ce)
            warning('Nelson:help:notAvailableMacro', 'No help available for macro "%s".', keyword);
            if nargout > 0
                varargout{1} = '';
            end
            return
        end
        if nargout == 0
            for l = ce(:)'
                fprintf([l{1}, newline()]);
            end
        else
            txt = '';
            for l = ce(:)'
                if isempty(txt)
                    txt = l{1};
                else
                    txt = [txt, newline(), l{1}];
                end
            end
            varargout{1} = txt;
        end
        return
    else
        warning('Nelson:help:notFound', 'Help not found for "%s".', keyword);
        if nargout > 0
            varargout{1} = '';
        end
        return
    end
end
%=============================================================================
function txt = formatStruct(st, maxLineLength, completeDescription)
    txt = '';
    if isempty(st)
        return
    end
    if isfield(st, 'short_description')
        r = formatShortDescription(st, maxLineLength);
        if ~isempty(r)
            txt = [txt, r, newline];
        end
    end
    if isfield(st, 'description')
        r = formatDescription(st, maxLineLength, completeDescription);
        if ~isempty(r)
            if ~isempty(txt)
                txt = [txt, newline];
            end
            txt = [txt, r, newline];
        end
    end
    if isfield(st, 'syntax')
        r = formatSyntax(st, maxLineLength);
        if ~isempty(r)
            txt = [txt, r, newline];
        end
    end
    if isfield(st, 'input_arguments')
        r = formatInputArgs(st, maxLineLength);
        if ~isempty(r)
            txt = [txt, r, newline];
        end
    end
    if isfield(st, 'output_arguments')
        r = formatOutputArgs(st, maxLineLength);
        if ~isempty(r)
            txt = [txt, r, newline];
        end
    end
    if isfield(st, 'examples')
        r = formatExamples(st, maxLineLength);
        if ~isempty(r)
            txt = [txt, r, newline];
        end
    end
    if isfield(st, 'see_also')
        r = formatSeeAlso(st, maxLineLength);
        if ~isempty(r)
            txt = [txt, r, newline];
        end
    end
    if isfield(st, 'keyword')
        r = formatDocumentation(st, maxLineLength);
        if ~isempty(r)
            txt = [txt, r, newline];
        end
    end
end
%=============================================================================
function txt = formatShortDescription(st, maxLineLength)
    if isfield(st, 'keyword')
        txt = [' ', st.keyword, ' - ', st.short_description];
    else
        txt = [' ', st.short_description];
    end
end
%=============================================================================
function txt = formatSyntax(st, maxLineLength)
    txt = ['   ', _('Syntax:'), ' ', newline];
    for i = 1:length(st.syntax)
        txt = [txt, '   ', '   ', st.syntax{i}, newline];
    end
end
%=============================================================================
function txt = formatInputArgs(st, maxLineLength)
    input_args = st.input_arguments;
    nb_input_args = length(input_args);
    if nb_input_args == 0
        txt = '';
        return
    end
    txt = ['   ', _('Input Arguments:'), newline];
    for i = 1:nb_input_args
        txt = [txt, '   ', '   ',input_args(i).name, ': ', input_args(i).description, newline];
    end
end
%=============================================================================
function txt = formatOutputArgs(st, maxLineLength)
    output_args = st.output_arguments;
    nb_output_args = length(output_args);
    if nb_output_args == 0
        txt = '';
        return
    end
    txt = ['   ', _('Output Arguments:'), newline];
    for i = 1:nb_output_args
        txt = [txt, '   ', '   ', output_args(i).name, ': ', output_args(i).description, newline];
    end
end
%=============================================================================
function txt = formatDescription(st, maxLineLength, completeDescription)
    description = st.description;
    if ~completeDescription
        description = limitToTwoSentences(description);
    end
    lines = splitText(description, maxLineLength);
    txt = '';
    for i = 1:length(lines)
        txt = [txt, '   ', lines{i}, newline];
    end
end
%=============================================================================
function txt = formatSeeAlso(st, maxLineLength)
    if isempty(st.see_also)
        txt = '';
        return
    end
    see_also_txt = join(st.see_also, ', ');
    txt = ['   ', sprintf(_('See also: %s'), see_also_txt{1}), newline];
end
%=============================================================================
function txt = formatExamples(st, maxLineLength)
    if isempty(st.examples)
        txt = '';
        return
    end
    examples_txt = join(st.examples, newline());
    txt = ['   ', sprintf(_('Examples: %s'), examples_txt{1}), newline];
end
%=============================================================================
function txt = formatDocumentation(st, maxLineLength)
    txt = ['   ', sprintf(_('Documentation: %s'), st.keyword), newline];
end
%=============================================================================
function lines = splitText(txt, maxLineLength)
    words = {};
    w = '';
    for k = 1:length(txt)
        ch = txt(k);
        if isspace(ch)
            if ~isempty(w)
                words{end+1} = w;
                w = '';
            end
        else
            w = [w, ch];
        end
    end
    if ~isempty(w)
        words{end+1} = w;
    end

    currentLine = '';
    lines = {};
    for i = 1:length(words)
        word = words{i};
        if isempty(currentLine)
            tentative = word;
        else
            tentative = [currentLine, ' ', word];
        end
        if length(tentative) <= maxLineLength
            currentLine = tentative;
        else
            if ~isempty(currentLine)
                lines{end+1} = currentLine;
            end
            currentLine = word;
        end
    end
    if ~isempty(currentLine)
        lines{end+1} = currentLine;
    end
end
%=============================================================================
function txt = limitToTwoSentences(txt)
    % Extract up to two sentences
    sentences = {};
    current = '';
    truncated = false;
    for k = 1:length(txt)
        ch = txt(k);
        current = [current, ch];
        if ch == '.' || ch == '!' || ch == '?'
            % push sentence (trim to remove leading/trailing spaces)
            sentences{end+1} = strtrim(current);
            current = '';
            if length(sentences) >= 2
                % if there's any non-space character after this point -> truncated
                if k < length(txt)
                    rest = txt(k+1:end);
                    if any(~isspace(rest))
                        truncated = true;
                    end
                end
                break;
            end
        end
    end

    if length(sentences) >= 2
        out = [sentences{1}, ' ', sentences{2}];
    elseif length(sentences) == 1
        out = sentences{1};
    else
        % no sentence terminator found: return trimmed input
        out = strtrim(txt);
    end

    if truncated
        out = [out, ' â€¦'];
    end

    txt = out;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function markdowndisp(textToRender)
  narginchk(1, 1);
  nargoutchk(0, 0);

  if isStringScalar(textToRender)
    textToRender = convertStringsToChars(textToRender);
  end
  if ~ischar(textToRender) || ~isrow(textToRender)
    error('Nelson:markdowndisp:invalidInput', 'Input argument must be a string scalar or row character vector.');
  end

  mode = getnelsonmode();
  if ~strcmp(mode, 'GUI') && ~strcmp(mode, 'WEB_GUI')
    disp(textToRender);
    return
  end

  if contains(textToRender, char(8))
    error('Nelson:markdowndisp:backspaceNotSupported', 'Backspace character is not supported.');
  end

  html = markdown(textToRender, 'advanced');
  if strcmp(mode, 'WEB_GUI')
    % The web command window renders HTML and typesets LaTeX (KaTeX) itself,
    % so the raw markdown HTML is inserted directly; no MathJax pre-render.
    inserthtml(html);
    return
  end

  % Qt desktop: its rich-text terminal cannot run JavaScript, so LaTeX is
  % pre-rendered to SVG images through an offscreen MathJax webview.
  inserthtml(renderMarkdownHtml(html));
end
%=============================================================================
function renderedHtml = renderMarkdownHtml(html)
  if ~containsLatexMarkup(html)
    renderedHtml = html;
    return
  end


  [found, cached] = cachedRenderedHtml(html);
  if found
    renderedHtml = cached;
    return
  end

  template = buildRendererTemplate(html);
  try
    renderedHtml = __webview_render_html__(template);
  catch
    renderedHtml = html;
  end
  cachedRenderedHtml(html, renderedHtml);
end
%=============================================================================
function tf = containsLatexMarkup(html)
  tf = contains(html, '$') || contains(html, '\(') || contains(html, '\[');
end
%=============================================================================
function [found, renderedHtml] = cachedRenderedHtml(html, renderedHtmlToCache)
  persistent cacheKeys cacheValues
  if isempty(cacheKeys)
    cacheKeys = {};
    cacheValues = {};
  end

  found = false;
  renderedHtml = '';
  idx = find(strcmp(cacheKeys, html), 1);
  if nargin == 1
    if ~isempty(idx)
      found = true;
      renderedHtml = cacheValues{idx};
    end
    return
  end

  if ~isempty(idx)
    cacheValues{idx} = renderedHtmlToCache;
    return
  end
  cacheKeys{end + 1} = html;
  cacheValues{end + 1} = renderedHtmlToCache;
  if length(cacheKeys) > 64
    cacheKeys(1) = [];
    cacheValues(1) = [];
  end
end
%=============================================================================
function template = buildRendererTemplate(html)
  mathjax = loadMathJaxScript();
  template = ['<!DOCTYPE html>', newline(), ...
  '<html><head><meta charset="utf-8">', newline(), ...
  '<script>', newline(), ...
  'window.MathJax = {', newline(), ...
  '  tex: {inlineMath: [["$","$"], ["\\\\(","\\\\)"]], displayMath: [["$$","$$"], ["\\\\[","\\\\]"]]},', newline(), ...
  '  svg: {fontCache: "none"}', newline(), ...
  '};', newline(), ...
  'window.nelsonMarkdownReady = false;', newline(), ...
  '</script>', newline(), ...
  '<script>', newline(), ...
  mathjax, newline(), ...
  '</script>', newline(), ...
  '<script>', newline(), ...
  'function mathDimensionToPixels(value, scale) {', newline(), ...
  '  const match = String(value || "").match(/^([0-9.]+)([a-z]*)/i);', newline(), ...
  '  if (!match) { return 0; }', newline(), ...
  '  const number = Number(match[1]);', newline(), ...
  '  if (!Number.isFinite(number) || number <= 0) { return 0; }', newline(), ...
  '  const unit = match[2];', newline(), ...
  '  let pixels = number;', newline(), ...
  '  if (unit === "ex") { pixels = number * 8; }', newline(), ...
  '  else if (unit === "em") { pixels = number * 16; }', newline(), ...
  '  pixels = pixels * (scale || 1);', newline(), ...
  '  pixels = Math.max(1, Math.min(4096, Math.round(pixels)));', newline(), ...
  '  return pixels;', newline(), ...
  '}', newline(), ...
  'function replaceMathJaxSvg(root) {', newline(), ...
  '  root.querySelectorAll(''mjx-container[jax="SVG"]'').forEach(function(container) {', newline(), ...
  '    const svg = container.querySelector("svg");', newline(), ...
  '    if (!svg) { return; }', newline(), ...
  '    if (!svg.getAttribute("xmlns")) { svg.setAttribute("xmlns", "http://www.w3.org/2000/svg"); }', newline(), ...
  '    const displayMode = container.getAttribute("display") === "true";', newline(), ...
  '    const scale = displayMode ? 1.55 : 1.25;', newline(), ...
  '    const serialized = new XMLSerializer().serializeToString(svg);', newline(), ...
  '    const img = document.createElement("img");', newline(), ...
  '    img.setAttribute("src", "data:image/svg+xml;charset=utf-8," + encodeURIComponent(serialized));', newline(), ...
  '    img.setAttribute("alt", container.getAttribute("aria-label") || "");', newline(), ...
  '    const width = mathDimensionToPixels(svg.getAttribute("width"), scale);', newline(), ...
  '    const height = mathDimensionToPixels(svg.getAttribute("height"), scale);', newline(), ...
  '    if (width > 0) { img.setAttribute("width", String(width)); img.style.width = String(width) + "px"; }', newline(), ...
  '    if (height > 0) { img.setAttribute("height", String(height)); img.style.height = String(height) + "px"; }', newline(), ...
  '    img.style.maxWidth = "100%";', newline(), ...
  '    if (displayMode) {', newline(), ...
  '      img.style.display = "block";', newline(), ...
  '      img.style.margin = "0.75em 0";', newline(), ...
  '    } else {', newline(), ...
  '      img.style.verticalAlign = "-0.16em";', newline(), ...
  '    }', newline(), ...
  '    container.replaceWith(img);', newline(), ...
  '  });', newline(), ...
  '}', newline(), ...
  'window.addEventListener("load", function() {', newline(), ...
  '  const root = document.getElementById("nelson-markdowndisp-root");', newline(), ...
  '  const done = function() { replaceMathJaxSvg(root); window.nelsonMarkdownReady = true; };', newline(), ...
  '  if (window.MathJax && window.MathJax.typesetPromise) {', newline(), ...
  '    window.MathJax.typesetPromise([root]).then(done).catch(done);', newline(), ...
  '  } else {', newline(), ...
  '    done();', newline(), ...
  '  }', newline(), ...
  '});', newline(), ...
  '</script>', newline(), ...
  '</head><body><div id="nelson-markdowndisp-root">', newline(), ...
  html, newline(), ...
  '</div></body></html>'];
end
%=============================================================================
function script = loadMathJaxScript()
  persistent cachedScript
  if isempty(cachedScript)
    script = fileread([modulepath('help_tools'), '/resources/tex-svg.js']);
    script = strrep(script, '</script>', '<\/script>');
    cachedScript = script;
  else
    script = cachedScript;
  end
end
