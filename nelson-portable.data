%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% twister64 behaves like twister: the saved state alone fixes the sequence.
%=============================================================================
% state layout: the 312 most recent 64-bit words, oldest first
word = @(hi, lo) uint64(hi) * uint64(4294967296) + uint64(lo);
rng(7, 'twister64');
st = rng();
asserts.isequal(size(st.State), [312 1]);
asserts.isequal(class(st.State), 'uint64');
asserts.isequal(st.State([1 2 312])', [uint64(7), word(1782426941, 404126268), word(782214229, 1959931450)]);
asserts.isapprox(rand(1, 3), [0.75438530415285798 0.94930120289264419 0.11741428103451801], 2e-16);
%=============================================================================
% state saved in the middle of a 312-word block
rand(1, 400);
st = rng();
asserts.isequal(st.State([1 2 312])', [word(1850266453, 178321286), ...
    word(3868579187, 3323643826), word(705129874, 1938095262)]);
x = rand(1, 500);
rng(st);
asserts.isequal(rand(1, 500), x);
%=============================================================================
rng(0, 'twister64');
st = rng();
asserts.isequal(st.Seed, uint64(0));
asserts.isequal(st.State([1 312])', [uint64(5489), word(3327846748, 1168496534)]);
%=============================================================================
% randn keeps no value outside the state
rng(1, 'twister64');
randn(1, 1);
st = rng();
x = randn(1, 5);
rng(st);
asserts.isequal(randn(1, 5), x);
rng(1, 'twister64');
x = [randn(1, 1), randn(1, 1), randn(1, 1)];
rng(1, 'twister64');
asserts.isequal(randn(1, 3), x);
s = RandStream('twister64', 'Seed', 1);
x = [randn(s, 1, 1), randn(s, 1, 1)];
reset(s);
asserts.isequal(randn(s, 1, 2), x);
%=============================================================================
% standard normal moments
rng(3, 'twister64');
x = randn(1, 1e6);
asserts.istrue(abs(mean(x)) < 5e-3);
asserts.isapprox(std(x), 1, 5e-3);
asserts.isequal(class(randn(2, 'single')), 'single');
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
backup = rng();
%=============================================================================
rng('xoshiro');
s = rng();
assert_isequal(s.Type, 'xoshiro');
assert_isequal(s.Seed, uint32(0));
assert_isequal(class(s.State), 'uint64');
assert_isequal(size(s.State), [6 1]);
% 256-bit state expanded from seed 0 by SplitMix64, full precision, empty cache.
HI = uint64([3793791033 1853398634 113532184 4169906344]');
LO = uint64([2065550767 2713282036 2148091215 1917616620]');
REF = [bitshift(HI, 32) + LO; uint64(0); uint64(0)];
assert_isequal(s.State, REF);
%=============================================================================
rng(0, 'xoshiro256pp');
s = rng();
assert_isequal(s.Type, 'xoshiro');
rng('default');
rng('xoshiro256pp');
s = rng();
assert_isequal(s.Type, 'xoshiro');
lst = rng('enginelist');
assert_istrue(any(strcmp(lst, 'xoshiro')));
%=============================================================================
% 53 random bits of each 64-bit xoshiro256++ output.
rng(0, 'xoshiro');
R = rand(1, 4);
REF = [0.32457526803140668 0.38223929651167343 0.35961720764735527 0.011455508934653635];
assert_isequal(R, REF);
rng(42, 'xoshiro');
R = rand(2, 2);
REF = [0.81430514512290986 0.98389416817748876; 0.31882104006166112 0.70113559813475557];
assert_isequal(R, REF);
%=============================================================================
% reproducibility and state save / restore
rng(7, 'xoshiro');
A = rand(3, 5);
rng(7, 'xoshiro');
B = rand(3, 5);
assert_isequal(A, B);
s = rng();
A = [rand(1, 5), randn(1, 5), randi(10, 1, 5)];
rng(s);
B = [rand(1, 5), randn(1, 5), randi(10, 1, 5)];
assert_isequal(A, B);
C = rand(1, 5);
assert_isfalse(isequal(C, A(1:5)));
%=============================================================================
% uniform values in (0, 1), normal values by inversion of the uniforms
rng(3, 'xoshiro');
U = rand(1, 10000);
assert_istrue(all(U > 0 & U < 1));
assert_istrue(abs(mean(U) - 0.5) < 0.02);
rng(3, 'xoshiro');
Z = randn(1, 10000);
assert_isapprox(Z, norminv(U), 1e-12);
assert_istrue(abs(mean(Z)) < 0.05);
assert_istrue(abs(std(Z) - 1) < 0.05);
Z = randn(2, 3, 'like', 1i);
assert_isfalse(isreal(Z));
assert_isequal(size(Z), [2 3]);
%=============================================================================
X = rand(100, 10, 'single');
assert_isequal(class(X), 'single');
assert_istrue(all(X(:) > 0 & X(:) < 1));
X = randn(3, 'single');
assert_isequal(class(X), 'single');
%=============================================================================
R = randi([-3 4], 1, 2000);
assert_istrue(all(R >= -3 & R <= 4));
assert_isequal(unique(R), -3:4);
P = randperm(20);
assert_isequal(sort(P), 1:20);
P = randperm(100, 3);
assert_isequal(numel(unique(P)), 3);
