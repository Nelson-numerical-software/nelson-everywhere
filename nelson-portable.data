%=============================================================================
function j = juliandate(t)
  narginchk(1, 1);
  if ~isa(t, 'datetime')
    error('Nelson:time:datetimeInputExpected', '%s expected.', 'Datetime input');
  end
  if isempty(t.TimeZone)
    j = datenum(t) + 1721058.5;
  else
    % a zoned datetime counts its UTC instant
    j = posixtime(t) ./ 86400 + 2440587.5;
  end
end
