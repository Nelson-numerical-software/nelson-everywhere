  0.6555 0.0318 0.0971;
  0.1712 0.2769 0.8235];
asserts.isapprox(R2, ref, 1e-4);
asserts.isequal(R1, R2);
%=============================================================================
rng('default')
rng(5489)
R2 = rand(3, 3);
ref = [0.8147 0.9134 0.2785;
  0.9058 0.6324 0.5469;
  0.1270 0.0975 0.9575];
asserts.isapprox(R2, ref, 1e-4);
%=============================================================================
R = rand([0 0]);
REF = [];
asserts.isequal(R, REF);
%=============================================================================
R = rand([0 3]);
REF = zeros(0, 3);
asserts.isequal(R, REF);
%=============================================================================
savedRandomState = rng();
rng('default');
randomValues = rand(2, 3);
asserts.isequal(size(randomValues), [2 3]);
asserts.istrue(all(randomValues(:) >= 0));
asserts.istrue(all(randomValues(:) <= 1));
rng(savedRandomState);
