% LICENCE_BLOCK_END
function mode = discover_executionMode(options)
  if options.gui_mode
    mode = 'gui';
  elseif options.adv_cli_mode
    mode = 'adv_cli';
  else
    mode = 'cli';
  end
end
﻿%=============================================================================
