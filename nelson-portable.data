% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function R = randomSparse(generator, varargin)
  if nargin == 2
    R = randomSparseLike(generator, varargin{1});
  elseif nargin == 4
    R = randomSparseWithDensity(generator, varargin{1}, varargin{2}, varargin{3});
  else
    error('Nelson:sparse:invalidNumberInputArguments2', 'Invalid number of input arguments.');
  end
end
%=============================================================================
function R = randomSparseWithDensity(generator, mInput, nInput, densityInput)
  rowCount = double(mInput);
  columnCount = double(nInput);
  density = min(double(densityInput), 1);
  requestedCount = round(rowCount * columnCount * density);
  if requestedCount == 0
    R = sparse([], [], [], rowCount, columnCount);
    return
  end

  rowIndex = randi(rowCount, requestedCount, 1);
  columnIndex = randi(columnCount, requestedCount, 1);
  uniquePairs = unique([rowIndex columnIndex], 'rows');
  rowIndex = uniquePairs(:, 1);
  columnIndex = uniquePairs(:, 2);
  R = sparse(rowIndex, columnIndex, generator(length(rowIndex), 1), rowCount, columnCount);
end
%=============================================================================
function R = randomSparseLike(generator, S)
  if ~ismatrix(S)
    error('Nelson:randomSparse:invalidInput', 'Input must be a matrix.');
  end
  rowCount = size(S, 1);
  columnCount = size(S, 2);
  [rowIndex, columnIndex] = find(S); %#ok<NLS0004>
  R = sparse(rowIndex, columnIndex, generator(numel(rowIndex), 1), rowCount, columnCount);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function S = spaugment(varargin)
  narginchk(1, 2);
  nargoutchk(0, 1);

  A = varargin{1};
  if ((~isnumeric(A) && ~islogical(A)) || ndims(A) ~= 2)
    error('Nelson:types:numericOrLogical2DExpected', 'A numeric or logical 2-D matrix expected.');
  end
  if (isempty(A))
    error('Nelson:spaugment:emptyMatrix', 'A must be a non-empty matrix.');
  end

  if (nargin == 2)
    c = varargin{2};
    if ((~isnumeric(c) && ~islogical(c) && ~ischar(c)) || isempty(c))
      error('Nelson:spaugment:invalidC', 'C must be a non-empty numeric, logical, or character array.');
    end
    if (ndims(c) ~= 2)
      error('Nelson:spaugment:cMustBe2D', 'C must be a 2-D array.');
    end
    c = double(c(1));
  else
    c = max(max(abs(A))) / 1000;
  end

  [m, n] = size(A);
  if (c == 0)
    C = sparse(m, m);
  else
    C = sparse(1:m, 1:m, c * ones(m, 1), m, m);
  end
  S = [C, sparse(A); sparse(A'), sparse(n, n)];
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function sp = speye(varargin)
  if (nargin == 0)
    m = 1;
    n = 1;
  elseif (nargin == 1)
    arg = varargin{1};
    if isscalar(arg)
      m = arg;
      n = m;
    elseif isvector(arg)
      len = length(arg);
      if (len == 2)
        m = arg(1);
        n = arg(2);
      else
        error('Nelson:speye:InvalidInputFormat', 'Please use speye(n), speye(m, n) or speye([m, n]).');
      end
    else
      error('Nelson:speye:InvalidInputFormat', 'Please use speye(n), speye(m, n) or speye([m, n]).');
    end
  elseif (nargin == 2)
    m = varargin{1};
    n = varargin{2};
    if ~isscalar(m) || ~isscalar(n)
      error('Nelson:speye:InvalidInputFormat', 'Please use speye(n), speye(m, n) or speye([m, n]).');
    end
  else
    error('Nelson:speye:wrongNumberOutputArguments2', 'Wrong number of output arguments.');
  end
  if (m < 0)
    m = 0;
  end
  if (n < 0)
    n = 0;
  end
  mn = min([m, n]);
  idx = 1:mn;
  sp = sparse(idx, idx, ones(mn, 1), m, n);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function s = spfun(fun, S)
  narginchk(2, 2);
  if ~isa(fun, 'function_handle')
    error('Nelson:spfun:functionHandleExpected', 'First argument must be a function handle.');
  end
  if ~ismatrix(S)
    error('Nelson:sparse:ndSparseNotSupported', 'ND-sparse arrays are not supported.');
  end
  sparseInput = S;
  if ~issparse(S)
    sparseInput = sparse(S);
  end
  rowCount = size(sparseInput, 1);
  columnCount = size(sparseInput, 2);
  [rowIndex, columnIndex, nonzeroValues] = find(sparseInput); %#ok<NLS0004>
  if isempty(nonzeroValues)
    s = sparse([], [], [], rowCount, columnCount);
  else
    s = sparse(rowIndex, columnIndex, fun(nonzeroValues(:)), rowCount, columnCount);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function s = spones(S)
  narginchk(1, 1);

  if ~ismatrix(S)
    error('Nelson:sparse:ndSparseNotSupported', 'ND-sparse arrays are not supported.');
  end
  if isa(S, 'single')
    oneValue = single(1);
  else
    oneValue = 1;
  end
  if ~issparse(S)
    if isa(S, 'single')
      s = sparse(single(S ~= 0));
    else
      s = sparse(double(S ~= 0));
    end
  else
    [I, J] = find(S);
    [m, n] = size(S);
    s = sparse(I, J, oneValue, m, n);
  end
end
%=============================================================================
%=============================================================================
