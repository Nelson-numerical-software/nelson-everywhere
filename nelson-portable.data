%=============================================================================
function [gx, gy, gz] = volumeGradient(V, x, y, z)
  gx = derivativeAlongDimension(V, x, 2);
  gy = derivativeAlongDimension(V, y, 1);
  gz = derivativeAlongDimension(V, z, 3);
end
%=============================================================================
function d = derivativeAlongDimension(V, coordinates, dim)
  d = zeros(size(V));
  n = size(V, dim);
  for k = 1:n
    [first, second] = derivativeStencil(k, n);
    d = assignDerivativeSlice(d, V, coordinates, dim, k, first, second);
  end
end
%=============================================================================
function [first, second] = derivativeStencil(k, n)
  if k == 1
    first = 1;
    second = 2;
  elseif k == n
    first = n - 1;
    second = n;
  else
    first = k - 1;
    second = k + 1;
  end
end
%=============================================================================
function d = assignDerivativeSlice(d, V, coordinates, dim, k, first, second)
  target = repmat({':'}, 1, ndims(V));
  lower = target;
  upper = target;
  if dim == 1
    target{1} = k;
    lower{1} = first;
    upper{1} = second;
  elseif dim == 2
    target{2} = k;
    lower{2} = first;
    upper{2} = second;
  else
    target{3} = k;
    lower{3} = first;
    upper{3} = second;
  end
  denominator = coordinates(second) - coordinates(first);
  d(target{:}) = (V(upper{:}) - V(lower{:})) / denominator;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [x, y, z] = volumeGridVectors(X, Y, Z, V)
  if nargin == 1
    V = X;
    x = 1:size(V, 2);
    y = 1:size(V, 1);
    z = 1:size(V, 3);
    return
  end
  if isvector(X) && isvector(Y) && isvector(Z)
    x = double(X(:).');
    y = double(Y(:).');
    z = double(Z(:).');
    return
  end
  if ~isequal(size(X), size(Y)) || ~isequal(size(X), size(Z)) || ~isequal(size(X), size(V))
    error('Nelson:volumeGridVectors:invalidGridArrays', 'Grid arrays must have the same size as V.');
  end
  x = double(squeeze(X(1, :, 1))).';
  y = double(squeeze(Y(:, 1, 1))).';
  z = double(squeeze(Z(1, 1, :))).';
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function handles = volumeSliceSurfaces(parent, x, y, z, V, xs, ys, zs, method, surfaceArgs)
  if ~areAxisSlices(xs, ys, zs)
    C = interp3(x, y, z, V, xs, ys, zs, method, NaN);
    handles = surface(parent, xs, ys, zs, C, surfaceArgs{:});
    return
  end
  handles = gobjects(0, 1);
  for k = 1:numel(xs)
    [Xq, Yq, Zq] = xSliceGrid(x, y, z, xs(k));
    C = interp3(x, y, z, V, Xq, Yq, Zq, method, NaN);
    handles(end + 1, 1) = surface(parent, Xq, Yq, Zq, C, surfaceArgs{:});
  end
  for k = 1:numel(ys)
    [Xq, Yq, Zq] = ySliceGrid(x, y, z, ys(k));
    C = interp3(x, y, z, V, Xq, Yq, Zq, method, NaN);
    handles(end + 1, 1) = surface(parent, Xq, Yq, Zq, C, surfaceArgs{:});
  end
  for k = 1:numel(zs)
    [Xq, Yq, Zq] = zSliceGrid(x, y, z, zs(k));
    C = interp3(x, y, z, V, Xq, Yq, Zq, method, NaN);
    handles(end + 1, 1) = surface(parent, Xq, Yq, Zq, C, surfaceArgs{:});
  end
end
%=============================================================================
function [Xq, Yq, Zq] = xSliceGrid(x, y, z, value)
  [Yq, Zq] = ndgrid(y, z);
  Xq = value * ones(size(Yq));
end
%=============================================================================
function [Xq, Yq, Zq] = ySliceGrid(x, y, z, value)
  [Xq, Zq] = ndgrid(x, z);
  Yq = value * ones(size(Xq));
end
%=============================================================================
function [Xq, Yq, Zq] = zSliceGrid(x, y, z, value)
  [Xq, Yq] = meshgrid(x, y);
  Zq = value * ones(size(Xq));
end
%=============================================================================
function tf = areAxisSlices(xs, ys, zs)
  tf = min(size(xs)) <= 1 && min(size(ys)) <= 1 && min(size(zs)) <= 1;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function warnContourNotRendered(Z)
  % A surface with no relief carries no contour line to draw. The two ways that
  % happens do not read alike and each keeps its own warning: data whose finite
  % values are all equal is constant, data holding no finite value at all is
  % not. Only the plotting functions warn; contourc is silent.
  finiteZ = Z(isfinite(Z));
  if isempty(finiteZ)
    warning('Nelson:contour:nonFiniteData', 'Contour not rendered for non-finite ZData.');
  elseif min(finiteZ(:)) == max(finiteZ(:))
    warning('Nelson:contour:constantData', 'Contour not rendered for constant ZData.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = quiver(varargin)
  narginchk(2, 10000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [parent, args] = parseQuiverParent(args);
  [x, y, u, v, args, autoXY] = parseQuiverData(args);
  [scaleArgs, lineArgs, propertyPairs] = parseQuiverTail(args);
  keepBox = quiverKeepBox(parent);
  ax = targetAxes(parent);
  if ~keepBox
    ax.Box = 'on';
  end
  constructorArgs = {'Parent', parentForObject(parent, ax), 'XData', x, 'YData', y, ...
    'UData', u, 'VData', v, 'XDataMode', autoMode(autoXY), 'YDataMode', autoMode(autoXY)};
  constructorArgs = [constructorArgs, scaleArgs, lineArgs];
  if isempty(lineColor(lineArgs)) && ~hasProperty(propertyPairs, 'Color')
    color = getColorAndUpdateIndex(ax);
    constructorArgs = [constructorArgs, {'Color', color}];
  end
  h = __quiver__(constructorArgs{:}, propertyPairs{:});
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [parent, args] = parseQuiverParent(args)
  if ~isempty(args) && isscalar(args{1}) && (isgraphics(args{1}, 'axes') || isgraphics(args{1}, 'hggroup'))
    parent = args{1};
    args = args(2:end);
  else
    [parent, args] = graphicsExtractParentProperty(args);
  end
end
%=============================================================================
function keepBox = quiverKeepBox(parent)
  keepBox = false;
  if isempty(parent)
    fig = groot().CurrentFigure;
    if ~isempty(fig) && ~isempty(fig.CurrentAxes)
      keepBox = strcmp(fig.CurrentAxes.NextPlot, 'add');
    end
  elseif isgraphics(parent, 'axes')
    keepBox = strcmp(parent.NextPlot, 'add');
  elseif isgraphics(parent, 'hggroup')
    ax = ancestor(parent, 'axes');
    keepBox = strcmp(ax.NextPlot, 'add');
  end
end
%=============================================================================
function [x, y, u, v, args, autoXY] = parseQuiverData(args)
  firstTail = firstTailArgument(args);
  if firstTail >= 5
    x = args{1};
    y = args{2};
    u = args{3};
    v = args{4};
    args = args(5:end);
    autoXY = false;
  elseif firstTail >= 3
    u = args{1};
    v = args{2};
    [x, y] = defaultGrid(u);
    args = args(3:end);
    autoXY = true;
  else
    error('Nelson:notEnoughInputs', 'Not enough input arguments.');
  end
  validateQuiverData(x, y, u, v);
end
%=============================================================================
function index = firstTailArgument(args)
  index = length(args) + 1;
  for k = 1:length(args)
    if ~(isnumeric(args{k}) || islogical(args{k}))
      index = k;
      return
    end
  end
end
%=============================================================================
function [x, y] = defaultGrid(u)
  x = 1:size(u, 2);
  y = 1:size(u, 1);
end
%=============================================================================
function validateQuiverData(x, y, u, v)
  values = {x, y, u, v};
  for k = 1:numel(values)
    if ~((isnumeric(values{k}) || islogical(values{k})) && isreal(values{k}))
      error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Value');
    end
  end
  if ~isequal(size(u), size(v))
    error('Nelson:dimagree:vectorComponentSizesMatch', 'Vector component sizes must match.');
  end
  validateCoordinateSize(x, size(u), 'X');
  validateCoordinateSize(y, size(u), 'Y');
end
%=============================================================================
function validateCoordinateSize(value, targetSize, name)
  if isscalar(value) || isequal(size(value), targetSize)
    return
  end
  if isvector(value) && (numel(value) == targetSize(1) || numel(value) == targetSize(2) || numel(value) == prod(targetSize))
    return
  end
  error('Nelson:graphics:componentDataSizeMismatch', '%s must match vector component size.', name);
end
%=============================================================================
function [scaleArgs, lineArgs, propertyPairs] = parseQuiverTail(args)
  scaleArgs = {};
  if ~isempty(args) && isnumeric(args{1}) && isscalar(args{1})
    scale = double(args{1});
    if scale == 0
      scaleArgs = {'AutoScale', 'off'};
    else
      scaleArgs = {'AutoScale', 'on', 'AutoScaleFactor', scale};
    end
    args = args(2:end);
  end
  lineArgs = parseLineSpec(args);
  if ~isempty(lineArgs)
    args = args(2:end);
  end
  if mod(length(args), 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  propertyPairs = args;
end
%=============================================================================
function lineArgs = parseLineSpec(args)
  lineArgs = {};
  if isempty(args) || ~isTextScalar(args{1}) || isValidGraphicsProperty('quiver', args{1})
    return
  end
  [lineStyle, colorSpec, markerSpec, msg] = colstyle(convertStringsToChars(args{1}), 'plot');
  if ~isempty(msg)
    error('Nelson:quiver:invalidLineSpec', msg);
  end
  if ~isempty(lineStyle)
    lineArgs = [lineArgs, {'LineStyle', lineStyle}];
  end
  if ~isempty(colorSpec)
    lineArgs = [lineArgs, {'Color', colorSpec}];
  end
  if ~isempty(markerSpec)
    lineArgs = [lineArgs, {'Marker', markerSpec}];
  end
end
%=============================================================================
function tf = isTextScalar(value)
  tf = ischar(value) || isStringScalar(value);
end
%=============================================================================
function value = autoMode(tf)
  if tf
    value = 'auto';
  else
    value = 'manual';
  end
end
%=============================================================================
function ax = targetAxes(parent)
  if isempty(parent)
    ax = newplot();
  elseif isgraphics(parent, 'hggroup')
    ax = ancestor(parent, 'axes');
  else
    ax = newplot(parent);
  end
end
%=============================================================================
function parent = parentForObject(parent, ax)
  if isempty(parent)
    parent = ax;
  end
end
%=============================================================================
function tf = hasProperty(args, name)
  tf = false;
  for k = 1:2:length(args)
    if isTextScalar(args{k}) && strcmpi(convertStringsToChars(args{k}), name)
      tf = true;
      return
    end
  end
end
%=============================================================================
function value = lineColor(args)
  value = [];
  for k = 1:2:length(args)
    if strcmp(args{k}, 'Color')
      value = args{k + 1};
      return
    end
  end
end
