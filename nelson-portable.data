% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function rotate3d(varargin)
  % rotate3d option
  % rotate3d
  % rotate3d(fig, ...)
  % rotate3d(ax, ...)

  narginchk(0, 2);
  if (nargin == 0)
    ax = gca();
    option = 'toggle';
    optionPosition = 1;
  else
    optionPosition = 1;
    if (isgraphics(varargin{1}, 'axes'))
      ax = varargin{1};
      option = varargin{2};
      optionPosition = 2;
    elseif (isgraphics(varargin{1}, 'figure'))
      fig = varargin{1};
      ax = fig.CurrentAxes;
      option = varargin{2};
      optionPosition = 2;
    else
      ax = gca();
      option = varargin{1};
      optionPosition = 1;
    end
  end
  if ((ischar(option) && isrow(option)) || isStringScalar(option))
    option = convertStringsToChars(option);
    mustBeMember(tolower(option), {'on', 'off', 'toggle'}, optionPosition);
    __rotate3d__(ax, option);
  else
    error('Nelson:graphics:wrongTypeForInput', 'Wrong type for input arguments.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = rticklabels(varargin)
  narginchk(0, 2);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [ax, args] = polarAxesForFunction(args);
  state = polarGetState(ax, isempty(args));
  if isempty(args)
    varargout{1} = state.RTickLabel;
    return
  end
  value = args{1};
  if ischar(value) && any(strcmp(lower(value), {'auto', 'manual', 'mode'}))
    switch lower(value)
      case 'mode'
        varargout{1} = state.RTickLabelMode;
        return
      case 'auto'
        state.RTickLabelMode = 'auto';
      case 'manual'
        state.RTickLabelMode = 'manual';
    end
  else
    state.RTickLabel = polarNormalizeLabels(value);
    state.RTickLabelMode = 'manual';
  end
  if nargout == 1
    error('Nelson:graphics:invalidOutputArgument', 'Invalid output argument.');
  end
  polarSetStateAndRefresh(ax, state);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
