%=============================================================================
function c = calmonths(x)
  narginchk(1, 1);
  if isa(x, 'calendarDuration')
    c = calendarDuration.rawMonths(x);
  else
    c = calendarDuration(0, double(x), 0);
  end
end
%=============================================================================
