function dy = odeVectorizedPatternRhs(t, y)
  global ODE_VECTORIZED_PATTERN_COLUMNS;
  if isempty(ODE_VECTORIZED_PATTERN_COLUMNS)
    ODE_VECTORIZED_PATTERN_COLUMNS = [];
  end
  ODE_VECTORIZED_PATTERN_COLUMNS(end + 1) = size(y, 2);
  dy = zeros(size(y));
  dy(1, :) = -100 * y(1, :);
  dy(2, :) = -100 * y(2, :);
end
