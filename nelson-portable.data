%=============================================================================
function [T, rowTimes, props] = eventtableDataTable(E)
  st = struct(E);
  props = st.Properties;
  timeName = 'Time';
  if isfield(props, 'CustomProperties') && isfield(props.CustomProperties, 'EventTimeVariable')
    timeName = props.CustomProperties.EventTimeVariable;
  end
  rowTimes = st.data.(timeName);
  names = st.Properties.VariableNames;
  dataArgs = {};
  dataNames = {};
  keep = [];
  for k = 1:length(names)
    if ~strcmp(names{k}, timeName)
      dataArgs{end + 1} = st.data.(names{k});
      dataNames{end + 1} = names{k};
      keep(end + 1) = k;
    end
  end
  T = table(dataArgs{:}, 'VariableNames', dataNames);
  if isfield(st.Properties, 'VariableUnits') && length(st.Properties.VariableUnits) == length(names)
    T.Properties.VariableUnits = st.Properties.VariableUnits(keep);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function E = eventtableFromDataTable(T, rowTimes, props)
  names = T.Properties.VariableNames;
  args = cell(1, length(names));
  for k = 1:length(names)
    args{k} = T.(names{k});
  end
  TT = timetable(rowTimes, args{:}, 'VariableNames', names);
  E = eventtable(TT);
  outProps = E.Properties;
  if isfield(props, 'CustomProperties')
    outProps.CustomProperties = props.CustomProperties;
    outProps.CustomProperties.EventTimeVariable = 'Time';
    outProps.CustomProperties.EventLabelsVariable = keepEventName(outProps.CustomProperties, 'EventLabelsVariable', names);
    outProps.CustomProperties.EventLengthsVariable = keepEventName(outProps.CustomProperties, 'EventLengthsVariable', names);
    outProps.CustomProperties.EventEndsVariable = keepEventName(outProps.CustomProperties, 'EventEndsVariable', names);
  end
  if ~isempty(T.Properties.VariableUnits)
    outProps.VariableUnits = [{''}, T.Properties.VariableUnits];
  end
  E.Properties = outProps;
end
%=============================================================================
function name = keepEventName(customProps, fieldName, names)
  name = '';
  if isfield(customProps, fieldName)
    candidate = customProps.(fieldName);
    if any(strcmp(names, candidate))
      name = candidate;
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function R = eventtableMathBinary(A, B, fun)
  [TA, rowTimes, props] = eventtableDataTable(A);
  if isa(B, 'eventtable')
    eventtableValidateMetadata(A, B);
    [TB, ~] = eventtableDataTable(B);
    T = table.applyBinary(TA, TB, fun);
  else
    T = table.applyBinary(TA, B, fun);
  end
  R = eventtableFromDataTable(T, rowTimes, props);
end
%=============================================================================
function eventtableValidateMetadata(A, B)
  fields = {'EventLabelsVariable', 'EventLengthsVariable', 'EventEndsVariable'};
  for k = 1:length(fields)
    a = eventtableCustomProperty(A, fields{k});
    b = eventtableCustomProperty(B, fields{k});
    if ~strcmp(a, b)
      error('Nelson:eventtable:metadataMismatch', 'Event table metadata variables must match.');
    end
  end
end
%=============================================================================
function value = eventtableCustomProperty(E, name)
  value = '';
  props = E.Properties;
  if isfield(props, 'CustomProperties') && isfield(props.CustomProperties, name)
    value = props.CustomProperties.(name);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function R = eventtableMathMap(A, fun, functionName, varargin)
  [T, rowTimes, props] = eventtableDataTable(A);
  T = table.applyMapWithArgs(T, fun, functionName, varargin{:});
  if height(T) == height(A)
    R = eventtableFromDataTable(T, rowTimes, props);
  else
    R = T;
  end
end
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function R = eventtableMathReduce(A, fun, functionName, varargin)
  [T, rowTimes, props] = eventtableDataTable(A);
  T = table.applyReduce(T, fun, functionName, varargin{:});
  if ~isempty(varargin) && isnumeric(varargin{1}) && isscalar(varargin{1}) && varargin{1} == 2
    R = eventtableFromDataTable(T, rowTimes, props);
  else
    R = T;
  end
end
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function R = eventtableMathUnary(A, fun, functionName)
  [T, rowTimes, props] = eventtableDataTable(A);
  T = table.applyUnary(T, fun, functionName);
  R = eventtableFromDataTable(T, rowTimes, props);
end
