%=============================================================================
% nflow_blocks ships the C++ block library (nlsNflow_blocks), the declarative
% block libraries, and the acausal/planar palette macros (catalog, diagram
% lowering, and the palette manifest/help/icon generators). It exposes no
% gateway; the macros live in functions/.
addpath(modulepath('nflow_blocks', 'functions'), '-frozen');
%=============================================================================
%=============================================================================
