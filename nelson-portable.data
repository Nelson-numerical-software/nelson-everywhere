function z = realpow(x, y)
  narginchk(2, 2);
  nargoutchk(0, 1);

  if ~isreal(x) || ~isreal(y)
    error('Nelson:validators:mustBeReal', '%s must be real.', 'Inputs');
  end

  z = x .^ y;
  if ~isreal(z)
    error('Nelson:validators:mustBeReal', '%s must be real.', 'Result');
  end
end
