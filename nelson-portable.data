%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function r = sind(x)
  if isreal(x)
    r = sindReal(x);
  else
    r = sindComplex(x);
  end
end
%=============================================================================
function r = sindReal(x)
  x = mod(real(x) - 180, 360) - 180;
  r = sin(x / 180 * pi);
  r(x == -180) = 0;
end
%=============================================================================
function r = sindComplex(x)
  ix = imag(x);
  x = mod(real(x) - 180, 360) - 180;
  r = sin(complex(x, ix) / 180 * pi);
  r(x == -180) = complex(0, imag(r(x == -180)));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = sinpi(varargin)
  narginchk(1, 1);
  nargoutchk(0, 1);
  x = varargin{1};
  x = mod(x - 1, 2) - 1;
  x(x == -1) = 0;
  y = sin(x * pi);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = sph2cart(varargin)
  narginchk(3, 3);
  nargoutchk(0, 3);
  azimut = varargin{1};
  elevation = varargin{2};
  radius = varargin{3};

  z = radius .* sin(elevation);
  radiuscoselevation = radius .* cos(elevation);
  x = radiuscoselevation .* cos(azimut);
  y = radiuscoselevation .* sin(azimut);

  if nargout > 0
    varargout{1} = x;
  end
  if nargout > 1
    varargout{2} = y;
  end
  if (nargout > 2)
    varargout{3} = z;
  end
end
%=============================================================================


%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function r = tand(x)
  % sind and cosd perform an exact reduction on degrees:
  % zeros and infinities (with the right sign) come out exactly.
  r = sind(x) ./ cosd(x);
  if isreal(x)
    % multiples of 45 degrees are exactly +/-1
    q = mod(x, 180);
    r(q == 45) = 1;
    r(q == 135) = -1;
  end
end
