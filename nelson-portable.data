function n = report_countErrors(cases)
  n = 0;
  for k = 1:length(cases)
    n = n + report_isErrorStatus(cases(k));
  end
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function n = report_countOutcome(cases, status)
  n = 0;
  for k = 1:length(cases)
    n = n + strcmp(report_caseOutcome(cases(k)), status);
  end
end
