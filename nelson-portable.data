%=============================================================================
function method = validateSmooth3Method(method)
  if ~ischar(method)
    error('Nelson:validateSmooth3Method:invalidSmoothingMethod', 'Smoothing method must be ''box'' or ''gaussian''.');
  end
  method = lower(method);
  if ~any(strcmp(method, {'box', 'gaussian'}))
    error('Nelson:validateSmooth3Method:invalidSmoothingMethod', 'Smoothing method must be ''box'' or ''gaussian''.');
  end
end
%=============================================================================
