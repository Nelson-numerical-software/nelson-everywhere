%=============================================================================
function map = white(varargin)
  narginchk(0, 1);
  if nargin < 1
    R = groot();
    f = R.CurrentFigure;
    if isempty(f)
      m = size(R.DefaultFigureColormap, 1);
    else
      m = size(f.Colormap, 1);
    end
  else
    m = varargin{1};
  end
  map = ones(m, 3);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = winter(varargin)
  nargoutchk(0, 1);
  narginchk(0, 1);
  if nargin < 1
    R = groot();
    f = R.CurrentFigure;
    if isempty(f)
      n = size(R.DefaultFigureColormap, 1);
    else
      n = size(f.Colormap, 1);
    end
  else
    n = varargin{1};
  end

  if (n == 1)
    varargout{1} = [0, 0, 1];
  else
    if (n <= 0)
      varargout{1} = zeros(0, 3);
    else
      r = (0:n - 1)' / max(n - 1, 1);
      varargout{1} = [zeros(n, 1), r, 0.5 + (1 - r) / 2];
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
