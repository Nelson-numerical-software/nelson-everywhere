%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = binscatter(varargin)
  narginchk(2, 1000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [parent, args] = parseParent(args);
  constructorArgs = parseBinscatterArguments(parent, args);
  h = __binscatter__(constructorArgs{:});
  updateBinscatterAxes(h);
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [parent, args] = parseParent(args)
  if ~isempty(args) && isscalar(args{1}) && (isgraphics(args{1}, 'axes') || isgraphics(args{1}, 'hggroup'))
    designatedParent = args{1}(1);
    args = args(2:end);
  else
    % Pull the pair out: the parent is handed to the constructor on its own,
    % and 'Parent' is not one of the binscatter properties validated below.
    [designatedParent, args] = graphicsExtractParentProperty(args);
  end
  % The bins are drawn in an axes, so a group designated as target is resolved
  % to the axes holding it, and that axes is the one to start anew.
  if isgraphics(designatedParent, 'hggroup')
    designatedParent = ancestor(designatedParent, 'axes');
  end
  parent = newplotTarget(designatedParent);
end
%=============================================================================
function constructorArgs = parseBinscatterArguments(parent, args)
  if numel(args) < 2 || ~isRealNumericOrLogical(args{1}) || ~isRealNumericOrLogical(args{2})
    error('Nelson:binscatter:numericXAndExpected', 'Numeric X and Y data expected.');
  end
  x = double(args{1}(:).');
  y = double(args{2}(:).');
  if numel(x) ~= numel(y)
    error('Nelson:dimagree:valueValueNumberElements', '%s and %s must have the same number of elements.', 'X', 'Y');
  end
  args = args(3:end);
  constructorArgs = {'Parent', parent, 'XData', x, 'YData', y};
  flags = struct('NumBins', false, 'NumBinsMode', false, ...
    'XLimits', false, 'XLimitsMode', false, 'YLimits', false, 'YLimitsMode', false);
  if ~isempty(args) && isnumeric(args{1}) && ~isPropertyName(args{1})
    constructorArgs = [constructorArgs, {'NumBins', validateNumBins(args{1})}];
    flags.NumBins = true;
    args = args(2:end);
  end
  if mod(length(args), 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  for k = 1:2:length(args)
    name = canonicalPropertyName(args{k});
    value = args{k + 1};
    [value, flags] = validatePropertyValue(name, value, flags);
    constructorArgs = [constructorArgs, {name, value}];
  end
  validateModeConsistency(flags, constructorArgs);
end
%=============================================================================
function tf = isRealNumericOrLogical(value)
  tf = (isnumeric(value) || islogical(value)) && isreal(value);
end
%=============================================================================
function n = validateNumBins(value)
  if ~isnumeric(value) || ~isreal(value) || ~(isscalar(value) || numel(value) == 2)
    error('Nelson:graphics:invalidNumBins', 'NumBins must be a positive scalar or two-element vector.');
  end
  n = double(value(:).');
  if any(~isfinite(n)) || any(n < 1) || any(floor(n) ~= n)
    error('Nelson:graphics:invalidNumBins', 'NumBins must be a positive scalar or two-element vector.');
  end
  if isscalar(n)
    n = [n n];
  end
end
%=============================================================================
function limits = validateLimits(value, name)
  if ~isnumeric(value) || ~isreal(value) || numel(value) ~= 2
    error('Nelson:graphics:mustBeTwoElementVector', '%s must be a two-element increasing finite vector.', name);
  end
  limits = double(value(:).');
  if any(~isfinite(limits)) || limits(1) >= limits(2)
    error('Nelson:graphics:mustBeTwoElementVector', '%s must be a two-element increasing finite vector.', name);
  end
end
%=============================================================================
function mode = validateMode(value, name)
  if ~(ischar(value) || isStringScalar(value))
    error('Nelson:binscatter:invalidValue', '%s must be ''auto'' or ''manual''.', name);
  end
  mode = lower(char(value));
  if ~strcmp(mode, 'auto') && ~strcmp(mode, 'manual')
    error('Nelson:binscatter:invalidValue', '%s must be ''auto'' or ''manual''.', name);
  end
end
%=============================================================================
function [value, flags] = validatePropertyValue(name, value, flags)
  switch name
    case 'NumBins'
      value = validateNumBins(value);
      flags.NumBins = true;
    case 'NumBinsMode'
      value = validateMode(value, name);
      flags.NumBinsMode = true;
    case 'XLimits'
      value = validateLimits(value, name);
      flags.XLimits = true;
    case 'XLimitsMode'
      value = validateMode(value, name);
      flags.XLimitsMode = true;
    case 'YLimits'
      value = validateLimits(value, name);
      flags.YLimits = true;
    case 'YLimitsMode'
      value = validateMode(value, name);
      flags.YLimitsMode = true;
  end
end
%=============================================================================
function validateModeConsistency(flags, constructorArgs)
  numBinsMode = propertyValue(constructorArgs, 'NumBinsMode', '');
  xLimitsMode = propertyValue(constructorArgs, 'XLimitsMode', '');
  yLimitsMode = propertyValue(constructorArgs, 'YLimitsMode', '');
  if flags.NumBins && strcmp(numBinsMode, 'auto')
    error('Nelson:binscatter:numBinsCannotBeSpecified', 'NumBins cannot be specified when NumBinsMode is ''auto''.');
  end
  if flags.NumBinsMode && strcmp(numBinsMode, 'manual') && ~flags.NumBins
    error('Nelson:binscatter:numBinsRequiredManual', 'NumBins must be specified when NumBinsMode is ''manual''.');
  end
  if flags.XLimits && strcmp(xLimitsMode, 'auto')
    error('Nelson:binscatter:xLimitsCannotBeSpecified', 'XLimits cannot be specified when XLimitsMode is ''auto''.');
  end
  if flags.XLimitsMode && strcmp(xLimitsMode, 'manual') && ~flags.XLimits
    error('Nelson:binscatter:invalidXLimits', 'XLimits must be specified when XLimitsMode is ''manual''.');
  end
  if flags.YLimits && strcmp(yLimitsMode, 'auto')
    error('Nelson:binscatter:yLimitsCannotBeSpecified', 'YLimits cannot be specified when YLimitsMode is ''auto''.');
  end
  if flags.YLimitsMode && strcmp(yLimitsMode, 'manual') && ~flags.YLimits
    error('Nelson:binscatter:invalidYLimits', 'YLimits must be specified when YLimitsMode is ''manual''.');
  end
end
%=============================================================================
function value = propertyValue(args, name, defaultValue)
  value = defaultValue;
  for k = 1:2:length(args)
    if strcmp(args{k}, name)
      value = args{k + 1};
      return
    end
  end
end
%=============================================================================
function name = canonicalPropertyName(value)
  if ~(ischar(value) || isStringScalar(value))
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  names = supportedPropertyNames();
  matches = strcmpi(char(value), names);
  if ~any(matches)
    error('Nelson:graphics:unsupportedProperty', 'Unsupported "%s" option.', 'binscatter');
  end
  name = names{find(matches, 1)};
end
%=============================================================================
function tf = isPropertyName(value)
  if ~(ischar(value) || isStringScalar(value))
    tf = false;
    return
  end
  tf = any(strcmpi(char(value), supportedPropertyNames()));
end
%=============================================================================
function names = supportedPropertyNames()
  names = {'NumBins', 'NumBinsMode', 'XLimits', 'XLimitsMode', ...
    'YLimits', 'YLimitsMode', 'ShowEmptyBins', 'FaceAlpha', ...
    'DisplayName', 'Visible', 'HandleVisibility', 'Tag', 'UserData', ...
    'ButtonDownFcn', 'ContextMenu', 'Selected', 'SelectionHighlight', ...
    'HitTest', 'PickableParts', 'BusyAction', 'Interruptible', ...
    'CreateFcn', 'DeleteFcn'};
end
%=============================================================================
function updateBinscatterAxes(h)
  ax = ancestor(h, 'axes');
  if isempty(ax)
    return
  end
  ax.YDir = 'normal';
  ax.Box = 'on';
  values = h.Values;
  if isempty(values)
    maxValue = 1;
  else
    maxValue = max(values(:));
    if ~isfinite(maxValue) || maxValue <= 0
      maxValue = 1;
    end
  end
  ax.CLim = [0 maxValue];
  try
    colormap(ax, sky(256));
  catch
  end
  cb = colorbar(ax);
  cb.Label.String = _('Bin Counts');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function box(varargin)
  narginchk(0, 2);
  nargoutchk(0, 0);

  if nargin == 0
    target = gca();
    toggleBox(target);
    return
  end

  firstArgument = varargin{1};
  if isBoxTargetArgument(firstArgument)
    target = firstArgument;
    if nargin == 1
      validateBoxTarget(target);
      toggleBox(target);
    else
      validateBoxTarget(target);
      setBox(target, parseBoxVisibility(varargin{2}));
    end
    return
  end

  if nargin == 2
    error('Nelson:box:invalidFirstArgument', 'First argument must be a graphics object.');
  end

  target = gca();
  validateBoxTarget(target);
  setBox(target, parseBoxVisibility(firstArgument));
end
%=============================================================================
function tf = isBoxTargetArgument(value)
  if isempty(value)
    tf = false;
    return
  else
    graphicsFlags = isgraphics(value);
    tf = all(graphicsFlags(:));
  end
end
%=============================================================================
function validateBoxTarget(target)
  for k = 1:numel(target)
    if ~isprop(target(k), 'Box')
      error('Nelson:box:invalidTarget', 'Target must have a Box property.');
    end
  end
end
%=============================================================================
function toggleBox(target)
  for k = 1:numel(target)
    if strcmp(target(k).Box, 'on')
      target(k).Box = 'off';
    else
      target(k).Box = 'on';
    end
  end
end
%=============================================================================
function setBox(target, visibility)
  for k = 1:numel(target)
    if ~strcmp(target(k).Box, visibility)
      target(k).Box = visibility;
    end
  end
end
%=============================================================================
function visibility = parseBoxVisibility(value)
  if ischar(value) || isStringScalar(value)
    visibility = lower(convertStringsToChars(value));
    if strcmp(visibility, 'on') || strcmp(visibility, 'off')
      return
    end
  elseif (islogical(value) || isnumeric(value)) && isscalar(value)
    if value == 1
      visibility = 'on';
      return
    elseif value == 0
      visibility = 'off';
      return
    end
  end
  error('Nelson:box:invalidOnOffValue', 'Command option must be ''on'' or ''off''.');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = boxchart(varargin)
  narginchk(1, 10000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [parent, args] = graphicsParseParent(args);
  [posArgs, optionArgs] = splitDataAndOptions(args);
  [groupByColor, optionArgs] = extractGroupByColor(optionArgs);
  options = parseBoxchartOptions(optionArgs);
  [series, axesState] = parseBoxchartData(posArgs, groupByColor, options);
  [target, ax] = boxchartTarget(parent);
  handles = [];
  for k = 1:numel(series)
    ctorArgs = seriesConstructorArgs(target, series(k), options, k, numel(series));
    handles = [handles; __boxchart__(ctorArgs{:})];
  end
  applyAxesState(ax, axesState, options);
  if nargout == 1
    varargout{1} = handles;
  end
end
%=============================================================================
function [target, ax] = boxchartTarget(parent)
  if isempty(parent)
    ax = newplot();
    target = ax;
  elseif isgraphics(parent, 'hggroup')
    target = parent;
    ax = ancestor(parent, 'axes');
  else
    ax = newplot(parent);
    target = ax;
  end
end
%=============================================================================
function [posArgs, optionArgs] = splitDataAndOptions(args)
  firstOption = numel(args) + 1;
  for k = 1:numel(args)
    if isBoxchartOptionName(args{k})
      firstOption = k;
      break
    end
  end
  posArgs = args(1:firstOption - 1);
  optionArgs = args(firstOption:end);
  if rem(numel(optionArgs), 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
end
%=============================================================================
function [groupByColor, args] = extractGroupByColor(args)
  groupByColor = [];
  kept = {};
  k = 1;
  while k <= numel(args)
    name = canonicalPropertyName(args{k});
    if strcmp(name, 'GroupByColor')
      groupByColor = args{k + 1};
    else
      kept(end + 1:end + 2) = args(k:k + 1);
    end
    k = k + 2;
  end
  args = kept;
end
%=============================================================================
function options = parseBoxchartOptions(args)
  options = struct();
  options.ConstructorArgs = {};
  options.BoxWidth = 0.5;
  options.ColorGroupWidth = 1;
  options.ColorGroupLayout = 'grouped';
  options.Orientation = 'vertical';
  k = 1;
  while k <= numel(args)
    name = canonicalPropertyName(args{k});
    value = args{k + 1};
    validateBoxchartOption(name, value);
    if strcmp(name, 'BoxWidth')
      options.BoxWidth = double(value);
    elseif strcmp(name, 'ColorGroupWidth')
      options.ColorGroupWidth = double(value);
    elseif strcmp(name, 'ColorGroupLayout')
      options.ColorGroupLayout = lower(char(value));
    elseif strcmp(name, 'Orientation')
      options.Orientation = lower(char(value));
    end
    options.ConstructorArgs(end + 1:end + 2) = {name, value};
    k = k + 2;
  end
end
%=============================================================================
function validateBoxchartOption(name, value)
  switch name
    case {'BoxWidth', 'CapWidth', 'LineWidth', 'MarkerSize'}
      validatePositiveScalar(value, name);
    case {'BoxFaceAlpha', 'ColorGroupWidth'}
      validateUnitScalar(value, name);
    case {'BoxFaceColor', 'BoxEdgeColor', 'BoxMedianLineColor', 'WhiskerLineColor', 'MarkerColor'}
      validateColorOrAuto(value, name);
    case {'Orientation'}
      validateMember(value, {'vertical', 'horizontal'}, name);
    case {'ColorGroupLayout'}
      validateMember(value, {'grouped', 'overlaid'}, name);
    case {'Notch', 'JitterOutliers', 'Clipping', 'Visible', 'HandleVisibility', ...
        'Selected', 'SelectionHighlight', 'HitTest', 'Interruptible'}
      validateOnOff(value, name);
    otherwise
  end
end
%=============================================================================
function [series, axesState] = parseBoxchartData(posArgs, groupByColor, options)
  if isempty(posArgs)
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Value');
  end
  if istable(posArgs{1}) || istimetable(posArgs{1})
    [series, axesState] = parseTableBoxchartData(posArgs, groupByColor, options);
    return
  end
  [x, y, xLabels] = parseArrayBoxchartData(posArgs);
  [series, axesState] = buildSeriesFromArrays(x, y, xLabels, groupByColor, options);
end
%=============================================================================
function [x, y, xLabels] = parseArrayBoxchartData(posArgs)
  x = [];
  xLabels = [];
  if numel(posArgs) == 1
    y = posArgs{1};
  elseif numel(posArgs) == 2
    [x, xLabels] = groupPositions(posArgs{1}, numel(posArgs{2}));
    y = posArgs{2};
  else
    if containsTextArgument(posArgs(2:end))
      error('Nelson:graphics:unsupportedProperty', 'Unsupported "%s" option.', 'boxchart');
    end
    error('Nelson:graphics:tooManyDataArguments', 'Too many data arguments.');
  end
  if ~isnumeric(y)
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Value');
  end
end
%=============================================================================
function tf = containsTextArgument(args)
  tf = false;
  for k = 1:numel(args)
    if ischar(args{k}) || isStringScalar(args{k})
      tf = true;
      return
    end
  end
end
%=============================================================================
function [series, axesState] = parseTableBoxchartData(posArgs, groupByColor, options)
  tbl = posArgs{1};
  if numel(posArgs) == 2
    yNames = graphicsTableVariableNames(tbl, posArgs{2});
    [y, labels] = tableNumericMatrix(tbl, yNames);
    base = makeSeries([], y, '', strjoin(yNames, ','), tbl);
    series = base;
    axesState = defaultAxesState(size(y, 2), labels);
  elseif numel(posArgs) == 3
    xNames = graphicsTableVariableNames(tbl, posArgs{2});
    yNames = graphicsTableVariableNames(tbl, posArgs{3});
    [series, axesState] = tableXYSeries(tbl, xNames, yNames, groupByColor, options);
    return
  else
    error('Nelson:graphics:tableVariableExpected', 'Table variable arguments expected.');
  end
  if ~isempty(groupByColor)
    groupByColor = tableGroupByColor(tbl, groupByColor, numel(y));
    [series, axesState] = applyGroupByColor(series, axesState, groupByColor, options);
  end
end
%=============================================================================
function [series, axesState] = tableXYSeries(tbl, xNames, yNames, groupByColor, options)
  rawGroupByColor = groupByColor;
  if numel(xNames) == 1 && numel(yNames) > 1
    series = repmat(emptySeries(), 1, numel(yNames));
    for k = 1:numel(yNames)
      [x, labels] = groupPositions(tbl.(xNames{1}), numel(tbl.(yNames{k})));
      series(k) = makeSeries(x, numericColumn(tbl.(yNames{k}), yNames{k}), xNames{1}, yNames{k}, tbl);
      series(k).DisplayName = yNames{k};
    end
    axesState = axesStateFromLabels(x, labels);
  elseif numel(xNames) == numel(yNames)
    series = repmat(emptySeries(), 1, numel(yNames));
    labels = [];
    x = [];
    for k = 1:numel(yNames)
      [x, labels] = groupPositions(tbl.(xNames{k}), numel(tbl.(yNames{k})));
      series(k) = makeSeries(x, numericColumn(tbl.(yNames{k}), yNames{k}), xNames{k}, yNames{k}, tbl);
      series(k).DisplayName = yNames{k};
    end
    axesState = axesStateFromLabels(x, labels);
  else
    error('Nelson:dimagree:tableVariableCountsMatch', 'Table variable counts must match.');
  end
  if ~isempty(groupByColor)
    groupByColor = tableGroupByColor(tbl, rawGroupByColor, numel(series(1).YData));
    [series, axesState] = applyGroupByColor(series, axesState, groupByColor, options);
  end
end
%=============================================================================
function [series, axesState] = buildSeriesFromArrays(x, y, xLabels, groupByColor, options)
  if isempty(groupByColor)
    series = makeSeries(x, y, '', '', []);
    if isempty(xLabels)
      axesState = defaultAxesStateForData(x, y);
    else
      axesState = axesStateFromLabels(x, xLabels);
    end
  else
    base = makeSeries(x, y, '', '', []);
    [series, axesState] = applyGroupByColor(base, axesStateFromLabels(x, xLabels), ...
      groupByColor, options);
  end
end
%=============================================================================
function s = emptySeries()
  s = struct('XData', [], 'YData', [], 'XVariable', '', 'YVariable', '', ...
    'SourceTable', [], 'DisplayName', '');
end
%=============================================================================
function s = makeSeries(x, y, xVariable, yVariable, sourceTable)
  s = emptySeries();
  s.XData = x;
  s.YData = y;
  s.XVariable = xVariable;
  s.YVariable = yVariable;
  s.SourceTable = sourceTable;
end
%=============================================================================
function ctorArgs = seriesConstructorArgs(target, s, options, index, count)
  ctorArgs = {'Parent', target, 'YData', s.YData};
  if ~isempty(s.XData)
    ctorArgs(end + 1:end + 2) = {'XData', s.XData};
  end
  if ~isempty(s.SourceTable)
    ctorArgs(end + 1:end + 2) = {'SourceTable', s.SourceTable};
  end
  if ~isempty(s.XVariable)
    ctorArgs(end + 1:end + 2) = {'XVariable', s.XVariable};
  end
  if ~isempty(s.YVariable)
    ctorArgs(end + 1:end + 2) = {'YVariable', s.YVariable};
  end
  if ~isempty(s.DisplayName)
    ctorArgs(end + 1:end + 2) = {'DisplayName', s.DisplayName};
  end
  if count > 1
    ctorArgs(end + 1:end + 4) = {'SeriesIndex', index, 'NumPeers', count};
  end
  ctorArgs = [ctorArgs, options.ConstructorArgs];
end
%=============================================================================
function [series, axesState] = applyGroupByColor(baseSeries, axesState, groupByColor, options)
  if numel(baseSeries) ~= 1
    error('Nelson:boxchart:groupByColorSupportsOneData', 'GroupByColor supports one data series at a time.');
  end
  y = baseSeries.YData;
  if ~isvector(y)
    error('Nelson:boxchart:groupByColorRequiresVectorData', 'GroupByColor requires vector data.');
  end
  y = y(:);
  if isempty(baseSeries.XData)
    x = ones(size(y));
    if isempty(axesState.Ticks)
      axesState = axesStateFromLabels(1, {'1'});
    end
  else
    x = baseSeries.XData(:);
  end
  if numel(x) ~= numel(y)
    error('Nelson:dimagree:valueValueNumberElements', '%s and %s must have the same number of elements.', 'XData', 'YData');
  end
  labels = graphicsLabelsFromValue(groupByColor, numel(y));
  [colorLabels, colorIndex] = sortedUniqueLabels(labels);
  count = numel(colorLabels);
  series = repmat(emptySeries(), 1, count);
  for k = 1:count
    mask = colorIndex == k;
    sx = x(mask);
    series(k) = makeSeries(sx, y(mask), baseSeries.XVariable, baseSeries.YVariable, ...
      baseSeries.SourceTable);
    series(k).DisplayName = colorLabels{k};
  end
end
%=============================================================================
function offset = colorOffset(index, count, boxWidth, colorGroupWidth)
  if count <= 1
    offset = 0;
  else
    span = boxWidth * colorGroupWidth;
    offset = ((index - (count + 1) / 2) / count) * span;
  end
end
%=============================================================================
function [positions, labels] = groupPositions(value, expectedCount)
  labels = [];
  if isnumeric(value) || islogical(value)
    positions = double(value(:));
  else
    labels = graphicsLabelsFromValue(value, -1);
    if expectedCount >= 0 && numel(labels) ~= expectedCount
      error('Nelson:graphics:invalidGroupData', 'Group data must have the same number of elements as data.');
    end
    [uniqueLabels, index] = stableUniqueLabels(labels);
    positions = double(index(:));
    labels = uniqueLabels;
  end
  if expectedCount >= 0 && numel(positions) ~= expectedCount
    error('Nelson:graphics:invalidGroupData', 'Group data must have the same number of elements as data.');
  end
end
%=============================================================================
function [uniqueLabels, index] = stableUniqueLabels(labels)
  uniqueLabels = {};
  index = zeros(numel(labels), 1);
  for k = 1:numel(labels)
    found = find(strcmp(labels{k}, uniqueLabels), 1);
    if isempty(found)
      uniqueLabels{end + 1, 1} = labels{k};
      found = numel(uniqueLabels);
    end
    index(k) = found;
  end
end
%=============================================================================
function [uniqueLabels, index] = sortedUniqueLabels(labels)
  [uniqueLabels, ~] = stableUniqueLabels(labels);
  uniqueLabels = sort(uniqueLabels(:));
  index = zeros(numel(labels), 1);
  for k = 1:numel(labels)
    index(k) = find(strcmp(labels{k}, uniqueLabels), 1);
  end
end
%=============================================================================
function state = axesStateFromLabels(x, labels)
  state = struct('Ticks', [], 'Labels', [], 'Limits', []);
  if ~isempty(labels)
    state.Ticks = 1:numel(labels);
    state.Labels = labels(:);
    state.Limits = numericPositionLimits(state.Ticks);
  else
    [state.Limits, state.Ticks] = numericPositionLimits(x);
  end
end
%=============================================================================
function state = defaultAxesStateForData(x, y)
  if isempty(x) && ~isvector(y)
    state = defaultAxesState(size(y, 2), defaultLabels(size(y, 2)));
  elseif isempty(x)
    state = defaultAxesState(1, {'1'});
  else
    state = axesStateFromLabels(x, []);
  end
end
%=============================================================================
function state = defaultAxesState(count, labels)
  state = struct('Ticks', 1:count, 'Labels', {labels(:)}, 'Limits', defaultPositionLimits(count));
end
%=============================================================================
function limits = defaultPositionLimits(count)
  limits = [0.5 count + 0.5];
end
%=============================================================================
function [limits, ticks] = numericPositionLimits(values)
  limits = [];
  ticks = [];
  if isempty(values) || ~(isnumeric(values) || islogical(values))
    return
  end
  values = double(values(:));
  values = values(isfinite(values));
  if isempty(values)
    return
  end
  values = sort(unique(values(:).'));
  if numel(values) == 1
    step = 1;
  else
    steps = diff(values);
    steps = steps(steps > 0);
    if isempty(steps)
      step = 1;
    else
      step = min(steps);
    end
  end
  tickStep = step / 2;
  limits = [values(1) - tickStep, values(end) + tickStep];
  ticks = limits(1):tickStep:limits(2);
end
%=============================================================================
function applyAxesState(ax, state, options)
  if isempty(ax)
    return
  end
  if strcmp(options.Orientation, 'horizontal')
    if ~isempty(state.Ticks)
      ax.YTick = state.Ticks;
    end
    if ~isempty(state.Labels)
      ax.YTickLabel = state.Labels;
    end
    if ~isempty(state.Limits) && strcmp(ax.YLimMode, 'auto')
      ax.YLim = state.Limits;
    end
  else
    if ~isempty(state.Ticks)
      ax.XTick = state.Ticks;
    end
    if ~isempty(state.Labels)
      ax.XTickLabel = state.Labels;
    end
    if ~isempty(state.Limits) && strcmp(ax.XLimMode, 'auto')
      ax.XLim = state.Limits;
    end
  end
end
%=============================================================================
function [data, labels] = tableNumericMatrix(tbl, names)
  data = [];
  labels = {};
  for k = 1:numel(names)
    value = numericColumn(tbl.(names{k}), names{k});
    data = [data, value];
    labels{end + 1, 1} = names{k};
  end
end
%=============================================================================
function value = numericColumn(value, name)
  if ~isnumeric(value)
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', name);
  end
  if ~isvector(value)
    error('Nelson:validators:mustBeVector', '%s must be a vector.', name);
  end
  value = double(value(:));
end
%=============================================================================
function value = tableGroupByColor(tbl, value, expectedCount)
  if ischar(value) || isStringScalar(value)
    try
      names = graphicsTableVariableNames(tbl, value);
      if numel(names) == 1 && numel(tbl.(names{1})) == expectedCount
        value = tbl.(names{1});
      end
    catch
    end
  end
end
%=============================================================================
function labels = defaultLabels(count)
  labels = cell(count, 1);
  for k = 1:count
    labels{k} = num2str(k);
  end
end
%=============================================================================
function tf = isBoxchartOptionName(value)
  tf = false;
  if ~(ischar(value) || isStringScalar(value))
    return
  end
  try
    canonicalPropertyName(value);
    tf = true;
  catch
    tf = false;
  end
end
%=============================================================================
function name = canonicalPropertyName(value)
  if ~(ischar(value) || isStringScalar(value))
    error('Nelson:boxchart:propertyNameExpected', 'Property name expected.');
  end
  switch lower(char(value))
    case 'groupbycolor'
      name = 'GroupByColor';
    case 'xdata'
      name = 'XData';
    case 'ydata'
      name = 'YData';
    case 'xdatamode'
      name = 'XDataMode';
    case 'ydatamode'
      name = 'YDataMode';
    case 'xvariable'
      name = 'XVariable';
    case 'yvariable'
      name = 'YVariable';
    case 'boxwidth'
      name = 'BoxWidth';
    case 'boxfacecolor'
      name = 'BoxFaceColor';
    case 'boxedgecolor'
      name = 'BoxEdgeColor';
    case 'boxmedianlinecolor'
      name = 'BoxMedianLineColor';
    case 'boxfacealpha'
      name = 'BoxFaceAlpha';
    case 'capwidth'
      name = 'CapWidth';
    case 'whiskerlinecolor'
      name = 'WhiskerLineColor';
    case 'linewidth'
      name = 'LineWidth';
    case 'whiskerlinestyle'
      name = 'WhiskerLineStyle';
    case 'markercolor'
      name = 'MarkerColor';
    case 'markersize'
      name = 'MarkerSize';
    case {'markerstyle', 'marker'}
      name = 'MarkerStyle';
    case 'clipping'
      name = 'Clipping';
    case 'orientation'
      name = 'Orientation';
    case 'colorgrouplayout'
      name = 'ColorGroupLayout';
    case 'notch'
      name = 'Notch';
    case 'jitteroutliers'
      name = 'JitterOutliers';
    case 'colorgroupwidth'
      name = 'ColorGroupWidth';
    case 'boxfacecolormode'
      name = 'BoxFaceColorMode';
    case 'boxedgecolormode'
      name = 'BoxEdgeColorMode';
    case 'boxmedianlinecolormode'
      name = 'BoxMedianLineColorMode';
    case 'capwidthmode'
      name = 'CapWidthMode';
    case 'markercolormode'
      name = 'MarkerColorMode';
    case 'colorgroupwidthmode'
      name = 'ColorGroupWidthMode';
    case 'visible'
      name = 'Visible';
    case 'displayname'
      name = 'DisplayName';
    case 'tag'
      name = 'Tag';
    case 'userdata'
      name = 'UserData';
    case 'seriesindex'
      name = 'SeriesIndex';
    case 'handlevisibility'
      name = 'HandleVisibility';
    case 'hittest'
      name = 'HitTest';
    case 'pickableparts'
      name = 'PickableParts';
    case 'buttondownfcn'
      name = 'ButtonDownFcn';
    case 'contextmenu'
      name = 'ContextMenu';
    case 'busyaction'
      name = 'BusyAction';
    case 'interruptible'
      name = 'Interruptible';
    case 'createfcn'
      name = 'CreateFcn';
    case 'deletefcn'
      name = 'DeleteFcn';
    case 'selected'
      name = 'Selected';
    case 'selectionhighlight'
      name = 'SelectionHighlight';
    otherwise
      error('Nelson:graphics:unsupportedProperty', 'Unsupported "%s" option.', 'boxchart');
  end
end
%=============================================================================
function validatePositiveScalar(value, name)
  if ~isnumeric(value) || ~isscalar(value) || ~isfinite(value) || value <= 0
    error('Nelson:graphics:mustBePositiveFinite', '%s must be a positive finite scalar.', name);
  end
end
%=============================================================================
function validateUnitScalar(value, name)
  if ~isnumeric(value) || ~isscalar(value) || ~isfinite(value) || value < 0 || value > 1
    error('Nelson:boxchart:mustBeInRange', '%s must be a scalar between 0 and 1.', name);
  end
end
%=============================================================================
function validateColorOrAuto(value, name)
  if isnumeric(value)
    if ~isequal(size(value), [1 3]) || any(value < 0) || any(value > 1)
      error('Nelson:boxchart:invalidRGBTriplet', '%s must be an RGB triplet.', name);
    end
  elseif ~(ischar(value) || isStringScalar(value))
    error('Nelson:boxchart:invalidColor', '%s must be a color value.', name);
  end
end
%=============================================================================
function validateMember(value, values, name)
  if ~(ischar(value) || isStringScalar(value)) || ~any(strcmpi(char(value), values))
    error('Nelson:boxchart:invalidValue', '%s has an unsupported value.', name);
  end
end
%=============================================================================
function validateOnOff(value, name)
  if islogical(value) && isscalar(value)
    return
  end
  if ~(ischar(value) || isStringScalar(value)) || ~any(strcmpi(char(value), {'on', 'off'}))
    error('Nelson:boxchart:mustBeOnOff', '%s must be ''on'' or ''off''.', name);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = boxplot(varargin)
  narginchk(1, 10000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [parent, args] = parseParent(args);
  options = defaultBoxOptions('boxplot');
  [data, groupData, args] = parseBoxplotData(args);
  [options, labels] = parseBoxOptions(options, args);
  [groups, labels] = makeBoxGroups(data, groupData, labels);
  h = boxPlotBase(parent, groups, labels, options);
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [parent, args] = parseParent(args)
  parent = [];
  if ~isempty(args) && isscalar(args{1}) && (isgraphics(args{1}, 'axes') || isgraphics(args{1}, 'hggroup'))
    parent = args{1};
    args = args(2:end);
  end
end
%=============================================================================
function [data, groupData, args] = parseBoxplotData(args)
  if isempty(args) || ~isnumeric(args{1})
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Value');
  end
  data = args{1};
  args = args(2:end);
  groupData = [];
  if ~isempty(args) && ~isBoxOptionName(args{1})
    if (ischar(args{1}) || isStringScalar(args{1})) && numel(args) >= 2
      error('Nelson:graphics:unsupportedProperty', 'Unsupported "%s" option.', 'boxplot');
    end
    groupData = args{1};
    args = args(2:end);
  end
end
%=============================================================================
function [options, labels] = parseBoxOptions(options, args)
  labels = [];
  if rem(length(args), 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  for k = 1:2:length(args)
    name = lower(char(args{k}));
    value = args{k + 1};
    switch name
      case 'labels'
        labels = labelsFromValue(value);
      case 'orientation'
        options.Orientation = validateOrientation(value);
      case 'widths'
        options.Widths = validatePositiveVector(value, 'Widths');
      case 'whisker'
        options.Whisker = validateNonnegativeScalar(value, 'Whisker');
      case 'symbol'
        options = applyOutlierSymbol(options, value);
      case {'colors', 'color'}
        options.Colors = validateColors(value);
      case 'linewidth'
        options.LineWidth = validatePositiveScalar(value, 'LineWidth');
      case 'showoutliers'
        options.ShowOutliers = validateOnOff(value);
      case 'notch'
        options.Notch = validateOnOff(value);
      case 'positions'
        options.Positions = validatePositions(value);
      case 'boxstyle'
        options.BoxStyle = validateBoxStyle(value);
      otherwise
        error('Nelson:graphics:unsupportedProperty', 'Unsupported "%s" option.', 'boxplot');
    end
  end
end
%=============================================================================
function [groups, labels] = makeBoxGroups(data, groupData, labels)
  if isempty(groupData)
    data = double(data);
    if isvector(data)
      groups = {data(:)};
    else
      groups = cell(1, size(data, 2));
      for k = 1:size(data, 2)
        groups{k} = data(:, k);
      end
    end
    if isempty(labels)
      labels = defaultLabels(numel(groups));
    end
    validateLabelCount(labels, numel(groups));
    return
  end
  values = double(data(:));
  if numel(values) ~= numel(groupData)
    error('Nelson:graphics:invalidGroupData', 'Group data must have the same number of elements as data.');
  end
  groupLabels = labelsFromValue(groupData);
  [uniqueLabels, groupIndex] = stableUniqueLabels(groupLabels);
  groups = cell(1, numel(uniqueLabels));
  for k = 1:numel(uniqueLabels)
    groups{k} = values(groupIndex == k);
  end
  if isempty(labels)
    labels = uniqueLabels;
  end
  validateLabelCount(labels, numel(groups));
end
%=============================================================================
function tf = isBoxOptionName(value)
  tf = false;
  if ~(ischar(value) || isStringScalar(value))
    return
  end
  names = {'labels', 'orientation', 'widths', 'whisker', 'symbol', 'colors', ...
    'color', 'linewidth', 'showoutliers', 'notch', 'positions', 'boxstyle'};
  tf = any(strcmpi(char(value), names));
end
%=============================================================================
function options = defaultBoxOptions(chartType)
  options = struct('ChartType', chartType, 'Orientation', 'vertical', ...
    'Width', 0.5, 'Whisker', 1.5, 'BoxFaceColor', [0.8 0.8 0.8], ...
    'BoxFaceAlpha', 1, 'EdgeColor', [0 0 0], 'MedianColor', [1 0 0], ...
    'OutlierColor', [1 0 0], 'Symbol', '+', 'ShowOutliers', 'on', ...
    'LineWidth', 0.5, 'Notch', 'off', 'Positions', [], ...
    'BoxStyle', 'filled', 'Colors', [], 'Widths', 0.5);
end
%=============================================================================
function labels = defaultLabels(n)
  labels = cell(n, 1);
  for k = 1:n
    labels{k} = num2str(k);
  end
end
%=============================================================================
function labels = labelsFromValue(value)
  if iscellstr(value)
    labels = value(:);
  elseif isstring(value)
    labels = cellstr(value(:));
  elseif ischar(value)
    labels = cellstr(value);
  elseif isnumeric(value) || islogical(value)
    value = value(:);
    labels = cell(numel(value), 1);
    for k = 1:numel(value)
      labels{k} = num2str(value(k));
    end
  else
    error('Nelson:boxplot:invalidLabels', 'Labels must be character, string, cell string, or numeric values.');
  end
end
%=============================================================================
function [uniqueLabels, index] = stableUniqueLabels(labels)
  uniqueLabels = {};
  index = zeros(numel(labels), 1);
  for k = 1:numel(labels)
    found = 0;
    for j = 1:numel(uniqueLabels)
      if strcmp(labels{k}, uniqueLabels{j})
        found = j;
        break
      end
    end
    if found == 0
      uniqueLabels{end + 1, 1} = labels{k};
      found = numel(uniqueLabels);
    end
    index(k) = found;
  end
end
%=============================================================================
function validateLabelCount(labels, count)
  if numel(labels) ~= count
    error('Nelson:boxplot:invalidNumberOfLabels', 'Number of labels must match number of groups.');
  end
end
%=============================================================================
function value = validateOrientation(value)
  value = lower(char(value));
  if ~(strcmp(value, 'vertical') || strcmp(value, 'horizontal'))
    error('Nelson:boxplot:invalidOrientation', 'Orientation must be ''vertical'' or ''horizontal''.');
  end
end
%=============================================================================
function value = validateOnOff(value)
  value = lower(char(value));
  if ~(strcmp(value, 'on') || strcmp(value, 'off'))
    error('Nelson:graphics:invalidOnOffValue', 'Value must be ''on'' or ''off''.');
  end
end
%=============================================================================
function value = validatePositiveScalar(value, name)
  if ~isnumeric(value) || ~isscalar(value) || ~isfinite(value) || value <= 0
    error('Nelson:graphics:mustBePositiveFinite', '%s must be a positive finite scalar.', name);
  end
end
%=============================================================================
function value = validatePositiveVector(value, name)
  if ~isnumeric(value) || ~isvector(value) || isempty(value) || any(~isfinite(value(:))) ...
      || any(value(:) <= 0)
    error('Nelson:boxplot:mustBePositiveFiniteVector', '%s must be a positive finite numeric vector.', name);
  end
  value = double(value(:).');
end
%=============================================================================
function value = validateNonnegativeScalar(value, name)
  if ~isnumeric(value) || ~isscalar(value) || ~isfinite(value) || value < 0
    error('Nelson:boxplot:mustBeNonnegativeFinite', '%s must be a nonnegative finite scalar.', name);
  end
end
%=============================================================================
function color = validateColor(value)
  if isnumeric(value)
    if ~isequal(size(value), [1 3]) || any(value < 0) || any(value > 1)
      error('Nelson:boxplot:invalidColor', '%s must be an RGB triplet.', 'Color');
    end
    color = value;
  else
    color = getColorShortName(char(value));
  end
end
%=============================================================================
function colors = validateColors(value)
  if isnumeric(value)
    if size(value, 2) ~= 3 || isempty(value) || any(value(:) < 0) || any(value(:) > 1)
      error('Nelson:boxplot:invalidColors', 'Colors must be a color string or an RGB matrix.');
    end
    colors = double(value);
  elseif ischar(value) || isStringScalar(value)
    text = char(value);
    if isempty(text)
      error('Nelson:boxplot:invalidColors', 'Colors must be a color string or an RGB matrix.');
    end
    for k = 1:numel(text)
      getColorShortName(text(k));
    end
    colors = text;
  else
    error('Nelson:boxplot:invalidColors', 'Colors must be a color string or an RGB matrix.');
  end
end
%=============================================================================
function value = validatePositions(value)
  if ~isnumeric(value) || ~isvector(value) || isempty(value) || any(~isfinite(value(:)))
    error('Nelson:boxplot:invalidPositions', 'Positions must be a finite numeric vector.');
  end
  value = double(value(:).');
end
%=============================================================================
function value = validateBoxStyle(value)
  value = lower(char(value));
  if ~(strcmp(value, 'filled') || strcmp(value, 'outline'))
    error('Nelson:boxplot:invalidBoxStyle', 'BoxStyle must be ''filled'' or ''outline''.');
  end
end
%=============================================================================
function options = applyOutlierSymbol(options, value)
  [~, color, marker, msg] = colstyle(char(value), 'plot', false);
  if ~isempty(msg)
    error('Nelson:boxplot:invalidLineSpec', msg);
  end
  if ~isempty(marker)
    options.Symbol = marker;
  end
  if ~isempty(color)
    options.OutlierColor = color;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = bubblechart(varargin)
  narginchk(3, 1000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [parent, args] = parseParent(args);
  if ~isempty(args) && (istable(args{1}) || istimetable(args{1}))
    [x, y, sizes, colorData, args, tableArgs] = parseTableBubbleData(args);
  else
    tableArgs = {};
    [x, y, sizes, args] = parseNumericBubbleData(args);
    [colorData, args] = parseColorData(args);
  end
  validateBubbleData(x, y, sizes);
  chartArgs = parseBubbleOptions(args);
  h = createBubbleChart(parent, x, y, sizes, colorData, chartArgs, tableArgs);
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [parent, args] = parseParent(args)
  parent = [];
  if ~isempty(args) && isscalar(args{1}) && isgraphics(args{1}, 'axes')
    parent = args{1};
    args = args(2:end);
  end
end
%=============================================================================
function [x, y, sizes, args] = parseNumericBubbleData(args)
  if numel(args) < 3 || ~isnumeric(args{1}) || ~isnumeric(args{2}) || ~isnumeric(args{3})
    error('Nelson:bubblechart:numericXYExpected', 'Numeric X, Y, and bubble size data expected.');
  end
  x = args{1};
  y = args{2};
  sizes = args{3};
  args = args(4:end);
end
%=============================================================================
function validateBubbleData(x, y, sizes)
  if isempty(sizes)
    error('Nelson:dimagree:sizeSMatchXY', 'Size of S must match X, Y.');
  end
  if ~(isnumeric(x) && isnumeric(y) && isnumeric(sizes))
    error('Nelson:bubblechart:numericXYExpected', 'Numeric X, Y, and bubble size data expected.');
  end
  if isvector(x) && isvector(y)
    if numel(x) ~= numel(y)
      error('Nelson:dimagree:xYSize', 'X and Y must be the same size.');
    end
    n = numel(x);
    if ~(isscalar(sizes) || numel(sizes) == n || any(size(sizes) == n))
      error('Nelson:dimagree:sizeSMatchXY', 'Size of S must match X, Y.');
    end
  elseif ~isequal(size(x), size(y))
    error('Nelson:dimagree:xYSize', 'X and Y must be the same size.');
  end
end
%=============================================================================
function [colorData, args] = parseColorData(args)
  colorData = [];
  if isempty(args) || isBubblePropertyName(args{1})
    return
  end
  if isnumeric(args{1})
    colorData = args{1};
    args = args(2:end);
    return
  end
  if ischar(args{1}) || isStringScalar(args{1})
    try
      colorData = normalizeColorData(args{1});
      args = args(2:end);
    catch
      colorData = [];
    end
  end
end
%=============================================================================
function chartArgs = parseBubbleOptions(args)
  chartArgs = {};
  if rem(length(args), 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  for k = 1:2:length(args)
    name = char(args{k});
    value = args{k + 1};
    switch lower(name)
      case {'bubblecolor', 'color', 'cdata'}
        chartArgs = [chartArgs, {'CData', normalizeColorData(value)}];
      case 'alphadata'
        chartArgs = [chartArgs, {'AlphaData', value}];
      case 'alphadatamapping'
        chartArgs = [chartArgs, {'AlphaDataMapping', value}];
      case 'alphadatamode'
        chartArgs = [chartArgs, {'AlphaDataMode', value}];
      case 'cdatamode'
        chartArgs = [chartArgs, {'CDataMode', value}];
      case 'linewidth'
        chartArgs = [chartArgs, {'LineWidth', value}];
      case 'markerfacecolor'
        chartArgs = [chartArgs, {'MarkerFaceColor', value}];
      case 'markeredgecolor'
        chartArgs = [chartArgs, {'MarkerEdgeColor', value}];
      case 'markerfacealpha'
        chartArgs = [chartArgs, {'MarkerFaceAlpha', value}];
      case 'markeredgealpha'
        chartArgs = [chartArgs, {'MarkerEdgeAlpha', value}];
      case 'displayname'
        chartArgs = [chartArgs, {'DisplayName', value}];
      case 'visible'
        chartArgs = [chartArgs, {'Visible', value}];
      case 'tag'
        chartArgs = [chartArgs, {'Tag', value}];
      case 'userdata'
        chartArgs = [chartArgs, {'UserData', value}];
      case 'sourcetable'
        chartArgs = [chartArgs, {'SourceTable', value}];
      case 'xvariable'
        chartArgs = [chartArgs, {'XVariable', value}];
      case 'yvariable'
        chartArgs = [chartArgs, {'YVariable', value}];
      case 'sizevariable'
        chartArgs = [chartArgs, {'SizeVariable', value}];
      case 'colorvariable'
        chartArgs = [chartArgs, {'ColorVariable', value}];
      case 'xdatasource'
        chartArgs = [chartArgs, {'XDataSource', value}];
      case 'ydatasource'
        chartArgs = [chartArgs, {'YDataSource', value}];
      case 'zdatasource'
        chartArgs = [chartArgs, {'ZDataSource', value}];
      case 'sizedatasource'
        chartArgs = [chartArgs, {'SizeDataSource', value}];
      case 'cdatasource'
        chartArgs = [chartArgs, {'CDataSource', value}];
      case 'sizedatamode'
        chartArgs = [chartArgs, {'SizeDataMode', value}];
      case 'xdatamode'
        chartArgs = [chartArgs, {'XDataMode', value}];
      case 'ydatamode'
        chartArgs = [chartArgs, {'YDataMode', value}];
      case 'zdatamode'
        chartArgs = [chartArgs, {'ZDataMode', value}];
      case 'seriesindex'
        chartArgs = [chartArgs, {'SeriesIndex', value}];
      case 'handlevisibility'
        chartArgs = [chartArgs, {'HandleVisibility', value}];
      case 'clipping'
        chartArgs = [chartArgs, {'Clipping', value}];
      case 'buttondownfcn'
        chartArgs = [chartArgs, {'ButtonDownFcn', value}];
      case 'createfcn'
        chartArgs = [chartArgs, {'CreateFcn', value}];
      case 'deletefcn'
        chartArgs = [chartArgs, {'DeleteFcn', value}];
      case 'busyaction'
        chartArgs = [chartArgs, {'BusyAction', value}];
      case 'interruptible'
        chartArgs = [chartArgs, {'Interruptible', value}];
      case 'pickableparts'
        chartArgs = [chartArgs, {'PickableParts', value}];
      case 'hittest'
        chartArgs = [chartArgs, {'HitTest', value}];
      case 'selected'
        chartArgs = [chartArgs, {'Selected', value}];
      case 'selectionhighlight'
        chartArgs = [chartArgs, {'SelectionHighlight', value}];
      case 'contextmenu'
        chartArgs = [chartArgs, {'ContextMenu', value}];
      case 'datatiptemplate'
        chartArgs = [chartArgs, {'DataTipTemplate', value}];
      case 'annotation'
        chartArgs = [chartArgs, {'Annotation', value}];
      case 'alphavariable'
        chartArgs = [chartArgs, {'AlphaVariable', value}];
      case 'xjitter'
        chartArgs = [chartArgs, {'XJitter', value}];
      case 'yjitter'
        chartArgs = [chartArgs, {'YJitter', value}];
      case 'zjitter'
        chartArgs = [chartArgs, {'ZJitter', value}];
      case 'xjitterwidth'
        chartArgs = [chartArgs, {'XJitterWidth', value}];
      case 'xjitterwidthmode'
        chartArgs = [chartArgs, {'XJitterWidthMode', value}];
      case 'yjitterwidth'
        chartArgs = [chartArgs, {'YJitterWidth', value}];
      case 'yjitterwidthmode'
        chartArgs = [chartArgs, {'YJitterWidthMode', value}];
      case 'zjitterwidth'
        chartArgs = [chartArgs, {'ZJitterWidth', value}];
      case 'zjitterwidthmode'
        chartArgs = [chartArgs, {'ZJitterWidthMode', value}];
      case 'xjitterdirection'
        chartArgs = [chartArgs, {'XJitterDirection', value}];
      case 'yjitterdirection'
        chartArgs = [chartArgs, {'YJitterDirection', value}];
      case 'zjitterdirection'
        chartArgs = [chartArgs, {'ZJitterDirection', value}];
      case 'zvariable'
        chartArgs = [chartArgs, {'ZVariable', value}];
      otherwise
        error('Nelson:graphics:unsupportedProperty', 'Unsupported "%s" option.', 'bubblechart');
    end
  end
end
%=============================================================================
function value = normalizeColorData(value)
  if ischar(value) || isStringScalar(value)
    value = validatecolor(value);
  end
end
%=============================================================================
function h = createBubbleChart(parent, x, y, sizes, colorData, chartArgs, tableArgs)
  parent = prepareParent(parent);
  ax = ancestor(parent, 'axes');
  nextPlot = '';
  if ~isempty(ax) && isscalar(ax) && isgraphics(ax, 'axes')
    nextPlot = ax.NextPlot;
  end
  [orientation, nSeries] = getSeriesOrientation(x, y, sizes);
  h = [];
  for k = 1:nSeries
    xk = graphicsSelectSeriesData(x, orientation, k, 'row');
    yk = graphicsSelectSeriesData(y, orientation, k, 'row');
    sk = graphicsSelectSeriesData(sizes, orientation, k, 'row');
    ck = graphicsSelectColorSeriesData(colorData, orientation, k, nSeries, numel(xk), 'row');
    args = [chartArgs, graphicsSelectTableSeriesArgs(tableArgs, k, nSeries)];
    if isempty(ck) && ~hasConstructorProperty(args, 'CData')
      if hasSeriesIndexNone(args)
        ck = noSeriesColor();
      else
        ck = getColorAndUpdateIndex(parent);
      end
    end
    hk = createBubbleChartObject(parent, xk, yk, sk, ck, args);
    h = [h, hk];
  end
  if ~isempty(ax) && any(strcmp(nextPlot, {'replace', 'replaceall'}))
    ax.Box = 'on';
  end
  applyBubbleAxisLabels(ax, tableArgs);
end
%=============================================================================
function applyBubbleAxisLabels(ax, tableArgs)
  if isempty(ax) || ~isscalar(ax) || ~isgraphics(ax, 'axes') || isempty(tableArgs)
    return
  end
  names = tableArgs{1};
  xName = getNamedArgValue(names, 'XVariable');
  yName = getNamedArgValue(names, 'YVariable');
  if ~isempty(xName) && isAxisLabelEmpty(ax.XLabel)
    xlabel(ax, xName);
  end
  if ~isempty(yName) && isAxisLabelEmpty(ax.YLabel)
    ylabel(ax, yName);
  end
end
%=============================================================================
function value = getNamedArgValue(args, name)
  value = '';
  for k = 1:2:numel(args)
    if ischar(args{k}) && strcmpi(args{k}, name)
      value = args{k + 1};
      return
    end
  end
end
%=============================================================================
function tf = isAxisLabelEmpty(labelHandle)
  tf = true;
  if ~isempty(labelHandle) && isscalar(labelHandle) && isgraphics(labelHandle)
    tf = isempty(char(labelHandle.String));
  end
end
%=============================================================================
function parent = prepareParent(parent)
  if isempty(parent)
    parent = newplot();
  else
    parent = newplot(parent);
  end
end
%=============================================================================
function h = createBubbleChartObject(parent, x, y, sizes, colorData, chartArgs)
  args = {'Parent', parent, 'XData', x, 'YData', y, 'SizeData', sizes};
  if ~isempty(colorData)
    args = [args, {'CData', colorData}];
  end
  h = __bubblechart__(args{:}, chartArgs{:});
end
%=============================================================================
function [orientation, nSeries] = getSeriesOrientation(x, y, sizes)
  if isvector(x) && isvector(y) && isscalar(sizes)
    orientation = 'points';
    nSeries = numel(x);
    return
  end
  if isvector(x) && isvector(y)
    [orientation, nSeries] = getVectorSeriesOrientation(x, sizes);
    return
  end
  if isscalar(sizes)
    error('Nelson:dimagree:sizeSMatchXY', 'Size of S must match X, Y.');
  end
  if isvector(sizes) && numel(sizes) == numel(x)
    orientation = 'single';
    nSeries = 1;
    return
  end
  rows = size(x, 1);
  cols = size(x, 2);
  if isequal(size(sizes), size(x))
    orientation = 'columns';
    nSeries = cols;
  elseif isvector(sizes) && numel(sizes) == rows
    orientation = 'columns';
    nSeries = cols;
  elseif isrow(sizes) && numel(sizes) == cols && rows > 1
    orientation = 'rows';
    nSeries = rows;
  else
    error('Nelson:dimagree:sizeSMatchXY', 'Size of S must match X, Y.');
  end
end
%=============================================================================
function [orientation, nSeries] = getVectorSeriesOrientation(x, sizes)
  n = numel(x);
  if isvector(sizes)
    orientation = 'single';
    nSeries = 1;
  elseif size(sizes, 1) == n
    orientation = 'columns';
    nSeries = size(sizes, 2);
  elseif size(sizes, 2) == n
    orientation = 'rows';
    nSeries = size(sizes, 1);
  else
    error('Nelson:dimagree:sizeSMatchXY', 'Size of S must match X, Y.');
  end
end
%=============================================================================
function tf = isBubblePropertyName(value)
  if ~(ischar(value) || isStringScalar(value))
    tf = false;
    return
  end
  names = {'AlphaData', 'AlphaDataMapping', 'AlphaDataMode', 'AlphaVariable', 'Annotation', ...
    'BubbleColor', 'BusyAction', 'ButtonDownFcn', 'CData', 'CDataMode', ...
    'CDataSource', 'Clipping', 'Color', 'ColorVariable', 'ContextMenu', ...
    'CreateFcn', 'DataTipTemplate', 'DeleteFcn', 'DisplayName', ...
    'HandleVisibility', 'HitTest', 'Interruptible', 'LineWidth', ...
    'MarkerEdgeAlpha', 'MarkerEdgeColor', 'MarkerFaceAlpha', ...
    'MarkerFaceColor', 'PickableParts', 'Selected', 'SelectionHighlight', ...
    'SeriesIndex', 'SizeDataMode', 'SizeDataSource', 'SizeVariable', ...
    'SourceTable', 'Tag', 'UserData', 'Visible', 'XDataMode', 'XDataSource', ...
    'XJitter', 'XJitterDirection', 'XJitterWidth', 'XVariable', 'YDataMode', ...
    'YDataSource', 'YJitter', 'YJitterDirection', 'YJitterWidth', 'YVariable', ...
    'ZDataMode', 'ZDataSource', 'ZJitter', 'ZJitterDirection', 'ZJitterWidth', ...
    'ZVariable'};
  tf = any(strcmpi(char(value), names));
end
%=============================================================================
function [x, y, sizes, colorData, args, tableArgs] = parseTableBubbleData(args)
  tbl = args{1};
  if numel(args) < 4
    error('Nelson:graphics:tableVariableExpected', 'Table variable arguments expected.');
  end
  xNames = graphicsTableVariableNames(tbl, args{2});
  yNames = graphicsTableVariableNames(tbl, args{3});
  sizeNames = graphicsTableVariableNames(tbl, args{4});
  args = args(5:end);
  colorNames = {};
  if ~isempty(args) && ~isBubblePropertyName(args{1})
    colorNames = graphicsTableVariableNames(tbl, args{1});
    args = args(2:end);
  end
  nSeries = max([numel(xNames), numel(yNames), numel(sizeNames), max(1, numel(colorNames))]);
  validateTableVariableCounts(xNames, yNames, sizeNames, colorNames, nSeries);
  [x, y, sizes, colorData, tableArgs] = tableBubbleSeries(tbl, xNames, yNames, sizeNames, colorNames, nSeries);
end
%=============================================================================
function validateTableVariableCounts(xNames, yNames, sizeNames, colorNames, nSeries)
  counts = [numel(xNames), numel(yNames), numel(sizeNames)];
  if ~isempty(colorNames)
    counts(end + 1) = numel(colorNames);
  end
  if any(counts ~= 1 & counts ~= nSeries)
    error('Nelson:dimagree:tableVariableCountsMatch', 'Table variable counts must match.');
  end
end
%=============================================================================
function [x, y, sizes, colorData, tableArgs] = tableBubbleSeries(tbl, xNames, yNames, sizeNames, colorNames, nSeries)
  x = [];
  y = [];
  sizes = [];
  colorData = [];
  tableArgs = cell(1, nSeries);
  for k = 1:nSeries
    xName = graphicsSelectName(xNames, k);
    yName = graphicsSelectName(yNames, k);
    sizeName = graphicsSelectName(sizeNames, k);
    x = graphicsAppendColumn(x, graphicsNumericColumn(tbl.(xName), xName));
    y = graphicsAppendColumn(y, graphicsNumericColumn(tbl.(yName), yName));
    sizes = graphicsAppendColumn(sizes, graphicsNumericColumn(tbl.(sizeName), sizeName));
    oneArgs = {'SourceTable', tbl, 'XVariable', xName, 'YVariable', yName, 'SizeVariable', sizeName};
    if ~isempty(colorNames)
      colorName = graphicsSelectName(colorNames, k);
      colorData = graphicsAppendColumn(colorData, graphicsNumericColumn(tbl.(colorName), colorName));
      oneArgs(end + 1:end + 2) = {'ColorVariable', colorName};
    end
    if nSeries > 1
      oneArgs(end + 1:end + 2) = {'DisplayName', yName};
    end
    tableArgs{k} = oneArgs;
  end
end
%=============================================================================
function tf = hasConstructorProperty(args, propertyName)
  tf = false;
  for k = 1:2:numel(args)
    if ischar(args{k}) && strcmpi(args{k}, propertyName)
      tf = true;
      return
    end
  end
end
%=============================================================================
function tf = hasSeriesIndexNone(args)
  tf = false;
  for k = 1:2:numel(args)
    if ischar(args{k}) && strcmpi(args{k}, 'SeriesIndex')
      value = args{k + 1};
      tf = (ischar(value) || isStringScalar(value)) && strcmpi(char(value), 'none');
      return
    end
  end
end
%=============================================================================
function color = noSeriesColor()
  color = [33 33 33] / 255;
end
