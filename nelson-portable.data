function st = timetableApplyVariableProperties(st, props)
  % Copies the per-variable metadata of a validated timetable Properties
  % struct into its table storage st, whose data is already renamed.
  st.Properties.VariableNames = props.VariableNames;
  st.Properties.VariableDescriptions = props.VariableDescriptions;
  st.Properties.VariableUnits = props.VariableUnits;
  st.Properties.VariableContinuity = props.VariableContinuity;
  st.Properties.CustomProperties = props.CustomProperties;
  st = struct(table.fromStruct(st));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
