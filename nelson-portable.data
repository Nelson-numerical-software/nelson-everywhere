% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = splitapply(func, varargin)
  narginchk(2, inf);
  if ~isa(func, 'function_handle')
    error('Nelson:data_analysis:firstInputFunctionHandle', '%s must be a function handle.', 'First input');
  end
  G = varargin{end};
  data = varargin(1:end - 1);
  Gv = G(:);
  finite = Gv(~isnan(Gv));
  if isempty(finite)
    ngroups = 0;
  else
    ngroups = max(finite);
  end
  nout = max(nargout, 1);
  varargout = cell(1, nout);
  collected = cell(ngroups, nout);
  for k = 1:ngroups
    mask = (Gv == k);
    args = cell(1, numel(data));
    for d = 1:numel(data)
      col = data{d};
      args{d} = col(mask, :);
    end
    outs = cell(1, nout);
    [outs{1:nout}] = func(args{:});
    for o = 1:nout
      collected{k, o} = outs{o};
    end
  end
  for o = 1:nout
    if ngroups == 0
      varargout{o} = [];
    else
      varargout{o} = vertcat(collected{:, o});
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
