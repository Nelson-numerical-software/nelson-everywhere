%=============================================================================
function tf = isequalwithequalnans(obj, varargin)
  tf = true;
  for k = 1:length(varargin)
    other = varargin{k};
    tf = tf && istimeseries(other) ...
      && isequaln(obj.Data, other.Data) ...
      && isequaln(obj.Time, other.Time) ...
      && isequaln(obj.Quality, other.Quality);
  end
end
