function varargout = remove(varargin)
  narginchk(2, 2);
  nargoutchk(0, 1);
  obj = varargin{1};
  if ~isConfigured(obj)
    varargout{1} = obj;
    return
  end
  key = varargin{2};
  obj(key) = [];
  varargout{1} = obj;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
