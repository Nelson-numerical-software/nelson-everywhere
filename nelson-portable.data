function varargout = zticks(varargin)
  narginchk(0, 2);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [ax, args] = parseAxis(args);
  if isempty(args)
    varargout{1} = ax.ZTick;
    return
  end
  value = args{1};
  if ischar(value)
    switch lower(value)
      case 'mode'
        varargout{1} = ax.ZTickMode;
        return
      case 'auto'
        ax.ZTickMode = 'auto';
      case 'manual'
        ax.ZTickMode = 'manual';
      otherwise
        error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
    end
  elseif isnumeric(value)
    if ~isvector(value) && ~isempty(value)
      error('Nelson:graphics:invalidInput', 'Input must be a vector of numeric values.');
    end
    ax.ZTick = value(:)';
    ax.ZTickMode = 'manual';
  else
    error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
  end
  if nargout == 1
    error('Nelson:graphics:invalidOutputArgument', 'Invalid output argument.');
  end
end
