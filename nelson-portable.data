function run_writeRequestedReport(results, options)
  if ~isempty(options.Format) && ~isempty(options.OutputFile)
    nelson.unittest.report(results, 'Format', options.Format, 'OutputFile', options.OutputFile, ...
      'Verbose', options.Verbose);
  end
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
