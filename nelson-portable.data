%=============================================================================
R = sys * 2;
REF_A = [1 2;
  3 4];
REF_B = [2 0;
  0 2];
REF_C = ones(2, 2);
REF_D = [2 4;
  6 8];
REF = ss(REF_A, REF_B, REF_C, REF_D);
asserts.isequal(R, REF);
%=============================================================================
sysd = ss(A, B, C, D, 0.2);
R = ss(2) * sysd;
asserts.isequal(R.Ts, 0.2);
%=============================================================================
sysA = ss(1);
sysB = ss(2);
sysA.UserData = 'left';
sysB.UserData = 'right';
asserts.isequal((sysA * sysB).UserData, 'right');
%=============================================================================
sysA = ss(1);
sysB = ss(2);
sysA.OutputName = {'plant output'};
sysA.OutputUnit = {'meter'};
sysA.TimeUnit = 'milliseconds';
sysB.InputName = {'controller input'};
sysB.InputUnit = {'volt'};
sysB.TimeUnit = 'milliseconds';
