% LICENCE_BLOCK_END
%=============================================================================
function y = square(varargin)
  narginchk(1, 2);
  nargoutchk(0, 1);
  t = varargin{1};
  duty = 50;
  if nargin == 2
    duty = varargin{2};
  end
  phase = mod(t / (2 * pi), 1);
  y = ones(size(t));
  y(phase >= duty / 100) = -1;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
