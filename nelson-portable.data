%=============================================================================
function desc = getqualitydesc(obj, code)
  desc = {};
  if isempty(obj.QualityInfo.Code)
    return
  end
  for k = 1:numel(code)
    idx = find(obj.QualityInfo.Code == code(k), 1);
    if isempty(idx) || idx > numel(obj.QualityInfo.Description)
      desc{k, 1} = '';
    else
      desc{k, 1} = obj.QualityInfo.Description{idx};
    end
  end
end
