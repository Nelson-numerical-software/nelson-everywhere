% LICENCE_BLOCK_END
%=============================================================================
function modules = run_planModuleNames(cases)
  modules = {};
  for k = 1:length(cases)
    moduleName = run_planSuiteName(cases(k).module);
    if ~any(strcmp(modules, moduleName))
      modules = [modules; moduleName];
    end
  end
end
