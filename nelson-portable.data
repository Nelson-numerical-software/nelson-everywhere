% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function tf = isenum(x)
  narginchk(1, 1);
  nargoutchk(0, 1);
  tf = false;
  try
    mc = metaclass(x);
    tf = ~isempty(mc) && ~isempty(mc.EnumerationMemberList);
  catch
    tf = false;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
