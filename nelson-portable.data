function dy = odeVectorizedStiffRhs(t, y)
  global ODE_VECTORIZED_STIFF_COLUMNS;
  if isempty(ODE_VECTORIZED_STIFF_COLUMNS)
    ODE_VECTORIZED_STIFF_COLUMNS = [];
  end
  ODE_VECTORIZED_STIFF_COLUMNS(end + 1) = size(y, 2);
  dy = -100 * y;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
solinit = bvpinit(linspace(0, 1, 5), [0; 1]);
sol = bvp4c(@(x, y)[y(2); 0], @(ya, yb)[ya(1); yb(1) - 1], solinit, ...
  bvpset('RelTol', 1e-5, 'NMax', 100));
asserts.isequal(sol.solver, 'bvp4c');
asserts.istrue(max(abs(sol.y(1, :) - sol.x)) < 1e-4);
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
solinit = bvpinit(linspace(0, 1, 5), [0; 1]);
sol = bvp5c(@(x, y)[y(2); 0], @(ya, yb)[ya(1); yb(1) - 1], solinit, ...
  bvpset('RelTol', 1e-5, 'NMax', 100));
asserts.isequal(sol.solver, 'bvp5c');
asserts.istrue(max(abs(sol.y(1, :) - sol.x)) < 1e-4);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
options = bvpset('RelTol', 1e-5, 'AbsTol', 1e-7, 'NMax', 200);
asserts.istrue(isstruct(options));
asserts.isequal(bvpget(options, 'RelTol'), 1e-5);
asserts.isequal(bvpget(options, 'FJacobian', 7), 7);
%=============================================================================
linearInit = bvpinit(linspace(0, 1, 5), [0; 1]);
linearSol = bvp4c(@(x, y)[y(2); 0], @(ya, yb)[ya(1); yb(1) - 1], ...
  linearInit, options);
asserts.isequal(linearSol.solver, 'bvp4c');
asserts.isequal(linearSol.stats.nmeshpoints, length(linearSol.x));
asserts.istrue(isfield(linearSol.stats, 'maxDefect'));
asserts.istrue(isfield(linearSol.stats, 'rmsDefect'));
asserts.istrue(isfield(linearSol.stats, 'residualRms'));
asserts.istrue(max(abs(linearSol.y(1, :) - linearSol.x)) < 1e-4);
[linearY, linearYp] = deval(linearSol, [0.25 0.75]);
asserts.istrue(max(abs(linearY(1, :) - [0.25 0.75])) < 1e-4);
asserts.istrue(max(abs(linearYp(1, :) - 1)) < 1e-4);
%=============================================================================
analyticOptions = bvpset(options, 'FJacobian', @bvpTestLinearJacobian, ...
  'BCJacobian', @bvpTestLinearBcJacobian, 'SingularTerm', zeros(2));
analyticSol = bvp4c(@(x, y)[y(2); 0], @(ya, yb)[ya(1); yb(1) - 1], ...
  linearInit, analyticOptions);
asserts.istrue(max(abs(analyticSol.y(1, :) - analyticSol.x)) < 1e-4);
asserts.istrue(analyticSol.stats.residualNorm < 1e-5);
%=============================================================================
clear global BVP_VECTORIZED_CALL_SEEN;
global BVP_VECTORIZED_CALL_SEEN;
BVP_VECTORIZED_CALL_SEEN = false;
vectorizedOptions = bvpset(options, 'Vectorized', 'on');
vectorizedSol = bvp4c(@bvpTestVectorizedRhs, @(ya, yb)[ya(1); yb(1) - 1], ...
  linearInit, vectorizedOptions);
asserts.istrue(max(abs(vectorizedSol.y(1, :) - vectorizedSol.x)) < 1e-4);
asserts.istrue(BVP_VECTORIZED_CALL_SEEN);
%=============================================================================
paramInit = bvpinit(linspace(0, 1, 6), 1, 0.5);
paramSol = bvp4c(@(x, y, p) p(1) * y, @(ya, yb, p)[ya(1) - 1; yb(1) - 2], ...
  paramInit, options);
asserts.istrue(abs(paramSol.parameters(1) - log(2)) < 2e-3);
asserts.istrue(abs(paramSol.y(1, length(paramSol.x)) - 2) < 1e-5);
capabilities = __ode_sundials_capabilities__();
if isfield(capabilities, 'kinsol') && capabilities.kinsol
  asserts.istrue(paramSol.stats.nfevals > 0);
end
%=============================================================================
extended = bvpxtend(linearSol, linspace(0, 1, 9));
asserts.isequal(length(extended.x), 9);
asserts.istrue(max(abs(extended.y(1, :) - extended.x)) < 1e-4);
%=============================================================================
bratuInit = bvpinit(linspace(0, 1, 7), [0; 0]);
bratuSol = bvp5c(@(x, y)[y(2); -exp(y(1))], @(ya, yb)[ya(1); yb(1)], ...
  bratuInit, options);
asserts.isequal(bratuSol.solver, 'bvp5c');
asserts.isequal(bratuSol.stats.nmeshpoints, length(bratuSol.x));
asserts.istrue(bratuSol.stats.nrefinements >= 0);
asserts.istrue(isfinite(bratuSol.stats.maxDefect));
asserts.istrue(abs(bratuSol.y(1, 1)) < 1e-5);
asserts.istrue(abs(bratuSol.y(1, length(bratuSol.x))) < 1e-5);
bratuCenter = deval(bratuSol, 0.5);
asserts.istrue(abs(bratuCenter(1) - 0.14053921090765503) < 5e-4);
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
options = bvpset('RelTol', 1e-5);
asserts.isequal(bvpget(options, 'RelTol'), 1e-5);
% an unset property returns the caller-supplied default, not a baked-in value
asserts.isequal(bvpget(options, 'AbsTol', 1e-7), 1e-7);
asserts.isequal(bvpget(options, 'AbsTol'), []);
asserts.isequal(bvpget(bvpset(), 'NMax', 200), 200);
asserts.checkerror('bvpget(options, ''UnknownOption'')', sprintf(_('Unknown %s option name.'), 'BVP'));
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
solinit = bvpinit(linspace(0, 1, 4), [1; 2], 3);
asserts.isequal(solinit.x, [0 1 / 3 2 / 3 1]);
asserts.isequal(size(solinit.y), [2 4]);
asserts.isequal(solinit.parameters, 3);
asserts.checkerror('bvpinit([0 0], [1; 2])', _('Initial mesh must be strictly increasing.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
options = bvpset('RelTol', 1e-5, 'AbsTol', 1e-7, 'NMax', 200);
asserts.istrue(isstruct(options));
asserts.isequal(options.RelTol, 1e-5);
asserts.isequal(options.AbsTol, 1e-7);
asserts.isequal(options.NMax, 200);
asserts.checkerror('bvpset(''RelTol'')', _('Name-value arguments expected.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
solinit = bvpinit(linspace(0, 1, 5), [0; 1]);
sol = bvp4c(@(x, y)[y(2); 0], @(ya, yb)[ya(1); yb(1) - 1], solinit, ...
  bvpset('RelTol', 1e-5, 'NMax', 100));
extended = bvpxtend(sol, linspace(0, 1, 9));
asserts.isequal(length(extended.x), 9);
asserts.istrue(max(abs(extended.y(1, :) - extended.x)) < 1e-4);
asserts.checkerror('bvpxtend(sol, [-0.1 0.5])', ...
  _('Extended mesh outside the solution interval requires an initial guess.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
sol = dde23(@(t, y, z) - y + z, 0.1, 1, [0 0.2], ddeset('MaxStep', 0.02));
asserts.isequal(sol.solver, 'dde23');
asserts.istrue(abs(sol.y(1, length(sol.x)) - 1) < 1e-8);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
options = ddeset('RelTol', 1e-5, 'AbsTol', 1e-7);
asserts.istrue(isstruct(options));
asserts.isequal(ddeget(options, 'RelTol'), 1e-5);
asserts.isequal(ddeget(options, 'InitialStep', 3), 3);
initialOptions = ddeset(options, 'InitialY', 2, 'Jumps', 0.1);
asserts.isequal(ddeget(initialOptions, 'InitialY'), 2);
asserts.isequal(ddeget(initialOptions, 'Jumps'), 0.1);
%=============================================================================
sol = dde23(@(t, y, z) - y + z, 0.1, 1, [0 0.2], options);
asserts.isequal(sol.solver, 'dde23');
asserts.istrue(isfield(sol, 'yp'));
asserts.istrue(sol.stats.nchunks >= 1);
asserts.istrue(abs(sol.y(1, length(sol.x)) - 1) < 1e-8);
[yq, ypq] = deval(sol, 0.1);
asserts.istrue(abs(yq(1) - 1) < 1e-8);
asserts.istrue(abs(ypq(1)) < 1e-6);
initialSol = dde23(@(t, y, z) - y + z, 0.1, 1, [0 0.05], initialOptions);
asserts.isequal(initialSol.y(1, 1), 2);
jumpSol = dde23(@(t, y, z) - y + z, 0.1, 1, [0 0.2], ddeset(options, 'Jumps', 0.1));
asserts.istrue(any(abs(jumpSol.x - 0.1) < 1e-12));
continuedSol = dde23(@(t, y, z) - y + z, 0.1, sol, [0.2 0.3], options);
asserts.istrue(abs(continuedSol.y(1, 1) - 1) < 1e-8);
asserts.istrue(abs(continuedSol.y(1, length(continuedSol.x)) - 1) < 1e-8);
%=============================================================================
eventOptions = ddeset('Events', @ddeTestEventThreshold, 'MaxStep', 0.02);
eventSol = dde23(@(t, y, z) - y, 0.1, 1, [0 1], eventOptions);
asserts.istrue(isfield(eventSol, 'xe'));
asserts.istrue(abs(eventSol.xe(1) + log(0.9)) < 2e-2);
asserts.isequal(eventSol.ie(1), 1);
%=============================================================================
stateDelay = @(t, y) t - 0.05 + 0 * y(1);
stateSol = ddesd(@(t, y, z) - y + z, stateDelay, 1, [0 0.2], options);
asserts.isequal(stateSol.solver, 'ddesd');
asserts.istrue(abs(stateSol.y(1, length(stateSol.x)) - 1) < 1e-8);
%=============================================================================
neutralDelay = @(t, y) t - 0.05 + 0 * y(1);
neutralSol = ddensd(@(t, y, z, zp) - y + z + 0 * zp, neutralDelay, neutralDelay, ...
  1, [0 0.2], options);
asserts.isequal(neutralSol.solver, 'ddensd');
asserts.istrue(abs(neutralSol.y(1, length(neutralSol.x)) - 1) < 1e-8);
asserts.istrue(abs(neutralSol.yp(1, length(neutralSol.x))) < 1e-6);
neutralCellSol = ddensd(@(t, y, z, zp) - y + z + 0 * zp, neutralDelay, neutralDelay, ...
  {1, 0}, [0 0.2], options);
asserts.istrue(abs(neutralCellSol.y(1, 1) - 1) < 1e-8);
asserts.istrue(abs(neutralCellSol.yp(1, 1)) < 1e-8);
