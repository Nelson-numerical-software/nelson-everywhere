% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
classdef dictionary
  properties (Hidden)
    map
    allKeys
    allValues
    keyType
    valueType
  end

  methods
    function obj = dictionary(varargin)
      obj.map = struct();
      obj.allKeys = {};
      obj.allValues = {};
      obj.keyType = '';
      obj.valueType = '';

      if nargin == 0
        return
      end

      if nargin == 1
        inputValue = varargin{1};
        if isa(inputValue, 'py.dict')
          obj = dictionary.convertPyDictToDictionary(inputValue);
          return
        end
        if isa(inputValue, 'jl') && startsWith(inputValue.typeof, 'Dict{')
          obj = dictionary.convertJlDictToDictionary(inputValue);
          return
        end
        if ~isa(inputValue, 'dictionary')
          error('Nelson:dictionary:IncorrectNumberOfInputs', 'Incorrect number of input arguments. Each key must be followed by a value.');
        end
        obj.map = inputValue.map;
        obj.allKeys = inputValue.allKeys;
        obj.allValues = inputValue.allValues;
        obj.keyType = inputValue.keyType;
        obj.valueType = inputValue.valueType;
        return
      end

      if mod(nargin, 2) ~= 0
        error('Nelson:dictionary:IncorrectNumberOfInputs', 'Incorrect number of input arguments. Each key must be followed by a value.');
      end

      for p = 1:2:numel(varargin)
        keyInput = varargin{p};
        valueInput = varargin{p + 1};
        if ischar(keyInput)
          keyInput = convertCharsToStrings(keyInput);
        end
        if ischar(valueInput)
          valueInput = convertCharsToStrings(valueInput);
        end
        if numel(keyInput) ~= numel(valueInput) && numel(valueInput) ~= 1
          error('Nelson:dictionary:IncorrectNumberOfInputs', 'Incorrect number of input arguments. Each key must be followed by a value.');
        end
        if isempty(obj.keyType)
          obj.keyType = class(keyInput);
          obj.valueType = class(valueInput);
        end

        for i = 1:numel(keyInput)
          currentKey = keyInput(i);
          if ~isa(currentKey, obj.keyType)
            currentKey = convertDataType(obj.keyType, currentKey);
          end
          h = dec2hex(keyHash(currentKey));
          keyIndex = dictionary.findKeyIndex(obj, currentKey);
          if keyIndex == 0
            obj.allKeys{end + 1} = currentKey;
            keyIndex = numel(obj.allKeys);
          end
          if numel(valueInput) == 1
            value = dictionary.castValue(obj.valueType, valueInput);
          else
            value = dictionary.castValue(obj.valueType, valueInput(i));
          end
          obj.allValues{keyIndex} = value;
          obj.map.(h) = value;
        end
      end
    end

    varargout = subsref(obj, s)
    obj = subsasgn(obj, s, val)
    varargout = insert(varargin)
    varargout = lookup(varargin)
    varargout = isKey(varargin)
    varargout = remove(varargin)
    varargout = isequal(varargin)
    varargout = isequalto(varargin)
    varargout = ndims(varargin)
    disp(varargin)
    display(varargin)

    function n = numel(varargin)
      n = 1;
    end

    function n = length(varargin)
      n = 1;
    end

    function varargout = size(varargin)
      sz = [1 1];
      if nargin == 1
        if nargout <= 1
          varargout{1} = sz;
        else
          for k = 1:nargout
            if k <= length(sz)
              varargout{k} = sz(k);
            else
              varargout{k} = 1;
            end
          end
        end
      else
        dim = varargin{2};
        if dim <= length(sz)
          varargout{1} = sz(dim);
        else
          varargout{1} = 1;
        end
      end
    end

    function n = end(varargin)
      n = 1;
    end

    function varargout = properties(varargin)
      properties_list = {};
      if nargout == 1
        varargout{1} = properties_list;
        return
      end
      fmt = format();
      if strcmp(fmt.LineSpacing, 'loose')
        fprintf('\n')
      end
      fprintf([_('Properties for class %s:'), '\n'], class(varargin{1}))
      if strcmp(fmt.LineSpacing, 'loose')
        fprintf('\n')
      end
      if strcmp(fmt.LineSpacing, 'loose')
        fprintf('\n')
      end
    end

    function varargout = methods(varargin)
      methods_list = {'dictionary'; 'entries'; 'insert'; 'isConfigured'; 'isKey'; 'keys'; ...
        'length'; 'lookup'; 'ndims'; 'numEntries'; 'numel'; 'remove'; 'size'; ...
        'types'; 'values'};
      if nargout == 1
        varargout{1} = methods_list;
        return
      end
      fmt = format();
      if strcmp(fmt.LineSpacing, 'loose')
        fprintf('\n')
      end
      fprintf([_('Methods for class %s:'), '\n'], class(varargin{1}))
      if strcmp(fmt.LineSpacing, 'loose')
        fprintf('\n')
      end
      for e = methods_list'
        fprintf('    %s\n', e{1});
      end
      if strcmp(fmt.LineSpacing, 'loose')
        fprintf('\n')
      end
    end

    function value = struct(varargin)
      error('Nelson:dictionary:cannotConvertToStruct', 'Conversion to struct from dictionary is not possible.');
    end
  end

  methods (Static, Hidden)
    function obj = fromState(map, allKeys, keyType, valueType, allValues)
      obj = dictionary();
      obj.map = map;
      obj.allKeys = allKeys;
      if nargin < 5
        obj.allValues = dictionary.valuesFromMap(map, allKeys);
      else
        obj.allValues = allValues;
      end
      obj.keyType = keyType;
      obj.valueType = valueType;
    end

    function idx = findKeyIndex(obj, key)
      idx = 0;
      for k = 1:numel(obj.allKeys)
        storedKey = dictionary.normalizeStoredKey(obj, obj.allKeys{k});
        try
          if keyMatch(storedKey, key)
            idx = k;
            return
          end
        catch
          if isequal(storedKey, key)
            idx = k;
            return
          end
        end
      end
    end

    function value = valueAt(obj, idx)
      if ~isempty(obj.allValues) && idx >= 1 && idx <= numel(obj.allValues)
        value = dictionary.normalizeStoredValue(obj, obj.allValues{idx});
        return
      end
      key = dictionary.normalizeStoredKey(obj, obj.allKeys{idx});
      h = dec2hex(keyHash(key));
      value = dictionary.normalizeStoredValue(obj, obj.map.(h));
    end

    function map = mapFromKeysValues(allKeys, allValues)
      map = struct();
      for k = 1:numel(allKeys)
        h = dec2hex(keyHash(allKeys{k}));
        map.(h) = allValues{k};
      end
    end

    function key = normalizeStoredKey(obj, key)
      if ~strcmp(obj.keyType, 'cell') && iscell(key) && isscalar(key)
        key = key{1};
      end
      if ~isempty(obj.keyType) && ~isa(key, obj.keyType)
        key = convertDataType(obj.keyType, key);
      end
    end

    function value = normalizeStoredValue(obj, value)
      if strcmp(obj.valueType, 'cell')
        return
      end
      if iscell(value) && isscalar(value)
        value = value{1};
      end
      if ~isempty(obj.valueType) && ~isa(value, obj.valueType)
        value = convertDataType(obj.valueType, value);
      end
    end
  end

  methods (Static, Access = private)
    function allValues = valuesFromMap(map, allKeys)
      allValues = cell(size(allKeys));
      for k = 1:numel(allKeys)
        h = dec2hex(keyHash(allKeys{k}));
        if isfield(map, h)
          allValues{k} = map.(h);
        else
          allValues{k} = [];
        end
      end
    end

    function value = castValue(valueType, value)
      if isa(value, valueType)
        return
      end
      value = convertDataType(valueType, value);
    end

    function obj = convertJlDictToDictionary(inputValue)
      error('Nelson:dictionary:notmanaged', 'Julia dictionary is not supported.');
    end

    function obj = convertPyDictToDictionary(inputValue)
      obj = dictionary();
      keyType = pyrun("key_type = type(next(iter(A.keys()))).__name__", "key_type", "A", inputValue);
      pythonKeyType = keyType.char();
      st = struct(inputValue);
      names = string(fieldnames(st));
      for i = 1:numel(names)
        key = names(i);
        value = st.(key);
        if i == 1
          if strcmp(pythonKeyType, 'float')
            obj.keyType = 'double';
          else
            obj.keyType = class(key);
          end
          obj.valueType = class(value);
          if strcmp(obj.valueType, 'py.str')
            obj.valueType = 'string';
          end
        end
        if ~isa(key, obj.keyType)
          key = convertDataType(obj.keyType, key);
        end
        h = dec2hex(keyHash(key));
        keyIndex = dictionary.findKeyIndex(obj, key);
        if keyIndex == 0
          obj.allKeys{end + 1} = key;
          keyIndex = numel(obj.allKeys);
        end
        if numel(value) == 1
          storedValue = dictionary.castValue(obj.valueType, value);
        else
          storedValue = dictionary.castValue(obj.valueType, value(i));
        end
        obj.allValues{keyIndex} = storedValue;
        obj.map.(h) = storedValue;
      end
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function disp(varargin)
  narginchk(1, 1);
  fmt = format();
  LineSpacing = fmt.LineSpacing;
  obj = varargin{1};
  if (~isConfigured(obj))
    fprintf(['\n  ', _('dictionary object not configured.'), '\n\n']);
    return
  end
  if (numEntries(obj) == 0)
    fprintf('\n  dictionary (%s ⟼ %s) with no entries.\n\n', obj.keyType, obj.valueType);
    return
  end
  if (numEntries(obj) == 1)
    entry_str = 'entry';
  else
    entry_str = 'entries';
  end
  if strcmp(LineSpacing, 'loose')
    msgfmt = '\n  dictionary (%s ⟼ %s) with %d %s:\n\n';
  else
    msgfmt = '  dictionary (%s ⟼ %s) with %d %s:\n';
  end
  fprintf(msgfmt, obj.keyType, obj.valueType, numEntries(obj), entry_str);
  allKeys = obj.allKeys;
  for i = 1:numEntries(obj)
    key = allKeys{i};
    val = dictionary.valueAt(obj, i);
    key = strtrim(evalc('disp(key)'));
    if strcmp(obj.keyType, 'string')
      key = ['"', key, '"'];
    end
    if strcmp(obj.keyType, 'char')
      key = ['''', key, ''''];
    end
    if isstring(val) && isrow(val)
      nbmax = 42;
      if strlength(val) > nbmax
        aschar = char(val);
        val = [aschar(1:nbmax), '…'];
      end
      valstr = """" + val + """";
    else
      valstr = strtrim(formattedDisplayText(val, 'LineSpacing', LineSpacing));
    end
    if (length(strfind(valstr, char(10))) > 1)
      valstr = getHeaderClassToString(val);
    end
    fprintf("  %s ⟼ %s\n", key, valstr);
  end
  if strcmp(LineSpacing, 'loose')
    fprintf("\n");
  end
end
%=============================================================================
function str = getHeaderClassToString(obj)
  dimensions = size(obj);
  typeName = class(obj);
  str = '';
  for i = 1:numel(dimensions)
    str = [str, sprintf('%d', dimensions(i))];
    if i < numel(dimensions)
      str = [str, '×'];
    end
  end
  str = [str, ' ', typeName];
end
