%=============================================================================
function varargout = datetimeSizeValue(serialValue, requestedOutputs, varargin)
  if isempty(varargin)
    if requestedOutputs <= 1
      varargout{1} = size(serialValue);
    else
      [varargout{1:requestedOutputs}] = size(serialValue);
    end
  else
    varargout{1} = size(serialValue, varargin{1});
  end
end
