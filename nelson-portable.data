% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function poles = signalButterPrototypePoles(n)
  imaginaryUnit = complex(0, 1);
  poles = zeros(n, 1);
  for k = 1:n
    theta = pi * (2 * k + n - 1) / (2 * n);
    poles(k) = exp(imaginaryUnit * theta);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = signalChebpoly(n, x)
  y = zeros(size(x));
  inside = abs(x) <= 1;
  y(inside) = cos(n * acos(x(inside)));
  above = x > 1;
  y(above) = cosh(n * acosh(x(above)));
  below = x < -1;
  y(below) = ((-1) ^ n) * cosh(n * acosh(-x(below)));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function poles = signalCheby1PrototypePoles(n, rp)
  epsilon = sqrt(10 ^ (rp / 10) - 1);
  mu = asinh(1 / epsilon) / n;
  poles = zeros(n, 1);
  for k = 1:n
    theta = pi * (2 * k - 1) / (2 * n);
    poles(k) = -sinh(mu) * sin(theta) + 1i * cosh(mu) * cos(theta);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [zerosArray, poles] = signalCheby2Prototype(n, rs)
  epsilon = 1 / sqrt(10 ^ (rs / 10) - 1);
  mu = asinh(1 / epsilon) / n;
  zerosArray = [];
  poles = zeros(n, 1);
  for k = 1:n
    theta = pi * (2 * k - 1) / (2 * n);
    pole = -sinh(mu) * sin(theta) + 1i * cosh(mu) * cos(theta);
    poles(k) = 1 / pole;
    c = cos(theta);
    if abs(c) > eps()
      zerosArray = [zerosArray; 1i / c];
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = signalDecimateFir(x, q, n)
  wasRow = size(x, 1) == 1;
  xv = x(:).';
  b = fir1(n, 1 / q);
  filtered = conv(xv, b);
  outputLength = ceil(length(xv) / q);
  delay = floor(n / 2);
  indices = delay + 1:q:delay + 1 + (outputLength - 1) * q;
  y = filtered(indices);
  if mod(n, 2) == 0
    y(1) = xv(1);
  end
  if ~wasRow
    y = y.';
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = signalDecimateIir(x, q, n)
  if length(x) <= 3 * n
    error('Nelson:signal:decimate:dataTooShort', 'Data length must be greater than three times the filter order.');
  end
  [b, a] = cheby1(n, 0.05, 0.8 / q);
  y = downsample(filtfilt(b, a, x), q, q - 1);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function z = signalEllipArcSc1(w, m)
  mc = 1 - m;
  lo = 0;
  hi = signalEllipke(mc) * (1 - 10 * eps());
  for idx = 1:80
    mid = (lo + hi) / 2;
    [s, c] = signalEllipj(mid, mc);
    if real(s / c) < w
      lo = mid;
    else
      hi = mid;
    end
  end
  z = (lo + hi) / 2;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function m = signalEllipDegree(n, m1)
  k1 = signalEllipke(m1);
  k1p = signalEllipke(1 - m1);
  q = exp(-pi * k1p / (n * k1));
  numerator = 0;
  denominator = 1;
  for idx = 0:7
    numerator = numerator + q ^ (idx * (idx + 1));
    denominator = denominator + 2 * q ^ ((idx + 1) ^ 2);
  end
  m = 16 * q * (numerator / denominator) ^ 4;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [z, p] = signalEllipPrototype(n, rp, rs)
  if n == 1
    z = [];
    p = -sqrt(1 / (10 ^ (rp / 10) - 1));
    return;
  end
  epsilon2 = 10 ^ (rp / 10) - 1;
  ck12 = epsilon2 / (10 ^ (rs / 10) - 1);
  m = signalEllipDegree(n, ck12);
  capk = signalEllipke(m);
  j = 1 - mod(n, 2):2:n - 1;
  [s, c, d] = signalEllipj(j * capk / n, m);
  snew = s(abs(s) > eps());
  z = 1i ./ (sqrt(m) * snew(:));
  z = [z; conj(z)];
  r = signalEllipArcSc1(1 / sqrt(epsilon2), ck12);
  v0 = capk * r / (n * signalEllipke(ck12));
  [sv, cv, dv] = signalEllipj(v0, 1 - m);
  p = -(c(:) .* d(:) * sv * cv + 1i * s(:) * dv) ./ (1 - (d(:) * sv) .^ 2);
  if mod(n, 2) == 1
    keep = abs(imag(p)) > eps() * sqrt(sum(real(p .* conj(p))));
    p = [p; conj(p(keep))];
  else
    p = [p; conj(p)];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [sn, cn, dn] = signalEllipj(u, m)
  k = signalEllipke(m);
  kp = signalEllipke(1 - m);
  q = exp(-pi * kp / k);
  v = pi * u / (2 * k);
  theta20 = signalTheta2(0, q);
  theta30 = signalTheta3(0, q);
  theta40 = signalTheta4(0, q);
  theta4v = signalTheta4(v, q);
  sn = (theta30 / theta20) * signalTheta1(v, q) ./ theta4v;
  cn = (theta40 / theta20) * signalTheta2(v, q) ./ theta4v;
  dn = (theta40 / theta30) * signalTheta3(v, q) ./ theta4v;
end
%=============================================================================
function y = signalTheta1(v, q)
  y = zeros(size(v));
  for n = 0:40
    term = 2 * ((-1) ^ n) * q ^ ((n + 0.5) ^ 2) * sin((2 * n + 1) * v);
    y = y + term;
    if max(abs(term)) <= 1e-15
      break;
    end
  end
end
%=============================================================================
function y = signalTheta2(v, q)
  y = zeros(size(v));
  for n = 0:40
    term = 2 * q ^ ((n + 0.5) ^ 2) * cos((2 * n + 1) * v);
    y = y + term;
    if max(abs(term)) <= 1e-15
      break;
    end
  end
end
%=============================================================================
function y = signalTheta3(v, q)
  y = ones(size(v));
  for n = 1:40
    term = 2 * q ^ (n ^ 2) * cos(2 * n * v);
    y = y + term;
    if max(abs(term)) <= 1e-15
      break;
    end
  end
end
%=============================================================================
function y = signalTheta4(v, q)
  y = ones(size(v));
  for n = 1:40
    term = 2 * ((-1) ^ n) * q ^ (n ^ 2) * cos(2 * n * v);
    y = y + term;
    if max(abs(term)) <= 1e-15
      break;
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function k = signalEllipke(m)
  a = 1;
  b = sqrt(1 - m);
  for idx = 1:32
    nextA = (a + b) / 2;
    b = sqrt(a * b);
    a = nextA;
    if abs(a - b) <= eps() * max(1, abs(a))
      break;
    end
  end
  k = pi / (2 * a);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function width = signalFrequencyBinWidth(f)
  f = f(:);
  if length(f) < 2
    error('Nelson:signal:invalidFrequencyVector', 'Frequency vector must contain at least two elements.');
  end
  missingWidth = (f(end) - f(1)) / (length(f) - 1);
  if f(1) ~= 0
    width = [missingWidth; diff(f)];
  else
    width = [diff(f); missingWidth];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function h = signalFrequencyResponse(b, a, w)
  imaginaryUnit = complex(0, 1);
  b = b(:).';
  a = a(:).';
  kB = 0:length(b) - 1;
  kA = 0:length(a) - 1;
  originalShape = size(w);
  w = w(:);
  h = zeros(size(w));
  for idx = 1:length(w)
    numerator = sum(b .* exp(-imaginaryUnit * w(idx) * kB));
    denominator = sum(a .* exp(-imaginaryUnit * w(idx) * kA));
    h(idx) = numerator ./ denominator;
  end
  h = reshape(h, originalShape);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [digitalZeros, digitalPoles, gain, b, a] = signalIirPrototypeToDigital(z, p, n, rp, wn, ftype)
  if mod(n, 2) == 0
    targetGain = 10 ^ (-rp / 20);
  else
    targetGain = 1;
  end
  if length(wn) == 1
    [az, ap, appendInf, normalizeAt] = signalIirScalarTransform(z, p, n, wn, ftype);
  else
    [az, ap, appendInf, normalizeAt] = signalIirBandTransform(z, p, n, wn, ftype);
  end
  digitalZeros = (1 + az / 2) ./ (1 - az / 2);
  digitalPoles = (1 + ap / 2) ./ (1 - ap / 2);
  if appendInf > 0
    digitalZeros = [digitalZeros; -ones(appendInf, 1)];
  end
  b = real(poly(digitalZeros));
  a = real(poly(digitalPoles));
  gain = targetGain * abs(polyval(a, normalizeAt) / polyval(b, normalizeAt));
  b = b * gain;
end
%=============================================================================
function [az, ap, appendInf, normalizeAt] = signalIirScalarTransform(z, p, n, wn, ftype)
  if ~(isempty(ftype) || strcmpi(ftype, 'low') || strcmpi(ftype, 'high'))
    error('Nelson:signal:cutoffScalarLowpassHighpass', 'Cutoff frequency must be a scalar for lowpass and highpass filters.');
  end
  warped = 2 * tan(pi * wn / 2);
  if strcmpi(ftype, 'high')
    az = warped ./ z(:);
    az = [az; zeros(n - length(z), 1)];
    ap = warped ./ p(:);
    appendInf = 0;
    normalizeAt = -1;
  else
    az = warped * z(:);
    ap = warped * p(:);
    appendInf = n - length(z);
    normalizeAt = 1;
  end
end
%=============================================================================
function [az, ap, appendInf, normalizeAt] = signalIirBandTransform(z, p, n, wn, ftype)
  if ~(isempty(ftype) || strcmpi(ftype, 'bandpass') || strcmpi(ftype, 'pass') || strcmpi(ftype, 'stop'))
    error('Nelson:signal:cutoffVectorBandpassBandstop', 'Cutoff frequency must be a two-element vector for bandpass and bandstop filters.');
  end
  warped = 2 * tan(pi * wn(:).' / 2);
  bandwidth = warped(2) - warped(1);
  center = sqrt(warped(1) * warped(2));
  ap = signalMapBandPoles(p, bandwidth, center, strcmpi(ftype, 'stop'));
  if strcmpi(ftype, 'stop')
    az = signalMapBandPoles(z, bandwidth, center, true);
    missing = n - length(z);
    az = [az; 1i * center * ones(missing, 1); -1i * center * ones(missing, 1)];
    appendInf = 0;
    normalizeAt = 1;
  else
    az = signalMapBandPoles(z, bandwidth, center, false);
    az = [az; zeros(n - length(z), 1)];
    appendInf = n - length(z);
    normalizeAt = exp(1i * 2 * atan(center / 2));
  end
end
%=============================================================================
function mapped = signalMapBandPoles(values, bandwidth, center, isStop)
  mapped = [];
  for idx = 1:length(values)
    if isStop
      mapped = [mapped; roots([values(idx), -bandwidth, values(idx) * center ^ 2])];
    else
      mapped = [mapped; roots([1, -bandwidth * values(idx), center ^ 2])];
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function h = signalIntfilt(r, n, alpha)
  order = 2 * r * n - 2;
  halfOrder = order / 2;
  [f, m] = interpolationBands(r, alpha);
  gram = zeros(halfOrder + 1, halfOrder + 1);
  rhs = zeros(halfOrder + 1, 1);
  for bandIndex = 1:2:length(f)
    a = f(bandIndex);
    b = f(bandIndex + 1);
    bandGain = m(bandIndex);
    for row = 0:halfOrder
      rhs(row + 1) = rhs(row + 1) + bandGain * cosineIntegral(row, a, b);
      for col = 0:halfOrder
        gram(row + 1, col + 1) = gram(row + 1, col + 1) + cosineProductIntegral(row, col, a, b);
      end
    end
  end
  coeffs = gram \ rhs;
  h = zeros(1, order + 1);
  center = halfOrder + 1;
  h(center) = coeffs(1);
  for k = 1:halfOrder
    value = coeffs(k + 1) / 2;
    h(center - k) = value;
    h(center + k) = value;
  end
end
%=============================================================================
function [f, m] = interpolationBands(r, alpha)
  if alpha == 1
    f = [0, 1 / r, 1 / r, 1];
    m = [r, r, 0, 0];
    return;
  end
  f = [0, alpha / r];
  m = [r, r];
  imageCenter = 1 / r;
  while imageCenter <= 0.5 + eps
    f = [f, 2 * (imageCenter - alpha / (2 * r)), 2 * (imageCenter + alpha / (2 * r))];
    m = [m, 0, 0];
    imageCenter = imageCenter + 1 / r;
  end
  if f(end) > 1
    f(end) = 1;
  end
end
%=============================================================================
function value = cosineProductIntegral(i, j, a, b)
  if i == 0 && j == 0
    value = b - a;
  elseif i == 0
    value = cosineIntegral(j, a, b);
  elseif j == 0
    value = cosineIntegral(i, a, b);
  else
    value = (cosineIntegral(abs(i - j), a, b) + cosineIntegral(i + j, a, b)) / 2;
  end
end
%=============================================================================
function value = cosineIntegral(k, a, b)
  if k == 0
    value = b - a;
  else
    value = (sin(k * pi * b) - sin(k * pi * a)) / (k * pi);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [fmean, pwr] = signalMeanfreqFromPsd(pxx, f, freqRange)
  f = f(:);
  if isempty(freqRange)
    freqRange = [f(1), f(end)];
  end
  width = signalFrequencyBinWidth(f);
  power = pxx .* width;
  idx = f >= freqRange(1) & f <= freqRange(2);
  selectedPower = power(idx, :);
  selectedFreq = f(idx);
  pwr = sum(selectedPower, 1);
  fmean = sum(selectedPower .* selectedFreq, 1) ./ pwr;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [fm, pwr] = signalMedfreqFromPsd(pxx, f, freqRange)
  f = f(:);
  if isempty(freqRange)
    freqRange = [f(1), f(end)];
  end
  width = signalFrequencyBinWidth(f);
  cumulativeFrequency = [f(1); (f(1:end - 1) + f(2:end)) / 2; f(end)];
  fm = zeros(1, size(pxx, 2));
  pwr = zeros(1, size(pxx, 2));
  for col = 1:size(pxx, 2)
    power = width .* pxx(:, col);
    cumulativePower = [0; cumsum(power)];
    lowPower = interp1(cumulativeFrequency, cumulativePower, freqRange(1), 'linear');
    highPower = interp1(cumulativeFrequency, cumulativePower, freqRange(2), 'linear');
    pwr(col) = highPower - lowPower;
    fm(col) = interp1(cumulativePower, cumulativeFrequency, (lowPower + highPower) / 2, 'linear');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = signalMedian(x)
  x = x(:);
  n = length(x);
  if n == 0
    y = NaN;
    return;
  end
  for i = 2:n
    value = x(i);
    j = i - 1;
    while j >= 1 && x(j) > value
      x(j + 1) = x(j);
      j = j - 1;
    end
    x(j + 1) = value;
  end
  if mod(n, 2) == 1
    y = x((n + 1) / 2);
  else
    y = (x(n / 2) + x(n / 2 + 1)) / 2;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [m, N] = signalParseWindowLengthAndOption(args)
  m = args{1};
  signalValidateWindowLength(m);
  N = m - 1;
  if length(args) == 2
    opt = args{2};
  else
    opt = 'symmetric';
  end
  if strcmp(opt, 'periodic')
    N = m;
  elseif ~(strcmp(opt, 'symmetric') || strcmp(opt, 'symmetric'))
    error('Nelson:signal:invalidWindowType', '%s expected.', '"periodic" or "symmetric"');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [pxx, f] = signalPeriodogramCore(x, win, nfft, fs, range, spectrumType)
  if nargin < 5
    range = '';
  end
  if nargin < 6
    spectrumType = 'psd';
  end
  x = x(:);
  if isempty(win)
    win = ones(length(x), 1);
  elseif isscalar(win)
    win = rectwin(win);
  else
    win = win(:);
  end
  x = x(1:min(length(x), length(win)));
  win = win(1:length(x));
  if isempty(nfft)
    nfft = max(256, 2 ^ nextpow2(length(x)));
  end
  xw = x .* win;
  padded = zeros(nfft, 1);
  padded(1:length(xw)) = xw;
  xdft = fft(padded);
  scale = fs * sum(abs(win) .^ 2);
  rawPxx = abs(xdft) .^ 2 ./ scale;
  if strcmp(spectrumType, 'power')
    rawPxx = rawPxx .* scale ./ (abs(sum(win)) .^ 2);
  end
  [pxx, f] = signalSpectrumRange(rawPxx, nfft, fs, range, isreal(x));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [s, f, t] = signalSpectrogramCore(x, window, overlap, nfft, fs)
  step = length(window) - overlap;
  starts = 1:step:(length(x) - length(window) + 1);
  frames = zeros(length(window), length(starts));
  for idx = 1:length(starts)
    frames(:, idx) = x(starts(idx):starts(idx) + length(window) - 1) .* window;
  end
  padded = zeros(nfft, length(starts));
  padded(1:size(frames, 1), :) = frames;
  s = fft(padded, nfft, 1);
  keep = 1:floor(nfft / 2) + 1;
  s = s(keep, :);
  f = (keep(:) - 1) * fs / nfft;
  t = (starts(:) + length(window) / 2 - 1) / fs;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [spectrum, f] = signalSpectrumRange(rawSpectrum, nfft, fs, range, useRealSymmetry)
  if strcmp(range, 'half')
    range = 'onesided';
  elseif strcmp(range, 'whole')
    range = 'twosided';
  end
  if isempty(range)
    if useRealSymmetry
      range = 'onesided';
    else
      range = 'twosided';
    end
  end
  if strcmp(range, 'onesided') && useRealSymmetry
    [spectrum, f] = localOnesided(rawSpectrum, nfft, fs);
  elseif strcmp(range, 'centered') && useRealSymmetry
    [spectrum, f] = localCenteredReal(rawSpectrum, nfft, fs);
  else
    [spectrum, f] = localTwosided(rawSpectrum, nfft, fs, range);
  end
end
%=============================================================================
function [spectrum, f] = localOnesided(rawSpectrum, nfft, fs)
  if mod(nfft, 2) == 0
    select = 1:nfft / 2 + 1;
    spectrum = rawSpectrum(select);
    spectrum(2:end - 1) = 2 * spectrum(2:end - 1);
  else
    select = 1:(nfft + 1) / 2;
    spectrum = rawSpectrum(select);
    spectrum(2:end) = 2 * spectrum(2:end);
  end
  f = (select(:) - 1) * fs / nfft;
end
%=============================================================================
function [spectrum, f] = localCenteredReal(rawSpectrum, nfft, fs)
  if mod(nfft, 2) == 0
    positive = rawSpectrum(1:nfft / 2 + 1);
    spectrum = [positive(nfft / 2:-1:2); positive(1); positive(2:nfft / 2); positive(end)];
    f = ([-(nfft / 2 - 1):-1, 0:nfft / 2].') * fs / nfft;
  else
    positive = rawSpectrum(1:(nfft + 1) / 2);
    spectrum = [positive(end:-1:2); positive];
    f = ([-floor(nfft / 2):-1, 0:floor(nfft / 2)].') * fs / nfft;
  end
end
%=============================================================================
function [spectrum, f] = localTwosided(rawSpectrum, nfft, fs, range)
  if strcmp(range, 'centered')
    spectrum = fftshift(rawSpectrum);
    if mod(nfft, 2) == 0
      f = (-nfft / 2:nfft / 2 - 1)' * fs / nfft;
    else
      f = (-(nfft - 1) / 2:(nfft - 1) / 2)' * fs / nfft;
    end
  else
    spectrum = rawSpectrum;
    f = (0:nfft - 1)' * fs / nfft;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [s, f, t] = signalStftCore(x, window, overlapLength, fftLength, fs, frequencyRange)
  if nargin < 6
    frequencyRange = 'centered';
  end
  window = window(:);
  step = length(window) - overlapLength;
  starts = 1:step:(length(x) - length(window) + 1);
  s = zeros(fftLength, length(starts));
  for idx = 1:length(starts)
    frame = x(starts(idx):starts(idx) + length(window) - 1) .* window;
    padded = zeros(fftLength, 1);
    padded(1:length(frame)) = frame;
    s(:, idx) = fft(padded);
  end
  if strcmpi(frequencyRange, 'onesided')
    keep = 1:floor(fftLength / 2) + 1;
    s = s(keep, :);
    f = (keep(:) - 1) * fs / fftLength;
  elseif strcmpi(frequencyRange, 'twosided')
    f = (0:fftLength - 1)' * fs / fftLength;
  else
    negativeCount = floor((fftLength - 1) / 2);
    if mod(fftLength, 2) == 0
      order = [negativeCount + 3:fftLength, 1:negativeCount + 2];
    else
      order = [negativeCount + 2:fftLength, 1:negativeCount + 1];
    end
    s = s(order, :);
    f = (-negativeCount:fftLength - negativeCount - 1)' * fs / fftLength;
  end
  t = (starts(:) + length(window) / 2 - 1) / fs;
end
