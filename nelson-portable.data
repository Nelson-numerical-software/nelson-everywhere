function y = deg2rad(varargin)
  narginchk(1, 1);
  nargoutchk(0, 1);
  x = varargin{1};
  if isfloat(x)
    y = (pi / 180) * x;
  else
    error('Nelson:trigonometric_functions:nonFloatInput', 'Input must be single or double.');
  end
end
