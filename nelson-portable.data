%=============================================================================
function obj = timeseriesRefreshMetadata(obj)
  if isa(obj.TimeInfo, 'tsdata.timemetadata')
    obj.TimeInfo = setTime(obj.TimeInfo, obj.Time_);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function rows = timeseriesResolveRows(obj, selector)
  if ischar(selector) && strcmp(selector, ':')
    rows = 1:obj.Length;
  elseif islogical(selector)
    rows = find(selector(:)).';
  else
    rows = selector;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function dim = timeseriesSampleDimension(data, isTimeFirst)
  if isempty(data)
    dim = 1;
  elseif isvector(data)
    if isrow(data)
      dim = 2;
    else
      dim = 1;
    end
  elseif isTimeFirst
    dim = 1;
  else
    dim = ndims(data);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function data = timeseriesSelectData(data, rows, isTimeFirst)
  if isempty(data)
    return
  end
  dim = timeseriesSampleDimension(data, isTimeFirst);
  subs = repmat({':'}, 1, ndims(data));
  subs{dim} = rows;
  data = data(subs{:});
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = timeseriesSizeValue(data, requestedOutputs, varargin)
  if isempty(varargin)
    shape = size(data);
    if requestedOutputs <= 1
      varargout{1} = shape;
    else
      for k = 1:requestedOutputs
        if k <= length(shape)
          varargout{k} = shape(k);
        else
          varargout{k} = 1;
        end
      end
    end
  else
    varargout{1} = size(data, varargin{1});
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function out = timeseriesSubset(obj, selector)
  rows = timeseriesResolveRows(obj, selector);
  out = obj;
  out.Data_ = timeseriesSelectData(obj.Data_, rows, obj.IsTimeFirst_);
  out.Time_ = obj.Time_(rows);
  if ~isempty(obj.Quality_)
    out.Quality_ = obj.Quality_(rows);
  end
  out = timeseriesRefreshMetadata(out);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
