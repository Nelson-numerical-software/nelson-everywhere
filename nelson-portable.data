%=============================================================================
function obj = delevent(obj, selector)
  if ischar(selector) || isstring(selector)
    events = obj.Events;
    keep = true(numel(events), 1);
    for k = 1:numel(events)
      currentEvent = timeseriesEventAt(events, k);
      keep(k) = ~strcmp(currentEvent.Name, char(selector));
    end
    obj.Events = events(keep);
  else
    obj.Events(selector) = [];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function obj = delsample(obj, varargin)
  if nargin == 2
    rows = timeseriesResolveRows(obj, varargin{1});
  elseif nargin == 3 && strcmpi(timeseriesText(varargin{1}, 'Selector'), 'index')
    rows = timeseriesResolveRows(obj, varargin{2});
  elseif nargin == 3 && strcmpi(timeseriesText(varargin{1}, 'Selector'), 'time')
    rows = find(obj.Time == varargin{2});
  else
    error('Nelson:time:invalidSampleSelector', 'Invalid %s.', 'sample selector');
  end
  keep = true(obj.Length, 1);
  keep(rows) = false;
  obj = timeseriesSubset(obj, find(keep));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function obj = detrend(obj, varargin)
  mode = 'linear';
  if nargin > 1
    mode = char(varargin{1});
  end
  y = timeseriesDataAsColumns(obj);
  if isempty(y)
    return
  end
  if strcmpi(mode, 'constant')
    obj.Data_ = y - mean(y, 1);
  else
    x = obj.Time(:);
    x = [x, ones(length(x), 1)];
    coeff = x \ y;
    obj.Data_ = y - x * coeff;
  end
end
