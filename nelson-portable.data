function sys = ltiApplyCommonMetadata(sys, left, right)
  [p, m] = size(left);
  sys.TimeUnit = ltiMergeTimeUnit(left, right);
  sys.InputName = ltiMergeCellMetadata(left.InputName, m, right.InputName, m, 'match');
  sys.InputUnit = ltiMergeCellMetadata(left.InputUnit, m, right.InputUnit, m, 'match');
  sys.OutputName = ltiMergeCellMetadata(left.OutputName, p, right.OutputName, p, 'match');
  sys.OutputUnit = ltiMergeCellMetadata(left.OutputUnit, p, right.OutputUnit, p, 'match');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function sys = ltiApplySeriesMetadata(sys, left, right)
  [pLeft, ~] = size(left);
  [~, mRight] = size(right);
  sys.TimeUnit = ltiMergeTimeUnit(left, right);
  sys.InputName = ltiCopyCellMetadata(right.InputName, mRight);
  sys.InputUnit = ltiCopyCellMetadata(right.InputUnit, mRight);
  sys.OutputName = ltiCopyCellMetadata(left.OutputName, pLeft);
  sys.OutputUnit = ltiCopyCellMetadata(left.OutputUnit, pLeft);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function ltiCheckSampleTimeCompatibility(left, right)
  if isstatic(left) || isstatic(right) || left.Ts == right.Ts
    return
  end
  if left.Ts == -1 || right.Ts == -1
    return
  end
  error('Nelson:control_system:sampleTimeMismatch', 'Sampling times must agree.');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function value = ltiCopyCellMetadata(value, count)
  if isempty(value)
    value = {};
    return
  end
  if ~iscell(value) || numel(value) ~= count
    value = {};
    return
  end
  value = value(:)';
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function out = ltiCopyModelMetadata(out, in)
  out.TimeUnit = in.TimeUnit;
  out.InputName = in.InputName;
  out.InputUnit = in.InputUnit;
  out.InputGroup = in.InputGroup;
  out.OutputName = in.OutputName;
  out.OutputUnit = in.OutputUnit;
  out.OutputGroup = in.OutputGroup;
  out.Notes = in.Notes;
  out.UserData = in.UserData;
  if ~isempty(in.Name)
    out.Name = in.Name;
  end
  out.SamplingGrid = in.SamplingGrid;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function ltiDisplayModelProperties(sys, plainFallback)
  if nargin < 2
    plainFallback = '';
  end
  props = ltiPropertyNames(class(sys));
  expandedText = '';
  width = 0;
  for k = 1:numel(props)
    width = max(width, length(props{k}));
  end
  for k = 1:numel(props)
    name = props{k};
    try
      value = sys.(name);
      expandedText = [expandedText, '      ', repmat(' ', 1, width - length(name)), ...
        name, ': ', ltiCompactPropertyValue(value), char(10)];
    catch
    end
  end
  __display_expandable_text__(_('Model Properties'), expandedText, plainFallback);
end
%=============================================================================
function text = ltiCompactPropertyValue(value)
  if isempty(value)
    text = ltiEmptyValueText(value);
  elseif ischar(value)
    if size(value, 1) == 1
      text = ['''', value, ''''];
    else
      text = ltiSizedValueText(value);
    end
  elseif isstring(value)
    if isscalar(value)
      text = ['"', char(value), '"'];
    else
      text = ltiSizedValueText(value);
    end
  elseif isnumeric(value) || islogical(value)
    if isscalar(value) || numel(value) <= 10
      text = mat2str(value, 4);
    else
      text = ltiSizedValueText(value);
    end
  elseif iscell(value)
    text = ltiSizedValueText(value);
  elseif isstruct(value)
    text = ltiSizedValueText(value);
  else
    text = ltiSizedValueText(value);
  end
end
%=============================================================================
function text = ltiEmptyValueText(value)
  if iscell(value)
    text = '{}';
  elseif ischar(value)
    text = '''''';
  else
    text = '[]';
  end
end
%=============================================================================
function text = ltiSizedValueText(value)
  text = ['[', ltiSizeToString(size(value)), ' ', class(value), ']'];
end
%=============================================================================
function text = ltiSizeToString(sz)
  text = int2str(sz(1));
  for k = 2:length(sz)
    text = [text, 'x', int2str(sz(k))];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function value = ltiMergeCellMetadata(left, leftCount, right, rightCount, mode)
  switch mode
    case 'concat'
      value = concatMetadata(left, leftCount, right, rightCount);
    case 'match'
      value = matchMetadata(left, leftCount, right, rightCount);
    otherwise
      error('Nelson:control_system:invalidSyntax', 'Invalid syntax.');
  end
end
%=============================================================================
function value = concatMetadata(left, leftCount, right, rightCount)
  if isempty(left) && isempty(right)
    value = {};
    return
  end
  left = expandMetadata(left, leftCount);
  right = expandMetadata(right, rightCount);
  if isempty(left) || isempty(right)
    value = {};
    return
  end
  value = [left, right];
end
%=============================================================================
function value = matchMetadata(left, leftCount, right, rightCount)
  if leftCount ~= rightCount || isempty(left) || isempty(right)
    value = {};
    return
  end
  left = expandMetadata(left, leftCount);
  right = expandMetadata(right, rightCount);
  if isequal(left, right)
    value = left;
  else
    value = {};
  end
end
%=============================================================================
function value = expandMetadata(value, count)
  if isempty(value)
    value = cell(1, count);
    value(:) = {''};
    return
  end
  if ~iscell(value) || numel(value) ~= count
    value = {};
    return
  end
  value = value(:)';
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
