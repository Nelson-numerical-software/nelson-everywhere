%=============================================================================
function labels = watershed(varargin)
  narginchk(1, 2);
  nargoutchk(0, 1);
  img = varargin{1};
  if ~(isnumeric(img) || islogical(img))
    error('Nelson:validators:mustBeNumericOrLogical', '%s must be numeric or logical.', 'Image');
  end
  if issparse(img)
    error('Nelson:image_processing:sparseImagesNotSupported', '%s are not supported.', 'Sparse images');
  end
  isVolume = length(size(img)) == 3;
  if length(size(img)) > 3
    error('Nelson:image_processing:imageDDArray', '%s must be a 2-D or 3-D array.', 'Image');
  end
  if ~isreal(img)
    error('Nelson:validators:mustBeReal', '%s must be real.', 'Image');
  end
  d = double(img);
  if any(~isfinite(d(:)))
    error('Nelson:image_processing:imageValuesFinite', '%s values must be finite.', 'Image');
  end
  conn = 8;
  if isVolume
    conn = 26;
  end
  if nargin == 2
    conn = ip_validate_watershed_connectivity(varargin{2}, isVolume);
  end
  labels = builtin('__watershed_kernel__', img, conn);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = worldToIntrinsic(varargin)
  narginchk(3, 4);
  ref = varargin{1};
  [dim, ref] = ip_spatial_ref_dimension(ref);
  if dim == 2
    nargoutchk(0, 2);
    if nargin ~= 3
      error('Nelson:image_processing:dSpatialReferencesRequireXY', '2-D spatial references require X and Y coordinates.');
    end
    varargout{1} = (double(varargin{2}) - ref.XWorldLimits(1)) ...
      / ref.PixelExtentInWorldX + 0.5;
    varargout{2} = (double(varargin{3}) - ref.YWorldLimits(1)) ...
      / ref.PixelExtentInWorldY + 0.5;
  else
    nargoutchk(0, 3);
    if nargin ~= 4
      error('Nelson:image_processing:dSpatialReferencesRequireXYZ', '3-D spatial references require X, Y and Z coordinates.');
    end
    varargout{1} = (double(varargin{2}) - ref.XWorldLimits(1)) ...
      / ref.PixelExtentInWorldX + 0.5;
    varargout{2} = (double(varargin{3}) - ref.YWorldLimits(1)) ...
      / ref.PixelExtentInWorldY + 0.5;
    varargout{3} = (double(varargin{4}) - ref.ZWorldLimits(1)) ...
      / ref.PixelExtentInWorldZ + 0.5;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = worldToSubscript(varargin)
  narginchk(3, 4);
  ref = varargin{1};
  [dim, ref] = ip_spatial_ref_dimension(ref);
  if dim == 2
    nargoutchk(0, 2);
    if nargin ~= 3
      error('Nelson:image_processing:dSpatialReferencesRequireXY', '2-D spatial references require X and Y coordinates.');
    end
    [xIntrinsic, yIntrinsic] = worldToIntrinsic(ref, varargin{2}, varargin{3});
    row = round(yIntrinsic);
    column = round(xIntrinsic);
    outside = xIntrinsic < ref.XIntrinsicLimits(1) | xIntrinsic > ref.XIntrinsicLimits(2) ...
      | yIntrinsic < ref.YIntrinsicLimits(1) | yIntrinsic > ref.YIntrinsicLimits(2);
    row(outside) = NaN;
    column(outside) = NaN;
    varargout{1} = row;
    varargout{2} = column;
  else
    nargoutchk(0, 3);
    if nargin ~= 4
      error('Nelson:image_processing:dSpatialReferencesRequireXYZ', '3-D spatial references require X, Y and Z coordinates.');
    end
    [xIntrinsic, yIntrinsic, zIntrinsic] = worldToIntrinsic(ref, varargin{2}, varargin{3}, ...
      varargin{4});
    row = round(yIntrinsic);
    column = round(xIntrinsic);
    plane = round(zIntrinsic);
    outside = xIntrinsic < ref.XIntrinsicLimits(1) | xIntrinsic > ref.XIntrinsicLimits(2) ...
      | yIntrinsic < ref.YIntrinsicLimits(1) | yIntrinsic > ref.YIntrinsicLimits(2) ...
      | zIntrinsic < ref.ZIntrinsicLimits(1) | zIntrinsic > ref.ZIntrinsicLimits(2);
    row(outside) = NaN;
    column(outside) = NaN;
    plane(outside) = NaN;
    varargout{1} = row;
    varargout{2} = column;
    varargout{3} = plane;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function rgb = ycbcr2rgb(ycbcr)
  narginchk(1, 1);
  nargoutchk(0, 1);
  isMap = ip_is_colormap(ycbcr);
  if isMap
    if ~isa(ycbcr, 'double') || any(ycbcr(:) < 0) || any(ycbcr(:) > 1)
      error('Nelson:image_processing:colormapDoubleMatrixValuesRange', 'Colormap must be a double matrix with values in the range [0, 1].');
    end
    ycbcrMap = reshape(ycbcr, size(ycbcr, 1), 1, 3);
    rgbMap = ycbcr2rgb(ycbcrMap);
    rgb = reshape(rgbMap, size(ycbcr, 1), 3);
    return;
  end
  if ~ip_is_rgb_image(ycbcr)
    error('Nelson:image_processing:ycbcrImageMNArray', '%s must be an M-by-N-by-3 array.', 'YCbCr image');
  end
  d = ip_to_unit_double(ycbcr);
  y = 255 * d(:, :, 1);
  cb = 255 * d(:, :, 2) - 128;
  cr = 255 * d(:, :, 3) - 128;
  r = 1.164383 * (y - 16) + 1.596027 * cr;
  g = 1.164383 * (y - 16) - 0.391762 * cb - 0.812968 * cr;
  b = 1.164383 * (y - 16) + 2.017232 * cb;
  out = ip_clip01(cat(3, r, g, b) / 255);
  switch class(ycbcr)
    case 'uint8'
      rgb = uint8(round(out * 255));
    case 'uint16'
      rgb = uint16(round(out * 65535));
    case 'single'
      rgb = single(out);
    otherwise
      rgb = out;
  end
end
