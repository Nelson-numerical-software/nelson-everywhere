%=============================================================================
function Y = circshift(varargin)
  nRhs = nargin;
  if nRhs < 2
    error('Nelson:notEnoughInputs', 'Not enough input arguments.');
  end
  if nRhs > 3
    error('Nelson:tooManyInputs', 'Too many input arguments.');
  end
  X = varargin{1};
  N = varargin{2};
  sz = size(X);
  nd = ndims(X);
  if (nRhs == 3)
    DIM = varargin{3};
    if ~isscalar(N)
      error('Nelson:circshift:nAScalarIfDIM2', 'N must be a scalar if DIM is specified.');
    end
    N = [zeros(1, DIM - 1), N];
  end
  if ~isfinite(N)
    error('Nelson:circshift:allValuesNIntegerValues3', 'All values of N must be integer values.');
  end
  if (nRhs == 2 && isscalar(N))
    % scalar N applies to the first non-singleton dimension
    DIM = find(sz ~= 1, 1);
    if isempty(DIM)
      DIM = 1;
    end
    N = [zeros(1, DIM - 1), N];
  end
  IDX = repmat({':'}, 1, nd);
  if ~isempty(X)
    if (~isvector(N) || length(N) > nd)
      error('Nelson:validators:mustBeVector', '%s must be a vector.', 'N');
    elseif (any(N ~= fix(N)))
      error('Nelson:circshift:allValuesNIntegerValues3', 'All values of N must be integer values.');
    end
    for i = 1:length(N)
      D = sz(i);
      B = N(i);
      if (B < 0)
        B = rem(abs(B), D);
        IDX{i} = [B + 1:D, 1:B];
      else
        if (B > 0)
          B = rem(B, D);
          IDX{i} = [D - B + 1:D, 1:D - B];
        end
      end
    end
  end
  % an empty array is indexed too: its result holds no imaginary part
  Y = X(IDX{:});
end
