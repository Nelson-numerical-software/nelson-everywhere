% LICENCE_BLOCK_END
%=============================================================================
% Default exclude patterns always applied when packaging a module (.nmz).
% Patterns use the .nmignore glob syntax (see nmm_pack_select).
% A builtin module gateway library lives at the module root or in 'builtin/',
% never in 'bin/', so excluding build output directories is safe.
%=============================================================================
function patterns = nmm_pack_default_excludes()
  patterns = {...
    '.git/', ...
    '.svn/', ...
    '.hg/', ...
    '.gitignore', ...
    '.gitattributes', ...
    '.gitmodules', ...
    'builder.m', ...
    'bin/', ...
    'build/', ...
    'builds/', ...
    'x64/', ...
    'Win32/', ...
    'ARM64/', ...
    'CMakeFiles/', ...
    'CMakeCache.txt', ...
    'cmake_install.cmake', ...
    '.vs/', ...
    '.vscode/', ...
    '.nmm-tmp/', ...
    '*.obj', ...
    '*.o', ...
    '*.tlog', ...
    '*.pdb', ...
    '*.exp', ...
    '*.ilk', ...
    '*.idb', ...
    '*.lib', ...
    '*.user', ...
    '*.suo', ...
    '*.nmz', ...
    '.DS_Store', ...
    'Thumbs.db', ...
    '.nmignore'};
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% Returns the list of files (relative paths, '/' separated) that would be
% included in the .nmz archive of the module located at module_path.
%
% options fields (all optional):
%   options.skiptests  logical, when true excludes the root 'tests/' folder.
%
% Selection rules (precedence):
%   1. files-allowlist ('files' array in module.json), when present: only
%      files matching one of its globs are candidates.
%   2. default excludes: always removed (see nmm_pack_default_excludes).
%   3. .nmignore: gitignore-style patterns at module root, ADD excludes
%      ('!' prefix un-ignores, subject to the parent-directory limitation).
%=============================================================================
function files = nmm_pack_select(module_path, options)
  if nargin < 2
    options = struct();
  end
  skiptests = isfield(options, 'skiptests') && options.skiptests;
  if ~endsWith(module_path, '/')
    module_path = [module_path, '/'];
  end
  positives = nmm_pack_default_excludes();
  negatives = {};
  if skiptests
    positives{end + 1} = 'tests/';
  end
  [nmi_pos, nmi_neg] = readNmignore(module_path);
  for k = 1:numel(nmi_pos)
    positives{end + 1} = nmi_pos{k};
  end
  for k = 1:numel(nmi_neg)
    negatives{end + 1} = nmi_neg{k};
  end
  files = walkTree(module_path, '', positives, negatives, {});
  allow = readAllowlist(module_path);
  if ~isempty(allow)
    kept = {};
    for i = 1:numel(files)
      if matchAny(files{i}, allow)
        kept{end + 1} = files{i};
      end
    end
    files = kept;
  end
  if ~isempty(files)
    files = sort(files(:))';
  end
end
%=============================================================================
function files = walkTree(root, rel, positives, negatives, files)
  if isempty(rel)
    listing = dir(root);
  else
    listing = dir([root, rel]);
  end
  for i = 1:numel(listing)
    nm = listing(i).name;
    if strcmp(nm, '.') || strcmp(nm, '..')
      continue;
    end
    if isempty(rel)
      childRel = nm;
    else
      childRel = [rel, '/', nm];
    end
    if listing(i).isdir
      if isExcludedPath(childRel, positives, negatives)
        continue;
      end
      files = walkTree(root, childRel, positives, negatives, files);
    else
      if ~isExcludedPath(childRel, positives, negatives)
        files{end + 1} = childRel;
      end
    end
  end
end
%=============================================================================
function tf = isExcludedPath(relpath, positives, negatives)
  tf = matchAny(relpath, positives);
  if tf
    if matchAny(relpath, negatives)
      tf = false;
    end
  end
end
%=============================================================================
function tf = matchAny(relpath, patterns)
  tf = false;
  for i = 1:numel(patterns)
    if pathMatches(relpath, patterns{i})
      tf = true;
      return;
    end
  end
end
%=============================================================================
function tf = pathMatches(relpath, pat)
  dirOnly = false;
  if endsWith(pat, '/')
    dirOnly = true;
    pat = pat(1:end - 1);
  end
  if isempty(pat)
    tf = false;
    return;
  end
  anchored = any(pat == '/');
  re = globToRegex(pat);
  if anchored
    if dirOnly
      full = ['^', re, '(/.*)?$'];
    else
      full = ['^', re, '$'];
    end
    tf = ~isempty(regexp(relpath, full, 'once'));
  else
    full = ['^', re, '$'];
    segments = regexp(relpath, '/', 'split');
    tf = false;
    for k = 1:numel(segments)
      if ~isempty(regexp(segments{k}, full, 'once'))
        tf = true;
        return;
      end
    end
  end
end
%=============================================================================
function re = globToRegex(pat)
  re = '';
  specials = '.^$+()[]{}|';
  i = 1;
  n = length(pat);
  while i <= n
    c = pat(i);
    if c == '*'
      if i < n && pat(i + 1) == '*'
        if i + 2 <= n && pat(i + 2) == '/'
          re = [re, '(?:.*/)?'];
          i = i + 3;
        else
          re = [re, '.*'];
          i = i + 2;
        end
      else
        re = [re, '[^/]*'];
        i = i + 1;
      end
    elseif c == '?'
      re = [re, '[^/]'];
      i = i + 1;
    elseif any(c == specials)
      re = [re, '\', c];
      i = i + 1;
    else
      re = [re, c];
      i = i + 1;
    end
  end
end
%=============================================================================
function [pos, neg] = readNmignore(module_path)
  pos = {};
  neg = {};
  f = [module_path, '.nmignore'];
  if ~isfile(f)
    return;
  end
  txt = fileread(f);
  lines = regexp(txt, '\r\n|\r|\n', 'split');
  for i = 1:numel(lines)
    ln = strtrim(lines{i});
    if isempty(ln) || startsWith(ln, '#')
      continue;
    end
    if startsWith(ln, '!')
      ln = strtrim(ln(2:end));
      if ~isempty(ln)
        neg{end + 1} = ln;
      end
    else
      pos{end + 1} = ln;
    end
  end
end
%=============================================================================
function allow = readAllowlist(module_path)
  allow = {};
  jf = [module_path, 'module.json'];
  if ~isfile(jf)
    return;
  end
  info = jsondecode(jf, '-file');
  if ~isstruct(info) || ~isfield(info, 'files')
    return;
  end
  value = info.files;
  if isempty(value)
    return;
  end
  [ok, list] = normalizeStringList(value);
  if ~ok
    warning(_('module.json: "files" must be an array of character vectors; entry ignored.'));
    return;
  end
  allow = list;
end
%=============================================================================
function [ok, out] = normalizeStringList(value)
  ok = true;
  out = {};
  if ischar(value)
    out = {value};
  elseif isstring(value)
    value = value(:);
    for i = 1:numel(value)
      out{end + 1} = char(value(i));
    end
  elseif iscell(value)
    for i = 1:numel(value)
      v = value{i};
      if ischar(v)
        out{end + 1} = v;
      elseif isstring(v) && isscalar(v)
        out{end + 1} = char(v);
      else
        ok = false;
        out = {};
        return;
      end
    end
  else
    ok = false;
    return;
  end
  cleaned = {};
  for i = 1:numel(out)
    if ~isempty(out{i})
      cleaned{end + 1} = out{i};
    end
  end
  out = cleaned;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function package_file = nmm_package(varargin)
  if (length(varargin) ~= 2)
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  module_name = varargin{1};
  destination_dir = varargin{2};
  package_file = [];
  if ~nmm_is_installed(module_name)
    nmm_error('ModuleNameExpectedValidModuleName', 'an valid module name expected.');
  end
  if ~isdir(destination_dir)
    nmm_error('DirectoryExpectedExistingDirectoryExpected', 'an existing directory expected.');
  end
  modules = nmm_list();
  module_info = getfield(modules, module_name);
  module_path = module_info.path;
  stagingPath = newTemporaryDirectory();
  try
    copyfile(module_path, stagingPath, 'f');
    ensureLockFileHasChecksums(stagingPath);
    info = nmm_read_module_json(stagingPath);
    package_file = buildDestinationFilename(destination_dir, module_name, info);
    zip(package_file, stagingPath, stagingPath);
    writePackageChecksum(package_file);
    cleanupDirectory(stagingPath);
  catch
    e = lasterror();
    cleanupDirectory(stagingPath);
    error(e);
  end
end
%=============================================================================
function ensureLockFileHasChecksums(module_path)
  root = ensureTrailingSlash(module_path);
  lockFile = [root, 'module-lock.json'];
  if ~isfile(lockFile)
    nmm_error('ModuleLockMissing', 'module-lock.json is missing.');
  end
  lock = jsondecode(lockFile, '-file');
  moduleInfo = nmm_read_module_json(root);
  lock.package_type = packageType(moduleInfo);
  lock.checksums = lockChecksums(root);
  filewrite(lockFile, jsonprettyprint(jsonencode(lock)));
end
%=============================================================================
function type = packageType(info)
  if info.builtin
    type = 'binary';
  else
    type = 'source';
  end
end
%=============================================================================
function checksums = lockChecksums(module_path)
  root = ensureTrailingSlash(module_path);
  checksums = struct();
  checksums = addFileChecksum(checksums, 'module_json', [root, 'module.json']);
  checksums = addFileChecksum(checksums, 'loader', [root, 'loader.m']);
  checksums = addFileChecksum(checksums, 'builder', [root, 'builder.m']);
  checksums = addFileChecksum(checksums, 'etc_startup', [root, 'etc/startup.m']);
  checksums = addFileChecksum(checksums, 'etc_finish', [root, 'etc/finish.m']);
end
%=============================================================================
function checksums = addFileChecksum(checksums, field, filename)
  if isfile(filename)
    checksums.(field) = sha256(filename, '-file');
  end
end
%=============================================================================
function package_file = buildDestinationFilename(destination_dir, module_name, info)
  package_file_extension = 'nmz';
  universal = false;
  if info.builtin
    arch = computer('arch');
  else
    platforms = info.platforms;
    if ischar(platforms)
      universal = strcmp(info.platforms, 'all');
    end
  end
  if universal
    arch = 'all';
  else
    arch = computer('arch');
  end
  version = info.version;
  if endsWith(fullpath(destination_dir), '/')
    buffer_format = '%s%s-%s-%s.%s';
  else
    buffer_format = '%s/%s-%s-%s.%s';
  end
  package_file = sprintf(buffer_format, fullpath(destination_dir), module_name, arch, version, package_file_extension);
end
%=============================================================================
function writePackageChecksum(package_file)
  checksum_file = [package_file, '.sha256'];
  filewrite(checksum_file, sha256(package_file, '-file'));
end
%=============================================================================
function path = newTemporaryDirectory()
  root = [usermodulesdir(), '.nmm-tmp/'];
  if ~isdir(root)
    mkdir(root);
  end
  path = [root, createGUID(), '/'];
  mkdir(path);
end
%=============================================================================
function cleanupDirectory(path)
  if ischar(path) && isdir(path)
    rmdir(path, 's');
  end
end
%=============================================================================
function path = ensureTrailingSlash(path)
  if ~endsWith(path, '/')
    path = [path, '/'];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function report = nmm_pin(varargin)
  if length(varargin) < 1 || length(varargin) > 2
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  module_name = varargin{1};
  version = '';
  if length(varargin) == 2
    version = varargin{2};
  end
  if ~ischar(module_name)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 2);
  end
  if length(varargin) == 2 && ~ischar(version)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 3);
  end
  [module_name, module_data] = nmm_find_installed_module(module_name, version);
  if isempty(module_data)
    nmm_error('ModuleNameExpectedModuleNameInstalled', 'module name and installed version expected.');
  end
  if ismodule(module_name)
    removemodule(module_name);
  end
  modules = nmm_list();
  current = getfield(modules, module_name);
  current.path = module_data.path;
  current.version = module_data.version;
  current.load = true;
  current.pinned_version = module_data.version;
  modules.(module_name) = current;
  filewrite([usermodulesdir(), 'modules.json'], jsonprettyprint(jsonencode(modules)));
  nmm_load(module_name, module_data.version);
  report = struct();
  report.module = module_name;
  report.version = module_data.version;
  report.path = module_data.path;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function nmm_prepare_destination(destination_dir, module_name, module_version)
  if nmm_is_installed(module_name, module_version)
    nmm_error('DestinationExists', 'Destination already exists: %s', destination_dir);
  end
  if ~isSafeOrphanDestination(destination_dir, module_name, module_version)
    nmm_error('DestinationExists', 'Destination already exists: %s', destination_dir);
  end
  [r, msg] = rmdir(destination_dir, 's');
  if ~r
    nmm_error('DestinationRemoveFailed', msg);
  end
end
%=============================================================================
function tf = isSafeOrphanDestination(destination_dir, module_name, module_version)
  tf = false;
  root = usermodulesdir();
  if ~startsWith(destination_dir, root)
    return
  end
  moduleJson = [destination_dir, 'module.json'];
  if ~isfile(moduleJson)
    return
  end
  try
    info = jsondecode(moduleJson, '-file');
    tf = isfield(info, 'module') && isfield(info, 'version') ...
        && strcmp(info.module, module_name) && strcmp(info.version, module_version);
  catch
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function nmm_progress(action, name, version, step, index, total)
  % Progress hook for long package operations (install, update, remove).
  % nmm stays headless: the event is delivered only when a listener named
  % nmm_progress_listener is on the path (the package manager window
  % provides one); otherwise this is a no-op. Listener failures never
  % break the operation.
  if exist('nmm_progress_listener') == 0
    return
  end
  try
    nmm_progress_listener(action, name, version, step, index, total);
  catch
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function report = nmm_publish(varargin)
  if length(varargin) < 1 || length(varargin) > 6
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  package_file = varargin{1};
  if ~ischar(package_file)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 2);
  end
  if ~isfile(package_file)
    nmm_error('FilenameExpected', 'filename expected.');
  end
  if ~endsWith(package_file, '.nmz')
    nmm_error('InvalidPackageFileExtension', 'filename extension .nmz expected.');
  end
  options = parseOptions(varargin(2:end));
  verifyPackageChecksum(package_file);
  registryFile = registryFilename();
  [lock, moduleInfo] = packageMetadata(package_file);
  if ~isempty(options.source)
    validateSourceUrl(options.source, lock.platform, lock.version);
  end
  registry = readLocalRegistry(registryFile);
  entry = packageEntry(lock, moduleInfo, package_file, options.source);
  exists = hasPackage(registry.packages, entry.name, entry.version);
  duplicate = entryAlreadyPublished(registry.packages, entry);
  if options.check || options.dry_run
    report = publishReport(false, options.dry_run, options.force, registryFile, entry, exists);
    report.checked = options.check;
    report.publishable = ~duplicate || options.force;
    if ~report.publishable
      report.errors = {duplicatePackageMessage(entry.name, entry.version)};
    else
      report.errors = {};
    end
    report = encodeReport(report, options.json);
    return
  end
  if duplicate && ~options.force
    nmm_error('PackageAlreadyExists', duplicatePackageMessage(entry.name, entry.version));
  end
  registry.packages = upsertPackage(registry.packages, entry);
  filewrite(registryFile, jsonprettyprint(jsonencode(registry)));
  writeRegistryChecksum(registryFile);
  nmm_registry_signature('write', registryFile);
  report = publishReport(true, false, options.force && exists, registryFile, entry, exists);
  report.checked = false;
  report.publishable = true;
  report.errors = {};
  report = encodeReport(report, options.json);
end
%=============================================================================
function options = parseOptions(args)
  options = struct();
  options.dry_run = false;
  options.check = false;
  options.force = false;
  options.json = false;
  options.source = '';
  k = 1;
  while k <= length(args)
    option = args{k};
    if ~ischar(option)
      nmm_error('CharactersExpected', '#%d argument: characters expected.', 3);
    end
    switch option
      case '-dry-run'
        options.dry_run = true;
      case '-check'
        options.check = true;
      case '-force'
        options.force = true;
      case '-json'
        options.json = true;
      case '-source'
        % Hosted registries (e.g. GitHub releases) reference the archive by
        % URL, not by the local path where it was packed. -source <url> stores
        % that URL as the archive source while the checksum is still taken from
        % the local file being published.
        if k == length(args)
          nmm_error('RegistrySourceUrlExpected', 'A source URL is expected after ''-source''.');
        end
        value = args{k + 1};
        if ~ischar(value) || ~(startsWith(value, 'http://') || startsWith(value, 'https://'))
          nmm_error('RegistrySourceUrlInvalid', '''-source'' expects an http(s) URL.');
        end
        options.source = value;
        k = k + 1;
      otherwise
        nmm_error('InvalidOptionExpected', '%s expected.', sprintf('#%d argument: ''-dry-run'', ''-check'', ''-force'', ''-source'' or ''-json''', 3));
    end
    k = k + 1;
  end
end
%=============================================================================
function report = publishReport(published, dryRun, forced, registryFile, entry, exists)
  report = struct();
  report.published = published;
  report.dry_run = dryRun;
  report.forced = forced;
  report.existing = exists;
  report.registry = registryFile;
  report.package = entry.name;
  report.version = entry.version;
  report.entry = entry;
end
%=============================================================================
function report = encodeReport(report, jsonOutput)
  if jsonOutput
    report = jsonencode(report);
  end
end
%=============================================================================
function tf = hasPackage(packages, name, version)
  tf = false;
  if isempty(packages)
    return
  end
  for k = 1:length(packages)
    if strcmp(packages(k).name, name) && strcmp(packages(k).version, version)
      tf = true;
      return
    end
  end
end
%=============================================================================
function msg = duplicatePackageMessage(name, version)
  msg = sprintf(_('Package already exists in registry: %s %s. Use -force to replace it.'), name, version);
end
%=============================================================================
function verifyPackageChecksum(package_file)
  checksum_file = [package_file, '.sha256'];
  if ~isfile(checksum_file)
    return
  end
  expected = strtrim(fileread(checksum_file));
  actual = sha256(package_file, '-file');
  if ~strcmpi(expected, actual)
    nmm_error('PackageChecksumMismatch', 'Package checksum does not match.');
  end
end
%=============================================================================
function registryFile = registryFilename()
  registryFile = getenv('NELSON_NMM_REGISTRY');
  if isempty(registryFile)
    registryFile = [usermodulesdir(), 'registry.json'];
  end
  if startsWith(registryFile, 'http://') || startsWith(registryFile, 'https://')
    nmm_error('LocalRegistryPathExpected', 'Local registry path expected.');
  end
end
%=============================================================================
function [lock, moduleInfo] = packageMetadata(package_file)
  stagingPath = [usermodulesdir(), '.nmm-tmp/', createGUID(), '/'];
  if ~isdir([usermodulesdir(), '.nmm-tmp/'])
    mkdir([usermodulesdir(), '.nmm-tmp/']);
  end
  mkdir(stagingPath);
  try
    unzip(package_file, stagingPath);
    lockFile = [stagingPath, 'module-lock.json'];
    if ~isfile(lockFile)
      nmm_error('ModuleLockMissing', 'module-lock.json is missing.');
    end
    moduleJson = [stagingPath, 'module.json'];
    if ~isfile(moduleJson)
      nmm_error('ModuleJsonMissing', 'module.json is missing.');
    end
    lock = jsondecode(lockFile, '-file');
    moduleInfo = jsondecode(moduleJson, '-file');
    rmdir(stagingPath, 's');
  catch e
    if isdir(stagingPath)
      rmdir(stagingPath, 's');
    end
    rethrow(e);
  end
end
%=============================================================================
function registry = readLocalRegistry(registryFile)
  if isfile(registryFile)
    verifyRegistryChecksum(registryFile);
    nmm_registry_signature('verify-if-present', registryFile);
    registry = jsondecode(registryFile, '-file');
  else
    registry = struct();
    registry.packages = struct([]);
  end
  if ~isfield(registry, 'packages')
    registry.packages = struct([]);
  end
  % entries with optional fields decode as a cell array: homogenize them
  registry.packages = nmm_normalize_packages(registry.packages);
end
%=============================================================================
function verifyRegistryChecksum(registryFile)
  checksumFile = [registryFile, '.sha256'];
  if ~isfile(checksumFile)
    nmm_error('RegistryChecksumMissing', 'Registry checksum file is missing.');
  end
  expected = strtrim(fileread(checksumFile));
  separator = strfind(expected, ' ');
  if ~isempty(separator)
    expected = expected(1:separator(1) - 1);
  end
  actual = sha256(registryFile, '-file');
  if ~strcmpi(expected, actual)
    nmm_error('RegistryChecksumMismatch', 'Registry checksum does not match.');
  end
end
%=============================================================================
function writeRegistryChecksum(registryFile)
  filewrite([registryFile, '.sha256'], sha256(registryFile, '-file'));
end
%=============================================================================
function entry = packageEntry(lock, moduleInfo, package_file, sourceOverride)
  entry = struct();
  entry.name = lock.module;
  entry.version = lock.version;
  entry.title = metadataText(moduleInfo, 'title');
  entry.summary = metadataText(moduleInfo, 'summary');
  entry.description = metadataText(moduleInfo, 'description');
  if isempty(entry.description)
    entry.description = entry.summary;
  end
  entry.license = metadataText(moduleInfo, 'license');
  entry.authors = metadataValue(moduleInfo, 'authors', {});
  entry.repository = metadataText(moduleInfo, 'repository');
  entry.keywords = metadataValue(moduleInfo, 'keywords', {});
  entry.tags = entry.keywords;
  if isfield(lock, 'package_type')
    entry.package_type = lock.package_type;
  else
    entry.package_type = packageType(moduleInfo);
  end
  entry.platforms = {lock.platform};
  entry.nelson = ['>=', lock.nelson.version];
  entry.dependencies = lock.dependencies;
  checksum = sha256(package_file, '-file');
  if ~isempty(sourceOverride)
    source = sourceOverride;
  else
    source = fullpath(package_file);
  end
  if isArchitectureSpecific(lock.platform)
    % A binary (builtin) package is locked to one architecture, so its archive
    % is stored under an "artifacts" map keyed by that architecture. Publishing
    % another architecture of the same version later merges into this map (see
    % upsertPackage), letting one name and version ship win64 and woa64.
    entry.artifacts = struct();
    entry.artifacts.(lock.platform) = archArtifact(source, checksum);
  else
    entry.checksum = checksum;
    entry.source = source;
  end
  entry.signature = '';
end
%=============================================================================
function tf = isArchitectureSpecific(platform)
  tf = ischar(platform) && ~isempty(platform) && ~strcmp(platform, 'all');
end
%=============================================================================
function validateSourceUrl(url, platform, packageVersion)
  % Catch a copy-paste mistake where the hosted -source URL points at a
  % different architecture than the archive being published (e.g. publishing
  % the woa64 .nmz but pasting the win64 release link). The architecture token
  % in the URL file name, when present, must match the packed platform.
  base = lower(urlBasename(url));
  for candidate = nmm_valid_platforms()
    arch = candidate{1};
    if strcmp(arch, 'all')
      continue
    end
    if ~isempty(strfind(base, arch)) && ~strcmp(arch, platform)
      nmm_error('RegistrySourceUrlArchMismatch', 'The -source URL references architecture %s but the package is %s.', arch, platform);
    end
  end
  if ischar(packageVersion) && ~isempty(packageVersion) && isempty(strfind(base, lower(packageVersion)))
    warning('Nelson:nmm:RegistrySourceUrlVersion', 'The -source URL does not mention the package version %s.', packageVersion);
  end
end
%=============================================================================
function base = urlBasename(url)
  positions = strfind(url, '/');
  if isempty(positions)
    base = url;
  else
    base = url(positions(end) + 1:end);
  end
end
%=============================================================================
function artifact = archArtifact(source, checksum)
  artifact = struct();
  artifact.source = source;
  artifact.checksum = checksum;
end
%=============================================================================
function type = packageType(moduleInfo)
  if moduleInfo.builtin
    type = 'binary';
  else
    type = 'source';
  end
end
%=============================================================================
function text = metadataText(moduleInfo, field)
  text = '';
  if isfield(moduleInfo, field)
    value = moduleInfo.(field);
    if ischar(value)
      text = value;
    end
  end
end
%=============================================================================
function value = metadataValue(moduleInfo, field, defaultValue)
  value = defaultValue;
  if isfield(moduleInfo, field)
    value = moduleInfo.(field);
  end
end
%=============================================================================
function packages = upsertPackage(packages, entry)
  if isempty(packages)
    packages = entry;
    return
  end
  index = findPackageIndex(packages, entry.name, entry.version);
  if index == 0
    [packages, entry] = normalizePackageFields(packages, entry);
    packages(end + 1) = entry;
    return
  end
  merged = mergePackageEntry(packages(index), entry);
  [packages, merged] = normalizePackageFields(packages, merged);
  packages(index) = merged;
end
%=============================================================================
function index = findPackageIndex(packages, name, version)
  index = 0;
  for k = 1:length(packages)
    if strcmp(packages(k).name, name) && strcmp(packages(k).version, version)
      index = k;
      return
    end
  end
end
%=============================================================================
function merged = mergePackageEntry(existing, entry)
  % The freshly published metadata wins, but when both the stored entry and the
  % new one carry per-architecture artifacts, accumulate them so a single
  % version keeps every architecture published so far (e.g. win64 then woa64).
  merged = entry;
  if ~isArtifactEntry(entry) || ~isArtifactEntry(existing)
    return
  end
  artifacts = existing.artifacts;
  for field = fieldnames(entry.artifacts)'
    artifacts.(field{1}) = entry.artifacts.(field{1});
  end
  merged.artifacts = artifacts;
  merged.platforms = mergedPlatforms(existing, entry);
end
%=============================================================================
function platforms = mergedPlatforms(existing, entry)
  platforms = {};
  platforms = appendPlatformList(platforms, existing);
  platforms = appendPlatformList(platforms, entry);
end
%=============================================================================
function platforms = appendPlatformList(platforms, package)
  if ~isfield(package, 'platforms')
    return
  end
  values = package.platforms;
  if ischar(values)
    values = {values};
  end
  if ~iscell(values)
    return
  end
  for k = 1:numel(values)
    if ischar(values{k}) && ~isempty(values{k}) && ~any(strcmp(platforms, values{k}))
      platforms{end + 1} = values{k};
    end
  end
end
%=============================================================================
function tf = entryAlreadyPublished(packages, entry)
  % A version is a duplicate when it is already in the registry, except that a
  % new architecture added to an existing binary version is an addition (it
  % merges), not a duplicate: only re-publishing the same architecture needs
  % -force.
  tf = false;
  index = findPackageIndex(packages, entry.name, entry.version);
  if index == 0
    return
  end
  if isArtifactEntry(entry)
    tf = entryHasArtifactArch(packages(index), artifactArch(entry));
    return
  end
  tf = true;
end
%=============================================================================
function tf = isArtifactEntry(entry)
  tf = isfield(entry, 'artifacts') && isstruct(entry.artifacts) ...
      && ~isempty(fieldnames(entry.artifacts));
end
%=============================================================================
function arch = artifactArch(entry)
  names = fieldnames(entry.artifacts);
  arch = names{1};
end
%=============================================================================
function tf = entryHasArtifactArch(existing, arch)
  tf = isfield(existing, 'artifacts') && isstruct(existing.artifacts) ...
      && isfield(existing.artifacts, arch);
end
%=============================================================================
function [packages, entry] = normalizePackageFields(packages, entry)
  for field = fieldnames(entry)'
    if ~isfield(packages, field{1})
      for k = 1:length(packages)
        packages(k).(field{1}) = defaultFieldValue(entry.(field{1}));
      end
    end
  end
  for field = fieldnames(packages)'
    if ~isfield(entry, field{1})
      entry.(field{1}) = defaultFieldValue(packages(1).(field{1}));
    end
  end
end
%=============================================================================
function value = defaultFieldValue(reference)
  if iscell(reference)
    value = {};
  elseif isstruct(reference)
    value = struct();
  elseif islogical(reference)
    value = false;
  else
    value = '';
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [args, quiet] = nmm_quiet_option(args)
  quiet = false;
  if length(args) < 2
    return
  end
  last = args{end};
  if ischar(last) && strcmp(last, '-quiet')
    quiet = true;
    args = args(1:length(args) - 1);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function report = nmm_rdeps(varargin)
  if length(varargin) ~= 1
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  packageName = varargin{1};
  if ~ischar(packageName)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 2);
  end
  report = struct([]);
  modules = nmm_list();
  for moduleName = fieldnames(modules)'
    requester = moduleName{1};
    versions = installedVersions(modules.(requester));
    for k = 1:length(versions)
      dependencies = installedDependencies(versions(k));
      if isfield(dependencies, packageName)
        report = appendReverseDependency(report, requester, versions(k), packageName, dependencies.(packageName));
      end
    end
  end
end
%=============================================================================
function report = appendReverseDependency(report, requester, versionData, dependencyName, dependencyVersion)
  item = struct();
  item.package = requester;
  item.version = versionData.version;
  item.path = versionData.path;
  item.dependency = dependencyName;
  item.requested = dependencyVersion;
  if isempty(report)
    report = item;
  else
    report(end + 1) = item;
  end
end
%=============================================================================
function dependencies = installedDependencies(versionData)
  dependencies = struct();
  if ~isfield(versionData, 'path')
    return
  end
  lockFile = [versionData.path, 'module-lock.json'];
  if ~isfile(lockFile)
    return
  end
  try
    lock = jsondecode(lockFile, '-file');
    if isfield(lock, 'dependencies') && isstruct(lock.dependencies)
      dependencies = lock.dependencies;
    end
  catch
  end
end
%=============================================================================
function versions = installedVersions(moduleData)
  versions = struct([]);
  if isfield(moduleData, 'versions') && ~isempty(moduleData.versions)
    versions = moduleData.versions;
    return
  end
  if isfield(moduleData, 'path') && isfield(moduleData, 'version')
    versions = moduleData;
    if isfield(versions, 'versions')
      versions = rmfield(versions, 'versions');
    end
    if isfield(versions, 'pinned_version')
      versions = rmfield(versions, 'pinned_version');
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function st = nmm_read_module_json(directory)
  module_json_path = [directory, 'module.json'];
  st = jsondecode(module_json_path, '-file');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function out = nmm_registry(action, varargin)
  switch action
    case 'search'
      out = registrySearch(varargin{:});
    case 'info'
      out = registryInfo(varargin{:});
    case 'versions'
      out = registryVersions(varargin{:});
    case 'check'
      out = registryCheck(varargin{:});
    case 'validate'
      out = registryCheck(varargin{:});
    case 'list'
      out = registryList(varargin{:});
    case 'stats'
      out = registryStatsCommand(varargin{:});
    case 'doctor'
      out = registryDoctor(varargin{:});
    otherwise
      nmm_error('UnknownRegistryAction', 'Unknown registry action.');
  end
end
%=============================================================================
function result = registrySearch(query, varargin)
  if nargin < 1 || nargin > 3
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  if ~ischar(query)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 2);
  end
  [asJson, platformOnly] = parseSearchOptions(varargin);
  packages = registryPackages();
  result = struct([]);
  for k = 1:length(packages)
    if ~packageMatches(packages(k), query) || isYankedPackage(packages(k))
      continue
    end
    if platformOnly && ~packageSupportsCurrentPlatform(packages(k))
      continue
    end
    result = appendPackage(result, packages(k));
  end
  if asJson
    result = jsonprettyprint(jsonencode(result));
  end
end
%=============================================================================
function [asJson, platformOnly] = parseSearchOptions(args)
  % -json returns the matches as JSON text; -platform keeps only the packages
  % installable on the running architecture (platforms contains computer('arch')
  % or 'all'). The core search stays unfiltered by default so it reports the
  % whole registry regardless of the current machine; presentation layers such
  % as nmm_gui opt in to -platform.
  asJson = false;
  platformOnly = false;
  for k = 1:numel(args)
    option = args{k};
    if ~ischar(option)
      nmm_error('CharactersExpected', '#%d argument: characters expected.', 3);
    end
    switch option
      case '-json'
        asJson = true;
      case '-platform'
        platformOnly = true;
      otherwise
        nmm_error('InvalidOption', '#%d argument: %s expected.', k + 2, '''-json'' or ''-platform''');
    end
  end
end
%=============================================================================
function tf = packageSupportsCurrentPlatform(package)
  platforms = platformList(package);
  if isempty(platforms)
    tf = true;
    return
  end
  arch = computer('arch');
  tf = any(strcmp(platforms, 'all')) || any(strcmp(platforms, arch));
end
%=============================================================================
function result = registryInfo(packageName, varargin)
  if nargin < 1 || nargin > 3
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  if ~ischar(packageName)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 2);
  end
  version = '';
  asJson = false;
  for k = 1:length(varargin)
    value = varargin{k};
    if ~ischar(value)
      nmm_error('CharactersExpected', '#%d argument: characters expected.', k + 2);
    end
    if strcmp(value, '-json')
      asJson = true;
    else
      if ~isempty(version)
        nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
      end
      version = value;
    end
  end
  packages = registryPackages();
  matches = struct([]);
  for k = 1:length(packages)
    if strcmp(packages(k).name, packageName)
      % a yanked version is never picked as "latest" nor by a semver
      % constraint, but stays resolvable when its exact version is requested
      % (lockfiles must keep working)
      if (isempty(version) || isVersionConstraint(version)) && isYankedPackage(packages(k))
        continue
      end
      if isempty(version) || registryVersionMatches(packages(k).version, version)
        matches = appendPackage(matches, packages(k));
      end
    end
  end
  if isempty(matches)
    nmm_error('PackageNotFound', 'Package not found: %s', packageName);
  end
  result = latestPackage(matches);
  result = resolveArtifactSource(result);
  if asJson
    result = jsonprettyprint(jsonencode(result));
  end
end
%=============================================================================
function package = resolveArtifactSource(package)
  % A binary package can ship one archive per architecture under "artifacts":
  % {"win64": {"source": ..., "checksum": ...}, "woa64": {...}}. Flatten the
  % entry for the running architecture into the flat source/checksum fields the
  % installer already understands, so a single registry entry (one name and
  % version) serves every architecture. Source packages carry no "artifacts"
  % map and are left untouched.
  if ~hasArtifacts(package)
    return
  end
  arch = computer('arch');
  if ~isfield(package.artifacts, arch)
    return
  end
  selected = package.artifacts.(arch);
  if ~isstruct(selected)
    return
  end
  if isfield(selected, 'source') && ischar(selected.source)
    package.source = selected.source;
  end
  if isfield(selected, 'checksum') && ischar(selected.checksum)
    package.checksum = selected.checksum;
  end
end
%=============================================================================
function tf = hasArtifacts(package)
  tf = isfield(package, 'artifacts') && isstruct(package.artifacts) ...
      && ~isempty(fieldnames(package.artifacts));
end
%=============================================================================
function asJson = parseJsonOption(args)
  asJson = false;
  if isempty(args)
    return
  end
  option = args{1};
  if ~ischar(option)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 3);
  end
  if ~strcmp(option, '-json')
    nmm_error('InvalidOption', '#%d argument: %s expected.', 3, '''-json''');
  end
  asJson = true;
end
%=============================================================================
function tf = registryVersionMatches(packageVersion, requestedVersion)
  tf = strcmp(packageVersion, requestedVersion);
  if tf
    return
  end
  if ~isVersionConstraint(requestedVersion)
    return
  end
  tf = semverConstraintSatisfied(packageVersion, requestedVersion);
end
%=============================================================================
function tf = isVersionConstraint(version)
  tf = startsWith(version, '>') || startsWith(version, '<') ...
      || startsWith(version, '=') || startsWith(version, '^') ...
      || startsWith(version, '~') || contains(version, ' ');
end
%=============================================================================
function tf = semverConstraintSatisfied(packageVersion, constraint)
  tf = true;
  constraints = strsplit(strtrim(constraint), ' ');
  for k = 1:length(constraints)
    item = constraints{k};
    if isempty(item)
      continue
    end
    try
      if semver(packageVersion, item) ~= 1
        tf = false;
        return
      end
    catch
      tf = false;
      return
    end
  end
end
%=============================================================================
function versions = registryVersions(packageName, varargin)
  if nargin < 1 || nargin > 2
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  if ~ischar(packageName)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 2);
  end
  asJson = parseJsonOption(varargin);
  packages = registryPackages();
  versions = {};
  for k = 1:length(packages)
    if strcmp(packages(k).name, packageName) && ~isYankedPackage(packages(k))
      versions{end + 1} = packages(k).version;
    end
  end
  if isempty(versions)
    nmm_error('PackageNotFound', 'Package not found: %s', packageName);
  end
  if asJson
    versions = jsonprettyprint(jsonencode(versions));
  end
end
%=============================================================================
function report = registryCheck(varargin)
  if nargin ~= 0
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  source = registrySource();
  report = struct();
  report.ok = true;
  report.registry = source;
  report.is_local = ~nmm_is_remote_registry(source);
  report.checksum_file = [source, '.sha256'];
  report.checksum_ok = false;
  report.signature_file = [source, '.sig'];
  report.signature_ok = false;
  report.signature_key = '';
  report.trusted_keys = length(nmm_registry_signature('trusted-keys'));
  report.offline = false;
  report.cached_file = '';
  report.issues = {};
  if ~report.is_local
    try
      [localFile, info] = nmm_registry_fetch(source);
      report.cached_file = localFile;
      report.offline = info.offline;
      report.signature_ok = info.verified;
      report.signature_key = info.public_key;
      if ~info.signature_present
        report = addIssue(report, _('Registry signature file is missing.'));
      end
      jsondecode(localFile, '-file');
    catch
      e = lasterror();
      report = addIssue(report, e.message);
    end
    return
  end
  if ~isfile(source)
    report = addIssue(report, registryNotConfiguredMessage());
    return
  end
  try
    jsondecode(source, '-file');
  catch
    e = lasterror();
    report = addIssue(report, e.message);
  end
  if ~isfile(report.checksum_file)
    report = addIssue(report, _('Registry checksum file is missing.'));
  else
    try
      verifyRegistryChecksum(source);
      report.checksum_ok = true;
    catch
      e = lasterror();
      report = addIssue(report, e.message);
    end
  end
  if isfile(report.signature_file)
    try
      info = nmm_registry_signature('verify', source);
      report.signature_ok = true;
      report.signature_key = info.public_key;
    catch
      e = lasterror();
      report = addIssue(report, e.message);
    end
  end
end
%=============================================================================
function report = registryList(varargin)
  if nargin ~= 0
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  packages = registryPackages();
  report = struct();
  report.registry = registrySource();
  report.packages = packages;
  report.stats = registryStats(packages);
end
%=============================================================================
function report = registryStatsCommand(varargin)
  if nargin ~= 0
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  packages = registryPackages();
  report = registryStats(packages);
end
%=============================================================================
function report = registryDoctor(varargin)
  if nargin ~= 0
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  report = registryCheck();
  [packages, readIssues] = rawRegistryPackages();
  report.stats = registryStats(packages);
  report.duplicates = duplicatePackages(packages);
  report.missing_sources = missingSources(packages);
  report.inconsistent_artifacts = inconsistentArtifacts(packages);
  report.unsigned = unsignedPackages(packages);
  report.unchecksummed = unchecksummedPackages(packages);
  for k = 1:length(readIssues)
    report = addIssue(report, readIssues{k});
  end
  for k = 1:length(report.duplicates)
    report = addIssue(report, ['Duplicate package version: ', report.duplicates{k}]);
  end
  for k = 1:length(report.missing_sources)
    report = addIssue(report, ['Package source is missing: ', report.missing_sources{k}]);
  end
  for k = 1:length(report.inconsistent_artifacts)
    report = addIssue(report, ['Package artifacts are inconsistent with platforms: ', report.inconsistent_artifacts{k}]);
  end
end
%=============================================================================
function values = inconsistentArtifacts(packages)
  % A binary entry must keep its "platforms" set equal to the architectures it
  % actually ships under "artifacts", and every artifact key must be a known
  % architecture. Hand-editing the registry easily breaks this (listing woa64
  % but forgetting its artifact, or a mistyped arch), which would let an install
  % pass the platform gate and then fail with an obscure missing-source error.
  values = {};
  for k = 1:length(packages)
    if ~hasArtifacts(packages(k))
      continue
    end
    if ~artifactsConsistent(packages(k))
      values = appendUnique(values, packageLabel(packages(k)));
    end
  end
end
%=============================================================================
function tf = artifactsConsistent(package)
  tf = false;
  archs = fieldnames(package.artifacts)';
  valid = nmm_valid_platforms();
  for a = archs
    if strcmp(a{1}, 'all') || ~any(strcmp(valid, a{1}))
      return
    end
  end
  platforms = platformList(package);
  if numel(platforms) ~= numel(archs)
    return
  end
  for a = archs
    if ~any(strcmp(platforms, a{1}))
      return
    end
  end
  tf = true;
end
%=============================================================================
function platforms = platformList(package)
  platforms = {};
  if ~isfield(package, 'platforms')
    return
  end
  values = package.platforms;
  if ischar(values)
    values = {values};
  end
  if ~iscell(values)
    return
  end
  for k = 1:numel(values)
    if ischar(values{k}) && ~isempty(values{k}) && ~any(strcmp(platforms, values{k}))
      platforms{end + 1} = values{k};
    end
  end
end
%=============================================================================
function stats = registryStats(packages)
  source = registrySource();
  stats = struct();
  stats.registry = source;
  stats.is_local = ~nmm_is_remote_registry(source);
  stats.entries = length(packages);
  stats.packages = length(uniquePackageNames(packages));
  stats.versions = length(packages);
  stats.platforms = uniquePlatforms(packages);
  stats.checksummed = checksummedCount(packages);
  stats.signed = countTextField(packages, 'signature');
end
%=============================================================================
function [packages, issues] = rawRegistryPackages()
  packages = struct([]);
  issues = {};
  source = registrySource();
  if ~nmm_is_remote_registry(source) && ~isfile(source)
    issues{end + 1} = registryNotConfiguredMessage();
    return
  end
  try
    localFile = nmm_registry_fetch(source);
    registry = jsondecode(localFile, '-file');
    packages = packagesFromRegistry(registry);
  catch e
    issues{end + 1} = e.message;
  end
end
%=============================================================================
function report = addIssue(report, issue)
  report.ok = false;
  report.issues{end + 1} = issue;
end
%=============================================================================
function packages = registryPackages()
  registry = readRegistry();
  packages = packagesFromRegistry(registry);
end
%=============================================================================
function packages = packagesFromRegistry(registry)
  if isfield(registry, 'packages')
    packages = registry.packages;
  else
    packages = registry;
  end
  if isempty(packages)
    packages = struct([]);
  end
  % entries may not share the same fields (optional keys): homogenize them
  packages = nmm_normalize_packages(packages);
end
%=============================================================================
function values = uniquePackageNames(packages)
  values = {};
  for k = 1:length(packages)
    if isfield(packages(k), 'name')
      values = appendUnique(values, packages(k).name);
    end
  end
end
%=============================================================================
function values = uniquePlatforms(packages)
  values = {};
  for k = 1:length(packages)
    if isfield(packages(k), 'platforms')
      platforms = packages(k).platforms;
      if iscell(platforms)
        for j = 1:length(platforms)
          values = appendUnique(values, platforms{j});
        end
      elseif isstring(platforms)
        for j = 1:length(platforms)
          values = appendUnique(values, char(platforms(j)));
        end
      elseif ischar(platforms)
        values = appendUnique(values, platforms);
      end
    end
  end
end
%=============================================================================
function values = duplicatePackages(packages)
  values = {};
  seen = {};
  for k = 1:length(packages)
    if isfield(packages(k), 'name') && isfield(packages(k), 'version')
      label = [packages(k).name, '@', packages(k).version];
      if any(strcmp(seen, label))
        values = appendUnique(values, label);
      else
        seen{end + 1} = label;
      end
    end
  end
end
%=============================================================================
function values = missingSources(packages)
  values = {};
  for k = 1:length(packages)
    if ~packageSourcePresent(packages(k))
      values = appendUnique(values, packageLabel(packages(k)));
    end
  end
end
%=============================================================================
function tf = packageSourcePresent(package)
  if hasArtifacts(package)
    tf = true;
    for field = fieldnames(package.artifacts)'
      selected = package.artifacts.(field{1});
      source = '';
      if isstruct(selected) && isfield(selected, 'source') && ischar(selected.source)
        source = selected.source;
      end
      if ~sourceResolves(source)
        tf = false;
        return
      end
    end
    return
  end
  tf = sourceResolves(packageSource(package));
end
%=============================================================================
function tf = sourceResolves(source)
  tf = ischar(source) && ~isempty(source) ...
      && (isfile(source) || isdir(source) ...
      || startsWith(source, 'http://') || startsWith(source, 'https://'));
end
%=============================================================================
function values = unsignedPackages(packages)
  values = {};
  for k = 1:length(packages)
    if ~hasTextField(packages(k), 'signature')
      values = appendUnique(values, packageLabel(packages(k)));
    end
  end
end
%=============================================================================
function values = unchecksummedPackages(packages)
  values = {};
  for k = 1:length(packages)
    if ~packageChecksummed(packages(k))
      values = appendUnique(values, packageLabel(packages(k)));
    end
  end
end
%=============================================================================
function count = checksummedCount(packages)
  count = 0;
  for k = 1:length(packages)
    if packageChecksummed(packages(k))
      count = count + 1;
    end
  end
end
%=============================================================================
function tf = packageChecksummed(package)
  if hasArtifacts(package)
    tf = true;
    for field = fieldnames(package.artifacts)'
      selected = package.artifacts.(field{1});
      if ~(isstruct(selected) && isfield(selected, 'checksum') ...
          && ischar(selected.checksum) && ~isempty(selected.checksum))
        tf = false;
        return
      end
    end
    return
  end
  tf = hasTextField(package, 'checksum');
end
%=============================================================================
function count = countTextField(packages, field)
  count = 0;
  for k = 1:length(packages)
    if hasTextField(packages(k), field)
      count = count + 1;
    end
  end
end
%=============================================================================
function tf = hasTextField(package, field)
  tf = isfield(package, field) && ischar(package.(field)) && ~isempty(package.(field));
end
%=============================================================================
function source = packageSource(package)
  source = '';
  if isfield(package, 'source')
    source = package.source;
  elseif isfield(package, 'url')
    source = package.url;
  elseif isfield(package, 'archive')
    source = package.archive;
  end
  if ~ischar(source)
    source = '';
  end
end
%=============================================================================
function label = packageLabel(package)
  label = '';
  if isfield(package, 'name')
    label = package.name;
  end
  if isfield(package, 'version')
    label = [label, '@', package.version];
  end
end
%=============================================================================
function values = appendUnique(values, value)
  if ~any(strcmp(values, value))
    values{end + 1} = value;
  end
end
%=============================================================================
function registry = readRegistry()
  % the registry bytes are fetched and verified (checksum, Ed25519
  % signature) by nmm_registry_fetch before being parsed
  source = registrySource();
  if ~nmm_is_remote_registry(source) && ~isfile(source)
    nmm_error('RegistryNotConfigured', registryNotConfiguredMessage());
  end
  localFile = nmm_registry_fetch(source);
  registry = jsondecode(localFile, '-file');
end
%=============================================================================
function msg = registryNotConfiguredMessage()
  msg = 'Package registry is not configured. Set NELSON_NMM_REGISTRY or create registry.json in usermodulesdir(). Local source, archive and offline cache commands remain available.';
end
%=============================================================================
function source = registrySource()
  source = nmm_registry_source();
end
%=============================================================================
function verifyRegistryChecksum(source)
  checksumFile = [source, '.sha256'];
  if ~isfile(checksumFile)
    nmm_error('RegistryChecksumMissing', 'Registry checksum file is missing.');
  end
  expected = strtrim(fileread(checksumFile));
  separator = strfind(expected, ' ');
  if ~isempty(separator)
    expected = expected(1:separator(1) - 1);
  end
  actual = sha256(source, '-file');
  if ~strcmpi(expected, actual)
    nmm_error('RegistryChecksumMismatch', 'Registry checksum does not match.');
  end
end
%=============================================================================
function tf = isYankedPackage(package)
  % "yanked": true marks a published version withdrawn by its author.
  tf = false;
  if isfield(package, 'yanked') && ~isempty(package.yanked)
    value = package.yanked;
    if islogical(value) || isnumeric(value)
      tf = logical(value(1));
    elseif ischar(value)
      tf = any(strcmpi(value, {'true', '1', 'yes'}));
    end
  end
end
%=============================================================================
function tf = packageMatches(package, query)
  q = lower(query);
  text = lower(packageText(package));
  tf = contains(text, q);
end
%=============================================================================
function text = packageText(package)
  text = '';
  fields = {'name', 'version', 'summary', 'description', 'keywords'};
  for field = fields
    if isfield(package, field{1})
      value = package.(field{1});
      if ischar(value)
        text = [text, ' ', value];
      elseif iscellstr(value)
        for k = value(:)'
          text = [text, ' ', k{1}];
        end
      elseif isstring(value)
        text = [text, ' ', char(join(value, ' '))];
      end
    end
  end
end
%=============================================================================
function result = appendPackage(result, package)
  if isempty(result)
    result = package;
  else
    result(end + 1) = package;
  end
end
%=============================================================================
function latest = latestPackage(packages)
  latest = packages(1);
  for k = 2:length(packages)
    if semver(packages(k).version, latest.version) == 1
      latest = packages(k);
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [localFile, info] = nmm_registry_fetch(source)
  % Returns a local, verified copy of the configured registry.
  %
  % Local file: the ".sha256" sidecar is mandatory and the ".sig" sidecar,
  % when present, must carry a valid signature from a trusted key.
  %
  % Remote source (http, https, file): "registry.json" and "registry.json.sig"
  % are fetched as raw bytes, the signature is verified BEFORE the JSON is
  % parsed, then the pair is stored in the nmm cache. When the fetch fails and
  % a previously verified copy exists in the cache, that copy is re-verified
  % and used (offline mode). An unsigned remote registry is refused unless
  % NELSON_NMM_REGISTRY_ALLOW_UNSIGNED=1.
  %
  % NELSON_NMM_REGISTRY_REUSE=1 lets a caller issuing several registry queries
  % in a row (the package manager window refreshing) download the registry
  % once: a remote registry already fetched by this process is then served
  % from its cached copy, re-verified like an offline copy, without network.
  info = struct();
  info.source = source;
  info.remote = nmm_is_remote_registry(source);
  info.signature_present = false;
  info.verified = false;
  info.public_key = '';
  info.offline = false;
  info.cached_file = '';
  info.signature_file = [source, '.sig'];
  if info.remote
    [localFile, info] = fetchRemote(source, info);
  else
    [localFile, info] = fetchLocal(source, info);
  end
end
%=============================================================================
function [localFile, info] = fetchLocal(source, info)
  if ~isfile(source)
    nmm_error('RegistryFileMissing', 'Registry file is missing: %s', source);
  end
  verifyChecksum(source);
  signature = nmm_registry_signature('verify-if-present', source);
  info.signature_present = signature.present;
  info.verified = signature.ok;
  info.public_key = signature.public_key;
  localFile = source;
end
%=============================================================================
function [localFile, info] = fetchRemote(source, info)
  cacheDir = registryCacheDir(source);
  cachedFile = [cacheDir, 'registry.json'];
  if reuseRequested() && fetchedSources('has', source) && isfile(cachedFile)
    info = verifyFetchedRegistry(cachedFile, source, info);
    info.cached_file = cachedFile;
    localFile = cachedFile;
    return
  end
  % Short-lived on-disk cache: an http(s) registry downloaded moments ago is
  % reused (re-verified, no network round trip) so a burst of separate CLI
  % processes (nmm search, then nmm install) fetches it once. Unlike the opt-in
  % in-process reuse above, this survives across processes and is on by default.
  % NELSON_NMM_REGISTRY_CACHE_TTL (seconds, 0 disables) overrides the 60 s
  % default. file:// stays always fresh (local, and tests rewrite it in place).
  if isNetworkRegistry(source) && isFreshRegistryCache(cachedFile)
    try
      info = verifyFetchedRegistry(cachedFile, source, info);
      info.cached_file = cachedFile;
      localFile = cachedFile;
      return
    catch
      % a stale or unusable cached copy falls through to a fresh fetch
    end
  end
  stagingDir = [tempdir(), 'nmm_registry_fetch_', shortHash(source), '/'];
  cleanupDirectory(stagingDir);
  mkdir(stagingDir);
  stagedFile = [stagingDir, 'registry.json'];
  stagedSignature = [stagedFile, '.sig'];
  try
    websave(stagedFile, source, nmm_web_options());
  catch e
    cleanupDirectory(stagingDir);
    if isfile(cachedFile)
      [localFile, info] = useOfflineCopy(cachedFile, info, e.message);
      return
    end
    nmm_error('RegistryFetchFailed', 'Registry cannot be fetched: %s (%s)', source, e.message);
  end
  try
    websave(stagedSignature, [source, '.sig'], nmm_web_options());
  catch
    if isfile(stagedSignature)
      rmfile(stagedSignature);
    end
  end
  try
    info = verifyFetchedRegistry(stagedFile, source, info);
  catch e
    cleanupDirectory(stagingDir);
    rethrow(e);
  end
  if ~isdir(cacheDir)
    mkdir(cacheDir);
  end
  copyfile(stagedFile, cachedFile);
  cachedSignature = [cachedFile, '.sig'];
  if isfile(stagedSignature)
    copyfile(stagedSignature, cachedSignature);
  elseif isfile(cachedSignature)
    rmfile(cachedSignature);
  end
  filewrite([cacheDir, 'source.txt'], source);
  cleanupDirectory(stagingDir);
  fetchedSources('add', source);
  info.cached_file = cachedFile;
  localFile = cachedFile;
end
%=============================================================================
function info = verifyFetchedRegistry(registryFile, source, info)
  signatureFile = [registryFile, '.sig'];
  if isfile(signatureFile)
    signature = nmm_registry_signature('verify', registryFile);
    info.signature_present = true;
    info.verified = signature.ok;
    info.public_key = signature.public_key;
    return
  end
  if ~allowUnsigned()
    nmm_error('RegistrySignatureMissing', 'Registry signature file is missing.');
  end
  warnUnsignedOnce(source);
end
%=============================================================================
function [localFile, info] = useOfflineCopy(cachedFile, info, reason)
  info = verifyFetchedRegistry(cachedFile, info.source, info);
  info.offline = true;
  info.cached_file = cachedFile;
  localFile = cachedFile;
  warning('Nelson:nmm:RegistryOffline', 'Registry cannot be fetched (%s): using the last verified copy.', reason);
end
%=============================================================================
function tf = reuseRequested()
  tf = strcmp(strtrim(getenv('NELSON_NMM_REGISTRY_REUSE')), '1');
end
%=============================================================================
function tf = isNetworkRegistry(source)
  tf = ischar(source) && (startsWith(source, 'http://') || startsWith(source, 'https://'));
end
%=============================================================================
function tf = isFreshRegistryCache(cachedFile)
  ttl = registryCacheTtlSeconds();
  if ttl <= 0 || ~isfile(cachedFile)
    tf = false;
    return
  end
  entry = dir(cachedFile);
  if isempty(entry) || ~isfield(entry, 'datenum')
    tf = false;
    return
  end
  ageSeconds = (now - entry.datenum) * 86400;
  tf = ageSeconds >= 0 && ageSeconds < ttl;
end
%=============================================================================
function ttl = registryCacheTtlSeconds()
  value = strtrim(getenv('NELSON_NMM_REGISTRY_CACHE_TTL'));
  if isempty(value)
    ttl = 60;
    return
  end
  n = str2double(value);
  if isnan(n) || n < 0
    ttl = 60;
  else
    ttl = n;
  end
end
%=============================================================================
function tf = fetchedSources(action, source)
  % Remote registries downloaded (and verified) by this process.
  persistent sources
  if isempty(sources)
    sources = {};
  end
  tf = any(strcmp(sources, source));
  if strcmp(action, 'add') && ~tf
    sources{end + 1} = source;
  end
end
%=============================================================================
function tf = allowUnsigned()
  tf = strcmp(strtrim(getenv('NELSON_NMM_REGISTRY_ALLOW_UNSIGNED')), '1');
end
%=============================================================================
function warnUnsignedOnce(source)
  persistent warnedSources
  if isempty(warnedSources)
    warnedSources = {};
  end
  if any(strcmp(warnedSources, source))
    return
  end
  warnedSources{end + 1} = source;
  warning('Nelson:nmm:RegistryUnsigned', 'Registry is not signed (NELSON_NMM_REGISTRY_ALLOW_UNSIGNED=1): %s', source);
end
%=============================================================================
function verifyChecksum(registryFile)
  checksumFile = [registryFile, '.sha256'];
  if ~isfile(checksumFile)
    nmm_error('RegistryChecksumMissing', 'Registry checksum file is missing.');
  end
  expected = strtrim(fileread(checksumFile));
  separator = strfind(expected, ' ');
  if ~isempty(separator)
    expected = expected(1:separator(1) - 1);
  end
  if ~strcmpi(expected, sha256(registryFile, '-file'))
    nmm_error('RegistryChecksumMismatch', 'Registry checksum does not match.');
  end
end
%=============================================================================
function cacheDir = registryCacheDir(source)
  cacheDir = [nmm_cache('dir'), 'registry/', sha256(source, '-string'), '/'];
end
%=============================================================================
function h = shortHash(source)
  h = sha256(source, '-string');
  h = h(1:16);
end
%=============================================================================
function cleanupDirectory(directory)
  if isdir(directory)
    rmdir(directory, 's');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function out = nmm_registry_signature(action, registryFile)
  % Ed25519 signature of a registry file, carried by the JSON sidecar
  % "<registry>.sig" (format described in writeRegistrySignature).
  switch action
    case 'verify'
      out = verifyRegistrySignature(registryFile, true);
    case 'verify-if-present'
      out = verifyRegistrySignature(registryFile, false);
    case 'write'
      out = writeRegistrySignature(registryFile);
    case 'trusted-keys'
      out = trustedKeys();
    otherwise
      nmm_error('UnknownRegistrySignatureAction', 'Unknown registry signature action.');
  end
end
%=============================================================================
function info = verifyRegistrySignature(registryFile, required)
  info = struct();
  info.signature_file = [registryFile, '.sig'];
  info.present = isfile(info.signature_file);
  info.ok = false;
  info.public_key = '';
  if ~info.present
    if required
      nmm_error('RegistrySignatureMissing', 'Registry signature file is missing.');
    end
    return
  end
  signatures = readSignatureFile(info.signature_file);
  keys = trustedKeys();
  trustedFound = false;
  seen = {};
  for k = 1:length(signatures)
    publicKey = signatures(k).public_key;
    seen{end + 1} = publicKey;
    if ~any(strcmp(keys, publicKey))
      continue
    end
    trustedFound = true;
    if crypto.ed25519.verify(registryFile, signatures(k).signature, publicKey, '-file')
      info.ok = true;
      info.public_key = publicKey;
      return
    end
  end
  if ~trustedFound
    nmm_error('RegistrySignatureUntrustedKey', 'Registry signature key is not trusted: %s', strjoin(seen, ', '));
  end
  nmm_error('RegistrySignatureMismatch', 'Registry signature does not match.');
end
%=============================================================================
function signatures = readSignatureFile(signatureFile)
  try
    document = jsondecode(signatureFile, '-file');
  catch
    nmm_error('RegistrySignatureFormatInvalid', 'Registry signature file is not valid: %s', signatureFile);
  end
  valid = isstruct(document) && isfield(document, 'format') && isfield(document, 'version') ...
    && isfield(document, 'algorithm') && isfield(document, 'signatures') ...
    && ischar(document.format) && strcmp(document.format, 'nmm-registry-signature') ...
    && isnumeric(document.version) && isscalar(document.version) && document.version == 1 ...
    && ischar(document.algorithm) && strcmp(document.algorithm, 'ed25519');
  if ~valid
    nmm_error('RegistrySignatureFormatInvalid', 'Registry signature file is not valid: %s', signatureFile);
  end
  entries = document.signatures;
  if iscell(entries)
    entries = [entries{:}];
  end
  if ~isstruct(entries) || isempty(entries) || ~isfield(entries, 'public_key') || ~isfield(entries, 'signature')
    nmm_error('RegistrySignatureFormatInvalid', 'Registry signature file is not valid: %s', signatureFile);
  end
  signatures = struct([]);
  for k = 1:length(entries)
    publicKey = entries(k).public_key;
    signature = entries(k).signature;
    if ~isHexString(publicKey, 64) || ~isHexString(signature, 128)
      nmm_error('RegistrySignatureFormatInvalid', 'Registry signature file is not valid: %s', signatureFile);
    end
    entry = struct('public_key', lower(publicKey), 'signature', lower(signature));
    if isempty(signatures)
      signatures = entry;
    else
      signatures(end + 1) = entry;
    end
  end
end
%=============================================================================
function info = writeRegistrySignature(registryFile)
  % Sidecar format (hexadecimal everywhere, pure Ed25519 over the exact bytes
  % of the registry file, several signatures allowed for key rotation):
  % {
  %   "format": "nmm-registry-signature", "version": 1, "algorithm": "ed25519",
  %   "file": "registry.json", "sha256": "<hex>",
  %   "signatures": [ { "public_key": "<hex 64>", "signature": "<hex 128>" } ]
  % }
  info = struct();
  info.signature_file = [registryFile, '.sig'];
  info.written = false;
  info.public_key = '';
  seed = signingSeed();
  if isempty(seed)
    return
  end
  [signature, publicKey] = crypto.ed25519.sign(registryFile, seed, '-file');
  [~, name, ext] = fileparts(registryFile);
  document = struct();
  document.format = 'nmm-registry-signature';
  document.version = 1;
  document.algorithm = 'ed25519';
  document.file = [name, ext];
  document.sha256 = sha256(registryFile, '-file');
  document.signatures = {struct('public_key', publicKey, 'signature', signature)};
  filewrite(info.signature_file, jsonprettyprint(jsonencode(document)));
  info.written = true;
  info.public_key = publicKey;
end
%=============================================================================
function keys = trustedKeys()
  % official keys + NELSON_NMM_REGISTRY_PUBLIC_KEY (';' separated) + the key
  % derived from the configured signing seed (a signer trusts itself).
  keys = nmm_registry_trusted_keys();
  extra = getenv('NELSON_NMM_REGISTRY_PUBLIC_KEY');
  if ~isempty(extra)
    parts = strsplit(extra, ';');
    for k = 1:length(parts)
      key = strtrim(parts{k});
      if isempty(key)
        continue
      end
      if ~isHexString(key, 64)
        nmm_error('RegistryPublicKeyInvalid', 'Registry public key must be 64 hexadecimal characters: %s', key);
      end
      keys{end + 1} = key;
    end
  end
  seed = signingSeed();
  if ~isempty(seed)
    [~, publicKey] = crypto.ed25519.sign(uint8([]), seed);
    keys{end + 1} = publicKey;
  end
  keys = unique(lower(keys));
  if ~iscell(keys)
    keys = {};
  end
end
%=============================================================================
function seed = signingSeed()
  seed = strtrim(getenv('NELSON_NMM_REGISTRY_SIGNING_KEY'));
  if isempty(seed)
    seed = '';
    return
  end
  if ~isHexString(seed, 64)
    nmm_error('RegistrySigningKeyInvalid', 'Registry signing key must be 64 hexadecimal characters (Ed25519 seed).');
  end
end
%=============================================================================
function tf = isHexString(value, expectedLength)
  tf = ischar(value) && isrow(value) && length(value) == expectedLength ...
    && all(ismember(lower(value), '0123456789abcdef'));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function source = nmm_registry_source()
  % Resolve the package registry Nelson reads, in order of precedence:
  %   1. NELSON_NMM_REGISTRY (explicit override: a file path or an http(s) URL);
  %   2. a registry.json created locally in usermodulesdir(), when it exists;
  %   3. the official Nelson package registry (signed, verified against the
  %      public key embedded in nmm_registry_trusted_keys).
  % So a fresh install browses and installs packages with no configuration,
  % while a local or private registry still takes precedence when set up.
  source = strtrim(getenv('NELSON_NMM_REGISTRY'));
  if ~isempty(source)
    return
  end
  local = [usermodulesdir(), 'registry.json'];
  if isfile(local)
    source = local;
    return
  end
  source = 'https://raw.githubusercontent.com/nelson-lang/nelson-modules-registry/master/registry.json';
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function keys = nmm_registry_trusted_keys()
  % Ed25519 public keys (64 lowercase hexadecimal characters) trusted to sign
  % the official Nelson package registry. Keep the current key and the next
  % key while a rotation is in progress; remove a key only once every
  % registry still served has been re-signed with its successor.
  %
  % Additional keys for private registries come from the environment
  % variable NELSON_NMM_REGISTRY_PUBLIC_KEY (';' separated) and, when a
  % signing seed is configured, from the seed itself: see
  % nmm_registry_signature('trusted-keys').
  keys = {'4113b7e0c4091683ca17524057769d3f1fadf2c22b371f135798dd35fde94924'};
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function report = nmm_repair(varargin)
  if length(varargin) ~= 0
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  modules = nmm_list();
  removed = {};
  for moduleName = fieldnames(modules)'
    name = moduleName{1};
    data = getfield(modules, name);
    [data, removed] = removeBrokenVersions(name, data, removed);
    if isempty(data)
      modules = rmfield(modules, name);
    else
      modules.(name) = data;
    end
  end
  saveModulesJson(modules);
  report = struct();
  report.removed = removed;
  report.ok = true;
end
%=============================================================================
function [data, removed] = removeBrokenVersions(moduleName, data, removed)
  versions = installedVersions(data);
  valid = struct([]);
  for k = 1:length(versions)
    if isfield(versions(k), 'path') && isdir(versions(k).path)
      valid = appendVersion(valid, versions(k));
    else
      removed{end + 1} = [moduleName, '@', versions(k).version];
    end
  end
  if isempty(valid)
    data = struct([]);
    if isempty(versions)
      removed{end + 1} = moduleName;
    end
    return
  end
  data = selectActiveVersion(data, valid);
end
%=============================================================================
function versions = installedVersions(module_data)
  versions = struct([]);
  if isfield(module_data, 'versions') && ~isempty(module_data.versions)
    versions = module_data.versions;
    return
  end
  if isfield(module_data, 'path') && isfield(module_data, 'version')
    versions = module_data;
    if isfield(versions, 'versions')
      versions = rmfield(versions, 'versions');
    end
    if isfield(versions, 'pinned_version')
      versions = rmfield(versions, 'pinned_version');
    end
  end
end
%=============================================================================
function versions = appendVersion(versions, versionData)
  if isempty(versions)
    versions = versionData;
  else
    versions(end + 1) = versionData;
  end
end
%=============================================================================
function data = selectActiveVersion(previousData, versions)
  activeVersion = latestInstalledVersion(versions);
  if isfield(previousData, 'pinned_version') && hasInstalledVersion(versions, previousData.pinned_version)
    activeVersion = previousData.pinned_version;
  end
  data = selectInstalledVersion(versions, activeVersion);
  data.versions = versions;
  if isfield(previousData, 'pinned_version') && hasInstalledVersion(versions, previousData.pinned_version)
    data.pinned_version = previousData.pinned_version;
  end
end
%=============================================================================
function version = latestInstalledVersion(versions)
  version = versions(1).version;
  for k = 2:length(versions)
    if semver(versions(k).version, version) == 1
      version = versions(k).version;
    end
  end
end
%=============================================================================
function r = hasInstalledVersion(versions, version)
  r = false;
  for k = 1:length(versions)
    if strcmp(versions(k).version, version)
      r = true;
      return
    end
  end
end
%=============================================================================
function selected = selectInstalledVersion(versions, version)
  selected = versions(1);
  for k = 1:length(versions)
    if strcmp(versions(k).version, version)
      selected = versions(k);
      return
    end
  end
end
%=============================================================================
function saveModulesJson(modules)
  modules_json_path = [usermodulesdir(), 'modules.json'];
  txt = jsonprettyprint(jsonencode(modules));
  filewrite(modules_json_path, txt);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function report = nmm_resolve(varargin)
  if length(varargin) < 1 || length(varargin) > 2
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  packageName = varargin{1};
  versionSpec = '';
  if length(varargin) == 2
    versionSpec = varargin{2};
  end
  if ~ischar(packageName)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 2);
  end
  if ~ischar(versionSpec)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 3);
  end
  packageInfo = nmm_latest(packageName, versionSpec);
  report = struct();
  report.package = packageInfo.name;
  report.version = packageInfo.version;
  report.requested = versionSpec;
  report.package_info = packageInfo;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function tf = nmm_satisfies(varargin)
  if length(varargin) ~= 2
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  version = varargin{1};
  constraint = varargin{2};
  if ~ischar(version)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 2);
  end
  if ~ischar(constraint)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 3);
  end
  if isVersionConstraint(constraint)
    tf = semverConstraintSatisfied(version, constraint);
  else
    tf = semver(version, constraint) == 0;
  end
end
%=============================================================================
function tf = semverConstraintSatisfied(version, constraint)
  tf = true;
  constraints = strsplit(strtrim(constraint), ' ');
  for k = 1:length(constraints)
    item = constraints{k};
    if isempty(item)
      continue
    end
    try
      if semver(version, item) ~= 1
        tf = false;
        return
      end
    catch
      tf = false;
      return
    end
  end
end
%=============================================================================
function tf = isVersionConstraint(value)
  tf = startsWith(value, '>') || startsWith(value, '<') ...
      || startsWith(value, '=') || startsWith(value, '^') ...
      || startsWith(value, '~') || contains(value, ' ');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function report = nmm_status(varargin)
  if length(varargin) ~= 1
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  packageName = varargin{1};
  if ~ischar(packageName)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 2);
  end
  report = emptyStatus(packageName);
  modules = nmm_list();
  if ~isfield(modules, packageName)
    return
  end
  moduleRecord = modules.(packageName);
  [~, moduleData] = nmm_find_installed_module(packageName);
  versions = installedVersions(moduleRecord);
  report.installed = true;
  report.version = moduleData.version;
  report.versions = versionNames(versions);
  report.path = moduleData.path;
  report.autoload = moduleData.load;
  report.pinned = isfield(moduleRecord, 'pinned_version');
  if report.pinned
    report.pinned_version = moduleRecord.pinned_version;
  end
  report.lockfile = isfile([moduleData.path, 'module-lock.json']);
  tree = nmm_tree(packageName);
  report.dependencies = nmm_deps(packageName);
  report.missing = tree.missing;
  why = nmm_why(packageName);
  report.required_by = why.required_by;
  report.direct = why.direct;
  report.ok = report.lockfile && isempty(report.missing);
end
%=============================================================================
function report = emptyStatus(packageName)
  report = struct();
  report.package = packageName;
  report.installed = false;
  report.ok = false;
  report.version = '';
  report.versions = {};
  report.pinned = false;
  report.pinned_version = '';
  report.autoload = false;
  report.path = '';
  report.lockfile = false;
  report.dependencies = struct([]);
  report.missing = {};
  report.required_by = {};
  report.direct = false;
end
%=============================================================================
function versions = installedVersions(moduleData)
  versions = struct([]);
  if isfield(moduleData, 'versions') && ~isempty(moduleData.versions)
    versions = moduleData.versions;
    return
  end
  if isfield(moduleData, 'path') && isfield(moduleData, 'version')
    versions = moduleData;
    if isfield(versions, 'versions')
      versions = rmfield(versions, 'versions');
    end
    if isfield(versions, 'pinned_version')
      versions = rmfield(versions, 'pinned_version');
    end
  end
end
%=============================================================================
function names = versionNames(versions)
  names = {};
  for k = 1:length(versions)
    names{end + 1} = versions(k).version;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function report = nmm_tree(varargin)
  [args, jsonOutput] = nmm_json_option(varargin);
  if length(args) ~= 1
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  value = args{1};
  if ischar(value)
    report = installedTree(value);
  elseif isstruct(value)
    report = planTree(value);
  else
    nmm_error('InvalidArgumentType', '#%d argument: characters or struct expected.', 2);
  end
  report = nmm_json_output(report, jsonOutput);
end
%=============================================================================
function report = installedTree(packageName)
  [~, moduleData] = nmm_find_installed_module(packageName);
  if isempty(moduleData)
    report = missingNode(packageName, '');
    return
  end
  report = installedNode(packageName, moduleData, {});
end
%=============================================================================
function node = installedNode(packageName, moduleData, stack)
  node = emptyNode(packageName, moduleData.version);
  node.installed = true;
  node.action = 'installed';
  if any(strcmp(stack, packageName))
    node.conflicts = {[strjoin([stack, {packageName}], ' -> '), ' cycle']};
    return
  end
  dependencies = lockDependencies(moduleData);
  stack{end + 1} = packageName;
  for dependency = fieldnames(dependencies)'
    dependencyName = dependency{1};
    dependencyVersion = dependencies.(dependencyName);
    [~, dependencyData] = nmm_find_installed_module(dependencyName, dependencyVersion);
    if isempty(dependencyData)
      child = missingNode(dependencyName, dependencyVersion);
    else
      child = installedNode(dependencyName, dependencyData, stack);
      child.requested = dependencyVersion;
    end
    node = appendChild(node, child);
  end
end
%=============================================================================
function report = planTree(planOrReport)
  plan = normalizedPlan(planOrReport);
  if isempty(plan)
    nmm_error('InstallPlanEmpty', 'Install plan is empty.');
  end
  if isfield(planOrReport, 'install_plan') && isfield(planOrReport, 'package')
    root = planOrReport.package;
  else
    root = plan(1).package;
  end
  report = planNode(root, plan, {});
  if isfield(planOrReport, 'conflicts') && iscell(planOrReport.conflicts)
    report.conflicts = mergeValues(report.conflicts, planOrReport.conflicts);
  end
end
%=============================================================================
function node = planNode(packageName, plan, stack)
  item = findPlanItem(plan, packageName);
  if isempty(item)
    [~, moduleData] = nmm_find_installed_module(packageName);
    if isempty(moduleData)
      node = missingNode(packageName, '');
    else
      node = installedNode(packageName, moduleData, stack);
    end
    return
  end
  node = emptyNode(item.package, item.version);
  node.installed = nmm_is_installed(item.package, item.version);
  node.action = item.action;
  if isfield(item, 'requested')
    node.requested = item.requested;
  end
  if any(strcmp(stack, item.package))
    node.conflicts = {[strjoin([stack, {item.package}], ' -> '), ' cycle']};
    return
  end
  dependencies = planDependencies(item);
  stack{end + 1} = item.package;
  for dependency = fieldnames(dependencies)'
    dependencyName = dependency{1};
    child = planNode(dependencyName, plan, stack);
    child.requested = dependencies.(dependencyName);
    node = appendChild(node, child);
  end
end
%=============================================================================
function node = emptyNode(packageName, packageVersion)
  node = struct();
  node.package = packageName;
  node.version = packageVersion;
  node.installed = false;
  node.requested = '';
  node.action = '';
  node.dependencies = struct([]);
  node.missing = {};
  node.conflicts = {};
end
%=============================================================================
function node = missingNode(packageName, requested)
  node = emptyNode(packageName, '');
  node.requested = requested;
  node.action = 'missing';
  node.missing = {missingLabel(packageName, requested)};
end
%=============================================================================
function node = appendChild(node, child)
  if isempty(node.dependencies)
    node.dependencies = child;
  else
    node.dependencies(end + 1) = child;
  end
  node.missing = mergeValues(node.missing, child.missing);
  node.conflicts = mergeValues(node.conflicts, child.conflicts);
end
%=============================================================================
function item = findPlanItem(plan, packageName)
  item = struct([]);
  for k = 1:length(plan)
    if strcmp(plan(k).package, packageName)
      item = plan(k);
      return
    end
  end
end
%=============================================================================
function dependencies = lockDependencies(moduleData)
  dependencies = struct();
  if ~isfield(moduleData, 'path')
    return
  end
  lockFile = [moduleData.path, 'module-lock.json'];
  if ~isfile(lockFile)
    return
  end
  try
    lock = jsondecode(lockFile, '-file');
    if isfield(lock, 'dependencies') && isstruct(lock.dependencies)
      dependencies = lock.dependencies;
    end
  catch
  end
end
%=============================================================================
function plan = normalizedPlan(planOrReport)
  if isfield(planOrReport, 'install_plan')
    plan = planOrReport.install_plan;
  else
    plan = planOrReport;
  end
  if isempty(plan)
    plan = struct([]);
  end
end
%=============================================================================
function dependencies = planDependencies(item)
  dependencies = struct();
  if isfield(item, 'dependencies') && isstruct(item.dependencies)
    dependencies = item.dependencies;
  end
end
%=============================================================================
function values = mergeValues(values, extra)
  for k = 1:length(extra)
    if ~any(strcmp(values, extra{k}))
      values{end + 1} = extra{k};
    end
  end
end
%=============================================================================
function label = missingLabel(packageName, requested)
  label = packageName;
  if ~isempty(requested)
    label = [packageName, '@', requested];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function report = nmm_uninstall(varargin)
  if length(varargin) < 1 || length(varargin) > 3
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  module_or_directory = varargin{1};
  if ~ischar(module_or_directory)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 2);
  end
  options = parseOptions(varargin(2:end));
  version = options.version;
  [module_name, module_data] = nmm_find_installed_module(module_or_directory, version);
  if isempty(module_data)
    nmm_error('ModuleNameExpected', 'module name or existing directory installed is expected.');
  end
  removeAll = isempty(version) && ~isdir(module_or_directory);
  report = removalReport(module_name, module_data, removeAll, options);
  if options.dry_run
    return
  end
  if ~options.force && ~isempty(report.required_by)
    nmm_error('PackageRequired', requiredByMessage(module_name));
  end
  nmm_progress('remove', module_name, report.version, 'remove', 1, 2);
  if removeAll
    uninstallAllVersions(module_name);
  else
    uninstallOneVersion(module_name, module_data);
  end
  nmm_progress('remove', module_name, report.version, 'done', 2, 2);
  report.removed = true;
  report.changed = true;
end
%=============================================================================
function options = parseOptions(args)
  options = struct();
  options.version = '';
  options.dry_run = false;
  options.force = false;
  for k = 1:length(args)
    value = args{k};
    if ~ischar(value)
      nmm_error('CharactersExpected', '#%d argument: characters expected.', 3);
    end
    switch value
      case '-dry-run'
        options.dry_run = true;
      case '-force'
        options.force = true;
      otherwise
        if ~isempty(options.version)
          nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
        end
        options.version = value;
    end
  end
end
%=============================================================================
function report = removalReport(module_name, module_data, removeAll, options)
  report = struct();
  report.package = module_name;
  report.version = '';
  if ~removeAll
    report.version = module_data.version;
  end
  report.remove_all = removeAll;
  report.dry_run = options.dry_run;
  report.forced = options.force;
  report.removed = false;
  report.changed = false;
  report.paths = removalPaths(module_name, module_data, removeAll);
  report.required_by = reverseDependencies(module_name, report.version);
  report.allowed = options.force || isempty(report.required_by);
end
%=============================================================================
function paths = removalPaths(module_name, module_data, removeAll)
  if removeAll
    modules = nmm_list();
    versions = installedVersions(getfield(modules, module_name));
  else
    versions = module_data;
  end
  paths = {};
  for k = 1:length(versions)
    paths{end + 1} = versions(k).path;
  end
end
%=============================================================================
function report = reverseDependencies(module_name, version)
  all = nmm_rdeps(module_name);
  report = struct([]);
  for k = 1:length(all)
    if isempty(version) || strcmp(all(k).requested, version)
      report = appendReverseDependency(report, all(k));
    end
  end
end
%=============================================================================
function report = appendReverseDependency(report, item)
  if isempty(report)
    report = item;
  else
    report(end + 1) = item;
  end
end
%=============================================================================
function msg = requiredByMessage(module_name)
  msg = sprintf(_('Package is required by installed modules: %s. Use -force to remove it.'), module_name);
end
%=============================================================================
function uninstallAllVersions(module_name)
  modules = nmm_list();
  module_record = getfield(modules, module_name);
  versions = installedVersions(module_record);
  if ismodule(module_name)
    removemodule(module_name);
  end
  if ismodule('help_tools')
    deployhelp('remove', module_name);
  end
  for k = 1:length(versions)
    removeInstalledDirectory(versions(k).path);
  end
  modules = rmfield(modules, module_name);
  writeModulesJson(modules);
end
%=============================================================================
function uninstallOneVersion(module_name, module_data)
  modules = nmm_list();
  module_record = getfield(modules, module_name);
  activePath = module_record.path;
  if ismodule(module_name) && strcmp(activePath, module_data.path)
    removemodule(module_name);
  end
  if ismodule('help_tools')
    deployhelp('remove', module_name);
  end
  removeInstalledDirectory(module_data.path);
  versions = removeInstalledVersion(installedVersions(module_record), module_data.version);
  if isempty(versions)
    modules = rmfield(modules, module_name);
  else
    active = selectActiveAfterRemove(module_record, versions);
    modules.(module_name) = active;
  end
  writeModulesJson(modules);
end
%=============================================================================
function removeInstalledDirectory(module_path)
  p = usermodulesdir();
  if ~startsWith(module_path, p)
    return
  end
  if ~isdir(module_path)
    return
  end
  parent_dir = fullpath([module_path, '/..']);
  d = dir(parent_dir);
  if length(d) == 3
    [r, msg] = rmdir(parent_dir, 's');
  else
    [r, msg] = rmdir(module_path, 's');
  end
  if ~r
    nmm_error('InstalledDirectoryRemoveFailed', msg);
  end
end
%=============================================================================
function versions = installedVersions(module_data)
  versions = struct([]);
  if isfield(module_data, 'versions') && ~isempty(module_data.versions)
    versions = module_data.versions;
    return
  end
  if isfield(module_data, 'path') && isfield(module_data, 'version')
    versions = module_data;
    if isfield(versions, 'versions')
      versions = rmfield(versions, 'versions');
    end
    if isfield(versions, 'pinned_version')
      versions = rmfield(versions, 'pinned_version');
    end
  end
end
%=============================================================================
function versions = removeInstalledVersion(versions, version)
  keep = [];
  for k = 1:length(versions)
    if ~strcmp(versions(k).version, version)
      keep = [keep, k];
    end
  end
  versions = versions(keep);
end
%=============================================================================
function active = selectActiveAfterRemove(module_record, versions)
  activeVersion = latestInstalledVersion(versions);
  if isfield(module_record, 'pinned_version') && hasInstalledVersion(versions, module_record.pinned_version)
    activeVersion = module_record.pinned_version;
  end
  active = selectInstalledVersion(versions, activeVersion);
  active.versions = versions;
  if isfield(module_record, 'pinned_version') && hasInstalledVersion(versions, module_record.pinned_version)
    active.pinned_version = module_record.pinned_version;
  end
end
%=============================================================================
function version = latestInstalledVersion(versions)
  version = versions(1).version;
  for k = 2:length(versions)
    if semver(versions(k).version, version) == 1
      version = versions(k).version;
    end
  end
end
%=============================================================================
function r = hasInstalledVersion(versions, version)
  r = false;
  for k = 1:length(versions)
    if strcmp(versions(k).version, version)
      r = true;
      return
    end
  end
end
%=============================================================================
function selected = selectInstalledVersion(versions, version)
  selected = struct([]);
  for k = 1:length(versions)
    if strcmp(versions(k).version, version)
      selected = versions(k);
      return
    end
  end
end
%=============================================================================
function writeModulesJson(modules)
  filewrite([usermodulesdir(), 'modules.json'], jsonprettyprint(jsonencode(modules)));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
