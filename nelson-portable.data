% LICENCE_BLOCK_END
%=============================================================================
function material(varargin)
  nargoutchk(0, 0);
  inputArguments = convertStringToCharArgs(varargin);
  if isempty(inputArguments)
    inputArguments = {'default'};
  end
  if isscalar(inputArguments{1}) && isgraphics(inputArguments{1}, 'axes')
    ax = inputArguments{1};
    inputArguments = inputArguments(2:end);
  else
    ax = gca();
  end
  values = materialValues(inputArguments);
  h = surfacePatchChildren(ax);
  if ~isempty(h)
    set(h, 'AmbientStrength', values(1), 'DiffuseStrength', values(2), ...
      'SpecularStrength', values(3), 'SpecularExponent', values(4), ...
      'SpecularColorReflectance', values(5));
  end
end
%=============================================================================
function values = materialValues(args)
  if length(args) == 1 && ischar(args{1})
    name = lower(args{1});
    if strcmp(name, 'default')
      values = [0.3, 0.6, 0.9, 10, 1];
    elseif strcmp(name, 'shiny')
      values = [0.3, 0.6, 0.9, 20, 1];
    elseif strcmp(name, 'dull')
      values = [0.3, 0.8, 0.0, 10, 1];
    elseif strcmp(name, 'metal')
      values = [0.3, 0.3, 1.0, 25, 0.5];
    else
      error('Nelson:material:invalidPropertyValue', 'Illegal selection for property.');
    end
  elseif length(args) == 1 && isnumeric(args{1}) && isvector(args{1})
    values = args{1}(:)';
  else
    values = cell2mat(args);
  end
  if ~isnumeric(values) || ~isvector(values) || ~any(numel(values) == [4 5])
    error('Nelson:material:invalidMaterialValues', 'Material values must be a four or five element vector.');
  end
  if numel(values) == 4
    values(5) = 1;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = mesh(varargin)
  narginchk(1, 1000);
  nargoutchk(0, 1);

  inputArguments = convertStringToCharArgs(varargin);
  nbInputArguments = length(inputArguments);
  if (nbInputArguments >= 2) && (length(inputArguments{1}) == 1) && isgraphics(inputArguments{1}, 'axes')
    go = newplotTarget(inputArguments{1}(1));
    inputArguments = inputArguments(2:end);
  else
    go = newplotTarget(graphicsParentProperty(inputArguments));
  end

  firstProperty = find(cellfun('isclass', inputArguments, 'char'), 1);
  if isempty(firstProperty)
    firstProperty = length(inputArguments) + 1;
  end
  propertiesList = inputArguments(firstProperty:end);
  dataArguments = inputArguments(1:firstProperty - 1);
  defaultProperties = {'FaceColor', 'w', 'EdgeColor', 'flat', 'FaceLighting', 'none', 'EdgeLighting', 'flat'};
  % Concatenate at the cell level: expanding the comma list here would build a
  % matrix out of the data, the property names and the handles, which fails as
  % soon as a name/value pair is given. The defaults come before the caller
  % properties so that a property set by the caller wins over the mesh default.
  args = [dataArguments, defaultProperties, propertiesList];
  h = surface(go, args{:});

  % Adding to a group leaves the axes untouched: newplot did not start it anew,
  % so the 3-D framing is not applied either.
  if (~isgraphics(go, 'hggroup') && ~ishold(go))
    view(go, 3);
    grid(go, 'on');
  end
  if nargout > 0
    varargout{1} = h;
  end
end
%=============================================================================
ï»¿%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
