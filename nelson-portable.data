% LICENCE_BLOCK_END
%=============================================================================
function R = istriu(M)
  R = (islogical(M) || isnumeric(M)) && (ndims(M) == 2);
  if (R)
    [I, J] = find(M);
    R = all(I <= J);
  end
end
