function obj = setabstime(obj, startDate)
  info = obj.TimeInfo;
  info.StartDate = startDate;
  obj.TimeInfo = info;
  names = fieldnames(obj.Members_);
  for k = 1:length(names)
    obj.Members_.(names{k}) = setabstime(obj.Members_.(names{k}), startDate);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function obj = settimeseriesnames(obj, names)
  if ischar(names) || isstring(names)
    names = cellstr(names);
  end
  if ~iscell(names)
    error('Nelson:time:timeseriesNamesCellArrayText', '%s must be a cell array of text.', 'Timeseries names');
  end
  current = fieldnames(obj.Members_);
  if length(names) ~= length(current)
    error('Nelson:time:numberNamesMatchNumberTimeseries', 'Number of names must match the number of timeseries members.');
  end
  values = cell(length(current), 1);
  for k = 1:length(current)
    values{k} = obj.Members_.(current{k});
  end
  obj.Members_ = struct();
  for k = 1:length(names)
    name = tscollectionValidName(timeseriesText(names{k}, 'Timeseries name'));
    values{k}.Name = name;
    obj.Members_.(name) = values{k};
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
classdef tscollection
  properties
    Name
    TimeInfo
  end

  properties (Dependent)
    Time
    Length
  end

  properties (Hidden)
    Time_
    Members_
  end

  methods
    function obj = tscollection(varargin)
      obj.Name = '';
      obj.Time_ = zeros(0, 1);
      obj.TimeInfo = tsdata.timemetadata();
      obj.Members_ = struct();
      if nargin == 0
        return
      end
      if iscell(varargin{1})
        obj = addCellTimeseries(obj, varargin{1});
        args = varargin(2:end);
      elseif istimeseries(varargin{1})
        obj.Time_ = varargin{1}.Time;
        obj.TimeInfo = varargin{1}.TimeInfo;
        obj = addts(obj, varargin{1});
        args = varargin(2:end);
      else
        obj.Time_ = timeseriesNormalizeTime(varargin{1});
        args = varargin(2:end);
      end
      obj = tscollectionRefreshMetadata(obj);
      obj = applyNameValues(obj, args{:});
    end

    function value = get.Time(obj)
      value = obj.Time_;
    end

    function obj = set.Time(obj, value)
      obj.Time_ = timeseriesNormalizeTime(value);
      obj = tscollectionRefreshMetadata(obj);
      names = fieldnames(obj.Members_);
      for k = 1:length(names)
        obj.Members_.(names{k}) = resample(obj.Members_.(names{k}), obj.Time_);
      end
    end

    function value = get.Length(obj)
      value = length(obj.Time_);
    end

    function n = numel(varargin)
      n = 1;
    end

    function n = length(obj)
      n = obj.Length;
    end

    function tf = isempty(obj)
      tf = isempty(fieldnames(obj.Members_));
    end

    function varargout = size(obj, varargin)
      sz = [obj.Length, length(fieldnames(obj.Members_))];
      if nargin == 1
        if nargout <= 1
          varargout{1} = sz;
        else
          for k = 1:nargout
            if k <= length(sz)
              varargout{k} = sz(k);
            else
              varargout{k} = 1;
            end
          end
        end
      else
        varargout{1} = sz(varargin{1});
      end
    end

    function n = end(obj, k, count)
      sz = size(obj);
      if count == 1
        n = obj.Length;
      elseif k <= length(sz)
        n = sz(k);
      else
        n = 1;
      end
    end

    function value = subsref(obj, s)
      if strcmp(s(1).type, '.') && isfield(obj.Members_, s(1).subs)
        value = obj.Members_.(s(1).subs);
        if length(s) > 1
          value = subsref(value, s(2:end));
        end
        return
      end
      if strcmp(s(1).type, '()')
        value = getsampleusingtime(obj, obj.Time_(s(1).subs{:}));
        if length(s) > 1
          value = subsref(value, s(2:end));
        end
        return
      end
      if strcmp(s(1).type, '.')
        value = dotReference(obj, s(1).subs);
        if length(s) > 1
          value = subsref(value, s(2:end));
        end
        return
      end
      error('Nelson:time:invalidTscollectionIndexing', 'Invalid %s.', 'tscollection indexing');
    end

    function obj = subsasgn(obj, s, value)
      if strcmp(s(1).type, '.') && istimeseries(value)
        obj = addts(obj, value, s(1).subs);
        return
      end
      if strcmp(s(1).type, '.')
        obj = dotAssign(obj, s(1).subs, value);
        return
      end
      error('Nelson:time:invalidTscollectionAssignment', 'Invalid %s.', 'tscollection assignment');
    end

    function names = fieldnames(obj)
      names = fieldnames(obj.Members_);
    end

    function disp(obj)
      collectionName = obj.Name;
      if isempty(collectionName)
        collectionName = 'unnamed';
      end
      disp(['Time Series Collection Object: ', collectionName]);
      disp(' ');
      disp('Time vector characteristics');
      disp(' ');
      if obj.Length ~= 0
        disp(['      Start time            ', tscollectionFormatTime(obj, obj.Time_(1))]);
        disp(['      End time              ', tscollectionFormatTime(obj, obj.Time_(end))]);
      end
      disp(' ');
      disp('Member Time Series Objects:');
      disp(' ');
      names = fieldnames(obj.Members_);
      for k = 1:length(names)
        member = obj.Members_.(names{k});
        memberName = member.Name;
        if isempty(memberName)
          memberName = names{k};
        end
        disp(['      ', memberName]);
      end
    end

    function display(obj, varargin)
      if nargin == 2
        name = varargin{1};
      else
        name = inputname(1);
      end
      if ~isempty(name)
        disp([name, ' =']);
        disp(' ');
      end
      disp(obj);
    end

    function value = dotReference(obj, name)
      state = struct(obj);
      switch name
        case 'Time'
          value = state.Time_;
        case 'Length'
          value = length(state.Time_);
        otherwise
          if isfield(state.Members_, name)
            value = state.Members_.(name);
          elseif isfield(state, name)
            value = state.(name);
          else
            error('Nelson:time:unknownTscollectionProperty', 'Unknown %s property.', 'tscollection');
          end
      end
    end

    function obj = dotAssign(obj, name, value)
      if istimeseries(value)
        obj = addts(obj, value, name);
        return
      end
      switch name
        case 'Time'
          obj.Time = value;
        case 'Name'
          obj.Name = timeseriesText(value, 'Name');
        case 'TimeInfo'
          obj.TimeInfo = value;
          obj = tscollectionRefreshMetadata(obj);
        otherwise
          error('Nelson:time:unknownTscollectionProperty', 'Unknown %s property.', 'tscollection');
      end
    end
  end

  methods (Static)
    function obj = loadobj(value)
      if isa(value, 'tscollection')
        obj = value;
        obj = tscollectionRefreshMetadata(obj);
        return
      end
      if isstruct(value)
        obj = tscollection();
        fields = fieldnames(value);
        for k = 1:length(fields)
          obj.(fields{k}) = value.(fields{k});
        end
        if isempty(obj.TimeInfo)
          obj.TimeInfo = tsdata.timemetadata();
        end
        if isempty(obj.Members_)
          obj.Members_ = struct();
        end
        obj = tscollectionRefreshMetadata(obj);
        return
      end
      error('Nelson:time:inputTscollectionObjectStructure', 'Input must be a tscollection object or structure.');
    end
  end
end
%=============================================================================
function obj = addCellTimeseries(obj, series)
  for k = 1:numel(series)
    ts = series{k};
    if ~istimeseries(ts)
      error('Nelson:time:inputCellArrayContainTimeseries', 'Input cell array must contain timeseries objects.');
    end
    if isempty(fieldnames(obj.Members_))
      obj.Time_ = ts.Time;
      obj.TimeInfo = ts.TimeInfo;
    end
    obj = addts(obj, ts);
  end
end
%=============================================================================
function text = tscollectionFormatTime(obj, value)
  if isa(value, 'datetime') || isa(value, 'duration')
    text = char(string(value));
    return
  end
  units = obj.TimeInfo.Units;
  if isempty(units)
    units = 'seconds';
  end
  text = [num2str(value), ' ', units];
end
%=============================================================================
function obj = applyNameValues(obj, varargin)
  if rem(length(varargin), 2) ~= 0
    error('Nelson:time:nameValueArgumentsAppearPairs', 'Name-value arguments must be paired.');
  end
  for k = 1:2:length(varargin)
    name = lower(timeseriesText(varargin{k}, 'Property name'));
    switch name
      case 'name'
        obj.Name = varargin{k + 1};
      case 'timeinfo'
        obj.TimeInfo = varargin{k + 1};
      otherwise
        error('Nelson:time:unsupportedCollectionProperty', 'Unsupported %s.', 'collection property');
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function out = vertcat(varargin)
  out = varargin{1};
  for k = 2:nargin
    names = fieldnames(out.Members_);
    for j = 1:length(names)
      if isfield(varargin{k}.Members_, names{j})
        out.Members_.(names{j}) = append(out.Members_.(names{j}), varargin{k}.Members_.(names{j}));
      end
    end
    out.Time_ = [out.Time_; varargin{k}.Time(:)];
  end
  out = tscollectionRefreshMetadata(out);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function t = NaT(varargin)
  [sizes, fmt, tz] = parseNaTInputs(varargin{:});
  if isempty(sizes)
    values = NaN;
  elseif numel(sizes) == 1
    values = NaN(sizes{1}, sizes{1});
  else
    values = NaN(sizes{:});
  end
  t = datetime(values, 'ConvertFrom', 'datenum', 'Format', fmt, 'TimeZone', tz);
end
%=============================================================================
function [sizes, fmt, tz] = parseNaTInputs(varargin)
  sizes = {};
  fmt = 'dd-MMM-yyyy';
  tz = '';
  k = 1;
  while k <= nargin
    if ischar(varargin{k}) || (isstring(varargin{k}) && isscalar(varargin{k}))
      name = char(varargin{k});
      if strcmpi(name, 'Format')
        fmt = char(varargin{k + 1});
        k = k + 2;
        continue
      elseif strcmpi(name, 'TimeZone')
        tz = char(varargin{k + 1});
        k = k + 2;
        continue
      end
    end
    value = varargin{k};
    if isnumeric(value) && isvector(value) && numel(value) > 1 && nargin == 1
      sizes = num2cell(double(value));
    else
      sizes{end + 1} = double(value);
    end
    k = k + 1;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function d = addtodate(d, q, f)
  narginchk(3, 3);
  nargoutchk(0, 1);

  isSupportedThirdArgType = (ischar(f) && isrow(f)) || isStringScalar(f);
  if ~isSupportedThirdArgType
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Date field');
  end
  f = convertStringsToChars(f);

  if (isscalar(d) && ~isscalar(q))
    d = repmat(d, size(q));
  end

  switch f
    case 'year'
      tmp = datevec(d);
      tmp(:, 1) = tmp(:, 1) + q(:);
      % clamp day to the last day of the target month (e.g. 29-Feb-2020 + 1 year -> 28-Feb-2021)
      tmp(:, 3) = min(tmp(:, 3), eomday(tmp(:, 1), tmp(:, 2)));
      dnew = datenum(tmp);
      if (numel(d) == numel(dnew))
        d = reshape(dnew, size(d));
      else
        d = reshape(dnew, size(q));
      end
    case 'month'
      tmp = datevec(d);
      tmp(:, 2) = tmp(:, 2) + q(:);
      tmp(:, 1) = tmp(:, 1) + floor((tmp(:, 2) - 1) / 12);
      tmp(:, 2) = mod(tmp(:, 2) - 1, 12) + 1;
      % clamp day to the last day of the target month (e.g. 31-Jan-2020 + 1 month -> 29-Feb-2020)
      tmp(:, 3) = min(tmp(:, 3), eomday(tmp(:, 1), tmp(:, 2)));
      dnew = datenum(tmp);
      if (numel(d) == numel(dnew))
        d = reshape(dnew, size(d));
      else
        d = reshape(dnew, size(q));
      end
    case 'day'
      d = d + q .* (1);
    case 'hour'
      d = d + q .* (1 / 24);
    case 'minute'
      d = d + q .* (1 / 1440);
    case 'second'
      d = d + q .* (1 / 86400);
    case 'millisecond'
      d = d + q .* (1 / 86400000);
    otherwise
      error('Nelson:addtodate:invalidDateField', 'Date field "%s" is invalid.', f);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function c = between(t1, t2, components)
  narginchk(2, 3);
  if nargin < 3
    components = 'months';
  end
  serial1 = datenum(t1);
  serial2 = datenum(t2);
  [serial1, serial2] = expandPair(serial1, serial2);
  v1 = datevec(serial1(:));
  v2 = datevec(serial2(:));
  components = lower(char(components));
  switch components
    case {'years', 'year', 'y'}
      monthsValue = wholeMonths(v1, v2);
      monthsValue = fix(monthsValue ./ 12) .* 12;
      daysValue = zeros(size(monthsValue));
    case {'quarters', 'quarter', 'q'}
      monthsValue = wholeMonths(v1, v2);
      monthsValue = fix(monthsValue ./ 3) .* 3;
      daysValue = zeros(size(monthsValue));
    case {'months', 'month', 'm'}
      monthsValue = wholeMonths(v1, v2);
      anchor = addMonths(serial1(:), monthsValue);
      daysValue = floor(serial2(:)) - floor(anchor);
    case {'days', 'day', 'd'}
      monthsValue = zeros(size(serial1(:)));
      daysValue = floor(serial2(:)) - floor(serial1(:));
    otherwise
      monthsValue = wholeMonths(v1, v2);
      anchor = addMonths(serial1(:), monthsValue);
      daysValue = floor(serial2(:)) - floor(anchor);
  end
  secondsValue = (serial2(:) - floor(serial2(:)) - (serial1(:) - floor(serial1(:)))) .* 86400;
  c = calendarDuration.fromParts(reshape(monthsValue, size(serial1)), ...
    reshape(daysValue, size(serial1)), reshape(secondsValue, size(serial1)), 'ymd');
end
%=============================================================================
function m = wholeMonths(v1, v2)
  m = (v2(:, 1) - v1(:, 1)) .* 12 + (v2(:, 2) - v1(:, 2));
  adjustPositive = m >= 0 & v2(:, 3) < v1(:, 3);
  adjustNegative = m < 0 & v2(:, 3) > v1(:, 3);
  m(adjustPositive) = m(adjustPositive) - 1;
  m(adjustNegative) = m(adjustNegative) + 1;
end
%=============================================================================
function out = addMonths(serial, monthsValue)
  v = datevec(serial);
  v(:, 2) = v(:, 2) + monthsValue(:);
  y = v(:, 1) + floor((v(:, 2) - 1) ./ 12);
  m = mod(v(:, 2) - 1, 12) + 1;
  d = min(v(:, 3), eomday(y, m));
  out = datenum(y, m, d, v(:, 4), v(:, 5), v(:, 6));
end
%=============================================================================
function [a, b] = expandPair(a, b)
  if isscalar(a) && ~isscalar(b)
    a = repmat(a, size(b));
  elseif isscalar(b) && ~isscalar(a)
    b = repmat(b, size(a));
  elseif ~isequal(size(a), size(b))
    error('Nelson:time:inputSizesMatchScalar', 'Input sizes must match or be scalar.');
  end
end
