%=============================================================================
function s = stackedplot(varargin)
  narginchk(1, Inf);
  inputArguments = convertStringToCharArgs(varargin);
  [parent, inputArguments] = extractStackedplotParent(inputArguments);
  [xValues, names, values, legendLabels, xLabelName, xVariableName, displayVariables, ...
    sourceTable, options] = ...
    stackedplotArguments(inputArguments);
  options.Parent = parent;

  if isempty(values)
    error('Nelson:stackedplot:noPlottableVariablesFound', 'No plottable variables found.');
  end
  if length(values) > 25
    error('Nelson:stackedplot:tooManyVariablesTo', 'Too many variables to plot.');
  end

  if ~isempty(options.DisplayLabels)
    names = normalizeLabels(options.DisplayLabels, length(values));
  end
  if ~isempty(options.XLabel)
    xLabelName = options.XLabel;
  end

  [fig, previousDrawLater] = beginStackedplotDrawLater(parent);
  try
    s = createStackedLineChart(parent);
    [axesHandles, lineProperties, axesProperties] = ...
      renderStackedplotAxes(xValues, names, values, legendLabels, xLabelName, options);
    set(s, ...
      'Children', axesHandles, ...
      'DisplayLabels', names(:), ...
      'DisplayVariables', displayVariables, ...
      'EventsVisible', options.EventsVisible, ...
      'CombineMatchingNames', options.CombineMatchingNames, ...
      'XLabel', xLabelName, ...
      'XVariable', xVariableName, ...
      'XData', options.XData, ...
      'YData', options.YData, ...
      'XLimits', options.XLimits, ...
      'SourceTable', sourceTable, ...
      'Title', options.Title, ...
      'LegendLabels', options.LegendLabels, ...
      'LegendVisible', options.LegendVisible, ...
      'LegendOrientation', options.LegendOrientation);
    applyStackedplotChartProperties(s, options);
    if strcmp(options.GridVisible, 'on')
      s.GridVisible = 'on';
    end
    set(s, ...
      'LineProperties', optionOrDefault(options.LineProperties, lineProperties), ...
      'AxesProperties', optionOrDefault(options.AxesProperties, axesProperties));
    if strcmp(options.LegendVisible, 'on') || ~isempty(options.AxesProperties)
      applyInitialAxesProperties(s);
    end
    removeStackedplotAxesFromFigure(fig, axesHandles);
    endStackedplotDrawLater(fig, previousDrawLater);
  catch exception
    endStackedplotDrawLater(fig, previousDrawLater);
    error(exception.message);
  end
end
%=============================================================================
function removeStackedplotAxesFromFigure(fig, axesHandles)
  if isempty(fig) || ~isgraphics(fig, 'figure')
    return
  end
  children = get(fig, 'Children');
  keptChildren = [];
  for k = 1:numel(children)
    keepChild = true;
    for j = 1:numel(axesHandles)
      if isequal(children(k), axesHandles(j))
        keepChild = false;
        break
      end
    end
    if keepChild
      keptChildren = [keptChildren children(k)];
    end
  end
  set(fig, 'Children', keptChildren);
end
%=============================================================================
function [parent, inputArguments] = extractStackedplotParent(inputArguments)
  parent = [];
  if ~isempty(inputArguments) && isscalar(inputArguments{1}) && isgraphics(inputArguments{1}, 'figure')
    parent = inputArguments{1};
    inputArguments(1) = [];
  end
  if isempty(inputArguments)
    error('Nelson:stackedplot:tableTimetableOrExpected', 'table, timetable, or plottable array expected.');
  end
end
%=============================================================================
function s = createStackedLineChart(parent)
  s = __stackedplot__('AutoParent', 'off');
  if ~isempty(parent)
    s.Parent = parent;
  end
end
%=============================================================================
function [fig, previousDrawLater] = beginStackedplotDrawLater(parent)
  if isempty(parent)
    fig = gcf();
  else
    fig = parent;
  end
  previousDrawLater = fig.DrawLater;
  if strcmp(previousDrawLater, 'off')
    fig.DrawLater = 'on';
  end
end
%=============================================================================
function endStackedplotDrawLater(fig, previousDrawLater)
  if strcmp(previousDrawLater, 'off')
    fig.DrawLater = 'off';
  end
end
%=============================================================================
function [xValues, names, values, legendLabels, xLabelName, xVariableName, ...
    displayVariables, sourceTable, options] = stackedplotArguments(inputArguments)
  options = stackedplotDefaultOptions();
  xVariableName = '';
  displaySelector = [];
  sourceTable = [];

  if isTableInput(inputArguments{1})
    [tables, firstNameValue, sourceTable] = collectTableInputs(inputArguments);
    variableNames = combinedVariableNames(tables);
    if length(inputArguments) >= firstNameValue && ~isNameValueStart(inputArguments, firstNameValue)
      arg = inputArguments{firstNameValue};
      if isVariableSelector(arg, variableNames)
        displaySelector = arg;
        firstNameValue = firstNameValue + 1;
      elseif isLineSpecArgument(arg)
        options = applyLineSpec(options, arg);
        firstNameValue = firstNameValue + 1;
      else
        displaySelector = arg;
        firstNameValue = firstNameValue + 1;
      end
    end
    if length(inputArguments) >= firstNameValue && isLineSpecArgument(inputArguments{firstNameValue})
      options = applyLineSpec(options, inputArguments{firstNameValue});
      firstNameValue = firstNameValue + 1;
    end
    options = parseStackedplotOptions(inputArguments, firstNameValue, options);
    if ~isempty(options.DisplayVariables)
      displaySelector = options.DisplayVariables;
    end
    options.EventData = stackedplotEventData(tables);
    xVariableName = options.XVariable;
    [xValues, names, values, legendLabels, xLabelName, displayVariables] = ...
      tablesStackedplotData(tables, displaySelector, xVariableName, options.CombineMatchingNames);
  elseif isStackedPlotValue(inputArguments{1})
    firstNameValue = 2;
    y = inputArguments{1};
    x = [];
    if length(inputArguments) >= 2 && isStackedPlotValue(inputArguments{2})
      x = inputArguments{1};
      y = inputArguments{2};
      firstNameValue = 3;
    end
    if length(inputArguments) >= firstNameValue && isLineSpecArgument(inputArguments{firstNameValue})
      options = applyLineSpec(options, inputArguments{firstNameValue});
      firstNameValue = firstNameValue + 1;
    end
    options = parseStackedplotOptions(inputArguments, firstNameValue, options);
    [xValues, names, values, legendLabels, xLabelName, displayVariables] = ...
      matrixStackedplotData(x, y);
    if isempty(x)
      options.XData = (1:size(stackedplotValueToNumeric(y), 1))';
    else
      options.XData = stackedplotValueToNumeric(x);
    end
    options.YData = stackedplotValueToNumeric(y);
  else
    error('Nelson:stackedplot:tableTimetableOrExpected', 'table, timetable, or plottable array expected.');
  end
end
%=============================================================================
function tf = isTableInput(value)
  tf = istable(value) || istimetable(value) || isCellArrayOfTables(value);
end
%=============================================================================
function tf = isCellArrayOfTables(value)
  tf = false;
  if ~iscell(value) || isempty(value)
    return
  end
  for k = 1:numel(value)
    if ~(istable(value{k}) || istimetable(value{k}))
      return
    end
  end
  tf = true;
end
%=============================================================================
function [tables, nextIndex, sourceTable] = collectTableInputs(inputArguments)
  if isCellArrayOfTables(inputArguments{1})
    tables = inputArguments{1}(:)';
    nextIndex = 2;
    sourceTable = inputArguments{1};
  else
    tables = {};
    nextIndex = 1;
    while nextIndex <= length(inputArguments) && ...
        (istable(inputArguments{nextIndex}) || istimetable(inputArguments{nextIndex}))
      tables{end + 1} = inputArguments{nextIndex};
      nextIndex = nextIndex + 1;
    end
    sourceTable = tables{1};
    if length(tables) > 1
      sourceTable = tables;
    end
  end
  validateTableInputTypes(tables);
end
%=============================================================================
function validateTableInputTypes(tables)
  firstIsTimetable = istimetable(tables{1});
  for k = 2:length(tables)
    if istimetable(tables{k}) ~= firstIsTimetable
      error('Nelson:stackedplot:invalidInputs', 'Inputs must be all tables or all timetables.');
    end
  end
end
%=============================================================================
function variableNames = combinedVariableNames(tables)
  variableNames = {};
  for k = 1:length(tables)
    names = tables{k}.Properties.VariableNames;
    for n = 1:length(names)
      if ~any(strcmp(variableNames, names{n}))
        variableNames{end + 1} = names{n};
      end
    end
  end
end
%=============================================================================
function tf = isVariableSelector(value, variableNames)
  tf = isnumeric(value) || islogical(value) || iscellstr(value);
  if tf
    return
  end
  if ischar(value)
    tf = any(strcmp(value, variableNames));
  end
end
%=============================================================================
function [xValues, names, values, legendLabels, xLabelName, displayVariables] = ...
    tablesStackedplotData(tables, displaySelector, xVariableName, combineMatchingNames)
  variableNames = combinedVariableNames(tables);
  explicitSelector = ~isempty(displaySelector);
  validateXVariableForTables(tables, xVariableName);
  xLabelName = defaultTableXLabel(tables{1}, xVariableName);
  displayVariables = {};
  names = {};
  values = {};
  xValues = {};
  legendLabels = {};

  if isGroupedVariableSelector(displaySelector)
    [xValues, names, values, legendLabels, displayVariables] = ...
      groupedTableSeries(tables, displaySelector, xVariableName);
  else
    candidateNames = resolveVariableSelector(displaySelector, variableNames);
    if ~combineMatchingNames
      [xValues, names, values, legendLabels, displayVariables] = ...
        separateTableSeries(tables, candidateNames, xVariableName, explicitSelector);
    else
      [xValues, names, values, legendLabels, displayVariables] = ...
        combinedTableSeries(tables, candidateNames, xVariableName, explicitSelector);
    end
  end
end
%=============================================================================
function tf = isGroupedVariableSelector(selector)
  tf = iscell(selector) && ~iscellstr(selector);
end
%=============================================================================
function [xValues, names, values, legendLabels, displayVariables] = ...
    groupedTableSeries(tables, displaySelector, xVariableName)
  if length(tables) ~= 1
    error('Nelson:stackedplot:groupedVariableSelectorsAre', 'Grouped variable selectors are supported only for one table input.');
  end
  tbl = tables{1};
  variableNames = tbl.Properties.VariableNames;
  xValues = {};
  names = {};
  values = {};
  legendLabels = {};
  displayVariables = {};
  tableXVariableName = xVariableForTable(xVariableName, 1, 1);
  for k = 1:length(displaySelector)
    groupNames = resolveVariableSelector(displaySelector{k}, variableNames);
    panelX = {};
    panelY = {};
    panelLegend = {};
    for j = 1:length(groupNames)
      name = groupNames{j};
      if shouldSkipVariable(tbl, name, tableXVariableName, true)
        continue
      end
      validateVariableName(name, variableNames);
      value = tbl.(name);
      if isStackedPlotValue(value)
        x = tableXData(tbl, tableXVariableName);
        [panelX, panelY, panelLegend] = appendValueSeries(panelX, panelY, panelLegend, ...
          x, value, name);
      end
    end
    if ~isempty(panelY)
      names{end + 1} = groupedDisplayName(groupNames);
      values{end + 1} = panelY;
      xValues{end + 1} = panelX;
      legendLabels{end + 1} = panelLegend;
      displayVariables{end + 1} = groupNames;
    end
  end
end
%=============================================================================
function label = groupedDisplayName(names)
  if length(names) == 1
    label = names{1};
  else
    label = names{1};
    for k = 2:length(names)
      label = [label, ', ', names{k}];
    end
  end
end
%=============================================================================
function [xValues, names, values, legendLabels, displayVariables] = ...
    combinedTableSeries(tables, candidateNames, xVariableName, explicitSelector)
  xValues = {};
  names = {};
  values = {};
  legendLabels = {};
  displayVariables = {};
  for k = 1:length(candidateNames)
    name = candidateNames{k};
    panelX = {};
    panelY = {};
    panelLegend = {};
    for t = 1:length(tables)
      tbl = tables{t};
      tableXVariableName = xVariableForTable(xVariableName, t, length(tables));
      if shouldSkipVariable(tbl, name, tableXVariableName, explicitSelector)
        continue
      end
      validateVariableName(name, tbl.Properties.VariableNames);
      value = tbl.(name);
      if isStackedPlotValue(value)
        x = tableXData(tbl, tableXVariableName);
        [panelX, panelY, panelLegend] = appendValueSeries(panelX, panelY, panelLegend, ...
          x, value, sourceLegendLabel(t, length(tables), name));
      end
    end
    if ~isempty(panelY)
      names{end + 1} = name;
      values{end + 1} = panelY;
      xValues{end + 1} = panelX;
      legendLabels{end + 1} = panelLegend;
      displayVariables{end + 1} = name;
    end
  end
end
%=============================================================================
function [xValues, names, values, legendLabels, displayVariables] = ...
    separateTableSeries(tables, candidateNames, xVariableName, explicitSelector)
  xValues = {};
  names = {};
  values = {};
  legendLabels = {};
  displayVariables = {};
  for t = 1:length(tables)
    tbl = tables{t};
    tableXVariableName = xVariableForTable(xVariableName, t, length(tables));
    for k = 1:length(candidateNames)
      name = candidateNames{k};
      if shouldSkipVariable(tbl, name, tableXVariableName, explicitSelector)
        continue
      end
      validateVariableName(name, tbl.Properties.VariableNames);
      value = tbl.(name);
      if isStackedPlotValue(value)
        x = tableXData(tbl, tableXVariableName);
        [panelX, panelY, panelLegend] = appendValueSeries({}, {}, {}, x, value, name);
        names{end + 1} = separatedDisplayName(name, t, length(tables));
        values{end + 1} = panelY;
        xValues{end + 1} = panelX;
        legendLabels{end + 1} = panelLegend;
        if ~any(strcmp(displayVariables, name))
          displayVariables{end + 1} = name;
        end
      end
    end
  end
end
%=============================================================================
function tf = shouldSkipVariable(tbl, name, xVariableName, explicitSelector)
  tf = ~any(strcmp(name, tbl.Properties.VariableNames));
  if tf
    return
  end
  tf = ~explicitSelector && ~isempty(xVariableName) && strcmp(name, xVariableName);
end
%=============================================================================
function x = tableXData(tbl, xVariableName)
  if ~isempty(xVariableName)
    validateVariableName(xVariableName, tbl.Properties.VariableNames);
    x = stackedplotValueToNumeric(tbl.(xVariableName));
  elseif istimetable(tbl)
    x = rowTimesToNumeric(tbl.Properties.RowTimes);
  else
    x = (1:height(tbl))';
  end
  x = x(:);
end
%=============================================================================
function xLabelName = defaultTableXLabel(tbl, xVariableName)
  if ~isempty(xVariableName)
    if iscellstr(xVariableName)
      xVariableName = xVariableName{1};
    end
    validateVariableName(xVariableName, tbl.Properties.VariableNames);
    xLabelName = xVariableName;
  elseif istimetable(tbl)
    xLabelName = timetableRowTimeName(tbl);
  else
    xLabelName = 'Row';
  end
end
%=============================================================================
function validateXVariableForTables(tables, xVariableName)
  if isempty(xVariableName)
    return
  end
  if istimetable(tables{1})
    error('Nelson:stackedplot:xVariableIsSupportedOnly', 'XVariable is supported only for table inputs.');
  end
  if iscellstr(xVariableName) && length(xVariableName) > 1 && length(xVariableName) ~= length(tables)
    error('Nelson:stackedplot:invalidXVariable', 'XVariable must contain one name or one name per table.');
  end
end
%=============================================================================
function name = xVariableForTable(xVariableName, index, tableCount)
  name = xVariableName;
  if iscellstr(xVariableName)
    if length(xVariableName) == tableCount
      name = xVariableName{index};
    else
      name = xVariableName{1};
    end
  end
end
%=============================================================================
function [panelX, panelY, panelLegend] = appendValueSeries(panelX, panelY, panelLegend, ...
    x, value, baseLabel)
  y = stackedplotValueToNumeric(value);
  if isvector(y)
    y = y(:);
  end
  if size(y, 1) ~= length(x)
    error('Nelson:stackedplot:invalidXAndY', 'X and Y data must have compatible lengths.');
  end
  for c = 1:size(y, 2)
    panelX{end + 1} = x;
    panelY{end + 1} = y(:, c);
    if size(y, 2) == 1
      panelLegend{end + 1} = baseLabel;
    else
      panelLegend{end + 1} = [baseLabel, ' Column ', int2str(c)];
    end
  end
end
%=============================================================================
function label = sourceLegendLabel(index, count, name)
  if count <= 1
    label = name;
  else
    label = ['Input ', int2str(index)];
  end
end
%=============================================================================
function name = separatedDisplayName(name, index, count)
  if count > 1
    name = [name, ' (', int2str(index), ')'];
  end
end
%=============================================================================
function [xValues, names, values, legendLabels, xLabelName, displayVariables] = ...
    matrixStackedplotData(x, y)
  y = stackedplotValueToNumeric(y);
  if isempty(x)
    x = (1:size(y, 1))';
    xLabelName = '';
  else
    x = stackedplotValueToNumeric(x);
    xLabelName = '';
  end
  x = x(:);
  if isvector(y)
    y = y(:);
  end

  xValues = {};
  names = {};
  values = {};
  legendLabels = {};
  for k = 1:size(y, 2)
    name = ['Column ', int2str(k)];
    names{end + 1} = name;
    values{end + 1} = {y(:, k)};
    xValues{end + 1} = {x};
    legendLabels{end + 1} = {name};
  end
  displayVariables = {};
end
%=============================================================================
function [axesHandles, lineProperties, axesProperties] = ...
    renderStackedplotAxes(xValues, names, values, legendLabels, xLabelName, options)
  axesHandles = [];
  lineProperties = [];
  axesProperties = [];
  labelHandles = [];
  axesPositions = stackedplotAxesPositions(length(values));
  if useStackedplotRenderBuiltin(options)
    [axesHandles, labelHandles, lineHandlesByPanel] = __stackedplot_render__(...
      options.Parent, axesPositions, xValues, values, names, xLabelName, options.Title);
    for k = 1:length(values)
      applyLineOptions(lineHandlesByPanel{k}, options.LineOptionNames, options.LineOptionValues);
      applyStackedplotPanelYLimits(axesHandles(k), values{k});
      defaultColors = stackedplotPanelColors(axesHandles(k), length(values{k}), options);
      lineProperties = appendObjectProperty(lineProperties, ...
        stackedplotLineProperties(options, defaultColors));
      axesProperties = appendObjectProperty(axesProperties, stackedplotAxesProperties(legendLabels{k}));
    end
    applyStackedplotAxesFonts(axesHandles, options);
    applyStackedplotXAxisVisibility(axesHandles);
    adjustStackedplotLayout(axesHandles, labelHandles, names, values, options);
    return
  end
  for k = 1:length(values)
    ax = createStackedplotAxes(options.Parent, axesPositions(k, :));
    lineHandles = [];
    defaultColors = stackedplotPanelColors(ax, length(values{k}), options);
    for j = 1:length(values{k})
      lineHandles = [lineHandles; line('Parent', ax, 'XData', xValues{k}{j}, ...
        'YData', values{k}{j}, 'Color', defaultColors(j, :))];
    end
    applyLineOptions(lineHandles, options.LineOptionNames, options.LineOptionValues);
    applyStackedplotPanelYLimits(ax, values{k});
    renderStackedplotEvents(ax, options.EventData, options.EventsVisible);
    set(ax, 'Box', 'off');
    labelHandles = [labelHandles; stackedplotLabel(ax, names{k})];
    if k ~= length(values)
      set(ax, 'XTick', []);
      set(ax, 'XTickLabel', {});
    else
      xlabel(ax, xLabelName);
    end
    if k == 1
      title(ax, options.Title);
    end
    axesHandles = [axesHandles; ax];
    lineProperties = appendObjectProperty(lineProperties, ...
      stackedplotLineProperties(options, defaultColors));
    axesProperties = appendObjectProperty(axesProperties, stackedplotAxesProperties(legendLabels{k}));
  end
  applyStackedplotAxesFonts(axesHandles, options);
  applyStackedplotXAxisVisibility(axesHandles);
  adjustStackedplotLayout(axesHandles, labelHandles, names, values, options);
end
%=============================================================================
function applyStackedplotXAxisVisibility(axesHandles)
  % Only the bottom panel shows the shared x-axis (ruler line, ticks and
  % labels). Upper panels hide their x-axis so no baseline is drawn between
  % panels, but they keep the same x-ticks so the vertical grid still spans
  % every panel.
  n = length(axesHandles);
  if n == 0
    return
  end
  sharedXTick = get(axesHandles(n), 'XTick');
  for k = 1:n
    ax = axesHandles(k);
    if ~isempty(sharedXTick)
      set(ax, 'XTick', sharedXTick);
    end
    if k < n
      set(ax, 'XTickLabel', {});
      xAxisRuler = get(ax, 'XAxis');
      if ~isempty(xAxisRuler)
        set(xAxisRuler, 'Visible', 'off');
      end
    end
  end
end
%=============================================================================
function applyStackedplotAxesFonts(axesHandles, options)
  % stackedplot uses a compact default font. Tick labels follow the axes
  % font, while the x-label and title use the usual 1.1 label multiplier.
  fontSize = stackedplotInitialFontSize(options);
  labelFontSize = fontSize * 1.1;
  for k = 1:length(axesHandles)
    ax = axesHandles(k);
    set(ax, 'FontSize', fontSize);
    xLabelHandle = get(ax, 'XLabel');
    if ~isempty(xLabelHandle) && isgraphics(xLabelHandle)
      set(xLabelHandle, 'FontSize', labelFontSize);
    end
    titleHandle = get(ax, 'Title');
    if ~isempty(titleHandle) && isgraphics(titleHandle)
      set(titleHandle, 'FontSize', labelFontSize);
    end
  end
end
%=============================================================================
function tf = useStackedplotRenderBuiltin(options)
  tf = isempty(options.EventData) || strcmp(options.EventsVisible, 'off');
end
%=============================================================================
function ax = createStackedplotAxes(parent, position)
  if isempty(parent)
    ax = axes('Position', position);
  else
    ax = axes(parent, 'Position', position);
  end
end
%=============================================================================
function applyStackedplotPanelYLimits(ax, panelValues)
  % Fit each panel's Y-axis tightly to its data range so that the tick
  % density matches the values shown, instead of rounding the limits
  % outward (which produces coarser ticks). An explicit YLimits supplied
  % through AxesProperties still overrides this default afterwards.
  numericValues = [];
  for k = 1:length(panelValues)
    value = panelValues{k};
    if isnumeric(value) || islogical(value)
      numericValues = [numericValues; double(value(:))];
    end
  end
  numericValues = numericValues(isfinite(numericValues));
  if isempty(numericValues)
    return
  end
  lowerLimit = min(numericValues);
  upperLimit = max(numericValues);
  if upperLimit > lowerLimit
    ax.YLim = [lowerLimit, upperLimit];
  end
end
%=============================================================================
function options = stackedplotDefaultOptions()
  options = struct();
  options.Parent = [];
  options.DisplayVariables = [];
  options.DisplayLabels = [];
  options.XVariable = '';
  options.XLabel = [];
  options.XData = [];
  options.YData = [];
  options.XLimits = [];
  options.CombineMatchingNames = true;
  options.EventsVisible = 'on';
  options.GridVisible = 'off';
  options.Title = '';
  options.LegendLabels = [];
  options.LegendVisible = 'off';
  options.LegendOrientation = 'vertical';
  options.LineProperties = [];
  options.AxesProperties = [];
  options.LineOptionNames = {};
  options.LineOptionValues = {};
  options.ChartPropertyNames = {};
  options.ChartPropertyValues = {};
  options.EventData = [];
end
%=============================================================================
function options = parseStackedplotOptions(inputArguments, firstNameValue, options)
  k = firstNameValue;
  while k <= length(inputArguments)
    if k == length(inputArguments) || ~ischar(inputArguments{k})
      error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
    end
    name = normalizedName(inputArguments{k});
    value = inputArguments{k + 1};
    switch name
      case 'displayvariables'
        options.DisplayVariables = value;
      case 'displaylabels'
        options.DisplayLabels = value;
      case 'xvariable'
        options.XVariable = xVariableSelector(value);
      case 'xlabel'
        options.XLabel = scalarName(value);
      case 'xlimits'
        options.XLimits = stackedplotValueToNumeric(value);
      case 'combinematchingnames'
        options.CombineMatchingNames = logicalScalar(value);
      case 'eventsvisible'
        options.EventsVisible = onOffValue(value);
      case 'gridvisible'
        options.GridVisible = onOffValue(value);
      case 'title'
        options.Title = scalarName(value);
      case 'legendlabels'
        options.LegendLabels = value;
      case 'legendvisible'
        options.LegendVisible = onOffValue(value);
      case 'legendorientation'
        options.LegendOrientation = scalarName(value);
      case 'lineproperties'
        options.LineProperties = value;
      case 'axesproperties'
        options.AxesProperties = value;
      case {'color', 'linestyle', 'linewidth', 'marker', 'markersize', ...
          'markeredgecolor', 'markerfacecolor'}
        options.LineOptionNames{end + 1} = inputArguments{k};
        options.LineOptionValues{end + 1} = value;
        options = addChartProperty(options, inputArguments{k}, value);
      case {'fontname', 'fontsize'}
        options = addChartProperty(options, inputArguments{k}, value);
      otherwise
        error('Nelson:graphics:unsupportedProperty', 'Unsupported "%s" option.', 'stackedplot');
    end
    k = k + 2;
  end
end
%=============================================================================
function tf = isNameValueStart(inputArguments, index)
  tf = false;
  if index > length(inputArguments) || ~ischar(inputArguments{index})
    return
  end
  names = {'displayvariables', 'displaylabels', 'xvariable', 'xlabel', ...
    'xlimits', 'combinematchingnames', 'eventsvisible', 'gridvisible', 'title', ...
    'legendlabels', 'legendvisible', 'legendorientation', 'lineproperties', ...
    'axesproperties', 'color', 'linestyle', 'linewidth', 'marker', 'markersize', ...
    'markeredgecolor', 'markerfacecolor', 'fontname', 'fontsize'};
  tf = any(strcmp(normalizedName(inputArguments{index}), names));
end
%=============================================================================
function names = resolveVariableSelector(selector, variableNames)
  if isempty(selector)
    names = variableNames;
  elseif ischar(selector)
    names = {selector};
  elseif iscellstr(selector)
    names = selector;
  elseif isnumeric(selector)
    names = variableNames(selector);
  elseif islogical(selector)
    names = variableNames(selector);
  else
    error('Nelson:stackedplot:invalidVariableSelector', 'Invalid variable selector.');
  end
  names = names(:)';
end
%=============================================================================
function labels = normalizeLabels(labels, n)
  if ischar(labels)
    labels = {labels};
  elseif ~iscellstr(labels)
    error('Nelson:stackedplot:invalidDisplayLabels', 'Invalid display labels.');
  end
  labels = labels(:)';
  if length(labels) ~= n
    error('Nelson:stackedplot:invalidDisplayLabelsLength', 'Display labels length must match the number of plots.');
  end
end
%=============================================================================
function validateVariableName(name, variableNames)
  if ~any(strcmp(name, variableNames))
    error('Nelson:stackedplot:invalidVariableName', 'Invalid variable name.');
  end
end
%=============================================================================
function names = removeVariableName(names, name)
  names = names(~strcmp(names, name));
end
%=============================================================================
function value = stackedplotValueToNumeric(value)
  if isa(value, 'datetime')
    value = datenum(value);
  elseif isa(value, 'duration')
    value = seconds(value);
  else
    value = double(value);
  end
end
%=============================================================================
function tf = isStackedPlotValue(value)
  tf = (isnumeric(value) || islogical(value) || isa(value, 'datetime') || isa(value, 'duration')) ...
    && ismatrix(value) && ~isempty(value);
end
%=============================================================================
function tf = isLineSpecArgument(value)
  tf = false;
  if ~(ischar(value) || isStringScalar(value))
    return
  end
  [~, ~, ~, msg] = colstyle(value, 'plot', false);
  tf = isempty(msg);
end
%=============================================================================
function x = rowTimesToNumeric(rowTimes)
  if isa(rowTimes, 'datetime')
    x = datenum(rowTimes);
  elseif isa(rowTimes, 'duration')
    x = seconds(rowTimes);
  else
    x = rowTimes;
  end
  x = x(:);
end
%=============================================================================
function eventData = stackedplotEventData(tables)
  eventData = [];
  for k = 1:length(tables)
    tbl = tables{k};
    if ~istimetable(tbl) || ~isfield(tbl.Properties, 'Events')
      continue
    end
    events = tbl.Properties.Events;
    if ~istable(events) || height(events) == 0
      continue
    end
    current = eventTableData(events);
    if isempty(current)
      continue
    end
    if isempty(eventData)
      eventData = current;
    else
      eventData.X = [eventData.X; current.X];
      eventData.Width = [eventData.Width; current.Width];
      eventData.Labels = [eventData.Labels; current.Labels];
    end
  end
end
%=============================================================================
function eventData = eventTableData(events)
  eventData = [];
  eventNames = events.Properties.VariableNames;
  timeName = eventTableMetadata(events, 'EventTimeVariable', 'Time');
  if ~any(strcmp(timeName, eventNames))
    if isempty(eventNames)
      return
    end
    timeName = eventNames{1};
  end
  eventTimes = events.(timeName);
  if ~(isa(eventTimes, 'datetime') || isa(eventTimes, 'duration'))
    return
  end
  labelName = eventTableMetadata(events, 'EventLabelsVariable', '');
  if isempty(labelName) || ~any(strcmp(labelName, eventNames))
    labelName = inferredEventLabelName(events, timeName);
  end
  lengthName = eventTableMetadata(events, 'EventLengthsVariable', '');
  if isempty(lengthName) || ~any(strcmp(lengthName, eventNames))
    lengthName = '';
  end
  endName = eventTableMetadata(events, 'EventEndsVariable', '');
  if isempty(endName) || ~any(strcmp(endName, eventNames))
    endName = '';
  end
  eventData = struct();
  eventData.X = rowTimesToNumeric(eventTimes);
  eventData.Width = eventWidthsToNumeric(events, lengthName, endName, eventTimes);
  eventData.Labels = eventLabels(events, labelName, length(eventData.X));
  keep = isfinite(eventData.X) & isfinite(eventData.Width);
  eventData.X = eventData.X(keep);
  eventData.Width = eventData.Width(keep);
  eventData.Labels = eventData.Labels(keep);
  if isempty(eventData.X)
    eventData = [];
  end
end
%=============================================================================
function value = eventTableMetadata(events, name, defaultValue)
  value = defaultValue;
  props = events.Properties;
  if isfield(props, 'CustomProperties') && isfield(props.CustomProperties, name)
    value = props.CustomProperties.(name);
  end
end
%=============================================================================
function name = inferredEventLabelName(events, timeName)
  name = '';
  eventNames = events.Properties.VariableNames;
  for k = 1:length(eventNames)
    if strcmp(eventNames{k}, timeName)
      continue
    end
    value = events.(eventNames{k});
    if iscellstr(value) || isa(value, 'string') || ischar(value)
      name = eventNames{k};
      return
    end
  end
end
%=============================================================================
function labels = eventLabels(events, labelName, count)
  labels = repmat({''}, count, 1);
  if isempty(labelName)
    return
  end
  value = events.(labelName);
  if isstring(value)
    labels = cellstr(value(:));
  elseif iscellstr(value)
    labels = value(:);
  elseif ischar(value)
    labels = cellstr(value);
    labels = labels(:);
  else
    labels = cellstr(string(value(:)));
  end
  if length(labels) ~= count
    labels = repmat({''}, count, 1);
  end
end
%=============================================================================
function widths = eventWidthsToNumeric(events, lengthName, endName, eventTimes)
  widths = zeros(length(rowTimesToNumeric(eventTimes)), 1);
  if ~isempty(endName)
    ends = events.(endName);
    widths = rowTimesToNumeric(ends) - rowTimesToNumeric(eventTimes);
    widths = max(widths(:), 0);
    return
  end
  if isempty(lengthName)
    return
  end
  lengths = events.(lengthName);
  if isa(lengths, 'duration')
    widths = seconds(lengths(:));
    if isa(eventTimes, 'datetime')
      widths = widths ./ 86400;
    end
  else
    widths = double(lengths(:));
  end
  widths = max(widths, 0);
end
%=============================================================================
function renderStackedplotEvents(ax, eventData, eventsVisible)
  if isempty(eventData) || strcmp(eventsVisible, 'off')
    return
  end
  yLimits = ax.YLim;
  if isempty(yLimits) || length(yLimits) ~= 2 || yLimits(1) == yLimits(2)
    yLimits = [0 1];
  end
  colorOrder = ax.ColorOrder;
  if isempty(colorOrder)
    colorOrder = [0.8 0.8 0.8];
  end
  thinWidth = stackedplotEventThinWidth(ax, eventData.X);
  labels = unique(eventData.Labels, 'stable');
  for k = 1:length(eventData.X)
    x1 = eventData.X(k);
    x2 = x1 + eventData.Width(k);
    if x2 == x1
      x1 = x1 - thinWidth / 2;
      x2 = x2 + thinWidth / 2;
    end
    color = stackedplotEventColor(eventData.Labels{k}, labels, colorOrder);
    patch(ax, [x1 x2 x2 x1], [yLimits(1) yLimits(1) yLimits(2) yLimits(2)], color, ...
      'EdgeColor', 'none', ...
      'FaceAlpha', 0.18, ...
      'Tag', 'StackedplotEvent');
  end
  ax.YLim = yLimits;
end
%=============================================================================
function width = stackedplotEventThinWidth(ax, x)
  xLimits = ax.XLim;
  if isempty(xLimits) || length(xLimits) ~= 2 || xLimits(1) == xLimits(2)
    xLimits = [min(x), max(x)];
  end
  span = abs(xLimits(2) - xLimits(1));
  if span == 0 || ~isfinite(span)
    span = 1;
  end
  width = span * 0.003;
end
%=============================================================================
function color = stackedplotEventColor(label, labels, colorOrder)
  index = find(strcmp(labels, label), 1);
  if isempty(index)
    index = 1;
  end
  color = colorOrder(mod(index - 1, size(colorOrder, 1)) + 1, :);
end
%=============================================================================
function positions = stackedplotAxesPositions(n)
  % Generic stacked-panel layout. The panel column is anchored at a fixed
  % left margin and width (the display labels live in the left margin, they
  % do not shift the panels). Panels share a common column between a fixed
  % bottom and top edge; the vertical gap between two panels is a constant
  % fraction of the panel pitch, so the layout stays proportional for any
  % number of panels.
  left = 0.13;
  width = 0.775;
  bottom = 0.11;
  topEdge = 0.925;
  gapFraction = 0.1;
  totalHeight = topEdge - bottom;
  pitch = totalHeight / (n - gapFraction);
  height = pitch * (1 - gapFraction);
  gap = pitch - height;
  positions = zeros(n, 4);
  for k = 1:n
    y = topEdge - k * height - (k - 1) * gap;
    positions(k, :) = [left, y, width, height];
  end
end
%=============================================================================
function name = timetableRowTimeName(tbl)
  name = 'Time';
  if isfield(tbl.Properties, 'DimensionNames') && ~isempty(tbl.Properties.DimensionNames)
    name = tbl.Properties.DimensionNames{1};
  end
end
%=============================================================================
function h = stackedplotLabel(ax, label)
  h = text(ax, -0.035, 0.5, label, ...
    'Units', 'normalized', ...
    'HorizontalAlignment', 'right', ...
    'VerticalAlignment', 'middle', ...
    'Rotation', 0);
end
%=============================================================================
function adjustStackedplotLayout(axesHandles, labelHandles, names, values, options)
  if isempty(axesHandles) || isempty(labelHandles)
    return
  end
  % The panel column keeps a fixed right margin. Its left edge stays at the
  % base margin when the display labels and y-tick labels fit inside it, and
  % only shifts right (shrinking the panels) when the labels are too wide to
  % fit. The display labels sit in the left margin, right aligned just left
  % of the y-tick labels and vertically centred. Text widths are measured
  % with the real font metrics so the layout is independent of the actual
  % label strings.
  parent = axesHandles(1).Parent;
  parentPosition = parent.Position;
  figureWidth = stackedplotTextReferenceWidth(parentPosition);
  fontSize = stackedplotInitialFontSize(options);
  labelFontSize = fontSize * 1.1;
  baseLeft = 0.13;
  right = 0.095;
  outerLeftPixels = 6;
  labelTickGapPixels = 4;
  tickAxisGapPixels = 4;
  minimumAxesWidth = 0.2;
  labelWidthPixels = maxStackedplotMeasuredWidth(axesHandles(1), names, labelFontSize);
  tickWidthPixels = maxStackedplotMeasuredTickWidth(axesHandles(1), values, fontSize);
  leftPixels = outerLeftPixels + labelWidthPixels + labelTickGapPixels + ...
    tickWidthPixels + tickAxisGapPixels;
  left = leftPixels / figureWidth;
  left = min(max(left, baseLeft), 1 - right - minimumAxesWidth);
  width = max(1 - left - right, minimumAxesWidth);
  axesWidthPixels = max(width * figureWidth, 1);
  labelX = -(tickWidthPixels + labelTickGapPixels) / axesWidthPixels;
  for k = 1:length(axesHandles)
    position = axesHandles(k).Position;
    position(1) = left;
    position(3) = width;
    axesHandles(k).Position = position;
  end
  for k = 1:length(labelHandles)
    set(labelHandles(k), 'FontSize', labelFontSize);
    labelPosition = labelHandles(k).Position;
    labelPosition(1) = labelX;
    labelHandles(k).Position = labelPosition;
  end
end
%=============================================================================
function width = maxStackedplotMeasuredWidth(ax, labels, fontSize)
  width = 0;
  if ischar(labels)
    labels = {labels};
  end
  for k = 1:numel(labels)
    label = labels{k};
    if ~ischar(label)
      label = char(string(label));
    end
    width = max(width, stackedplotMeasuredTextWidth(ax, label, fontSize));
  end
end
%=============================================================================
function width = maxStackedplotMeasuredTickWidth(ax, values, fontSize)
  width = 0;
  for k = 1:length(values)
    labels = stackedplotEstimatedTickLabels(values{k});
    for j = 1:length(labels)
      width = max(width, stackedplotMeasuredTextWidth(ax, labels{j}, fontSize));
    end
  end
end
%=============================================================================
function width = stackedplotMeasuredTextWidth(ax, label, fontSize)
  % Measure the pixel width of a string using the real font metrics, then
  % remove the probe so it never affects the axes.
  probe = text(ax, 0, 0, label, ...
    'Units', 'pixels', ...
    'FontSize', fontSize, ...
    'Visible', 'off');
  extent = get(probe, 'Extent');
  delete(probe);
  width = extent(3);
end
%=============================================================================
function width = stackedplotTextReferenceWidth(parentPosition)
  width = max(parentPosition(3), 1);
  try
    screenSize = get(0, 'ScreenSize');
    if width <= 1.5 && length(screenSize) >= 3
      width = max(width * screenSize(3), 1);
    end
  catch
  end
end
%=============================================================================
function fontSize = stackedplotInitialFontSize(options)
  fontSize = stackedplotOptionValue(options.ChartPropertyNames, options.ChartPropertyValues, ...
    'FontSize', 8);
end
%=============================================================================
function labels = stackedplotEstimatedTickLabels(values)
  numericValues = [];
  for k = 1:length(values)
    value = values{k};
    if isnumeric(value) || islogical(value)
      numericValues = [numericValues; double(value(:))];
    end
  end
  numericValues = numericValues(isfinite(numericValues));
  if isempty(numericValues)
    labels = {'0'};
    return
  end
  minimumValue = min(numericValues);
  maximumValue = max(numericValues);
  labels = {num2str(minimumValue, 4), num2str(maximumValue, 4)};
  if minimumValue <= 0 && maximumValue >= 0
    labels{end + 1} = '0';
  end
end
%=============================================================================
function applyLineOptions(lineHandles, names, values)
  for k = 1:length(names)
    set(lineHandles, names{k}, values{k});
  end
end
%=============================================================================
function properties = stackedplotLineProperties(options, defaultColors)
  color = stackedplotOptionValue(options.LineOptionNames, options.LineOptionValues, ...
    'Color', defaultColors);
  markerFaceColor = stackedplotOptionValue(options.LineOptionNames, options.LineOptionValues, ...
    'MarkerFaceColor', 'none');
  markerEdgeColor = stackedplotOptionValue(options.LineOptionNames, options.LineOptionValues, ...
    'MarkerEdgeColor', color);
  lineStyle = stackedplotOptionValue(options.LineOptionNames, options.LineOptionValues, ...
    'LineStyle', '-');
  lineWidth = stackedplotOptionValue(options.LineOptionNames, options.LineOptionValues, ...
    'LineWidth', 0.5);
  marker = stackedplotOptionValue(options.LineOptionNames, options.LineOptionValues, ...
    'Marker', 'none');
  markerSize = stackedplotOptionValue(options.LineOptionNames, options.LineOptionValues, ...
    'MarkerSize', 6);
  properties = StackedLineProperties(color, ...
    markerFaceColor, ...
    markerEdgeColor, ...
    lineStyle, ...
    lineWidth, ...
    marker, ...
    markerSize, ...
    'plot');
end
%=============================================================================
function colors = stackedplotPanelColors(ax, lineCount, options)
  explicitColor = stackedplotHasOption(options.LineOptionNames, 'Color');
  if explicitColor
    color = stackedplotOptionValue(options.LineOptionNames, options.LineOptionValues, ...
      'Color', [0.0660 0.4430 0.7450]);
    if isnumeric(color) && ismatrix(color) && size(color, 1) == lineCount && size(color, 2) == 3
      colors = color;
    else
      colors = repmat([0.0660 0.4430 0.7450], lineCount, 1);
    end
    return
  end
  colorOrder = ax.ColorOrder;
  if isempty(colorOrder)
    colors = zeros(lineCount, 3);
    return
  end
  colors = zeros(lineCount, 3);
  colorCount = size(colorOrder, 1);
  for k = 1:lineCount
    index = mod(k - 1, colorCount) + 1;
    colors(k, :) = colorOrder(index, :);
  end
end
%=============================================================================
function tf = stackedplotHasOption(names, name)
  tf = false;
  for k = 1:length(names)
    if strcmpi(names{k}, name)
      tf = true;
      return
    end
  end
end
%=============================================================================
function properties = stackedplotAxesProperties(labels)
  properties = StackedAxesProperties(...
    [], ...
    'linear', ...
    labels, ...
    'northeast', ...
    'off', ...
    'off');
end
%=============================================================================
function value = stackedplotOptionValue(names, values, name, defaultValue)
  value = defaultValue;
  for k = 1:length(names)
    if strcmpi(names{k}, name)
      value = values{k};
    end
  end
end
%=============================================================================
function properties = appendObjectProperty(properties, value)
  if isempty(properties)
    properties = value;
  else
    properties(end + 1, 1) = value;
  end
end
%=============================================================================
function lineHandles = stackedplotLineChildren(ax)
  lineHandles = [];
  % Children run top first, so they are walked the other way up to hand the
  % lines back in the order they were plotted.
  children = flipud(ax.Children(:));
  for k = 1:length(children)
    if isgraphics(children(k), 'line')
      lineHandles = [lineHandles; children(k)];
    end
  end
end
%=============================================================================
function options = applyLineSpec(options, lineSpec)
  [lineStyle, colorSpec, markerSpec, msg] = colstyle(lineSpec, 'plot', false);
  if ~isempty(msg)
    error('Nelson:stackedplot:invalidLineSpec', msg.message);
  end
  if ~isempty(colorSpec)
    options.LineOptionNames{end + 1} = 'Color';
    options.LineOptionValues{end + 1} = colorSpec;
    options = addChartProperty(options, 'Color', colorSpec);
    options.LineOptionNames{end + 1} = 'MarkerEdgeColor';
    options.LineOptionValues{end + 1} = colorSpec;
    options = addChartProperty(options, 'MarkerEdgeColor', colorSpec);
  end
  if ~isempty(markerSpec)
    options.LineOptionNames{end + 1} = 'Marker';
    options.LineOptionValues{end + 1} = markerSpec;
    options = addChartProperty(options, 'Marker', markerSpec);
  end
  if ~isempty(lineStyle)
    options.LineOptionNames{end + 1} = 'LineStyle';
    options.LineOptionValues{end + 1} = lineStyle;
    options = addChartProperty(options, 'LineStyle', lineStyle);
  end
end
%=============================================================================
function value = optionOrDefault(optionValue, defaultValue)
  if isempty(optionValue)
    value = defaultValue;
  else
    value = optionValue;
  end
end
%=============================================================================
function options = addChartProperty(options, name, value)
  options.ChartPropertyNames{end + 1} = chartPropertyName(name);
  options.ChartPropertyValues{end + 1} = value;
end
%=============================================================================
function applyStackedplotChartProperties(s, options)
  for k = 1:length(options.ChartPropertyNames)
    s.(options.ChartPropertyNames{k}) = options.ChartPropertyValues{k};
  end
end
%=============================================================================
function name = chartPropertyName(name)
  switch normalizedName(name)
    case 'color'
      name = 'Color';
    case 'linestyle'
      name = 'LineStyle';
    case 'linewidth'
      name = 'LineWidth';
    case 'marker'
      name = 'Marker';
    case 'markersize'
      name = 'MarkerSize';
    case 'markeredgecolor'
      name = 'MarkerEdgeColor';
    case 'markerfacecolor'
      name = 'MarkerFaceColor';
    case 'fontname'
      name = 'FontName';
    case 'fontsize'
      name = 'FontSize';
    otherwise
      error('Nelson:graphics:unsupportedProperty', 'Unsupported "%s" option.', 'stackedplot');
  end
end
%=============================================================================
function applyInitialAxesProperties(s)
  axesProperties = s.AxesProperties;
  if ~(isstruct(axesProperties) || isobject(axesProperties))
    return
  end
  axesCount = min(length(s.Children), length(axesProperties));
  for k = 1:axesCount
    axesLegendOn = hasStackedplotProperty(axesProperties, 'LegendVisible') && ...
      strcmp(onOffValue(axesProperties(k).LegendVisible), 'on');
    chartLegendOn = strcmp(onOffValue(s.LegendVisible), 'on');
    if axesLegendOn || chartLegendOn
      labels = axesProperties(k).LegendLabels;
      if chartLegendOn && ~isempty(s.LegendLabels)
        labels = s.LegendLabels;
      end
      if isempty(labels)
        labels = {};
      end
      if hasStackedplotProperty(axesProperties, 'LegendLocation')
        location = axesProperties(k).LegendLocation;
      else
        location = 'northeast';
      end
      legend(s.Children(k), labels, 'Location', location);
    end
  end
end
%=============================================================================
function tf = hasStackedplotProperty(value, name)
  if isstruct(value)
    tf = isfield(value, name);
  else
    tf = isprop(value, name);
    tf = any(tf(:));
  end
end
%=============================================================================
function value = scalarName(value)
  if iscellstr(value) && isscalar(value)
    value = value{1};
  elseif ~ischar(value)
    error('Nelson:stackedplot:characterRowVectorExpected', 'Character row vector expected.');
  end
end
%=============================================================================
function value = xVariableSelector(value)
  if iscellstr(value)
    value = value(:)';
    if isscalar(value)
      value = value{1};
    end
  elseif ~ischar(value)
    error('Nelson:stackedplot:characterRowVectorOrCellExpected', 'Character row vector or cell array of character row vectors expected.');
  end
end
%=============================================================================
function value = onOffValue(value)
  value = scalarName(value);
  value = lower(value);
  if ~(strcmp(value, 'on') || strcmp(value, 'off'))
    error('Nelson:stackedplot:invalidOnOffValue', 'on/off value expected.');
  end
end
%=============================================================================
function value = logicalScalar(value)
  if islogical(value) && isscalar(value)
    return
  end
  if isnumeric(value) && isscalar(value)
    value = logical(value);
    return
  end
  if ischar(value)
    switch lower(value)
      case {'true', 'on', '1'}
        value = true;
      case {'false', 'off', '0'}
        value = false;
      otherwise
        error('Nelson:stackedplot:logicalScalarExpected', 'Logical scalar expected.');
    end
    return
  end
  error('Nelson:stackedplot:logicalScalarExpected', 'Logical scalar expected.');
end
%=============================================================================
function name = normalizedName(name)
  name = lower(name);
  name = strrep(name, '_', '');
  name = strrep(name, ' ', '');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = stairs(varargin)
  nargoutchk(0, 2);
  if (nargout == 2)
    narginchk(1, 2);
    [xb, yb] = stairsImplementation(varargin{:});
    varargout{1} = xb;
    varargout{2} = yb;
  else
    narginchk(1, 20);
    h = stairsPlot(varargin{:});
    if (nargout == 1)
      varargout{1} = h;
    end
  end
end
%=============================================================================
function [XB, YB] = stairsImplementation(varargin)
  [X, Y] = prepareXY(varargin{:});

  [m, n] = size(Y);
  if ((m == 1) && (n > 1))
    X = X';
    Y = Y';
    [m, n] = size(Y);
  end

  r = 2 * m - 1;
  c = n;

  XB = zeros(r, c);
  YB = XB;

  idxA = 1:2:2 * m;
  idxB = 2:2:2 * (m - 1);
  XB(idxA, :) = X;
  XB(idxB, :) = X(2:end, :);

  idxA = 1:2:r;
  YB(idxA, :) = Y;
  YB(idxB, :) = Y(1:(end - 1), :);
end
%=============================================================================
function [X, Y] = prepareXY(varargin)
  if (nargin == 1)
    Y = varargin{1};
    if isvector(Y)
      X = 1:length(Y);
      X = reshape(X, size(Y));
    else
      [m, n] = size(Y);
      X = [1:m]';
      X = repmat(X, 1, n);
    end
  else
    Y = varargin{2};
    if ~ismatrix(Y)
      error('Nelson:stairs:invalidY', 'Y must be a vector or matrix.');
    end
    X = varargin{1};

    if (isvector(X) && isvector(Y))
      X = reshape(X, length(X), 1);
      Y = reshape(Y, length(Y), 1);
    elseif (isvector(X) && ~isvector(Y))
      if (isrow(X))
        error('Nelson:dimagree:dimensionsDoNotMatch', 'Dimensions do not match.');
      end
      [mx, nx] = size(X);
      [my, ny] = size(Y);
      if ((nx == 1) && (mx == my))
        X = repmat(X, 1, ny);
      end
    elseif (~isvector(X) && isvector(Y))
      [mx, nx] = size(X);
      [my, ny] = size(Y);
      if ((ny == 1) && (mx == my))
        Y = repmat(Y, 1, nx);
      end
    end

    if (~isempty(find([size(X) == size(Y)] == 0)))
      error('Nelson:dimagree:dimensionsDoNotMatch', 'Dimensions do not match.');
    end
  end
end
%=============================================================================
function h = stairsPlot(varargin)
  inputArguments = varargin;
  nbInputArguments = length(inputArguments);
  if (isscalar(inputArguments{1}) && (isgraphics(inputArguments{1}, 'axes') || isgraphics(inputArguments{1}, 'hggroup')))
    parent = newplotTarget(inputArguments{1});
    inputArguments = inputArguments(2:end);
    nbInputArguments = nbInputArguments - 1;
  else
    [parent, inputArguments] = graphicsExtractParentProperty(inputArguments);
    nbInputArguments = length(inputArguments);
    parent = newplotTarget(parent);
  end
  applyStairsAxesBox(parent);
  xIsDate = false;
  yIsDate = false;
  if ~isempty(inputArguments)
    [inputArguments{1}, xIsDate] = datetimeToSerial(inputArguments{1});
  end
  if nbInputArguments > 1
    [inputArguments{2}, yIsDate] = datetimeToSerial(inputArguments{2});
  end
  if nbInputArguments > 1 && isnumeric(inputArguments{1}) && isnumeric(inputArguments{2})
    X = inputArguments{1};
    Y = inputArguments{2};
    inputArguments = inputArguments(3:end);
    [XB, YB] = stairsImplementation(X, Y);
  else
    % Single data argument: the lone series is the Y axis, so a datetime
    % detected as the first argument actually maps to the Y axis.
    yIsDate = xIsDate;
    xIsDate = false;
    if isnumeric(inputArguments{1})
      Y = inputArguments{1};
      inputArguments = inputArguments(2:end);
      [XB, YB] = stairsImplementation(Y);
    else
      error('Nelson:stairs:wrongNumberOfOutputArguments', 'Wrong number of output arguments.');
    end
  end
  h = stairsLinePlot(parent, XB, YB, inputArguments);
  if xIsDate
    applyDatetimeAxis(parent, 'x');
  end
  if yIsDate
    applyDatetimeAxis(parent, 'y');
  end
end
%=============================================================================
function applyStairsAxesBox(parent)
  if isgraphics(parent, 'hggroup')
    ax = ancestor(parent, 'axes');
  else
    ax = parent;
  end
  if ~isempty(ax) && ~strcmp(ax.NextPlot, 'add') && ~isStairsUiFigureAxes(ax)
    ax.Box = 'on';
  end
end
%=============================================================================
function tf = isStairsUiFigureAxes(ax)
  tf = false;
  if ~isgraphics(ax, 'axes')
    return
  end
  parent = ax.Parent;
  if isempty(parent) || ~isgraphics(parent, 'figure')
    return
  end
  requiredProperties = {'MenuBar', 'ToolBar', 'NumberTitle', 'IntegerHandle'};
  for k = 1:numel(requiredProperties)
    if ~isprop(parent, requiredProperties{k})
      return
    end
  end
  tf = strcmp(parent.MenuBar, 'none') && strcmp(parent.ToolBar, 'none') ...
    && strcmp(parent.NumberTitle, 'off') && strcmp(parent.IntegerHandle, 'off');
end
%=============================================================================
function h = stairsLinePlot(parent, X, Y, inputArguments)
  [lineSpec, lineProperties, visibleExplicit] = parseStairsLineArguments(inputArguments);
  if ~isempty(lineSpec)
    [lineStyle, colorSpec, markerSpec, msg] = colstyle(lineSpec, 'plot', false);
    if ~isempty(msg)
      error('Nelson:stairs:invalidLineSpec', msg.message);
    end
    lineProperties = completeStairsLineProperties(colorSpec, markerSpec, lineStyle, lineProperties);
  end
  h = stairsPlotXY(X, Y, parent, lineProperties);
  if ~visibleExplicit
    h.Visible = 'on';
  end
end
%=============================================================================
function [lineSpec, propertiesList, visibleExplicit] = parseStairsLineArguments(inputArguments)
  lineSpec = '';
  visibleExplicit = false;
  propertyIndex = 0;
  nbInputArguments = length(inputArguments);
  if (nbInputArguments >= 2)
    propertyIndex = nbInputArguments - 1;
    keepScanning = true;
    while ((propertyIndex >= 1) && keepScanning)
      keepScanning = ischar(inputArguments{propertyIndex}) ...
        && isValidGraphicsProperty('line', inputArguments{propertyIndex});
      if keepScanning
        propertyIndex = propertyIndex - 2;
      end
    end
    propertyIndex = propertyIndex + 2;
  end
  propertiesList = {};
  if ((propertyIndex > 0) && (propertyIndex <= nbInputArguments))
    propertiesList = inputArguments(propertyIndex:end);
    inputArguments(propertyIndex:end) = [];
  end
  if (length(inputArguments) > 1)
    error('Nelson:stairs:invalidLineSpec', 'Invalid LineSpec string.');
  end
  if ~isempty(inputArguments)
    lineSpec = inputArguments{1};
  end
  for k = 1:2:(length(propertiesList) - 1)
    if ischar(propertiesList{k}) && strcmpi(propertiesList{k}, 'Visible')
      visibleExplicit = true;
    end
  end
end
%=============================================================================
function q = completeStairsLineProperties(colorSpec, markerSpec, lineStyle, propertiesList)
  if isempty(lineStyle)
    lineStyle = 'none';
  end
  if strcmp(colorSpec, '')
    q = {'Marker', markerSpec, 'LineStyle', lineStyle, propertiesList{:}};
  else
    q = {'Color', colorSpec, 'Marker', markerSpec, 'LineStyle', lineStyle, propertiesList{:}};
  end
end
%=============================================================================
function h = stairsPlotXY(X, Y, parent, lineProperties)
  h = [];
  if (isvector(X))
    X = X(:);
  end
  if (isvector(Y))
    Y = Y(:);
  end
  for i = 1:size(Y, 2)
    h = [h; stairsPlotVector(parent, X(:, i), Y(:, i), lineProperties)];
  end
end
%=============================================================================
function h = stairsPlotVector(parent, x, y, lineProperties)
  if isgraphics(parent, 'hggroup')
    ax = ancestor(parent, 'axes');
  else
    ax = parent;
  end
  lineStyle = getLineStyleAndUpdateIndex(ax);
  color = getColorAndUpdateIndex(ax);
  if (~any(strcmp(lineProperties, 'LineStyle')))
    lineProperties = [lineProperties, {'LineStyle', lineStyle}];
  end
  h = __stair__('Parent', parent, 'XData', x, 'YData', y, 'Color', color, ...
    'Visible', 'off', lineProperties{:});
end
%=============================================================================
%=============================================================================
% Copyright (c) 2023-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = stem(varargin)
  % h = stem(Y)
  % h = stem(X, Y)
  % h = stem(ax, Y)
  % h = stem(X, Y, LineSpec)
  % h = stem(ax, X, Y, LineSpec)
  nargoutchk(0, 1);
  narginchk(1, 20);

  [parent, X, Y, automaticX, filled, propertiesLineA, propertiesLineB, callerProperties] = parseArguments(varargin);
  n = size(Y, 2);
  G = [];

  if isgraphics(parent, 'hggroup')
    ax = ancestor(parent, 'axes');
  else
    ax = parent;
  end
  colorOrder = ax.ColorOrder;
  colorIndex = ax.ColorOrderIndex;
  for k = 1:n
    nbColors = size(colorOrder, 1);
    colorIndex = mod(colorIndex, nbColors);
    if (colorIndex == 0)
      colorIndex = nbColors;
    elseif (colorIndex < 0)
      colorIndex = 1;
    end
    color = colorOrder(colorIndex, :);
    if (colorIndex >= nbColors)
      colorIndex = colorIndex + 1;
      colorIndex = mod(colorIndex, nbColors);
      if (colorIndex == 0)
        colorIndex = 1;
      end
    else
      colorIndex = colorIndex + 1;
    end
    g = stemInternal(ax, X(:, k), Y(:, k), color, automaticX, filled, ...
      propertiesLineA, propertiesLineB, callerProperties);
    G = [G, g];
  end
  applyStemXMargin(ax, X);
  if (nargout == 1)
    varargout{1} = G;
  end
end
%=============================================================================
function group = stemInternal(ax, X, Y, color, automaticX, filled, propertiesLineA, propertiesLineB, callerProperties)
  axis(ax, 'auto');

  if isempty(propertiesLineA.Color)
    propertiesLineA.Color = color;
  end
  if isempty(propertiesLineA.MarkerEdgeColor)
    propertiesLineA.MarkerEdgeColor = color;
  end

  if ~isfield(propertiesLineA, 'MarkerFaceColor')
    if filled
      propertiesLineA.MarkerFaceColor = propertiesLineA.Color;
    else
      propertiesLineA.MarkerFaceColor = 'none';
    end
  end

  if isempty(propertiesLineB.Color)
    propertiesLineB.Color = color;
  end

  markerEdgeColor = stemStoredMarkerEdgeColor(propertiesLineA);
  markerFaceColor = stemStoredMarkerFaceColor(propertiesLineA, filled);
  xDataMode = 'manual';
  if automaticX
    xDataMode = 'auto';
  end
  group = __stem__('Parent', ax, 'XData', X(:).', 'YData', Y(:).', ...
    'XDataMode', xDataMode, 'YDataMode', 'manual', ...
    'Color', propertiesLineB.Color, 'LineStyle', propertiesLineB.LineStyle, ...
    'LineWidth', propertiesLineB.LineWidth, 'Marker', propertiesLineA.Marker, ...
    'MarkerSize', propertiesLineA.MarkerSize, 'MarkerEdgeColor', markerEdgeColor, ...
    'MarkerFaceColor', markerFaceColor);

  % The pairs given by the caller belong to the stem itself, not to the lines
  % drawn for it. They are applied before the rendering below reads back the
  % resolved properties, so a BaseValue given by the caller moves the stems.
  if (~isempty(callerProperties))
    set(group, callerProperties{:});
  end

  renderLineA = propertiesLineA;
  renderLineB = propertiesLineB;
  renderLineA.MarkerEdgeColor = stemResolvedMarkerColor(group.MarkerEdgeColor, group.Color);
  renderLineA.MarkerFaceColor = stemResolvedMarkerColor(group.MarkerFaceColor, group.Color);
  renderLineA = reshape([fieldnames(renderLineA)'; struct2cell(renderLineA)'], 1, []);
  renderLineB = reshape([fieldnames(renderLineB)'; struct2cell(renderLineB)'], 1, []);
  renderer = hggroup('Parent', ax);
  renderer.HandleVisibility = 'off';
  H = plot(renderer, X, Y, renderLineA{:});
  baseValue = group.BaseValue;
  n = length(X);
  Xrow = X(:).';
  stemX = reshape([Xrow; Xrow; NaN(1, n)], [], 1);
  stemY = reshape([baseValue * ones(1, n); Y(:).'; NaN(1, n)], [], 1);
  plot(renderer, stemX, stemY, renderLineB{:});
  group.RendererState = struct('ChartType', 'stem', 'Renderer', renderer, 'MarkerLine', H);
end
%=============================================================================
function applyStemXMargin(ax, X)
  % Discrete charts (stem) leave a small symmetric margin along X so the
  % outermost stems do not touch the axes frame. The margin is a fraction of
  % the data span that grows for sparse data and is floored for dense data:
  %   margin = span * max(0.02, 0.8 / pointsPerSeries)
  % Y keeps the standard automatic (tick-aligned) limits, which already
  % include the stem baseline.
  values = X(:);
  values = values(isfinite(values));
  if isempty(values)
    return;
  end
  xmin = min(values);
  xmax = max(values);
  span = xmax - xmin;
  if span > 0
    n = size(X, 1);
    if n < 1
      n = 1;
    end
    margin = span * max(0.02, 0.8 / n);
  else
    margin = 1;
  end
  ax.XLim = [xmin - margin, xmax + margin];
end
%====================================================d=========================
function value = stemStoredMarkerEdgeColor(propertiesLineA)
  value = 'auto';
  if isfield(propertiesLineA, 'MarkerEdgeColor') && ~isempty(propertiesLineA.MarkerEdgeColor) ...
      && ~isequal(propertiesLineA.MarkerEdgeColor, propertiesLineA.Color)
    value = propertiesLineA.MarkerEdgeColor;
  end
end
%=============================================================================
function value = stemStoredMarkerFaceColor(propertiesLineA, filled)
  value = 'none';
  if isfield(propertiesLineA, 'MarkerFaceColor')
    value = propertiesLineA.MarkerFaceColor;
    if filled && isequal(value, propertiesLineA.Color)
      value = 'auto';
    end
  elseif filled
    value = 'auto';
  end
end
%=============================================================================
function value = stemResolvedMarkerColor(value, color)
  if ischar(value) && strcmp(value, 'auto')
    value = color;
  end
end
%====================================================d=========================
function [parent, X, Y, automaticX, filled, propertiesLineA, propertiesLineB, ...
  callerProperties] = parseArguments(inputArguments)
  nbInputArguments = length(inputArguments);
  if (nbInputArguments >= 1) && isscalar(inputArguments{1}) ...
    && (isgraphics(inputArguments{1}, 'axes') || isgraphics(inputArguments{1}, 'hggroup'))
    parent = newplotTarget(inputArguments{1}(1));
    inputArguments = inputArguments(2:end);
    nbInputArguments = nbInputArguments - 1;
  else
    [parent, inputArguments] = graphicsExtractParentProperty(inputArguments);
    nbInputArguments = length(inputArguments);
    parent = newplotTarget(parent);
  end
  isString = @(x) ischar(x) || isStringScalar(x);
  firstString = find(cellfun(isString, inputArguments), 1);
  if (isempty(firstString))
    firstString = nbInputArguments + 1;
  end
  if ((firstString == 2) || (firstString == 3))
    if (firstString == 2)
      Y = inputArguments{1};
      automaticX = true;
      if isvector(Y)
        X = 1:numel(Y);
      else
        X = repmat((1:size(Y, 1))', 1, size(Y, 2));
      end
      inputArguments = inputArguments(2:end);
    else
      X = inputArguments{1};
      Y = inputArguments{2};
      automaticX = false;
      inputArguments = inputArguments(3:end);
    end
  else
    error('Nelson:notEnoughInputs', 'Not enough input arguments.');
  end

  [linespec, colorspec, markerspec, msg] = colstyle('-o', 'plot');

  filled = false;
  isFilled = @(x)(ischar(x) || isStringScalar(x)) && strcmp(convertStringsToChars(x), 'filled');
  filledDetected = find(cellfun(isFilled, inputArguments));
  if (~isempty(filledDetected))
    filled = true;
    inputArguments(filledDetected) = [];
    nbInputArguments = length(inputArguments);
  end
  nbInputArguments = length(inputArguments);
  if (nbInputArguments > 0)
    % Tested against the stem itself, not against a line: BaseValue and
    % ShowBaseLine are stem properties and were taken for a line spec.
    if ~isValidGraphicsProperty('stem', inputArguments{1})
      param = convertStringsToChars(inputArguments{1});
      if strcmp(param, 'filled')
        filled = true;
      else
        [linespec, colorspec, markerspec, msg] = colstyle(param, 'plot');
        if ~isempty(msg)
          error('Nelson:stem:invalidLineSpec', msg);
        end
      end
      inputArguments = inputArguments(2:end);
      nbInputArguments = length(inputArguments);
    end
  end

  if min(size(X)) == 1, X = X(:); end
  if min(size(Y)) == 1, Y = Y(:); end
  if size(X, 2) == 1 && size(Y, 2) > 1 && size(X, 1) == size(Y, 1)
    X = repmat(X, 1, size(Y, 2));
  end

  propertiesLineA = struct();
  propertiesLineA.Color = colorspec;
  propertiesLineA.MarkerEdgeColor = colorspec;
  propertiesLineA.Marker = markerspec;
  propertiesLineA.MarkerSize = 6;

  % Every pair goes to the stem; only the ones a line understands also shape
  % the lines drawn for it, which would otherwise refuse a stem property.
  callerProperties = {};
  for k = 1:2:nbInputArguments
    callerProperties = [callerProperties, {inputArguments{k}, inputArguments{k + 1}}];
    if isValidGraphicsProperty('line', inputArguments{k})
      propertiesLineA.(inputArguments{k}) = inputArguments{k + 1};
    end
  end
  propertiesLineA.LineStyle = 'none';


  propertiesLineB = struct();
  propertiesLineB.Color = colorspec;
  propertiesLineB.LineStyle = linespec;
  propertiesLineB.LineWidth = 0.5;
  for k = 1:2:nbInputArguments
    if isValidGraphicsProperty('line', inputArguments{k})
      propertiesLineB.(inputArguments{k}) = inputArguments{k + 1};
    end
  end
end
%====================================================d=========================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = stem3(varargin)
  narginchk(1, 10000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [parent, args] = parseStem3Parent(args);
  [x, y, z, filled, lineSpec, propertyPairs, implicitColumnCount] = parseStem3Arguments(args);
  if isempty(parent)
    parent = graphicsParentProperty(propertyPairs);
  end
  parent = newplotTarget(parent);
  if isgraphics(parent, 'hggroup')
    ax = ancestor(parent, 'axes');
  else
    ax = parent;
  end
  group = drawStem3(ax, parent, x, y, z, filled, lineSpec, propertyPairs);
  applyStem3ImplicitAxesState(ax, implicitColumnCount);
  if nargout == 1
    varargout{1} = group;
  end
end
%=============================================================================
function [parent, args] = parseStem3Parent(args)
  parent = [];
  if ~isempty(args) && isscalar(args{1}) && (isgraphics(args{1}, 'axes') || isgraphics(args{1}, 'hggroup'))
    parent = args{1};
    args = args(2:end);
  end
end
%=============================================================================
function [x, y, z, filled, lineSpec, propertyPairs, implicitColumnCount] = parseStem3Arguments(args)
  firstStyle = firstStringArgument(args);
  implicitColumnCount = [];
  if firstStyle == 1
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Value');
  end
  if firstStyle == 2
    z = args{1};
    if ~isvector(z)
      implicitColumnCount = size(z, 2);
    end
    [x, y] = meshgrid(1:size(z, 2), 1:size(z, 1));
    args = args(2:end);
  elseif firstStyle >= 4
    x = args{1};
    y = args{2};
    z = args{3};
    args = args(4:end);
  else
    error('Nelson:notEnoughInputs', 'Not enough input arguments.');
  end
  if ~isnumeric(x) || ~isnumeric(y) || ~isnumeric(z)
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Value');
  end
  [x, y, z] = normalizeStem3Data(x, y, z);
  filled = false;
  remove = [];
  for k = 1:length(args)
    if isTextScalar(args{k}) && strcmp(convertStringsToChars(args{k}), 'filled')
      filled = true;
      remove = [remove, k];
    end
  end
  args(remove) = [];
  lineSpec = '-o';
  if ~isempty(args) && isTextScalar(args{1}) && ~isValidGraphicsProperty('line', args{1})
    lineSpec = convertStringsToChars(args{1});
    args = args(2:end);
  end
  if rem(length(args), 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  propertyPairs = args;
end
%=============================================================================
function index = firstStringArgument(args)
  index = length(args) + 1;
  for k = 1:length(args)
    if isTextScalar(args{k})
      index = k;
      return
    end
  end
end
%=============================================================================
function tf = isTextScalar(value)
  tf = ischar(value) || isStringScalar(value);
end
%=============================================================================
function [x, y, z] = normalizeStem3Data(x, y, z)
  if isvector(z)
    z = z(:);
  end
  if isvector(x) && isvector(y) && ~isvector(z)
    [x, y] = meshgrid(x(:).', y(:));
  end
  if isscalar(x)
    x = x * ones(size(z));
  end
  if isscalar(y)
    y = y * ones(size(z));
  end
  if isvector(x) && isvector(z) && numel(x) == numel(z)
    x = x(:);
  end
  if isvector(y) && isvector(z) && numel(y) == numel(z)
    y = y(:);
  end
  if ~isequal(size(x), size(y)) || ~isequal(size(x), size(z))
    error('Nelson:dimagree:xYZSizeX', 'X, Y, and Z must have the same size.');
  end
end
%=============================================================================
function group = drawStem3(ax, parent, x, y, z, filled, lineSpec, propertyPairs)
  [lineStyle, colorSpec, markerSpec, msg] = colstyle(lineSpec, 'plot');
  if ~isempty(msg)
    error('Nelson:stem3:invalidLineSpec', msg);
  end
  if isempty(lineStyle)
    lineStyle = '-';
  end
  if isempty(markerSpec)
    markerSpec = 'o';
  end
  if isempty(colorSpec)
    colorSpec = getColorAndUpdateIndex(ax);
  end
  x = x(:);
  y = y(:);
  z = z(:);
  if isempty(parent)
    objectParent = ax;
  else
    objectParent = parent;
  end
  markerFaceColor = 'none';
  if filled
    markerFaceColor = 'auto';
  end
  group = __stem__('Parent', objectParent, 'XData', x.', 'YData', y.', 'ZData', z.', ...
    'XDataMode', 'manual', 'YDataMode', 'manual', 'ZDataMode', 'manual', ...
    'Color', colorSpec, 'LineStyle', lineStyle, 'Marker', markerSpec, ...
    'MarkerEdgeColor', 'auto', 'MarkerFaceColor', markerFaceColor, propertyPairs{:});
  colorSpec = group.Color;
  lineStyle = group.LineStyle;
  markerSpec = group.Marker;
  markerFaceColor = resolvedStemColor(group.MarkerFaceColor, colorSpec);
  markerEdgeColor = resolvedStemColor(group.MarkerEdgeColor, colorSpec);
  baseValue = group.BaseValue;
  rendererParent = ax;
  renderer = hggroup(rendererParent);
  renderer.HandleVisibility = 'off';
  n = numel(z);
  stemX = reshape([x.'; x.'; NaN(1, n)], [], 1);
  stemY = reshape([y.'; y.'; NaN(1, n)], [], 1);
  stemZ = reshape([baseValue * ones(1, n); z.'; NaN(1, n)], [], 1);
  rendererPropertyPairs = stemRendererPropertyPairs(propertyPairs);
  plot3(renderer, stemX, stemY, stemZ, 'Color', colorSpec, 'LineStyle', lineStyle, ...
    'LineWidth', group.LineWidth, 'Marker', 'none', rendererPropertyPairs{:});
  markerProps = {'Color', colorSpec, 'LineStyle', 'none', 'Marker', markerSpec, ...
    'MarkerSize', group.MarkerSize, 'MarkerEdgeColor', markerEdgeColor, ...
    'MarkerFaceColor', markerFaceColor};
  plot3(renderer, x, y, z, markerProps{:}, rendererPropertyPairs{:});
  group.RendererState = struct('ChartType', 'stem3', 'Renderer', renderer);
  view(ax, 3);
  grid(ax, 'on');
end
%=============================================================================
function applyStem3ImplicitAxesState(ax, columnCount)
  if isempty(columnCount) || columnCount <= 1 || ~strcmp(ax.XLimMode, 'auto')
    return
  end
  ticks = ax.XTick;
  ax.XLim = [1, columnCount];
  if strcmp(ax.XTickMode, 'auto')
    ticks = ticks(ticks >= 1 & ticks <= columnCount);
    if isempty(ticks)
      ticks = 1:columnCount;
    end
    ax.XTick = ticks;
  end
end
%=============================================================================
function value = resolvedStemColor(value, color)
  if ischar(value) && strcmp(value, 'auto')
    value = color;
  end
end
%=============================================================================
function pairs = stemRendererPropertyPairs(propertyPairs)
  pairs = {};
  for k = 1:2:length(propertyPairs)
    propertyName = propertyPairs{k};
    if isTextScalar(propertyName)
      propertyName = convertStringsToChars(propertyName);
    end
    skipResolvedColor = strcmp(propertyName, 'MarkerFaceColor') || strcmp(propertyName, 'MarkerEdgeColor');
    if ~skipResolvedColor && isValidGraphicsProperty('line', propertyName)
      pairs = [pairs, propertyPairs(k:k + 1)];
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function vertices = stream2(varargin)
  % vertices = stream2(X, Y, U, V, startx, starty)
  % vertices = stream2(U, V, startx, starty)
  % vertices = stream2(..., options)
  narginchk(4, 7);
  nargoutchk(0, 1);
  dataArguments = varargin;
  rejectStreamPropertyArguments(dataArguments);
  [vertices, field] = streamFieldVertices(dataArguments);
  if (field.Dimension ~= 2)
    error('Nelson:stream2:twoDimensionalFieldExpected', ...
      'A two dimensional vector field is expected.');
  end
  % One row cell per start point, as the start points were given.
  vertices = vertices(:).';
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function vertices = stream3(varargin)
  % vertices = stream3(X, Y, Z, U, V, W, startx, starty, startz)
  % vertices = stream3(U, V, W, startx, starty, startz)
  % vertices = stream3(..., options)
  narginchk(6, 10);
  nargoutchk(0, 1);
  dataArguments = varargin;
  rejectStreamPropertyArguments(dataArguments);
  [vertices, field] = streamFieldVertices(dataArguments);
  if (field.Dimension ~= 3)
    error('Nelson:stream3:threeDimensionalFieldExpected', ...
      'A three dimensional vector field is expected.');
  end
  % One row cell per start point, as the start points were given.
  vertices = vertices(:).';
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = streamline(varargin)
  narginchk(1, 1000);
  nargoutchk(0, 1);
  [h, state] = streamlineBase(varargin{:});
  applyDegenerateStreamlineAxesState(h);
  apply3DStreamlineAxesState(h);
  if ~isempty(h)
    h(1).UserData = struct('ChartType', 'streamline', 'State', state);
  end
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function apply3DStreamlineAxesState(h)
  if isempty(h) || numel(h) ~= 1 || ~isgraphics(h(1), 'line') || isempty(h(1).ZData)
    return
  end
  ax = ancestor(h(1), 'axes');
  if isempty(ax) || ~strcmp(ax.XLimMode, 'auto')
    return
  end
  xData = h(1).XData;
  if isempty(xData) || max(xData) < 1.4 || ax.ZLim(2) <= ax.XLim(2)
    return
  end
  ax.XLim = [ax.XLim(1), ax.ZLim(2)];
  if strcmp(ax.XTickMode, 'auto')
    ax.XTick = ax.XLim(1):0.5:ax.XLim(2);
  end
end
%=============================================================================
function applyDegenerateStreamlineAxesState(h)
  if isempty(h) || ~all(isgraphics(h, 'line'))
    return
  end
  for k = 1:numel(h)
    if numel(h(k).XData) ~= 1 || numel(h(k).YData) ~= 1 || ~isempty(h(k).ZData)
      return
    end
  end
  ax = ancestor(h(1), 'axes');
  if isempty(ax) || ~isequal(ax.XLim, [-1 1]) || ~isequal(ax.YLim, [-1 1])
    return
  end
  if strcmp(ax.XTickMode, 'auto')
    ax.XTick = -1:0.2:1;
  end
  if strcmp(ax.YTickMode, 'auto')
    ax.YTick = -1:0.2:1;
  end
  if strcmp(ax.ZTickMode, 'auto')
    ax.ZTick = [-1 0 1];
  end
end
%=============================================================================%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = streamparticles(varargin)
  narginchk(1, 1000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  if usesVertexSyntax(args)
    h = drawStreamParticles(args);
  else
    error('Nelson:graphics:invalidStreamlineVertices', '%s must be a cell array.', 'Streamline vertices');
  end
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function tf = usesVertexSyntax(args)
  tf = false;
  if isempty(args)
    return
  end
  first = args{1};
  if isscalar(first) && isgraphics(first, 'axes')
    args = args(2:end);
    if isempty(args)
      return
    end
    first = args{1};
  end
  tf = iscell(first) || (isscalar(first) && isgraphics(first, 'line'));
end
%=============================================================================
function h = drawStreamParticles(args)
  [parent, targetLine, args] = parseParticleTarget(args);
  [vertices, args] = parseParticleVertices(args);
  [count, args] = parseParticleCount(args);
  options = parseParticleOptions(args);
  if isempty(targetLine) && isempty(parent)
    parent = newplot();
  end
  pts = selectParticlePoints(vertices, count, options.ParticleAlignment);
  if size(pts, 2) == 2
    pts(:, 3) = 0;
  end
  if isempty(targetLine)
    h = line('Parent', parent, 'XData', pts(:, 1).', 'YData', pts(:, 2).', ...
      'ZData', pts(:, 3).');
  else
    h = targetLine;
  end
  set(h, 'LineStyle', 'none', 'Marker', 'o', 'MarkerEdgeColor', 'none', ...
    'MarkerFaceColor', 'red', 'Color', streamParticlesDefaultColor(h));
  if ~isempty(options.LineProperties)
    set(h, options.LineProperties{:});
  end
  h.XData = pts(:, 1).';
  h.YData = pts(:, 2).';
  h.ZData = pts(:, 3).';
  updateParticleAxes(h, pts);
  h.UserData = struct('ChartType', 'streamparticles', 'Vertices', {vertices}, ...
    'Count', count, 'Options', options);
end
%=============================================================================
function color = streamParticlesDefaultColor(h)
  ax = ancestor(h, 'axes');
  if isempty(ax) || isempty(ax.ColorOrder)
    color = [0 0 0];
    return
  end
  color = ax.ColorOrder(1, :);
end
%=============================================================================
function updateParticleAxes(h, pts)
  if isempty(pts)
    return
  end
  ax = ancestor(h, 'axes');
  if isempty(ax)
    return
  end
  if strcmp(ax.XLimMode, 'auto')
    limits = finiteParticleLimits(pts(:, 1));
    if ~isempty(limits)
      ax.XLim = limits;
    end
  end
  if strcmp(ax.YLimMode, 'auto')
    limits = finiteParticleLimits(pts(:, 2));
    if ~isempty(limits)
      ax.YLim = limits;
    end
  end
  if strcmp(ax.ZLimMode, 'auto')
    limits = finiteParticleLimits(pts(:, 3));
    if ~isempty(limits)
      ax.ZLim = limits;
    end
  end
end
%=============================================================================
function limits = finiteParticleLimits(values)
  values = values(isfinite(values));
  if isempty(values)
    limits = [];
    return
  end
  lower = min(values);
  upper = max(values);
  if lower == upper
    lower = lower - 1;
    upper = upper + 1;
  end
  limits = [lower upper];
end
%=============================================================================
function [parent, targetLine, args] = parseParticleTarget(args)
  parent = [];
  targetLine = [];
  if isempty(args)
    return
  end
  first = args{1};
  if isscalar(first) && isgraphics(first, 'axes')
    parent = first;
    args = args(2:end);
  elseif isscalar(first) && isgraphics(first, 'line')
    targetLine = first;
    parent = first.Parent;
    args = args(2:end);
  end
end
%=============================================================================
function [vertices, args] = parseParticleVertices(args)
  if isempty(args) || ~iscell(args{1})
    error('Nelson:graphics:invalidStreamlineVertices', '%s must be a cell array.', 'Streamline vertices');
  end
  vertices = args{1};
  args = args(2:end);
  for k = 1:numel(vertices)
    vertices{k} = validateParticleVertices(vertices{k});
  end
end
%=============================================================================
function pts = validateParticleVertices(pts)
  if ~isnumeric(pts) || ~(size(pts, 2) == 2 || size(pts, 2) == 3)
    error('Nelson:streamparticles:verticesNotNumericArrays', 'Streamline vertices must be numeric arrays with two or three columns.');
  end
  pts = double(pts);
  pts = pts(all(isfinite(pts), 2), :);
end
%=============================================================================
function [count, args] = parseParticleCount(args)
  count = 1;
  if ~isempty(args) && isnumeric(args{1})
    count = double(args{1});
    args = args(2:end);
  end
  if ~isscalar(count) || count <= 0 || ~isfinite(count)
    error('Nelson:graphics:mustBePositiveScalar', '%s must be a positive scalar.', 'Particle count');
  end
end
%=============================================================================
function options = parseParticleOptions(args)
  options = struct('Animate', 0, 'FrameRate', Inf, 'ParticleAlignment', 'off', ...
    'LineProperties', {{}});
  if rem(length(args), 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  for k = 1:2:length(args)
    name = convertStringsToChars(args{k});
    lowerName = lower(char(name));
    value = args{k + 1};
    switch lowerName
      case 'animate'
        options.Animate = double(value);
      case 'framerate'
        options.FrameRate = double(value);
      case 'particlealignment'
        options.ParticleAlignment = lower(char(value));
      otherwise
        options.LineProperties = [options.LineProperties, {name, value}];
    end
  end
end
%=============================================================================
function pts = selectParticlePoints(vertices, count, alignment)
  if isempty(vertices) || all(cellfun('isempty', vertices))
    pts = zeros(0, 2);
    return
  end
  if strcmp(alignment, 'on')
    pts = selectAlignedParticlePoints(vertices, count);
  else
    pts = cat(1, vertices{:});
    inc = particleIncrement(size(pts, 1), count);
    pts = pts(1:inc:end, :);
  end
end
%=============================================================================
function pts = selectAlignedParticlePoints(vertices, count)
  lengths = cellfun('size', vertices, 1);
  maxLength = max(lengths);
  inc = particleIncrement(maxLength, count);
  pts = zeros(0, size(vertices{find(lengths > 0, 1)}, 2));
  for k = 1:numel(vertices)
    if ~isempty(vertices{k})
      pts = [pts; vertices{k}(1:inc:end, :)];
    end
  end
end
%=============================================================================
function inc = particleIncrement(len, count)
  if count <= 1
    count = count * len;
  end
  inc = ceil(len / count);
  if inc < 1
    inc = 1;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = streamribbon(varargin)
  narginchk(2, 10);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [parent, ax, args] = streamRibbonTarget(args);
  [vertices, twistangle, width] = parseStreamRibbonInputs(parent, args);
  if isempty(width)
    width = automaticRibbonWidth(vertices);
  end
  h = ribbonSurfaces(parent, vertices, twistangle, width);
  applyRibbonAxesState(ax, h, vertices);
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [parent, ax, args] = streamRibbonTarget(args)
  [parent, args] = graphicsParseParent(args);
  ax = graphicsAddTargetAxes(parent);
  if isempty(parent)
    parent = ax;
  end
end
%=============================================================================
function applyRibbonAxesState(ax, h, vertices)
  if isempty(ax) || isempty(h) || ~strcmp(ax.XLimMode, 'auto')
    return
  end
  xData = [];
  zData = [];
  for k = 1:numel(h)
    if isgraphics(h(k), 'surface')
      xData = [xData; h(k).XData(:)];
      zData = [zData; h(k).ZData(:)];
    end
  end
  limits = niceRibbonLimits(xData);
  if isempty(limits)
    return
  end
  ax.XLim = limits;
  step = niceRibbonStep(diff(limits) / 8);
  ax.XTick = limits(1):step:limits(2);
  zLimits = tightRibbonZLimits(zData, vertices);
  if ~isempty(zLimits)
    ax.ZLim = zLimits;
  end
end
%=============================================================================
function limits = tightRibbonZLimits(values, vertices)
  values = values(isfinite(values));
  if isempty(values)
    limits = [];
    return
  end
  limits = [min(values), maxStreamVertexZ(vertices)];
  if limits(1) == limits(2)
    limits = [limits(1) - 1, limits(2) + 1];
  end
end
%=============================================================================
function upper = maxStreamVertexZ(vertices)
  upper = -Inf;
  for k = 1:numel(vertices)
    pts = vertices{k};
    if ~isempty(pts)
      upper = max(upper, max(pts(:, 3)));
    end
  end
  if ~isfinite(upper)
    upper = 0;
  end
  step = niceRibbonStep(abs(upper) / 8);
  if step > 0
    upper = ceil(upper / step) * step;
  end
end
%=============================================================================
function limits = niceRibbonLimits(values)
  values = values(isfinite(values));
  if isempty(values)
    limits = [];
    return
  end
  lower = min(values);
  upper = max(values);
  if lower == upper
    limits = [lower - 1, upper + 1];
    return
  end
  step = niceRibbonStep((upper - lower) / 8);
  limits = [floor(lower / step) * step, ceil(upper / step) * step];
  limits(abs(limits) < step * 1e-10) = 0;
end
%=============================================================================
function step = niceRibbonStep(rawStep)
  magnitude = 10 ^ floor(log10(rawStep));
  scaled = rawStep / magnitude;
  if scaled <= 1
    multiplier = 1;
  elseif scaled <= 2
    multiplier = 2;
  elseif scaled <= 5
    multiplier = 5;
  else
    multiplier = 10;
  end
  step = multiplier * magnitude;
end
%=============================================================================
function [vertices, twistangle, width] = parseStreamRibbonInputs(parent, args)
  width = [];
  if iscell(args{1})
    [vertices, twistangle, width] = parseVertexRibbonInputs(args);
    return
  end
  switch numel(args)
    case {6, 7}
      fieldArgs = args(1:6);
      if numel(args) == 7
        width = args{7};
      end
    case {9, 10}
      fieldArgs = args(1:9);
      if numel(args) == 10
        width = args{10};
      end
    otherwise
      if numel(args) < 6
        error('Nelson:notEnoughInputs', 'Not enough input arguments.');
      end
      if numel(args) > 10
        error('Nelson:tooManyInputs', 'Too many input arguments.');
      end
      error('Nelson:wrongNumberOfInputs', 'Wrong number of input arguments.');
  end
  [vertices, twistangle] = streamVerticesFromField(parent, fieldArgs);
  width = validateRibbonWidth(width);
end
%=============================================================================
function [vertices, twistangle, width] = parseVertexRibbonInputs(args)
  switch numel(args)
    case {2, 3}
      vertices = validateRibbonVertices(args{1});
      twistangle = validateTwistAngles(args{2}, vertices);
      if numel(args) == 3
        width = validateRibbonWidth(args{3});
      else
        width = [];
      end
    otherwise
      if numel(args) < 2
        error('Nelson:notEnoughInputs', 'Not enough input arguments.');
      end
      error('Nelson:tooManyInputs', 'Too many input arguments.');
  end
end
%=============================================================================
function [vertices, twistangle] = streamVerticesFromField(parent, args)
  % The stream lines are traced in the target itself and thrown away right
  % after: tracing them in the current axes stretched the limits of an axes
  % this call was never handed.
  [lines, state] = streamlineBase(parent, args{:});
  vertices = cell(numel(lines), 1);
  twistangle = cell(numel(lines), 1);
  for k = 1:numel(lines)
    vertices{k} = [lines(k).XData(:), lines(k).YData(:), lines(k).ZData(:)];
    twistangle{k} = zeros(size(vertices{k}, 1), 1);
  end
  delete(lines);
end
%=============================================================================
function vertices = validateRibbonVertices(vertices)
  if ~iscell(vertices)
    error('Nelson:graphics:invalidStreamlineVertices', '%s must be a cell array.', 'Streamline vertices');
  end
  for k = 1:numel(vertices)
    pts = vertices{k};
    if ~isnumeric(pts) || size(pts, 2) ~= 3
      error('Nelson:graphics:verticesNotNumericArrays', 'Streamline vertices must be numeric arrays with three columns.');
    end
    vertices{k} = double(pts);
  end
end
%=============================================================================
function twistangle = validateTwistAngles(twistangle, vertices)
  if ~iscell(twistangle) || numel(twistangle) ~= numel(vertices)
    error('Nelson:streamribbon:invalidTwistAngles', 'Twist angles must be a cell array matching streamline vertices.');
  end
  for k = 1:numel(twistangle)
    values = twistangle{k};
    if ~isnumeric(values) || numel(values) ~= size(vertices{k}, 1)
      error('Nelson:streamribbon:twistAnglesCountMismatch', 'Twist angles must match streamline vertex counts.');
    end
    twistangle{k} = double(values(:));
  end
end
%=============================================================================
function width = validateRibbonWidth(width)
  if isempty(width)
    return
  end
  if ~isnumeric(width) || ~isscalar(width) || ~isfinite(width) || width <= 0
    error('Nelson:graphics:mustBePositiveScalar', '%s must be a positive scalar.', 'Ribbon width');
  end
  width = double(width);
end
%=============================================================================
function width = automaticRibbonWidth(vertices)
  bounds = zeros(0, 6);
  for k = 1:numel(vertices)
    pts = vertices{k};
    if ~isempty(pts)
      bounds(end + 1, :) = [min(pts, [], 1), max(pts, [], 1)];
    end
  end
  if isempty(bounds)
    width = 0.05;
    return
  end
  span = max(bounds(:, 4:6), [], 1) - min(bounds(:, 1:3), [], 1);
  width = 0.05 * max(span);
end
%=============================================================================
function h = ribbonSurfaces(parent, vertices, twistangle, width)
  h = gobjects(0, 1);
  for k = 1:numel(vertices)
    pts = vertices{k};
    if size(pts, 1) > 1
      h(end + 1, 1) = ribbonSurface(parent, pts, twistangle{k}, width);
    end
  end
end
%=============================================================================
function h = ribbonSurface(parent, pts, twistangle, width)
  [X, Y, Z, C] = ribbonCoordinates(pts, twistangle, width);
  h = surface(parent, X, Y, Z, C, 'FaceColor', 'flat', ...
    'EdgeColor', graphicsDefaultEdgeColor());
end
%=============================================================================
function [X, Y, Z, C] = ribbonCoordinates(vertices, twistangle, width)
  radius = width / 2;
  count = size(vertices, 1);
  side = initialRibbonSide(vertices);
  side = side * radius;
  side = rotateGeometry(side, vertices(2, :) - vertices(1, :), twistangle(1));

  X = zeros(count, 2);
  Y = zeros(count, 2);
  Z = zeros(count, 2);
  leftEdge = vertices(1, :) + side;
  rightEdge = vertices(1, :) - side;
  X(1, :) = [leftEdge(1), rightEdge(1)];
  Y(1, :) = [leftEdge(2), rightEdge(2)];
  Z(1, :) = [leftEdge(3), rightEdge(3)];

  for k = 2:count
    direction = vertices(k, :) - vertices(k - 1, :);
    side = nextRibbonSide(side, direction, twistangle(k), radius);
    leftEdge = vertices(k, :) + side;
    rightEdge = vertices(k, :) - side;
    X(k, :) = [leftEdge(1), rightEdge(1)];
    Y(k, :) = [leftEdge(2), rightEdge(2)];
    Z(k, :) = [leftEdge(3), rightEdge(3)];
  end
  twist = cumsum(twistangle(:));
  C = [twist, twist];
end
%=============================================================================
function side = nextRibbonSide(side, direction, angle, radius)
  side = rotateGeometry(side, direction, angle);
  side = crossSimple(crossSimple(direction, side), direction);
  sideLength = norm(side);
  if sideLength > 0
    side = side .* (1 / sideLength);
  end
  side = side * radius;
end
%=============================================================================
function side = initialRibbonSide(vertices)
  direction = vertices(2, :) - vertices(1, :);
  axes = [0 0 1; 1 0 0];
  normal = crossSimple(direction, axes(1, :));
  if ~any(normal)
    normal = crossSimple(direction, axes(2, :));
  end
  side = crossSimple(normal, direction);
  sideLength = norm(side);
  if sideLength > 0
    side = side .* (1 / sideLength);
  end
end
%=============================================================================
function c = crossSimple(a, b)
  c1 = a(2) * b(3) - a(3) * b(2);
  c2 = a(3) * b(1) - a(1) * b(3);
  c3 = a(1) * b(2) - a(2) * b(1);
  c = [c1, c2, c3];
end
%=============================================================================
function out = rotateGeometry(v, axisVector, angle)
  axisNorm = norm(axisVector);
  if axisNorm == 0 || angle == 0
    out = v;
    return
  end
  u = axisVector(:) / axisNorm;
  cosa = cos(angle);
  sina = sin(angle);
  vera = 1 - cosa;
  x = u(1);
  y = u(2);
  z = u(3);
  rotation = [cosa + x ^ 2 * vera, x * y * vera - z * sina, x * z * vera + y * sina; ...
    x * y * vera + z * sina, cosa + y ^ 2 * vera, y * z * vera - x * sina; ...
    x * z * vera - y * sina, y * z * vera + x * sina, cosa + z ^ 2 * vera].';
  out = v * rotation;
end
%=============================================================================
﻿%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
