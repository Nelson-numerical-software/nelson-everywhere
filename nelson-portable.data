      "runtimePath": "modules/graphics/examples/rigid_triple_pendulum.m",
      "sha256": "5e0d9ceee105677ca0a27539c33960ec06fc99cc14b75d762da28e0a9fcb0bd6",
      "included": true,
      "requiredCapabilities": [
        "ode-solvers",
        "plots"
      ],
      "missingCapabilities": [],
      "exclusionReason": ""
    }
  ]
}
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
try
manifestFile = getenv('NELSON_PORTABLE_TEST_MANIFEST');
testRoot = getenv('NELSON_PORTABLE_TEST_ROOT');
junitFile = getenv('NELSON_PORTABLE_JUNIT');

if isempty(manifestFile)
  manifestFile = '/tests/portable/manifest.json';
end
if isempty(testRoot)
  testRoot = '/';
end
if isempty(junitFile)
  junitFile = '/tmp/nelson-portable-junit.xml';
end

if ~isfile(manifestFile)
  error('Nelson:portable:testManifestMissing', ...
    ['Portable test manifest does not exist: ', manifestFile]);
end

manifest = jsondecode(fileread(manifestFile));
previousForceDisplay = getenv('NELSON_TESTS_FORCE_DISPLAY');
cleanupForceDisplay = onCleanup(@() setenv('NELSON_TESTS_FORCE_DISPLAY', previousForceDisplay)); %#ok<NLS0004>
previousResetGraphics = getenv('NELSON_UNITTEST_RESET_GRAPHICS');
cleanupResetGraphics = onCleanup(@() setenv('NELSON_UNITTEST_RESET_GRAPHICS', previousResetGraphics)); %#ok<NLS0004>
if any(strcmp(manifest.capabilities, 'plots'))
  setenv('NELSON_TESTS_FORCE_DISPLAY', '1');
  setenv('NELSON_UNITTEST_RESET_GRAPHICS', '1');
end
testPaths = {};
excludedCount = 0;
for testIndex = 1:length(manifest.tests)
  entry = manifest.tests(testIndex);
  if entry.included
    testPath = [testRoot, '/', entry.runtimePath];
    if ~isfile(testPath)
      error('Nelson:portable:testResourceMissing', ...
        ['Portable test resource does not exist: ', testPath]);
    end
    testPaths{end + 1} = testPath;
  else
    excludedCount = excludedCount + 1;
    if isempty(entry.exclusionReason)
      error('Nelson:portable:unclassifiedTest', ...
        ['Excluded test has no reason: ', entry.module, '/', entry.file]);
    end
  end
end

if isempty(testPaths)
  error('Nelson:portable:noPortableTests', ...
    'The portable test manifest contains no runnable tests.');
end

results = nelson.unittest.run(testPaths, 'Workers', 1, 'StopOnFail', false, ...
  'ExecutionMode', 'inline');
if ~nelson.unittest.report(results, 'Format', 'junit', 'OutputFile', junitFile)
  error('Nelson:portable:junitWriteFailed', 'Could not write the JUnit report.');
end

portableStatus = results.status && results.summary.skipped == 0;
summary = struct('status', portableStatus, ...
  'executed', length(testPaths), ...
  'excluded', excludedCount, ...
  'passed', results.summary.passed, ...
  'failed', results.summary.failed, ...
  'skipped', results.summary.skipped, ...
  'junitFile', junitFile);
disp(['__NELSON_PORTABLE_RESULT_BEGIN__', jsonencode(summary), ...
  '__NELSON_PORTABLE_RESULT_END__']);
disp('__NELSON_PORTABLE_JUNIT_BEGIN__');
disp(fileread(junitFile));
disp('__NELSON_PORTABLE_JUNIT_END__');

clear cleanupResetGraphics
clear cleanupForceDisplay

if ~portableStatus
  error('Nelson:portable:portableTestsFailed', 'Portable unit tests failed.');
end
catch exception
  if exist('cleanupResetGraphics', 'var')
    clear cleanupResetGraphics
  end
  if exist('cleanupForceDisplay', 'var')
    clear cleanupForceDisplay
  end
  disp(exception);
  for stackIndex = 1:length(exception.stack)
    disp(exception.stack(stackIndex));
  end
  rethrow(exception);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
a = inv([1 2; 3 4]);
if abs(a(1, 1) + 2) > 1e-12 || abs(a(2, 2) + 0.5) > 1e-12
  error('Nelson:portable:linearAlgebra', 'Linear algebra smoke test failed.');
end

if isbuiltin('figure')
  f = figure('Visible', 'off');
  surf(peaks(24));
  displayList = __web_display_list__(f);
  close(f);
  if length(displayList) < 100
    error('Nelson:portable:plot', 'Headless plot smoke test failed.');
  end
end

if isbuiltin('__nflow_simulate__')
  d = struct();
  d.blocks = {...
    struct('id', 'one', 'type', 'constant', 'inputs', 0, 'outputs', 1, ...
      'params', struct('Value', 1)), ...
    struct('id', 'sink', 'type', 'scope', 'inputs', 1, 'outputs', 0, ...
      'params', struct())};
  d.connections = {struct('from', 'one', 'to', 'sink', ...
    'fromIndex', 0, 'toIndex', 0)};
  d.sampleTime = 0.1;
  d.duration = 0.2;
  d.variables = struct();
  result = jsondecode(__nflow_simulate__(jsonencode(d)));
  if ~strcmp(result.status, 'done')
    error('Nelson:portable:nflow', 'NFlow smoke test failed.');
  end
end

disp('NELSON_PORTABLE_SMOKE_OK');
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
try
  testFile = [modulepath('string'), '/tests/test_strfind.m'];
  if ~isfile(testFile)
    error('Nelson:portable:testRunResourceMissing', ...
      ['test_run resource does not exist: ', testFile]);
  end

  output = evalc('status = test_run(''string'', ''test_strfind'');');
  if ~status
    error('Nelson:portable:testRunFailed', 'test_run reported a failure.');
  end
  if ~contains(output, '01/01 - test_strfind') || contains(output, '02/')
    error('Nelson:portable:testRunUnexpectedSelection', ...
      'test_run did not execute exactly the requested test.');
  end

  disp(output);
  disp('NELSON_PORTABLE_TEST_RUN_OK');
catch exception
  disp(exception);
  for stackIndex = 1:length(exception.stack)
    disp(exception.stack(stackIndex));
  end
  rethrow(exception);
end
%=============================================================================
