function varargout = db2pow(varargin)
  narginchk(1, 1);
  nargoutchk(0, 1);
  varargout{1} = 10 .^ (varargin{1} / 10);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
