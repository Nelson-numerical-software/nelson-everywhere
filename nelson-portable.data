%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('candexch'), -1);
asserts.isequal(nargout('candexch'), 1);
%=============================================================================
C = [ones(4, 1) (0:3)'];
rlist = candexch(C, 2, 'InitialDesign', C([2 3], :), 'Display', 'off', 'AvoidDuplicates', true);
asserts.isequal(sort(rlist), [1; 4]);
%=============================================================================
rlist = candexch(C, 1, 'FixedRows', [1 -1], 'Display', 'off');
asserts.isequal(rlist, 4);
%=============================================================================
rng(7);
r1 = candexch(C, 2, 'Display', 'off', 'NumTries', 3, 'AvoidDuplicates', true);
rng(7);
r2 = candexch(C, 2, 'Display', 'off', 'NumTries', 3, 'AvoidDuplicates', true);
asserts.isequal(r1, r2);
asserts.isequal(sort(r1), [1; 4]);
%=============================================================================
C2 = [ones(5, 1) (0:4)' ((0:4)') .^ 2];
rlist = candexch(C2, 3, 'Display', 'off', 'AvoidDuplicates', true);
asserts.isequal(size(rlist), [3 1]);
asserts.isequal(length(unique(rlist)), 3);
%=============================================================================
opts = statset('candexch');
asserts.isequal(opts.UseParallel, false);
rlist = candexch(C, 2, 'Display', 'off', 'Options', opts);
asserts.isequal(size(rlist), [2 1]);
%=============================================================================
asserts.checkerror('candexch()', _('Not enough input arguments.'));
asserts.checkerror('candexch([], 2)', sprintf(_('%s must be a nonempty numeric matrix.'), 'C'));
asserts.checkerror('candexch(C, 0)', sprintf(_('%s must be a positive integer scalar.'), 'NROWS'));
asserts.checkerror('candexch(C, 2, ''Display'')', _('Name-value arguments must be paired.'));
asserts.checkerror('candexch(C, 2, ''Unknown'', 1)', _('Invalid name-value argument name.'));
asserts.checkerror('candexch(C, 2, ''Display'', ''bad'')', _('Display must be on or off.'));
asserts.checkerror('candexch(C, 2, ''AvoidDuplicates'', 2)', sprintf(_('%s must be a scalar logical value.'), 'AvoidDuplicates'));
asserts.checkerror('candexch(C, 2, ''MaxIterations'', 0)', sprintf(_('%s must be a positive integer scalar.'), 'MaxIterations'));
asserts.checkerror('candexch(C, 2, ''NumTries'', 0)', sprintf(_('%s must be a positive integer scalar.'), 'NumTries'));
asserts.checkerror('candexch(C, 5, ''AvoidDuplicates'', true)', _('NROWS must not exceed the number of candidate rows when AvoidDuplicates is true.'));
asserts.checkerror('candexch(C, 2, ''InitialDesign'', [1 2 3; 1 2 4])', sprintf(_('%s must have the same number of columns as C.'), 'InitialDesign'));
asserts.checkerror('candexch(C, 2, ''InitialDesign'', C(1, :), ''Display'', ''off'')', _('InitialDesign must have NROWS rows.'));
asserts.checkerror('candexch(C, 2, ''InitialDesign'', [1 10; 1 11], ''Display'', ''off'')', _('InitialDesign rows must be rows from C.'));
asserts.checkerror('candexch(C, 2, ''FixedRows'', [1 2 3])', sprintf(_('%s must have the same number of columns as C.'), 'FixedRows'));
asserts.checkerror('candexch(C, 2, ''Options'', 1)', _('Options must be a structure.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('candgen'), -1);
asserts.isequal(nargout('candgen'), 2);
%=============================================================================
F = candgen(2);
asserts.isequal(F, [-1 -1; 1 -1; -1 1; 1 1]);
[F, C] = candgen(2, 'quadratic');
asserts.isequal(size(F), [4 2]);
asserts.isequal(size(C), [4 5]);
%=============================================================================
[F, C] = candgen(2, 'linear', 'Bounds', [0 1 2; -1 1 1]);
asserts.isequal(size(F), [6 2]);
asserts.isequal(size(C), [6 3]);
asserts.istrue(all(F(:, 1) >= 0));
%=============================================================================
asserts.checkerror('candgen()', _('Not enough input arguments.'));
asserts.checkerror('candgen(0)', sprintf(_('%s must be a positive integer scalar.'), 'NFACTORS'));
asserts.checkerror('candgen(2, ''linear'', ''Bounds'')', _('Name-value arguments must be paired.'));
asserts.checkerror('candgen(2, ''linear'', ''Unknown'', 1)', _('Invalid name-value argument name.'));
asserts.checkerror('candgen(2, ''linear'', ''Bounds'', [0 1])', _('Bounds must have one row per factor.'));
asserts.checkerror('candgen(2, ''linear'', ''Bounds'', [0; 1])', _('Bounds must contain at least two levels per factor.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--WEIGHT 2-->
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('canoncorr'), 2);
asserts.isequal(nargout('canoncorr'), 6);
%=============================================================================
X = [1 2 3; 2 1 5; 3 4 4; 4 3 8; 5 7 6; ...
  6 5 9; 7 8 11; 8 9 10; 9 11 13; 10 10 15];
Y = [3 4; 1 7; 5 5; 2 11; 9 6; 4 12; 10 10; 7 13; 12 9; 8 16];
[A, B, r, U, V, stats] = canoncorr(X, Y);
asserts.isapprox(A, [0.196684315807947 1.284241160268141; ...
  0.071879788440771 -0.966553558900145; ...
  0.043656501201557 -0.169114559908250], 1e-12);
asserts.isapprox(B, [0.180293419017243 -0.213758900644718; ...
  0.161718093723430 0.213109910670694], 1e-12);
asserts.isapprox(r, [0.991234240954053 0.936088581899088], 1e-12);
asserts.isapprox(U(:, 1), [-1.408343681387254; -1.196226151616965; ...
  -0.827558971688260; -0.528128439514858; -0.131237972346938; ...
  0.052656270184136; 0.552292953717511; 0.777200556764673; ...
  1.248613953058833; 1.460731482829122], 1e-12);
asserts.isapprox(V(:, 2), [-0.466829934556053; 0.600017598745465; ...
  -0.681237825174795; 1.238698340783524; -1.323163517082973; ...
  1.024290450164782; -0.684482775044915; 0.596123658901322; ...
  -1.325110487005045; 1.021694490268686], 1e-12);
C = corrcoef([U(:, 1), V(:, 1)]);
asserts.isapprox(C(1, 2), r(1), 1e-12);
asserts.isapprox(stats.Wilks, [0.002159810051532 0.123738166838155], 1e-12);
asserts.isequal(stats.df1, [6 2]);
asserts.isequal(stats.df2, [10 7]);
asserts.isapprox(stats.F, [34.195867136905001 24.785532988199698], 1e-12);
asserts.isapprox(stats.pF, [0.000004206983385 0.000666442787225], 1e-12);
asserts.isapprox(stats.chisq, [36.826410001551764 14.627112525306551], 1e-12);
asserts.isapprox(stats.pChisq, [0.000001903539959 0.000666442787225], 1e-12);
asserts.isequal(stats.dfe, stats.df1);
asserts.isequal(stats.p, stats.pChisq);
%=============================================================================
[A, B, r] = canoncorr(single(X), single(Y));
asserts.isequal(class(A), 'double');
asserts.isapprox(r, [0.991234240954053 0.936088581899088], 1e-12);
asserts.isequal(size(B), [2 2]);
%=============================================================================
Xdep = [1 2 2; 3 4 4; 5 8 8; 7 11 11; 9 13 13];
Ydep = [2 1; 4 2; 6 5; 8 6; 10 8];
evalc('[Adep, Bdep, rdep] = canoncorr(Xdep, Ydep);');
asserts.isequal(size(Adep), [3 2]);
asserts.isequal(size(Bdep), [2 2]);
asserts.isequal(Adep(3, :), [0 0]);
asserts.isapprox(rdep, [1.000000000000000 0.639602149066831], 1e-12);
%=============================================================================
Xconstant = [1 2; 1 2; 1 2];
Yconstant = [3 4; 5 6; 7 8];
evalc('[A0, B0, r0, U0, V0, stats0] = canoncorr(Xconstant, Yconstant);');
asserts.isequal(size(A0), [2 0]);
asserts.isequal(size(B0), [2 0]);
asserts.isequal(size(r0), [1 0]);
asserts.isequal(size(U0), [3 0]);
asserts.isequal(size(V0), [3 0]);
asserts.isequal(size(stats0.Wilks), [1 0]);
%=============================================================================
asserts.checkerror('canoncorr()', _('Not enough input arguments.'));
asserts.checkerror('canoncorr({1}, [1; 2])', sprintf(_('%s must be a real numeric matrix.'), 'X'));
asserts.checkerror('canoncorr([1; 2], {1})', sprintf(_('%s must be a real numeric matrix.'), 'Y'));
asserts.checkerror('canoncorr([1; 2], [1; 2; 3])', sprintf(_('%s must have the same number of rows.'), 'X and Y'));
asserts.checkerror('canoncorr([1], [2])', _('X and Y must contain at least two observations and one variable.'));
asserts.checkerror('canoncorr([1; NaN], [2; 3])', sprintf(_('%s must contain finite values.'), 'X and Y'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('chi2cdf'), 3);
asserts.isequal(nargout('chi2cdf'), 1);
%=============================================================================
x = [0.5 1 2 5];
R = chi2cdf(x, 4);
REF = [0.0264990211607439 0.0902040104310499 ...
       0.264241117657115 0.712702504816354];
asserts.isapprox(R, REF, 1e-12);
R = chi2cdf(x, 4, 'upper');
REF = [0.973500978839256 0.909795989568950 ...
       0.735758882342885 0.287297495183646];
asserts.isapprox(R, REF, 1e-12);
%=============================================================================
x = [0 0.5 1 2 5 10];
v = [1 2 3 4 5 6];
R = chi2cdf(x, v);
REF = [0 0.221199216928595 0.198748043098799 ...
       0.264241117657115 0.584119813004491 0.875347980516914];
asserts.isapprox(R, REF, 1e-12);
%=============================================================================
R = chi2cdf(x, v, 'upper');
REF = [1 0.778800783071405 0.801251956901201 ...
       0.735758882342885 0.415880186995509 0.124652019483081];
asserts.isapprox(R, REF, 1e-12);
%=============================================================================
R = chi2cdf(single(x), single(v));
asserts.isequal(class(R), 'single');
asserts.isapprox(R, single([0 0.221199216928595 0.198748043098799 ...
                           0.264241117657115 0.584119813004491 0.875347980516914]), 1e-6);
%=============================================================================
R = chi2cdf([-1 0 Inf NaN 1], [2 2 2 2 NaN]);
asserts.isequal(R(1), 0);
asserts.isequal(R(2), 0);
asserts.isequal(R(3), 1);
asserts.istrue(isnan(R(4)));
asserts.istrue(isnan(R(5)));
%=============================================================================
R = chi2cdf([], []);
asserts.isequal(size(R), [0 0]);
%=============================================================================
asserts.checkerror('chi2cdf(ones(2), ones(3))', _('Size mismatch on input arguments'));
asserts.checkerror('chi2cdf(1, 2, ''bad'')', sprintf(_('Invalid %s distribution option.'), 'chi-square'));
asserts.checkerror('chi2cdf({1}, 2)', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('chi2cdf(1, {2})', sprintf(_('%s must be real numeric.'), 'V'));
%=============================================================================
asserts.isapprox(chi2cdf(2, 4), 1 - 2 * exp(-1), 1e-12);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('chi2gof'), -2);
asserts.isequal(nargout('chi2gof'), 3);
%=============================================================================
x = norminv(((1:100) - 0.5) / 100);
[h, p, stats] = chi2gof(x);
asserts.isequal(h, false);
asserts.isequal(p, 1);
asserts.istrue(abs(stats.chi2stat) < 1e-8);
asserts.isequal(stats.df, 9);
asserts.isequal(stats.O, 10 * ones(1, 10));
asserts.isapprox(stats.E, 10 * ones(1, 10), 1e-12);
%=============================================================================
[h1, p1, stats1] = chi2gof([1 1 1 2 2 3], ...
  'Edges', [0.5 1.5 2.5 3.5], 'Expected', [2 2 2], 'EMin', 0.1);
asserts.isequal(h1, false);
asserts.isapprox(p1, 0.606530659712633, 1e-12);
asserts.isapprox(stats1.chi2stat, 1, 1e-12);
asserts.isequal(stats1.df, 2);
asserts.isequal(stats1.O, [3 2 1]);
asserts.isequal(stats1.E, [2 2 2]);
%=============================================================================
[h2, p2, stats2] = chi2gof([1 2 3], 'Frequency', [3 2 1], ...
  'Edges', [0.5 1.5 2.5 3.5], 'Expected', [2 2 2], 'EMin', 0.1);
asserts.isequal(h2, false);
asserts.isapprox(p2, 0.606530659712633, 1e-12);
asserts.isapprox(stats2.chi2stat, 1, 1e-12);
asserts.isequal(stats2.O, [3 2 1]);
%=============================================================================
sample = [-2 -1 -0.5 0 0.5 1 2];
[h3, p3, stats3] = chi2gof(sample, 'Edges', [-Inf -1 0 1 Inf], ...
  'CDF', @(z) normcdf(z), 'EMin', 0.1);
asserts.isequal(h3, false);
asserts.isapprox(p3, 0.837419473808862, 1e-12);
asserts.isapprox(stats3.chi2stat, 0.850226893029783, 1e-12);
asserts.isequal(stats3.df, 3);
asserts.isequal(stats3.O, [2 2 2 1]);
%=============================================================================
cdf = [-2 0; -1 0.25; 0 0.5; 1 0.75; 2 1];
[h4, p4, stats4] = chi2gof(sample, 'Edges', [-Inf -1 0 1 Inf], ...
  'CDF', cdf, 'EMin', 0.1);
asserts.isequal(h4, false);
asserts.isapprox(p4, 0.934279075624251, 1e-12);
asserts.isapprox(stats4.chi2stat, 0.428571428571429, 1e-12);
asserts.isequal(stats4.df, 3);
%=============================================================================
[h5, p5, stats5] = chi2gof(single([1 1 2 3 3 3]), 'Ctrs', [1 2 3], ...
  'Expected', [2 2 2], 'EMin', 0.1, 'Alpha', 0.2);
asserts.isequal(h5, false);
asserts.isapprox(p5, 0.606530659712633, 1e-12);
asserts.isapprox(stats5.chi2stat, 1, 1e-12);
asserts.isequal(stats5.df, 2);
%=============================================================================
[h6, p6, stats6] = chi2gof([1 NaN Inf 2 3], 'Frequency', [1 1 1 1 1], ...
  'Edges', [0.5 1.5 2.5 3.5], 'Expected', [1 1 1], 'EMin', 0.1);
asserts.isequal(h6, false);
asserts.isequal(p6, 1);
asserts.isequal(stats6.O, [1 1 1]);
%=============================================================================
asserts.checkerror('chi2gof()', _('Not enough input arguments.'));
asserts.checkerror('chi2gof({1})', sprintf(_('%s must be a real numeric vector.'), 'X'));
asserts.checkerror('chi2gof([NaN Inf])', _('X must contain at least one finite observation.'));
asserts.checkerror('chi2gof([1 2], ''Alpha'', 2)', sprintf(_('%s must be a scalar in the range (0,1).'), 'ALPHA'));
asserts.checkerror('chi2gof([1 2], ''NBins'', 1.5)', sprintf(_('%s must be a positive integer scalar.'), 'NBINS'));
asserts.checkerror('chi2gof([1 2], ''Edges'', [0 1 1])', sprintf(_('%s must be a strictly increasing vector.'), 'EDGES'));
asserts.checkerror('chi2gof([1 2], ''Expected'', [-1 2])', _('EXPECTED must contain nonnegative counts with positive sum.'));
asserts.checkerror('chi2gof([1 2], ''Frequency'', [1 2 3])', sprintf(_('%s must have one value per observation.'), 'FREQUENCY'));
asserts.checkerror('chi2gof([1 2], ''CDF'', [0 0.5 1])', _('CDF must be a two-column matrix or function handle.'));
asserts.checkerror('chi2gof([1 2], ''Unknown'', 1)', _('Invalid name-value argument name.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('chi2inv'), 2);
asserts.isequal(nargout('chi2inv'), 1);
%=============================================================================
p = [0.025 0.5 0.975];
R = chi2inv(p, 4);
REF = [0.484418557087930 3.35669398003332 11.1432867818778];
asserts.isapprox(R, REF, 1e-11);
%=============================================================================
p = [0 0.001 0.025 0.5 0.975 1];
v = [1 2 3 4 5 6];
R = chi2inv(p, v);
REF = [0 0.00200100066716707 0.215795282623898 ...
       3.35669398003332 12.8325019940302 Inf];
asserts.isapprox(R(1:5), REF(1:5), 1e-11);
asserts.istrue(isinf(R(6)) && R(6) > 0);
%=============================================================================
R = chi2inv(single([0.025 0.5 0.975]), single([1 2 3]));
asserts.isequal(class(R), 'single');
asserts.isapprox(R, single([0.000982069117175255 1.38629436111989 9.34840360449615]), 1e-5);
%=============================================================================
R = chi2inv([-0.1 1.1 NaN 0 1], 2);
asserts.istrue(all(isnan(R(1:3))));
asserts.isequal(R(4), 0);
asserts.istrue(isinf(R(5)) && R(5) > 0);
%=============================================================================
R = chi2inv([], []);
asserts.isequal(size(R), [0 0]);
%=============================================================================
asserts.checkerror('chi2inv(ones(2), ones(3))', _('Size mismatch on input arguments'));
asserts.checkerror('chi2inv({0.5}, 2)', sprintf(_('%s must be real numeric.'), 'P'));
asserts.checkerror('chi2inv(0.5, {2})', sprintf(_('%s must be real numeric.'), 'V'));
%=============================================================================
asserts.isapprox(chi2inv(chi2cdf(2, 4), 4), 2, 1e-12);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('chi2pdf'), 2);
asserts.isequal(nargout('chi2pdf'), 1);
%=============================================================================
x = [0.5 1 2 5];
R = chi2pdf(x, 4);
REF = [0.0973500978839256 0.151632664928158 ...
       0.183939720585721 0.102606248279874];
asserts.isapprox(R, REF, 1e-12);
%=============================================================================
x = [0 0.5 1 2 5 10];
v = [1 2 3 4 5 6];
R = chi2pdf(x, v);
REF = [Inf 0.389400391535702 0.241970724519143 ...
       0.183939720585721 0.122041521349387 0.0421121687442842];
asserts.isapprox(R, REF, 1e-12);
%=============================================================================
R = chi2pdf(single(x), single(v));
asserts.isequal(class(R), 'single');
asserts.isapprox(R, single(REF), 1e-6);
%=============================================================================
R = chi2pdf([-1 0 0 Inf NaN 1], [2 1 2 2 2 NaN]);
asserts.isequal(R(1), 0);
asserts.istrue(isinf(R(2)) && R(2) > 0);
asserts.isequal(R(3), 0.5);
asserts.isequal(R(4), 0);
asserts.istrue(isnan(R(5)));
asserts.istrue(isnan(R(6)));
%=============================================================================
R = chi2pdf([], []);
asserts.isequal(size(R), [0 0]);
%=============================================================================
asserts.checkerror('chi2pdf(ones(2), ones(3))', _('Size mismatch on input arguments'));
asserts.checkerror('chi2pdf({1}, 2)', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('chi2pdf(1, {2})', sprintf(_('%s must be real numeric.'), 'V'));
%=============================================================================
asserts.isapprox(chi2pdf(2, 4), exp(-1) / 2, 1e-12);
asserts.istrue(isnan(chi2pdf(1, -1)));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('chi2rnd'), -1);
asserts.isequal(nargout('chi2rnd'), 1);
%=============================================================================
rng(0);
R = chi2rnd(4, 2, 3);
REF = [6.191782680520468 1.230732934682247 4.294289187503583;
       7.929155514899250 8.138797937569517 1.047824422781352];
asserts.isapprox(R, REF, 1e-13);
%=============================================================================
rng(0);
U = rand(2, 3);
E = chi2inv(U, 4);
rng(0);
R = chi2rnd(4, 2, 3);
asserts.isequal(size(R), [2 3]);
asserts.isapprox(R, E, 1e-12);
%=============================================================================
rng(0);
U = rand(1, 3);
E = chi2inv(U, [1 2 3]);
rng(0);
R = chi2rnd([1 2 3]);
asserts.isapprox(R, E, 1e-12);
%=============================================================================
rng(0);
R = chi2rnd(single(4), [2 3]);
asserts.isequal(class(R), 'single');
asserts.isequal(size(R), [2 3]);
R = chi2rnd(4, single([2 3]));
asserts.isequal(class(R), 'double');
asserts.isequal(size(R), [2 3]);
%=============================================================================
R = chi2rnd([0 -1 NaN], [1 3]);
asserts.istrue(all(isnan(R)));
R = chi2rnd(4, 0, 3);
asserts.isequal(size(R), [0 3]);
R = chi2rnd(single(4), [2 0 3]);
asserts.isequal(class(R), 'single');
asserts.isequal(size(R), [2 0 3]);
%=============================================================================
asserts.checkerror('chi2rnd([1 2], 2, 2)', _('Size mismatch on input arguments'));
asserts.checkerror('chi2rnd(1, 1.5, 2)', _('Size must contain integer values.'));
asserts.checkerror('chi2rnd({1})', sprintf(_('%s must be real numeric.'), 'V'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('chi2stat'), 1);
asserts.isequal(nargout('chi2stat'), 2);
%=============================================================================
[m, v] = chi2stat([1 2 3 Inf]);
asserts.isapprox(m(1:3), [1 2 3], 1e-15);
asserts.isapprox(v(1:3), [2 4 6], 1e-15);
asserts.istrue(isinf(m(4)) && isinf(v(4)));
%=============================================================================
[m, v] = chi2stat(single([1 2]));
asserts.isequal(class(m), 'single');
asserts.isequal(class(v), 'single');
asserts.isapprox(double(m), [1 2], 1e-7);
asserts.isapprox(double(v), [2 4], 1e-6);
%=============================================================================
[m, v] = chi2stat([0 -1 NaN]);
asserts.istrue(all(isnan(m)));
asserts.istrue(all(isnan(v)));
%=============================================================================
[m, v] = chi2stat([]);
asserts.isequal(size(m), [0 0]);
asserts.isequal(size(v), [0 0]);
%=============================================================================
asserts.checkerror('chi2stat({1})', sprintf(_('%s must be real numeric.'), 'V'));
%=============================================================================
[chiMean, chiVariance] = chi2stat(4);
asserts.isequal(chiMean, 4);
asserts.isequal(chiVariance, 8);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('cluster'), -1);
asserts.isequal(nargout('cluster'), 1);
%=============================================================================
X = [0 0; 1 0; 0 2; 4 4];
Z = linkage(X);
T = cluster(Z, 'MaxClust', 2);
asserts.isequal(T, [1; 1; 1; 2]);
%=============================================================================
T = cluster(Z, 'MaxClust', [1 2 3]);
asserts.isequal(T, [1 1 1; 1 1 1; 1 1 2; 1 2 3]);
%=============================================================================
T = cluster(Z, 'Cutoff', 2, 'Criterion', 'distance');
asserts.isequal(T, [1; 1; 1; 2]);
%=============================================================================
T = cluster(Z, 'Cutoff', [0.5 2 10], 'Criterion', 'distance');
asserts.isequal(T, [1 1 1; 2 1 1; 3 1 1; 4 2 1]);
%=============================================================================
asserts.checkerror('cluster()', _('Not enough input arguments.'));
asserts.checkerror('cluster([1 2; 3 4], ''MaxClust'', 2)', _('Z must have three columns.'));
asserts.checkerror('cluster(Z, ''MaxClust'')', _('Not enough input arguments.'));
asserts.checkerror('cluster(Z, ''Unknown'', 2)', _('Invalid option name.'));
asserts.checkerror('cluster(Z, ''Criterion'', ''bad'', ''MaxClust'', 2)', _('Criterion must be ''distance''.'));
asserts.checkerror('cluster(Z, ''MaxClust'', 2, ''Cutoff'', 1)', _('Specify either Cutoff or MaxClust.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('clusterdata'), -1);
asserts.isequal(nargout('clusterdata'), 1);
%=============================================================================
X = [0 0; 1 0; 0 2; 4 4];
T = clusterdata(X, 'MaxClust', 2);
asserts.isequal(T, [1; 1; 1; 2]);
%=============================================================================
T = clusterdata(X, 'Cutoff', 2, 'Criterion', 'distance');
asserts.isequal(T, [1; 1; 1; 2]);
%=============================================================================
T = clusterdata(X, 'MaxClust', [1 2 3]);
asserts.isequal(T, [1 1 1; 1 1 1; 1 1 2; 1 2 3]);
%=============================================================================
T = clusterdata(X, 'Cutoff', [0.5 2 10], 'Criterion', 'd');
asserts.isequal(T, [1 1 1; 2 1 1; 3 1 1; 4 2 1]);
%=============================================================================
T = clusterdata(X, 'MaxClust', 2, 'Linkage', 'complete');
asserts.isequal(T, [1; 1; 1; 2]);
%=============================================================================
T = clusterdata(X, 'MaxClust', 2, 'Distance', 'cityblock');
asserts.isequal(T, [1; 1; 1; 2]);
%=============================================================================
T = clusterdata(X, 'MaxClust', 2, 'Distance', 'minkowski', 'P', 1.5);
asserts.isequal(T, [1; 1; 1; 2]);
%=============================================================================
T = clusterdata(X, 'MaxClust', 2, 'SaveMemory', 'on', 'Depth', 2);
asserts.isequal(T, [1; 1; 1; 2]);
%=============================================================================
T = clusterdata([0; 1; 10; 11], 'MaxClust', 2);
asserts.isequal(T, [1; 1; 2; 2]);
%=============================================================================
X = [0 0; 0 1; 5 5; 6 5; 9 0];
T = clusterdata(X, 'MaxClust', 3, 'Linkage', 'average');
asserts.isequal(T, [1; 1; 2; 2; 3]);
%=============================================================================
asserts.checkerror('clusterdata()', _('Not enough input arguments.'));
asserts.checkerror('clusterdata({1}, ''MaxClust'', 2)', _('X must be a numeric matrix with at least two rows.'));
asserts.checkerror('clusterdata([1 2], ''MaxClust'', 2)', _('X must be a numeric matrix with at least two rows.'));
asserts.checkerror('clusterdata(ones(2, 2, 2), ''MaxClust'', 2)', _('X must be a numeric matrix with at least two rows.'));
asserts.checkerror('clusterdata(X, ''MaxClust'')', _('Not enough input arguments.'));
asserts.checkerror('clusterdata(X, ''MaxClust'', 2, ''Cutoff'', 1)', _('Specify either Cutoff or MaxClust.'));
asserts.checkerror('clusterdata(X, ''Unknown'', 1, ''MaxClust'', 2)', _('Invalid name-value argument name.'));
asserts.checkerror('clusterdata(X, '''', 1, ''MaxClust'', 2)', _('Invalid name-value argument name.'));
asserts.checkerror('clusterdata(X, ''C'', 1, ''MaxClust'', 2)', _('Ambiguous name-value argument name.'));
asserts.checkerror('clusterdata(X, ''Criterion'', ''bad'', ''MaxClust'', 2)', _('Criterion must be ''distance''.'));
asserts.checkerror('clusterdata(X, ''Criterion'', '''', ''MaxClust'', 2)', _('Criterion must be ''distance''.'));
asserts.checkerror('clusterdata(X, ''SaveMemory'', ''bad'', ''MaxClust'', 2)', _('SaveMemory must be ''on'' or ''off''.'));
asserts.checkerror('clusterdata(X, ''SaveMemory'', '''', ''MaxClust'', 2)', _('SaveMemory must be ''on'' or ''off''.'));
asserts.checkerror('clusterdata(X, ''Distance'', ''minkowski'', ''P'', 0, ''MaxClust'', 2)', sprintf(_('%s must be a positive scalar.'), 'P'));
asserts.checkerror('clusterdata(X, ''MaxClust'', [])', sprintf(_('%s must be numeric.'), 'MaxClust'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('cmdscale'), 2);
asserts.isequal(nargout('cmdscale'), 2);
%=============================================================================
X = [0 0; 1 0; 0 2; 2 2];
D = squareform(pdist(X));
[Y, e] = cmdscale(D);
asserts.isapprox(Y, [-1.238218880541527 0.171213328542167; ...
  -0.753450348148581 -0.703429152704650; ...
  0.511066081952108 1.140750393328058; ...
  1.480603146737999 -0.608534569165577], 1e-12);
asserts.isapprox(e, [4.554247641507077; 2.195752358492924; ...
  0.000000000000000; -0.000000000000000], 1e-12);
asserts.isapprox(pdist(Y), pdist(X), 1e-12);
asserts.istrue(max(abs(mean(Y, 1))) < 1e-12);
asserts.isequal(size(Y), [4 2]);
asserts.isapprox(sum(e(1:2)), 6.750000000000001, 1e-12);
%=============================================================================
[Y1, e1] = cmdscale(D, 1);
asserts.isapprox(Y1, [-1.238218880541527; -0.753450348148581; ...
  0.511066081952108; 1.480603146737999], 1e-12);
asserts.isapprox(e1, 4.554247641507077, 1e-12);
%=============================================================================
[Y3, e3] = cmdscale(D, 3);
asserts.isequal(size(Y3), [4 2]);
asserts.isapprox(Y3, Y, 1e-12);
asserts.isapprox(e3, [4.554247641507077; 2.195752358492924; ...
  0.000000000000000], 1e-12);
%=============================================================================
[Yv, ev] = cmdscale(pdist(X));
asserts.isapprox(Yv, Y, 1e-12);
asserts.isapprox(ev, e, 1e-12);
%=============================================================================
U = triu(D);
[Yu, eu] = cmdscale(U);
asserts.isapprox(Yu, Y, 1e-12);
asserts.isapprox(eu, e, 1e-12);
%=============================================================================
S = 1 - D .^ 2 / 10;
S(1:size(S, 1) + 1:end) = 1;
[Ys, es] = cmdscale(S);
asserts.isapprox(Ys, Y / sqrt(10), 1e-12);
asserts.isapprox(es, e / 10, 1e-12);
%=============================================================================
[Y0, e0] = cmdscale(0);
asserts.isequal(size(Y0), [1 0]);
asserts.isequal(e0, 0);
%=============================================================================
asserts.checkerror('cmdscale()', _('Not enough input arguments.'));
asserts.checkerror('cmdscale({1})', sprintf(_('%s must be a real numeric vector or matrix.'), 'D'));
asserts.checkerror('cmdscale([0 1; 1 NaN])', sprintf(_('%s must contain finite values.'), 'D'));
asserts.checkerror('cmdscale([0 1 2; 1 0 3])', _('D must be square or a valid distance vector.'));
asserts.checkerror('cmdscale([0 1; 2 0])', _('D must be symmetric or upper triangular.'));
asserts.checkerror('cmdscale([0 -1; -1 0])', _('D must contain nonnegative dissimilarities.'));
asserts.checkerror('cmdscale(D, 0)', _('p must be an integer scalar between 1 and the number of points.'));
asserts.checkerror('cmdscale(D, 5)', _('p must be an integer scalar between 1 and the number of points.'));
asserts.checkerror('cmdscale(D, 1.5)', _('p must be an integer scalar between 1 and the number of points.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('cordexch'), -1);
asserts.isequal(nargout('cordexch'), 2);
%=============================================================================
rng(7);
[dCE, X] = cordexch(2, 3, 'linear', 'Display', 'off', 'AvoidDuplicates', true);
asserts.isequal(size(dCE), [3 2]);
asserts.isequal(size(X), [3 3]);
asserts.isequal(length(unique(dCE, 'rows')), 3);
%=============================================================================
asserts.checkerror('cordexch()', _('Not enough input arguments.'));
asserts.checkerror('cordexch(0, 3)', sprintf(_('%s must be a positive integer scalar.'), 'NFACTORS'));
asserts.checkerror('cordexch(2, 0)', sprintf(_('%s must be a positive integer scalar.'), 'NRUNS'));
asserts.checkerror('cordexch(2, 3, ''linear'', ''Display'')', _('Name-value arguments must be paired.'));
asserts.checkerror('cordexch(2, 3, ''linear'', ''Unknown'', 1)', _('Invalid name-value argument name.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('corr'), -2);
asserts.isequal(nargout('corr'), 2);
%=============================================================================
X = [1 2 3; 2 4 1; 3 NaN 2; 4 8 4; 5 10 5];
R = corr(X);
REF = [1 NaN 0.7; NaN NaN NaN; 0.7 NaN 1];
asserts.isapprox(R, REF, 1e-12);
%=============================================================================
R = corr(X, 'Rows', 'pairwise');
REF = [1 1 0.7; 1 1 0.748331477354788; 0.7 0.748331477354788 1];
asserts.isapprox(R, REF, 1e-12);
%=============================================================================
R = corr(X, 'Rows', 'complete');
REF = [1 1 0.748331477354788; 1 1 0.748331477354788; ...
       0.748331477354788 0.748331477354788 1];
asserts.isapprox(R, REF, 1e-12);
%=============================================================================
R = corr(X, 'Type', 'Spearman', 'Rows', 'pairwise');
REF = [1 0.989949493661166 0.7; 0.989949493661166 1 0.680336051416609; ...
       0.7 0.680336051416609 1];
asserts.isapprox(R, REF, 1e-12);
%=============================================================================
R = corr(X, 'Type', 'Kendall', 'Rows', 'pairwise');
REF = [1 1 0.6; 1 1 0.666666666666667; 0.6 0.666666666666667 1];
asserts.isapprox(R, REF, 1e-12);
%=============================================================================
Y = [5 1; 4 2; 3 3; 2 4; 1 5];
[R, P] = corr(X(:, [1 3]), Y, 'Tail', 'right');
asserts.isapprox(R, [-1 1; -0.7 0.7], 1e-12);
asserts.isapprox(P, [1 0; 0.905939797812906 0.094060202187094], 1e-12);
[R, P] = corr(X(:, [1 3]), Y, 'Tail', 'left');
asserts.isapprox(R, [-1 1; -0.7 0.7], 1e-12);
asserts.isapprox(P, [0 1; 0.094060202187094 0.905939797812906], 1e-12);
%=============================================================================
[R, P] = corr(X(:, [1 3]), Y, 'Weights', [1 2 3 4 5]);
asserts.isapprox(R, [-1 1; -0.857492925712544 0.857492925712544], 1e-12);
asserts.istrue(all(isnan(P(:))));
%=============================================================================
asserts.isequal(corr([1 2 3]), NaN(3, 3));
asserts.istrue(isempty(corr([])));
asserts.isequal(corr(zeros(0, 3)), NaN(3, 3));
asserts.isequal(class(corr(single([1; 2; 3]), single([3; 2; 1]))), 'double');
%=============================================================================
asserts.checkerror('corr()', _('Not enough input arguments.'));
asserts.checkerror('corr({1})', sprintf(_('%s must be a real numeric matrix.'), 'X'));
asserts.checkerror('corr([1; 2], {1})', sprintf(_('%s must be a real numeric matrix.'), 'Y'));
asserts.checkerror('corr([1; 2], [1 2])', sprintf(_('%s must have the same number of rows.'), 'X and Y'));
asserts.checkerror('corr([1; 2], ''Type'', ''bad'')', sprintf(_('%s has an unsupported value.'), 'TYPE'));
asserts.checkerror('corr([1; 2], ''Rows'', ''bad'')', sprintf(_('%s has an unsupported value.'), 'ROWS'));
asserts.checkerror('corr([1; 2], ''Tail'', ''bad'')', sprintf(_('%s has an unsupported value.'), 'TAIL'));
asserts.checkerror('corr([1; 2], ''Weights'', [1 -1])', sprintf(_('%s must contain nonnegative finite values.'), 'Weights'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('corrcoef'), 1);
asserts.isequal(nargout('corrcoef'), 1);
%=============================================================================
R = corrcoef(magic(4));
REF = [1.0000 -0.9776 -0.9069 0.7978;
  -0.9776 1.0000 0.9753 -0.9069;
  -0.9069 0.9753 1.0000 -0.9776;
  0.7978 -0.9069 -0.9776 1.0000];
asserts.isapprox(R, REF, 1e-4);
%=============================================================================
R = corrcoef(magic(4) + 2i);
REF = [1.0000 -0.9776 -0.9069 0.7978;
  -0.9776 1.0000 0.9753 -0.9069;
  -0.9069 0.9753 1.0000 -0.9776;
  0.7978 -0.9069 -0.9776 1.0000];
asserts.isapprox(R, REF, 1e-4);
%=============================================================================
R = corrcoef(single(magic(4)));
REF = [1.0000 -0.9776 -0.9069 0.7978;
  -0.9776 1.0000 0.9753 -0.9069;
  -0.9069 0.9753 1.0000 -0.9776;
  0.7978 -0.9069 -0.9776 1.0000];
asserts.isapprox(R, single(REF), 1e-4);
%=============================================================================
R = corrcoef([]);
asserts.istrue(isnan(R));
%=============================================================================
R = corrcoef(zeros(0, 3));
REF = zeros(3, 3) * NaN;
asserts.isequal(R, REF);
%=============================================================================
R = corrcoef(1);
REF = NaN;
asserts.isequal(R, REF);
%=============================================================================
R = corrcoef([1, 2, 3]);
asserts.istrue(R == 1 || R == 0);
%=============================================================================
asserts.checkerror('R = corrcoef(ones(3,4,3));', _('Inputs must be 2-D.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% corrcoef(x, y) concatenates x(:) and y(:) as two columns
asserts.isapprox(corrcoef([1 2 3], [2 4 6]), ones(2, 2), 1e-12);
asserts.isapprox(corrcoef([1 2 3], [6 4 2]), [1 -1; -1 1], 1e-12);
R1 = corrcoef([1 2 4 8], [1 3 2 9]);
R2 = corrcoef([[1; 2; 4; 8], [1; 3; 2; 9]]);
asserts.isapprox(R1, R2, 1e-12);
% column/row mix
asserts.isapprox(corrcoef([1; 2; 3], [6 4 2]), [1 -1; -1 1], 1e-12);
%=============================================================================
% one argument form still works
asserts.isapprox(corrcoef([1 2; 2 4; 3 6]), ones(2, 2), 1e-12);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('cov'), -1);
asserts.isequal(nargout('cov'), 1);
%=============================================================================
R = cov([]);
REF = NaN;
asserts.isequal(R, REF);
%=============================================================================
R = cov([1:5]);
REF = 2.5;
asserts.isapprox(R, REF, 1e-4);
%=============================================================================
R = cov([5 0 3 7; 1 -5 7 3; 4 9 8 10]);
REF = [4.3333 8.8333 -3.0000 5.6667;
  8.8333 50.3333 6.5000 24.1667;
  -3.0000 6.5000 7.0000 1.0000;
  5.6667 24.1667 1.0000 12.3333];
asserts.isapprox(R, REF, 1e-4);
%=============================================================================
R = cov([3 6 4], [7 12 -9]);
REF = [2.3333 6.8333;
  6.8333 120.3333];
asserts.isapprox(R, REF, 1e-4);
%=============================================================================
R = cov([2 0 -9; 3 4 1], [5 2 6; -4 4 9]);
REF = [22.1667 -6.9333;
  -6.9333 19.4667];
asserts.isapprox(R, REF, 1e-4);
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('crosstab'), -1);
asserts.isequal(nargout('crosstab'), -1);
%=============================================================================
[tbl, chi2, p, labels] = crosstab([1 1 1 2 2 2], {'a', 'a', 'b', 'b', 'b', 'b'});
asserts.isequal(tbl, [2 1; 0 3]);
asserts.isequal(chi2, 3);
asserts.isapprox(p, 0.083264516663550, 1e-14);
asserts.isequal(labels, {'1', 'a'; '2', 'b'});
%=============================================================================
tbl = crosstab([1 1 2 2], {'a', 'b', 'a', 'b'}, ["x", "x", "y", "y"]);
asserts.isequal(tbl(:, :, 1), [1 1; 0 0]);
asserts.isequal(tbl(:, :, 2), [0 0; 1 1]);
%=============================================================================
[tbl, ~, ~, labels] = crosstab([1 NaN 2], {'a', 'a', 'b'});
asserts.isequal(tbl, [1 0; 0 1]);
asserts.isequal(labels, {'1', 'a'; '2', 'b'});
%=============================================================================
[tbl, ~, ~, labels] = crosstab([1 NaN 2], {'a', 'a', 'b'}, 'IncludeMissingGroups', true);
asserts.isequal(tbl, [1 0; 0 1; 1 0]);
asserts.isequal(labels(1:3, 1), {'1'; '2'; 'NaN'});
%=============================================================================
T = table([1; 1; 2], {'a'; 'b'; 'a'}, 'VariableNames', {'G1', 'G2'});
[tbl, ~, ~, labels] = crosstab(T);
asserts.isequal(tbl, [1 1; 1 0]);
asserts.isequal(labels, {'1', 'a'; '2', 'b'});
%=============================================================================
S = crosstab([1 1 2], {'a', 'b', 'a'}, 'OutputFormat', 'stacked-table');
asserts.istrue(istable(S));
asserts.isequal(S.Count, [1; 1; 1; 0]);
%=============================================================================
[tblStable, ~, ~, labelsStable] = crosstab({'Male'; 'Male'; 'Female'}, [1; 2; 1]);
asserts.isequal(tblStable, [1 1; 1 0]);
asserts.isequal(labelsStable(1:2, 1), {'Male'; 'Female'});
%=============================================================================
asserts.checkerror('crosstab()', _('Not enough input arguments.'));
asserts.checkerror('crosstab([1 2], [1 2 3])', _('All grouping variables must have the same number of elements.'));
asserts.checkerror('crosstab({1, 2}, [1 2])', _('Grouping variables must be vectors or text arrays.'));
asserts.checkerror('crosstab([1 2], [1 2], ''OutputFormat'', ''bad'')', sprintf(_('Unsupported %s.'), 'output format'));
%=============================================================================
%=============================================================================
