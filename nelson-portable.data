%=============================================================================
function varargout = sphere(varargin)
  narginchk(0, 2);
  nargoutchk(0, 3);
  n = 20;
  if nargin == 0
    ax = [];
  else
    if nargin == 1
      v = varargin{1};
      if isgraphics(v)
        ax = v;
      else
        ax = [];
        n = v;
      end
    else
      ax = varargin{1};
      n = varargin{2};
    end
  end
  phi = (-n:2:n)' / n * pi / 2;
  theta = (-n:2:n) / n * pi;
  cosphi = cos(phi);
  cosphi(n + 1) = 0;
  cosphi(1) = 0;
  sintheta = sin(theta);
  sintheta(n + 1) = 0;
  sintheta(1) = 0;

  x = cosphi * cos(theta);
  y = cosphi * sintheta;
  z = sin(phi) * ones(1, n + 1);

  if nargout == 0
    ax = newplot(ax);
    surf(x, y, z, 'Parent', ax);
  else
    varargout{1} = x;
    varargout{2} = y;
    varargout{3} = z;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function spy(varargin)
  narginchk(0, 3);

  cax = newplot();
  next = lower(cax.NextPlot);
  holdState = ishold();

  % The matrix is read before the style: spy() takes no target, so an axes
  % handed as the leading argument is a first argument that is not a matrix,
  % and that is what the diagnostic has to name. Reading the style first blames
  % the sample sitting behind it instead.
  S = spyMatrix(varargin);
  [m, n] = size(S);
  [i, j] = spyLocations(S);
  [marker, color, markersize] = parseSpyStyle(varargin, cax);
  markersize = spyMarkerSize(markersize, marker, m, n);
  if isempty(S)
    marker = 'none';
  end

  % The marker is handed over, not just parsed: dropped here, every plot comes
  % out wearing the default marker of the primitive spy() happens to draw with.
  % No 'filled': it hands the marker edge to 'none', and '.', '*', '+' and 'x'
  % are stroked shapes with no face to fall back on, so they would come out
  % blank. Left alone, scatter() already draws the edge-coloured, face-less
  % marker the reference implementation draws.
  % A marker size is a LENGTH, and scatter() sizes its markers by AREA.
  scatter(j, i, markersize ^ 2, color, 'Marker', marker);
  xlabel(['nz = ', int2str(nnz(S))]);
  applySpyAxes(gca(), m, n);

  if ~holdState
    cax.NextPlot = next;
  end
end
%=============================================================================
function [marker, color, markersize] = parseSpyStyle(args, cax)
  marker = '';
  color = '';
  markersize = 0;

  for k = min(numel(args), 3):-1:2
    value = args{k};
    if ischar(value) || isStringScalar(value)
      [~, color, marker, msg] = colstyle(value, 'plot');
      if ~isempty(msg)
        error('Nelson:spy:invalidLineSpec', msg.message);
      end
    else
      markersize = spyValidatedMarkerSize(value);
    end
  end

  if isempty(marker)
    marker = '.';
  end
  if isempty(color)
    co = cax.ColorOrder;
    color = co(1, :);
  end
end
%=============================================================================
function S = spyMatrix(args)
  if isempty(args)
    S = demo();
  else
    S = args{1};
  end
  if ~(isnumeric(S) || islogical(S))
    error('Nelson:spy:invalidMatrix', ...
      'First argument must be a numeric or logical matrix.');
  end
end
%=============================================================================
function markersize = spyValidatedMarkerSize(value)
  % 0 is the caller asking for the size to be worked out from the matrix.
  if ~(isnumeric(value) && isscalar(value) && isreal(value) && isfinite(value) ...
    && value >= 0)
    error('Nelson:spy:invalidMarkerSize', ...
      'MarkerSize must be a finite nonnegative numeric scalar.');
  end
  markersize = double(value);
end
%=============================================================================
function markersize = spyMarkerSize(markersize, marker, m, n)
  if (markersize == 0) && ~strcmp(marker, '.')
    markersize = 6;
  end
  if (markersize == 0)
    ax = gca();
    units = ax.Units;
    ax.Units = 'normalized';
    pos = ax.Position;
    pos(1) = pos(1) * 420;
    pos(2) = pos(2) * 315;
    pos(3) = pos(3) * 420;
    pos(4) = pos(4) * 315;
    markersize = max(4, min(14, round(6 * min(pos(3:4)) / max(m + 1, n + 1))));
    ax.Units = units;
  end
end
%=============================================================================
function [i, j] = spyLocations(S)
  if issparse(S)
    [i, j] = IJV(S);
  else
    [i, j] = find(S);
  end

  if isempty(i)
    i = NaN;
    j = NaN;
  end
end
%=============================================================================
function applySpyAxes(ax, m, n)
  ax.XLim = [0, n + 1];
  ax.YLim = [0, m + 1];
  ax.YDir = 'reverse';
  ax.PlotBoxAspectRatio = [n + 1, m + 1, 1];
end
