function value = getabstime(obj)
  if isempty(obj.TimeInfo.StartDate)
    value = obj.Time;
    return
  end
  serial = datenum(obj.TimeInfo.StartDate) + obj.Time(:) .* timeseriesUnitDays(obj.TimeInfo.Units);
  value = cellstr(datestr(serial));
end
