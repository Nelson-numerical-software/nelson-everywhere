% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function sos = tf2sos(varargin)
  narginchk(2, 2);
  nargoutchk(0, 1);
  [z, p, k] = tf2zp(varargin{1}, varargin{2});
  sos = zp2sos(z, p, k);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = tf2zp(varargin)
  narginchk(2, 2);
  nargoutchk(0, 3);
  b = varargin{1};
  a = varargin{2};
  if ~isvector(a)
    error('Nelson:validators:mustBeVector', '%s must be a vector.', 'Second argument');
  end
  if isvector(b)
    b = b(:).';
  end
  zerosArray = [];
  gain = zeros(size(b, 1), 1);
  for row = 1:size(b, 1)
    numerator = signalTrimLeadingZeros(b(row, :));
    if isempty(numerator)
      gain(row) = 0;
      z = [];
    else
      gain(row) = numerator(1) / a(1);
      z = roots(numerator);
    end
    if row == 1
      zerosArray = zeros(length(z), size(b, 1));
    end
    if length(z) < size(zerosArray, 1)
      z = [z; zeros(size(zerosArray, 1) - length(z), 1)];
    end
    zerosArray(:, row) = z;
  end
  varargout{1} = zerosArray;
  if nargout > 1
    varargout{2} = roots(a);
  end
  if nargout > 2
    varargout{3} = gain;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = tfe(u, y, nfft, fs)
  arguments
    u {mustBeNumeric, mustBeVector}
    y {mustBeNumeric, mustBeVector}
    nfft {mustBeNumeric} = []
    fs {mustBeNumeric} = []
  end
  % Transfer function estimate compatibility wrapper.
  % [Hv, f, Puu, Pyy, Puy, coh, Sv] = tfe(u, y, nfft, fs)

  nargoutchk(0, 7);

  u = u(:);
  y = y(:);
  if length(u) ~= length(y)
    error('Nelson:dimagree:valueLength', '%s must have the same length.', 'Input signals');
  end

  n = length(u);
  if isempty(nfft)
    nfft = min(256, n);
  end
  if isempty(fs)
    fs = 2;
  end

  window = localHanning(nfft);
  noverlap = 0;
  nwind = length(window);
  if n < nwind
    u(nwind) = 0;
    y(nwind) = 0;
    n = nwind;
  end

  nwindows = fix((n - noverlap) / (nwind - noverlap));

  Puu = zeros(nfft, 1);
  Pyy = zeros(nfft, 1);
  Puy = zeros(nfft, 1);
  idx = 1:nwind;
  for w = 1:nwindows
    uw = window .* u(idx);
    yw = window .* y(idx);
    idx = idx + (nwind - noverlap);
    U = fft(uw, nfft);
    Y = fft(yw, nfft);
    Puu = Puu + abs(U) .^ 2;
    Pyy = Pyy + abs(Y) .^ 2;
    Puy = Puy + Y .* conj(U);
  end

  if isreal(u) && isreal(y)
    if rem(nfft, 2)
      select = (1:(nfft + 1) / 2)';
    else
      select = (1:nfft / 2 + 1)';
    end
    Puu = Puu(select);
    Pyy = Pyy(select);
    Puy = Puy(select);
  else
    select = (1:nfft)';
  end

  Hv = Puy ./ Puu;
  f = (select - 1) * fs / nfft;

  if nargout == 0
    plot(f, abs(Hv));
    return
  end

  varargout{1} = Hv;
  if nargout > 1
    varargout{2} = f;
  end
  if nargout > 2
    varargout{3} = Puu;
  end
  if nargout > 3
    varargout{4} = Pyy;
  end
  if nargout > 4
    varargout{5} = Puy;
  end
  if nargout > 5
    varargout{6} = (abs(Puy) .^ 2) ./ (Puu .* Pyy);
  end
  if nargout > 6
    varargout{7} = abs(Hv) ./ sqrt(max(1, nwindows));
  end
end
%=============================================================================
function window = localHanning(nfft)
  window = 0.5 * (1 - cos(2 * pi * (1:nfft)' / (nfft + 1)));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = tfestimate(varargin)
  narginchk(2, 7);
  nargoutchk(0, 2);
  x = varargin{1};
  y = varargin{2};
  args = varargin(3:end);
  [pyx, f] = cpsd(y, x, args{:});
  [pxx] = pwelch(x, args{:});
  n = min(length(pyx), length(pxx));
  txy = pyx(1:n) ./ pxx(1:n);
  tolerance = 100 * eps() * max(1, max(abs(txy)));
  realValues = abs(imag(txy)) <= tolerance;
  txy(realValues) = real(txy(realValues));
  if nargout == 0
    plot(f(1:n), abs(txy));
  else
    varargout{1} = txy;
    if nargout > 1
      varargout{2} = f(1:n);
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function value = thd(varargin)
  narginchk(1, 2);
  nargoutchk(0, 1);
  x = varargin{1}(:);
  X = abs(fft(x));
  X = X(1:floor(length(X) / 2));
  [fundamental, idx] = max(X(2:end));
  idx = idx + 1;
  fundamentalOffset = idx - 1;
  harmonicPower = 0;
  harmonic = 2;
  harmonicIndex = 1 + harmonic * fundamentalOffset;
  while harmonicIndex <= length(X)
    harmonicPower = harmonicPower + X(harmonicIndex) ^ 2;
    harmonic = harmonic + 1;
    harmonicIndex = 1 + harmonic * fundamentalOffset;
  end
  value = 10 * log10(harmonicPower / (fundamental ^ 2));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function w = triang(m)
  narginchk(1, 1);
  nargoutchk(0, 1);
  signalValidateWindowLength(m);
  if isempty(m)
    w = zeros(0, 1);
  elseif mod(m, 2) == 0
    n = (1:m)';
    w = (2 / m) * (m / 2 - abs(n - (m + 1) / 2));
  else
    n = (1:m)';
    w = (2 / (m + 1)) * ((m + 1) / 2 - abs(n - (m + 1) / 2));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = tripuls(varargin)
  narginchk(1, 3);
  nargoutchk(0, 1);
  t = varargin{1};
  width = 1;
  skew = 0;
  if nargin >= 2
    width = varargin{2};
  end
  if nargin == 3
    skew = varargin{3};
  end
  y = zeros(size(t));
  left = -width / 2;
  peak = skew * width / 2;
  right = width / 2;
  if peak == left
    falling = t >= peak & t <= right;
    y(falling) = (right - t(falling)) / (right - peak);
  elseif peak == right
    rising = t >= left & t <= peak;
    y(rising) = (t(rising) - left) / (peak - left);
  else
    rising = t >= left & t <= peak;
    falling = t > peak & t <= right;
    y(rising) = (t(rising) - left) / (peak - left);
    y(falling) = (right - t(falling)) / (right - peak);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function w = tukeywin(varargin)
  narginchk(1, 2);
  nargoutchk(0, 1);
  m = varargin{1};
  if nargin < 2
    r = 0.5;
  else
    r = varargin{2};
  end
  signalValidateWindowLength(m);
  if isempty(m)
    w = zeros(0, 1);
    return;
  end
  if r <= 0
    w = ones(m, 1);
    return;
  end
  if r >= 1
    w = hann(m);
    return;
  end
  n = (0:m - 1)';
  w = ones(m, 1);
  first = n < r * (m - 1) / 2;
  last = n >= (m - 1) * (1 - r / 2);
  w(first) = 0.5 * (1 + cos(pi * (2 * n(first) / (r * (m - 1)) - 1)));
  w(last) = 0.5 * (1 + cos(pi * (2 * n(last) / (r * (m - 1)) - 2 / r + 1)));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = upfirdn(varargin)
  narginchk(2, 5);
  nargoutchk(0, 1);
  x = varargin{1};
  h = varargin{2};
  p = 1;
  q = 1;
  dim = [];
  if nargin >= 3
    p = varargin{3};
  end
  if nargin >= 4
    q = varargin{4};
  end
  if nargin == 5
    dim = varargin{5};
  end
  if issparse(x) || issparse(h)
    error('Nelson:signal:upfirdn:sparseNotSupported', 'Sparse matrices are not supported.');
  end
  if isempty(x)
    error('Nelson:validators:mustBeNonempty', '%s must be nonempty.', 'Input signal');
  end
  if isempty(h)
    error('Nelson:validators:mustBeNonempty', '%s must be nonempty.', 'Filter coefficients');
  end
  mustBeNumeric(p);
  mustBeScalarOrEmpty(p);
  mustBeFinite(p);
  mustBeInteger(p);
  mustBePositive(p);
  mustBeNumeric(q);
  mustBeScalarOrEmpty(q);
  mustBeFinite(q);
  mustBeInteger(q);
  mustBePositive(q);
  if isempty(dim)
    if isrow(x) && ~isvector(h)
      x = x(:);
      dim = 1;
    end
    dim = find(size(x) ~= 1, 1, 'first');
    if isempty(dim)
      dim = 1;
    end
  else
    mustBeNumeric(dim);
    mustBeScalarOrEmpty(dim);
    mustBeFinite(dim);
    mustBeInteger(dim);
    mustBePositive(dim);
  end
  p = double(p);
  q = double(q);
  dim = double(dim);
  if dim == 1 || dim == 2
    y = builtin('__upfirdn__', x, h, p, q, dim);
    return;
  end
  xu = upsampleWithoutTrailingZeros(x, p, dim);
  yf = fullConvolveAlongDimension(xu, h, dim);
  y = downsample(yf, q, 0, dim);
end
%=============================================================================
function y = upsampleWithoutTrailingZeros(x, p, dim)
  if p == 1
    y = x;
    return;
  end
  if dim == 1
    outputLength = (size(x, 1) - 1) * p + 1;
    y = zeros(outputLength, size(x, 2));
    y(1:p:end, :) = x;
  elseif dim == 2
    outputLength = (size(x, 2) - 1) * p + 1;
    y = zeros(size(x, 1), outputLength);
    y(:, 1:p:end) = x;
  else
    error('Nelson:signal:dimensionMustBe1Or2', 'Dimension must be 1 or 2.');
  end
end
%=============================================================================
function y = fullConvolveAlongDimension(x, h, dim)
  h = h(:);
  if dim == 1
    y = zeros(size(x, 1) + length(h) - 1, size(x, 2));
    for col = 1:size(x, 2)
      y(:, col) = conv(x(:, col), h);
    end
  elseif dim == 2
    y = zeros(size(x, 1), size(x, 2) + length(h) - 1);
    for row = 1:size(x, 1)
      y(row, :) = conv(x(row, :), h.');
    end
  else
    error('Nelson:signal:dimensionMustBe1Or2', 'Dimension must be 1 or 2.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = upsample(varargin)
  narginchk(2, 4);
  nargoutchk(0, 1);

  x = varargin{1};
  factor = varargin{2};
  phase = 0;
  dim = [];

  if nargin >= 3
    phase = varargin{3};
  end
  if nargin == 4
    dim = varargin{4};
  end

  mustBeNumeric(factor);
  mustBeScalarOrEmpty(factor);
  mustBeFinite(factor);
  mustBeInteger(factor);
  mustBePositive(factor);

  mustBeNumeric(phase);
  mustBeScalarOrEmpty(phase);
  mustBeFinite(phase);
  mustBeInteger(phase);
  mustBeGreaterThanOrEqual(phase, 0);
  mustBeLessThan(phase, factor);

  if isempty(dim)
    dim = find(size(x) ~= 1, 1, 'first');
    if isempty(dim)
      dim = 1;
    end
  else
    mustBeNumeric(dim);
    mustBeScalarOrEmpty(dim);
    mustBeFinite(dim);
    mustBeInteger(dim);
    mustBePositive(dim);
  end

  factor = double(factor);
  phase = double(phase);
  dim = double(dim);

  shape = size(x);
  numberOfDimensions = max([2, ndims(x), dim]);
  if length(shape) < numberOfDimensions
    shape = [shape, ones(1, numberOfDimensions - length(shape))];
  end

  remainingDimensions = 1:numberOfDimensions;
  remainingDimensions(dim) = [];
  permutationOrder = [dim, remainingDimensions];
  permutedShape = shape(permutationOrder);
  xPermuted = permute(x, permutationOrder);
  x2D = reshape(xPermuted, permutedShape(1), []);

  y2D = zeros(permutedShape(1) * factor, size(x2D, 2), class(x));
  y2D(phase + 1:factor:end, :) = x2D;

  outputShape = permutedShape;
  outputShape(1) = size(y2D, 1);
  yPermuted = reshape(y2D, outputShape);
  y = ipermute(yPermuted, permutationOrder);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = xcorr(varargin)
  narginchk(1, 4);
  nargoutchk(0, 2);

  xInput = varargin{1};
  yInput = [];
  maxlag = [];
  scaleOption = 'none';
  argumentIndex = 2;

  if argumentIndex <= nargin
    value = varargin{argumentIndex};
    if ischar(value) || isstring(value)
      scaleOption = char(value);
      argumentIndex = argumentIndex + 1;
    elseif isscalar(value)
      maxlag = value;
      argumentIndex = argumentIndex + 1;
    else
      yInput = value;
      argumentIndex = argumentIndex + 1;
    end
  end

  if argumentIndex <= nargin
    value = varargin{argumentIndex};
    if ischar(value) || isstring(value)
      scaleOption = char(value);
    else
      maxlag = value;
    end
    argumentIndex = argumentIndex + 1;
  end

  if argumentIndex <= nargin
    value = varargin{argumentIndex};
    if ischar(value) || isstring(value)
      scaleOption = char(value);
    else
      maxlag = value;
    end
  end

  if isempty(yInput) && ~isvector(xInput)
    [c, lags] = matrixAutocorrelation(xInput, maxlag, scaleOption);
    varargout{1} = c;
    if nargout > 1
      varargout{2} = lags;
    end
    return;
  end

  x = xInput(:);
  if isempty(yInput)
    y = x;
  else
    y = yInput(:);
  end
  if isempty(maxlag)
    maxlag = length(x) - 1;
    if length(y) > length(x)
      maxlag = length(y) - 1;
    end
  else
    maxlag = validateMaxlag(maxlag);
  end

  fullCorrelation = conv(x, conj(y(end:-1:1)));
  fullLags = (-(length(y) - 1):(length(x) - 1)).';
  lags = (-maxlag:maxlag).';
  c = zeros(length(lags), 1);
  for idx = 1:length(lags)
    loc = find(fullLags == lags(idx), 1, 'first');
    if ~isempty(loc)
      c(idx) = fullCorrelation(loc);
    end
  end
  c = applyScale(c, lags, length(x), x, y, scaleOption);

  if size(xInput, 1) == 1
    c = c.';
    lags = lags.';
  end

  varargout{1} = c;
  if nargout > 1
    varargout{2} = lags;
  end
end
%=============================================================================
function maxlag = validateMaxlag(maxlag)
  mustBeInteger(maxlag);
  maxlag = abs(double(maxlag));
end
%=============================================================================
function [c, lags] = matrixAutocorrelation(x, maxlag, scaleOption)
  if isempty(maxlag)
    maxlag = size(x, 1) - 1;
  else
    maxlag = validateMaxlag(maxlag);
  end
  columns = size(x, 2);
  c = zeros(2 * maxlag + 1, columns * columns);
  lags = (-maxlag:maxlag).';
  outputColumn = 1;
  for firstColumn = 1:columns
    for secondColumn = 1:columns
      c(:, outputColumn) = xcorr(x(:, firstColumn), x(:, secondColumn), maxlag, scaleOption);
      outputColumn = outputColumn + 1;
    end
  end
end
%=============================================================================
function c = applyScale(c, lags, n, x, y, scaleOption)
  if strcmp(scaleOption, 'none')
    return;
  elseif strcmp(scaleOption, 'biased')
    c = c ./ n;
  elseif strcmp(scaleOption, 'unbiased')
    c = c ./ (n - abs(lags));
  elseif strcmp(scaleOption, 'coeff') || strcmp(scaleOption, 'normalized')
    if length(x) ~= length(y)
      error('Nelson:signal:xcorr:invalidScaleOption', 'Scale option must be ''none'' for input vectors of different lengths.');
    end
    scale = sqrt(sum(abs(x) .^ 2) * sum(abs(y) .^ 2));
    if scale == 0
      c(:) = NaN;
    else
      c = c ./ scale;
    end
  else
    error('Nelson:signal:xcorr:unknownScaleOption', 'Unknown scale option.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = xcorr2(varargin)
  narginchk(1, 2);
  nargoutchk(0, 1);
  A = varargin{1};
  if nargin == 1
    B = A;
  else
    B = varargin{2};
  end
  varargout{1} = conv2(A, rot90(conj(B), 2));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = xcov(varargin)
  narginchk(1, 4);
  nargoutchk(0, 2);

  xInput = varargin{1};
  if isvector(xInput)
    x = xInput(:) - mean(xInput(:));
  else
    x = xInput - mean(xInput, 1);
  end
  args = varargin(2:end);
  if ~isempty(args) && ~(ischar(args{1}) || isstring(args{1})) && ~isscalar(args{1})
    y = args{1};
    args{1} = y(:) - mean(y(:));
    [c, lags] = xcorr(x, args{:});
  else
    [c, lags] = xcorr(x, args{:});
  end

  if size(xInput, 1) == 1
    c = c.';
    lags = lags.';
  end

  varargout{1} = c;
  if nargout > 1
    varargout{2} = lags;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function sos = zp2sos(varargin)
  narginchk(3, 3);
  nargoutchk(0, 1);
  z = varargin{1};
  p = varargin{2};
  k = varargin{3};
  z = z(:);
  p = p(:);
  sectionCount = max(1, ceil(max(length(z), length(p)) / 2));
  sos = zeros(sectionCount, 6);
  gain = prod(k(:));
  for section = 1:sectionCount
    zi = signalTakePair(z, section);
    pi = signalTakePair(p, section);
    b = real(poly(zi));
    a = real(poly(pi));
    b = [zeros(1, 3 - length(b)), b];
    a = [zeros(1, 3 - length(a)), a];
    if section == 1
      b = b * gain;
    end
    sos(section, :) = [b, a];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = zp2tf(varargin)
  narginchk(3, 3);
  nargoutchk(0, 2);
  zerosArray = varargin{1};
  polesArray = varargin{2};
  gain = varargin{3};
  if ~isvector(gain)
    error('Nelson:validators:mustBeVector', '%s must be a vector.', 'Third argument');
  end

  denominator = findDenominator(polesArray);
  varargout{1} = findNumerator(zerosArray, gain, denominator);

  if (nargout > 1)
    varargout{2} = denominator;
  end
end
%=============================================================================
function denominator = findDenominator(polesArray)
  denominator = real(poly(polesArray(:)));
end
%=============================================================================
function numerator = findNumerator(zerosArray, gain, denominator)
  numerator = [];
  denominator_cols = size(denominator, 2);
  gain = gain(:);
  gain_rows = size(gain, 1);
  if isempty(zerosArray)
    if (denominator_cols - 1 > 0)
      numerator = [zeros(gain_rows, denominator_cols - 1), gain];
    else
      numerator = gain;
    end
  else
    [zeros_rows, zeros_cols] = size(zerosArray);
    if (gain_rows ~= zeros_cols)
      if ((zeros_rows - 1) ~= 0)
        error('Nelson:dimagree:inputArgumentNNShouldColumn', 'Input argument #%d and #%d should have the same column size.', 1, 3);
      else
        error('Nelson:validators:mustBeColumn', '%s must be a column vector.', 'First argument');
      end
    else
      numerator = findNumeratorStandardImpl(zerosArray, zeros_cols, gain, denominator_cols);
    end
  end
end
%=============================================================================
function numerator = findNumeratorStandardImpl(zerosArray, zeros_cols, gain, denominator_cols)
  numerator = [];
  for nidx = 1:zeros_cols
    zeros_index = zerosArray(:, nidx);
    poles_index = real(poly(zeros_index) * gain(nidx));
    zeros_rows = zeros(1, denominator_cols - length(poles_index));
    if isempty(numerator)
      numerator = [zeros_rows, poles_index];
    else
      numerator(nidx, :) = [zeros_rows, poles_index];
    end
  end
end
