% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function A = removecats(A, oldCategories)
  narginchk(1, 2);
  if nargin == 1
    used = unique(A.codes(:));
    removeCodes = setdiff(1:length(A.categoryNames), used(:)');
  else
    removeCodes = categorical.categoryCodes(oldCategories, A.categoryNames);
  end
  keep = true(length(A.categoryNames), 1);
  keep(removeCodes) = false;
  map = zeros(length(A.categoryNames), 1);
  map(keep) = 1:sum(keep);
  for k = 1:numel(A.codes)
    code = A.codes(k);
    if code > 0
      A.codes(k) = map(code);
    end
  end
  A.categoryNames = A.categoryNames(keep);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function A = renamecats(A, oldNames, newNames)
  if nargin == 2
    newNames = oldNames;
    if length(newNames) ~= length(A.categoryNames)
      error('Nelson:renamecats:categoryCountMismatch', 'New category names must match existing categories.');
    end
    A.categoryNames = categorical.checkCategoryNames(newNames, false);
    return
  end
  oldNames = categorical.checkCategoryNames(oldNames, true);
  newNames = categorical.checkCategoryNames(newNames, false);
  if length(oldNames) ~= length(newNames)
    error('Nelson:renamecats:lengthMismatch', 'Old and new category names must have the same length.');
  end
  for k = 1:length(oldNames)
    idx = find(strcmp(A.categoryNames, oldNames{k}), 1);
    if isempty(idx)
      error('Nelson:categorical:categoryNotFound', 'Category not found.');
    end
    A.categoryNames{idx} = newNames{k};
  end
  categorical.checkCategoryNames(A.categoryNames, false);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function A = reordercats(A, newOrder)
  narginchk(1, 2);
  if nargin == 1
    newOrder = sort(A.categoryNames);
  elseif isnumeric(newOrder)
    newOrder = A.categoryNames(newOrder);
  else
    newOrder = categorical.checkCategoryNames(newOrder, false);
  end
  [tf, map] = categorical.namesMember(A.categoryNames, newOrder);
  if length(newOrder) ~= length(A.categoryNames) || ~all(tf)
    error('Nelson:reordercats:invalidOrder', 'New category order must contain all categories.');
  end
  for k = 1:numel(A.codes)
    code = A.codes(k);
    if code > 0
      A.codes(k) = map(code);
    end
  end
  A.categoryNames = newOrder(:);
end
