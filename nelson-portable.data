function d = tzoffset(t)
  narginchk(1, 1);
  if ~isa(t, 'datetime')
    error('Nelson:time:datetimeInputExpected', '%s expected.', 'Datetime input');
  end
  timezoneDataPath = [modulepath('time'), '/resources/tzdata'];
  offsetSeconds = timezoneoffset(datenum(t), t.TimeZone, timezoneDataPath);
  d = seconds(offsetSeconds);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
