%=============================================================================
function jac = odeCountedJacobian(t, y)
  global ODE_COUNTED_JACOBIAN_CALLS;
  if isempty(ODE_COUNTED_JACOBIAN_CALLS)
    ODE_COUNTED_JACOBIAN_CALLS = 0;
  end
  ODE_COUNTED_JACOBIAN_CALLS = ODE_COUNTED_JACOBIAN_CALLS + 1;
  jac = -100;
end
