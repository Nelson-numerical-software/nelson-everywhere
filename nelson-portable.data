function content = worker_pool_script_files(chunk)
  content = cell(length(chunk), 1);
  for k = 1:length(chunk)
    content{k} = ['worker_files = [worker_files; ', ...
      nelsonStringLiteral(chunk(k).filename), '];'];
  end
end
