function documentJson = prepareModelJson(documentJson)
  documentJson = NFlow.internal.expandModelica(documentJson);
  documentJson = NFlow.internal.acausalExpand(documentJson);
  documentJson = NFlow.internal.planarExpand(documentJson);
end
