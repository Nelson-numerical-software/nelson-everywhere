    SSE = NaN
    SST = NaN
    SSR = NaN
    FStat = struct('F', NaN, 'pValue', NaN, 'DF1', NaN, 'DF2', NaN)
    ModelCriterion = struct('AIC', NaN, 'BIC', NaN)
    Intercept = true
    Terms = zeros(0, 0)
    Beta = []
    Covariance = []
  end

  methods
    function obj = LinearModel(varargin)
