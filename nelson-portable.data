% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function tf = tablePropagatesFunctionError(functionName)
  % Table math functions whose errors reach the caller as they are.
  tf = any(strcmp(functionName, {'realpow', 'reallog', 'realsqrt', 'nthroot'}));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function names = tableRenameRepeated(names, indices, maxLength)
  % names = source(indices), variable or row names. When an index is
  % repeated, its first occurrence keeps the name and the next ones get a
  % _k suffix that no other name of the list uses
  % ({'B', 'B', 'B_1'} -> {'B', 'B_2', 'B_1'}). Without maxLength, names are
  % not truncated (row names).
  n = numel(indices);
  if n < 2
    return
  end
  sorted = sortrows([indices(:), (1:n)']);
  repeated = false(1, n);
  repeated(sorted(2:end, 2)) = diff(sorted(:, 1)) == 0;
  if ~any(repeated)
    return
  end
  if nargin < 3
    maxLength = max(cellfun('length', names)) + 1 + length(int2str(n));
  end
  names = nelson.lang.makeUniqueStrings(names, reshape(repeated, size(names)), maxLength);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [rows, newRowNames] = tableResolveRows(st, sub, nRows, allowNew)
  % Row numbers selected by ':', a logical mask, numbers or row names in a
  % table of nRows rows. A name that is not a row raises an error; with
  % allowNew (an assignment) it is a new row after the last one instead,
  % and newRowNames lists these names in the order of their rows.
  newRowNames = {};
  if ischar(sub) && strcmp(sub, ':')
    rows = 1:nRows;
  elseif islogical(sub)
    rows = find(sub);
    rows = rows(:)';
  elseif isnumeric(sub)
    rows = sub(:)';
  elseif ischar(sub) || isstring(sub) || iscellstr(sub)
    if ischar(sub)
      names = {sub};
    else
      names = cellstr(sub);
      names = names(:)';
    end
    implicitNames = {};
    if isempty(st.Properties.RowNames)
      implicitNames = tableFirstVariableRowNames(st, nRows);
    end
    rows = zeros(1, length(names));
    for k = 1:length(names)
      idx = find(strcmp(st.Properties.RowNames, names{k}));
      if isempty(idx) && ~isempty(implicitNames)
        idx = find(strcmp(implicitNames, names{k}));
      end
      if isempty(idx) && nargin > 3 && allowNew
        idx = find(strcmp(newRowNames, names{k}));
        if isempty(idx)
          newRowNames{end + 1} = names{k};
          idx = length(newRowNames);
        end
        idx = nRows + idx;
      end
      if isempty(idx)
        error('Nelson:table:notFound', _('Unrecognized table row name ''%s''.'), names{k});
      end
      rows(k) = idx(1);
    end
  else
    error('Nelson:table:invalidSubscript', 'Invalid %s subscript type.', 'row');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function idx = tableResolveVariables(names, vars, types, data)
  if nargin < 3
    types = [];
  end
  if nargin < 4
    data = struct();
  end
  if nargin < 2 || isempty(vars) || (ischar(vars) && strcmp(vars, ':'))
    idx = 1:length(names);
    return
  end
  if strcmp(class(vars), 'vartype')
    idx = find(strcmp(types, vars.TypeName));
    return
  end
  if isa(vars, 'function_handle')
    idx = [];
    for k = 1:length(names)
      try
        tf = vars(types(k));
      catch
        tf = vars(data.(names{k}));
      end
      if tf
        idx(end + 1) = k;
      end
    end
    return
  end
  if islogical(vars)
    idx = find(vars);
    return
  end
  if isnumeric(vars)
    idx = vars;
    return
  end
  if isstring(vars)
    vars = cellstr(vars);
  elseif ischar(vars)
    vars = {vars};
  end
  idx = zeros(1, length(vars));
  for k = 1:length(vars)
    found = find(strcmp(names, vars{k}), 1);
    if isempty(found)
      error('Nelson:table:unrecognizedVariable', _('Unrecognized table variable name ''%s''.'), vars{k});
    end
    idx(k) = found;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function keys = tableRowKeys(st, nRows, vars)
  if nargin < 3 || isempty(vars)
    vars = 1:length(st.Properties.VariableNames);
  end
  keys = cell(nRows, 1);
  for r = 1:nRows
    key = '';
    for j = 1:length(vars)
      name = st.Properties.VariableNames{vars(j)};
      column = st.data.(name);
      key = [key, '#', int2str(j), '=', tableValueKey(tableColumnRows(column, r)), ';'];
    end
    keys{r} = key;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [codesA, codesB, B, options] = tableSetInputs(A, B, args)
  % Shared front end of the table set operations (ismember, intersect,
  % setdiff, union, setxor), reached when either input is a table. Both
  % inputs must be tables with the same variable names (in any order); B is
  % returned with the variable order of A. Each row is replaced by a row of
  % group codes computed jointly over A and B, so equal rows get equal codes
  % whatever their row names, and the numeric set functions with 'rows' on
  % the codes follow the sortrows order of the tables. options holds the
  % other flags ('rows' is implicit), left to the numeric set functions to
  % validate.
  if ~istable(A)
    error('Nelson:table:invalidType', '%s must be a table.', 'First input');
  end
  if ~istable(B)
    error('Nelson:table:invalidType', '%s must be a table.', 'Second input');
  end
  options = withoutRowsFlag(args);
  namesA = A.Properties.VariableNames;
  namesB = B.Properties.VariableNames;
  if numel(namesA) ~= numel(namesB) || ~all(ismember(namesA, namesB))
    error('Nelson:table:variableNamesMustMatch', '%s must match.', 'Table variable names');
  end
  if ~isequal(namesA, namesB)
    B = B(:, namesA);
  end
  nA = height(A);
  nB = height(B);
  stA = struct(A);
  stB = struct(B);
  codes = ones(nA + nB, 1);
  if ~isempty(namesA)
    codes = zeros(nA + nB, 0);
  end
  for k = 1:length(namesA)
    column = [stA.data.(namesA{k}); stB.data.(namesA{k})];
    codes = [codes, tableVariableCodes(column, nA + nB, true)];
  end
  codesA = codes(1:nA, :);
  codesB = codes(nA + 1:end, :);
end
%=============================================================================
function options = withoutRowsFlag(args)
  options = {};
  for k = 1:length(args)
    arg = args{k};
    if ~((ischar(arg) || (isstring(arg) && isscalar(arg))) && strcmpi(arg, 'rows'))
      options{end + 1} = arg;
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [R, order] = tableSortrows(T, idx, direction)
  % Each sort variable is replaced by its sorted-order group codes, then the
  % numeric sortrows of the code matrix gives a stable lexicographic order in
  % which every variable follows its own type order. A code column holding
  % missing values is preceded by an always-ascending missing flag, so missing
  % values stay last in both directions.
  st = struct(T);
  nRows = height(T);
  names = st.Properties.VariableNames;
  idx = idx(:)';
  descending = parseDirection(direction, length(idx));
  codes = zeros(nRows, 0);
  signs = zeros(1, 0);
  for k = 1:length(idx)
    [varCodes, varMissing] = tableVariableCodes(st.data.(names{idx(k)}), nRows, false);
    for j = 1:size(varCodes, 2)
      if any(varMissing(:, j))
        codes = [codes, double(varMissing(:, j))];
        signs = [signs, 1];
      end
      codes = [codes, varCodes(:, j)];
      signs = [signs, 1 - 2 * descending(k)];
    end
  end
  if isempty(codes)
    order = (1:nRows)';
  else
    [~, order] = sortrows(codes, signs .* (1:size(codes, 2)));
    order = order(:);
  end
  R = T(order, :);
end
%=============================================================================
function descending = parseDirection(direction, nVars)
  if ischar(direction)
    direction = {direction};
  elseif isstring(direction)
    direction = cellstr(direction);
  end
  if ~iscellstr(direction) || (length(direction) ~= 1 && length(direction) ~= nVars)
    error('Nelson:table:sortrows:invalidDirection', 'Sorting direction must be ''ascend'' or ''descend'', or a cell array with one direction per sorting variable.');
  end
  descending = false(1, length(direction));
  for k = 1:length(direction)
    if strcmpi(direction{k}, 'descend')
      descending(k) = true;
    elseif ~strcmpi(direction{k}, 'ascend')
      error('Nelson:table:sortrows:invalidDirection', 'Sorting direction must be ''ascend'' or ''descend'', or a cell array with one direction per sorting variable.');
    end
  end
  if length(descending) == 1
    descending = repmat(descending, 1, nVars);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function nVars = tableSubscriptCount(varSub, variableNames)
  % number of variables selected by a variable subscript, new names included
  if ischar(varSub) && strcmp(varSub, ':')
    nVars = length(variableNames);
  elseif islogical(varSub)
    nVars = nnz(varSub);
  elseif isnumeric(varSub)
    nVars = numel(varSub);
  elseif ischar(varSub)
    nVars = 1;
  else
    nVars = numel(varSub);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [C, ia, ic] = tableUnique(T, varargin)
  % Each variable column is replaced by its sorted-order group codes, so the
  % unique rows of the code matrix follow sortrows semantics across variables
  % while 'sorted'/'stable'/'first'/'last' are handled by the numeric unique.
  distinctMissing = parseTableUniqueOptions(varargin);
  st = struct(T);
  nRows = height(T);
  names = st.Properties.VariableNames;
  codes = zeros(nRows, 0);
  for k = 1:length(names)
    codes = [codes, tableVariableCodes(st.data.(names{k}), nRows, distinctMissing)];
  end
  if nRows == 0
    % still goes through unique so the options are validated
    [~, ia, ic] = unique(zeros(0, 1), varargin{:});
  elseif isempty(codes)
    % no variables: every row is the same
    [~, ia, ic] = unique(ones(nRows, 1), varargin{:});
  else
    [~, ia, ic] = unique(codes, 'rows', varargin{:});
  end
  ia = ia(:);
  ic = ic(:);
  C = T(ia, :);
end
%=============================================================================
function distinctMissing = parseTableUniqueOptions(args)
  distinctMissing = true;
  k = 1;
  while k <= length(args)
    arg = args{k};
    if (ischar(arg) || (isstring(arg) && isscalar(arg))) && strcmpi(arg, 'TreatMissingAsDistinct') && k < length(args)
      distinctMissing = logical(args{k + 1});
      k = k + 2;
      continue;
    end
    if (ischar(arg) || (isstring(arg) && isscalar(arg))) && any(strcmpi(arg, {'legacy', 'R2012a'}))
      error('Nelson:table:unique:unsupportedOption', 'The ''R2012a'' and ''legacy'' options are not supported.');
    end
    k = k + 1;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function key = tableValueKey(value)
  if ischar(value)
    key = ['char:', value];
  elseif isstring(value)
    key = ['string:', char(value)];
  elseif iscell(value)
    if isempty(value)
      key = 'cell:[]';
    else
      key = ['cell:', tableValueKey(value{1})];
    end
  elseif isnumeric(value) || islogical(value)
    key = [class(value), ':', mat2str(value)];
  else
    try
      key = [class(value), ':', mat2str(value)];
    catch
      key = [class(value), ':', char(string(value))];
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [codes, missing] = tableVariableCodes(value, nRows, distinctMissing)
  % Replaces each column of a table variable by its sorted-order group codes
  % (one code column per variable column). Missing values get the largest
  % codes, so the numeric sortrows/unique of the code matrix follow the order
  % of each variable in its own type. missing flags the missing elements (an
  % empty char in a cellstr variable is a plain value, not a missing one).
  if ndims(value) > 2 || size(value, 2) ~= 1
    value = reshape(value, nRows, []);
  end
  nCols = size(value, 2);
  codes = zeros(nRows, nCols);
  for j = 1:nCols
    codes(:, j) = columnCodes(value(:, j), distinctMissing);
  end
  if nargout > 1
    missing = missingElements(value);
  end
end
%=============================================================================
function tf = missingElements(value)
  if isdatetime(value)
    tf = isnat(value);
  elseif isduration(value) || isfloat(value)
    tf = isnan(value);
  elseif iscategorical(value)
    tf = isundefined(value);
  elseif isstring(value)
    tf = ismissing(value);
  else
    tf = false(size(value));
  end
end
%=============================================================================
function g = columnCodes(column, distinctMissing)
  if iscell(column) && ~iscellstr(column)
    keys = cell(size(column, 1), 1);
    for r = 1:size(column, 1)
      keys{r} = tableValueKey(column(r, :));
    end
    [~, ~, g] = unique(keys);
  elseif iscell(column) || distinctMissing
    % an empty char in a cellstr variable is a plain value, not a missing one
    [~, ~, g] = unique(column);
  else
    [~, ~, g] = unique(column, 'TreatMissingAsDistinct', false);
  end
  g = double(g(:));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function names = tableVertcatRowNames(namesA, nA, namesB, nB)
  % Row names of [A; B]: none when neither table has row names, otherwise
  % the rows of a table without row names are named Row<k> after their row
  % number in the result, and a row name given in both tables is an error.
  hasA = tableHasRowNames(namesA, nA);
  hasB = tableHasRowNames(namesB, nB);
  if ~hasA && ~hasB
    names = {};
    return
  end
  if hasA
    namesA = reshape(namesA, [], 1);
  else
    namesA = tableDefaultRowNames(1:nA, namesB);
  end
  if hasB
    namesB = reshape(namesB, [], 1);
  else
    namesB = tableDefaultRowNames(nA + (1:nB), namesA);
  end
  [isDuplicate, idx] = ismember(namesB, namesA);
  if any(isDuplicate)
    error('Nelson:table:vertcat:duplicateRowNames', _('Duplicate table row name: ''%s''.'), namesA{idx(find(isDuplicate, 1))});
  end
  names = [namesA; namesB];
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [st, nRows] = tableVertcatStructs(st, nRows, stB, nB)
  % [A; B] on the structures of two tables of heights nRows and nB: a
  % table without rows adds nothing but its row names.
  rowNames = tableVertcatRowNames(st.Properties.RowNames, nRows, stB.Properties.RowNames, nB);
  if nRows == 0
    st = stB;
  elseif nB > 0
    names = st.Properties.VariableNames;
    if ~isequal(names, stB.Properties.VariableNames)
      error('Nelson:table:vertcatVariableNamesMismatch', 'All tables to be vertically concatenated must have identical variable names.');
    end
    if isempty(names)
      st.data = repmat(struct(), nRows + nB, 0);
    end
    for j = 1:length(names)
      st.data.(names{j}) = [st.data.(names{j}); stB.data.(names{j})];
    end
  end
  st.Properties.RowNames = rowNames;
  nRows = nRows + nB;
end
