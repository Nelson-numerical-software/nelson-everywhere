%=============================================================================
function [B, I] = maxk(A, k, varargin)
  if ~A.isOrdinal
    error('Nelson:categorical:requiresOrdinal', '%s requires ordinal categorical arrays.', 'maxk');
  end
  [S, order] = sort(A);
  I = order(end - k + 1:end);
  B = S(end - k + 1:end);
end
