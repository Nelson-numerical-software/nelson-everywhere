function data = timeseriesAssignData(data, rows, value, isTimeFirst)
  dim = timeseriesSampleDimension(data, isTimeFirst);
  subs = repmat({':'}, 1, ndims(data));
  subs{dim} = rows;
  data(subs{:}) = value;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function out = timeseriesBinaryOperation(a, b, op)
  if istimeseries(a) && istimeseries(b)
    if ~isequal(a.Time, b.Time)
      [a, b] = synchronize(a, b);
    end
    out = a;
    left = a.Data;
    right = b.Data;
  elseif istimeseries(a)
    out = a;
    left = a.Data;
    right = b;
  elseif istimeseries(b)
    out = b;
    left = a;
    right = b.Data;
  else
    error('Nelson:time:leastOneInputTimeseriesObject', 'At least one input must be a timeseries object.');
  end
  switch op
    case 'plus'
      out.Data_ = left + right;
    case 'minus'
      out.Data_ = left - right;
    case 'times'
      out.Data_ = left .* right;
    case 'rdivide'
      out.Data_ = left ./ right;
    case 'ldivide'
      out.Data_ = left .\ right;
    case 'mtimes'
      out.Data_ = left * right;
    case 'mrdivide'
      out.Data_ = left / right;
    case 'mldivide'
      out.Data_ = left \ right;
    case 'eq'
      out.Data_ = left == right;
    otherwise
      error('Nelson:time:unsupportedTimeseriesOperation', 'Unsupported %s.', 'timeseries operation');
  end
  out.Quality_ = [];
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = timeseriesDataAsColumns(obj)
  data = obj.Data_;
  if isempty(data)
    y = [];
    return
  end
  if isvector(data)
    y = data(:);
    return
  end
  if obj.IsTimeFirst_
    y = reshape(data, obj.Length, []);
  else
    order = [ndims(data), 1:ndims(data) - 1];
    data = permute(data, order);
    y = reshape(data, obj.Length, []);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function obj = timeseriesDotAssign(obj, name, value)
  switch name
    case 'Data'
      obj.Data = value;
    case 'Time'
      obj.Time = value;
    case 'Quality'
      obj.Quality = value;
    case 'IsTimeFirst'
      obj.IsTimeFirst = value;
    case 'Name'
      obj.Name = timeseriesText(value, 'Name');
    case {'Events', 'UserData', 'DataInfo', 'TimeInfo', 'QualityInfo', 'TreatNaNasMissing'}
      obj.(name) = value;
      if strcmp(name, 'TimeInfo')
        obj = timeseriesRefreshMetadata(obj);
      end
    otherwise
      error('Nelson:time:unknownTimeseriesProperty', 'Unknown %s property.', 'timeseries');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function value = timeseriesDotReference(obj, name)
  state = struct(obj);
  switch name
    case 'Data'
      value = state.Data_;
    case 'Time'
      value = state.Time_;
    case 'Quality'
      value = state.Quality_;
    case 'IsTimeFirst'
      value = state.IsTimeFirst_;
    case 'Length'
      value = length(state.Time_);
    otherwise
      if isfield(state, name)
        value = state.(name);
      else
        error('Nelson:time:unknownTimeseriesProperty', 'Unknown %s property.', 'timeseries');
      end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function ev = timeseriesEventAt(events, index)
  if iscell(events)
    ev = events{index};
  else
    ev = events(index);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function ev = timeseriesFindEvent(obj, eventName)
  eventName = timeseriesText(eventName, 'Event name');
  events = obj.Events;
  for k = 1:numel(events)
    currentEvent = timeseriesEventAt(events, k);
    if strcmp(currentEvent.Name, eventName)
      ev = currentEvent;
      return
    end
  end
  error('Nelson:time:eventFound', 'Event was not found.');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function data = timeseriesInterpolateData(obj, newTime, method)
  y = timeseriesDataAsColumns(obj);
  if isempty(y)
    data = [];
    return
  end
  if strcmpi(method, 'zoh')
    method = 'previous';
  end
  if strcmpi(method, 'previous')
    data = interpolatePrevious(obj.Time(:), y, newTime(:));
  else
    data = interp1(obj.Time(:), y, newTime(:), method, 'extrap');
  end
end
%=============================================================================
function out = interpolatePrevious(time, y, newTime)
  out = zeros(length(newTime), size(y, 2));
  for k = 1:length(newTime)
    idx = find(time <= newTime(k), 1, 'last');
    if isempty(idx)
      idx = 1;
    end
    out(k, :) = y(idx, :);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function n = timeseriesLengthFromData(data, isTimeFirst)
  if isempty(data)
    n = 0;
    return
  end
  if isvector(data)
    n = numel(data);
  elseif isTimeFirst
    n = size(data, 1);
  else
    n = size(data, ndims(data));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function time = timeseriesNormalizeTime(value)
  if isempty(value)
    time = zeros(0, 1);
  elseif isa(value, 'datetime')
    time = datenum(value);
    time = time(:);
  elseif isa(value, 'duration')
    time = double(value);
    time = time(:);
  elseif ischar(value) || isstring(value) || iscellstr(value)
    time = datenum(value);
    time = time(:);
  elseif isnumeric(value)
    time = double(value(:));
  else
    error('Nelson:time:timeValuesNumericDatetimeDuration', 'Time values must be numeric, datetime, duration, or text dates.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function parsed = timeseriesParseConstructor(varargin)
  parsed = struct();
  parsed.Data = [];
  parsed.Time = [];
  parsed.Quality = [];
  parsed.Name = '';
  parsed.UserData = [];
  parsed.DataInfo = tsdata.datametadata();
  parsed.TimeInfo = tsdata.timemetadata();
  parsed.QualityInfo = tsdata.qualmetadata();
  parsed.TreatNaNasMissing = true;
  parsed.IsTimeFirst = true;

  [args, opts] = splitNameValues(varargin);
  if length(args) >= 1
    parsed.Data = args{1};
  end
  if length(args) >= 2
    parsed.Time = args{2};
  end
  if length(args) >= 3
    parsed.Quality = args{3};
  end
  if length(args) > 3
    error('Nelson:tooManyInputs', 'Too many input arguments.');
  end

  isTimeFirstSpecified = false;
  if ~isempty(parsed.Data) && ndims(parsed.Data) > 2
    parsed.IsTimeFirst = false;
  end
  for k = 1:2:length(opts)
    name = lower(timeseriesText(opts{k}, 'Property name'));
    value = opts{k + 1};
    switch name
      case 'name'
        parsed.Name = timeseriesText(value, 'Name');
      case 'userdata'
        parsed.UserData = value;
      case 'datainfo'
        parsed.DataInfo = value;
      case 'timeinfo'
        parsed.TimeInfo = value;
      case 'qualityinfo'
        parsed.QualityInfo = value;
      case 'treatnanasmissing'
        parsed.TreatNaNasMissing = logical(value);
      case 'istimefirst'
        parsed.IsTimeFirst = logical(value);
        isTimeFirstSpecified = true;
      otherwise
        error('Nelson:time:unsupportedTimeseriesOption', 'Unsupported %s.', 'timeseries option');
    end
  end
  if ~isTimeFirstSpecified && ~isempty(parsed.Data) && ndims(parsed.Data) > 2
    parsed.IsTimeFirst = false;
  end
  n = timeseriesLengthFromData(parsed.Data, parsed.IsTimeFirst);
  if isempty(parsed.Time) && n > 0
    parsed.Time = (0:n - 1).';
  end
end
%=============================================================================
function [args, opts] = splitNameValues(values)
  firstOption = length(values) + 1;
  k = 1;
  while k <= length(values)
    if (ischar(values{k}) || isstring(values{k})) && k < length(values)
      name = lower(char(values{k}));
      if any(strcmp(name, {'name', 'userdata', 'datainfo', 'timeinfo', 'qualityinfo', 'treatnanasmissing', 'istimefirst'}))
        firstOption = k;
        break
      end
    end
    k = k + 1;
  end
  args = values(1:firstOption - 1);
  opts = values(firstOption:end);
  if rem(length(opts), 2) ~= 0
    error('Nelson:time:nameValueArgumentsAppearPairs', 'Name-value arguments must be paired.');
  end
end
