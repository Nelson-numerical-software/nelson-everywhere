asserts.isequal(nargin('ssdata'), -1);
asserts.isequal(nargout('ssdata'), -1);
%=============================================================================
A = [0 1; -2 -3];
B = [0; 1];
C = [1 0];
D = 0;
sys = ss(A, B, C, D);
[a, b, c, d, Ts] = ssdata(sys);
asserts.isequal(a, A);
asserts.isequal(b, B);
asserts.isequal(c, C);
asserts.isequal(d, D);
asserts.isequal(Ts, 0);
