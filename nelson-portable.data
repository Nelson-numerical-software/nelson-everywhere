function sz = getdatasamplesize(obj)
  if isempty(obj.Data)
    sz = [0 0];
    return
  end
  sz = size(obj.Data);
  dim = timeseriesSampleDimension(obj.Data, obj.IsTimeFirst);
  sz(dim) = [];
  if isempty(sz)
    sz = [1 1];
  elseif isscalar(sz)
    sz = [1 sz];
  end
end
