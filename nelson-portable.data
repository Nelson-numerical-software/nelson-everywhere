%=============================================================================
function b = fir1(varargin)
  narginchk(2, 4);
  nargoutchk(0, 1);
  n = varargin{1};
  wn = varargin{2};
  ftype = '';
  win = [];
  for k = 3:nargin
    value = varargin{k};
    if ischar(value) || isstring(value)
      ftype = char(value);
    else
      win = value;
    end
  end
  mustBeInteger(n);
  mustBeNonnegative(n);
  if isempty(win)
    win = hamming(n + 1);
  else
    win = win(:);
  end
  if length(win) ~= n + 1
    error('Nelson:signal:fir1:invalidWindowLength', 'Window length must be filter order plus one.');
  end
  if isempty(ftype)
    if length(wn) == 1
      ftype = 'low';
    else
      ftype = 'bandpass';
    end
  end
  m = (0:n) - n / 2;
  if length(wn) == 1
    wc = wn(1);
    h = wc * sinc(wc * m);
    if strcmp(ftype, 'high')
      h = -h;
      h(n / 2 + 1) = h(n / 2 + 1) + 1;
    end
  else
    w1 = wn(1);
    w2 = wn(2);
    h = w2 * sinc(w2 * m) - w1 * sinc(w1 * m);
    if strcmp(ftype, 'stop')
      h = -h;
      h(n / 2 + 1) = h(n / 2 + 1) + 1;
    end
  end
  b = h(:).' .* win(:).';
  if strcmp(ftype, 'high')
    scale = abs(sum(b .* ((-1) .^ (0:n))));
  elseif strcmp(ftype, 'bandpass')
    center = mean(wn);
    scale = abs(sum(b .* exp(-complex(0, 1) * pi * center * (0:n))));
  else
    scale = sum(b);
  end
  if scale ~= 0
    b = real(b ./ scale);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function b = fir2(varargin)
  narginchk(3, 4);
  nargoutchk(0, 1);
  n = varargin{1};
  f = varargin{2};
  m = varargin{3};
  if nargin == 4
    win = varargin{4};
  else
    win = hamming(n + 1);
  end
  mustBeInteger(n);
  mustBeNonnegative(n);
  f = f(:).';
  m = m(:).';
  if length(f) ~= length(m)
    error('Nelson:dimagree:valueLength', '%s must have the same length.', 'Frequency and magnitude vectors');
  end
  gridCount = max(1024, 2 ^ nextpow2(2 * (n + 1)));
  grid = (0:gridCount / 2) / (gridCount / 2);
  mag = interp1(f, m, grid, 'linear');
  phase = exp(-complex(0, 1) * pi * grid * n / 2);
  response = mag .* phase;
  spectrum = [response, conj(response(end - 1:-1:2))];
  h = real(ifft(spectrum));
  b = h(1:n + 1) .* win(:).';
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = freqz(varargin)
  narginchk(1, 5);
  nargoutchk(0, 2);

  b = varargin{1};
  a = 1;
  n = 512;
  fs = [];
  range = 'half';

  isSos = ismatrix(b) && ~isvector(b) && size(b, 2) == 6;
  if isSos
    [b, a] = sos2tf(b);
    argumentIndex = 2;
  elseif nargin >= 2
    a = varargin{2};
    argumentIndex = 3;
  else
    argumentIndex = 3;
  end

  if argumentIndex <= nargin && ~isempty(varargin{argumentIndex})
    if ischar(varargin{argumentIndex}) || isstring(varargin{argumentIndex})
      range = char(varargin{argumentIndex});
    else
      n = varargin{argumentIndex};
    end
    argumentIndex = argumentIndex + 1;
  end
  while argumentIndex <= nargin
    value = varargin{argumentIndex};
    if ischar(value) || isstring(value)
      range = char(value);
    else
      fs = value;
    end
    argumentIndex = argumentIndex + 1;
  end

  validateFilterVectors(b, a);

  if isscalar(n)
    nfft = double(n);
    if isempty(fs)
      if strcmp(range, 'whole')
        w = (0:nfft - 1)' * 2 * pi / nfft;
      else
        w = (0:nfft - 1)' * pi / nfft;
      end
    else
      if strcmp(range, 'whole')
        w = (0:nfft - 1)' * double(fs) / nfft;
      else
        w = (0:nfft - 1)' * double(fs) / (2 * nfft);
      end
    end
  else
    w = n(:);
  end

  if isempty(fs)
    evalw = w;
  else
    evalw = 2 * pi * w / double(fs);
  end
  h = signalFrequencyResponse(b, a, evalw);

  if nargout == 0
    plot(w, abs(h));
  else
    varargout{1} = h;
    if nargout > 1
      varargout{2} = w;
    end
  end
end
%=============================================================================
function validateFilterVectors(b, a)
  if isempty(a) || isempty(b) || ~isvector(a) || ~isvector(b)
    error('Nelson:signal:freqz:invalidCoefficients', 'Filter coefficients must be vectors.');
  end
  if a(1) == 0
    error('Nelson:signal:zeroLeadingDenominator', 'First denominator filter coefficient must be nonzero.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
