% LICENCE_BLOCK_END
%=============================================================================
function tf = ip_activecontour_is_color_image(img)
  s = size(img);
  tf = length(s) == 3 && (s(3) == 3 || s(3) == 4);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function image2d = ip_activecontour_prepare_image(img)
  ip_assert_full_image(img, true, true);
  if ~isreal(img)
    error('Nelson:validators:mustBeReal', '%s must be real.', 'Image');
  end
  s = size(img);
  if length(s) < 3
    image2d = img;
    return
  end
  r = ip_to_unit_double(img(:, :, 1));
  g = ip_to_unit_double(img(:, :, 2));
  b = ip_to_unit_double(img(:, :, 3));
  image2d = 0.2989360213 * r + 0.5870430745 * g + 0.1140209043 * b;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function mask = ip_apply_corner_roi(mask, roi)
  if isempty(roi)
    return
  end
  [rows, cols] = size(mask);
  x1 = max(1, floor(roi(1)));
  y1 = max(1, floor(roi(2)));
  x2 = min(cols, ceil(roi(1) + roi(3)));
  y2 = min(rows, ceil(roi(2) + roi(4)));
  keep = false(rows, cols);
  if x1 <= x2 && y1 <= y2
    keep(y1:y2, x1:x2) = true;
  end
  mask = mask & keep;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function ip_assert_full_image(img, allowRGB, allowRGBA)
  if nargin < 3
    allowRGBA = false;
  end
  if ~(isnumeric(img) || islogical(img))
    error('Nelson:validators:mustBeNumericOrLogical', '%s must be numeric or logical.', 'Image');
  end
  if issparse(img)
    error('Nelson:image_processing:sparseImagesNotSupported', '%s are not supported.', 'Sparse images');
  end
  s = size(img);
  if length(s) <= 3
    if length(s) < 3 || s(3) == 1
      return
    end
    if allowRGB && (s(3) == 3 || (allowRGBA && s(3) == 4))
      return
    end
  end
  if allowRGB
    if allowRGBA
      error('Nelson:image_processing:imageDRgbRgbaArray', '%s must be a 2-D, RGB, or RGBA array.', 'Image');
    else
      error('Nelson:image_processing:imageDRgbArray', '%s must be a 2-D or RGB array.', 'Image');
    end
  else
    error('Nelson:image_processing:imageDArray', '%s must be a 2-D array.', 'Image');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function ip_assert_integer_valued(x)
  if any(~isfinite(double(x(:)))) || any(double(x(:)) ~= floor(double(x(:))))
    error('Nelson:image_processing:indexedImageValuesFiniteIntegers', 'Indexed image values must be finite integers.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function ip_assert_label_matrix(labels)
  ip_assert_full_image(labels, false);
  if ~isnumeric(labels)
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Label matrix');
  end
  values = double(labels(:));
  if any(~isfinite(values)) || any(values ~= floor(values)) || any(values < 0)
    error('Nelson:image_processing:labelMatrixValuesNonnegativeFiniteIntegers', '%s values must be nonnegative finite integers.', 'Label matrix');
  end
end
