%=============================================================================
% xml = NFlow.internal.acausalGenerateHelp(componentName, lang)
%
% Acausal palette N0.2: the per-block help-page generator. Emits a well-formed
% Nelson help XML page for one catalog component, generated from the
% single-source catalog (name, domain, pins, params, description). This is the
% N0.2 help scaffold: N5 writes the pages under
% modules/nflow_blocks/help/{en_US,fr_FR}/xml/<group>/<name>.xml, then an author
% expands the prose. nflow help pages use <history_version>1.0.0 (repo rule).
%
% componentName: a name from NFlow.internal.acausalCatalog (e.g. 'Resistor').
% lang: 'en_US' (default) | 'fr_FR', setting the <language> tag and a translated
%       lead sentence; the structured tables are language-neutral.
%=============================================================================
function xml = acausalGenerateHelp(componentName, lang)
  if nargin < 2
    lang = 'en_US';
  end
  catalog = NFlow.internal.acausalCatalog();
  idx = 0;
  for k = 1:numel(catalog)
    if strcmp(catalog(k).name, componentName)
      idx = k; break
    end
  end
  if idx == 0
    error('Nelson:nflow:acausalHelpUnknown', ...
      'Unknown acausal component ''%s''.', componentName);
  end
  c = catalog(idx);

  % Physical-pin rows.
  pinRows = {};
  for pp = 1:numel(c.pins)
    pinRows{end + 1} = sprintf(...
      '<tr><td>%s</td><td>%s pin (%s domain, undirected)</td></tr>', ...
      c.pins{pp}{1}, c.domain, c.domain); %#ok<AGROW>
  end
  % Parameter rows.
  paramRows = {};
  for qq = 1:numel(c.params)
    pm = c.params{qq};
    paramRows{end + 1} = sprintf(...
      '<tr><td><code>%s</code></td><td>%.15g</td><td>%s</td></tr>', ...
      pm{1}, pm{3}, pm{4}); %#ok<AGROW>
  end
  if isempty(paramRows)
    paramRows = {'<tr><td>(none)</td><td></td><td></td></tr>'};
  end

  lead = c.desc;
  if strcmp(lang, 'fr_FR')
    lead = ['Composant acausal (', c.domain, '). ', c.desc];
  end
  islandNote = sprintf(...
    ['Acausal component: lowered to a %s block by NFlow.internal.acausalExpand. "dae" is the ', ...
     'reference solver; the fixed-step loop and the native explicit solvers ', ...
     '(ode1/ode4/ode45) are also supported.'], ...
    c.island);

  xml = [...
    '<?xml version="1.0" encoding="UTF-8"?>', newline, ...
    '<xmldoc>', newline, ...
    '  <copyright>SAME AS NELSON SOFTWARE</copyright>', newline, ...
    '  <language>', lang, '</language>', newline, ...
    '  <keyword>', c.name, '</keyword>', newline, ...
    '  <keyword_alias>block:', c.name, '</keyword_alias>', newline, ...
    '  <short_description>', esc(c.desc), '</short_description>', newline, ...
    '  <syntax><syntax_item>Acausal component: ', c.name, '</syntax_item></syntax>', newline, ...
    '  <param_input><param_input_item><param_name>physical pins</param_name>', ...
    '<param_description>', num2str(numel(c.pins)), ' physical pin(s), ', c.domain, ' domain.', ...
    '</param_description></param_input_item></param_input>', newline, ...
    '  <param_output><param_output_item><param_name>signal ports</param_name>', ...
    '<param_description>', sig_desc(c), '</param_description></param_output_item></param_output>', newline, ...
    '  <description>', newline, ...
    '    <p>', esc(lead), '</p>', newline, ...
    '    <p>', islandNote, '</p>', newline, ...
    '    <p><b>Domain</b>: ', c.domain, ' &#8212; group ', c.group, '.</p>', newline, ...
    '    <p><b>Physical pins</b></p>', newline, ...
    '    <table border="1"><thead><tr><th>Pin</th><th>Role</th></tr></thead><tbody>', ...
    strjoin(pinRows, ''), '</tbody></table>', newline, ...
    '    <p><b>Parameters</b></p>', newline, ...
    '    <table border="1"><thead><tr><th>Parameter</th><th>Default</th><th>Unit</th></tr></thead><tbody>', ...
    strjoin(paramRows, ''), '</tbody></table>', newline, ...
    '    <p><b>Implementation Sources</b></p>', newline, ...
    '    <source_code label="Catalog" path="modules/nflow_blocks/functions/+NFlow/+internal/acausalCatalog.m" language="matlab"/>', newline, ...
    '  </description>', newline, ...
    '  <used_function/>', newline, ...
    '  <bibliography/>', newline, ...
    '  <see_also><see_also_item><link linkend="${nflow_engine}acausal_user_guide">acausal user guide</link></see_also_item></see_also>', newline, ...
    '  <history><history_item><history_version>1.0.0</history_version>', ...
    '<history_description>initial version</history_description></history_item></history>', newline, ...
    '  <authors><author_item>Allan CORNET</author_item></authors>', newline, ...
    '</xmldoc>', newline];
end
%=============================================================================
function d = sig_desc(c)
  parts = {};
  if ~isempty(c.signalIn)
    parts{end + 1} = ['input ', c.signalIn]; %#ok<AGROW>
  end
  if ~isempty(c.signalOut)
    parts{end + 1} = ['output (', c.signalOut, ' sensor)']; %#ok<AGROW>
  end
  if isempty(parts)
    d = 'none (pure physical component).';
  else
    d = [strjoin(parts, ', '), '.'];
  end
end
%=============================================================================
function o = esc(s)
  o = strrep(s, '&', '&amp;');
  o = strrep(o, '<', '&lt;');
  o = strrep(o, '>', '&gt;');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% svg = NFlow.internal.acausalGenerateIcon(name)
%
% Acausal palette N5: the per-block icon generator. Emits a polished, self-
% contained 72x72 SVG palette icon for one acausal component, composed from a
% clean-room symbol kit (textbook physical symbols drawn from primitives, no
% third-party artwork). Deterministic and generated from the single-source
% catalog, so every block ships with a consistent icon; the GUI palette (N5)
% references these under <libraries>/acausal_<domain>/icons/<name>.svg.
%
% Style: a rounded-rect card tinted by physical domain, the component symbol in
% the domain's ink colour, and undirected physical-pin dots on the edges.
%
% name: a component name from NFlow.internal.acausalCatalog (e.g. 'Resistor').
%=============================================================================
function svg = acausalGenerateIcon(name)
  catalog = NFlow.internal.acausalCatalog();
  idx = 0;
  for k = 1:numel(catalog)
    if strcmp(catalog(k).name, name)
      idx = k; break
    end
  end
  if idx == 0
    error('Nelson:nflow:acausalIconUnknown', ...
      'Unknown acausal component ''%s''.', name);
  end
  c = catalog(idx);
  [bg, stroke, tint] = ic_palette(c.domain);
  sym = ic_symbol(c, stroke);
  if isempty(sym)
    sym = ic_label(name, stroke); % clean fallback: the block initial
  end
  % Physical-pin dots: one per pin, spread along the left/right edges.
  npin = numel(c.pins);
  dots = ic_pins(npin, stroke);

  svg = [...
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 72 72" width="72" height="72">', newline, ...
    '  <rect x="1" y="1" width="70" height="70" rx="14" fill="', bg, ...
    '" stroke="', tint, '" stroke-width="1.5"/>', newline, ...
    sym, newline, ...
    dots, newline, ...
    '</svg>', newline];
end
%=============================================================================
function [bg, stroke, tint] = ic_palette(domain)
  switch domain
    case 'electrical'
      bg = '#E8F0FE'; stroke = '#1A3E8C'; tint = '#9DB8F0';
    case 'thermal'
      bg = '#FDECEA'; stroke = '#9C2A1A'; tint = '#F0A99D';
    case 'translational'
      bg = '#FEF6E1'; stroke = '#8C5A08'; tint = '#E7C98A';
    case 'rotational'
      bg = '#EAF7EC'; stroke = '#1E6B2E'; tint = '#A6DDB0';
    otherwise
      bg = '#F0F0F2'; stroke = '#333333'; tint = '#BEBEC2';
  end
end
%=============================================================================
function s = ic_line(x1, y1, x2, y2, stroke)
  s = sprintf(['<line x1="%g" y1="%g" x2="%g" y2="%g" stroke="%s" ', ...
    'stroke-width="2" stroke-linecap="round"/>'], x1, y1, x2, y2, stroke);
end
function s = ic_pins(npin, stroke)
  % Place physical-pin dots on the card edge so they line up with the symbol:
  % 1 pin -> left at the vertical centre; 2 pins -> left+right at the centre
  % (the horizontal 2-terminal layout the symbols use); 3+ -> split across the
  % left and right edges, spread vertically.
  parts = {};
  if npin <= 0
    s = ''; return
  end
  if npin == 1
    coords = {[8, 36]};
  elseif npin == 2
    coords = {[8, 36], [64, 36]};
  else
    coords = {};
    nleft = ceil(npin / 2); nright = npin - nleft;
    yl = ic_spread(nleft);
    for i = 1:nleft; coords{end + 1} = [8, yl(i)]; end %#ok<AGROW>
    if nright > 0
      yr = ic_spread(nright);
      for i = 1:nright; coords{end + 1} = [64, yr(i)]; end %#ok<AGROW>
    end
  end
  for k = 1:numel(coords)
    parts{end + 1} = sprintf('<circle cx="%g" cy="%g" r="3" fill="%s"/>', ...
      coords{k}(1), coords{k}(2), stroke); %#ok<AGROW>
  end
  s = ['  ', strjoin(parts, '')];
end
function ys = ic_spread(n)
  if n == 1
    ys = 36;
  else
    ys = linspace(24, 48, n);
  end
end
%=============================================================================
function s = ic_symbol(c, k)
  % Distinct icon per block. A base symbol (by kind) is disambiguated so no two
  % blocks render identically: name-specific overrides first, then modifier
  % glyphs (a 'variable' arrow for variable kinds, a 'G' badge for conductors
  % vs resistors, a 'signal' wave for signal-driven sources).
  name = c.name;
  kind = c.kind;
  % --- name-specific overrides (blocks that must not share a base symbol) ----
  switch name
    case 'VCV' % V-controlled V-source (Modelica: sense arrow -> source circle)
      s = ['  ', ic_line(14, 36, 26, 36, k), sprintf('<path d="M23 32 L30 36 L23 40 Z" fill="%s"/>', k), ...
        sprintf('<circle cx="48" cy="36" r="10" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        ic_line(43, 36, 53, 36, k)]; return
    case 'VCC' % V-controlled C-source (Modelica: sense arrow -> source circle + i-arrow)
      s = ['  ', ic_line(14, 36, 26, 36, k), sprintf('<path d="M23 32 L30 36 L23 40 Z" fill="%s"/>', k), ...
        sprintf('<circle cx="48" cy="36" r="10" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        ic_line(48, 43, 48, 31, k), sprintf('<path d="M45 34 L48 29 L51 34 Z" fill="%s"/>', k)]; return
    case 'CCV' % current-controlled voltage source: sense loop -> source circle
      s = ['  ', sprintf('<circle cx="22" cy="36" r="7" fill="none" stroke="%s" stroke-width="1.5"/>', k), ...
        sprintf('<path d="M22 43 L18 39 M22 43 L26 39" fill="none" stroke="%s" stroke-width="1.5"/>', k), ...
        sprintf('<circle cx="48" cy="36" r="10" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        ic_line(43, 36, 53, 36, k)]; return
    case 'CCC' % current-controlled current source: sense loop -> source circle + i-arrow
      s = ['  ', sprintf('<circle cx="22" cy="36" r="7" fill="none" stroke="%s" stroke-width="1.5"/>', k), ...
        sprintf('<path d="M22 43 L18 39 M22 43 L26 39" fill="none" stroke="%s" stroke-width="1.5"/>', k), ...
        sprintf('<circle cx="48" cy="36" r="10" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        ic_line(48, 42, 48, 30, k), sprintf('<path d="M45 33 L48 28 L51 33 Z" fill="%s"/>', k)]; return
    case 'ZDiode' % diode triangle + a bent (Zener) cathode bar
      s = ['  ', ic_line(14, 36, 28, 36, k), ...
        sprintf('<path d="M28 28 L28 44 L44 36 Z" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        sprintf('<path d="M40 28 L44 28 L44 44 L48 44" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        ic_line(44, 36, 58, 36, k)]; return
    case 'NPN' % bipolar transistor: base bar, collector/emitter leads, arrow out
      s = ['  ', ic_line(12, 36, 30, 36, k), ...
        sprintf('<line x1="30" y1="26" x2="30" y2="46" stroke="%s" stroke-width="3"/>', k), ...
        ic_line(30, 32, 50, 22, k), ic_line(30, 40, 50, 50, k), ...
        sprintf('<path d="M42 42 L50 50 L44 44 Z" fill="%s"/>', k)]; return
    case 'PNP' % bipolar transistor: base bar, collector/emitter leads, arrow in
      s = ['  ', ic_line(12, 36, 30, 36, k), ...
        sprintf('<line x1="30" y1="26" x2="30" y2="46" stroke="%s" stroke-width="3"/>', k), ...
        ic_line(30, 32, 50, 22, k), ic_line(30, 40, 50, 50, k), ...
        sprintf('<path d="M30 40 L38 44 L36 36 Z" fill="%s"/>', k)]; return
    case 'NMOS' % MOSFET: gate lead + separate gate bar + channel bar, arrow in
      s = ['  ', ic_line(12, 36, 24, 36, k), ...
        sprintf('<line x1="24" y1="27" x2="24" y2="45" stroke="%s" stroke-width="2"/>', k), ...
        sprintf('<line x1="30" y1="26" x2="30" y2="46" stroke="%s" stroke-width="3"/>', k), ...
        ic_line(30, 30, 50, 22, k), ic_line(30, 42, 50, 50, k), ...
        sprintf('<path d="M38 46 L30 42 L37 39 Z" fill="%s"/>', k)]; return
    case 'PMOS' % MOSFET: gate lead + separate gate bar + channel bar, arrow out
      s = ['  ', ic_line(12, 36, 24, 36, k), ...
        sprintf('<line x1="24" y1="27" x2="24" y2="45" stroke="%s" stroke-width="2"/>', k), ...
        sprintf('<line x1="30" y1="26" x2="30" y2="46" stroke="%s" stroke-width="3"/>', k), ...
        ic_line(30, 30, 50, 22, k), ic_line(30, 42, 50, 50, k), ...
        sprintf('<path d="M30 42 L38 46 L37 39 Z" fill="%s"/>', k)]; return
    case 'EMF' % motor circle: electrical terminals left, rotational shaft right
      s = ['  ', ic_line(10, 30, 22, 30, k), ic_line(10, 42, 22, 42, k), ...
        sprintf('<circle cx="34" cy="36" r="12" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        ic_line(28, 36, 40, 36, k), ic_line(46, 36, 58, 36, k)]; return
    case 'TranslationalEMF' % motor circle with a translational flange bar right
      s = ['  ', ic_line(10, 30, 22, 30, k), ic_line(10, 42, 22, 42, k), ...
        sprintf('<circle cx="34" cy="36" r="12" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        ic_line(28, 36, 40, 36, k), ic_line(46, 36, 54, 36, k), ic_line(54, 30, 54, 42, k)]; return
    case 'HeatingResistor' % resistor box with a heat arrow to the thermal port
      s = ['  ', ic_line(14, 36, 22, 36, k), ...
        sprintf('<rect x="22" y="26" width="28" height="16" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        ic_line(50, 36, 58, 36, k), ...
        ic_line(36, 42, 36, 52, k), sprintf('<path d="M32 48 L36 56 L40 48 Z" fill="%s"/>', k)]; return
    case 'IdealTransformer' % two coupled coils with a core between them
      s = ['  ', ic_coil(28, k), ic_coil_r(44, k), ...
        ic_line(36, 24, 36, 48, k)]; return
    case 'Gyrator' % Modelica: a two-port box labelled G1 (top) / G2 (bottom)
      s = ['  ', ic_glyph_text(36, 32, 'G1', 12, k), ic_glyph_text(36, 51, 'G2', 12, k)]; return
    case 'Rod' % rigid massless bar with end caps
      s = ['  ', ic_line(16, 30, 16, 42, k), ic_line(16, 36, 56, 36, k), ...
        ic_line(56, 30, 56, 42, k)]; return
    case 'Lever' % bar pivoting on a fulcrum triangle
      s = ['  ', ic_line(16, 30, 56, 42, k), ...
        sprintf('<path d="M32 46 L40 46 L36 38 Z" fill="none" stroke="%s" stroke-width="2"/>', k)]; return
    case 'SlidingMass' % a mass box on a hatched rail (distinct from plain Mass)
      s = ['  ', sprintf('<rect x="24" y="22" width="24" height="16" rx="2" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        ic_line(16, 44, 56, 44, k), ...
        ic_line(20, 44, 16, 50, k), ic_line(28, 44, 24, 50, k), ic_line(36, 44, 32, 50, k), ...
        ic_line(44, 44, 40, 50, k), ic_line(52, 44, 48, 50, k)]; return
    case 'MassWithWeight' % a mass box with a downward gravity/weight arrow
      s = ['  ', sprintf('<rect x="22" y="18" width="24" height="16" rx="2" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        ic_line(34, 36, 34, 50, k), sprintf('<path d="M30 46 L34 54 L38 46 Z" fill="%s"/>', k)]; return
    case {'LinearSpeedDependentForce', 'LinearSpeedDependentTorque'} % dashpot to ground
      s = ['  ', ic_line(12, 34, 26, 34, k), ...
        sprintf('<rect x="26" y="28" width="14" height="12" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        ic_line(34, 28, 34, 40, k), ic_line(40, 34, 50, 34, k), ic_ground_hatch(50, k)]; return
    case {'QuadraticSpeedDependentForce', 'QuadraticSpeedDependentTorque'} % dashpot to ground, quadratic
      s = ['  ', ic_line(12, 34, 24, 34, k), ...
        sprintf('<rect x="24" y="28" width="13" height="12" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        ic_line(31, 28, 31, 40, k), ic_line(37, 34, 46, 34, k), ic_ground_hatch(46, k), ...
        ic_glyph_text(56, 26, '&#178;', 13, k)]; return
    case 'Pulley' % a belt wheel (distinct from the toothed gear)
      s = ['  ', sprintf('<circle cx="36" cy="38" r="13" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        sprintf('<circle cx="36" cy="38" r="9" fill="none" stroke="%s" stroke-width="1.5"/>', k), ...
        sprintf('<circle cx="36" cy="38" r="2.5" fill="%s"/>', k), ...
        ic_line(14, 30, 58, 30, k)]; return
    case {'SpringDamper', 'RotSpringDamper'} % a parallel spring (top) + dashpot
      s = ['  ', ic_line(14, 36, 20, 36, k), ic_line(52, 36, 58, 36, k), ...
        ic_line(20, 26, 20, 46, k), ic_line(52, 26, 52, 46, k), ...
        sprintf(['<path d="M20 26 L24 20 L28 32 L32 20 L36 32 L40 20 L44 32 L48 20 L52 26" ', ...
          'fill="none" stroke="%s" stroke-width="1.5"/>'], k), ...
        ic_line(20, 46, 30, 46, k), ...
        sprintf('<rect x="30" y="41" width="12" height="10" fill="none" stroke="%s" stroke-width="1.5"/>', k), ...
        ic_line(36, 41, 36, 51, k), ic_line(42, 46, 52, 46, k)]; return
    case 'RelPositionSensor' % mechanical sensor: Modelica box style
      s = ['  ', ic_sensor_box('&#916;x', 12, k)]; return
    case 'RelSpeedSensor'
      s = ['  ', ic_sensor_box('&#916;v', 12, k)]; return
    case 'RelAngleSensor'
      s = ['  ', ic_sensor_box('&#916;&#966;', 12, k)]; return
    case 'RelRotSpeedSensor'
      s = ['  ', ic_sensor_box('&#916;&#969;', 12, k)]; return
    case 'PotentialSensor' % electrical sensor: keep the Modelica dial gauge
      s = ['  ', ic_sensor_circle(k), ic_glyph_text(36, 41, '&#966;', 14, k)]; return
    case 'RotSpeedSensor'
      s = ['  ', ic_sensor_box('&#969;', 14, k)]; return
    case 'AngleSensor'
      s = ['  ', ic_sensor_box('&#966;', 14, k)]; return
    case 'TemperatureSensor' % thermal sensor: Modelica thermometer
      s = ['  ', ic_thermometer(k)]; return
    case 'RelTemperatureSensor'
      s = ['  ', ic_thermometer(k), ic_glyph_text(50, 30, '&#916;', 12, k)]; return
    case 'SineVoltage' % voltage source circle + a sine waveform
      s = ['  ', ic_sensor_circle(k), ic_wave_sine(k)]; return
    case 'SineCurrent' % current source circle + a sine waveform + direction arrow
      s = ['  ', ic_sensor_circle(k), ic_wave_sine(k), ...
        sprintf('<path d="M33 26 L36 21 L39 26 Z" fill="%s"/>', k)]; return
    case 'ExpSineVoltage' % source circle + a decaying sine waveform
      s = ['  ', ic_sensor_circle(k), ic_wave_expsine(k)]; return
    case 'ExpSineCurrent'
      s = ['  ', ic_sensor_circle(k), ic_wave_expsine(k), ...
        sprintf('<path d="M33 26 L36 21 L39 26 Z" fill="%s"/>', k)]; return
    case 'TrapezoidVoltage' % source circle + a trapezoid waveform
      s = ['  ', ic_sensor_circle(k), ic_wave_trap(k)]; return
    case 'TrapezoidCurrent'
      s = ['  ', ic_sensor_circle(k), ic_wave_trap(k), ...
        sprintf('<path d="M33 26 L36 21 L39 26 Z" fill="%s"/>', k)]; return
    case 'RampVoltage' % source circle + a rising ramp waveform
      s = ['  ', ic_sensor_circle(k), ic_wave_ramp(k)]; return
    case 'RampCurrent' % source circle + a rising ramp waveform + direction arrow
      s = ['  ', ic_sensor_circle(k), ic_wave_ramp(k), ...
        sprintf('<path d="M33 26 L36 21 L39 26 Z" fill="%s"/>', k)]; return
    case 'Convection' % Modelica: a hatched wall with convection flow arrows
      s = ['  ', ic_hatch(18, 24, 11, 24, k, 'hc'), ...
        ic_line(33, 31, 52, 31, k), sprintf('<path d="M49 28 L56 31 L49 34 Z" fill="%s"/>', k), ...
        ic_line(33, 41, 52, 41, k), sprintf('<path d="M49 38 L56 41 L49 44 Z" fill="%s"/>', k)]; return
    case 'BodyRadiation' % Modelica: a hatched wall radiating heat arrows
      s = ['  ', ic_hatch(18, 24, 11, 24, k, 'hc'), ...
        ic_line(33, 30, 52, 30, k), sprintf('<path d="M49 27 L56 30 L49 33 Z" fill="%s"/>', k), ...
        ic_line(33, 36, 52, 36, k), sprintf('<path d="M49 33 L56 36 L49 39 Z" fill="%s"/>', k), ...
        ic_line(33, 42, 52, 42, k), sprintf('<path d="M49 39 L56 42 L49 45 Z" fill="%s"/>', k)]; return
    case 'HeatCapacitor' % Modelica: a lump of thermal mass with a heat port
      s = ['  ', sprintf(['<path d="M30 20 Q19 24 22 34 Q18 46 31 48 Q43 50 48 41 ', ...
        'Q52 31 45 23 Q39 18 30 20 Z" fill="none" stroke="%s" stroke-width="2"/>'], k), ...
        ic_line(31, 48, 31, 55, k)]; return
    case 'ThermalConductor' % Modelica: a hatched solid conductor block
      s = ['  ', ic_hatch(22, 26, 28, 20, k, 'hc'), ic_glyph_text(58, 31, 'G', 10, k)]; return
    case 'ThermalResistor' % Modelica: a hatched solid resistor block
      s = ['  ', ic_hatch(22, 26, 28, 20, k, 'hc'), ic_glyph_text(58, 31, 'R', 10, k)]; return
    case 'ConvectiveResistor' % hatched wall with convection arrows + label
      s = ['  ', ic_hatch(18, 24, 11, 24, k, 'hc'), ...
        ic_line(33, 36, 52, 36, k), sprintf('<path d="M49 33 L56 36 L49 39 Z" fill="%s"/>', k), ...
        ic_glyph_text(43, 30, 'h', 10, k)]; return
    case 'FixedTemperature' % Modelica: a hatched temperature boundary + T
      s = ['  ', ic_hatch(20, 24, 26, 24, k, 'hc'), ic_glyph_text(56, 41, 'T', 13, k)]; return
    case 'PrescribedTemperature' % signal-driven temperature boundary + T
      s = ['  ', ic_hatch(20, 24, 26, 24, k, 'hc'), ic_glyph_text(56, 41, 'T', 13, k), ic_wave(k)]; return
    case 'FixedHeatFlow' % Modelica: heat-flow arrows into the port
      s = ['  ', ic_line(14, 30, 44, 30, k), sprintf('<path d="M40 26 L48 30 L40 34 Z" fill="%s"/>', k), ...
        ic_line(14, 42, 44, 42, k), sprintf('<path d="M40 38 L48 42 L40 46 Z" fill="%s"/>', k)]; return
    case 'PrescribedHeatFlow' % signal-driven heat-flow source
      s = ['  ', ic_line(14, 30, 44, 30, k), sprintf('<path d="M40 26 L48 30 L40 34 Z" fill="%s"/>', k), ...
        ic_line(14, 42, 44, 42, k), sprintf('<path d="M40 38 L48 42 L40 46 Z" fill="%s"/>', k), ic_wave(k)]; return
    case 'Force2' % equal/opposite force between two flanges (signal-driven)
      s = ['  ', ic_line(20, 36, 52, 36, k), ...
        sprintf('<path d="M22 30 L12 36 L22 42 Z" fill="%s"/>', k), ...
        sprintf('<path d="M50 30 L60 36 L50 42 Z" fill="%s"/>', k), ic_wave(k)]; return
    case 'Torque2' % equal/opposite torque between two flanges (signal-driven)
      s = ['  ', sprintf('<path d="M34 22 A13 13 0 0 0 21 34" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        sprintf('<path d="M16 32 L21 40 L26 33 Z" fill="%s"/>', k), ...
        sprintf('<path d="M38 22 A13 13 0 0 1 51 34" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        sprintf('<path d="M46 33 L51 40 L56 32 Z" fill="%s"/>', k), ic_wave(k)]; return
    case 'Force' % translational force: application bar + right arrow (signal-driven)
      s = ['  ', ic_line(16, 24, 16, 48, k), ic_line(16, 36, 46, 36, k), ...
        sprintf('<path d="M42 29 L56 36 L42 43 Z" fill="%s"/>', k), ic_wave(k)]; return
    case 'ConstantForce' % constant force: application bar + right arrow + tail dot
      s = ['  ', ic_line(16, 24, 16, 48, k), ic_line(16, 36, 46, 36, k), ...
        sprintf('<path d="M42 29 L56 36 L42 43 Z" fill="%s"/>', k), ...
        sprintf('<circle cx="16" cy="36" r="2.5" fill="%s"/>', k)]; return
    case 'SineForce' % force arrow + a sine trace below (time-varying force)
      s = ['  ', ic_line(16, 22, 16, 44, k), ic_line(16, 33, 46, 33, k), ...
        sprintf('<path d="M42 26 L56 33 L42 40 Z" fill="%s"/>', k), ...
        sprintf(['<path d="M14 54 q3 -6 6 0 q3 6 6 0 q3 -6 6 0" fill="none" ', ...
          'stroke="%s" stroke-width="1.5"/>'], k)]; return
    case 'RampForce' % force arrow + a rising ramp trace below
      s = ['  ', ic_line(16, 22, 16, 44, k), ic_line(16, 33, 46, 33, k), ...
        sprintf('<path d="M42 26 L56 33 L42 40 Z" fill="%s"/>', k), ...
        sprintf('<path d="M14 56 L22 56 L34 48" fill="none" stroke="%s" stroke-width="1.5"/>', k)]; return
    case 'SineTorque' % torque arc + a sine trace below
      s = ['  ', ic_torque_arc(k), ...
        sprintf(['<path d="M14 56 q3 -5 6 0 q3 5 6 0 q3 -5 6 0" fill="none" ', ...
          'stroke="%s" stroke-width="1.5"/>'], k)]; return
    case 'RampTorque' % torque arc + a rising ramp trace below
      s = ['  ', ic_torque_arc(k), ...
        sprintf('<path d="M14 58 L22 58 L34 50" fill="none" stroke="%s" stroke-width="1.5"/>', k)]; return
    case 'ExpSineForce' % force arrow + a decaying-sine trace below
      s = ['  ', ic_line(16, 22, 16, 44, k), ic_line(16, 33, 46, 33, k), ...
        sprintf('<path d="M42 26 L56 33 L42 40 Z" fill="%s"/>', k), ...
        sprintf(['<path d="M14 54 q2 -6 4 0 q2 5 4 0 q2 -4 4 0 q2 3 4 0" fill="none" ', ...
          'stroke="%s" stroke-width="1.5"/>'], k)]; return
    case 'TrapezoidForce' % force arrow + a trapezoid trace below
      s = ['  ', ic_line(16, 22, 16, 44, k), ic_line(16, 33, 46, 33, k), ...
        sprintf('<path d="M42 26 L56 33 L42 40 Z" fill="%s"/>', k), ...
        sprintf('<path d="M14 56 L19 50 L27 50 L32 56" fill="none" stroke="%s" stroke-width="1.5"/>', k)]; return
    case 'ExpSineTorque' % torque arc + a decaying-sine trace below
      s = ['  ', ic_torque_arc(k), ...
        sprintf(['<path d="M14 56 q2 -5 4 0 q2 4 4 0 q2 -3 4 0 q2 2 4 0" fill="none" ', ...
          'stroke="%s" stroke-width="1.5"/>'], k)]; return
    case 'TrapezoidTorque' % torque arc + a trapezoid trace below
      s = ['  ', ic_torque_arc(k), ...
        sprintf('<path d="M14 58 L19 52 L27 52 L32 58" fill="none" stroke="%s" stroke-width="1.5"/>', k)]; return
    case 'Accelerate' % prescribed linear accel: mass box + double chevron
      s = ['  ', sprintf('<rect x="16" y="28" width="16" height="16" rx="2" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        sprintf('<path d="M38 29 L47 36 L38 43" fill="none" stroke="%s" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>', k), ...
        sprintf('<path d="M47 29 L56 36 L47 43" fill="none" stroke="%s" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>', k)]; return
    case 'Speed' % prescribed linear velocity: mass box + single chevron
      s = ['  ', sprintf('<rect x="16" y="28" width="16" height="16" rx="2" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        sprintf('<path d="M42 29 L51 36 L42 43" fill="none" stroke="%s" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>', k), ...
        ic_line(38, 36, 51, 36, k)]; return
    case 'ConstantSpeed' % constant linear velocity: mass box + arrow + tail dot
      s = ['  ', sprintf('<rect x="16" y="28" width="16" height="16" rx="2" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        ic_line(36, 36, 52, 36, k), sprintf('<path d="M48 32 L56 36 L48 40 Z" fill="%s"/>', k), ...
        sprintf('<circle cx="36" cy="36" r="2" fill="%s"/>', k)]; return
    case 'RotSpeed' % prescribed angular velocity: curved arrow + single head
      s = ['  ', sprintf('<path d="M36 22 A14 14 0 1 1 22 36" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        sprintf('<path d="M16 39 L22 30 L28 39 Z" fill="%s"/>', k)]; return
    case 'ConstantRotSpeed' % constant angular velocity: curved arrow + head + hub dot
      s = ['  ', sprintf('<path d="M36 22 A14 14 0 1 1 22 36" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        sprintf('<path d="M16 39 L22 30 L28 39 Z" fill="%s"/>', k), ...
        sprintf('<circle cx="36" cy="36" r="2.5" fill="%s"/>', k)]; return
    case 'ElastoGap' % contact spring against a wall across a gap
      s = ['  ', ic_line(12, 36, 18, 36, k), ...
        sprintf(['<path d="M18 36 L22 30 L26 42 L30 30 L34 42 L38 36" ', ...
          'fill="none" stroke="%s" stroke-width="2"/>'], k), ...
        ic_line(38, 36, 42, 36, k), ...
        ic_line(48, 26, 48, 46, k), ic_line(48, 46, 44, 50, k), ic_line(54, 26, 50, 30, k)]; return
    case 'ElastoBacklash' % spring with a central play gap (two brackets)
      s = ['  ', ic_line(12, 36, 18, 36, k), ...
        sprintf(['<path d="M18 36 L21 30 L24 42 L27 33 L30 36" ', ...
          'fill="none" stroke="%s" stroke-width="2"/>'], k), ...
        sprintf('<path d="M33 30 L30 30 L30 42 L33 42" fill="none" stroke="%s" stroke-width="1.5"/>', k), ...
        sprintf('<path d="M39 30 L42 30 L42 42 L39 42" fill="none" stroke="%s" stroke-width="1.5"/>', k), ...
        sprintf(['<path d="M42 36 L45 33 L48 42 L51 30 L54 36" ', ...
          'fill="none" stroke="%s" stroke-width="2"/>'], k), ic_line(54, 36, 58, 36, k)]; return
    case 'Torque' % rotational torque: curved arrow (signal-driven)
      s = ['  ', ic_torque_arc(k), ic_wave(k)]; return
    case 'ConstantTorque' % constant torque: curved arrow
      s = ['  ', ic_torque_arc(k)]; return
    case 'RotAccelerate' % prescribed angular accel: curved arrow + double head
      s = ['  ', sprintf('<path d="M36 22 A14 14 0 1 1 22 36" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        sprintf('<path d="M16 37 L22 29 L28 37 Z" fill="%s"/>', k), ...
        sprintf('<path d="M18 45 L24 37 L30 45 Z" fill="%s"/>', k)]; return
    case 'Inertia' % rotational inertia: a rotor cylinder (capsule) on a through-shaft
      % (Modelica draws a cylinder, not a translational mass box).
      s = ['  ', ic_line(10, 36, 24, 36, k), ic_line(48, 36, 62, 36, k), ...
        sprintf('<rect x="24" y="24" width="24" height="24" rx="7" fill="none" stroke="%s" stroke-width="2"/>', k)]; return
    case 'BearingFriction' % Modelica: the inertia cylinder on a fixed hatched bearing
      s = ['  ', ic_line(10, 30, 22, 30, k), ic_line(50, 30, 62, 30, k), ...
        sprintf('<rect x="22" y="20" width="28" height="20" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        ic_line(36, 40, 36, 46, k), ic_line(26, 46, 46, 46, k), ...
        ic_line(29, 46, 25, 52, k), ic_line(35, 46, 31, 52, k), ...
        ic_line(41, 46, 37, 52, k), ic_line(47, 46, 43, 52, k)]; return
    case 'Freewheel' % one-way clutch: two flange stubs + a ratchet arc with an arrow
      s = ['  ', ic_line(10, 36, 24, 36, k), ic_line(44, 36, 58, 36, k), ...
        sprintf('<path d="M24 28 A10 10 0 1 1 24 44" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        sprintf('<path d="M20 30 L24 24 L28 30 Z" fill="%s"/>', k), ...
        sprintf('<path d="M40 30 L44 36 L40 42" fill="none" stroke="%s" stroke-width="2" stroke-linecap="round"/>', k)]; return
    case 'Brake' % flange clamped by two brake pads (signal-actuated)
      s = ['  ', ic_line(10, 36, 58, 36, k), ...
        sprintf('<rect x="28" y="22" width="12" height="9" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        sprintf('<rect x="28" y="41" width="12" height="9" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        ic_wave(k)]; return
    case 'RotBrake' % a brake disc gripped by two pads (signal-actuated)
      s = ['  ', sprintf('<circle cx="34" cy="36" r="12" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        ic_line(46, 36, 58, 36, k), ...
        sprintf('<rect x="28" y="18" width="12" height="7" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        sprintf('<rect x="28" y="47" width="12" height="7" fill="none" stroke="%s" stroke-width="2"/>', k)]; return
  end
  % --- base symbol by kind + modifier glyphs --------------------------------
  s = ic_base_symbol(kind, k);
  if isempty(s)
    return
  end
  mods = '';
  if numel(kind) >= 8 && strcmp(kind(1:8), 'variable')
    mods = [mods, ic_vararrow(k)]; % variable component: a slash arrow
  end
  if strcmp(kind, 'conductor') || strcmp(kind, 'variableConductor')
    mods = [mods, ic_glyph_text(52, 28, 'G', 11, k)]; % conductance, not resistance
  end
  if ~isempty(c.signalIn)
    mods = [mods, ic_wave(k)]; % signal-driven source / boundary
  end
  s = [s, mods];
end
%=============================================================================
function s = ic_diamond(k)
  s = sprintf('<path d="M36 22 L50 36 L36 50 L22 36 Z" fill="none" stroke="%s" stroke-width="2"/>', k);
end
function s = ic_coil(cx, k)
  s = sprintf(['<path d="M%d 30 a4 4 0 0 1 0 12 a4 4 0 0 1 0 -12" fill="none" ', ...
    'stroke="%s" stroke-width="2"/>'], cx, k);
end
function s = ic_coil_r(cx, k)
  s = sprintf(['<path d="M%d 30 a4 4 0 0 0 0 12 a4 4 0 0 0 0 -12" fill="none" ', ...
    'stroke="%s" stroke-width="2"/>'], cx, k);
end
function s = ic_sensor_circle(k)
  s = sprintf('<circle cx="36" cy="36" r="14" fill="none" stroke="%s" stroke-width="2"/>', k);
end
function s = ic_sensor_box(t, fs, k)
  % Modelica mechanical-sensor style: a rectangular housing with the measured
  % quantity symbol inside (electrical/thermal-flow sensors keep the dial).
  s = [sprintf('<rect x="19" y="26" width="34" height="20" rx="2" fill="none" stroke="%s" stroke-width="2"/>', k), ...
    sprintf(['<text x="36" y="41" text-anchor="middle" font-family="Georgia,serif" ', ...
      'font-size="%d" fill="%s">%s</text>'], fs, k, t)];
end
function s = ic_thermometer(k)
  % Modelica temperature-sensor style: a bulb thermometer (tube + filled bulb).
  s = [sprintf('<rect x="32" y="18" width="8" height="22" rx="4" fill="none" stroke="%s" stroke-width="2"/>', k), ...
    sprintf('<rect x="34" y="24" width="4" height="18" fill="%s"/>', k), ...
    sprintf('<circle cx="36" cy="45" r="6" fill="%s"/>', k)];
end
function s = ic_hatch(x, y, w, h, k, id)
  % Modelica thermal-material style: an outlined block filled with 45-degree
  % hatching (a solid conductor / boundary). `id` disambiguates the clip path.
  lines = {};
  for d = -h:6:w
    lines{end + 1} = sprintf('<line x1="%g" y1="%g" x2="%g" y2="%g" stroke="%s" stroke-width="1"/>', ...
      x + d, y, x + d + h, y + h, k); %#ok<AGROW>
  end
  s = [sprintf('<clipPath id="%s"><rect x="%g" y="%g" width="%g" height="%g"/></clipPath>', id, x, y, w, h), ...
    sprintf('<g clip-path="url(#%s)">%s</g>', id, strjoin(lines, '')), ...
    sprintf('<rect x="%g" y="%g" width="%g" height="%g" fill="none" stroke="%s" stroke-width="2"/>', x, y, w, h, k)];
end
function s = ic_glyph_text(x, y, t, fs, k)
  s = sprintf(['<text x="%g" y="%g" text-anchor="middle" font-family="Georgia,serif" ', ...
    'font-size="%d" fill="%s">%s</text>'], x, y, fs, k, t);
end
function s = ic_vararrow(k)
  s = [sprintf('<line x1="18" y1="52" x2="54" y2="22" stroke="%s" stroke-width="1.5"/>', k), ...
    sprintf('<path d="M49 22 L54 22 L54 27 Z" fill="%s"/>', k)];
end
function s = ic_wave(k)
  s = sprintf(['<path d="M22 54 q3 -6 6 0 q3 6 6 0 q3 -6 6 0" fill="none" ', ...
    'stroke="%s" stroke-width="1.5"/>'], k);
end
function s = ic_wave_sine(k)
  s = sprintf(['<path d="M27 36 q2.5 -6 5 0 q2.5 6 5 0 q2.5 -6 5 0" fill="none" ', ...
    'stroke="%s" stroke-width="1.5"/>'], k);
end
function s = ic_wave_pulse(k)
  s = sprintf(['<path d="M27 40 L27 32 L33 32 L33 40 L39 40 L39 32 L45 32 L45 40" ', ...
    'fill="none" stroke="%s" stroke-width="1.5"/>'], k);
end
function s = ic_wave_expsine(k)
  % a decaying sine: shrinking humps left-to-right.
  s = sprintf(['<path d="M27 36 q2 -6 4 0 q2 5 4 0 q2 -4 4 0 q2 3 4 0" fill="none" ', ...
    'stroke="%s" stroke-width="1.5"/>'], k);
end
function s = ic_wave_trap(k)
  s = sprintf(['<path d="M26 40 L31 32 L41 32 L46 40" fill="none" ', ...
    'stroke="%s" stroke-width="1.5"/>'], k);
end
function s = ic_wave_ramp(k)
  % a flat baseline that breaks into a rising straight line: the ramp symbol.
  s = sprintf(['<path d="M26 40 L34 40 L46 30" fill="none" ', ...
    'stroke="%s" stroke-width="1.5"/>'], k);
end
function s = ic_torque_arc(k)
  % ~270 deg clockwise arc (top -> right -> bottom -> left) with an up arrowhead
  % at the left end: the conventional torque / angular symbol.
  s = [sprintf('<path d="M36 22 A14 14 0 1 1 22 36" fill="none" stroke="%s" stroke-width="2"/>', k), ...
    sprintf('<path d="M16 39 L22 30 L28 39 Z" fill="%s"/>', k)];
end
function s = ic_ground_hatch(x, k)
  % A small fixed-ground symbol: a vertical bar with three diagonal hatches.
  s = [ic_line(x, 26, x, 42, k), ...
    ic_line(x, 42, x - 5, 48, k), ic_line(x + 5, 42, x, 48, k), ic_line(x + 10, 42, x + 5, 48, k)];
end
%=============================================================================
function s = ic_base_symbol(kind, k)
  % Clean-room textbook symbols composed from SVG primitives. Returns '' for
  % kinds without a bespoke symbol (a labelled fallback is used instead).
  s = '';
  switch kind
    case {'resistor', 'conductor', 'variableResistor', 'variableConductor'}
      s = ['  ', ic_line(14, 36, 22, 36, k), ...
        sprintf('<rect x="22" y="28" width="28" height="16" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        ic_line(50, 36, 58, 36, k)];
    case {'capacitor', 'variableCapacitor'}
      s = ['  ', ic_line(14, 36, 32, 36, k), ic_line(32, 22, 32, 50, k), ...
        ic_line(40, 22, 40, 50, k), ic_line(40, 36, 58, 36, k)];
    case {'inductor', 'variableInductor'}
      s = ['  ', ic_line(14, 36, 22, 36, k), ...
        sprintf(['<path d="M22 36 a4 4 0 0 1 8 0 a4 4 0 0 1 8 0 a4 4 0 0 1 8 0" ', ...
          'fill="none" stroke="%s" stroke-width="2"/>'], k), ...
        ic_line(46, 36, 58, 36, k)];
    case 'vsource' % Modelica: circle + horizontal diameter line, + / - at terminals
      s = ['  ', sprintf('<circle cx="36" cy="36" r="14" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        ic_line(22, 36, 50, 36, k), ...
        ic_glyph_text(27, 31, '+', 12, k), ic_glyph_text(45, 31, '&#8722;', 12, k)];
    case 'isource'
      s = ['  ', sprintf('<circle cx="36" cy="36" r="14" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        ic_line(36, 44, 36, 28, k), ...
        sprintf('<path d="M32 33 L36 27 L40 33 Z" fill="%s"/>', k)];
    case 'diode'
      s = ['  ', ic_line(14, 36, 28, 36, k), ...
        sprintf('<path d="M28 28 L28 44 L44 36 Z" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        ic_line(44, 28, 44, 44, k), ic_line(44, 36, 58, 36, k)];
    case 'opAmp' % Modelica: a triangle with - (top) / + (bottom) inputs
      s = ['  ', sprintf('<path d="M26 22 L26 50 L50 36 Z" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        ic_glyph_text(31, 32, '&#8722;', 11, k), ic_glyph_text(31, 47, '+', 11, k)];
    case 'ground'
      s = ['  ', ic_line(36, 20, 36, 40, k), ...
        ic_line(26, 40, 46, 40, k), ic_line(29, 46, 43, 46, k), ...
        ic_line(32, 52, 40, 52, k)];
    case 'short'
      s = ['  ', ic_line(14, 36, 58, 36, k)];
    case 'idle'
      s = ['  ', ic_line(14, 36, 30, 36, k), ic_line(42, 36, 58, 36, k)];
    case 'switch'
      s = ['  ', ic_line(14, 36, 26, 36, k), ...
        sprintf('<circle cx="26" cy="36" r="2" fill="%s"/>', k), ...
        ic_line(26, 36, 46, 26, k), ...
        sprintf('<circle cx="46" cy="36" r="2" fill="%s"/>', k), ...
        ic_line(46, 36, 58, 36, k)];
    case {'currentSensor', 'voltageSensor', 'potentialSensor'}
      lbl = 'V';
      if strcmp(kind, 'currentSensor'); lbl = 'I'; end
      s = ['  ', sprintf('<circle cx="36" cy="36" r="14" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        sprintf(['<text x="36" y="41" text-anchor="middle" font-family="Georgia,serif" ', ...
          'font-size="14" fill="%s">%s</text>'], k, lbl)];
    case {'transformer', 'gyrator'}
      s = ['  ', sprintf('<circle cx="30" cy="36" r="10" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        sprintf('<circle cx="42" cy="36" r="10" fill="none" stroke="%s" stroke-width="2"/>', k)];
    case 'radiation'
      s = ['  ', sprintf(['<path d="M18 44 q6 -8 12 0 q6 8 12 0 q6 -8 12 0" ', ...
        'fill="none" stroke="%s" stroke-width="2"/>'], k), ...
        sprintf(['<path d="M18 30 q6 -8 12 0 q6 8 12 0 q6 -8 12 0" ', ...
        'fill="none" stroke="%s" stroke-width="2"/>'], k)];
    case 'mass'
      s = ['  ', sprintf('<rect x="24" y="26" width="24" height="20" rx="2" fill="none" stroke="%s" stroke-width="2"/>', k)];
    case 'spring'
      s = ['  ', ic_line(14, 36, 22, 36, k), ...
        sprintf(['<path d="M22 36 L26 28 L30 44 L34 28 L38 44 L42 28 L46 36" ', ...
          'fill="none" stroke="%s" stroke-width="2"/>'], k), ic_line(46, 36, 58, 36, k)];
    case 'damper'
      s = ['  ', ic_line(14, 36, 26, 36, k), ...
        sprintf('<rect x="26" y="28" width="16" height="16" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        ic_line(34, 28, 34, 44, k), ic_line(42, 36, 58, 36, k)];
    case 'gear'
      s = ['  ', sprintf('<circle cx="36" cy="36" r="12" fill="none" stroke="%s" stroke-width="2"/>', k), ...
        sprintf('<circle cx="36" cy="36" r="4" fill="%s"/>', k), ...
        ic_line(36, 20, 36, 24, k), ic_line(36, 48, 36, 52, k), ...
        ic_line(20, 36, 24, 36, k), ic_line(48, 36, 52, 36, k)];
    case 'fixed'
      s = ['  ', ic_line(24, 26, 48, 26, k), ...
        ic_line(26, 26, 22, 32, k), ic_line(32, 26, 28, 32, k), ...
        ic_line(38, 26, 34, 32, k), ic_line(44, 26, 40, 32, k), ...
        ic_line(36, 26, 36, 48, k)];
    case 'positionSensor' % mechanical sensor: Modelica box style
      s = ['  ', ic_sensor_box('x', 14, k)];
    case 'speedSensor'
      s = ['  ', ic_sensor_box('v', 14, k)];
    case 'friction'
      s = ['  ', ic_line(18, 46, 54, 46, k), ...
        ic_line(20, 46, 16, 52, k), ic_line(28, 46, 24, 52, k), ...
        ic_line(36, 46, 32, 52, k), ic_line(44, 46, 40, 52, k), ...
        sprintf('<rect x="28" y="26" width="16" height="14" rx="2" fill="none" stroke="%s" stroke-width="2"/>', k)];
    case 'clutch'
      s = ['  ', sprintf(['<path d="M34 22 A14 14 0 0 0 34 50" fill="none" ', ...
        'stroke="%s" stroke-width="2"/>'], k), ...
        sprintf(['<path d="M38 22 A14 14 0 0 1 38 50" fill="none" ', ...
        'stroke="%s" stroke-width="2"/>'], k)];
    otherwise
      s = '';
  end
end
%=============================================================================
function s = ic_label(name, k)
  s = ['  ', sprintf(['<text x="36" y="42" text-anchor="middle" ', ...
    'font-family="Georgia,serif" font-size="22" font-style="italic" ', ...
    'fill="%s">%s</text>'], k, upper(name(1)))];
end
