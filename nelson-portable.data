function varargout = deal(varargin)
  narginchk(1, 1000)
  if (nargin == 1 || nargin == nargout)
    if nargin == 1
      varargout = varargin(ones(1, nargout));
    else
      varargout = varargin;
    end
  else
    error('Nelson:elementary_functions:numberOutputsMatchNumberInputs', 'The number of outputs should match the number of inputs.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = expm1(x)
  narginchk(1, 1);
  nargoutchk(0, 1);
  if ~isreal(x)
    y = exp(x) - 1;
    return
  end
  % Kahan's algorithm: accurate for small x
  u = exp(x);
  y = u - 1;
  m = (u ~= 1) & (y ~= -1) & isfinite(u);
  y(m) = y(m) .* x(m) ./ log(u(m));
  m = (u == 1);
  y(m) = x(m);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function Y = factorial(X)
  if ~isreal(X) || any(fix(X(:)) ~= X(:)) || any(X(:) < 0)
    error('Nelson:elementary_functions:e1InputArgumentRealPositive', '#%d argument: must be real positive integer values.', 1);
  end
  cl = class(X);
  if isa(X, 'int64') || isa(X, 'uint64')
    % 64 bit integers: exact saturated iterative product in the input class
    Y = X;
    mx = intmax(cl);
    for k = 1:numel(X)
      p = ones(1, 1, cl);
      for j = 2:double(X(k))
        p = p * cast(j, cl);
        if p == mx
          break
        end
      end
      Y(k) = p;
    end
    return
  end
  % compute in double precision with an exact cumulative product
  % (bit-exact with the reference implementation, unlike round(gamma(x + 1)) for large values)
  t = [1, 1, cumprod(2:170)];
  Xd = double(X);
  Y = zeros(size(X));
  big = Xd > 170;
  Y(big) = Inf;
  Y(~big) = t(Xd(~big) + 1);
  if ~isdouble(X)
    Y = cast(Y, cl);
  end
end
