function tf = worker_pool_can_inline(code, cmd)
  tf = length(code) + length(cmd) < worker_pool_inline_limit();
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function chunks = worker_pool_chunks(test_cases, nbWorkers)
  nbChunks = min(nbWorkers, length(test_cases));
  chunks = cell(1, nbChunks);
  weights = zeros(1, nbChunks);
  assigned = zeros(1, length(test_cases));
  for k = 1:length(test_cases)
    [~, idx] = min(weights);
    test_cases(k).pool_index = k;
    test_cases(k).worker_pool_used = true;
    assigned(k) = idx;
    weights(idx) = weights(idx) + test_case_weight(test_cases(k));
  end
  for k = 1:nbChunks
    chunk = test_cases(assigned == k);
    chunks{k} = chunk(:);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function worker_pool_cleanup_stale_scripts(maxAgeDays, rootDirInput)
  if nargin == 0
    ageDays = worker_pool_stale_script_age_days();
  else
    ageDays = maxAgeDays;
  end
  if nargin < 2
    rootDir = unittest_tempdir();
  else
    rootDir = rootDirInput;
  end
  files = dir([rootDir, 'nelson_unittest_worker_*.m']);
  threshold = now() - ageDays;
  for k = 1:length(files)
    if ~files(k).isdir && files(k).datenum < threshold
      run_removeFile([rootDir, files(k).name]);
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function test_cases = worker_pool_collect_results(chunks, workers, nativeResults)
  test_cases = [];
  for k = 1:length(chunks)
    test_cases = [test_cases; worker_pool_collect_worker(chunks{k}, nativeResults(k))];
    run_removeFile(workers(k).command_filename);
  end
  test_cases = worker_pool_sort_results(test_cases);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function test_cases = worker_pool_collect_worker(chunk, nativeResult)
  payloads = extractRunfilePayloads(nativeResult.stdout);
  test_cases = chunk;
  for k = 1:length(chunk)
    if k <= length(payloads) && isstruct(payloads(k))
      test_cases(k) = worker_pool_apply_payload(chunk(k), payloads(k), nativeResult);
    else
      test_cases(k) = worker_pool_missing_result(chunk(k), nativeResult);
    end
  end
end
