function selected = run_planCasesForModule(cases, moduleName)
  selected = struct([]);
  for k = 1:length(cases)
    caseModule = run_planSuiteName(cases(k).module);
    if strcmp(caseModule, moduleName)
      selected = [selected; cases(k)];
    end
  end
end
