% LICENCE_BLOCK_END
%=============================================================================
function sol = odeRunSolver(solver, odefun, tspan, y0, yp0, options, nout)
  if nargin < 7
    nout = 1;
  end
  if strcmp(solver, 'autoswitch')
    sol = odeRunAutoSwitchSolver(odefun, tspan, y0, yp0, options, nout);
    return
  end
  problem = odePrepareProblem(solver, odefun, tspan, y0, yp0, options);
  problem.storeRequestedOutputOnly = nout > 1 && length(problem.tspan) > 2;
  if odeIsSundialsSolver(problem.solver)
    if ~odeSundialsAvailable()
      error('Nelson:ode_solvers:sundialsBackendNotAvailable', 'SUNDIALS backend is not available.');
    end
    sol = __ode_sundials_run__(problem);
    sol = odeApplySundialsOutputFcn(problem, sol);
    odeDisplayStats(problem, sol.stats);
    return
  end
  [x, y, slopes, xe, ye, ie, stats] = odeIntegrate(problem);
  sol = odeBuildSolution(problem, x, y, slopes, xe, ye, ie, stats);
  odeDisplayStats(problem, stats);
end
%=============================================================================
function sol = odeApplySundialsOutputFcn(problem, sol)
  if isempty(problem.options.OutputFcn)
    return
  end
  stop = odeCallOutput(problem, problem.tspan, problem.y0, 'init');
  stopIndex = [];
  if stop
    stopIndex = 1;
  else
    for k = 2:length(sol.x)
      stop = odeCallOutput(problem, sol.x(k), sol.y(:, k), '');
      if stop
        stopIndex = k;
        break
      end
    end
  end
  odeCallOutput(problem, [], [], 'done');
  if ~isempty(stopIndex)
    sol = odeTrimSundialsSolution(sol, stopIndex, problem.direction);
  end
end
%=============================================================================
function sol = odeTrimSundialsSolution(sol, stopIndex, direction)
  sol.x = sol.x(1:stopIndex);
  sol.y = sol.y(:, 1:stopIndex);
  if isfield(sol, 'yp')
    sol.yp = sol.yp(:, 1:stopIndex);
  end
  if isfield(sol, 'extdata') && isfield(sol.extdata, 'slopes')
    sol.extdata.slopes = sol.extdata.slopes(:, 1:stopIndex);
  end
  if isfield(sol, 'xe')
    if direction > 0
      keep = sol.xe <= sol.x(end);
    else
      keep = sol.xe >= sol.x(end);
    end
    sol.xe = sol.xe(keep);
    sol.ye = sol.ye(:, keep);
    sol.ie = sol.ie(keep);
  end
end
%=============================================================================
function sol = odeRunAutoSwitchSolver(odefun, tspan, y0, yp0, options, nout)
  nonstiffSolver = 'ode45';
  stiffSolver = 'ode15s';
  problem = odePrepareProblem(nonstiffSolver, odefun, tspan, y0, yp0, options);
  problem.storeRequestedOutputOnly = nout > 1 && length(problem.tspan) > 2;
  problem.autoSwitch = odeAutoSwitchState(nonstiffSolver, stiffSolver);
  [x, y, slopes, xe, ye, ie, stats] = odeIntegrate(problem);
  sol = odeBuildSolution(problem, x, y, slopes, xe, ye, ie, stats);
  sol = odeAnnotateAutoSwitch(sol, stats);
  odeDisplayStats(problem, stats);
end
%=============================================================================
function state = odeAutoSwitchState(nonstiffSolver, stiffSolver)
  state = struct();
  state.enabled = true;
  state.initialSolver = nonstiffSolver;
  state.stiffSolver = stiffSolver;
  state.selectedSolver = nonstiffSolver;
  state.switched = false;
  state.reason = 'nonstiffAccepted';
  state.switchTime = [];
  state.switchCount = 0;
  state.nonstiffCandidateSteps = 0;
  state.mode = 'step';
end
%=============================================================================
function sol = odeAnnotateAutoSwitch(sol, stats)
  sol.solver = stats.autoSwitchSelectedSolver;
  if isfield(sol, 'stats')
    sol.stats.autoSwitchInitialSolver = stats.autoSwitchInitialSolver;
    sol.stats.autoSwitchSelectedSolver = stats.autoSwitchSelectedSolver;
    sol.stats.autoSwitchSwitched = stats.autoSwitchSwitched;
    sol.stats.autoSwitchReason = stats.autoSwitchReason;
    sol.stats.autoSwitchLastReason = stats.autoSwitchLastReason;
    sol.stats.autoSwitchMode = stats.autoSwitchMode;
    sol.stats.autoSwitchSwitchTime = stats.autoSwitchSwitchTime;
    sol.stats.autoSwitchSwitchCount = stats.autoSwitchSwitchCount;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function obj = odeSelectSolver(obj, solver)
  if nargin < 2
    solver = obj.Solver;
  end
  if isempty(solver)
    solver = 'auto';
  end
  solver = odeSolverName(solver);
  requestedSolver = solver;
  useSundials = odeCanUseSundialsAuto(obj);
  switch solver
    case 'auto'
      if useSundials && strcmp(obj.EquationType, 'fullyimplicit')
        obj.SelectedSolver = 'idas';
      elseif useSundials && ~isempty(obj.MassMatrix)
        obj.SelectedSolver = 'cvodesstiff';
      elseif useSundials
        obj.SelectedSolver = 'cvodesnonstiff';
      elseif strcmp(obj.EquationType, 'fullyimplicit')
        obj.SelectedSolver = 'ode15i';
      elseif ~isempty(obj.MassMatrix)
        obj.SelectedSolver = 'ode15s';
      else
        obj.SelectedSolver = 'ode45';
      end
    case 'autoswitch'
      if strcmp(obj.EquationType, 'fullyimplicit')
        error('Nelson:ode_solvers:autoSwitchingSupportedExplicitOdeProblems', 'Auto-switching is only supported for explicit ODE problems.');
      end
      if ~isempty(obj.MassMatrix)
        error('Nelson:ode_solvers:autoSwitchingMassMatricesNotSupported', 'Auto-switching with mass matrices is not supported yet.');
      end
      obj.SelectedSolver = 'autoswitch';
    case 'stiff'
      if useSundials
        obj.SelectedSolver = 'cvodesstiff';
      else
        obj.SelectedSolver = 'ode15s';
      end
    case 'nonstiff'
      if useSundials
        obj.SelectedSolver = 'cvodesnonstiff';
      else
        obj.SelectedSolver = 'ode45';
      end
    otherwise
      obj.SelectedSolver = solver;
  end
  if strcmp(obj.SelectedSolver, 'autoswitch')
    obj.SolverOptions = odeMakeSolverOptions('ode45');
    obj.SelectedSolver = 'autoswitch';
    obj.Solver = requestedSolver;
    return
  end
  if ~odeIsSolverOptions(obj.SolverOptions) ...
      || ~strcmp(obj.SolverOptions.ID, obj.SelectedSolver)
    obj.SolverOptions = odeMakeSolverOptions(obj.SelectedSolver);
    obj.Solver = requestedSolver;
  end
end
%=============================================================================
function tf = odeCanUseSundialsAuto(obj)
  tf = odeSundialsAvailable();
  if ~tf
    return
  end
  if odeHasDirectSensitivity(obj) || odeHasDelayDefinition(obj.DelayDefinition) ...
      || ~isempty(obj.Jacobian) || ~isempty(obj.NonNegativeVariables)
    tf = false;
    return
  end
  if odeIsSolverOptions(obj.SolverOptions) && isprop(obj.SolverOptions, 'OutputFcn') ...
      && ~isempty(obj.SolverOptions.OutputFcn)
    tf = false;
    return
  end
  if ~isempty(obj.MassMatrix) && strcmp(obj.MassMatrix.Singular, 'yes')
    tf = false;
    return
  end
  if ~isempty(obj.EventDefinition) && odeEventUsesCallback(obj.EventDefinition)
    tf = false;
  end
end
%=============================================================================
function tf = odeHasDirectSensitivity(obj)
  tf = ~isempty(obj.Sensitivity) && ~strcmp(obj.Sensitivity.Method, 'adjoint');
end
%=============================================================================
function tf = odeEventUsesCallback(eventDefinition)
  responses = eventDefinition.Response;
  if ischar(responses) || isstring(responses)
    tf = strcmpi(char(responses), 'callback');
  elseif iscell(responses)
    tf = false;
    for k = 1:numel(responses)
      tf = tf || strcmpi(char(responses{k}), 'callback');
    end
  else
    tf = false;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [odefun, y0, yp0, options, restore] = odeSeparateComplexParts(solver, odefun, y0, yp0, options)
  n = length(y0(:));
  restore = struct('StateSize', n, 'Options', options);
  y0 = odeComplexToRealState(y0);
  yp0 = odeComplexToRealOptionalState(yp0);
  options = odeSeparateComplexOptions(options, n);
  isImplicit = strcmp(solver, 'ode15i') || strcmp(solver, 'idas');
  originalFcn = odefun;
  odefun = @(t, y, varargin) odeSeparatedComplexOdeFcn(originalFcn, n, isImplicit, t, y, varargin{:});
end
%=============================================================================
function options = odeSeparateComplexOptions(options, n)
  options.AbsTol = odeDuplicateStateOption(options.AbsTol, n);
  options.InitialSlope = odeComplexToRealOptionalState(options.InitialSlope);
  options.Mass = odeSeparateComplexMatrixOption(options.Mass, n);
  options.Jacobian = odeSeparateComplexMatrixOption(options.Jacobian, n);
  options.JPattern = odeDuplicatePattern(options.JPattern, n);
  options.MvPattern = odeDuplicatePattern(options.MvPattern, n);
  options.NonNegative = options.NonNegative(:);
  if ~isempty(options.OutputSel)
    originalOutputSel = options.OutputSel(:);
    originalOutputFcn = options.OutputFcn;
    options.OutputFcn = @(t, y, flag, varargin) odeSeparatedComplexOutputFcn(...
      originalOutputFcn, n, originalOutputSel, t, y, flag, varargin{:});
    options.OutputSel = [];
  elseif ~isempty(options.OutputFcn)
    originalOutputFcn = options.OutputFcn;
    options.OutputFcn = @(t, y, flag, varargin) odeSeparatedComplexOutputFcn(...
      originalOutputFcn, n, [], t, y, flag, varargin{:});
  end
  if isfield(options, 'EventDefinitionObject')
    options.EventDefinitionObject = odeSeparateComplexEventObject(options.EventDefinitionObject, n);
  elseif ~isempty(options.Events)
    originalEvents = options.Events;
    options.Events = @(t, y, varargin) odeSeparatedComplexEventFcn(originalEvents, n, t, y, varargin{:});
  end
end
%=============================================================================
function z = odeComplexToRealOptionalState(y)
  if isempty(y)
    z = y;
  else
    z = odeComplexToRealState(y);
  end
end
%=============================================================================
function value = odeDuplicateStateOption(value, n)
  if isempty(value) || isscalar(value)
    return
  end
  value = value(:);
  if length(value) == n
    value = [value; value];
  end
end
%=============================================================================
function value = odeSeparateComplexMatrixOption(value, n)
  if isempty(value)
    return
  end
  if isa(value, 'function_handle')
    originalValue = value;
    value = @(t, y, varargin) odeComplexMatrixBlock(...
      originalValue(t, odeRealToComplexState(y, n), varargin{:}), n);
  else
    value = odeComplexMatrixBlock(value, n);
  end
end
%=============================================================================
function pattern = odeDuplicatePattern(pattern, n)
  if isempty(pattern)
    return
  end
  if isequal(size(pattern), [n n])
    pattern = [pattern pattern; pattern pattern];
  end
end
%=============================================================================
function eventDefinition = odeSeparateComplexEventObject(eventDefinition, n)
  if ~isempty(eventDefinition.EventFcn)
    originalEventFcn = eventDefinition.EventFcn;
    eventDefinition.EventFcn = @(t, y, varargin) odeSeparatedComplexEventFcn(...
      originalEventFcn, n, t, y, varargin{:});
  end
  if ~isempty(eventDefinition.CallbackFcn)
    originalCallback = eventDefinition.CallbackFcn;
    eventDefinition.CallbackFcn = @(t, y, index, varargin) odeSeparatedComplexCallback(...
      originalCallback, n, t, y, index, varargin{:});
  end
end
%=============================================================================
function dy = odeSeparatedComplexOdeFcn(fcn, n, isImplicit, t, y, varargin)
  y = odeRealToComplexState(y, n);
  if isImplicit
    yp = odeRealToComplexState(varargin{1}, n);
    args = [{t, y, yp}, varargin(2:end)];
  else
    args = [{t, y}, varargin];
  end
  dy = feval(fcn, args{:});
  dy = odeComplexToRealState(dy);
end
%=============================================================================
function stop = odeSeparatedComplexOutputFcn(fcn, n, outputSel, t, y, flag, varargin)
  if ~isempty(y)
    y = odeRealToComplexState(y, n);
  end
  if ~isempty(outputSel) && isempty(flag)
    y = y(outputSel, :);
  end
  stop = feval(fcn, t, y, flag, varargin{:});
end
%=============================================================================
function varargout = odeSeparatedComplexEventFcn(fcn, n, t, y, varargin)
  y = odeRealToComplexState(y, n);
  args = {t, y};
  if ~isempty(varargin)
    rest = varargin;
    first = rest{1};
    if isnumeric(first) && size(first, 1) == 2 * n
      rest{1} = odeRealToComplexState(first, n);
    end
    args = [args, rest];
  end
  nin = nargin(fcn);
  if nin >= 0 && nin < length(args)
    args = args(1:nin);
  end
  if nargout == 0
    feval(fcn, args{:});
  else
    [varargout{1:nargout}] = feval(fcn, args{:});
  end
end
%=============================================================================
function varargout = odeSeparatedComplexCallback(fcn, n, t, y, index, varargin)
  y = odeRealToComplexState(y, n);
  nout = nargout;
  if nout <= 0
    feval(fcn, t, y, index, varargin{:});
    varargout = {};
  elseif nout == 1
    varargout{1} = feval(fcn, t, y, index, varargin{:});
  else
    [varargout{1}, eventY] = feval(fcn, t, y, index, varargin{:});
    varargout{2} = odeComplexToRealState(eventY);
  end
end
%=============================================================================
function z = odeComplexToRealState(y)
  y = y(:);
  z = [real(y); imag(y)];
end
%=============================================================================
function y = odeRealToComplexState(z, n)
  y = z(1:n, :) + 1i * z((n + 1):(2 * n), :);
end
%=============================================================================
function block = odeComplexMatrixBlock(value, n)
  if isscalar(value)
    if isreal(value)
      block = value;
    else
      eyeN = eye(n);
      block = [real(value) * eyeN -imag(value) * eyeN; ...
        imag(value) * eyeN real(value) * eyeN];
    end
    return
  end
  block = [real(value) -imag(value); imag(value) real(value)];
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function data = odeSolutionData(sol)
  if isa(sol, 'nelson.ode.ODEResults')
    sol = sol.RawSolution;
  end
  if ~isstruct(sol) || ~isfield(sol, 'x') || ~isfield(sol, 'y')
    error('Nelson:ode_solvers:odeSolutionStructureExpected', 'ODE solution structure expected.');
  end
  if ~isfield(sol, 'xe')
    sol.xe = [];
  end
  if ~isfield(sol, 'ye')
    sol.ye = zeros(size(sol.y, 1), 0);
  end
  if ~isfield(sol, 'ie')
    sol.ie = [];
  end
  if ~isfield(sol, 'stats')
    sol.stats = odeInitialStats();
  end
  data = sol;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = odeSolveFunction(solver, nout, varargin)
  if strcmp(solver, 'ode15i')
    [odefun, tspan, y0, yp0, options] = odeParse15i(varargin{:});
  else
    [odefun, tspan, y0, options] = odeParseStandard(varargin{:});
    yp0 = [];
  end
  sol = odeRunSolver(solver, odefun, tspan, y0, yp0, options, nout);
  if nout <= 1
    varargout{1} = sol;
    return
  end
  if ~odeHasRequestedOutputOnly(sol)
    sol = odeResampleSolution(sol, tspan);
  end
  data = odeSolutionData(sol);
  varargout{1} = data.x(:);
  varargout{2} = data.y.';
  if nout >= 3
    varargout{3} = data.xe(:);
  end
  if nout >= 4
    varargout{4} = data.ye.';
  end
  if nout >= 5
    varargout{5} = data.ie(:);
  end
end
%=============================================================================
function tf = odeHasRequestedOutputOnly(sol)
  tf = isstruct(sol) && isfield(sol, 'extdata') && isfield(sol.extdata, 'requestedOutputOnly') ...
    && sol.extdata.requestedOutputOnly;
end
%=============================================================================
function [odefun, tspan, y0, options] = odeParseStandard(varargin)
  narginchk(3, inf);
  odefun = varargin{1};
  tspan = varargin{2};
  y0 = varargin{3};
  if nargin < 4
    options = [];
  else
    options = varargin{4};
  end
  if nargin > 4
    options = odeAttachParameters(options, varargin(5:end));
  end
end
%=============================================================================
function [odefun, tspan, y0, yp0, options] = odeParse15i(varargin)
  narginchk(4, inf);
  odefun = varargin{1};
  tspan = varargin{2};
  y0 = varargin{3};
  yp0 = varargin{4};
  if nargin < 5
    options = [];
  else
    options = varargin{5};
  end
  if nargin > 5
    options = odeAttachParameters(options, varargin(6:end));
  end
end
%=============================================================================
function options = odeAttachParameters(options, parameters)
  if isempty(options)
    options = struct();
  elseif odeIsSolverOptions(options)
    options = struct(options);
  elseif ~isstruct(options)
    error('Nelson:ode_solvers:optionsArgumentStructureCreatedOdeset', 'Options argument must be a structure created with odeset.');
  end
  options.Parameters = parameters;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function solver = odeSolverName(solver)
  if isstring(solver)
    solver = char(solver);
  end
  if ~ischar(solver)
    error('Nelson:ode_solvers:solverNameExpected', 'Solver name expected.');
  end
  allowed = {'auto', 'autoswitch', 'stiff', 'nonstiff', 'ode45', 'ode23', 'ode78', ...
    'ode89', 'ode113', 'ode15s', 'ode23s', 'ode23t', 'ode23tb', 'ode15i', ...
    'cvodesnonstiff', 'cvodesstiff', 'idas'};
  idx = find(strcmpi(solver, allowed));
  if isempty(idx)
    error('Nelson:ode_solvers:unknownOdeSolver', 'Unknown ODE solver.');
  end
  solver = allowed{idx(1)};
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function stop = odeStopFlag(value, name)
  if isempty(value)
    stop = false;
    return
  end
  if ~(isnumeric(value) || islogical(value)) || ~isscalar(value) || ~isfinite(double(value))
    error('Nelson:ode_solvers:invalidValue:valueStopFlagAScalarNumeric', '%s stop flag must be a scalar numeric or logical value.', name);
  end
  stop = logical(value);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function tf = odeSundialsAvailable()
  tf = __ode_sundials_available__();
  if ~tf
    return
  end
  mode = upper(getenv('NELSON_SUNDIALS_RUNTIME'));
  tf = ~(strcmp(mode, 'OFF') || strcmp(mode, '0') || strcmp(mode, 'FALSE'));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% TR-BDF2 step (trapezoid stage to t + gamma*h followed by a variable
% coefficient BDF2 stage to t + h, gamma = 2 - sqrt(2)) with the standard
% embedded third-order error estimate of Hosea and Shampine, filtered by the
% stage iteration matrix for stiff robustness. Both implicit stages are
% solved with a small modified-Newton iteration so that an inexact supplied
% Jacobian does not leave an uncontrolled solve residual.
function [yhigh, ylow, evals] = odeTRBDF2Step(problem, t, y, h)
  gamma = 2 - sqrt(2);
  f0 = odeRhs(problem, t, y);
  [jac0, jacEvals0] = odeRhsJacobian(problem, t, y, f0);
  htrap = gamma * h;
  ystagePredicted = odeTRBDF2TrapezoidPredict(y, htrap, f0, jac0);
  fstagePredicted = odeRhs(problem, t + htrap, ystagePredicted);
  if strcmpi(problem.options.JConstant, 'on')
    jacStage = jac0;
    jacEvalsStage = 0;
  else
    [jacStage, jacEvalsStage] = odeRhsJacobian(problem, t + htrap, ystagePredicted, fstagePredicted);
  end
  [ystage, fstage, stageEvals] = odeTRBDF2TrapezoidSolve(...
    problem, t, y, htrap, f0, ystagePredicted, fstagePredicted, jacStage);
  yendPredicted = odeTRBDF2BDFPredict(y, ystage, h, fstage, gamma);
  fendPredicted = odeRhs(problem, t + h, yendPredicted);
  if strcmpi(problem.options.JConstant, 'on')
    jacEnd = jac0;
    jacEvalsEnd = 0;
  else
    [jacEnd, jacEvalsEnd] = odeRhsJacobian(problem, t + h, yendPredicted, fendPredicted);
  end
  [yhigh, fend, endEvals] = odeTRBDF2BDFSolve(...
    problem, t, y, ystage, h, gamma, yendPredicted, fendPredicted, jacEnd);
  % Embedded third-order error estimate (difference between the TR-BDF2
  % weights and the third-order interpolatory quadrature on the stage
  % nodes), filtered through the stage iteration matrix.
  sq2 = sqrt(2);
  rawEstimate = h * (((sq2 - 1) / 3) * f0 - (1 / 3) * fstage + ((2 - sq2) / 3) * fend);
  d = 1 - sq2 / 2;
  n = length(y);
  filteredEstimate = (eye(n, n) - h * d * jacEnd) \ rawEstimate;
  ylow = yhigh - filteredEstimate;
  evals = 3 + stageEvals + endEvals + jacEvals0 + jacEvalsStage + jacEvalsEnd;
end
%=============================================================================
function [ystage, fstage, evals] = odeTRBDF2TrapezoidSolve(...
    problem, t, y, htrap, f0, ypredicted, fpredicted, jac)
  ystage = ypredicted;
  fstage = fpredicted;
  evals = 0;
  for iteration = 1:4
    ynext = odeTRBDF2TrapezoidCorrect(y, htrap, f0, ystage, fstage, jac);
    delta = ynext - ystage;
    ystage = ynext;
    scale = problem.options.AbsTol + abs(ystage) * problem.options.RelTol;
    fstage = odeRhs(problem, t + htrap, ystage);
    evals = evals + 1;
    if max(abs(delta) ./ scale) < 0.05
      break
    end
  end
end
%=============================================================================
function [yend, fend, evals] = odeTRBDF2BDFSolve(...
    problem, t, y, ystage, h, gamma, ypredicted, fpredicted, jac)
  a0 = (1 - gamma) / (gamma * h);
  a1 = -1 / (gamma * (1 - gamma) * h);
  a2 = (2 - gamma) / ((1 - gamma) * h);
  n = length(y);
  id = eye(n, n);
  yend = ypredicted;
  fend = fpredicted;
  evals = 0;
  for iteration = 1:4
    rightHandSide = fend - jac * yend - a0 * y - a1 * ystage;
    ynext = (a2 * id - jac) \ rightHandSide;
    delta = ynext - yend;
    yend = ynext;
    scale = problem.options.AbsTol + abs(yend) * problem.options.RelTol;
    fend = odeRhs(problem, t + h, yend);
    evals = evals + 1;
    if max(abs(delta) ./ scale) < 0.05
      break
    end
  end
end
%=============================================================================
function ynext = odeTRBDF2BDFPredict(y, ystage, h, fstage, gamma)
  a0 = (1 - gamma) / (gamma * h);
  a1 = -1 / (gamma * (1 - gamma) * h);
  a2 = (2 - gamma) / ((1 - gamma) * h);
  ynext = (fstage - a0 * y - a1 * ystage) / a2;
end
%=============================================================================
function ynext = odeTRBDF2TrapezoidPredict(y, h, f, jac)
  n = length(y);
  ynext = y + h * ((eye(n, n) - 0.5 * h * jac) \ f);
end
%=============================================================================
function ynext = odeTRBDF2TrapezoidCorrect(y, h, f0, ypredicted, f1, jac)
  n = length(y);
  rightHandSide = y + 0.5 * h * (f0 + f1 - jac * ypredicted);
  ynext = (eye(n, n) - 0.5 * h * jac) \ rightHandSide;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [accepted, ynext, err, evals] = odeTryStep(problem, t, y, h, solverState)
  if strcmp(problem.solver, 'ode23')
    [yhigh, ylow, evals] = odeBogackiShampineStep(problem, t, y, h);
  elseif strcmp(problem.solver, 'ode113')
    [yhigh, ylow, evals] = odeAdamsMoultonStep(problem, t, y, h, solverState);
  elseif strcmp(problem.solver, 'ode78')
    [yhigh, ylow, evals] = odeVerner78Step(problem, t, y, h);
  elseif strcmp(problem.solver, 'ode89')
    [yhigh, ylow, evals] = odeVerner89Step(problem, t, y, h);
  elseif strcmp(problem.solver, 'ode23t')
    [yhigh, ylow, evals] = odeLinearlyImplicitTrapezoidStep(problem, t, y, h);
  elseif strcmp(problem.solver, 'ode23tb')
    [yhigh, ylow, evals] = odeTRBDF2Step(problem, t, y, h);
  elseif strcmp(problem.solver, 'ode15s')
    if odeUseFirstOrderBDF(problem)
      [yhigh, ylow, evals] = odeLinearlyImplicitEulerFirstOrderStep(problem, t, y, h);
    else
      [yhigh, ylow, evals] = odeBDFStep(problem, t, y, h, solverState);
    end
  elseif strcmp(problem.solver, 'ode23s')
    [yhigh, ylow, evals] = odeRosenbrock23Step(problem, t, y, h);
  elseif odeIsLinearlyImplicitEulerSolver(problem.solver)
    [yhigh, ylow, evals] = odeLinearlyImplicitEulerStep(problem, t, y, h);
  else
    [yhigh, ylow, evals] = odeDormandPrinceStep(problem, t, y, h);
  end
  err = odeErrorNorm(problem, y, yhigh, ylow);
  accepted = err <= 1;
  ynext = yhigh;
end

function tf = odeIsLinearlyImplicitEulerSolver(solver)
  tf = false;
end
%=============================================================================
function tf = odeUseFirstOrderBDF(problem)
  tf = ~isempty(problem.options.MaxOrder) && problem.options.MaxOrder == 1;
end
