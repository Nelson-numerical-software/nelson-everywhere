function display(varargin)
  doc = varargin{1};
  if nargin == 2
    name = varargin{2};
  else
    name = inputname(1);
  end
  currentFormat = format();
  if ~isempty(name)
    if strcmp(currentFormat.LineSpacing, 'loose')
      disp(' ');
    end
    disp([name, ' =']);
  end
  if strcmp(currentFormat.LineSpacing, 'loose')
    disp(' ');
  end
  disp(doc);
end
