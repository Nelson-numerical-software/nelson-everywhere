function [ax, args] = polarParseTargetAxes(args)
  if ~isempty(args) && isscalar(args{1}) && (isgraphics(args{1}, 'axes') || isgraphics(args{1}, 'polaraxes'))
    ax = args{1};
    args = args(2:end);
    return
  end
  gr = groot();
  if ~isempty(gr.CurrentFigure)
    ax = gca();
  else
    ax = axes();
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function ax = polarPrepareDataAxes(ax)
  if ~polarIsAxes(ax)
    ax = polarInitializeAxes(ax, false);
  end
  nextPlot = ax.NextPlot;
  state = polarGetState(ax, false);
  if strcmp(nextPlot, 'add')
    return
  end
  if isempty(state.DataHandles) && numel(allchild(ax)) == numel(state.GridHandles)
    return
  end
  newplot(ax);
  ax = polarInitializeAxes(ax, false);
  state = polarGetState(ax, false);
  state.GridHandles = gobjects(0, 1);
  state.DataHandles = gobjects(0, 1);
  polarSetState(ax, state);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function polarRefresh(ax, state, manageDrawLater)
  if ~polarIsAxes(ax)
    return
  end
  if nargin < 2
    state = polarGetState(ax, false);
  end
  if nargin < 3
    manageDrawLater = true;
  end
  fig = [];
  previousDrawLater = [];
  if manageDrawLater
    [fig, previousDrawLater] = polarBeginDrawLater(ax);
  end
  try
    deleteValidHandles(state.GridHandles);
    state.GridHandles = gobjects(0, 1);
    state.DataHandles = validDataHandles(state.DataHandles, ax);
    state = updateAutoRadiusLimits(state);
    if strcmp(state.RTickMode, 'auto')
      state.RTick = polarNiceTicks(state.RLim);
    end
    if strcmp(state.ThetaTickMode, 'auto')
      state.ThetaTick = automaticThetaTicks(state.ThetaLim, state.ThetaAxisUnits);
    end
    if strcmp(state.RTickLabelMode, 'auto')
      state.RTickLabel = polarFormatTickLabels(state.RTick, false);
    end
    if strcmp(state.ThetaTickLabelMode, 'auto')
      state.ThetaTickLabel = polarThetaTickLabels(state.ThetaTick, state.ThetaLim, state.ThetaAxisUnits);
    end
    maxRadius = max(abs(state.RLim));
    if maxRadius <= 0 || ~isfinite(maxRadius)
      maxRadius = 1;
    end
    [xLimits, yLimits] = polarVisibleLimits(state.ThetaLim, maxRadius, state.ThetaAxisUnits);
    set(ax, 'XLim', xLimits, 'YLim', yLimits, ...
      'PolarAxes', 'on', 'Visible', 'off', 'Box', 'off', 'Color', [1 1 1], ...
      'XTick', [], 'YTick', [], 'DataAspectRatio', [1 1 1], ...
      'PlotBoxAspectRatio', [1 1 1]);
    [state.GridHandles, gridLines, gridLabels] = drawPolarGrid(ax, state, maxRadius);
    reorderPolarChildren(ax, state, gridLines, gridLabels);
    polarSetState(ax, state);
    if manageDrawLater
      polarEndDrawLater(fig, previousDrawLater);
    end
  catch exception
    if manageDrawLater
      polarEndDrawLater(fig, previousDrawLater);
    end
    error(exception.message);
  end
end
%=============================================================================
function deleteValidHandles(handles)
  if isempty(handles)
    return
  end
  try
    delete(handles);
  catch
    for k = 1:numel(handles)
      try
        delete(handles(k));
      catch
      end
    end
  end
end
%=============================================================================
function handles = validDataHandles(handles, ax)
  if isempty(handles)
    handles = gobjects(0, 1);
    return
  end
  valid = isgraphics(handles);
  handles = handles(valid);
  keep = false(size(handles));
  for k = 1:numel(handles)
    keep(k) = (isgraphics(handles(k), 'line') || isgraphics(handles(k), 'functionline') ...
      || isgraphics(handles(k), 'compassplot') || isgraphics(handles(k), 'bubblechart')) ...
      && isequal(handles(k).Parent, ax);
  end
  handles = handles(keep);
  handles = handles(:);
end
%=============================================================================
function state = updateAutoRadiusLimits(state)
  if ~strcmp(state.RLimMode, 'auto')
    return
  end
  maxRadius = 0;
  for k = 1:numel(state.DataHandles)
    h = state.DataHandles(k);
    if isgraphics(h, 'line') || isgraphics(h, 'functionline') || isgraphics(h, 'compassplot') ...
        || isgraphics(h, 'bubblechart')
      r = h.RData;
      if ~isempty(r)
        r = abs(r(isfinite(r)));
        if ~isempty(r)
          maxRadius = max(maxRadius, max(r(:)));
        end
      end
    end
  end
  state.RLim = polarNiceRLimit(maxRadius);
end
%=============================================================================
function [handles, gridLines, gridLabels] = drawPolarGrid(ax, state, maxRadius)
  thetaLim = thetaValuesToRadians(state.ThetaLim, state.ThetaAxisUnits);
  theta = linspace(thetaLim(1), thetaLim(2), 361);
  gridColor = [0.15 0.15 0.15];
  gridLineColor = [0.75 0.75 0.75];
  gridLines = [drawRadialGridLines(ax, state, theta, gridLineColor); ...
    drawThetaGridLines(ax, state, maxRadius, gridLineColor)];
  gridLabels = [drawRLabels(ax, state, maxRadius, gridColor); ...
    drawThetaLabels(ax, state, maxRadius, gridColor)];
  handles = [gridLines; gridLabels];
end
%=============================================================================
function handle = drawRadialGridLines(ax, state, theta, color)
  gridX = [];
  gridY = [];
  for k = 1:numel(state.RTick)
    r = state.RTick(k);
    if r < state.RLim(1) || r > state.RLim(2)
      continue
    end
    [x, y] = polarToCartesian(theta, r * ones(size(theta)));
    gridX = [gridX, x, NaN];
    gridY = [gridY, y, NaN];
  end
  handle = drawGridLine(ax, gridX, gridY, color);
end
%=============================================================================
function handle = drawThetaGridLines(ax, state, maxRadius, color)
  ticks = visibleThetaTicks(state);
  x = NaN(1, 3 * numel(ticks));
  y = x;
  for k = 1:numel(ticks)
    value = ticks(k);
    th = thetaValueToRadians(value, state.ThetaAxisUnits);
    offset = 3 * (k - 1);
    x(offset + 1:offset + 3) = [0 maxRadius * cos(th) NaN];
    y(offset + 1:offset + 3) = [0 maxRadius * sin(th) NaN];
  end
  handle = drawGridLine(ax, x, y, color);
end
%=============================================================================
function handle = drawGridLine(ax, x, y, color)
  if isempty(x)
    handle = gobjects(0, 1);
    return
  end
  handle = __line__('Parent', ax, 'XData', x, 'YData', y, ...
    'Color', color, 'LineStyle', '-', 'LineWidth', 0.5, ...
    'HandleVisibility', 'off', 'HitTest', 'off', ...
    'Tag', '__nelson_polar_grid__', 'Visible', 'on');
end
%=============================================================================
function handles = drawRLabels(ax, state, maxRadius, color)
  handles = gobjects(min(numel(state.RTick), numel(state.RTickLabel)), 1);
  count = 0;
  labelAngle = deg2radLocal(80);
  labels = state.RTickLabel;
  for k = 1:min(numel(state.RTick), numel(labels))
    r = state.RTick(k);
    if r < state.RLim(1) || r > state.RLim(2)
      continue
    end
    x = r * cos(labelAngle);
    y = r * sin(labelAngle);
    count = count + 1;
    handles(count, 1) = __text__('Parent', ax, 'Visible', 'on', ...
      'Position', [x y 0], 'String', labels{k}, 'Color', color, ...
      'HorizontalAlignment', 'center', 'VerticalAlignment', 'middle', ...
      'HandleVisibility', 'off', 'HitTest', 'off', ...
      'Tag', '__nelson_polar_grid__');
  end
  if count == 0
    handles = gobjects(0, 1);
  else
    handles = handles(1:count);
  end
end
%=============================================================================
function handles = drawThetaLabels(ax, state, maxRadius, color)
  handles = gobjects(min(numel(state.ThetaTick), numel(state.ThetaTickLabel)), 1);
  count = 0;
  labels = state.ThetaTickLabel;
  radius = maxRadius * 1.06;
  for k = 1:min(numel(state.ThetaTick), numel(labels))
    value = state.ThetaTick(k);
    if value < state.ThetaLim(1) || value > state.ThetaLim(2)
      continue
    end
    th = thetaValueToRadians(value, state.ThetaAxisUnits);
    count = count + 1;
    handles(count, 1) = __text__('Parent', ax, 'Visible', 'on', ...
      'Position', [radius * cos(th) radius * sin(th) 0], ...
      'String', labels{k}, 'Color', color, ...
      'HorizontalAlignment', 'center', 'VerticalAlignment', 'middle', ...
      'HandleVisibility', 'off', 'HitTest', 'off', ...
      'Tag', '__nelson_polar_grid__');
  end
  if count == 0
    handles = gobjects(0, 1);
  else
    handles = handles(1:count);
  end
end
%=============================================================================
function reorderPolarChildren(ax, state, gridLines, gridLabels)
  data = state.DataHandles(:);
  known = [gridLines(:); gridLabels(:); data(:)];
  children = allchild(ax);
  if numel(children) == numel(known)
    other = gobjects(0, 1);
  else
    other = handlesNotIn(children, known);
  end
  % Built back to front: the grid sits under the data, the labels over it.
  ordered = [gridLines(:); data(:); other(:); gridLabels(:)];
  if ~isempty(ordered)
    % Children run top first, so the stack is handed back the other way up.
    ax.Children = flipud(ordered);
  end
end
%=============================================================================
function selected = handlesNotIn(handles, excluded)
  selected = gobjects(0, 1);
  for k = 1:numel(handles)
    if ~isKnownHandle(handles(k), excluded)
      selected(end + 1, 1) = handles(k);
    end
  end
end
%=============================================================================
function tf = isKnownHandle(handle, handles)
  tf = false;
  for k = 1:numel(handles)
    if isequal(handles(k), handle)
      tf = true;
      return
    end
  end
end
%=============================================================================
function radians = deg2radLocal(degrees)
  radians = degrees * pi / 180;
end
%=============================================================================
function ticks = automaticThetaTicks(thetaLim, thetaAxisUnits)
  step = 30;
  if strcmp(thetaAxisUnits, 'radians')
    step = pi / 6;
  end
  ticks = thetaLim(1):step:thetaLim(2);
  if isempty(ticks) || ticks(end) < thetaLim(2)
    ticks = [ticks thetaLim(2)];
  end
end
%=============================================================================
function ticks = visibleThetaTicks(state)
  ticks = state.ThetaTick;
  ticks = ticks(ticks >= state.ThetaLim(1) & ticks <= state.ThetaLim(2));
  if isFullCircle(state.ThetaLim, state.ThetaAxisUnits) && numel(ticks) > 1 ...
      && abs(ticks(end) - state.ThetaLim(2)) < 1e-12
    ticks(end) = [];
  end
end
%=============================================================================
function tf = isFullCircle(thetaLim, thetaAxisUnits)
  fullCircle = 360;
  if strcmp(thetaAxisUnits, 'radians')
    fullCircle = 2 * pi;
  end
  tf = abs(abs(thetaLim(2) - thetaLim(1)) - fullCircle) < 1e-12;
end
%=============================================================================
function radians = thetaValuesToRadians(values, thetaAxisUnits)
  radians = values;
  if strcmp(thetaAxisUnits, 'degrees')
    radians = values * pi / 180;
  end
end
%=============================================================================
function radians = thetaValueToRadians(value, thetaAxisUnits)
  radians = value;
  if strcmp(thetaAxisUnits, 'degrees')
    radians = deg2radLocal(value);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function polarSetState(ax, state)
  if isprop(ax, 'RLim')
    args = {'UserData', state};
    args = addModeValue(args, 'RLim', state.RLim, 'RLimMode', state.RLimMode);
    args = addModeValue(args, 'RTick', state.RTick, 'RTickMode', state.RTickMode);
    args = addModeValue(args, 'RTickLabel', state.RTickLabel, ...
      'RTickLabelMode', state.RTickLabelMode);
    args = [args, {'ThetaAxisUnits', state.ThetaAxisUnits}];
    args = addModeValue(args, 'ThetaLim', state.ThetaLim, ...
      'ThetaLimMode', state.ThetaLimMode);
    args = addModeValue(args, 'ThetaTick', state.ThetaTick, ...
      'ThetaTickMode', state.ThetaTickMode);
    args = addModeValue(args, 'ThetaTickLabel', state.ThetaTickLabel, ...
      'ThetaTickLabelMode', state.ThetaTickLabelMode);
    set(ax, args{:});
  else
    ax.UserData = state;
  end
end
%=============================================================================
function args = addModeValue(args, valueName, value, modeName, modeValue)
  if strcmp(modeValue, 'auto')
    args = [args, {modeName, 'manual'}];
  end
  args = [args, {valueName, value, modeName, modeValue}];
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function polarSetStateAndRefresh(ax, state)
  [fig, previousDrawLater] = polarBeginDrawLater(ax);
  try
    polarSetState(ax, state);
    polarRefresh(ax, state, false);
    polarEndDrawLater(fig, previousDrawLater);
  catch exception
    polarEndDrawLater(fig, previousDrawLater);
    error(exception.message);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function labels = polarThetaTickLabels(ticks, thetaLim, thetaAxisUnits)
  if nargin < 3
    thetaAxisUnits = 'degrees';
  end
  labelTicks = ticks;
  if isFullCircle(thetaLim, thetaAxisUnits) && numel(labelTicks) > 1 ...
      && abs(labelTicks(end) - thetaLim(2)) < 1e-12
    labelTicks(end) = [];
  end
  if strcmp(thetaAxisUnits, 'radians')
    labels = polarFormatPiLabels(labelTicks);
  else
    labels = polarFormatTickLabels(labelTicks, true);
  end
end
%=============================================================================
function labels = polarFormatPiLabels(values)
  labels = cell(numel(values), 1);
  for k = 1:numel(values)
    labels{k} = polarPiLabel(values(k));
  end
end
%=============================================================================
function label = polarPiLabel(value)
  ratio = value / pi;
  for denominator = 1:12
    numerator = round(ratio * denominator);
    if abs(ratio - numerator / denominator) < 1e-10
      label = polarPiFractionLabel(numerator, denominator);
      return
    end
  end
  label = polarFormatTickLabels(value, false);
  label = label{1};
end
%=============================================================================
function label = polarPiFractionLabel(numerator, denominator)
  if numerator == 0
    label = '0';
    return
  end
  divisor = gcdLocal(abs(numerator), denominator);
  numerator = numerator / divisor;
  denominator = denominator / divisor;
  prefix = '';
  if numerator < 0
    prefix = '-';
  end
  numerator = abs(numerator);
  coefficient = '';
  if numerator ~= 1
    coefficient = int2str(numerator);
  end
  if denominator == 1
    label = [prefix, coefficient, '\pi'];
  else
    label = [prefix, coefficient, '\pi/', int2str(denominator)];
  end
end
%=============================================================================
function value = gcdLocal(a, b)
  while b ~= 0
    t = rem(a, b);
    a = b;
    b = t;
  end
  if a == 0
    value = 1;
  else
    value = a;
  end
end
%=============================================================================
function tf = isFullCircle(thetaLim, thetaAxisUnits)
  fullCircle = 360;
  if strcmp(thetaAxisUnits, 'radians')
    fullCircle = 2 * pi;
  end
  tf = abs(abs(thetaLim(2) - thetaLim(1)) - fullCircle) < 1e-12;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [x, y] = polarToCartesian(theta, radius)
  reflected = radius < 0;
  theta(reflected) = theta(reflected) + pi;
  radius(reflected) = -radius(reflected);
  x = radius .* cos(theta);
  y = radius .* sin(theta);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [xLimits, yLimits] = polarVisibleLimits(thetaLim, radius, thetaAxisUnits)
  if nargin < 3
    thetaAxisUnits = 'degrees';
  end
  if radius <= 0 || ~isfinite(radius)
    radius = 1;
  end
  fullCircle = 360;
  if strcmp(thetaAxisUnits, 'radians')
    fullCircle = 2 * pi;
  end
  if abs(abs(thetaLim(2) - thetaLim(1)) - fullCircle) < 1e-12
    xLimits = [-radius radius];
    yLimits = [-radius radius];
    return
  end

  theta = visibleBoundaryAngles(thetaLim, thetaAxisUnits);
  if strcmp(thetaAxisUnits, 'degrees')
    theta = theta * pi / 180;
  end
  x = [0 radius * cos(theta)];
  y = [0 radius * sin(theta)];
  xLimits = expandEqualLimits([min(x) max(x)], radius);
  yLimits = expandEqualLimits([min(y) max(y)], radius);
end
%=============================================================================
function angles = visibleBoundaryAngles(thetaLim, thetaAxisUnits)
  angles = thetaLim;
  cardinal = -720:90:720;
  if strcmp(thetaAxisUnits, 'radians')
    cardinal = cardinal * pi / 180;
  end
  cardinal = cardinal(cardinal > thetaLim(1) & cardinal < thetaLim(2));
  angles = unique([angles cardinal]);
end
%=============================================================================
function limits = expandEqualLimits(limits, radius)
  if abs(limits(2) - limits(1)) < eps
    delta = max(radius * 0.05, eps);
    limits = limits + [-delta delta];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function rejectStreamPropertyArguments(args)
  % stream2 and stream3 compute vertices and draw nothing, so they take no
  % line property. Saying so is clearer than letting a property name reach the
  % field parser, which would count it as one of the data arguments.
  for k = 1:numel(args)
    if (ischar(args{k}) || isStringScalar(args{k}))
      error('Nelson:graphics:unexpectedPropertyArgument', ...
        'Property arguments are not accepted here.');
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [newFaces, newVertices] = shrinkFaceData(faces, vertices, sf)
  scale = sqrt(sf);
  newFaces = NaN(size(faces));
  newVertices = zeros(0, size(vertices, 2));
  nextIndex = 1;
  for row = 1:size(faces, 1)
    [newFaces, newVertices, nextIndex] = shrinkFaceRow(...
      faces, vertices, row, scale, newFaces, newVertices, nextIndex);
  end
end
%=============================================================================
function [newFaces, newVertices, nextIndex] = shrinkFaceRow(...
    faces, vertices, row, scale, newFaces, newVertices, nextIndex)
  ids = faces(row, isfinite(faces(row, :)));
  if isempty(ids)
    return
  end
  shrunk = shrinkFaceVertices(vertices(ids, :), scale);
  count = size(shrunk, 1);
  newVertices(nextIndex:nextIndex + count - 1, :) = shrunk;
  newFaces(row, 1:count) = nextIndex:nextIndex + count - 1;
  nextIndex = nextIndex + count;
end
%=============================================================================
function shrunk = shrinkFaceVertices(points, scale)
  center = mean(points, 1);
  shrunk = center + scale * (points - center);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [faces, vertices] = shrinkfacesDataFromStruct(fv)
  faces = shrinkfacesStructField(fv, 'faces', 'Faces');
  vertices = shrinkfacesStructField(fv, 'vertices', 'Vertices');
end
%=============================================================================
function value = shrinkfacesStructField(fv, lowerName, upperName)
  if isfield(fv, lowerName)
    value = fv.(lowerName);
  elseif isfield(fv, upperName)
    value = fv.(upperName);
  else
    error('Nelson:shrinkfacesDataFromStruct:invalidStructure', 'Structure must contain faces and vertices fields.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function out = smooth3ApplyWeights(data, weights, dim)
  out = zeros(size(data));
  radius = (numel(weights) - 1) / 2;
  n = size(data, dim);
  base = 1:n;
  idx = repmat({':'}, 1, ndims(data));
  for k = 1:numel(weights)
    src = min(max(base + k - radius - 1, 1), n);
    idx{dim} = src;
    out = out + weights(k) * data(idx{:});
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function weights = smooth3KernelWeights(method, windowSize, sd)
  weights = cell(1, 3);
  for dim = 1:3
    radius = (windowSize(dim) - 1) / 2;
    offsets = -radius:radius;
    weights{dim} = smooth3KernelWeightsForDimension(method, offsets, sd);
  end
end
%=============================================================================
function weights = smooth3KernelWeightsForDimension(method, offsets, sd)
  if strcmp(method, 'gaussian')
    weights = exp(-(offsets .^ 2) / (2 * sd * sd));
  else
    weights = ones(1, numel(offsets));
  end
  weights = weights / sum(weights);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [vertices, field] = streamFieldVertices(dataArgs)
  % Traces a 2-D or 3-D vector field from the start points it was given and
  % returns one N-by-2 or N-by-3 array of vertices per start point. This is the
  % computation behind streamline, stream2 and stream3: sharing it is what keeps
  % streamline(stream2(X, Y, U, V, sx, sy)) on the same path as
  % streamline(X, Y, U, V, sx, sy). No graphics object is created here, so a
  % caller that only wants the vertices does not open a figure.
  field = parseStreamField(dataArgs);
  if isfield(field, 'Vertices')
    vertices = field.Vertices(:);
    return
  end
  if field.Dimension == 2
    starts = [field.sx(:), field.sy(:)];
  else
    starts = [field.sx(:), field.sy(:), field.sz(:)];
  end
  vertices = cell(size(starts, 1), 1);
  for k = 1:size(starts, 1)
    vertices{k} = traceStream(field, starts(k, :));
  end
end
%=============================================================================
function field = parseStreamField(dataArgs)
  switch numel(dataArgs)
    case 1
      if ~iscell(dataArgs{1})
        error('Nelson:graphics:invalidStreamlineVertices', '%s must be a cell array.', 'Stream vertices');
      end
      field.Vertices = dataArgs{1};
      field.Dimension = streamVerticesDimension(field.Vertices);
    case 4
      [field.x, field.y] = default2DGrid(dataArgs{1});
      field.u = double(dataArgs{1});
      field.v = double(dataArgs{2});
      field.sx = dataArgs{3};
      field.sy = dataArgs{4};
      field.sz = zeros(size(field.sx));
      field.Dimension = 2;
    case 6
      [field, ok] = parseSixStreamArgs(dataArgs);
      if ~ok
        error('Nelson:wrongNumberOfInputs', 'Wrong number of input arguments.');
      end
    case 5
      field = parseStreamField(dataArgs(1:4));
      field.Options = dataArgs{5};
    case 7
      field = parseStreamField(dataArgs(1:6));
      field.Options = dataArgs{7};
    case 9
      field.x = dataArgs{1}; field.y = dataArgs{2}; field.z = dataArgs{3};
      field.u = double(dataArgs{4}); field.v = double(dataArgs{5}); field.w = double(dataArgs{6});
      field.sx = dataArgs{7}; field.sy = dataArgs{8}; field.sz = dataArgs{9};
      field.Dimension = 3;
    case 10
      field = parseStreamField(dataArgs(1:9));
      field.Options = dataArgs{10};
    otherwise
      if numel(dataArgs) < 1
        error('Nelson:notEnoughInputs', 'Not enough input arguments.');
      end
      if numel(dataArgs) > 10
        error('Nelson:tooManyInputs', 'Too many input arguments.');
      end
      error('Nelson:wrongNumberOfInputs', 'Wrong number of input arguments.');
  end
  if ~isfield(field, 'Vertices')
    field = normalizeStreamField(field);
  end
end
%=============================================================================
function dimension = streamVerticesDimension(vertices)
  dimension = 2;
  for k = 1:numel(vertices)
    if ~isempty(vertices{k}) && size(vertices{k}, 2) == 3
      dimension = 3;
      return
    end
  end
end
%=============================================================================
function [field, ok] = parseSixStreamArgs(args)
  ok = true;
  if ndims(args{1}) == 3
    [field.x, field.y, field.z] = volumeGridVectors(args{1});
    field.u = double(args{1}); field.v = double(args{2}); field.w = double(args{3});
    field.sx = args{4}; field.sy = args{5}; field.sz = args{6};
    field.Dimension = 3;
  else
    field.x = args{1}; field.y = args{2};
    field.u = double(args{3}); field.v = double(args{4});
    field.sx = args{5}; field.sy = args{6}; field.sz = zeros(size(field.sx));
    field.Dimension = 2;
  end
end
%=============================================================================
function field = normalizeStreamField(field)
  if field.Dimension == 2
    [field.x, field.y] = gridVectors2D(field.x, field.y, field.u);
    if ~isequal(size(field.u), size(field.v))
      error('Nelson:dimagree:vectorComponentSizesMatch', 'Vector component sizes must match.');
    end
  else
    [field.x, field.y, field.z] = volumeGridVectors(field.x, field.y, field.z, field.u);
    if ~isequal(size(field.u), size(field.v)) || ~isequal(size(field.u), size(field.w))
      error('Nelson:dimagree:vectorComponentSizesMatch', 'Vector component sizes must match.');
    end
  end
  if numel(field.sx) ~= numel(field.sy) || numel(field.sx) ~= numel(field.sz)
    error('Nelson:streamlineBase:invalidStartPointArrays', 'Start point arrays must have the same number of elements.');
  end
end
%=============================================================================
function [x, y] = default2DGrid(U)
  x = 1:size(U, 2);
  y = 1:size(U, 1);
end
%=============================================================================
function [x, y] = gridVectors2D(X, Y, U)
  if isvector(X) && isvector(Y)
    x = double(X(:).');
    y = double(Y(:).');
  elseif isequal(size(X), size(Y)) && isequal(size(X), size(U))
    x = double(X(1, :));
    y = double(Y(:, 1).');
  else
    error('Nelson:streamlineBase:invalidGridArrays', 'Grid arrays must have the same size as vector components.');
  end
end
%=============================================================================
function pts = traceStream(field, start)
  if outsideField(field, start)
    % A start point outside the field traces nothing at all. A start inside it
    % that the field does not move keeps its single vertex.
    pts = [];
    return
  end
  pts = start;
  [step, maxVertices] = streamIntegrationOptions(field);
  current = start;
  for k = 1:(maxVertices - 1)
    vec = sampleVector(field, current);
    if any(~isfinite(vec)) || norm(vec) < eps
      break
    end
    vec = vec / norm(vec);
    current = current + step * vec;
    if outsideField(field, current)
      break
    end
    pts(end + 1, :) = current;
  end
end
%=============================================================================
function [step, maxVertices] = streamIntegrationOptions(field)
  % The options argument is [stepsize] or [stepsize, maxvert]: a step given in
  % grid cells, and the largest number of vertices to produce, the start point
  % counted. Both keep their default when the argument leaves them out.
  stepScale = 0.1;
  maxVertices = 500;
  if isfield(field, 'Options') && ~isempty(field.Options) && isnumeric(field.Options)
    options = double(field.Options(:).');
    if isfinite(options(1)) && options(1) > 0
      stepScale = options(1);
    end
    if numel(options) >= 2 && isfinite(options(2)) && options(2) >= 1
      maxVertices = floor(options(2));
    end
  end
  step = stepScale * streamGridSpacing(field);
end
%=============================================================================
function spacing = streamGridSpacing(field)
  % One grid cell, taken as the smallest gap between two distinct coordinates.
  values = [field.x(:); field.y(:)];
  if field.Dimension == 3
    values = [values; field.z(:)];
  end
  d = diff(unique(sort(values)));
  d = d(d > 0);
  if isempty(d)
    spacing = 1;
  else
    spacing = min(d);
  end
end
%=============================================================================
function vec = sampleVector(field, point)
  if field.Dimension == 2
    ux = interp2(field.x, field.y, field.u, point(1), point(2), 'linear', NaN);
    vy = interp2(field.x, field.y, field.v, point(1), point(2), 'linear', NaN);
    vec = [ux, vy];
  else
    ux = interp3(field.x, field.y, field.z, field.u, point(1), point(2), point(3), 'linear', NaN);
    vy = interp3(field.x, field.y, field.z, field.v, point(1), point(2), point(3), 'linear', NaN);
    wz = interp3(field.x, field.y, field.z, field.w, point(1), point(2), point(3), 'linear', NaN);
    vec = [ux, vy, wz];
  end
end
%=============================================================================
function tf = outsideField(field, point)
  tf = point(1) < min(field.x) || point(1) > max(field.x) ...
    || point(2) < min(field.y) || point(2) > max(field.y);
  if field.Dimension == 3
    tf = tf || point(3) < min(field.z) || point(3) > max(field.z);
  end
end
