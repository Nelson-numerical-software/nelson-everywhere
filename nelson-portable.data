% LICENCE_BLOCK_END
%=============================================================================
function res = inv(sys)
  A = sys.A;
  B = sys.B;
  C = sys.C;
  D = sys.D;
  E = sys.E;

  res = sys;
  m = size(B, 2);
  n = size(A, 1);
  res.A = [A, B; C, D];
  res.B = [zeros(n, m); -eye(m)];
  res.C = [zeros(m, n), eye(m)];
  res.D = zeros(m, m);
  if isempty(E)
    E = eye(n, n);
  end
  res.E = [E, zeros(n, m); zeros(m, n + m)];
end
%=============================================================================
%=============================================================================
