% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [value, isterminal, direction] = odeEvaluateEventObject(eventDefinition, t, y, varargin)
  fcn = eventDefinition.EventFcn;
  if isempty(fcn)
    error('Nelson:ode_solvers:functionHandleExpected', '%s must be a function handle.', 'Value');
  end
  args = odeEventArguments(fcn, t, y, varargin{:});
  if odeEventFunctionHasLegacyOutputs(fcn)
    [value, isterminal, direction] = feval(fcn, args{:});
  else
    value = feval(fcn, args{:});
    [isterminal, direction] = odeEventFlags(eventDefinition, value);
  end
end
%=============================================================================
function tf = odeEventFunctionHasLegacyOutputs(fcn)
  nout = nargout(fcn);
  tf = nout >= 3;
end
%=============================================================================
function args = odeEventArguments(fcn, t, y, varargin)
  args = [{t, y}, varargin];
  nin = nargin(fcn);
  if nin >= 0 && nin < length(args)
    args = args(1:nin);
  end
end
%=============================================================================
function [isterminal, direction] = odeEventFlags(eventDefinition, value)
  n = numel(value);
  isterminal = false(n, 1);
  direction = zeros(n, 1);
  for k = 1:n
    response = odeEventChoiceAt(eventDefinition.Response, k, n, 'Response');
    if strcmpi(response, 'stop')
      isterminal(k) = true;
    end
    directionChoice = odeEventChoiceAt(eventDefinition.Direction, k, n, 'Direction');
    if strcmpi(directionChoice, 'increasing')
      direction(k) = 1;
    elseif strcmpi(directionChoice, 'decreasing')
      direction(k) = -1;
    end
  end
end
%=============================================================================
function choice = odeEventChoiceAt(choices, index, count, name)
  if iscell(choices)
    if numel(choices) == 1
      choice = choices{1};
    elseif numel(choices) == count
      choice = choices{index};
    else
      error('Nelson:ode_solvers:sizeMismatch:valueSizeDoesNotMatchEvent', '%s size does not match event value size.', name);
    end
  else
    choice = choices;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [jac, evals] = odeFiniteDifferenceRhsJacobian(problem, t, y, f0)
  n = length(y);
  jac = zeros(n, n);
  pattern = odeJacobianPattern(problem, n);
  activeColumns = any(pattern, 1);
  if ~any(activeColumns)
    evals = 0;
    return
  end
  steps = zeros(n, 1);
  trials = y * ones(1, n);
  for j = 1:n
    if activeColumns(j)
      steps(j) = sqrt(eps) * max(abs(y(j)), 1);
      trials(j, j) = trials(j, j) + steps(j);
    end
  end
  if strcmpi(problem.options.Vectorized, 'on')
    trialColumns = find(activeColumns);
    ftrials = odeCallFcn(problem.odefun, t, trials(:, trialColumns), problem.options);
    if ~isempty(problem.options.Mass)
      mass = odeMassValue(problem, t, y);
      ftrials = mass \ ftrials;
    end
    for k = 1:length(trialColumns)
      j = trialColumns(k);
      jac(:, j) = (ftrials(:, k) - f0(:)) / steps(j);
    end
    evals = double(~isempty(trialColumns));
    jac(~pattern) = 0;
    return
  end
  for j = 1:n
    if activeColumns(j)
      ftrial = odeRhs(problem, t, trials(:, j));
      jac(:, j) = (ftrial(:) - f0(:)) / steps(j);
    end
  end
  evals = length(find(activeColumns));
  jac(~pattern) = 0;
end

function pattern = odeJacobianPattern(problem, n)
  pattern = problem.options.JPattern;
  if isempty(pattern)
    pattern = true(n, n);
  else
    pattern = pattern ~= 0;
  end
end

function mass = odeMassValue(problem, t, y)
  mass = problem.options.Mass;
  if isa(mass, 'function_handle')
    mass = odeCallFcn(mass, t, y, problem.options);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function jac = odeFiniteDifferenceSlopeJacobian(problem, t, y, yp, r0)
  n = length(yp);
  jac = zeros(n, n);
  pattern = odeSlopeJacobianPattern(problem, n);
  activeColumns = any(pattern, 1);
  for j = 1:n
    if activeColumns(j)
      step = sqrt(eps) * max(abs(yp(j)), 1);
      trial = yp;
      trial(j) = trial(j) + step;
      r = odeCallFcn(problem.odefun, t, y, problem.options, trial);
      jac(:, j) = (r(:) - r0(:)) / step;
    end
  end
  jac(~pattern) = 0;
end

function pattern = odeSlopeJacobianPattern(problem, n)
  pattern = problem.options.JPattern;
  if isempty(pattern)
    pattern = true(n, n);
  else
    pattern = pattern ~= 0;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function tf = odeHasCrossing(v0, v1, direction)
  tf = (v1 == 0) || (v0 ~= 0 && sign(v0) ~= sign(v1));
  if ~tf || direction == 0
    return
  end
  slope = v1 - v0;
  tf = (direction > 0 && slope > 0) || (direction < 0 && slope < 0);
end
