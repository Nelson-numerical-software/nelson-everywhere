% LICENCE_BLOCK_END
%=============================================================================
function R = pow2(varargin)
  narginchk(1, 2);
  nargoutchk(0, 1);
  if (nargin == 2)
    X = varargin{1};
    E = varargin{2};
    doComplexWarning = false;
    if ~isreal(X)
      X = real(X);
      doComplexWarning = true;
    end
    if ~isreal(E)
      E = real(E);
      doComplexWarning = true;
    end
    R = X .* (2 .^ E);
    if doComplexWarning
      warning('Nelson:pow2:ignoredImagPart', 'Imaginary part ignored.');
    end
  else
    Y = varargin{1};
    R = 2 .^ Y;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2019-present Allan CORNET (Nelson)
