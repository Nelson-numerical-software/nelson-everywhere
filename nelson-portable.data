%=============================================================================
function varargout = timezones()
  timezoneDataPath = [modulepath('time'), '/resources/tzdata'];
  [zones, version] = timezoneslist(timezoneDataPath);
  varargout{1} = zones;
  if nargout > 1
    varargout{2} = version;
  end
end
