%=============================================================================
function options = bvpDefaultOptions()
  % All fields default to empty so that bvpget(options, name, callerDefault)
  % honours the caller-supplied default when a property was never set. The
  % numeric defaults (AbsTol = 1e-6, RelTol = 1e-3, NMax = 1000, Stats = 'off',
  % Vectorized = 'off') are applied at consumption time inside bvpSolve.
  options = struct('AbsTol', [], 'RelTol', [], ...
    'NMax', [], 'Stats', [], 'Vectorized', [], ...
    'FJacobian', [], 'BCJacobian', [], 'SingularTerm', []);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function options = bvpMergeOptions(options, extra)
  names = fieldnames(extra);
  for k = 1:length(names)
    name = bvpOptionName(names{k});
    options.(name) = extra.(names{k});
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function name = bvpOptionName(name)
  if isstring(name)
    name = char(name);
  end
  if ~ischar(name)
    error('Nelson:ode_solvers:bvpOptionNameExpected', '%s option name expected.', 'BVP');
  end
  names = fieldnames(bvpDefaultOptions());
  idx = find(strcmpi(name, names));
  if isempty(idx)
    idx = bvpPartialMatches(name, names);
  end
  if isempty(idx)
    error('Nelson:ode_solvers:unknownBvpOptionName', 'Unknown %s option name.', 'BVP');
  end
  if length(idx) > 1
    error('Nelson:ode_solvers:ambiguousBvpOptionName', 'Ambiguous %s option name.', 'BVP');
  end
  name = names{idx(1)};
end
%=============================================================================
function idx = bvpPartialMatches(name, names)
  idx = [];
  for k = 1:length(names)
    candidate = names{k};
    if length(name) <= length(candidate) && strcmpi(name, candidate(1:length(name)))
      idx(end + 1) = k;
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function residual = bvpResidual(odefun, bcfun, x, u, n, np, options)
  if nargin < 7
    options = [];
  end
  [y, parameters] = bvpResidualUnpack(u, n, length(x), np);
  residual = [];
  for k = 1:(length(x) - 1)
    h = x(k + 1) - x(k);
    f0 = bvpResidualOdeCall(odefun, x(k), y(:, k), parameters, options);
    f1 = bvpResidualOdeCall(odefun, x(k + 1), y(:, k + 1), parameters, options);
    midY = 0.5 * (y(:, k) + y(:, k + 1)) - h * (f1 - f0) / 8;
    fm = bvpResidualOdeCall(odefun, 0.5 * (x(k) + x(k + 1)), midY, parameters, options);
    residual = [residual; y(:, k + 1) - y(:, k) - h * (f0 + 4 * fm + f1) / 6];
  end
  residual = [residual; bvpResidualBcCall(bcfun, y(:, 1), y(:, length(x)), parameters)];
end
%=============================================================================
function [y, parameters] = bvpResidualUnpack(u, n, m, np)
  y = reshape(u(1:n * m), n, m);
  parameters = u(n * m + (1:np)).';
end
%=============================================================================
function values = bvpResidualOdeCall(fcn, x, y, parameters, options)
  if isempty(parameters) || (nargin(fcn) ~= -1 && nargin(fcn) < 3)
    values = feval(fcn, x, y);
  else
    values = feval(fcn, x, y, parameters);
  end
  values = values(:);
  if ~isempty(options)
    values = values + bvpSingularValue(options, x, y);
  end
end
%=============================================================================
function values = bvpResidualBcCall(fcn, ya, yb, parameters)
  if isempty(parameters) || (nargin(fcn) ~= -1 && nargin(fcn) < 3)
    values = feval(fcn, ya, yb);
  else
    values = feval(fcn, ya, yb, parameters);
  end
  values = values(:);
end
%=============================================================================
function value = bvpSingularValue(options, x, y)
  value = zeros(size(y));
  singularTerm = bvpget(options, 'SingularTerm', []);
  if isempty(singularTerm)
    return
  end
  if ~isnumeric(singularTerm) || ~isreal(singularTerm) ...
      || size(singularTerm, 1) ~= length(y) || size(singularTerm, 2) ~= length(y)
    error('Nelson:ode_solvers:singulartermRealSquareMatrixMatchingState', 'SingularTerm must be a real square matrix matching the state size.');
  end
  denominator = x;
  product = singularTerm * y;
  if abs(denominator) <= eps
    if max(abs(product)) > sqrt(eps)
      error('Nelson:ode_solvers:singulartermRequiresConsistentLeftBoundaryValue', 'SingularTerm requires a consistent left boundary value.');
    end
    return
  end
  value = product / denominator;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function sol = bvpSolve(solver, odefun, bcfun, solinit, options)
  bvpValidateFunctions(odefun, bcfun);
  [x, y, parameters] = bvpNormalizeInitialSolution(solinit);
  options = bvpNormalizeOptions(options);
  maxRefines = bvpRefinementPasses(solver, options);
  stats = struct('niterations', 0, 'nmeshpoints', length(x), ...
    'residualNorm', [], 'residualRms', [], 'nrefinements', 0, ...
    'maxDefect', [], 'rmsDefect', []);
  for refine = 1:maxRefines
    [y, parameters, currentStats] = bvpNewtonSolve(odefun, bcfun, x, y, parameters, options);
    stats.niterations = stats.niterations + currentStats.niterations;
    stats.residualNorm = currentStats.residualNorm;
    stats.residualRms = currentStats.residualRms;
    if isfield(currentStats, 'nfevals')
      stats.nfevals = currentStats.nfevals;
    end
    defects = bvpMeshDefects(odefun, x, y, parameters, options);
    stats.maxDefect = max(defects);
    stats.rmsDefect = sqrt(sum(defects(:) .^ 2) / numel(defects));
    if refine < maxRefines && bvpCanRefine(x, options, defects, bvpTolerance(options, y(:)))
      [x, y] = bvpRefineMesh(odefun, x, y, parameters, defects, options);
      stats.nrefinements = stats.nrefinements + 1;
    end
  end
  yp = bvpEvaluateSlopes(odefun, x, y, parameters, options);
  stats.nmeshpoints = length(x);
  sol = struct('solver', solver, 'x', x, 'y', y, 'yp', yp, ...
    'parameters', parameters, 'stats', stats, ...
    'extdata', struct('slopes', yp));
end
%=============================================================================
function passes = bvpRefinementPasses(solver, options)
  if strcmp(solver, 'bvp5c')
    passes = 4;
  else
    passes = 2;
  end
  nmax = bvpget(options, 'NMax', 1000);
  if nmax < 16
    passes = 1;
  end
end
%=============================================================================
function bvpValidateFunctions(odefun, bcfun)
  if ~isa(odefun, 'function_handle') || ~isa(bcfun, 'function_handle')
    error('Nelson:ode_solvers:bvpFunctionHandlesExpected', 'BVP function handles expected.');
  end
end
%=============================================================================
function [x, y, parameters] = bvpNormalizeInitialSolution(solinit)
  if ~isstruct(solinit) || ~isfield(solinit, 'x') || ~isfield(solinit, 'y')
    error('Nelson:ode_solvers:bvpInitialSolutionStructureExpected', 'BVP initial solution structure expected.');
  end
  x = solinit.x(:).';
  y = solinit.y;
  if any(diff(x) <= 0) || size(y, 2) ~= length(x)
    error('Nelson:ode_solvers:bvpInitialSolutionInconsistentMeshValues', 'BVP initial solution has inconsistent mesh and values.');
  end
  if isfield(solinit, 'parameters')
    parameters = solinit.parameters(:).';
  else
    parameters = [];
  end
end
%=============================================================================
function options = bvpNormalizeOptions(options)
  if isempty(options)
    options = bvpset();
  elseif isstruct(options)
    options = bvpMergeOptions(bvpDefaultOptions(), options);
  else
    error('Nelson:ode_solvers:bvpOptionsStructureExpected', '%s options structure expected.', 'BVP');
  end
end
%=============================================================================
function [y, parameters, stats] = bvpNewtonSolve(odefun, bcfun, x, y, parameters, options)
  u = bvpPack(y, parameters);
  tolerance = bvpTolerance(options, u);
  stats = struct('niterations', 0, 'residualNorm', Inf, 'residualRms', Inf);
  for iter = 1:20
    residual = bvpResidual(odefun, bcfun, x, u, size(y, 1), numel(parameters), options);
    stats.residualNorm = max(abs(residual));
    stats.residualRms = sqrt(sum(abs(residual(:)) .^ 2) / numel(residual));
    stats.niterations = iter;
    if stats.residualNorm <= tolerance
      break
    end
    [kinsolAccepted, u, kinsolStats] = bvpTryKinsol(...
      odefun, bcfun, x, u, size(y, 1), numel(parameters), tolerance, residual, options);
    if kinsolAccepted
      residual = bvpResidual(odefun, bcfun, x, u, size(y, 1), numel(parameters), options);
      stats.residualNorm = max(abs(residual));
      stats.residualRms = sqrt(sum(abs(residual(:)) .^ 2) / numel(residual));
      stats.niterations = kinsolStats.niterations;
      stats.nfevals = kinsolStats.nfevals;
      break
    end
    jacobian = bvpJacobian(odefun, bcfun, x, u, size(y, 1), numel(parameters), residual, options);
    if size(jacobian, 1) ~= size(jacobian, 2)
      error('Nelson:ode_solvers:boundaryConditionsCloseBvpSystem', 'Boundary conditions must close the BVP system.');
    end
    step = -(jacobian \ residual);
    u = bvpDampedUpdate(odefun, bcfun, x, u, step, size(y, 1), ...
      numel(parameters), stats.residualNorm, options);
  end
  if stats.residualNorm > 10 * tolerance
    error('Nelson:ode_solvers:bvpSolverFailedMeetRequestedTolerance', 'BVP solver failed to meet the requested tolerance.');
  end
  [y, parameters] = bvpUnpack(u, size(y, 1), length(x), numel(parameters));
end
%=============================================================================
function [accepted, u, stats] = bvpTryKinsol(odefun, bcfun, x, u, n, np, tolerance, residual, options)
  accepted = false;
  stats = struct();
  if length(residual) ~= length(u) || ~bvpKinsolAvailable()
    return
  end
  try
    residualFcn = @(trial) bvpResidual(odefun, bcfun, x, trial, n, np, options);
    [candidate, stats] = __bvp_kinsol_solve__(residualFcn, u, tolerance);
    candidateResidual = residualFcn(candidate);
    if max(abs(candidateResidual)) <= max(tolerance, max(abs(residual)))
      u = candidate(:);
      accepted = true;
    end
  catch
    accepted = false;
  end
end
%=============================================================================
function tf = bvpKinsolAvailable()
  tf = true;
end
%=============================================================================
function tolerance = bvpTolerance(options, u)
  absTol = bvpget(options, 'AbsTol', 1e-6);
  relTol = bvpget(options, 'RelTol', 1e-3);
  tolerance = max(absTol, relTol * max(1, max(abs(u))));
end
%=============================================================================
function u = bvpPack(y, parameters)
  u = [y(:); parameters(:)];
end
%=============================================================================
function [y, parameters] = bvpUnpack(u, n, m, np)
  y = reshape(u(1:n * m), n, m);
  parameters = u(n * m + (1:np)).';
end
%=============================================================================
function jacobian = bvpJacobian(odefun, bcfun, x, u, n, np, residual, options)
  fJacobian = bvpget(options, 'FJacobian', []);
  bcJacobian = bvpget(options, 'BCJacobian', []);
  if isempty(fJacobian) || isempty(bcJacobian)
    jacobian = bvpFiniteDifferenceJacobian(odefun, bcfun, x, u, n, np, residual, options);
  else
    jacobian = bvpAnalyticJacobian(odefun, fJacobian, bcJacobian, x, u, n, np, options);
  end
end
%=============================================================================
function jacobian = bvpFiniteDifferenceJacobian(odefun, bcfun, x, u, n, np, residual, options)
  jacobian = zeros(length(residual), length(u));
  for k = 1:length(u)
    delta = sqrt(eps) * max(1, abs(u(k)));
    trial = u;
    trial(k) = trial(k) + delta;
    trialResidual = bvpResidual(odefun, bcfun, x, trial, n, np, options);
    jacobian(:, k) = (trialResidual - residual) / delta;
  end
end
%=============================================================================
function u = bvpDampedUpdate(odefun, bcfun, x, u, step, n, np, residualNorm, options)
  factor = 1;
  for k = 1:8
    trial = u + factor * step;
    trialResidual = bvpResidual(odefun, bcfun, x, trial, n, np, options);
    if max(abs(trialResidual)) < residualNorm
      u = trial;
      return
    end
    factor = 0.5 * factor;
  end
  u = u + factor * step;
end
%=============================================================================
function values = bvpOdeCall(fcn, x, y, parameters, options)
  if isempty(parameters) || (nargin(fcn) ~= -1 && nargin(fcn) < 3)
    values = feval(fcn, x, y);
  else
    values = feval(fcn, x, y, parameters);
  end
  if isvector(values)
    values = values(:);
  end
  if nargin >= 5
    values = values + bvpSingularValue(options, x, y);
  end
end
%=============================================================================
function values = bvpBcCall(fcn, ya, yb, parameters)
  if isempty(parameters) || (nargin(fcn) ~= -1 && nargin(fcn) < 3)
    values = feval(fcn, ya, yb);
  else
    values = feval(fcn, ya, yb, parameters);
  end
  values = values(:);
end
%=============================================================================
function tf = bvpCanRefine(x, options, defects, tolerance)
  nmax = bvpget(options, 'NMax', 1000);
  tf = length(x) < nmax && any(defects > max(10 * tolerance, sqrt(eps)));
end
%=============================================================================
function [newX, newY] = bvpRefineMesh(odefun, x, y, parameters, defects, options)
  nmax = bvpget(options, 'NMax', 1000);
  threshold = max(bvpMedian(defects), 0.25 * max(defects));
  selected = find(defects >= threshold);
  capacity = max(0, nmax - length(x));
  selected = selected(1:min(length(selected), capacity));
  newX = sort([x, 0.5 * (x(selected) + x(selected + 1))]);
  slopes = bvpEvaluateSlopes(odefun, x, y, parameters, options);
  newY = odeDevalInterpolate(x, y, newX, slopes);
end
%=============================================================================
function value = bvpMedian(values)
  sortedValues = sort(values(:));
  count = numel(sortedValues);
  middle = floor((count + 1) / 2);
  value = sortedValues(middle);
  if mod(count, 2) == 0
    value = 0.5 * (value + sortedValues(middle + 1));
  end
end
%=============================================================================
function defects = bvpMeshDefects(odefun, x, y, parameters, options)
  slopes = bvpEvaluateSlopes(odefun, x, y, parameters, options);
  defects = zeros(1, length(x) - 1);
  for k = 1:(length(x) - 1)
    h = x(k + 1) - x(k);
    xm = 0.5 * (x(k) + x(k + 1));
    ym = odeDevalInterpolate(x(k:(k + 1)), y(:, k:(k + 1)), xm, slopes(:, k:(k + 1)));
    fm = bvpOdeCall(odefun, xm, ym, parameters, options);
    chord = (y(:, k + 1) - y(:, k)) / h;
    defects(k) = max(abs(chord - fm));
  end
end
%=============================================================================
function yp = bvpEvaluateSlopes(odefun, x, y, parameters, options)
  if strcmp(bvpget(options, 'Vectorized', 'off'), 'on')
    try
      yp = bvpOdeCall(odefun, x, y, parameters, options);
      if isequal(size(yp), size(y))
        return
      end
    catch
    end
  end
  yp = zeros(size(y));
  for k = 1:length(x)
    yp(:, k) = bvpOdeCall(odefun, x(k), y(:, k), parameters, options);
  end
end
%=============================================================================
function jacobian = bvpAnalyticJacobian(odefun, fJacobian, bcJacobian, x, u, n, np, options)
  [y, parameters] = bvpUnpack(u, n, length(x), np);
  intervals = length(x) - 1;
  jacobian = zeros(n * intervals + n + np, length(u));
  eyeN = eye(n);
  for k = 1:intervals
    row = (k - 1) * n + (1:n);
    h = x(k + 1) - x(k);
    [a0, b0] = bvpOdeJacobian(fJacobian, x(k), y(:, k), parameters, n, np, options);
    [a1, b1] = bvpOdeJacobian(fJacobian, x(k + 1), y(:, k + 1), parameters, n, np, options);
    f0 = bvpOdeCall(odefun, x(k), y(:, k), parameters, options);
    f1 = bvpOdeCall(odefun, x(k + 1), y(:, k + 1), parameters, options);
    midY = 0.5 * (y(:, k) + y(:, k + 1)) - h * (f1 - f0) / 8;
    [am, bm] = bvpOdeJacobian(fJacobian, 0.5 * (x(k) + x(k + 1)), midY, parameters, n, np, options);
    dmid0 = 0.5 * eyeN + h * a0 / 8;
    dmid1 = 0.5 * eyeN - h * a1 / 8;
    col0 = (k - 1) * n + (1:n);
    col1 = k * n + (1:n);
    jacobian(row, col0) = -eyeN - h * (a0 + 4 * am * dmid0) / 6;
    jacobian(row, col1) = eyeN - h * (4 * am * dmid1 + a1) / 6;
    if np > 0
      dmidp = -h * (b1 - b0) / 8;
      jacobian(row, n * length(x) + (1:np)) = -h * (b0 + 4 * (am * dmidp + bm) + b1) / 6;
    end
  end
  [dya, dyb, dpar] = bvpBoundaryJacobian(bcJacobian, y(:, 1), y(:, end), parameters, n, np);
  bcRows = n * intervals + (1:(n + np));
  jacobian(bcRows, 1:n) = dya;
  jacobian(bcRows, n * (length(x) - 1) + (1:n)) = dyb;
  if np > 0
    jacobian(bcRows, n * length(x) + (1:np)) = dpar;
  end
end
%=============================================================================
function [dfdy, dfdp] = bvpOdeJacobian(fcn, x, y, parameters, n, np, options)
  try
    if isempty(parameters) || (nargin(fcn) ~= -1 && nargin(fcn) < 3)
      [dfdy, dfdp] = feval(fcn, x, y);
    else
      [dfdy, dfdp] = feval(fcn, x, y, parameters);
    end
  catch
    if isempty(parameters) || (nargin(fcn) ~= -1 && nargin(fcn) < 3)
      dfdy = feval(fcn, x, y);
    else
      dfdy = feval(fcn, x, y, parameters);
    end
    dfdp = [];
  end
  dfdy = full(dfdy);
  if isempty(dfdp)
    dfdp = zeros(n, np);
  else
    dfdp = full(dfdp);
  end
  dfdy = dfdy + bvpSingularJacobian(options, x, n);
  if size(dfdy, 1) ~= n || size(dfdy, 2) ~= n || size(dfdp, 1) ~= n || size(dfdp, 2) ~= np
    error('Nelson:ode_solvers:bvpOdeJacobianInconsistentDimensions', 'BVP ODE Jacobian has inconsistent dimensions.');
  end
end
%=============================================================================
function [dya, dyb, dpar] = bvpBoundaryJacobian(fcn, ya, yb, parameters, n, np)
  try
    if isempty(parameters) || (nargin(fcn) ~= -1 && nargin(fcn) < 3)
      [dya, dyb, dpar] = feval(fcn, ya, yb);
    else
      [dya, dyb, dpar] = feval(fcn, ya, yb, parameters);
    end
  catch
    dpar = [];
    if isempty(parameters) || (nargin(fcn) ~= -1 && nargin(fcn) < 3)
      [dya, dyb] = feval(fcn, ya, yb);
    else
      [dya, dyb] = feval(fcn, ya, yb, parameters);
    end
  end
  dya = full(dya);
  dyb = full(dyb);
  if isempty(dpar)
    dpar = zeros(n + np, np);
  else
    dpar = full(dpar);
  end
  if size(dya, 1) ~= n + np || size(dya, 2) ~= n ...
      || size(dyb, 1) ~= n + np || size(dyb, 2) ~= n ...
      || size(dpar, 1) ~= n + np || size(dpar, 2) ~= np
    error('Nelson:ode_solvers:bvpBoundaryJacobianInconsistentDimensions', 'BVP boundary Jacobian has inconsistent dimensions.');
  end
end
%=============================================================================
function value = bvpSingularValue(options, x, y)
  value = zeros(size(y));
  singularTerm = bvpget(options, 'SingularTerm', []);
  if isempty(singularTerm)
    return
  end
  if ~isnumeric(singularTerm) || ~isreal(singularTerm) ...
      || size(singularTerm, 1) ~= size(y, 1) || size(singularTerm, 2) ~= size(y, 1)
    error('Nelson:ode_solvers:singulartermRealSquareMatrixMatchingState', 'SingularTerm must be a real square matrix matching the state size.');
  end
  if isscalar(x)
    value = bvpScalarSingularValue(singularTerm, x, y);
  else
    for k = 1:length(x)
      value(:, k) = bvpScalarSingularValue(singularTerm, x(k), y(:, k));
    end
  end
end
%=============================================================================
function value = bvpScalarSingularValue(singularTerm, x, y)
  value = zeros(size(y));
  product = singularTerm * y;
  if abs(x) <= eps
    if max(abs(product)) > sqrt(eps)
      error('Nelson:ode_solvers:singulartermRequiresConsistentLeftBoundaryValue', 'SingularTerm requires a consistent left boundary value.');
    end
    return
  end
  value = product / x;
end
%=============================================================================
function value = bvpSingularJacobian(options, x, n)
  value = zeros(n, n);
  singularTerm = bvpget(options, 'SingularTerm', []);
  if isempty(singularTerm)
    return
  end
  if abs(x) > eps
    value = singularTerm / x;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function options = ddeDefaultOptions()
  options = struct('AbsTol', [], 'Events', [], 'InitialStep', [], ...
    'InitialY', [], 'Jumps', [], 'MaxStep', [], 'NormControl', [], ...
    'OutputFcn', [], 'OutputSel', [], 'Refine', [], 'RelTol', [], 'Stats', []);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function options = ddeMergeOptions(options, extra)
  names = fieldnames(extra);
  for k = 1:length(names)
    name = ddeOptionName(names{k});
    options.(name) = extra.(names{k});
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function name = ddeOptionName(name)
  if isstring(name)
    name = char(name);
  end
  if ~ischar(name)
    error('Nelson:ode_solvers:ddeOptionNameExpected', '%s option name expected.', 'DDE');
  end
  names = fieldnames(ddeDefaultOptions());
  idx = find(strcmpi(name, names));
  if isempty(idx)
    idx = ddePartialMatches(name, names);
  end
  if isempty(idx)
    error('Nelson:ode_solvers:unknownDdeOptionName', 'Unknown %s option name.', 'DDE');
  end
  if length(idx) > 1
    error('Nelson:ode_solvers:ambiguousDdeOptionName', 'Ambiguous %s option name.', 'DDE');
  end
  name = names{idx(1)};
end
%=============================================================================
function idx = ddePartialMatches(name, names)
  idx = [];
  for k = 1:length(names)
    candidate = names{k};
    if length(name) <= length(candidate) && strcmpi(name, candidate(1:length(name)))
      idx(end + 1) = k;
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function sol = ddeRunSolver(name, ddefun, delays, slopeDelays, history, tspan, options)
  ddeValidateInputs(ddefun, tspan);
  ddeOptions = ddeNormalizeOptions(options);
  [y0, yp0] = ddeInitialState(history, tspan(1), ddeOptions);
  tspan = ddeApplyJumps(tspan, ddeOptions.Jumps);
  options = ddeOptionsToOdeOptions(ddeOptions);
  [delays, slopeDelays] = ddeNormalizeDelays(name, delays, slopeDelays);
  delay = odeDelay('History', ddeStateHistory(history), ...
    'ValueDelay', delays, 'SlopeDelay', slopeDelays);
  sol = odeRunDelaySolver('ode45', ddefun, tspan, y0, yp0, options, delay);
  sol.solver = name;
  if isfield(sol, 'extdata') && isfield(sol.extdata, 'slopes')
    sol.yp = sol.extdata.slopes;
  else
    [~, sol.yp] = deval(sol, sol.x);
  end
end
%=============================================================================
function history = ddeStateHistory(history)
  if iscell(history)
    history = history{1};
  end
end
%=============================================================================
function options = ddeOptionsToOdeOptions(ddeOptions)
  options = odeDefaultOptions();
  names = {'AbsTol', 'Events', 'InitialStep', 'MaxStep', 'NormControl', ...
    'OutputFcn', 'OutputSel', 'Refine', 'RelTol', 'Stats'};
  for k = 1:length(names)
    options.(names{k}) = ddeOptions.(names{k});
  end
  options.Parameters = [];
end
%=============================================================================
function [delays, slopeDelays] = ddeNormalizeDelays(name, delays, slopeDelays)
  if strcmp(name, 'dde23')
    return
  end
  delays = ddeWrapDelayTimes(delays);
  slopeDelays = ddeWrapDelayTimes(slopeDelays);
end
%=============================================================================
function delayValue = ddeWrapDelayTimes(delayValue)
  if isempty(delayValue) || ~isa(delayValue, 'function_handle')
    return
  end
  delayFcn = delayValue;
  delayValue = @(t, y) ddeDelayTimesToLags(delayFcn, t, y);
end
%=============================================================================
function lags = ddeDelayTimesToLags(delayFcn, t, y)
  delayedTimes = feval(delayFcn, t, y);
  lags = t - min(delayedTimes(:), t);
  lags = max(lags, sqrt(eps) * (1 + abs(t)));
end
%=============================================================================
function ddeValidateInputs(ddefun, tspan)
  if ~isa(ddefun, 'function_handle')
    error('Nelson:ode_solvers:ddeFunctionHandleExpected', '%s function handle expected.', 'DDE');
  end
  if ~isnumeric(tspan) || numel(tspan) < 2 || any(~isfinite(tspan(:)))
    error('Nelson:ode_solvers:timeSpanContainLeastTwoFinite', 'Time span must contain at least two finite numeric values.');
  end
  if tspan(1) == tspan(numel(tspan))
    error('Nelson:ode_solvers:timeSpanEndpointsDistinct', 'Time span endpoints must be distinct.');
  end
end
%=============================================================================
function options = ddeNormalizeOptions(options)
  if isempty(options)
    options = ddeset();
  elseif ~isstruct(options)
    error('Nelson:ode_solvers:ddeOptionsStructureExpected', '%s options structure expected.', 'DDE');
  end
  options = ddeMergeOptions(ddeDefaultOptions(), options);
  if ~isfield(options, 'Parameters')
    options.Parameters = [];
  end
end
%=============================================================================
function tspan = ddeApplyJumps(tspan, jumps)
  tspan = tspan(:).';
  if isempty(jumps)
    return
  end
  if ~isnumeric(jumps) || any(~isfinite(jumps(:)))
    error('Nelson:ode_solvers:jumpsFiniteNumericValues', 'Jumps must be finite numeric values.');
  end
  direction = sign(tspan(length(tspan)) - tspan(1));
  inside = jumps(direction * (jumps - tspan(1)) > 0 ...
    & direction * (tspan(length(tspan)) - jumps) > 0);
  tspan = [tspan inside(:).'];
  if direction < 0
    tspan = sort(tspan, 'descend');
  else
    tspan = sort(tspan);
  end
  tspan = unique(tspan, 'stable');
end
%=============================================================================
function [y0, yp0] = ddeInitialState(history, t0, options)
  yp0 = [];
  if ~isempty(options.InitialY)
    y0 = options.InitialY;
  elseif iscell(history)
    if length(history) ~= 2
      error('Nelson:ode_solvers:historyCellArrayContainInitialValues', 'History cell array must contain initial values and slopes.');
    end
    y0 = history{1};
    yp0 = history{2};
  elseif isa(history, 'function_handle')
    y0 = feval(history, t0);
  elseif isstruct(history)
    [y0, yp0] = deval(history, t0);
  elseif isnumeric(history)
    y0 = history;
  else
    error('Nelson:ode_solvers:historyNumericFunctionHandleCellArray', 'History must be numeric, a function handle, a cell array, or a solution structure.');
  end
  if ~isnumeric(y0) || isempty(y0) || any(~isfinite(y0(:)))
    error('Nelson:ode_solvers:historyEvaluateFiniteNumericValues', 'History must evaluate to finite numeric values.');
  end
  y0 = y0(:);
  if ~isempty(yp0)
    yp0 = yp0(:);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function solverState = odeAcceptStep(problem, solverState, oldT, oldY, oldSlope, h, t, y, slope)
  if ~odeUsesSolverHistory(problem.solver)
    return
  end
  if ~odeStepReachedEndOfAttempt(problem, oldT, h, t)
    solverState = odeInitialSolverState(problem, t, y, slope);
    solverState.historyValid = false;
    return
  end
  solverState.t(end + 1) = t;
  solverState.y(:, end + 1) = y(:);
  solverState.slope(:, end + 1) = slope(:);
  maxHistory = odeMaxSolverHistory(problem.solver);
  if length(solverState.t) > maxHistory
    first = length(solverState.t) - maxHistory + 1;
    solverState.t = solverState.t(first:end);
    solverState.y = solverState.y(:, first:end);
    solverState.slope = solverState.slope(:, first:end);
  end
  solverState.historyValid = true;
end
%=============================================================================
function tf = odeUsesSolverHistory(solver)
  tf = strcmp(solver, 'ode113') || strcmp(solver, 'ode15s');
end
%=============================================================================
function maxHistory = odeMaxSolverHistory(solver)
  if strcmp(solver, 'ode15s')
    % BDF-5 needs five history points plus one more for the same-order
    % predictor.
    maxHistory = 6;
  else
    maxHistory = 5;
  end
end
%=============================================================================
function tf = odeStepReachedEndOfAttempt(problem, oldT, h, t)
  expectedT = oldT + h;
  tf = abs(t - expectedT) <= eps * (1 + abs(expectedT));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [yhigh, ylow, evals] = odeAdamsMoultonStep(problem, t, y, h, solverState)
  if odeHasAdamsHistory(solverState, h, 5)
    [yhigh, ylow, evals] = odeAdamsMoultonFiveStep(problem, t, y, h, solverState);
  elseif odeHasAdamsHistory(solverState, h, 4)
    [yhigh, ylow, evals] = odeAdamsMoultonFourStep(problem, t, y, h, solverState);
  else
    [yhigh, ylow, evals] = odeDormandPrinceStep(problem, t, y, h);
    return
  end
end
%=============================================================================
function [yhigh, ylow, evals] = odeAdamsMoultonFourStep(problem, t, y, h, solverState)
  f = solverState.slope;
  n = size(f, 2);
  f0 = f(:, n);
  f1 = f(:, n - 1);
  f2 = f(:, n - 2);
  f3 = f(:, n - 3);
  ylow = y + h * (55 * f0 - 59 * f1 + 37 * f2 - 9 * f3) / 24;
  fpred = odeRhs(problem, t + h, ylow);
  yhigh = y + h * (9 * fpred + 19 * f0 - 5 * f1 + f2) / 24;
  evals = 1;
end
%=============================================================================
function [yhigh, ylow, evals] = odeAdamsMoultonFiveStep(problem, t, y, h, solverState)
  f = solverState.slope;
  n = size(f, 2);
  f0 = f(:, n);
  f1 = f(:, n - 1);
  f2 = f(:, n - 2);
  f3 = f(:, n - 3);
  f4 = f(:, n - 4);
  ylow = y + h * (1901 * f0 - 2774 * f1 + 2616 * f2 - 1274 * f3 + 251 * f4) / 720;
  fpred = odeRhs(problem, t + h, ylow);
  yhigh = y + h * (251 * fpred + 646 * f0 - 264 * f1 + 106 * f2 - 19 * f3) / 720;
  evals = 1;
end
%=============================================================================
function tf = odeHasAdamsHistory(solverState, h, count)
  tf = false;
  if ~isfield(solverState, 'historyValid') || ~solverState.historyValid
    return
  end
  if ~isfield(solverState, 't') || length(solverState.t) < count
    return
  end
  dt = diff(solverState.t);
  recent = dt(length(dt) - count + 2:length(dt));
  if any(abs(recent) <= eps)
    return
  end
  scale = max(abs(h), eps);
  tf = all(abs(recent - h) <= 0.25 * scale);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [xe, ye, ie] = odeAppendEvent(xe, ye, ie, ev)
  if isempty(ev.t)
    return
  end
  xe = [xe, ev.t];
  ye = [ye, ev.y];
  ie = [ie, ev.i];
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function args = odeAppendParameters(args, parameters)
  if isempty(parameters)
    return
  end
  if iscell(parameters)
    args = [args, parameters];
  else
    args = [args, {parameters}];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function solout = odeAppendSolutions(left, right)
  right = odeSolutionData(right);
  solout = left;
  solout.x = [left.x, right.x(2:length(right.x))];
  solout.y = [left.y, right.y(:, 2:size(right.y, 2))];
  if isfield(left, 'extdata') && isfield(left.extdata, 'slopes') ...
      && isfield(right, 'extdata') && isfield(right.extdata, 'slopes')
    solout.extdata.slopes = [left.extdata.slopes, right.extdata.slopes(:, 2:size(right.extdata.slopes, 2))];
  end
  solout.xe = [left.xe, right.xe];
  solout.ye = [left.ye, right.ye];
  solout.ie = [left.ie, right.ie];
  if isempty(solout.xe)
    solout = rmfield(solout, {'xe', 'ye', 'ie'});
  end
  solout.stats.nsteps = left.stats.nsteps + right.stats.nsteps;
  solout.stats.nfailed = left.stats.nfailed + right.stats.nfailed;
  solout.stats.nfevals = left.stats.nfevals + right.stats.nfevals;
  solout.stats.tfinal = right.stats.tfinal;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [initialValue, initialSlope, options] = ...
    odeApplyConsistentInitialConditions(solver, odefun, t0, initialValue, initialSlope, options)
  if ~(strcmp(solver, 'ode15i') || strcmp(solver, 'idas')) ...
      || ~odeShouldComputeConsistentInitialConditions(options)
    return
  end
  initialValue = initialValue(:);
  if isempty(initialSlope)
    initialSlope = zeros(size(initialValue));
  else
    initialSlope = initialSlope(:);
  end
  residual = @(t, y, yp) odeCallFcn(odefun, t, y, options, yp);
  fixedValue = true(size(initialValue));
  fixedSlope = false(size(initialSlope));
  [initialValue, initialSlope] = decic(residual, t0, initialValue, fixedValue, ...
    initialSlope, fixedSlope, options);
  odeCheckConsistentInitialResidual(residual, t0, initialValue, initialSlope, options);
  options.InitialSlope = initialSlope;
end
%=============================================================================
function tf = odeShouldComputeConsistentInitialConditions(options)
  tf = isfield(options, 'ComputeConsistentInitialConditions') ...
    && logical(options.ComputeConsistentInitialConditions);
end
%=============================================================================
function odeCheckConsistentInitialResidual(residual, t0, initialValue, initialSlope, options)
  value = residual(t0, initialValue, initialSlope);
  value = value(:);
  if any(~isfinite(value))
    error('Nelson:ode_solvers:consistentInitialConditionsProducedNonFinite', 'Consistent initial conditions produced a non-finite residual.');
  end
  absTolerance = max(options.AbsTol(:));
  relTolerance = max(options.RelTol(:));
  scale = max(absTolerance, relTolerance * max(1, max(abs(initialValue(:)))));
  if norm(value, inf) > 1000 * scale
    error('Nelson:ode_solvers:consistentInitialConditionsResidualTooLarge', 'Consistent initial conditions residual is too large.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function options = odeApplyDefaults(options, tspan, y0, solver)
  tfinal = tspan(length(tspan));
  odeValidateRawOptions(options, y0, solver);
  if isempty(options.RelTol)
    options.RelTol = 1e-3;
  end
  if isempty(options.AbsTol)
    options.AbsTol = 1e-6;
  end
  if isempty(options.MaxStep)
    options.MaxStep = abs(tfinal - tspan(1)) / 10;
  end
  if isempty(options.MinStep)
    options.MinStep = 0;
  end
  if isempty(options.InitialStep)
    options.InitialStep = odeDefaultInitialStep(tspan, solver);
  end
  if isempty(options.Refine)
    options.Refine = odeDefaultRefine(solver);
  end
  options.AbsTol = odeExpandTolerance(options.AbsTol, y0);
end
%=============================================================================
function step = odeDefaultInitialStep(tspan, solver)
  interval = abs(tspan(length(tspan)) - tspan(1));
  switch solver
    case {'ode15i', 'idas'}
      step = interval / 40;
    otherwise
      step = interval / 100;
  end
end
%=============================================================================
function refine = odeDefaultRefine(solver)
  switch solver
    case 'ode45'
      refine = 4;
    case {'ode78', 'ode89'}
      refine = 8;
    otherwise
      refine = 1;
  end
end
%=============================================================================
function odeValidateRawOptions(options, y0, solver)
  odeValidatePositiveScalar(options.RelTol, 'RelTol', false);
  odeValidatePositiveScalar(options.MaxStep, 'MaxStep', false);
  odeValidatePositiveScalar(options.InitialStep, 'InitialStep', false);
  odeValidatePositiveScalar(options.MinStep, 'MinStep', false);
  odeValidatePositiveScalar(options.Refine, 'Refine', true);
  if ~isempty(options.Refine) && fix(options.Refine) ~= options.Refine
    error('Nelson:ode_solvers:refineIntegerScalar', 'Refine must be an integer scalar.');
  end
  if ~isempty(options.AbsTol) && (~isnumeric(options.AbsTol) || any(options.AbsTol(:) <= 0))
    error('Nelson:ode_solvers:positiveAbsoluteToleranceExpected', 'Positive absolute tolerance expected.');
  end
  if ~isempty(options.Events) && ~isa(options.Events, 'function_handle')
    error('Nelson:ode_solvers:eventFunctionHandleExpected', '%s function handle expected.', 'Event');
  end
  if ~isempty(options.OutputFcn) && ~isa(options.OutputFcn, 'function_handle')
    error('Nelson:ode_solvers:outputFunctionHandleExpected', '%s function handle expected.', 'Output');
  end
  odeValidateIndexOption(options.OutputSel, y0, 'OutputSel');
  odeValidateIndexOption(options.NonNegative, y0, 'NonNegative');
  odeValidateOnOff(options.Stats, 'Stats');
  odeValidateVectorized(options.Vectorized, solver);
  odeValidateOnOff(options.NormControl, 'NormControl');
  odeValidateOnOff(options.BDF, 'BDF');
  odeValidateOnOff(options.JConstant, 'JConstant');
  odeValidateChoice(options.LinearSolver, 'LinearSolver', ...
    {'auto', 'dense', 'spgmr', 'spfgmr', 'spbcgs', 'sptfqmr', 'pcg', 'klu'});
  odeValidateChoice(options.Preconditioner, 'Preconditioner', ...
    {'auto', 'none', 'jacobi', 'banded', 'ilu0'});
  odeValidateChoice(options.MassSingular, 'MassSingular', {'yes', 'no', 'maybe'});
  odeValidateChoice(options.MStateDependence, 'MStateDependence', {'none', 'weak', 'strong'});
  odeValidateMaxOrder(options.MaxOrder, solver);
  odeValidateMatrixOrFunction(options.Mass, length(y0(:)), 'Mass');
  odeValidateMatrixOrFunction(options.Jacobian, length(y0(:)), 'Jacobian');
  odeValidatePatternOption(options.JPattern, length(y0(:)), 'JPattern');
  odeValidatePatternOption(options.MvPattern, length(y0(:)), 'MvPattern');
end
%=============================================================================
function odeValidatePositiveScalar(value, name, allowZero)
  if isempty(value)
    return
  end
  if ~isnumeric(value) || ~isscalar(value) || ~isfinite(value)
    error('Nelson:ode_solvers:mustBeFiniteScalar', '%s must be a finite scalar.', name);
  end
  if allowZero
    valid = value >= 0;
  else
    valid = value > 0;
  end
  if ~valid
    error('Nelson:validators:mustBePositive', '%s must be positive.', name);
  end
end
%=============================================================================
function odeValidateIndexOption(value, y0, name)
  if isempty(value)
    return
  end
  n = length(y0(:));
  if ~isnumeric(value) || any(value(:) < 1) || any(value(:) > n) || any(fix(value(:)) ~= value(:))
    error('Nelson:ode_solvers:invalidIndex', '%s indices are invalid.', name);
  end
end
%=============================================================================
function odeValidateOnOff(value, name)
  if isempty(value)
    return
  end
  if isstring(value)
    value = char(value);
  end
  if ~ischar(value) || ~(strcmpi(value, 'on') || strcmpi(value, 'off'))
    error('Nelson:ode_solvers:invalidValue:valueOff', '%s must be ''on'' or ''off''.', name);
  end
end
%=============================================================================
function odeValidateVectorized(value, solver)
  if isempty(value)
    return
  end
  if iscell(value) && (strcmp(solver, 'ode15i') || strcmp(solver, 'idas'))
    if numel(value) ~= 2
      error('Nelson:ode_solvers:invalidValue:valueOff', '%s must be ''on'' or ''off''.', 'Vectorized');
    end
    odeValidateOnOff(value{1}, 'Vectorized');
    odeValidateOnOff(value{2}, 'Vectorized');
    return
  end
  odeValidateOnOff(value, 'Vectorized');
end
%=============================================================================
function odeValidateChoice(value, name, choices)
  if isempty(value)
    return
  end
  if isstring(value)
    value = char(value);
  end
  if ~ischar(value)
    error('Nelson:ode_solvers:invalidValue', '%s has an invalid value.', name);
  end
  valid = false;
  for k = 1:length(choices)
    valid = valid || strcmpi(value, choices{k});
  end
  if ~valid
    error('Nelson:ode_solvers:invalidValue', '%s has an invalid value.', name);
  end
end
%=============================================================================
function odeValidateMaxOrder(value, solver)
  if isempty(value)
    return
  end
  maximum = 5;
  if strcmp(solver, 'cvodesnonstiff')
    maximum = 12;
  end
  if ~isnumeric(value) || ~isscalar(value) || ~isfinite(value) ...
      || fix(value) ~= value || value < 1 || value > maximum
    error('Nelson:ode_solvers:maxorderIntegerScalarBetween', 'MaxOrder must be an integer scalar between %d and %d.', 1, maximum);
  end
end
%=============================================================================
function odeValidateMatrixOrFunction(value, n, name)
  if isempty(value) || isa(value, 'function_handle')
    return
  end
  if ~isnumeric(value)
    error('Nelson:ode_solvers:invalidType:valueNumericAFunctionHandle', '%s must be numeric or a function handle.', name);
  end
  if isscalar(value)
    return
  end
  if ~isequal(size(value), [n n])
    error('Nelson:ode_solvers:sizeMismatch', '%s matrix has incompatible size.', name);
  end
end
%=============================================================================
function odeValidatePatternOption(value, n, name)
  if isempty(value)
    return
  end
  if ~(isnumeric(value) || islogical(value))
    error('Nelson:ode_solvers:invalidType', '%s must be a numeric or logical matrix.', name);
  end
  if ~isequal(size(value), [n n])
    error('Nelson:ode_solvers:sizeMismatch', '%s matrix has incompatible size.', name);
  end
end
%=============================================================================
function tol = odeExpandTolerance(tol, y0)
  if isscalar(tol)
    tol = tol * ones(size(y0(:)));
  else
    tol = tol(:);
  end
  if length(tol) ~= length(y0(:))
    error('Nelson:ode_solvers:absoluteToleranceSizeNotMatchInitial', 'Absolute tolerance size does not match initial value.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [stop, eventY] = odeApplyEventCallback(problem, eventT, eventY, eventIndex)
  stop = false;
  if ~isfield(problem.options, 'EventDefinitionObject')
    return
  end
  eventDefinition = problem.options.EventDefinitionObject;
  if ~strcmpi(odeEventResponseAt(eventDefinition.Response, eventIndex), 'callback')
    return
  end
  callback = eventDefinition.CallbackFcn;
  if isempty(callback)
    error('Nelson:ode_solvers:callbackFunctionHandleExpected', '%s function handle expected.', 'Callback');
  end
  args = {eventT, eventY, eventIndex};
  if isfield(problem.options, 'Parameters') && ~isempty(problem.options.Parameters)
    args = odeAppendParameters(args, problem.options.Parameters);
  end
  nout = nargout(callback);
  if nout < 0
    nout = 2;
  end
  if nout <= 0
    feval(callback, args{:});
  elseif nout == 1
    stop = odeStopFlag(feval(callback, args{:}), 'Callback');
  else
    [stop, eventY] = feval(callback, args{:});
    stop = odeStopFlag(stop, 'Callback');
  end
end

function response = odeEventResponseAt(responses, index)
  if iscell(responses)
    if numel(responses) == 1
      response = responses{1};
    elseif index <= numel(responses)
      response = responses{index};
    else
      response = 'proceed';
    end
  else
    response = responses;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = odeApplyNonNegative(problem, y)
  idx = problem.options.NonNegative;
  if ~isempty(idx)
    idx = idx(:);
    y(idx) = max(y(idx), 0);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [yhigh, ylow, evals] = odeBDF2Step(problem, t, y, h, solverState)
  if ~odeHasBDF2History(solverState, h)
    [yhigh, ylow, evals] = odeBDF2StartupStep(problem, t, y, h);
    return
  end

  f0 = odeRhs(problem, t, y);
  [jac0, jacEvals] = odeRhsJacobian(problem, t, y, f0);
  yprevious = solverState.y(:, size(solverState.y, 2) - 1);
  lastIndex = length(solverState.t);
  hprevious = solverState.t(lastIndex) - solverState.t(lastIndex - 1);
  coeffs = odeBDF2Coefficients(h, hprevious);
  ypredicted = odeBDF2Advance(y, yprevious, h, f0, jac0, coeffs);
  f1 = odeRhs(problem, t + h, ypredicted);
  [jac1, jacEvals1] = odeBDF2JacobianAtEnd(problem, t + h, ypredicted, f1, jac0);
  % Modified-Newton iteration on the BDF2 equation. Iterating to a small
  % residual (instead of a single correction) keeps the solve error under
  % control even when the supplied Jacobian is inexact, so the truncation
  % error estimate below remains the dominant error term.
  ybdf2 = ypredicted;
  fEnd = f1;
  newtonEvals = 0;
  for iteration = 1:4
    ynext = odeBDF2ImplicitCorrect(y, yprevious, h, ybdf2, fEnd, jac1, coeffs);
    delta = ynext - ybdf2;
    ybdf2 = ynext;
    scale = problem.options.AbsTol + abs(ybdf2) * problem.options.RelTol;
    if max(abs(delta) ./ scale) < 0.05
      break
    end
    fEnd = odeRhs(problem, t + h, ybdf2);
    newtonEvals = newtonEvals + 1;
  end
  yhigh = ybdf2;
  % Milne-device local error estimate: the corrected solution is compared
  % with the quadratic extrapolant through the solution history, giving an
  % O(h^3) estimate matching the order of the BDF2 formula (instead of the
  % O(h) implicit-Euler comparison that forced tiny steps at tight
  % tolerances).
  ypoly = odeBDF2ExtrapolatedPredictor(solverState, t, y, h);
  ylow = yhigh - 1.2 * (ybdf2 - ypoly);
  evals = 2 + newtonEvals + jacEvals + jacEvals1;
end
%=============================================================================
function ypoly = odeBDF2ExtrapolatedPredictor(solverState, t, y, h)
  count = length(solverState.t);
  tnodes = [solverState.t(count - 1), t];
  ynodes = [solverState.y(:, count - 1), y];
  if count >= 3
    tnodes = [solverState.t(count - 2), tnodes];
    ynodes = [solverState.y(:, count - 2), ynodes];
  end
  tnew = t + h;
  ypoly = zeros(size(y));
  for k = 1:length(tnodes)
    weight = 1;
    for j = 1:length(tnodes)
      if j ~= k
        weight = weight * (tnew - tnodes(j)) / (tnodes(k) - tnodes(j));
      end
    end
    ypoly = ypoly + weight * ynodes(:, k);
  end
end
%=============================================================================
function [jac, evals] = odeBDF2JacobianAtEnd(problem, t, y, f, jac0)
  if ischar(problem.options.JConstant) && strcmpi(problem.options.JConstant, 'on')
    jac = jac0;
    evals = 0;
  else
    [jac, evals] = odeRhsJacobian(problem, t, y, f);
  end
end
%=============================================================================
function [yhigh, ylow, evals] = odeBDF2StartupStep(problem, t, y, h)
  f0 = odeRhs(problem, t, y);
  [jac0, jacEvals0] = odeRhsJacobian(problem, t, y, f0);
  yfull = odeBDF2CorrectedEulerAdvance(problem, t, y, h, f0, jac0);

  hhalf = h / 2;
  yhalf = odeBDF2CorrectedEulerAdvance(problem, t, y, hhalf, f0, jac0);
  fhalf = odeRhs(problem, t + hhalf, yhalf);
  if ischar(problem.options.JConstant) && strcmpi(problem.options.JConstant, 'on')
    jachalf = jac0;
    jacEvalsHalf = 0;
  else
    [jachalf, jacEvalsHalf] = odeRhsJacobian(problem, t + hhalf, yhalf, fhalf);
  end
  ytwohalf = odeBDF2CorrectedEulerAdvance(problem, t + hhalf, yhalf, hhalf, fhalf, jachalf);

  yhigh = 2 * ytwohalf - yfull;
  ylow = ytwohalf;
  evals = 5 + jacEvals0 + jacEvalsHalf;
end
%=============================================================================
function tf = odeHasBDF2History(solverState, h)
  tf = false;
  if ~isfield(solverState, 'historyValid') || ~solverState.historyValid
    return
  end
  if ~isfield(solverState, 't') || length(solverState.t) < 2
    return
  end
  if ~isfield(solverState, 'y') || size(solverState.y, 2) < 2
    return
  end
  lastIndex = length(solverState.t);
  hprevious = solverState.t(lastIndex) - solverState.t(lastIndex - 1);
  tf = sign(hprevious) == sign(h) && abs(hprevious) > eps;
end
%=============================================================================
function coeffs = odeBDF2Coefficients(h, hprevious)
  ratio = h / hprevious;
  coeffs = [(1 + 2 * ratio) / (1 + ratio), ...
    -(1 + ratio), ratio ^ 2 / (1 + ratio)];
end
%=============================================================================
function ynext = odeBDF2CorrectedEulerAdvance(problem, t, y, h, f, jac)
  ypredicted = odeBDF2LinearlyImplicitEulerAdvance(y, h, f, jac);
  f1 = odeRhs(problem, t + h, ypredicted);
  ynext = y + h * f1;
end
%=============================================================================
function ynext = odeBDF2Advance(y, yprevious, h, f, jac, coeffs)
  n = length(y);
  identity = eye(n, n);
  alpha = coeffs(1) / h;
  rhs = f - jac * y - (coeffs(2) * y + coeffs(3) * yprevious) / h;
  ynext = (alpha * identity - jac) \ rhs;
end
%=============================================================================
function ynext = odeBDF2ImplicitCorrect(y, yprevious, h, ypredicted, f, jac, coeffs)
  n = length(y);
  identity = eye(n, n);
  alpha = coeffs(1) / h;
  rhs = f - jac * ypredicted - (coeffs(2) * y + coeffs(3) * yprevious) / h;
  ynext = (alpha * identity - jac) \ rhs;
end
%=============================================================================
function ynext = odeBDF2LinearlyImplicitEulerAdvance(y, h, f, jac)
  n = length(y);
  ynext = y + h * ((eye(n, n) - h * jac) \ f);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% Current BDF order for the ode15s kernel, derived deterministically from
% the accumulated solution history so both the step kernel and the step
% size controller agree on it. BDF-k needs k history points plus one more
% for the same-order predictor, hence history length minus one, capped by
% MaxOrder and the stability limit 5.
function k = odeBDFOrderFromState(problem, solverState)
  maximumOrder = 5;
  if ~isempty(problem.options.MaxOrder)
    maximumOrder = min(maximumOrder, problem.options.MaxOrder);
  end
  available = 1;
  if isfield(solverState, 'historyValid') && solverState.historyValid ...
      && isfield(solverState, 't')
    available = length(solverState.t) - 1;
  end
  k = max(1, min(available, maximumOrder));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% Variable-order, variable-step BDF kernel for ode15s (orders 2 to 5). The
% order grows with the accumulated solution history: BDF-k differentiates
% the polynomial interpolating the new point and the last k accepted points,
% and the local error is estimated with a Milne device against the
% extrapolant of the same order through the history alone. The implicit
% equation is solved with a modified-Newton iteration so an inexact
% supplied Jacobian cannot leave an uncontrolled solve residual. With fewer
% than three history points the BDF2 kernel (with its own startup) is used.
function [yhigh, ylow, evals] = odeBDFStep(problem, t, y, h, solverState)
  k = odeBDFOrderFromState(problem, solverState);
  if k <= 2
    [yhigh, ylow, evals] = odeBDF2Step(problem, t, y, h, solverState);
    return
  end
  f0 = odeRhs(problem, t, y);
  [jac, jacEvals] = odeRhsJacobian(problem, t, y, f0);
  count = length(solverState.t);
  tnew = t + h;
  historyT = solverState.t((count - k + 1):count);
  historyY = solverState.y(:, (count - k + 1):count);
  weights = odeBDFDerivativeWeights([historyT, tnew], tnew);
  % The derivative weights sum to zero analytically; enforcing it exactly
  % makes the formula reproduce constant solution components to rounding.
  weights(k + 1) = -sum(weights(1:k));
  historyTerm = historyY * weights(1:k).';
  leading = weights(k + 1);
  % Predictor: extrapolation of the degree-k polynomial through the last
  % k + 1 accepted points.
  ypred = odeBDFExtrapolate(solverState, k, tnew);
  % Numerical differentiation formula modification (Shampine-Reichelt):
  % the kappa term damps the leading truncation error of BDF-k, allowing
  % larger steps at the same accuracy. BDF='on' selects the plain BDF
  % formulas (kappa = 0).
  kappa = odeNDFKappa(problem, k);
  ndfShift = kappa * sum(1 ./ (1:k)) / h;
  ynext = ypred;
  fnext = odeRhs(problem, tnew, ynext);
  newtonEvals = 1;
  n = length(y);
  iterationMatrix = (leading - ndfShift) * eye(n, n) - jac;
  for iteration = 1:4
    residual = leading * ynext + historyTerm - fnext - ndfShift * (ynext - ypred);
    delta = iterationMatrix \ (-residual);
    ynext = ynext + delta;
    scale = problem.options.AbsTol + abs(ynext) * problem.options.RelTol;
    if max(abs(delta) ./ scale) < 0.05
      break
    end
    fnext = odeRhs(problem, tnew, ynext);
    newtonEvals = newtonEvals + 1;
  end
  yhigh = ynext;
  ylow = yhigh - 1.2 * (ynext - ypred) / (k + 1);
  evals = 1 + newtonEvals + jacEvals;
end
%=============================================================================
function kappa = odeNDFKappa(problem, k)
  if ischar(problem.options.BDF) && strcmpi(problem.options.BDF, 'on')
    kappa = 0;
    return
  end
  kappas = [-0.1850, -1 / 9, -0.0823, -0.0415, 0];
  kappa = kappas(k);
end
%=============================================================================
function weights = odeBDFDerivativeWeights(nodes, x)
  % Derivative of the Lagrange basis polynomials at x.
  count = length(nodes);
  weights = zeros(1, count);
  for i = 1:count
    total = 0;
    for m = 1:count
      if m == i
        continue
      end
      product = 1 / (nodes(i) - nodes(m));
      for j = 1:count
        if j ~= i && j ~= m
          product = product * (x - nodes(j)) / (nodes(i) - nodes(j));
        end
      end
      total = total + product;
    end
    weights(i) = total;
  end
end
%=============================================================================
function ypred = odeBDFExtrapolate(solverState, k, tnew)
  count = length(solverState.t);
  nodes = solverState.t((count - k):count);
  values = solverState.y(:, (count - k):count);
  weights = zeros(1, length(nodes));
  for i = 1:length(nodes)
    weight = 1;
    for j = 1:length(nodes)
      if j ~= i
        weight = weight * (tnew - nodes(j)) / (nodes(i) - nodes(j));
      end
    end
    weights(i) = weight;
  end
  % Lagrange weights sum to one analytically; enforcing it exactly keeps
  % constant solution components exact to rounding.
  weights(end) = weights(end) + (1 - sum(weights));
  ypred = values * weights.';
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [y3, y2, evals] = odeBogackiShampineStep(problem, t, y, h)
  k1 = odeRhs(problem, t, y);
  k2 = odeRhs(problem, t + h / 2, y + h * k1 / 2);
  k3 = odeRhs(problem, t + 3 * h / 4, y + 3 * h * k2 / 4);
  y3 = y + h * (2 * k1 / 9 + k2 / 3 + 4 * k3 / 9);
  k4 = odeRhs(problem, t + h, y3);
  y2 = y + h * (7 * k1 / 24 + k2 / 4 + k3 / 3 + k4 / 8);
  evals = 4;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function sol = odeBuildSolution(problem, x, y, slopes, xe, ye, ie, stats)
  extdata = struct();
  extdata.slopes = slopes;
  extdata.odefun = problem.odefun;
  extdata.options = problem.options;
  extdata.yp0 = problem.yp0;
  if isfield(problem, 'storeRequestedOutputOnly') && problem.storeRequestedOutputOnly
    extdata.requestedOutputOnly = true;
  end
  idata = struct();
  idata.f3d = [];
  idata.idxNonNegative = problem.options.NonNegative;
  if isempty(xe)
    sol = struct('solver', problem.solver, 'extdata', extdata, ...
      'x', x, 'y', y, 'stats', stats, 'idata', idata);
  else
    sol = struct('solver', problem.solver, 'extdata', extdata, ...
      'x', x, 'y', y, 'xe', xe, 'ye', ye, 'ie', ie, ...
      'stats', stats, 'idata', idata);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [value, isterminal, direction] = odeCallEvents(problem, t, y)
  if isfield(problem.options, 'EventDefinitionObject')
    [value, isterminal, direction] = odeCallEventObject(problem, t, y);
  elseif strcmp(problem.solver, 'ode15i')
    yp = odeRhs(problem, t, y);
    [value, isterminal, direction] = odeCallFcn(problem.options.Events, t, y, problem.options, yp);
  else
    [value, isterminal, direction] = odeCallFcn(problem.options.Events, t, y, problem.options);
  end
  [value, isterminal, direction] = odeValidateEventOutputs(value, isterminal, direction);
end
%=============================================================================
function [value, isterminal, direction] = odeValidateEventOutputs(value, isterminal, direction)
  if ~isnumeric(value) || isempty(value) || any(~isfinite(value(:)))
    error('Nelson:ode_solvers:eventValuesFiniteNumericValues', 'Event values must be finite numeric values.');
  end
  if ~(isnumeric(isterminal) || islogical(isterminal)) || isempty(isterminal) ...
      || any(~isfinite(double(isterminal(:))))
    error('Nelson:validators:mustBeNumericOrLogical', '%s must be numeric or logical.', 'Event terminal flags');
  end
  if ~isnumeric(direction) || isempty(direction) || any(~isfinite(direction(:)))
    error('Nelson:ode_solvers:eventDirectionsFiniteNumericValues', 'Event directions must be finite numeric values.');
  end
  n = numel(value);
  if numel(isterminal) ~= n || numel(direction) ~= n
    error('Nelson:ode_solvers:eventOutputsSameNumberElements', 'Event outputs must have the same number of elements.');
  end
  value = value(:);
  isterminal = isterminal(:);
  direction = direction(:);
end
%=============================================================================
function [value, isterminal, direction] = odeCallEventObject(problem, t, y)
  args = {problem.options.EventDefinitionObject, t, y};
  if strcmp(problem.solver, 'ode15i')
    yp = odeRhs(problem, t, y);
    args = [args, {yp}];
  end
  if isfield(problem.options, 'Parameters') && ~isempty(problem.options.Parameters)
    args = odeAppendParameters(args, problem.options.Parameters);
  end
  [value, isterminal, direction] = odeEvaluateEventObject(args{:});
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = odeCallFcn(fcn, t, y, options, yp)
  if nargin < 5
    args = {t, y};
  else
    args = {t, y, yp};
  end
  if isfield(options, 'Parameters') && ~isempty(options.Parameters)
    args = odeAppendParameters(args, options.Parameters);
  end
  if nargout == 0
    feval(fcn, args{:});
  else
    [varargout{1:nargout}] = feval(fcn, args{:});
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function stop = odeCallOutput(problem, t, y, flag)
  stop = false;
  outputFcn = problem.options.OutputFcn;
  if isempty(outputFcn)
    return
  end
  if ~isempty(problem.options.OutputSel) && (isempty(flag) || strcmp(flag, 'init'))
    y = y(problem.options.OutputSel, :);
  end
  args = {t, y, flag};
  if isfield(problem.options, 'Parameters') && ~isempty(problem.options.Parameters)
    args = odeAppendParameters(args, problem.options.Parameters);
  end
  result = feval(outputFcn, args{:});
  stop = odeStopFlag(result, 'OutputFcn');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function odeCheckDeferred(obj)
  if isempty(obj.ODEFcn)
    error('Nelson:ode_solvers:odeFunctionDefined', 'ODE function must be defined.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [eventState, stop, ev] = odeCheckEvents(problem, eventState, t0, y0, t1, y1)
  stop = false;
  ev = odeEmptyEvent(y0);
  if isempty(problem.options.Events)
    return
  end
  [value, isterminal, direction] = odeCallEvents(problem, t1, y1);
  value = value(:);
  isterminal = isterminal(:);
  direction = direction(:);
  for k = 1:length(value)
    isInitialHit = eventState.isInitial(k) && eventState.value(k) == 0 ...
      && odeDirectionMatches(value(k) - eventState.value(k), direction(k));
    if isInitialHit
      [callbackStop, eventY] = odeApplyEventCallback(problem, t0, y0, k);
      ev.t(end + 1) = t0;
      ev.y(:, end + 1) = eventY;
      ev.i(end + 1) = k;
      stop = stop || callbackStop;
    elseif odeHasCrossing(eventState.value(k), value(k), direction(k))
      [eventT, eventY] = odeLocateEvent(problem, k, eventState.value(k), value(k), t0, y0, t1, y1);
      [callbackStop, eventY] = odeApplyEventCallback(problem, eventT, eventY, k);
      ev.t(end + 1) = eventT;
      ev.y(:, end + 1) = eventY;
      ev.i(end + 1) = k;
      stop = stop || callbackStop || logical(isterminal(k));
    end
  end
  eventState.value = value;
  eventState.isterminal = isterminal;
  eventState.direction = direction;
  eventState.isInitial = odeLogicalLike(value, false);
end

function tf = odeDirectionMatches(slope, direction)
  tf = direction == 0 || (direction > 0 && slope > 0) || (direction < 0 && slope < 0);
end
%=============================================================================
function [eventT, eventY] = odeLocateEvent(problem, index, v0, v1, t0, y0, t1, y1)
  leftAlpha = 0;
  rightAlpha = 1;
  leftValue = v0;
  rightValue = v1;
  if rightValue == 0
    eventT = t1;
    eventY = y1;
    return
  end
  if leftValue == 0
    eventT = t0;
    eventY = y0;
    return
  end
  % Hermite interpolation of the state inside the step (using the end-point
  % slopes) so the located event tracks the solution curve, not its chord.
  slopes = [odeRhs(problem, t0, y0), odeRhs(problem, t1, y1)];
  for iter = 1:40
    midAlpha = (leftAlpha + rightAlpha) / 2;
    midT = t0 + midAlpha * (t1 - t0);
    midY = odeLinearInterpolate([t0 t1], [y0 y1], midT, slopes);
    values = odeCallEvents(problem, midT, midY);
    midValue = values(index);
    if midValue == 0
      leftAlpha = midAlpha;
      rightAlpha = midAlpha;
      break
    end
    if sign(leftValue) == sign(midValue)
      leftAlpha = midAlpha;
      leftValue = midValue;
    else
      rightAlpha = midAlpha;
      rightValue = midValue;
    end
  end
  alpha = (leftAlpha + rightAlpha) / 2;
  eventT = t0 + alpha * (t1 - t0);
  eventY = odeLinearInterpolate([t0 t1], [y0 y1], eventT, slopes);
end
