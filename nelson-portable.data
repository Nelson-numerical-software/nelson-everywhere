% LICENCE_BLOCK_END
%=============================================================================
function tf = iscategory(A, names)
  narginchk(2, 2);
  if isa(names, 'pattern')
    tf = ~isempty(categorical.categoryCodes(names, A.categoryNames));
    return
  end
  if isstring(names)
    names = cellstr(names);
  elseif ischar(names)
    names = {names};
  end
  tf = false(size(names));
  for k = 1:numel(names)
    tf(k) = any(strcmp(A.categoryNames, names{k}));
  end
end
