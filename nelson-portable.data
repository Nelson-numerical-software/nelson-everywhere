    {
      "type": "MassWithWeight",
      "label": "MassWithWeight",
      "acausal": true,
      "domain": "translational",
      "width": 100,
      "height": 80,
      "physicalPins": [
        {
          "name": "flange",
          "x": 0,
          "y": 40,
