function inferiorto(varargin)
  narginchk(1, Inf);
  for k = 1:nargin
    name = varargin{k};
    if (isstring(name) && isscalar(name))
      name = char(name);
    end
    if (~ischar(name) || ~isrow(name))
      error('Nelson:types:characterVectors2', '%s must be character vectors.', 'Class names');
    end
  end
  % Declares that the class currently being constructed has lower precedence
  % than the named classes when dispatching overloaded operators.
end
%=============================================================================
%=============================================================================
