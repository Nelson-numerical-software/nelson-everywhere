%=============================================================================
asserts.isequal(nargin('ksdensity'), -3);
asserts.isequal(nargout('ksdensity'), 3);
%=============================================================================
[f, xi, bw] = ksdensity([0 1 2], [0 1 2], 'Bandwidth', 1);
asserts.isapprox(f, [0.231634657144588; 0.294294576479907; 0.231634657144588], 1e-12);
asserts.isequal(xi, [0; 1; 2]);
asserts.isequal(bw, 1);
%=============================================================================
[f, xi, bw] = ksdensity([0 1 2]);
asserts.isequal(size(f), [100 1]);
asserts.isapprox(xi(1), -2.552718166397534, 1e-12);
asserts.isapprox(xi(end), 4.552718166397534, 1e-12);
asserts.isapprox(bw, 0.850906055465845, 1e-12);
%=============================================================================
F = ksdensity([0 1 2], [0 1 2], 'Bandwidth', 1, 'Function', 'cdf');
asserts.isapprox(F, [0.227135128626545; 0.5; 0.772864871373454], 1e-12);
S = ksdensity([0 1 2], [0 1 2], 'Bandwidth', 1, 'Function', 'survivor');
asserts.isapprox(S, [0.772864871373455; 0.5; 0.227135128626546], 1e-12);
H = ksdensity([0 1 2], [0 1 2], 'Bandwidth', 1, 'Function', 'cumhazard');
asserts.isapprox(H, [0.257651056318238; 0.693147180559945; 1.482210158316613], 1e-12);
%=============================================================================
f = ksdensity([0 1], [0 1], 'Bandwidth', 1, 'Weights', [1 3]);
asserts.isapprox(f, [0.281213613489716; 0.359699391430860], 1e-12);
%=============================================================================
f = ksdensity([1 2 3], [-1 1 4], 'Bandwidth', 1, 'Support', 'positive');
asserts.isapprox(f, [0; 0.231634657144588; 0.100131179814756], 1e-12);
%=============================================================================
q = ksdensity([0 1 2], [0.25 0.5 0.75], 'Bandwidth', 1, 'Function', 'icdf');
asserts.isapprox(q, [0.096110498950237; 1; 1.903889501049763], 1e-12);
%=============================================================================
asserts.checkerror('ksdensity()', _('Not enough input arguments.'));
asserts.checkerror('ksdensity({1})', sprintf(_('%s must be a real numeric vector.'), 'X'));
asserts.checkerror('ksdensity([1 2], [1 2], ''Weights'', [1 2 3])', sprintf(_('%s must match X.'), 'Weights'));
asserts.checkerror('ksdensity([1 2], [1 2], ''Bandwidth'', 0)', sprintf(_('%s must be a positive scalar.'), 'Bandwidth'));
asserts.checkerror('ksdensity([1 2], [1 2], ''Function'', ''bad'')', sprintf(_('Unsupported %s.'), 'function type'));
asserts.checkerror('ksdensity([1 2], [1 2], ''Kernel'', ''box'')', _('Only normal kernel is supported.'));
asserts.checkerror('ksdensity([1 2], [1 2], ''Support'', [2 1])', _('Support must be a two-element increasing vector.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
asserts.isequal(nargin('kstest'), -1);
asserts.isequal(nargout('kstest'), 4);
%=============================================================================
x = [-1.2 -0.4 0.1 0.3 0.8];
[h, p, ksstat, cv] = kstest(x);
asserts.isequal(h, false);
asserts.isapprox(p, 0.957493541127802, 1e-12);
asserts.isapprox(ksstat, 0.211855398583397, 1e-12);
asserts.isapprox(cv, 0.607361461908305, 1e-12);
%=============================================================================
cdf = [-2 0; -1 0.2; 0 0.5; 1 0.8; 2 1];
[h, p, ksstat, cv] = kstest(x, 'CDF', cdf);
asserts.isequal(h, false);
asserts.isapprox(p, 0.829019218303356, 1e-12);
asserts.isapprox(ksstat, 0.26, 1e-12);
asserts.isapprox(cv, 0.607361461908305, 1e-12);
%=============================================================================
xobj = [0 1 2];
cdfFunction = @(z) 0.2 + 0.3 .* z;
[h, p, ksstat, cv] = kstest(xobj, 'CDF', cdfFunction);
asserts.isequal(h, false);
asserts.isapprox(p, 0.998536663772354, 1e-12);
asserts.isapprox(ksstat, 0.2, 1e-12);
asserts.isapprox(cv, 0.784100275699685, 1e-12);
%=============================================================================
addpath([modulepath('statistics', 'tests'), '/classdef']);
cdfObject = NelsonKSTestCDF();
[h, p, ksstat, cv] = kstest(xobj, 'CDF', cdfObject);
asserts.isequal(h, false);
asserts.isapprox(p, 0.998536663772354, 1e-12);
asserts.isapprox(ksstat, 0.2, 1e-12);
asserts.isapprox(cv, 0.784100275699685, 1e-12);
%=============================================================================
[h, p, ksstat] = kstest(x, 'Tail', 'larger');
asserts.isequal(h, false);
asserts.isapprox(p, 0.638376465024447, 1e-12);
asserts.isapprox(ksstat, 0.211855398583397, 1e-12);
%=============================================================================
[h, p, ksstat] = kstest(x, 'Tail', 'smaller');
asserts.isequal(h, false);
asserts.isapprox(p, 0.811371926224080, 1e-12);
asserts.isapprox(ksstat, 0.144578258389676, 1e-12);
%=============================================================================
[h, p, ksstat] = kstest(x, 'C', cdf, 'Ta', 'smaller');
asserts.isequal(h, false);
asserts.isapprox(p, 0.723250242379842, 1e-12);
asserts.isapprox(ksstat, 0.18, 1e-12);
%=============================================================================
[h, p, ksstat] = kstest([x NaN]);
asserts.isequal(h, false);
asserts.isapprox(p, 0.957493541127802, 1e-12);
asserts.isapprox(ksstat, 0.211855398583397, 1e-12);
%=============================================================================
asserts.checkerror('kstest([1 2; 3 4])', sprintf(_('%s must be a vector.'), 'X'));
asserts.checkerror('kstest([NaN NaN])', _('X must contain at least one non-NaN value.'));
asserts.checkerror('kstest(x, ''CDF'', [0 0.5 1])', _('CDF must be a two-column matrix.'));
asserts.checkerror('kstest(x, ''CDF'', [0 0; 1 1])', _('CDF must cover all sample values.'));
asserts.checkerror('kstest(xobj, ''CDF'', @(z) 0.5)', sprintf(_('CDF function must return %s.'), 'one value per sample'));
asserts.checkerror('kstest(xobj, ''CDF'', @(z) z + 2)', sprintf(_('%s must be in the range [0,1].'), 'CDF values'));
asserts.checkerror('kstest(x, ''Alpha'', 2)', sprintf(_('%s must be a scalar in the range (0,1).'), 'ALPHA'));
asserts.checkerror('kstest(x, ''Tail'', ''bad'')', _('TAIL must be ''unequal'', ''larger'', or ''smaller''.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--WEIGHT 2-->
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('kstest2'), -1);
asserts.isequal(nargout('kstest2'), 3);
%=============================================================================
x1 = [1 2 3 4 5];
x2 = [2 3 4 6 8 10];
[h, p, ks2stat] = kstest2(x1, x2);
asserts.isequal(h, false);
asserts.isapprox(p, 0.367001385090225, 1e-12);
asserts.isapprox(ks2stat, 0.5, 1e-12);
%=============================================================================
[h, p, ks2stat] = kstest2(x1, x2, 'Tail', 'larger');
asserts.isequal(h, false);
asserts.isapprox(p, 0.255729159913101, 1e-12);
asserts.isapprox(ks2stat, 0.5, 1e-12);
%=============================================================================
[h, p, ks2stat] = kstest2(x1, x2, 'Tail', 'smaller');
asserts.isequal(h, false);
asserts.isequal(p, 1);
asserts.isequal(ks2stat, 0);
%=============================================================================
[h, p, ks2stat] = kstest2([1 1 2 2 3 NaN], [1 2 2 4]);
asserts.isequal(h, false);
asserts.isapprox(p, 0.994330585835702, 1e-12);
asserts.isapprox(ks2stat, 0.25, 1e-12);
%=============================================================================
[h, p, ks2stat] = kstest2(single([10 11 12 13]), single([1 2 3]), 'Alpha', 0.05);
asserts.isequal(h, true);
asserts.isapprox(p, 0.020503981704794, 1e-12);
asserts.isequal(ks2stat, 1);
%=============================================================================
[h, p, ks2stat] = kstest2([Inf 1 2], [1 2 3]);
asserts.isequal(h, false);
asserts.isapprox(p, 0.976212648864478, 1e-12);
asserts.isapprox(ks2stat, 0.333333333333333, 1e-12);
%=============================================================================
asserts.checkerror('kstest2([1 2; 3 4], [1 2])', sprintf(_('%s must be a real numeric vector.'), 'X1'));
asserts.checkerror('kstest2([1 2], [1 2; 3 4])', sprintf(_('%s must be a real numeric vector.'), 'X2'));
asserts.checkerror('kstest2([NaN NaN], [1 2])', sprintf(_('%s must be a real numeric vector.'), 'X1'));
asserts.checkerror('kstest2([1 2], [NaN])', sprintf(_('%s must be a real numeric vector.'), 'X2'));
asserts.checkerror('kstest2([1 2], [1 2], ''Alpha'')', _('Name-value arguments must be paired.'));
asserts.checkerror('kstest2([1 2], [1 2], ''Unknown'', 1)', _('Invalid name-value argument name.'));
asserts.checkerror('kstest2([1 2], [1 2], ''Alpha'', 2)', sprintf(_('%s must be a scalar in the range (0,1).'), 'ALPHA'));
asserts.checkerror('kstest2([1 2], [1 2], ''Tail'', ''bad'')', _('TAIL must be ''unequal'', ''larger'', or ''smaller''.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('kurtosis'), -2);
asserts.isequal(nargout('kurtosis'), 1);
%=============================================================================
y1 = kurtosis([1 2 3 4]);
asserts.isapprox(y1, 1.64, 1e-12);
%=============================================================================
A = [1 2 3; 4 NaN 6; 7 8 9];
y2 = kurtosis(A);
asserts.isapprox(y2, [1.5 1 1.5], 1e-12);
%=============================================================================
y3 = kurtosis(A, 0, 2);
asserts.istrue(all(isnan(y3)));
%=============================================================================
y4 = kurtosis(single([1 NaN 3]));
asserts.isequal(class(y4), 'single');
asserts.isequal(y4, single(1));
%=============================================================================
asserts.checkerror('kurtosis({1})', sprintf(_('%s must be a real numeric array.'), 'X'));
asserts.checkerror('kurtosis([1 2], 2)', sprintf(_('%s must be 0 or 1.'), 'Flag'));
asserts.checkerror('kurtosis([1 2], 1, 0)', _('Dimension must be a positive integer scalar, vector, or ''all''.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--WEIGHT 4-->
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('lasso'), -3);
asserts.isequal(nargout('lasso'), 2);
%=============================================================================
X = [1 0 2; 2 1 0; 3 1 1; 4 2 3; 5 3 5; 6 5 8; 7 8 13; 8 13 21];
y = X * [0; 2; -1] + 0.5;
[B, FitInfo] = lasso(X, y, 'Lambda', [0 0.1 0.5]);
REF = [0.003221749676649 0.183820374299024 0.086502291255244; ...
       1.989012466606983 0.270772093896595 0.216806009769157; ...
       -0.994292575247762 0 0];
asserts.isapprox(B, REF, 1e-12);
asserts.isequal(size(B(:, 1:2)), [3 2]);
asserts.isequal(FitInfo.Lambda(1:2), [0 0.1]);
asserts.isequal(FitInfo.DF(1:2), [3 2]);
asserts.isapprox(FitInfo.Intercept, [0.493014012717696 0.180873428330936 ...
                                    0.841414899053629], 1e-12);
asserts.isapprox(FitInfo.MSE, [0.000031482672177 0.858167203801974 ...
                              1.144402923827055], 1e-12);
asserts.isequal(FitInfo.DF, [3 2 2]);
asserts.isequal(FitInfo.Alpha, 1);
asserts.isequal(FitInfo.Lambda, [0 0.1 0.5]);
%=============================================================================
[B2, FitInfo2] = lasso(X, y, 'Lambda', [0.1 0.5], 'Alpha', 0.5, 'Standardize', false);
REF = [0.079690172928500 0.086107916664589; ...
       1.414808909644195 0.403448314589393; ...
       -0.666121806835798 -0.048230428358845];
asserts.isapprox(B2, REF, 1e-12);
asserts.isapprox(FitInfo2.Intercept, [0.343364439826608 0.392816665205448], 1e-12);
%=============================================================================
[B3, FitInfo3] = lasso(X, y, 'Lambda', 0.1, 'Intercept', false);
asserts.isapprox(B3, [0.174339654240931; 1.376741671768426; ...
                     -0.663301729644353], 1e-12);
asserts.isequal(FitInfo3.Intercept, 0);
%=============================================================================
[B4, FitInfo4] = lasso(X, y, 'NumLambda', 4, 'LambdaRatio', 0);
asserts.isapprox(FitInfo4.Lambda, [1.508811046288377 0.015088110462884 ...
                                  0.000150881104629 0], 1e-12);
asserts.isequal(size(B4), [3 4]);
%=============================================================================
[Bw, FitInfoW] = lasso(X, y, 'Lambda', [0.1 0.5], 'Weights', [1 1 1 1 2 2 2 2]);
REF = [0.106186357511525 0.003794111446580; ...
       0.312334647767217 0.260244413710441; ...
       0 0];
asserts.isapprox(Bw, REF, 1e-12);
asserts.isapprox(FitInfoW.Intercept, [0.337641472726502 1.135800953355391], 1e-12);
%=============================================================================
[Bempty, FitInfoEmpty] = lasso(X, y, 'Lambda', []);
asserts.isequal(size(Bempty), [3 100]);
asserts.isequal(size(FitInfoEmpty.Lambda), [1 100]);
%=============================================================================
asserts.checkerror('lasso()', _('Not enough input arguments.'));
asserts.checkerror('lasso({1}, [1])', sprintf(_('%s must be a real numeric matrix.'), 'X'));
asserts.checkerror('lasso([1], {1})', sprintf(_('%s must be a real numeric vector.'), 'Y'));
asserts.checkerror('lasso([1; 2], [1])', sprintf(_('%s must have the same number of rows.'), 'X and Y'));
asserts.checkerror('lasso([1; 2], [1; 2], ''Lambda'', -1)', sprintf(_('%s must be a nonnegative numeric vector.'), 'LAMBDA'));
asserts.checkerror('lasso([1; 2], [1; 2], ''Alpha'', 2)', _('ALPHA must be in the range (0,1].'));
asserts.checkerror('lasso([1; 2], [1; 2], ''Standardize'', 2)', sprintf(_('%s must be a logical scalar.'), 'STANDARDIZE'));
asserts.checkerror('lasso([1; 2], [1; 2], ''Weights'', [1 -1])', _('WEIGHTS must contain nonnegative values with at least one positive value.'));
asserts.checkerror('lasso([1; 2], [1; 2], ''CV'', 5)', _('Invalid name-value argument name.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('lillietest'), -2);
asserts.isequal(nargout('lillietest'), 4);
%=============================================================================
[h, p, kstat, critval] = lillietest([-1 -0.5 0 0.5 1]);
asserts.isequal(h, false);
asserts.isapprox(p, 0.5, 1e-12);
asserts.isapprox(kstat, 0.136455371567231, 1e-12);
asserts.isapprox(critval, 0.343821551051317, 1e-12);
%=============================================================================
[h2, p2, kstat2, critval2] = lillietest([0.1 0.2 0.4 0.9 1.6], ...
  'Distribution', 'exponential');
asserts.isequal(h2, false);
asserts.isapprox(p2, 0.5, 1e-12);
asserts.isapprox(kstat2, 0.154939460754474, 1e-12);
asserts.isapprox(critval2, critval, 1e-12);
%=============================================================================
[h3, p3, kstat3, critval3] = lillietest([-2 -1 0 1 2], ...
  'Distr', 'ev', 'Alpha', 0.1);
asserts.isequal(h3, true);
asserts.isapprox(p3, 0.003110438955619, 1e-12);
asserts.isapprox(kstat3, 0.431542606375316, 1e-12);
asserts.isapprox(critval3, 0.317306365956473, 1e-12);
%=============================================================================
[h4, p4, kstat4, critval4] = lillietest(single([-1 -0.5 NaN 0 0.5 1]), ...
  'MCTol', 0.01, 'Alpha', 0.2);
asserts.isequal(h4, false);
asserts.isequal(class(p4), 'double');
asserts.isapprox(p4, 0.5, 1e-12);
asserts.isapprox(kstat4, kstat, 1e-12);
asserts.isapprox(critval4, 0.284993850974512, 1e-12);
%=============================================================================
[h5, p5, kstat5, critval5] = lillietest([zeros(1, 20) 100]);
asserts.isequal(h5, true);
asserts.isapprox(p5, 0.001, 1e-12);
asserts.isapprox(kstat5, 0.538751279099597, 1e-12);
asserts.isapprox(critval5, 0.188326207784628, 1e-12);
%=============================================================================
asserts.checkerror('lillietest()', _('Not enough input arguments.'));
asserts.checkerror('lillietest({1})', sprintf(_('%s must be a real numeric vector.'), 'X'));
asserts.checkerror('lillietest([1 2 NaN])', _('X must contain at least four non-NaN observations.'));
asserts.checkerror('lillietest([1 2 3 4], ''Alpha'', 0.8)', _('ALPHA must be in the range [0.001,0.5] when MCTOL is not specified.'));
asserts.checkerror('lillietest([1 2 3 4], ''MCTol'', 2)', sprintf(_('%s must be a scalar in the range (0,1).'), 'MCTOL'));
asserts.checkerror('lillietest([1 2 3 4], ''Distribution'', ''gamma'')', sprintf(_('%s has an unsupported value.'), 'DISTRIBUTION'));
asserts.checkerror('lillietest([-1 1 2 3], ''Distribution'', ''exponential'')', _('X must be nonnegative for the exponential distribution.'));
asserts.checkerror('lillietest([1 2 3 4], ''Alpha'')', _('Name-value arguments must be paired.'));
asserts.checkerror('lillietest([1 2 3 4], ''Unknown'', ''normal'')', _('Invalid name-value argument name.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('linkage'), 4);
asserts.isequal(nargout('linkage'), 1);
%=============================================================================
X = [0 0; 1 0; 0 2; 4 4];
Z = linkage(X);
REF = [1 2 1; 3 5 2; 4 6 4.47213595499958];
asserts.isapprox(Z, REF, 1e-12);
%=============================================================================
D = squareform([0 1 2 3; 1 0 4 5; 2 4 0 6; 3 5 6 0]);
Z = linkage(D, 'complete');
asserts.isequal(Z, [1 2 1; 3 5 4; 4 6 6]);
%=============================================================================
Z = linkage(X, 'average');
REF = [1 2 1; 3 5 2.118033988749895; 4 6 5.042996734830653];
asserts.isapprox(Z, REF, 1e-12);
%=============================================================================
Z = linkage(X, 'weighted');
REF = [1 2 1; 3 5 2.118033988749895; 4 6 4.900281539872885];
asserts.isapprox(Z, REF, 1e-12);
%=============================================================================
Z = linkage(X, 'centroid');
REF = [1 2 1; 3 5 2.061552812808830; 4 6 4.955356249106169];
asserts.isapprox(Z, REF, 1e-12);
%=============================================================================
Z = linkage(X, 'median');
REF = [1 2 1; 3 5 2.061552812808830; 4 6 4.802343178074637];
asserts.isapprox(Z, REF, 1e-12);
%=============================================================================
Z = linkage(X, 'ward');
REF = [1 2 1; 3 5 2.380476142847617; 4 6 6.069047152011042];
asserts.isapprox(Z, REF, 1e-12);
%=============================================================================
Z = linkage(X, 'single', 'cityblock');
asserts.isequal(Z, [1 2 1; 3 5 2; 4 6 6]);
%=============================================================================
Z = linkage(X, 'single', 'minkowski', 1.5);
REF = [1 2 1; 3 5 2; 4 6 4.894521629542950];
asserts.isapprox(Z, REF, 1e-12);
%=============================================================================
asserts.checkerror('linkage()', _('Not enough input arguments.'));
asserts.checkerror('linkage({1})', _('Input must be a real numeric matrix or vector.'));
asserts.checkerror('linkage([1 2])', _('Distance vector length must be a binomial coefficient.'));
asserts.checkerror('linkage([1 2], ''single'')', _('Distance vector length must be a binomial coefficient.'));
asserts.checkerror('linkage([1; 2], ''unknown'')', _('Invalid linkage method.'));
asserts.checkerror('linkage(ones(1, 2))', _('Distance vector length must be a binomial coefficient.'));
asserts.checkerror('linkage(ones(1, 2, 2))', _('Input must be a real numeric matrix or vector.'));
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% <--REUSE PROCESS-->
%=============================================================================
asserts.isequal(nargin('logncdf'), 6);
asserts.isequal(nargout('logncdf'), 3);
%=============================================================================
x = [0 1 exp(1)];
R = logncdf(x);
E = [0 0.5 0.8413447460685429];
asserts.isapprox(R, E, 1e-15);
%=============================================================================
R = logncdf(exp([0 1 2]), 1, 2);
E = [0.3085375387259869 0.5 0.6914624612740131];
asserts.isapprox(R, E, 1e-15);
%=============================================================================
R = logncdf([0 1 exp(1)], 'upper');
E = [1 0.5 0.15865525393145707];
asserts.isapprox(R, E, 1e-15);
R = logncdf(exp(10), 'upper');
asserts.istrue(abs(R - 7.619853024160593e-24) < 1e-35);
%=============================================================================
[p, pLo, pUp] = logncdf(exp(1), 0, 1, [0.01 0; 0 0.04]);
asserts.isapprox(p, 0.8413447460685429, 1e-15);
asserts.isapprox(pLo, 0.7128529786997453, 1e-14);
asserts.isapprox(pUp, 0.9248200317736012, 1e-14);
%=============================================================================
R = logncdf(single([1 exp(1)]), single(0), single(1));
asserts.isequal(class(R), 'single');
asserts.isapprox(double(R), [0.5 0.8413447460685429], 1e-7);
%=============================================================================
R = logncdf([1 NaN 1 1], [0 0 NaN 0], [1 1 1 0]);
asserts.isapprox(R(1), 0.5, 1e-15);
asserts.istrue(all(isnan(R(2:4))));
%=============================================================================
R = logncdf([], [], []);
asserts.isequal(size(R), [0 0]);
%=============================================================================
asserts.checkerror('logncdf(ones(2), ones(3), 1)', _('Size mismatch on input arguments'));
asserts.checkerror('logncdf(1, 0, 1, ''bad'')', sprintf(_('Invalid %s distribution option.'), 'lognormal'));
asserts.checkerror('logncdf({1}, 0, 1)', sprintf(_('%s must be real numeric.'), 'X'));
asserts.checkerror('logncdf(1, {0}, 1)', sprintf(_('%s must be real numeric.'), 'MU'));
asserts.checkerror('logncdf(1, 0, {1})', sprintf(_('%s must be real numeric.'), 'SIGMA'));
%=============================================================================
