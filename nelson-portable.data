%=============================================================================
function obj = addevent(obj, eventValue)
  if ~isa(eventValue, 'tsdata.event')
    error('Nelson:time:inputEventObject', 'Input must be an event object.');
  end
  if isempty(obj.Events)
    obj.Events = eventValue;
  elseif iscell(obj.Events)
    obj.Events{end + 1, 1} = eventValue;
  else
    events = obj.Events;
    events(end + 1, 1) = eventValue;
    obj.Events = events;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function obj = addsample(obj, varargin)
  data = [];
  time = [];
  quality = [];
  for k = 1:2:length(varargin)
    name = lower(timeseriesText(varargin{k}, 'Property name'));
    switch name
      case 'data'
        data = varargin{k + 1};
      case 'time'
        time = varargin{k + 1};
      case 'quality'
        quality = varargin{k + 1};
      otherwise
        error('Nelson:time:unsupportedSampleProperty', 'Unsupported %s.', 'sample property');
    end
  end
  if isempty(time) || isempty(data)
    error('Nelson:time:sampleDataTimeRequired', 'Sample data and time are required.');
  end
  obj = append(obj, timeseries(data, time, quality, 'IsTimeFirst', obj.IsTimeFirst));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function obj = append(obj, varargin)
  for k = 1:length(varargin)
    other = varargin{k};
    if ~istimeseries(other)
      error('Nelson:time:allInputsTimeseriesObjects', 'All inputs must be timeseries objects.');
    end
    obj.Data_ = cat(timeseriesSampleDimension(obj.Data_, obj.IsTimeFirst_), obj.Data_, other.Data);
    obj.Time_ = [obj.Time_; other.Time(:)];
    if ~isempty(obj.Quality) || ~isempty(other.Quality)
      leftQuality = obj.Quality(:);
      rightQuality = other.Quality(:);
      if isempty(leftQuality)
        leftQuality = NaN(obj.Length - other.Length, 1);
      end
      if isempty(rightQuality)
        rightQuality = NaN(other.Length, 1);
      end
      obj.Quality_ = [leftQuality; rightQuality];
    end
    obj.Events = [obj.Events(:); other.Events(:)];
  end
  obj = timeseriesRefreshMetadata(obj);
  timeseriesValidate(obj);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function obj = delevent(obj, selector)
  if ischar(selector) || isstring(selector)
    events = obj.Events;
    keep = true(numel(events), 1);
    for k = 1:numel(events)
      currentEvent = timeseriesEventAt(events, k);
      keep(k) = ~strcmp(currentEvent.Name, char(selector));
    end
    obj.Events = events(keep);
  else
    obj.Events(selector) = [];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function obj = delsample(obj, varargin)
  if nargin == 2
    rows = timeseriesResolveRows(obj, varargin{1});
  elseif nargin == 3 && strcmpi(timeseriesText(varargin{1}, 'Selector'), 'index')
    rows = timeseriesResolveRows(obj, varargin{2});
  elseif nargin == 3 && strcmpi(timeseriesText(varargin{1}, 'Selector'), 'time')
    rows = find(obj.Time == varargin{2});
  else
    error('Nelson:time:invalidSampleSelector', 'Invalid %s.', 'sample selector');
  end
  keep = true(obj.Length, 1);
  keep(rows) = false;
  obj = timeseriesSubset(obj, find(keep));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function obj = detrend(obj, varargin)
  mode = 'linear';
  if nargin > 1
    mode = char(varargin{1});
  end
  y = timeseriesDataAsColumns(obj);
  if isempty(y)
    return
  end
  if strcmpi(mode, 'constant')
    obj.Data_ = y - mean(y, 1);
  else
    x = obj.Time(:);
    x = [x, ones(length(x), 1)];
    coeff = x \ y;
    obj.Data_ = y - x * coeff;
  end
end
