% LICENCE_BLOCK_END
%=============================================================================
function varargout = kron(varargin)
  % https://en.wikipedia.org/wiki/Kronecker_product
  narginchk(2, 2);
  nargoutchk(0, 1);

  A = varargin{1};
  B = varargin{2};

  if ~ismatrix(A) || ~ismatrix(B)
    error('Nelson:kron:inputMustBe2D', 'Inputs must be 2-D.');
  end

  if issparse(A) || issparse(B)
    varargout{1} = sparse(kron(full(A), full(B)));
  elseif (isa(A, 'double') || isa(A, 'single')) && ...
      (isa(B, 'double') || isa(B, 'single')) && ...
      isreal(A) && isreal(B)
    varargout{1} = builtin('kron', A, B);
  else
    [m, n] = size(A);
    [p, q] = size(B);
    % preserve integer / single classes (compatible with the reference implementation)
    if isinteger(A)
      outClass = class(A);
    elseif isinteger(B)
      outClass = class(B);
    elseif isa(A, 'single') || isa(B, 'single')
      outClass = 'single';
    else
      outClass = 'double';
    end
    result = zeros(m * p, n * q, outClass);
    for i = 1:m
      for j = 1:n
        a_ij = A(i, j);
        submatrix = a_ij * B;
        row_start = (i - 1) * p + 1;
        row_end = i * p;
        col_start = (j - 1) * q + 1;
        col_end = j * q;
        result(row_start:row_end, col_start:col_end) = submatrix;
      end
    end
    varargout{1} = result;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [X, r] = linsolve(A, B, opts)
  narginchk(2, 3);
  transA = false;
  if nargin == 3
    if ~isstruct(opts)
      error('Nelson:linsolve:invalidOptions', 'Third argument must be a structure of options.');
    end
    if isfield(opts, 'TRANSA') && ~isempty(opts.TRANSA) && opts.TRANSA
      transA = true;
    end
  end
  if transA
    X = A' \ B;
  else
    X = A \ B;
  end
  if nargout > 1
    r = rcond(A);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function Z = null(A, opt)
  narginchk(1, 2);
  nargoutchk(0, 1);
  if ~isnumeric(A) || ndims(A) > 2
    error('Nelson:null:invalidInput', 'Input must be a 2D numeric matrix.');
  end
  [m, n] = size(A);
  if nargin == 2
    if ~(ischar(opt) || (isstring(opt) && isscalar(opt))) || ~strcmpi(char(opt), 'r')
      error('Nelson:null:invalidOption', 'Second argument must be ''r''.');
    end
    % rational basis via reduced row echelon form
    [R, pivcol] = rref(A);
    r = numel(pivcol);
    nopiv = 1:n;
    nopiv(pivcol) = [];
    Z = zeros(n, n - r);
    if n > r
      Z(nopiv, :) = eye(n - r);
      Z(pivcol, :) = -R(1:r, nopiv);
    end
    return;
  end
  % orthonormal basis via singular value decomposition
  if isempty(A)
    Z = zeros(n, n);
    return;
  end
  [~, S, V] = svd(A);
  if m > 1
    s = diag(S);
  else
    s = S(1, 1);
  end
  tol = max(m, n) * eps(max(s));
  r = sum(s > tol);
  Z = V(:, r + 1:n);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = orth(varargin)
  narginchk(1, 2);
  nargoutchk(0, 1);

  A = varargin{1};
  [O, s] = svd(A, 'econ');
  d = diag(s);

  if ~isempty(d) && isnan(d(1))
    error('Nelson:linear_algebra:inputMustBeFinite', '%s must not contain NaN or Inf.', 'Input argument');
  end

  if nargin == 2
    tol = varargin{2};
    if ~(isscalar(tol) && isnumeric(tol) && isreal(tol))
      error('Nelson:orth:invalidTolerance', 'Input argument must be a real numeric scalar tolerance');
    end
  else
    tol = max(size(A)) * eps(norm(d, inf));
  end

  r = sum(d > tol);
  O(:, r + 1:end) = [];
  varargout{1} = O;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function Y = pagectranspose(X)
  narginchk(1, 1);
  nargoutchk(0, 1);
  Y = conj(pagetranspose(X));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function Y = pagenorm(X, p)
  narginchk(1, 2);
  nargoutchk(0, 1);
  if ~isnumeric(X)
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Input');
  end
  if nargin < 2
    p = 2;
  end
  sz = size(X);
  m = sz(1);
  n = sz(2);
  pagesSize = sz(3:end);
  npages = prod(pagesSize);
  Xr = reshape(X, m, n, npages);
  Y = zeros(1, 1, npages, class(X));
  for k = 1:npages
    Y(1, 1, k) = norm(Xr(:, :, k), p);
  end
  outSize = [1, 1, pagesSize];
  Y = reshape(Y, outSize);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = planerot(varargin)
  narginchk(1, 1);
  nargoutchk(0, 2);
  X = varargin{1};
  if (size(X, 1) ~= 2) || ~iscolumn(X)
    error('Nelson:planerot:invalidInput', 'First input must be a column vector of length 2.');
  end
  if X(2) == 0
    G = eye(2, class(X));
  else
    R = norm(X);
    G = [X'; [-X(2), X(1)]] ./ R;
    X = [R; 0];
  end

  varargout{1} = G;
  if nargout() > 1
    varargout{2} = X;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function R = rank(A, tol)
  S = svd(A);
  if (nargin == 1)
    maxS = max(S);
    if isempty(maxS)
      epsMax = eps;
    else
      epsMax = eps(maxS);
    end
    tol = max(size(A)) * epsMax;
  end
  R = sum(S > tol);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = rref(varargin)
  narginchk(1, 2);
  nargoutchk(0, 2);
  A = varargin{1};
  if (ndims(A) > 2)
    error('Nelson:rref:inputMustBe2D', 'Inputs must be 2-D.');
  end
  [rows, cols] = size(A);

  if (nargin == 2)
    tol = varargin{2};
  else
    tol = max(rows, cols) * eps(class(A)) * norm(A, inf);
  end

  if isempty(A)
    varargout{1} = A;
    if nargout > 1
      varargout{2} = zeros(1, 0);
    end
    return
  end
  used = zeros(1, cols);
  r = 1;
  for c = 1:cols
    [m, p] = max(abs(A(r:rows, c)));
    if (m > tol)
      used(1, c) = 1;
      ccols = c:cols;
      A(r, ccols) = A(r, ccols) / A(r, c);
      ridx = [1:r - 1, r + 1:rows];
      A(ridx, ccols) = A(ridx, ccols) - A(ridx, c) * A(r, ccols);
      if (r == rows)
        break;
      end
      r = r + 1;
    else
      A(r:rows, c) = zeros(rows - r + 1, 1);
    end
  end
  varargout{1} = A;
  if nargout > 1
    pivots = find(used);
    if isempty(pivots)
      pivots = zeros(1, 0);
    end
    varargout{2} = pivots;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = rsf2csf(varargin)
  narginchk(2, 2);
  nargoutchk(0, 2);
  U = varargin{1};
  T = varargin{2};
  order = size(T, 2);
  for blockEnd = order:-1:2
    subDiagonal = blockEnd - 1;
    if T(blockEnd, subDiagonal) ~= 0
      block = subDiagonal:blockEnd;
      rotation = schurBlockRotation(T(block, block), T(blockEnd, blockEnd), ...
        T(blockEnd, subDiagonal));
      T(block, subDiagonal:order) = rotation * T(block, subDiagonal:order);
      T(1:blockEnd, block) = T(1:blockEnd, block) * rotation';
      U(:, block) = U(:, block) * rotation';
      T(blockEnd, subDiagonal) = 0;
    end
  end
  varargout{1} = U;
  if (nargout == 2)
    varargout{2} = T;
  end
end
%=============================================================================
function rotation = schurBlockRotation(block, diagonalValue, subDiagonalValue)
  delta = eig(block) - diagonalValue;
  scale = hypot(delta(1), subDiagonalValue);
  cosineValue = delta(1) / scale;
  sineValue = subDiagonalValue / scale;
  rotation = [cosineValue', sineValue; -sineValue, cosineValue];
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function t = subspace(varargin)
  narginchk(2, 2);
  nargoutchk(0, 1);

  A = orth(varargin{1});
  B = orth(varargin{2});
  if size(A, 2) < size(B, 2)
    C = B;
    B = A;
    A = C;
  end
  B = B - A * (A' * B);
  t = asin(min(1, norm(B)));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function C = tensorprod(A, B, varargin)
  narginchk(2, inf);
  if ~isnumeric(A) || ~isnumeric(B)
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Inputs');
  end
  [dimA, dimB, contractAll, numDimsA] = parseArguments(varargin);
  ndA = ndims(A);
  if ~isempty(numDimsA)
    ndA = numDimsA;
  end
  ndB = ndims(B);
  if contractAll
    dimA = 1:ndA;
    dimB = 1:ndB;
  else
    if ~isempty(dimA)
      ndA = max(ndA, max(dimA));
    end
    if ~isempty(dimB)
      ndB = max(ndB, max(dimB));
    end
  end
  if numel(dimA) ~= numel(dimB)
    error('Nelson:tensorprod:contractedDimensionsMismatch', 'The number of contracted dimensions must match for both arrays.');
  end
  szA = sizePadded(A, ndA);
  szB = sizePadded(B, ndB);
  for k = 1:numel(dimA)
    if szA(dimA(k)) ~= szB(dimB(k))
      error('Nelson:dimagree:specifiedDimensionsInputArraysSizes', 'Specified dimensions of the input arrays must have the same sizes.');
    end
  end
  remA = setdiff(1:ndA, dimA, 'stable');
  remB = setdiff(1:ndB, dimB, 'stable');
  M1 = reshape(permute(A, [remA, dimA]), prod(szA(remA)), prod(szA(dimA)));
  M2 = reshape(permute(B, [dimB, remB]), prod(szB(dimB)), prod(szB(remB)));
  P = M1 * M2;
  outSize = [szA(remA), szB(remB)];
  if isempty(outSize)
    outSize = [1 1];
  elseif isscalar(outSize)
    outSize = [outSize, 1];
  end
  C = reshape(P, outSize);
end
%=============================================================================
function [dimA, dimB, contractAll, numDimsA] = parseArguments(args)
  dimA = [];
  dimB = [];
  contractAll = false;
  numDimsA = [];
  positional = {};
  k = 1;
  while k <= numel(args)
    a = args{k};
    if (ischar(a) || (isstring(a) && isscalar(a))) && strcmpi(char(a), 'NumDimensionsA')
      if k + 1 > numel(args)
        error('Nelson:tensorprod:valueExpected', 'Value expected after ''NumDimensionsA''.');
      end
      numDimsA = double(args{k + 1});
      k = k + 2;
    elseif (ischar(a) || (isstring(a) && isscalar(a))) && strcmpi(char(a), 'all')
      contractAll = true;
      k = k + 1;
    else
      positional{end + 1} = a;
      k = k + 1;
    end
  end
  if numel(positional) == 2
    dimA = double(positional{1});
    dimA = dimA(:).';
    dimB = double(positional{2});
    dimB = dimB(:).';
  elseif ~isempty(positional)
    error('Nelson:tensorprod:invalidContractedDimensions', 'Contracted dimensions must be given as two vectors DIMA and DIMB.');
  end
end
%=============================================================================
function sz = sizePadded(X, nd)
  sz = size(X);
  if numel(sz) < nd
    sz = [sz, ones(1, nd - numel(sz))];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function n = vecnorm(varargin)
  narginchk(1, 3);
  nargoutchk(0, 1);

  A = varargin{1};
  if (nargin > 1)
    p = varargin{2};
  else
    p = 2;
  end
  if (nargin > 2)
    dim = varargin{3};
  else
    dim = find(size(A) > 1, 1);
  end

  mustBeNumeric(A, 1);
  mustBePositive(p, 2);
  mustBePositive(dim, 3);

  if p == 1
    n = sum(abs(A), dim);
  elseif p == 2
    n = sqrt(sum(A .* conj(A), dim));
  elseif isinf(p)
    n = max(abs(A), [], dim);
  else
    if (rem(p, 2) == 0)
      if (iscomplex(A))
        n = (sum((real(A) .^ 2 + imag(A) .^ 2) .^ (p / 2), dim)) .^ (1 / p);
      else
        n = (sum(A .^ 2 .^ (p / 2), dim)) .^ (1 / p);
      end
    else
      n = (sum(abs(A) .^ p, dim)) .^ (1 / p);
    end
  end
end
