function msg = nmm_missing_dependency_message(dependencyName)
  msg = sprintf('%s not installed. Try nmm(''search'', ''%s'') to find it or nmm(''why'', ''%s'') to inspect installed reverse dependencies.', dependencyName, dependencyName, dependencyName);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
