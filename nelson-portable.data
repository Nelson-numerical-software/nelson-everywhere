% LICENCE_BLOCK_END
%=============================================================================
function stop = odeOutputStopAtThree(t, y, flag)
  global ODE_OUTPUT_STOP_LOG;
  if isempty(ODE_OUTPUT_STOP_LOG)
    ODE_OUTPUT_STOP_LOG = {};
  end
  entry = struct();
  entry.flag = flag;
  entry.t = t;
  entry.y = y;
  ODE_OUTPUT_STOP_LOG{end + 1} = entry;
  stop = isempty(flag) && t >= 0.3;
end
