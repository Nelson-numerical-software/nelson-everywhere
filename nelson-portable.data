function y = sawtooth(varargin)
  narginchk(1, 2);
  nargoutchk(0, 1);
  t = varargin{1};
  width = 1;
  if nargin == 2
    width = varargin{2};
  end
  phase = mod(t / (2 * pi), 1);
  y = zeros(size(t));
  rising = phase < width;
  y(rising) = 2 * phase(rising) / width - 1;
  y(~rising) = 1 - 2 * (phase(~rising) - width) / (1 - width);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [b, g] = sgolay(k, f, w)
  narginchk(2, 3);
  nargoutchk(0, 2);
  if ~isscalar(k) || ~isfinite(k) || k ~= fix(k) || k < 0
    error('Nelson:signal:sgolay:invalidOrder', 'Polynomial order must be a nonnegative integer.');
  end
  if ~isscalar(f) || ~isfinite(f) || f ~= fix(f) || f <= 0 || mod(f, 2) == 0
    error('Nelson:signal:sgolay:invalidFrameLength', 'Frame length must be a positive odd integer.');
  end
  if k >= f
    error('Nelson:signal:sgolay:orderTooLarge', 'Polynomial order must be less than frame length.');
  end
  if nargin < 3 || isempty(w)
    w = ones(f, 1);
  else
    if ~isvector(w) || length(w) ~= f || any(w(:) <= 0) || any(~isfinite(w(:)))
      error('Nelson:signal:sgolay:invalidWeights', 'Weights must be a positive finite vector with frame length elements.');
    end
    w = w(:);
  end
  half = (f - 1) / 2;
  x = (-half:half)';
  A = zeros(f, k + 1);
  for p = 0:k
    A(:, p + 1) = x .^ p;
  end
  W = diag(w);
  g = A * inv(A' * W * A);
  b = g * A' * W;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = sgolayfilt(varargin)
  narginchk(3, 5);
  nargoutchk(0, 1);
  input = varargin{1};
  k = varargin{2};
  f = varargin{3};
  w = [];
  dim = [];
  if nargin >= 4
    w = varargin{4};
  end
  if nargin == 5
    dim = varargin{5};
  end
  if isempty(dim)
    dim = firstNonSingletonDimension(input);
  else
    validateDimension(dim);
  end
  b = sgolay(k, f, w);
  [x2D, permutationOrder, permutedShape] = reshapeInputAlongDimension(input, dim);
  y2D = zeros(size(x2D));
  for col = 1:size(x2D, 2)
    y2D(:, col) = filterVector(x2D(:, col), b, f);
  end
  y = ipermute(reshape(y2D, permutedShape), permutationOrder);
end
%=============================================================================
function dim = firstNonSingletonDimension(x)
  shape = size(x);
  dim = find(shape ~= 1, 1, 'first');
  if isempty(dim)
    dim = 1;
  end
end
%=============================================================================
function validateDimension(dim)
  if ~isscalar(dim) || ~isfinite(dim) || dim ~= fix(dim) || dim <= 0
    error('Nelson:signal:invalidDimension', '%s must be a positive integer scalar.', 'Dimension');
  end
end
%=============================================================================
function [x2D, permutationOrder, permutedShape] = reshapeInputAlongDimension(x, dim)
  shape = size(x);
  numberOfDimensions = max([2, ndims(x), dim]);
  if length(shape) < numberOfDimensions
    shape = [shape, ones(1, numberOfDimensions - length(shape))];
  end
  remainingDimensions = 1:numberOfDimensions;
  remainingDimensions(dim) = [];
  permutationOrder = [dim, remainingDimensions];
  permutedShape = shape(permutationOrder);
  x2D = reshape(permute(x, permutationOrder), permutedShape(1), []);
end
%=============================================================================
function y = filterVector(x, b, f)
  center = (f + 1) / 2;
  y = zeros(size(x));
  for idx = 1:center - 1
    y(idx) = b(idx, :) * x(1:f);
  end
  for idx = center:length(x) - center + 1
    y(idx) = b(center, :) * x(idx - center + 1:idx + center - 1);
  end
  for idx = length(x) - center + 2:length(x)
    row = f - (length(x) - idx);
    y(idx) = b(row, :) * x(end - f + 1:end);
  end
end
%=============================================================================
%=============================================================================
