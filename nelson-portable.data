e2_REF = [-0.1198 + 0.0000i; -0.6423 - 1.0335i; -0.6423 + 1.0335i];

asserts.isapprox(K2, K2_REF, 1e-4);
asserts.isapprox(e2, e2_REF, 1e-3);

