% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function r = nmm_validate(varargin)
  if length(varargin) < 1 || length(varargin) > 4
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  module_path = varargin{1};
  if ~ischar(module_path)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 2);
  end
  strict = false;
  asJson = false;
  includeWarnings = false;
  for k = 2:length(varargin)
    option = varargin{k};
    if ~ischar(option)
      nmm_error('CharactersExpected', '#%d argument: characters expected.', k + 1);
    end
    if strcmp(option, '-strict')
      strict = true;
    elseif strcmp(option, '-json')
      asJson = true;
    elseif strcmp(option, '-warnings')
      includeWarnings = true;
    else
      nmm_error('UnknownArgument', '#%d argument: unknown option.', k + 1);
    end
  end
  if asJson
    r = validateJsonReport(module_path, strict, includeWarnings);
    return
  end
  if includeWarnings
    r = validateWarningReport(module_path, strict);
    return
  end
  validateModule(module_path, strict);
  r = true;
end
%=============================================================================
function report = validateJsonReport(module_path, strict, includeWarnings)
  report = struct();
  report.ok = true;
  report.issues = {};
  report.warnings = {};
  try
    validateModule(module_path, strict);
    if includeWarnings
      report.warnings = validationWarnings(module_path);
    end
  catch
    e = lasterror();
    report.ok = false;
    report.issues = {e.message};
  end
  report = jsonprettyprint(jsonencode(report));
end
%=============================================================================
function report = validateWarningReport(module_path, strict)
  validateModule(module_path, strict);
  report = struct();
  report.ok = true;
  report.warnings = validationWarnings(module_path);
end
%=============================================================================
function validateModule(module_path, strict)
  [data, module_dir] = resolveManifest(module_path);
  nmm_validate_module_json(data);
  if isempty(module_dir)
    % lone module.json file: manifest fields only, no source-tree checks
    if strict
      validateStrictMetadata(data);
    end
    return
  end
  validateSourceStructure(module_dir);
  if strict
    validateStrictMetadata(data);
    validateStrictSourceStructure(module_dir);
  end
end
%=============================================================================
% Resolves a validate/warnings target to a manifest struct.
% module_path may be a module directory (module_dir is returned with a
% trailing slash) or a lone module.json file / any *.json (module_dir is '').
function [data, module_dir] = resolveManifest(module_path)
  if isManifestFile(module_path)
    module_dir = '';
    data = jsondecode(module_path, '-file');
    return
  end
  module_dir = ensureTrailingSlash(module_path);
  if ~isdir(module_dir)
    nmm_error('DirectoryExpectedExistingDirectoryExpected', 'an existing directory expected.');
  end
  module_json = [module_dir, 'module.json'];
  if ~isfile(module_json)
    nmm_error('ModuleJsonMissing', 'module.json is missing.');
  end
  data = jsondecode(module_json, '-file');
end
%=============================================================================
function tf = isManifestFile(module_path)
  tf = isfile(module_path) && endsWith(lower(module_path), '.json');
end
%=============================================================================
function warnings = validationWarnings(module_path)
  [data, module_dir] = resolveManifest(module_path);
  warnings = nmm_module_json_warnings(data);
  if isempty(module_dir)
    return
  end
  [xmlCount, chapterCount] = xmlHelpFileCount(module_dir);
  if xmlCount == 0
    warnings = appendWarning(warnings, _('XML help file is missing.'));
  elseif xmlCount == chapterCount
    warnings = appendWarning(warnings, 'module help pages are missing.');
  end
end
%=============================================================================
function warnings = appendWarning(warnings, message)
  warnings{end + 1} = message;
end
%=============================================================================
function [xmlCount, chapterCount] = xmlHelpFileCount(module_path)
  xmlCount = 0;
  chapterCount = 0;
  entries = dir([module_path, 'help']);
  for k = 1:length(entries)
    if ~entries(k).isdir || strcmp(entries(k).name, '.') || strcmp(entries(k).name, '..')
      continue
    end
    files = dir([module_path, 'help/', entries(k).name, '/xml/*.xml']);
    xmlCount = xmlCount + length(files);
    for j = 1:length(files)
      if strcmp(files(j).name, 'chapter.xml')
        chapterCount = chapterCount + 1;
      end
    end
  end
end
%=============================================================================
function validateTextField(value, fieldname)
  if isstring(value)
    value = char(value);
  end
  if ~ischar(value) || isempty(value)
    nmm_error('ModuleJsonTextFieldInvalid', 'module.json field must be a non-empty string: %s', fieldname);
  end
end
%=============================================================================
function validateSourceStructure(module_path)
  if ~isfile([module_path, 'builder.m']) && ~isfile([module_path, 'loader.m'])
    nmm_error('LoaderMissingBuilderMLoader', 'builder.m or loader.m is missing.');
  end
  if ~isdir([module_path, 'etc'])
    nmm_error('EtcDirectoryMissing', 'etc directory is missing.');
  end
  if ~isfile([module_path, 'etc/startup.m'])
    nmm_error('StartupMissing', 'etc/startup.m is missing.');
  end
  if ~isfile([module_path, 'etc/finish.m'])
    nmm_error('FinishMissing', 'etc/finish.m is missing.');
  end
  if ~isdir([module_path, 'help'])
    nmm_error('HelpDirectoryMissing', 'help directory is missing.');
  end
  if ~isdir([module_path, 'tests'])
    nmm_error('TestsDirectoryMissing', 'tests directory is missing.');
  end
end
%=============================================================================
function validateStrictMetadata(data)
  validateOptionalTextField(data, 'repository');
  validateOptionalTextField(data, 'homepage');
  validateKeywords(data);
  % issues and documentation are truly optional: validate only when present.
  validatePresentUrlField(data, 'issues');
  validatePresentUrlField(data, 'documentation');
end
%=============================================================================
function validateOptionalTextField(data, fieldname)
  if ~isfield(data, fieldname)
    nmm_error('ModuleJsonFieldMissing', 'module.json field is missing: %s', fieldname);
  end
  validateTextField(data.(fieldname), fieldname);
  if strcmp(fieldname, 'repository') || strcmp(fieldname, 'homepage')
    validateHttpUrl(data.(fieldname), fieldname);
  end
end
%=============================================================================
% Validates an optional HTTP-URL field only when it is present and non-empty.
% Absence is never an error (the field is optional); an empty value is ignored.
function validatePresentUrlField(data, fieldname)
  if ~isfield(data, fieldname)
    return
  end
  value = data.(fieldname);
  if isstring(value)
    value = char(value);
  end
  if ~ischar(value) || isempty(value)
    return
  end
  validateHttpUrl(value, fieldname);
end
%=============================================================================
function validateHttpUrl(value, fieldname)
  if ~(startsWith(value, 'http://') || startsWith(value, 'https://'))
    nmm_error('ModuleJsonUrlInvalid', 'module.json field must be an HTTP URL: %s', fieldname);
  end
end
%=============================================================================
function validateKeywords(data)
  if ~isfield(data, 'keywords')
    nmm_error('ModuleJsonFieldMissingModuleJsonField', 'module.json field is missing: keywords');
  end
  keywords = data.keywords;
  if isstring(keywords)
    keywords = cellstr(keywords);
  end
  if ~iscellstr(keywords) || isempty(keywords)
    nmm_error('ModuleJsonKeywordsInvalid', 'module.json field must be a non-empty cell of strings: keywords');
  end
end
%=============================================================================
function validateStrictSourceStructure(module_path)
  testFiles = dir([module_path, 'tests/*.m']);
  if isempty(testFiles)
    nmm_error('PackageTestsMissing', 'No package tests found.');
  end
  if ~hasXmlHelpFile(module_path)
    nmm_error('XmlHelpMissing', 'XML help file is missing.');
  end
end
%=============================================================================
function tf = hasXmlHelpFile(module_path)
  tf = false;
  entries = dir([module_path, 'help']);
  for k = 1:length(entries)
    if ~entries(k).isdir || strcmp(entries(k).name, '.') || strcmp(entries(k).name, '..')
      continue
    end
    files = dir([module_path, 'help/', entries(k).name, '/xml/*.xml']);
    if ~isempty(files)
      tf = true;
      return
    end
  end
end
%=============================================================================
function validateBuiltPackageStructure(module_path)
  if ~isfile([module_path, 'loader.m'])
    nmm_error('LoaderMissing', 'loader.m is missing.');
  end
  if ~isfile([module_path, 'module-lock.json'])
    nmm_error('ModuleLockMissing', 'module-lock.json is missing.');
  end
end
%=============================================================================
function path = ensureTrailingSlash(path)
  if ~endsWith(path, '/')
    path = [path, '/'];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
% Single source of truth for module.json manifest field validation.
% Validates the schema fields only (no source-tree structure checks).
% Reused by nmm_validate (structural validation) and nmm_init (manifest
% generation) so a generated manifest is always nmm-valid.
%=============================================================================
function nmm_validate_module_json(data)
  validateRequiredFields(data);
  validateModuleName(data.module);
  validateTextField(data.title, 'title');
  validateTextField(data.summary, 'summary');
  validateSemverVersion(data.version, 'version');
  validatePlatforms(data.platforms);
  validateNelsonCompatibility(data.nelson);
  validateBuiltin(data.builtin);
  validateLicense(data.license);
  validateDependencies(data.dependencies);
  validateFilesField(data);
end
%=============================================================================
% Optional 'files' packaging allowlist: an array of non-empty glob strings
% (see nmm_pack_select). Absent is valid; malformed is a clear error.
function validateFilesField(data)
  if ~isfield(data, 'files')
    return
  end
  value = data.files;
  if isstring(value)
    value = cellstr(value);
  end
  if ischar(value)
    value = {value};
  end
  if ~iscell(value) || isempty(value)
    nmm_error('ModuleJsonFilesInvalid', 'module.json field must be a non-empty array of strings: files');
  end
  for k = 1:numel(value)
    entry = value{k};
    if isstring(entry) && isscalar(entry)
      entry = char(entry);
    end
    if ~ischar(entry) || isempty(entry)
      nmm_error('ModuleJsonFilesInvalid', 'module.json field must be a non-empty array of strings: files');
    end
  end
end
%=============================================================================
function validateRequiredFields(data)
  required = {'module', 'title', 'summary', 'version', 'platforms', 'nelson', 'builtin', 'license', 'dependencies'};
  for k = required
    if ~isfield(data, k{1})
      nmm_error('ModuleJsonFieldMissing', 'module.json field is missing: %s', k{1});
    end
  end
end
%=============================================================================
function validateModuleName(module_name)
  validateTextField(module_name, 'module');
  if isempty(regexp(module_name, '^[A-Za-z][A-Za-z0-9_]*$', 'once'))
    nmm_error('InvalidModuleName', 'Invalid module name.');
  end
end
%=============================================================================
function validateTextField(value, fieldname)
  if isstring(value)
    value = char(value);
  end
  if ~ischar(value) || isempty(value)
    nmm_error('ModuleJsonTextFieldInvalid', 'module.json field must be a non-empty string: %s', fieldname);
  end
end
%=============================================================================
function validateSemverVersion(value, fieldname)
  validateTextField(value, fieldname);
  semver(value, value);
end
%=============================================================================
function validatePlatforms(platforms)
  [r, msg] = nmm_is_supported_platform(platforms);
  if ~r
    nmm_error('PlatformNotSupported', msg);
  end
end
%=============================================================================
function validateNelsonCompatibility(range)
  validateTextField(range, 'nelson');
  v = version('-number');
  current = sprintf('%d.%d.%d', v(1), v(2), v(3));
  if ~semverConstraintSatisfied(current, range)
    nmm_error('NelsonVersionNotSupported', 'Nelson version not supported: %s', range);
  end
end
%=============================================================================
function validateBuiltin(value)
  if ~(islogical(value) && isscalar(value))
    nmm_error('ModuleJsonBuiltinInvalid', 'module.json field must be a logical scalar: builtin');
  end
end
%=============================================================================
function validateLicense(value)
  validateTextField(value, 'license');
  if ~isSpdxExpression(value)
    nmm_error('ModuleJsonLicenseInvalid', 'module.json license must be a SPDX expression.');
  end
end
%=============================================================================
function tf = isSpdxExpression(value)
  tf = false;
  tokens = strsplit(strtrim(value), ' ');
  expectIdentifier = true;
  for k = 1:length(tokens)
    token = tokens{k};
    if isempty(token)
      continue
    end
    if expectIdentifier
      if ~isSpdxIdentifier(token)
        return
      end
      expectIdentifier = false;
    else
      if ~strcmp(token, 'AND') && ~strcmp(token, 'OR') && ~strcmp(token, 'WITH')
        return
      end
      expectIdentifier = true;
    end
  end
  tf = ~expectIdentifier;
end
%=============================================================================
function tf = isSpdxIdentifier(token)
  tf = ~isempty(regexp(token, '^[A-Za-z0-9][A-Za-z0-9\.\-\+]*$', 'once')) ...
      && (contains(token, '-') || any(strcmp(token, {'MIT', 'ISC', '0BSD'})));
end
%=============================================================================
function validateDependencies(dependencies)
  if ~isstruct(dependencies)
    nmm_error('ModuleJsonDependenciesInvalid', 'module.json field must be a struct: dependencies');
  end
  for name = fieldnames(dependencies)'
    validateModuleName(name{1});
    value = dependencies.(name{1});
    validateTextField(value, ['dependencies.', name{1}]);
    [isRepository, url, tag_branch] = nmm_is_http_repository(value);
    if ~isRepository && ~isdir(value) && ~isfile(value)
      validateSemverConstraint(value);
    end
  end
end
%=============================================================================
function validateSemverConstraint(value)
  if ~isVersionConstraint(value)
    semver(value, value);
    return
  end
  constraints = strsplit(strtrim(value), ' ');
  for k = 1:length(constraints)
    item = constraints{k};
    if isempty(item)
      continue
    end
    semver('1.0.0', item);
  end
end
%=============================================================================
function tf = semverConstraintSatisfied(version, constraint)
  if ~isVersionConstraint(constraint)
    tf = semver(version, constraint) == 0;
    return
  end
  tf = true;
  constraints = strsplit(strtrim(constraint), ' ');
  for k = 1:length(constraints)
    item = constraints{k};
    if isempty(item)
      continue
    end
    try
      if semver(version, item) ~= 1
        tf = false;
        return
      end
    catch
      tf = false;
      return
    end
  end
end
%=============================================================================
function tf = isVersionConstraint(value)
  tf = startsWith(value, '>') || startsWith(value, '<') ...
      || startsWith(value, '=') || startsWith(value, '^') ...
      || startsWith(value, '~') || contains(value, ' ');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function report = nmm_verify(varargin)
  if length(varargin) ~= 1
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  target = varargin{1};
  if ~ischar(target)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 2);
  end
  if isdir(target)
    report = verifySourceModule(target);
    return
  end
  if ~isfile(target)
    nmm_error('FilenameExpected', 'filename expected.');
  end
  if ~endsWith(target, '.nmz')
    nmm_error('InvalidPackageFileExtension', 'filename extension .nmz expected.');
  end
  verifyPackageChecksum(target);
  stagingPath = newTemporaryDirectory();
  try
    unzip(target, stagingPath);
    nmm_validate(stagingPath);
    validateBuiltPackageStructure(stagingPath);
    moduleInfo = nmm_read_module_json(stagingPath);
    lock = jsondecode([stagingPath, 'module-lock.json'], '-file');
    validateArchiveLock(lock, moduleInfo);
    validateLockChecksums(stagingPath, lock);
    report = verificationReport(target, lock);
    cleanupDirectory(stagingPath);
  catch
    e = lasterror();
    cleanupDirectory(stagingPath);
    error(e);
  end
end
%=============================================================================
function report = verifySourceModule(module_path)
  module_path = ensureTrailingSlash(module_path);
  check = nmm_lock(module_path, '-check');
  if ~check.ok
    nmm_error('ModuleLockOutOfDate', 'module-lock.json is not up to date.');
  end
  report = struct();
  report.ok = true;
  report.package = module_path;
  report.module = check.module;
  report.version = check.version;
  report.platform = '';
  report.package_type = 'source';
  report.has_sha256 = false;
  report.lockfile = check.lockfile;
  report.up_to_date = true;
  report.differences = {};
end
%=============================================================================
function report = verificationReport(package_file, lock)
  report = struct();
  report.ok = true;
  report.package = package_file;
  report.module = lock.module;
  report.version = lock.version;
  report.platform = lock.platform;
  report.package_type = lock.package_type;
  report.has_sha256 = isfile([package_file, '.sha256']);
end
%=============================================================================
function verifyPackageChecksum(filename)
  checksumFile = [filename, '.sha256'];
  if ~isfile(checksumFile)
    return
  end
  expected = strtrim(fileread(checksumFile));
  separator = strfind(expected, ' ');
  if ~isempty(separator)
    expected = expected(1:separator(1) - 1);
  end
  actual = sha256(filename, '-file');
  if ~strcmpi(expected, actual)
    nmm_error('PackageChecksumMismatch', 'Package checksum does not match.');
  end
end
%=============================================================================
function validateBuiltPackageStructure(module_path)
  if ~isfile([module_path, 'loader.m'])
    nmm_error('LoaderMissing', 'loader.m is missing.');
  end
  if ~isfile([module_path, 'module-lock.json'])
    nmm_error('ModuleLockMissing', 'module-lock.json is missing.');
  end
end
%=============================================================================
function validateArchiveLock(lock, moduleInfo)
  if ~isfield(lock, 'module') || ~strcmp(lock.module, moduleInfo.module)
    nmm_error('ModuleLockModuleMismatch', 'module-lock.json module name mismatch.');
  end
  if ~isfield(lock, 'version') || ~strcmp(lock.version, moduleInfo.version)
    nmm_error('ModuleLockVersionMismatch', 'module-lock.json module version mismatch.');
  end
  if ~isfield(lock, 'builtin') || lock.builtin ~= moduleInfo.builtin
    nmm_error('ModuleLockBuiltinMismatch', 'module-lock.json builtin mismatch.');
  end
  if ~isfield(lock, 'package_type') || ~strcmp(lock.package_type, packageType(moduleInfo))
    nmm_error('ModuleLockPackageTypeMismatch', 'module-lock.json package type mismatch.');
  end
  if ~isfield(lock, 'nelson') || ~isstruct(lock.nelson)
    nmm_error('ModuleLockNelsonMissing', 'module-lock.json field is missing: nelson');
  end
  if ~isfield(lock.nelson, 'version') || ~isfield(lock.nelson, 'arch') || ~isfield(lock.nelson, 'abi')
    nmm_error('ModuleLockNelsonMissing', 'module-lock.json field is missing: nelson');
  end
  if lock.builtin
    if ~strcmp(lock.nelson.arch, computer('arch'))
      nmm_error('NelsonArchitectureNotSupported', 'Nelson architecture not supported.');
    end
    if ~strcmp(lock.nelson.abi, nelsonAbiTag())
      nmm_error('NelsonAbiNotSupported', 'Nelson ABI not supported: %s', lock.nelson.abi);
    end
  end
end
%=============================================================================
function type = packageType(info)
  if info.builtin
    type = 'binary';
  else
    type = 'source';
  end
end
%=============================================================================
function validateLockChecksums(modulePath, lock)
  if ~isfield(lock, 'checksums') || ~isstruct(lock.checksums)
    nmm_error('ModuleLockChecksumsMissing', 'module-lock.json field is missing: checksums');
  end
  checksums = lock.checksums;
  for field = {'module_json', 'loader'}
    if ~isfield(checksums, field{1})
      nmm_error('ModuleLockChecksumMissing', ['module-lock.json checksum is missing: ', field{1}]);
    end
  end
  for field = fieldnames(checksums)'
    name = field{1};
    filename = checksumFilename(modulePath, name);
    if isempty(filename)
      nmm_error('ModuleLockChecksumUnknownFile', ['module-lock.json checksum has unknown file: ', name]);
    end
    if ~isfile(filename)
      nmm_error('ModuleLockChecksumFileMissing', ['module-lock.json checksum file is missing: ', name]);
    end
    if ~strcmpi(checksums.(name), sha256(filename, '-file'))
      nmm_error('ModuleLockChecksumMismatch', ['module-lock.json checksum mismatch: ', name]);
    end
  end
end
%=============================================================================
function filename = checksumFilename(modulePath, name)
  root = ensureTrailingSlash(modulePath);
  switch name
    case 'module_json'
      filename = [root, 'module.json'];
    case 'loader'
      filename = [root, 'loader.m'];
    case 'builder'
      filename = [root, 'builder.m'];
    case 'etc_startup'
      filename = [root, 'etc/startup.m'];
    case 'etc_finish'
      filename = [root, 'etc/finish.m'];
    otherwise
      filename = '';
  end
end
%=============================================================================
function tag = nelsonAbiTag()
  compiler = version('-compiler');
  tag = [computer('arch'), '-', compiler{3}];
end
%=============================================================================
function path = newTemporaryDirectory()
  root = [usermodulesdir(), '.nmm-tmp/'];
  if ~isdir(root)
    mkdir(root);
  end
  path = [root, createGUID(), '/'];
  mkdir(path);
end
%=============================================================================
function cleanupDirectory(path)
  if ischar(path) && isdir(path)
    rmdir(path, 's');
  end
end
%=============================================================================
function path = ensureTrailingSlash(path)
  if ~endsWith(path, '/')
    path = [path, '/'];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function options = nmm_web_options()
  % weboptions used to download a registry index or a package archive. Follow
  % HTTP redirects (a GitHub release URL 302-redirects to
  % objects.githubusercontent.com, so without this the download saves an empty
  % body and the checksum fails) and allow enough time for a several-megabyte
  % archive over a slow link.
  options = weboptions('FollowLocation', true, 'Timeout', 120);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function report = nmm_why(varargin)
  [args, jsonOutput] = nmm_json_option(varargin);
  if length(args) == 1
    report = whyInstalled(args{1});
  elseif length(args) == 2
    report = whyPlan(args{1}, args{2});
  else
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  report = nmm_json_output(report, jsonOutput);
end
%=============================================================================
function report = whyInstalled(packageName)
  if ~ischar(packageName)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 2);
  end
  modules = nmm_list();
  requiredBy = {};
  chains = {};
  installed = isfield(modules, packageName);
  for moduleName = fieldnames(modules)'
    requester = moduleName{1};
    versions = installedVersions(modules.(requester));
    for k = 1:length(versions)
      dependencies = installedDependencies(versions(k));
      if isfield(dependencies, packageName)
        requiredBy = appendUnique(requiredBy, requester);
        chains = appendUnique(chains, [requester, ' -> ', packageName]);
      end
    end
  end
  report = struct();
  report.package = packageName;
  report.installed = installed;
  report.required_by = requiredBy;
  report.direct = installed && isempty(requiredBy);
  report.chains = chains;
end
%=============================================================================
function report = whyPlan(planOrReport, packageName)
  if ~isstruct(planOrReport)
    nmm_error('StructExpected', '#%d argument: struct expected.', 2);
  end
  if ~ischar(packageName)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 3);
  end
  plan = normalizedPlan(planOrReport);
  requiredBy = {};
  chains = {};
  inPlan = false;
  root = '';
  if isfield(planOrReport, 'package')
    root = planOrReport.package;
  elseif ~isempty(plan)
    root = plan(1).package;
  end
  for k = 1:length(plan)
    if strcmp(plan(k).package, packageName)
      inPlan = true;
    end
    dependencies = planDependencies(plan(k));
    if isfield(dependencies, packageName)
      requiredBy = appendUnique(requiredBy, plan(k).package);
      chains = appendUnique(chains, [plan(k).package, ' -> ', packageName]);
    end
  end
  if inPlan && isempty(chains) && ~isempty(root) && strcmp(root, packageName)
    chains = {packageName};
  end
  report = struct();
  report.package = packageName;
  report.installed = nmm_is_installed(packageName);
  report.in_plan = inPlan;
  report.required_by = requiredBy;
  report.direct = inPlan && isempty(requiredBy);
  report.chains = chains;
end
%=============================================================================
function plan = normalizedPlan(planOrReport)
  if isfield(planOrReport, 'install_plan')
    plan = planOrReport.install_plan;
  else
    plan = planOrReport;
  end
  if isempty(plan)
    plan = struct([]);
  end
end
%=============================================================================
function dependencies = planDependencies(item)
  dependencies = struct();
  if isfield(item, 'dependencies') && isstruct(item.dependencies)
    dependencies = item.dependencies;
  end
end
%=============================================================================
function dependencies = installedDependencies(versionData)
  dependencies = struct();
  if ~isfield(versionData, 'path')
    return
  end
  lockFile = [versionData.path, 'module-lock.json'];
  if ~isfile(lockFile)
    return
  end
  try
    lock = jsondecode(lockFile, '-file');
    if isfield(lock, 'dependencies') && isstruct(lock.dependencies)
      dependencies = lock.dependencies;
    end
  catch
  end
end
%=============================================================================
function versions = installedVersions(moduleData)
  versions = struct([]);
  if isfield(moduleData, 'versions') && ~isempty(moduleData.versions)
    versions = moduleData.versions;
    return
  end
  if isfield(moduleData, 'path') && isfield(moduleData, 'version')
    versions = moduleData;
    if isfield(versions, 'versions')
      versions = rmfield(versions, 'versions');
    end
    if isfield(versions, 'pinned_version')
      versions = rmfield(versions, 'pinned_version');
    end
  end
end
%=============================================================================
function values = appendUnique(values, value)
  if ~any(strcmp(values, value))
    values{end + 1} = value;
  end
end
