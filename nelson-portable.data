%=============================================================================
function [trans, emis, nstates, nsymbols] = __hmm_check_model(trans, emis)
  trans = checkMatrix(trans, sprintf('%s must be a finite nonnegative numeric matrix.', 'TRANS'));
  emis = checkMatrix(emis, sprintf('%s must be a finite nonnegative numeric matrix.', 'EMIS'));
  if size(trans, 1) ~= size(trans, 2)
    error('Nelson:statistics:TRANSSquareMatrix', '%s must be a square matrix.', 'TRANS');
  end
  if size(emis, 1) ~= size(trans, 1)
    error('Nelson:statistics:TRANSEMISSameNumberStates', 'TRANS and EMIS must have the same number of states.');
  end
  trans = normalizeRows(trans, sprintf('%s must have positive sum.', 'Each TRANS row'));
  emis = normalizeRows(emis, sprintf('%s must have positive sum.', 'Each EMIS row'));
  nstates = size(trans, 1);
  nsymbols = size(emis, 2);
end
%=============================================================================
function A = checkMatrix(A, message)
  if ~(isnumeric(A) && isreal(A) && ~issparse(A) && ndims(A) == 2)
    error('Nelson:statistics:realNumericMatrix', message);
  end
  A = double(A);
  if isempty(A) || any(~isfinite(A(:))) || any(A(:) < 0)
    error('Nelson:statistics:invalidValue', message);
  end
end
%=============================================================================
function A = normalizeRows(A, message)
  rowsum = sum(A, 2);
  if any(rowsum <= 0)
    error('Nelson:statistics:invalidValue', message);
  end
  A = A ./ repmat(rowsum, 1, size(A, 2));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function seq = __hmm_check_sequence(seq, upperBound, name)
  if ~(isnumeric(seq) && isreal(seq) && isvector(seq) && ~isempty(seq))
    error('Nelson:statistics:mustBeNonemptyVector', '%s must be a nonempty numeric vector.', name);
  end
  seq = double(seq(:)');
  if any(~isfinite(seq)) || any(floor(seq) ~= seq) || any(seq < 1) || any(seq > upperBound)
    error('Nelson:statistics:invalidIndex', '%s contains invalid indices.', name);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [gamma, xiSum, logp, alpha, beta, scale] = __hmm_forward_backward(seq, trans, emis)
  nstates = size(trans, 1);
  len = length(seq);
  alpha = zeros(len, nstates);
  beta = zeros(len, nstates);
  scale = zeros(len, 1);
  prior = ones(1, nstates) / nstates;
  alpha(1, :) = prior .* emis(:, seq(1))';
  [alpha(1, :), scale(1)] = normalizeRow(alpha(1, :));
  for t = 2:len
    alpha(t, :) = (alpha(t - 1, :) * trans) .* emis(:, seq(t))';
    [alpha(t, :), scale(t)] = normalizeRow(alpha(t, :));
  end
  beta(len, :) = ones(1, nstates);
  for t = len - 1:-1:1
    beta(t, :) = (trans * (emis(:, seq(t + 1)) .* beta(t + 1, :)'))' / scale(t + 1);
  end
  gamma = alpha .* beta;
  gamma = gamma ./ repmat(sum(gamma, 2), 1, nstates);
  xiSum = zeros(nstates, nstates);
  for t = 1:len - 1
    xi = trans .* (alpha(t, :)' * (emis(:, seq(t + 1))' .* beta(t + 1, :)));
    total = sum(xi(:));
    if total > 0
      xiSum = xiSum + xi / total;
    end
  end
  logp = sum(log(scale));
end
%=============================================================================
function [row, scale] = normalizeRow(row)
  scale = sum(row);
  if scale <= 0
    row(:) = 1 / length(row);
    scale = realmin;
  else
    row = row / scale;
  end
end
