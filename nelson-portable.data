%=============================================================================
classdef codeIssues
  properties (SetAccess = private)
    Date
    Release
    Files
    CodeAnalyzerConfiguration
    Issues
    SuppressedIssues
  end

  properties (Hidden, SetAccess = private)
    RawDiagnostics
    IncludeSubfolders
  end

  methods
    function obj = codeIssues(varargin)
      names = {pwd()};
      includeSubfolders = false;
      configFile = '';

      if nargin > 0
        first = varargin{1};
        if isNamesArgument(first)
          names = normalizeNames(first);
          varargin(1) = [];
        end
      end
      if mod(length(varargin), 2) ~= 0
        error('Nelson:codeIssues:invalidArgument', 'Name-value arguments expected.');
      end
      for k = 1:2:length(varargin)
        name = normalizeName(varargin{k});
        value = varargin{k + 1};
        switch lower(name)
          case 'codeanalyzerconfiguration'
            configFile = normalizeName(value);
          case 'includesubfolders'
            includeSubfolders = logical(value);
          otherwise
            error('Nelson:codeIssues:unsupportedArgument', 'Unsupported name-value argument.');
        end
      end

      diagnostics = __code_analyzer__(names, includeSubfolders, configFile, true, true, true, true);
      suppressed = [diagnostics.Suppressed];
      obj.Date = datestr(now());
      obj.Release = version();
      obj.Files = names;
      obj.CodeAnalyzerConfiguration = configFile;
      obj.IncludeSubfolders = includeSubfolders;
      obj.RawDiagnostics = diagnostics;
      obj.Issues = diagnosticsToTable(diagnostics(~suppressed));
      obj.SuppressedIssues = diagnosticsToTable(diagnostics(suppressed));
    end
  end
end
%=============================================================================
function tf = isNamesArgument(value)
  tf = ischar(value) || iscell(value) || isstring(value);
end
%=============================================================================
function names = normalizeNames(value)
  if ischar(value)
    names = {value};
  elseif isstring(value)
    names = cellstr(value);
  elseif iscell(value)
    names = value;
  else
    error('Nelson:types:fileNamesNotText', 'File names must be text.');
  end
end
%=============================================================================
function name = normalizeName(value)
  if isstring(value) && isscalar(value)
    name = char(value);
  elseif ischar(value)
    name = value;
  else
    error('Nelson:types:nameNotText', 'Name must be text.');
  end
end
%=============================================================================
function T = diagnosticsToTable(diagnostics)
  if isempty(diagnostics)
    T = table(cell(0, 1), cell(0, 1), cell(0, 1), cell(0, 1), cell(0, 1), ...
      zeros(0, 1), zeros(0, 1), zeros(0, 1), zeros(0, 1), cell(0, 1), ...
      cell(0, 1), cell(0, 1), cell(0, 1), cell(0, 1), ...
      'VariableNames', {'Location', 'Severity', 'Fixability', 'Description', 'CheckID', ...
      'LineStart', 'LineEnd', 'ColumnStart', 'ColumnEnd', 'FullFilename', 'Category', ...
      'RuleName', 'HelpURI', 'Fingerprint'});
    return
  end
  Location = {diagnostics.Location}';
  Severity = {diagnostics.Severity}';
  Fixability = {diagnostics.Fixability}';
  Description = {diagnostics.Description}';
  CheckID = {diagnostics.CheckID}';
  LineStart = [diagnostics.LineStart]';
  LineEnd = [diagnostics.LineEnd]';
  ColumnStart = [diagnostics.ColumnStart]';
  ColumnEnd = [diagnostics.ColumnEnd]';
  FullFilename = {diagnostics.FullFilename}';
  Category = {diagnostics.Category}';
  RuleName = {diagnostics.RuleName}';
  HelpURI = {diagnostics.HelpURI}';
  Fingerprint = {diagnostics.Fingerprint}';
  T = table(Location, Severity, Fixability, Description, CheckID, LineStart, LineEnd, ...
    ColumnStart, ColumnEnd, FullFilename, Category, RuleName, HelpURI, Fingerprint, ...
    'VariableNames', {'Location', 'Severity', 'Fixability', 'Description', 'CheckID', ...
    'LineStart', 'LineEnd', 'ColumnStart', 'ColumnEnd', 'FullFilename', 'Category', ...
    'RuleName', 'HelpURI', 'Fingerprint'});
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function export(obj, filename)
  if isstring(filename) && isscalar(filename)
    filename = char(filename);
  end
  if ~ischar(filename)
    error('Nelson:types:filenameNotText', 'Filename must be a character vector or string scalar.');
  end
  [~, ~, ext] = fileparts(filename);
  switch lower(ext)
    case '.json'
      filewrite(filename, jsonprettyprint(jsonencode(obj.RawDiagnostics)));
    case '.csv'
      writetable(obj.Issues, filename);
    otherwise
      filewrite(filename, issuesToText(obj.RawDiagnostics));
  end
end
%=============================================================================
function txt = issuesToText(diagnostics)
  lines = strings(numel(diagnostics), 1);
  for k = 1:numel(diagnostics)
    lines(k) = sprintf('%s:%d:%d: %s %s %s', diagnostics(k).FullFilename, ...
      diagnostics(k).LineStart, diagnostics(k).ColumnStart, diagnostics(k).Severity, ...
      diagnostics(k).CheckID, diagnostics(k).Description);
  end
  txt = join(lines, newline());
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function obj = fix(obj)
  diagnostics = obj.RawDiagnostics;
  if isempty(diagnostics)
    return
  end
  suppressed = reshape([diagnostics.Suppressed], size(diagnostics));
  fixable = false(size(diagnostics));
  if isfield(diagnostics, 'Fixes')
    for k = 1:numel(diagnostics)
      fixable(k) = hasSafeFix(diagnostics(k));
    end
    fixable = fixable & ~suppressed;
  end
  files = unique({diagnostics(fixable).FullFilename});
  for k = 1:length(files)
    sameFile = reshape(strcmp({diagnostics.FullFilename}, files{k}), size(diagnostics));
    fileDiagnostics = diagnostics(fixable & sameFile);
    if isfield(fileDiagnostics, 'Fixes')
      applyDiagnosticFixes(files{k}, fileDiagnostics);
    else
      fixFile(files{k});
    end
  end
  obj = codeIssues(obj.Files, 'CodeAnalyzerConfiguration', obj.CodeAnalyzerConfiguration, ...
    'IncludeSubfolders', obj.IncludeSubfolders);
end
%=============================================================================
function applyDiagnosticFixes(filename, diagnostics)
  lines = fileread(filename, 'cell');
  text = char(join(string(lines), newline()));
  edits = [];
  for k = 1:numel(diagnostics)
    fixes = diagnostics(k).Fixes;
    if isfield(fixes, 'Safe')
      fixes = fixes([fixes.Safe]);
    end
    for j = 1:numel(fixes)
      edits = [edits, fixes(j)];
    end
  end
  if isempty(edits)
    return
  end
  edits = selectNonConflictingTextEdits(edits, lines);
  if isempty(edits)
    return
  end
  order = sortTextEdits(edits);
  for k = 1:numel(order)
    text = applyTextEdit(text, lines, edits(order(k)));
  end
  lines = splitTextLines(text);
  filewrite(filename, [join(string(lines), newline()), newline()]);
end
%=============================================================================
function tf = hasSafeFix(diagnostic)
  tf = false;
  if ~isfield(diagnostic, 'Fixes') || isempty(diagnostic.Fixes)
    return
  end
  fixes = diagnostic.Fixes;
  if isfield(fixes, 'Safe')
    tf = any([fixes.Safe]);
  else
    tf = true;
  end
end
%=============================================================================
function order = sortTextEdits(edits)
  keys = zeros(1, numel(edits));
  for k = 1:numel(edits)
    keys(k) = edits(k).LineStart * 1000000 + edits(k).ColumnStart;
  end
  [~, ascending] = sort(keys);
  order = fliplr(ascending);
end
%=============================================================================
function edits = selectNonConflictingTextEdits(edits, originalLines)
  starts = zeros(1, numel(edits));
  ends = zeros(1, numel(edits));
  lengths = zeros(1, numel(edits));
  valid = true(1, numel(edits));
  for k = 1:numel(edits)
    starts(k) = textOffset(originalLines, edits(k).LineStart, edits(k).ColumnStart);
    ends(k) = textOffset(originalLines, edits(k).LineEnd, edits(k).ColumnEnd);
    if ends(k) < starts(k)
      valid(k) = false;
      lengths(k) = -1;
    else
      lengths(k) = ends(k) - starts(k);
    end
  end
  candidates = find(valid);
  [~, byLength] = sort(-lengths(candidates));
  keep = false(1, numel(edits));
  for k = 1:numel(byLength)
    index = candidates(byLength(k));
    if ~hasOverlappingEdit(index, keep, starts, ends)
      keep(index) = true;
    end
  end
  edits = edits(keep);
end
%=============================================================================
function tf = hasOverlappingEdit(index, keep, starts, ends)
  tf = false;
  kept = find(keep);
  for k = 1:numel(kept)
    other = kept(k);
    if starts(index) < ends(other) && starts(other) < ends(index)
      tf = true;
      return
    end
  end
end
%=============================================================================
function text = applyTextEdit(text, originalLines, edit)
  startOffset = textOffset(originalLines, edit.LineStart, edit.ColumnStart);
  endOffset = textOffset(originalLines, edit.LineEnd, edit.ColumnEnd);
  if endOffset < startOffset
    return
  end
  prefix = '';
  suffix = '';
  if startOffset > 1
    prefix = text(1:startOffset - 1);
  end
  if endOffset <= length(text)
    suffix = text(endOffset:end);
  end
  replacement = edit.ReplacementText;
  text = [prefix, replacement, suffix];
end
%=============================================================================
function offset = textOffset(lines, lineIndex, columnIndex)
  lineIndex = max(1, lineIndex);
  columnIndex = max(1, columnIndex);
  offset = 1;
  beforeLine = min(lineIndex - 1, length(lines));
  for k = 1:beforeLine
    offset = offset + length(lines{k}) + 1;
  end
  if lineIndex <= length(lines)
    offset = offset + min(columnIndex - 1, length(lines{lineIndex}));
  end
end
%=============================================================================
function lines = splitTextLines(text)
  if isempty(text)
    lines = {};
    return
  end
  lines = regexp(text, newline(), 'split');
  if ~isempty(lines) && isempty(lines{end})
    lines(end) = [];
  end
end
%=============================================================================
function fixFile(filename)
  lines = fileread(filename, 'cell');
  for k = 1:length(lines)
    lines{k} = stripRight(lines{k});
  end
  filewrite(filename, [join(string(lines), newline()), newline()]);
end
%=============================================================================
function line = stripRight(line)
  while ~isempty(line) && isspace(line(end))
    line(end) = [];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function disp(varargin)
  onCleanupObj = varargin{1};
  currentFormat = format();
  if ~isscalar(onCleanupObj)
    h = size(onCleanupObj, 1);
    w = size(onCleanupObj, 2);
    header = sprintf('  %d×%d %s array with properties:', h, w, 'onCleanup');
    disp(header);
    if strcmp(currentFormat.LineSpacing, 'loose')
      disp(' ');
    end
    disp('   task');
    if strcmp(currentFormat.LineSpacing, 'loose')
      disp(' ');
    end
    return;
  end
  msg = ['  ', sprintf(_('%s with properties:'), 'onCleanup')];
  disp(msg);
  if strcmp(currentFormat.LineSpacing, 'loose')
    disp(' ');
  end
  task = onCleanupObj.task;
  funAsStr = func2str(task);
  if ~startsWith(funAsStr, '@')
    funAsStr = ['@' funAsStr];
  end
  disp(['    task: ', funAsStr]);
  if strcmp(currentFormat.LineSpacing, 'loose')
    disp(' ');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function display(varargin)
  onCleanupObj = varargin{1};
  if nargin == 2
    name = varargin{2};
  else
    name = inputname(1);
  end
  currentFormat = format();
  if ~isempty(name)
    if strcmp(currentFormat.LineSpacing, 'loose')
      disp(' ');
    end
    disp([name, ' ='])
  end
  if strcmp(currentFormat.LineSpacing, 'loose')
    disp(' ');
  end
  disp(onCleanupObj);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
% SPDX-License-Identifier: LGPL-3.0-or-later
%=============================================================================
function shown = __nelsonc_application_help__(manifest, inputs)
  shown = false;
  if ~isfield(manifest, 'helpText')
    return;
  end
  text = manifest.helpText;
  if ~ischar(text) || (~isrow(text) && ~isempty(text)) ...
    || numel(text) > 1048576 || any(text == char(0))
    error('Nelson:nelsonc:manifest:invalidApplicationHelpText', 'Invalid application help text.');
  end
  shown = numel(inputs) == 1 && any(strcmp(inputs{1}, {'-?', '/?', '--help'}));
  if shown
    fprintf('%s', text);
  end
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function __nelsonc_run__()
  arguments = argv();
  executable = arguments{1};
  originalDirectory = pwd();
  originalPath = path();
  directory = getenv('NELSONC_EXTRACTION_DIRECTORY');
  if isempty(directory)
    error('Nelson:nelsonc:environment', 'Missing native application extraction directory.');
  end
  [currentDirectorySearch, userPath] = __nelsonc_environment__(false, '');
  cleanup = onCleanup(@() restore_environment(originalDirectory, originalPath, currentDirectorySearch, userPath));
  __application_archive__('extract', executable, directory);
  encodedManifest = fileread(fullfile(directory, 'application.json'));
  __bytecode_artifact__('verify', encodedManifest);
  manifest = jsondecode(encodedManifest);
  if ~isstruct(manifest) || ~isscalar(manifest) || ~isfield(manifest, 'format') ...
    || (~isequal(manifest.format, 1) && ~isequal(manifest.format, 2))
    error('Nelson:nelsonc:manifest:incompatibleApplicationManifest', 'Incompatible application manifest.');
  end
  numericInputs = false;
  if isequal(manifest.format, 2)
    if ~isfield(manifest, 'treatInputsAsNumeric') ...
      || ~islogical(manifest.treatInputsAsNumeric) || ~isscalar(manifest.treatInputsAsNumeric)
      error('Nelson:nelsonc:manifest:invalidApplicationInputConversion', 'Invalid application input conversion.');
    end
    numericInputs = manifest.treatInputsAsNumeric;
  elseif isfield(manifest, 'treatInputsAsNumeric')
    error('Nelson:nelsonc:manifest:inputConversionRequiresManifestVersion2', 'Input conversion requires application manifest version 2.');
  end
  required = {'entry', 'entryKind', 'entryName', 'gui', 'paths'};
  for k = 1:numel(required)
    if ~isfield(manifest, required{k})
      error('Nelson:nelsonc:manifest:incompleteApplicationManifest', 'Incomplete application manifest.');
    end
  end
  validate_relative(manifest.entry);
  if ~iscell(manifest.paths) || isempty(manifest.paths) || ~islogical(manifest.gui) || ~isscalar(manifest.gui)
    error('Nelson:nelsonc:manifest:invalidApplicationManifest', 'Invalid application manifest.');
  end
  for k = 1:numel(manifest.paths)
    validate_relative(manifest.paths{k});
  end
  if ~any(strcmp(manifest.entryKind, {'script', 'function'})) || ~ischar(manifest.entryName) ...
    || isempty(regexp(manifest.entryName, '^[A-Za-z_][A-Za-z_0-9]*(\.[A-Za-z_][A-Za-z_0-9]*)*$', 'once'))
    error('Nelson:nelsonc:manifest:invalidApplicationEntry', 'Invalid application entry.');
  end
  for k = numel(manifest.paths):-1:1
    addpath(fullfile(directory, manifest.paths{k}));
  end
  entry = fullfile(directory, manifest.entry);
  if isfield(manifest, 'nativePaths') && ~isempty(manifest.nativePaths)
    if ~iscell(manifest.nativePaths) || numel(manifest.nativePaths) > 256
      error('Nelson:nelsonc:manifest:invalidNativeApplicationPaths', 'Invalid native application paths.');
    end
    nativePaths = {};
    for k = 1:numel(manifest.nativePaths)
      validate_relative(manifest.nativePaths{k});
      nativePaths{k} = fullfile(directory, manifest.nativePaths{k});
    end
    previousNativePaths = __library_search_paths__(nativePaths);
    nativeCleanup = onCleanup(@() __library_search_paths__(previousNativePaths));
  end
  cd(getenv('NELSONC_INVOKING_DIRECTORY'));
  previousDeployment = __nelsonc_environment__('deployment', directory);
  deploymentCleanup = onCleanup(@() __nelsonc_environment__('deployment', previousDeployment));
  inputs = argv('user');
  if __nelsonc_application_help__(manifest, inputs)
    return;
  end
  if strcmp(manifest.entryKind, 'script')
    execute_script(entry);
  else
    if numericInputs
      for k = 1:numel(inputs)
        inputs{k} = builtin('str2double', inputs{k});
      end
    end
    feval(manifest.entryName, inputs{:});
  end
  if manifest.gui
    __nelsonc_wait_for_windows__();
  end
  clear deploymentCleanup;
  clear nativeCleanup;
  clear cleanup;
end

function execute_script(entry)
  run(entry, false);
end

function validate_relative(name)
  if ~ischar(name) || ~isrow(name) || ~startsWith(name, 'roots/') ...
    || any(name == '\') || any(name == ':') || any(name == char(0))
    error('Nelson:nelsonc:manifest', 'Invalid application path.');
  end
  components = strsplit(name, '/');
  if any(strcmp(components, '..')) || any(strcmp(components, '.')) || any(cellfun('isempty', components))
    error('Nelson:nelsonc:manifest', 'Invalid application path.');
  end
end

function restore_environment(originalDirectory, searchPath, currentDirectorySearch, userPath)
  cd(originalDirectory);
  path(searchPath);
  __nelsonc_environment__(currentDirectorySearch, userPath);
end
