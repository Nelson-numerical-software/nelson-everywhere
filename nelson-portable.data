function P = prctile(A, varargin)
  % Percentiles of the serial-day values, NaT being removed as NaN.
  values = prctile(datenum(A), varargin{:});
  P = datetime.fromSerial(values, A.FormatValue, A.TimeZoneValue);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [serial, millis] = datetimeAddSeconds(obj, secondsValue, direction)
  % Values of a datetime moved by a number of seconds (direction is +1 to add,
  % -1 to subtract). A zoned datetime moves on the UTC time line, so adding
  % hours(24) across a DST change keeps 24 elapsed hours. millis is empty when
  % the source has no precise time of day.
  zone = obj.TimeZoneValue;
  serial = datetime.rawSerial(obj);
  millis = datetime.storedMillis(obj);
  if ~isempty(zone)
    [serial, millis] = datetimeConvertZone(serial, millis, zone, '');
  end
  serial = __datetime_serial_add_seconds__(serial, secondsValue, direction);
  if ~isempty(millis)
    millis = mod(millis + direction .* secondsValue .* 1000, 86400000);
  end
  if ~isempty(zone)
    [serial, millis] = datetimeConvertZone(serial, millis, '', zone);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function b = datetimeAlignOperand(a, b)
  % Second operand of a two-datetime operation expressed in the time zone of
  % the first one, so their serial values compare as instants.
  if isa(a, 'datetime') && isa(b, 'datetime')
    b = datetimeAlignZone(b, a.TimeZoneValue);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function b = datetimeAlignZone(b, zone, isConcatenation)
  % The datetime b expressed in the time zone of the datetime it is combined
  % with (same instants). A datetime with a time zone never combines with one
  % without.
  bZone = b.TimeZoneValue;
  if xor(isempty(zone), isempty(bZone))
    if nargin > 2 && isConcatenation
      error('Nelson:datetime:cat:IncompatibleTZ', 'Unable to concatenate a datetime array that has a time zone with one that does not have a time zone.');
    end
    error('Nelson:datetime:IncompatibleTZ', 'Cannot combine or compare a datetime array with a time zone with one without a time zone.');
  end
  if strcmp(zone, bZone)
    return
  end
  [serial, millis] = datetimeConvertZone(datetime.rawSerial(b), datetime.storedMillis(b), bZone, zone);
  b = datetime.fromSerial(serial, b.FormatValue, zone, millis);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function v = datetimeConcatOperand(v)
  % numbers are not dates: only datetimes, date text and [] concatenate
  if isa(v, 'datetime')
    return
  end
  if (isnumeric(v) || islogical(v)) && ~isempty(v)
    error('Nelson:time:concatenateDatetimeOperands', '%s', 'All inputs must be datetimes or date/time character vectors or date/time strings.');
  end
  v = datetime(v);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [serial, millis] = datetimeConvertZone(serial, millis, fromZone, toZone)
  % Wall-clock serial dates read in fromZone, rewritten as the wall clock of
  % the same instants in toZone ('' stands for UTC here). millis, the precise
  % time of day in milliseconds, follows (it may be empty). Converting a zone
  % to itself moves a time skipped by a DST gap after the gap.
  if strcmp(fromZone, toZone) && isFixedZone(fromZone)
    return
  end
  dataPath = [modulepath('time'), '/resources/tzdata'];
  offsetFrom = zeros(size(serial));
  if ~isempty(fromZone)
    offsetFrom = reshape(timezoneoffset(serial, fromZone, dataPath), size(serial));
  end
  offsetTo = zeros(size(serial));
  if ~isempty(toZone)
    utc = serial - offsetFrom ./ 86400;
    offsetTo = reshape(timezoneoffset(utc, toZone, dataPath, 'utc'), size(serial));
  end
  delta = offsetTo - offsetFrom;
  if ~any(delta(:))
    return
  end
  serial = __datetime_serial_add_seconds__(serial, delta, 1);
  if ~isempty(millis)
    millis = mod(millis + delta .* 1000, 86400000);
  end
end
%=============================================================================
function tf = isFixedZone(zone)
  tf = isempty(zone) || strcmp(zone, 'UTC') || strcmp(zone, 'UTCLeapSeconds') ...
    || any(zone(1) == '+-');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function value = datetimeDimensionValue(serialValue, query, varargin)
  switch query
    case 'numel'
      value = numel(serialValue, varargin{:});
    case 'length'
      value = length(serialValue);
    case 'isempty'
      value = isempty(serialValue);
    case 'ndims'
      value = ndims(serialValue);
    case 'isrow'
      value = isrow(serialValue);
    case 'iscolumn'
      value = iscolumn(serialValue);
    case 'isscalar'
      value = isscalar(serialValue);
    case 'isvector'
      value = isvector(serialValue);
    case 'end'
      shape = size(serialValue);
      index = varargin{1};
      count = varargin{2};
      if count == 1
        value = numel(serialValue);
      else
        value = shape(index);
      end
    otherwise
      error('Nelson:time:unknownDatetimeDimensionQuery', 'Unknown %s.', 'datetime dimension query');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function out = datetimeDisplayText(obj)
  % Element texts for disp and display: an N-D array resolves the 'default'
  % format page by page (a page without time of day shows dates only),
  % while string, char and cellstr use one format for the whole array.
  serial = datenum(obj);
  out = strings(size(serial));
  if isempty(serial)
    return
  end
  pages = reshape(serial, size(serial, 1), size(serial, 2), []);
  pageSize = size(serial, 1) * size(serial, 2);
  for page = 1:size(pages, 3)
    pageSerial = pages(:, :, page);
    fmt = datetime.resolveDisplayFormat(obj.FormatValue, pageSerial);
    for k = 1:pageSize
      out((page - 1) * pageSize + k) = datetime.formatOne(pageSerial(k), fmt);
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function out = datetimeFormatText(obj, fmt)
  % Display text of each element; not-a-time stays the text 'NaT' here,
  % string() turns it into <missing>.
  serial = datenum(obj);
  if nargin < 2
    fmt = datetime.resolveDisplayFormat(obj.FormatValue, serial);
  else
    fmt = char(fmt);
  end
  out = strings(size(serial));
  for k = 1:numel(serial)
    out(k) = datetime.formatOne(serial(k), fmt);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function serial = datetimeNow(zone)
  % Current wall clock, in the given time zone when there is one.
  serial = now();
  if ~isempty(zone)
    localZone = timezonename('local', [modulepath('time'), '/resources/tzdata']);
    serial = datetimeConvertZone(serial, [], localZone, zone);
  end
end
