function moduleName = report_htmlCaseModule(testCase)
  moduleName = report_htmlModuleFromField(testCase);
  if isempty(moduleName)
    moduleName = report_htmlModuleFromClassname(testCase);
  end
  if isempty(moduleName)
    moduleName = report_htmlModuleFromCaseFilename(testCase);
  end
  if isempty(moduleName)
    moduleName = report_htmlModuleFromDiagnostics(testCase);
  end
end
%=============================================================================
function moduleName = report_htmlModuleFromField(testCase)
  moduleName = '';
  if isfield(testCase, 'module')
    moduleName = testCase.module;
  end
end
%=============================================================================
function moduleName = report_htmlModuleFromClassname(testCase)
  moduleName = '';
  if ~isfield(testCase, 'classname')
    return
  end
  parts = strsplit(testCase.classname, '.');
  if length(parts) >= 2
    moduleName = parts{end};
  end
end
%=============================================================================
function moduleName = report_htmlModuleFromCaseFilename(testCase)
  moduleName = '';
  if isfield(testCase, 'filename')
    moduleName = report_htmlModuleFromFilename(testCase.filename);
  end
end
%=============================================================================
function moduleName = report_htmlModuleFromDiagnostics(testCase)
  moduleName = '';
  if ~isfield(testCase, 'diagnostics')
    return
  end
  diagnostics = testCase.diagnostics;
  if isfield(diagnostics, 'metadata')
    moduleName = report_htmlModuleFromFilename(diagnostics.metadata);
  end
end
%=============================================================================
function moduleName = report_htmlModuleFromFilename(filename)
  moduleName = '';
  normalized = replace(filename, '\', '/');
  marker = '/modules/';
  markerIndex = strfind(normalized, marker);
  if isempty(markerIndex)
    return
  end
  moduleBegin = markerIndex(1) + length(marker);
  remaining = normalized(moduleBegin:end);
  separatorIndex = strfind(remaining, '/');
  if isempty(separatorIndex)
    return
  end
  moduleName = remaining(1:separatorIndex(1) - 1);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function lines = report_htmlCaseRows(cases)
  lines = cell(0, 1);
  previousModule = '';
  for k = 1:length(cases)
    outcome = report_caseOutcome(cases(k));
    moduleName = report_htmlModuleNameOrFiles(cases(k));
    kind = report_htmlCaseKind(cases(k));
    duration = report_caseDuration(cases(k));
    className = report_htmlStatusClass(outcome);
    text = lower([report_caseName(cases(k)), ' ', report_htmlCaseModule(cases(k)), ...
      ' ', kind, ' ', report_htmlCaseTags(cases(k))]);
    if ~strcmp(previousModule, moduleName)
      lines{end + 1} = report_htmlModuleRow(moduleName);
      previousModule = moduleName;
    end
    expanded = report_htmlDetailsExpanded(outcome);
    lines{end + 1} = report_htmlCaseRowStart(cases(k), k, className, outcome, text);
    lines{end + 1} = report_htmlCaseIndexCell(k, expanded);
    lines{end + 1} = report_htmlOutcomeCell(outcome, className, kind, duration);
    lines{end + 1} = ['<td>', report_htmlEscape(moduleName), '</td>'];
    lines{end + 1} = ['<td>', report_htmlEscape(report_caseName(cases(k))), '</td>'];
    lines{end + 1} = ['<td>', report_htmlEscape(kind), '</td>'];
    lines{end + 1} = ['<td class="num">', report_durationText(duration), '</td>'];
    lines{end + 1} = ['<td>', report_htmlEscape(report_htmlCaseTags(cases(k))), '</td></tr>'];
    details = report_htmlDetails(cases(k), k, expanded);
    lines = [lines(:); details(:)];
  end
  lines = lines(:);
end
%=============================================================================
function moduleName = report_htmlModuleNameOrFiles(testCase)
  moduleName = report_htmlCaseModule(testCase);
  if isempty(moduleName)
    moduleName = 'files';
  end
end
%=============================================================================
function line = report_htmlModuleRow(moduleName)
  line = ['<tr class="module-row" data-module="', report_htmlEscape(moduleName), ...
    '"><td colspan="7">', report_htmlEscape(moduleName), '</td></tr>'];
end
%=============================================================================
function line = report_htmlCaseRowStart(testCase, index, className, outcome, text)
  line = ['<tr class="case-row ', className, '" data-index="', int2str(index), ...
    '" data-outcome="', report_htmlEscape(outcome), '" data-module="', ...
    report_htmlEscape(report_htmlModuleNameOrFiles(testCase)), '" data-name="', ...
    report_htmlEscape(report_caseName(testCase)), '" data-kind="', ...
    report_htmlEscape(report_htmlCaseKind(testCase)), '" data-duration="', ...
    report_durationText(report_caseDuration(testCase)), '" data-text="', ...
    report_htmlEscape(text), '">'];
end
%=============================================================================
function line = report_htmlCaseIndexCell(index, expanded)
  expandedText = 'false';
  symbol = '+';
  if expanded
    expandedText = 'true';
    symbol = '-';
  end
  line = ['<td><button class="details-toggle" type="button" aria-expanded="', ...
    expandedText, '" aria-controls="details-', int2str(index), ...
    '" data-details-id="details-', int2str(index), '">', symbol, ...
    '</button><span class="case-index">', int2str(index), '</span></td>'];
end
%=============================================================================
function line = report_htmlOutcomeCell(outcome, className, kind, duration)
  label = outcome;
  if strcmp(kind, 'bench') || strcmp(outcome, 'bench')
    label = ['bench ', report_durationText(duration), ' s'];
  end
  line = ['<td><span class="badge ', className, '">', ...
    report_htmlEscape(label), '</span></td>'];
end
%=============================================================================
function expanded = report_htmlDetailsExpanded(outcome)
  expanded = strcmp(outcome, 'failed') || strcmp(outcome, 'timeout') || strcmp(outcome, 'error');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function tags = report_htmlCaseTags(testCase)
  tags = '';
  if isfield(testCase, 'tags') && ~isempty(testCase.tags)
    if iscell(testCase.tags)
      tags = strjoin(testCase.tags, ', ');
    else
      tags = char(testCase.tags);
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function cases = report_htmlCases(results)
  cases = report_resultCases(results);
  rawCases = report_htmlRawCases(results);
  count = min(length(cases), length(rawCases));
  for k = 1:count
    cases(k) = report_htmlEnrichCase(cases(k), rawCases(k));
  end
end
%=============================================================================
function testCase = report_htmlEnrichCase(testCase, rawCase)
  testCase = report_htmlEnrichModule(testCase, rawCase);
  testCase = report_htmlEnrichFilename(testCase, rawCase);
  testCase = report_htmlEnrichKind(testCase, rawCase);
end
%=============================================================================
function testCase = report_htmlEnrichModule(testCase, rawCase)
  if ~report_htmlCaseNeedsField(testCase, 'module')
    return
  end
  moduleName = report_htmlCaseModule(rawCase);
  if ~isempty(moduleName)
    testCase.module = moduleName;
  end
end
%=============================================================================
function testCase = report_htmlEnrichFilename(testCase, rawCase)
  if ~report_htmlCaseNeedsField(testCase, 'filename') || ~isfield(rawCase, 'filename')
    return
  end
  testCase.filename = rawCase.filename;
end
%=============================================================================
function testCase = report_htmlEnrichKind(testCase, rawCase)
  if ~report_htmlCaseNeedsField(testCase, 'kind')
    return
  end
  testCase.kind = report_htmlCaseKind(rawCase);
end
%=============================================================================
function need = report_htmlCaseNeedsField(testCase, fieldName)
  need = ~isfield(testCase, fieldName);
  if ~need
    value = testCase.(fieldName);
    need = isempty(value);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function lines = report_htmlDetails(testCase, index, expanded)
  className = 'details-row hidden';
  if expanded
    className = 'details-row';
  end
  lines = {['<tr class="', className, '" id="details-', int2str(index), '"><td colspan="7">']};
  lines = lines(:);
  lines{end + 1} = '<div class="details-grid">';
  lines = report_htmlAppendPreBlock(lines, 'Message', report_caseMessage(testCase));
  lines = report_htmlAppendPreBlock(lines, 'Stdout', report_caseStdout(testCase));
  lines = report_htmlAppendPreBlock(lines, 'Stderr', report_caseStderr(testCase));
  lines = report_htmlAppendPreBlock(lines, 'Reproduce', report_htmlReproduceCommand(testCase));
  if isfield(testCase, 'diagnostics')
    lines = report_htmlAppendPreBlock(...
      lines, 'Diagnostics', jsonprettyprint(jsonencode(testCase.diagnostics)));
  end
  if isfield(testCase, 'artifacts') && ~isempty(testCase.artifacts)
    lines = report_htmlAppendPreBlock(...
      lines, 'Artifacts', jsonprettyprint(jsonencode(testCase.artifacts)));
  end
  lines{end + 1} = '</div></td></tr>';
  lines = lines(:);
end
%=============================================================================
function command = report_htmlReproduceCommand(testCase)
  command = '';
  filename = report_htmlCaseFilename(testCase);
  if isempty(filename)
    return
  end
  filename = replace(filename, '''', '''''');
  kind = replace(report_htmlCaseKind(testCase), '''', '''''');
  command = ['nelson.unittest.run(''', filename, ''', ''Kind'', ''', kind, ''');'];
end
%=============================================================================
function filename = report_htmlCaseFilename(testCase)
  filename = '';
  if isfield(testCase, 'filename')
    filename = testCase.filename;
  elseif isfield(testCase, 'file')
    filename = testCase.file;
  elseif isfield(testCase, 'diagnostics') && isfield(testCase.diagnostics, 'metadata')
    filename = testCase.diagnostics.metadata;
  end
end
%=============================================================================
function lines = report_htmlAppendPreBlock(lines, title, value)
  block = report_htmlPreBlock(title, value);
  if ~isempty(block)
    lines = [lines(:); block(:)];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function txt = report_htmlEscape(value)
  if isempty(value)
    txt = '';
    return
  end
  txt = char(value);
  txt = replace(txt, '&', '&amp;');
  txt = replace(txt, '<', '&lt;');
  txt = replace(txt, '>', '&gt;');
  txt = replace(txt, '"', '&quot;');
  txt = replace(txt, char(39), '&#39;');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function lines = report_htmlModuleSummary(cases)
  summary = report_htmlBuildModuleSummary(cases);
  lines = {'<h2>Module summary</h2>'; '<table class="compact-table">'; ...
    ['<thead><tr><th>Module</th><th>Tests</th><th>Passed</th><th>Failed</th>', ...
    '<th>Skipped</th><th>Bench</th><th>Duration</th></tr></thead>']; '<tbody>'};
  for k = 1:length(summary.modules)
    lines{end + 1} = report_htmlModuleSummaryRow(summary, k);
  end
  lines{end + 1} = '</tbody></table>';
  lines = lines(:);
end
%=============================================================================
function summary = report_htmlBuildModuleSummary(cases)
  summary = report_htmlEmptyModuleSummary();
  for k = 1:length(cases)
    moduleName = report_htmlModuleNameOrFiles(cases(k));
    index = report_htmlModuleIndex(summary.modules, moduleName);
    if index == 0
      summary = report_htmlAppendModule(summary, moduleName);
      index = length(summary.modules);
    end
    summary = report_htmlUpdateModule(summary, index, cases(k));
  end
end
%=============================================================================
function summary = report_htmlEmptyModuleSummary()
  summary.modules = cell(0, 1);
  summary.tests = [];
  summary.passed = [];
  summary.failed = [];
  summary.skipped = [];
  summary.bench = [];
  summary.duration = [];
end
%=============================================================================
function moduleName = report_htmlModuleNameOrFiles(testCase)
  moduleName = report_htmlCaseModule(testCase);
  if isempty(moduleName)
    moduleName = 'files';
  end
end
%=============================================================================
function index = report_htmlModuleIndex(modules, moduleName)
  index = 0;
  for k = 1:length(modules)
    if strcmp(modules{k}, moduleName)
      index = k;
      return
    end
  end
end
%=============================================================================
function summary = report_htmlAppendModule(summary, moduleName)
  summary.modules{end + 1} = moduleName;
  summary.tests(end + 1) = 0;
  summary.passed(end + 1) = 0;
  summary.failed(end + 1) = 0;
  summary.skipped(end + 1) = 0;
  summary.bench(end + 1) = 0;
  summary.duration(end + 1) = 0;
end
%=============================================================================
function summary = report_htmlUpdateModule(summary, index, testCase)
  outcome = report_caseOutcome(testCase);
  if strcmp(report_htmlCaseKind(testCase), 'bench') || strcmp(outcome, 'bench')
    summary.bench(index) = summary.bench(index) + 1;
  else
    summary.tests(index) = summary.tests(index) + 1;
  end
  summary.duration(index) = summary.duration(index) + report_caseDuration(testCase);
  summary = report_htmlUpdateOutcome(summary, index, outcome);
end
%=============================================================================
function summary = report_htmlUpdateOutcome(summary, index, outcome)
  if strcmp(outcome, 'passed')
    summary.passed(index) = summary.passed(index) + 1;
  elseif strcmp(outcome, 'failed') || strcmp(outcome, 'timeout') || strcmp(outcome, 'error')
    summary.failed(index) = summary.failed(index) + 1;
  elseif strcmp(outcome, 'skipped')
    summary.skipped(index) = summary.skipped(index) + 1;
  end
end
%=============================================================================
function line = report_htmlModuleSummaryRow(summary, index)
  line = ['<tr><td>', report_htmlEscape(summary.modules{index}), '</td><td>', ...
    int2str(summary.tests(index)), '</td><td>', int2str(summary.passed(index)), ...
    '</td><td>', int2str(summary.failed(index)), '</td><td>', ...
    int2str(summary.skipped(index)), '</td><td>', int2str(summary.bench(index)), ...
    '</td><td class="num">', report_durationText(summary.duration(index)), '</td></tr>'];
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
