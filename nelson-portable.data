% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function d = days(x)
  narginchk(1, 1);
  if isa(x, 'duration')
    d = double(x) ./ 86400;
  else
    d = duration.fromSeconds(double(x) .* 86400, 'd');
  end
end
%=============================================================================
%=============================================================================
