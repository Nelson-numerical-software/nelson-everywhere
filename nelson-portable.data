%=============================================================================
function c = bartlett(varargin)
  % Oppenheim, Alan V., Ronald W. Schafer, and John R. Buck. Discrete-Time Signal Processing. Upper Saddle River, NJ: Prentice Hall, 1999, pp.
  narginchk(1, 1);
  m = varargin{1};
  isPositiveIntegerOrEmpty = isempty(m) || (isscalar(m) && (m == fix(m)) && (m > 0));
  if ~isPositiveIntegerOrEmpty
    error('Nelson:validators:mustBePositiveInteger', '%s must be a positive integer.', 'M');
  end
  if isempty(m)
    c = zeros(0, 1);
  elseif (m ~= 1)
    m = m - 1;
    n = fix(m / 2);
    c = [2 * (0:n) / m, 2 - 2 * (n + 1:m) / m]';
  else
    c = 1;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function c = blackman(varargin)
  % https://www.sciencedirect.com/topics/engineering/blackman-window
  narginchk(1, 2);
  [m, N] = signalParseWindowLengthAndOption(varargin);

  if isempty(m)
    c = zeros(0, 1);
  elseif (m ~= 1)
    m = m - 1;
    k = (0:m)' / N;
    c = 0.42 - (0.5 * cos(2 * pi * k)) + (0.08 * cos(4 * pi * k));
  else
    c = 1;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
