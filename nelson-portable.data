  narginchk(2, 3);
  nargoutchk(0, 1);
  if nargin == 2
    filtered = imhmin(varargin{1}, varargin{2});
    bw = imregionalmin(filtered);
  else
    filtered = imhmin(varargin{1}, varargin{2}, varargin{3});
    bw = imregionalmin(filtered, varargin{3});
