%=============================================================================
function c = hann(varargin)
  % https://www.sciencedirect.com/topics/engineering/hanning-window
  narginchk(1, 2);
  [m, N] = signalParseWindowLengthAndOption(varargin);

  if isempty(m)
    c = zeros(0, 1);
  elseif (m ~= 1)
    m = m - 1;
    c = 0.5 - (0.5 * cos(2 * pi * (0:m)' / N));
  else
    c = 1;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
