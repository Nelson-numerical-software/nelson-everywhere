%=============================================================================
function obj = subsasgn(obj, s, val)
  if numel(s) > 1
    if strcmp(s(1).type, '.')
      currentValue = obj.(s(1).subs);
      currentValue = subsasgn(currentValue, s(2:end), val);
      obj = subsasgn(obj, s(1), currentValue);
      return
    end
    if ~strcmp(s(1).type, '()') && ~strcmp(s(1).type, '{}')
      error('Nelson:dictionary:invalidChainedAssignment', 'Chained assignment is supported only for dictionary entries.');
    end
    if numel(dictionaryIndexKey(s(1))) ~= 1
      error('Nelson:dictionary:invalidChainedAssignment', 'Chained assignment is supported only for dictionary entries.');
    end
    currentValue = subsref(obj, s(1));
    currentValue = subsasgn(currentValue, s(2:end), val);
    obj = subsasgn(obj, s(1), currentValue);
    return
  end

  switch (s(1).type)
    case '.'
      obj.(s(1).subs) = val;
    case '()'
      obj = dictionaryParenAssign(obj, s(1), val);
    case '{}'
      obj = dictionaryBraceAssign(obj, s(1), val);
    otherwise
      error('Nelson:dictionary:invalidIndexing', 'Only ''()'' and ''{}'' indexing is supported for assigning values.');
  end
end
%=============================================================================
function obj = dictionaryParenAssign(obj, s, val)
  if (iscell(s.subs) && (numel(s.subs) > 1))
    error('Nelson:dictionary:TooManyInputsToParenAssign', 'Too many input arguments. To insert multiple entries, utilize an array of keys instead.');
  end
  key = dictionaryIndexKey(s);
  if (~isConfigured(obj))
    key = dictionaryKeyForUnconfiguredDictionary(key);
    if ischar(val)
      val = string(val);
    end
    obj.keyType = class(key);
    obj.valueType = class(val);
  else
    key = dictionaryKeyForType(key, obj.keyType);
    if ischar(val)
      val = string(val);
    end
  end
  if ischar(val)
    nbValues = numel(string(val));
  else
    nbValues = numel(val);
  end
  if (numel(key) ~= nbValues && nbValues ~= 1 && nbValues ~= 0)
    error('Nelson:dictionary:keyValueCountMismatch', 'The number of keys and values must match.');
  end
  for k = 1:numel(key)
    currentKey = dictionaryTypedKey(obj, key(k));
    keyIndex = dictionary.findKeyIndex(obj, currentKey);
    if (isa(val, 'double') && isequal(size(val), [0 0]))
      obj = dictionaryRemoveKeyAt(obj, currentKey, keyIndex);
      continue
    end
    if (numel(val) == 1)
      storedValue = dictionaryTypedValue(obj, val);
    else
      storedValue = dictionaryTypedValue(obj, val(k));
    end
    obj = dictionarySetRawValue(obj, currentKey, keyIndex, storedValue);
  end
end
%=============================================================================
function obj = dictionaryBraceAssign(obj, s, val)
  if (iscell(s.subs) && (numel(s.subs) > 1))
    error('Nelson:dictionary:TooManyInputsToBracketAssign', 'Too many input arguments. To insert multiple entries, utilize an array of keys instead.');
  end
  key = dictionaryIndexKey(s);
  if (~isConfigured(obj))
    key = dictionaryKeyForUnconfiguredDictionary(key);
    obj.keyType = class(key);
    obj.valueType = 'cell';
  else
    key = dictionaryKeyForType(key, obj.keyType);
  end
  if ~strcmp(obj.valueType, 'cell')
    error('Nelson:dictionary:unsupportedBraceIndexing', 'Using curly braces on a dictionary with ''%s'' value type is not supported. The dictionary value type must be ''cell''.', obj.valueType);
  end

  nbValues = 1;
  if numel(key) > 1
    nbValues = numel(val);
  end
  if (numel(key) ~= nbValues && nbValues ~= 1)
    error('Nelson:dictionary:keyValueCountMismatch', 'The number of keys and values must match.');
  end
  for k = 1:numel(key)
    currentKey = dictionaryTypedKey(obj, key(k));
    keyIndex = dictionary.findKeyIndex(obj, currentKey);
    if numel(key) > 1 && nbValues ~= 1
      storedContent = dictionaryElementValue(val, k);
    else
      storedContent = val;
    end
    obj = dictionarySetRawValue(obj, currentKey, keyIndex, {storedContent});
  end
end
%=============================================================================
function key = dictionaryIndexKey(s)
  if (isempty(s.subs))
    error('Nelson:dictionary:noKeySpecified', "No key specified");
  end
  key = s.subs{1};
end
%=============================================================================
function key = dictionaryKeyForUnconfiguredDictionary(key)
  if ischar(key)
    key = string(key);
  end
end
%=============================================================================
function key = dictionaryKeyForType(key, keyType)
  if strcmp(keyType, 'string') && ischar(key)
    key = string(key);
  end
end
%=============================================================================
function currentKey = dictionaryTypedKey(obj, currentKey)
  if (~isa(currentKey, obj.keyType))
    currentKey = convertDataType(obj.keyType, currentKey);
  end
end
%=============================================================================
function storedValue = dictionaryTypedValue(obj, value)
  if isa(value, obj.valueType)
    storedValue = value;
  else
    storedValue = convertDataType(obj.valueType, value);
  end
end
%=============================================================================
function obj = dictionarySetRawValue(obj, currentKey, keyIndex, storedValue)
  h = dec2hex(keyHash(currentKey));
  if keyIndex == 0
    obj.allKeys{end + 1} = currentKey;
    keyIndex = numel(obj.allKeys);
  end
  obj.allValues{keyIndex} = storedValue;
  obj.map.(h) = storedValue;
end
%=============================================================================
function obj = dictionaryRemoveKeyAt(obj, currentKey, keyIndex)
  if keyIndex <= 0
    return
  end
  h = dec2hex(keyHash(currentKey));
  if isfield(obj.map, h)
    obj.map = rmfield(obj.map, h);
  end
  obj.allKeys(keyIndex) = [];
  obj.allValues(keyIndex) = [];
end
%=============================================================================
function value = dictionaryElementValue(values, index)
  if iscell(values)
    value = values{index};
  else
    value = values(index);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = subsref(varargin)
  narginchk(2, 2);
  obj = varargin{1};
  s = varargin{2};

  switch (s(1).type)
    case '.'
      [varargout{1:nargout}] = dictionaryDotReference(obj, s);
    case '()'
      value = dictionaryParenReference(obj, s(1));
      if numel(s) > 1
        value = subsref(value, s(2:end));
      end
      varargout{1} = value;
    case '{}'
      contents = dictionaryBraceReference(obj, s(1));
      if numel(s) > 1
        for k = 1:numel(contents)
          contents{k} = subsref(contents{k}, s(2:end));
        end
      end
      if nargout <= 1
        if isempty(contents)
          varargout{1} = [];
        else
          varargout{1} = contents{1};
        end
      else
        varargout = contents;
      end
    otherwise
      error('Nelson:dictionary:unsupportedIndexing', '''%s'' indexing is not supported.', s(1).type);
  end
end
%=============================================================================
function varargout = dictionaryDotReference(obj, s)
  extra = {};
  if (numel(s) > 1 && strcmp(s(2).type, '()'))
    if (~isempty(s(2).subs))
      extra = s(2).subs;
    end
    s(2) = [];
  end
  switch (s(1).subs)
    case 'map'
      value = obj.map;
    case 'allKeys'
      value = obj.allKeys;
    case 'allValues'
      value = obj.allValues;
    case 'keyType'
      value = obj.keyType;
    case 'valueType'
      value = obj.valueType;
    case 'keys'
      value = keys(obj, extra{:});
    case 'values'
      value = values(obj, extra{:});
    case 'types'
      value = types(obj, extra{:});
    case 'numEntries'
      value = numEntries(obj, extra{:});
    case 'isConfigured'
      value = isConfigured(obj, extra{:});
    case 'isKey'
      value = isKey(obj, extra{:});
    otherwise
      error('Nelson:dictionary:unknownProperty', 'Unknown property: %s', s(1).subs);
  end
  if numel(s) > 1
    value = subsref(value, s(2:end));
  end
  varargout{1} = value;
end
%=============================================================================
function value = dictionaryParenReference(obj, s)
  rawValues = dictionaryValuesForKeys(obj, s);
  if strcmp(obj.valueType, 'cell')
    value = cell(size(rawValues));
    for k = 1:numel(rawValues)
      value{k} = rawValues{k}{1};
    end
    return
  end
  try
    value = [rawValues{:}];
  catch
    error('Nelson:dictionary:cannotConcatenateValues', 'Cannot concatenate values.');
  end
  key = dictionaryKeyForType(dictionaryIndexKey(s), obj.keyType);
  value = reshape(value, size(key));
end
%=============================================================================
function contents = dictionaryBraceReference(obj, s)
  if (~isConfigured(obj))
    error('Nelson:dictionary:notConfigured', "Dictionary not configured");
  end
  if ~strcmp(obj.valueType, 'cell')
    error('Nelson:dictionary:unsupportedBraceIndexing', 'Using curly braces on a dictionary with ''%s'' value type is not supported. The dictionary value type must be ''cell''.', obj.valueType);
  end
  rawValues = dictionaryValuesForKeys(obj, s);
  contents = cell(size(rawValues));
  for k = 1:numel(rawValues)
    contents{k} = rawValues{k}{1};
  end
end
%=============================================================================
function rawValues = dictionaryValuesForKeys(obj, s)
  if (isempty(s.subs))
    error('Nelson:dictionary:noKeySpecified', "No key specified");
  end
  if (iscell(s.subs) && (numel(s.subs) > 1))
    error('Nelson:dictionary:TooManyInputsToParenReference', 'Too many input arguments. To search for multiple entries, utilize an array of keys instead.');
  end
  if (~isConfigured(obj))
    error('Nelson:dictionary:notConfigured', "Dictionary not configured");
  end
  key = dictionaryIndexKey(s);
  key = dictionaryKeyForType(key, obj.keyType);
  rawValues = cell(size(key));
  for k = 1:numel(key)
    currentKey = key(k);
    if (~isa(currentKey, obj.keyType))
      currentKey = convertDataType(obj.keyType, currentKey);
    end
    keyIndex = dictionary.findKeyIndex(obj, currentKey);
    if keyIndex > 0
      rawValues{k} = dictionary.valueAt(obj, keyIndex);
    else
      error('Nelson:dictionary:unknownKey', "Unknown key");
    end
  end
end
%=============================================================================
function key = dictionaryIndexKey(s)
  key = s.subs{1};
end
%=============================================================================
function key = dictionaryKeyForType(key, keyType)
  if strcmp(keyType, 'string') && ischar(key)
    key = string(key);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = vertcat(varargin)
  error('Nelson:dictionary:cannotCombine', 'Combining ''dictionary'' objects is not allowed as they are designed to be scalar.');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
