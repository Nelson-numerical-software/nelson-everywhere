% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function report = nmm_install_three_rhs(module_name, module_version, option)
  report = [];
  if ~ischar(module_name)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 2);
  end
  if ~ischar(module_version)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 3);
  end
  if ~ischar(option)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 4);
  end
  if strcmp(option, '-offline')
    installOfflinePackage(module_name, module_version);
    return
  end
  if strcmp(option, '-dry-run')
    report = nmm_install_registry_dry_run(module_name, module_version);
    return
  end
  nmm_error('InvalidOptionExpected', '%s expected.', sprintf('#%d argument: ''-offline'' or ''-dry-run''', 4));
end
%=============================================================================
function installOfflinePackage(module_name, versionSpec)
  source = nmm_cache('latest', module_name, versionSpec);
  nmm_install(source);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function versions = nmm_installed(varargin)
  if length(varargin) ~= 1
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  moduleName = varargin{1};
  if ~ischar(moduleName)
    nmm_error('CharactersExpected', '#%d argument: characters expected.', 2);
  end
  modules = nmm_list();
  versions = {};
  if ~isfield(modules, moduleName)
    return
  end
  data = modules.(moduleName);
  records = installedVersions(data);
  for k = 1:length(records)
    versions{end + 1} = records(k).version;
  end
end
%=============================================================================
function versions = installedVersions(moduleData)
  versions = struct([]);
  if isfield(moduleData, 'versions') && ~isempty(moduleData.versions)
    versions = moduleData.versions;
    return
  end
  if isfield(moduleData, 'path') && isfield(moduleData, 'version')
    versions = moduleData;
    if isfield(versions, 'versions')
      versions = rmfield(versions, 'versions');
    end
    if isfield(versions, 'pinned_version')
      versions = rmfield(versions, 'pinned_version');
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [r, url, tag_branch] = nmm_is_http_repository(param)
  r = false;
  url = '';
  tag_branch = '';
  if ~ischar(param)
    return
  end
  if ((startsWith(param, 'http://') == 1 || startsWith(param, 'https://') == 1) && ~isempty(strfind(param, '.git')))
    tag_index = strfind(param, '#');
    if isempty(tag_index)
      r = true;
      url = param;
      tag_branch = '';
    else
      if isscalar(tag_index)
        r = true;
        url = param(1:tag_index - 1);
        tag_branch = param(tag_index + 1:end);
      else
        r = false;
      end
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function r = nmm_is_installed(module_name, varargin)
  if nargin == 2
    [~, module_data] = nmm_find_installed_module(module_name, varargin{1});
  elseif nargin == 1
    [~, module_data] = nmm_find_installed_module(module_name);
  else
    nmm_error('WrongNumberOfInputArguments', 'Wrong number of input arguments.');
  end
  r = ~isempty(module_data);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function tf = nmm_is_remote_registry(source)
  % A remote registry is fetched with websave (raw bytes) and must be signed:
  % http(s) endpoints, plus file:// URLs (same code path, testable offline).
  tf = ischar(source) && (startsWith(source, 'http://') ...
    || startsWith(source, 'https://') || startsWith(source, 'file://'));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [r, msg] = nmm_is_supported_platform(platforms)
  r = false;
  msg = 'Invalid type in platforms';
  validPlatforms = nmm_valid_platforms();
  currentArch = computer('arch');

  if ischar(platforms)
    platforms = {platforms};
  elseif isstring(platforms)
    platforms = cellstr(platforms);
  elseif ~iscellstr(platforms)
    return
  end

  for platform = platforms(:)'
    if ~any(strcmp(validPlatforms, platform{1}))
      msg = sprintf('Platform not supported: %s', platform{1});
      return
    end
  end

  if any(strcmp(platforms, 'all')) || any(strcmp(platforms, currentArch))
    r = true;
    msg = '';
  else
    if length(platforms) == 1
      msg = sprintf('Platform not supported: %s', platforms{1});
    else
      msg = sprintf('Platform not supported: %s', sprintf('%s ', platforms{:}));
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
