classdef StackedLineProperties
  properties
    Color = []
    MarkerFaceColor = 'none'
    MarkerEdgeColor = []
    LineStyle = '-'
    LineWidth = 0.5
    Marker = 'none'
    MarkerSize = 6
    PlotType = 'plot'
  end

  methods
    function obj = StackedLineProperties(color, markerFaceColor, markerEdgeColor, lineStyle, ...
        lineWidth, marker, markerSize, plotType)
      if nargin == 0
        return
      end
      obj.Color = color;
      obj.MarkerFaceColor = markerFaceColor;
      obj.MarkerEdgeColor = markerEdgeColor;
      obj.LineStyle = lineStyle;
      obj.LineWidth = lineWidth;
      obj.Marker = marker;
      obj.MarkerSize = markerSize;
      obj.PlotType = plotType;
    end
  end
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function p = ancestor(varargin)
  narginchk(2, 3);
  nargoutchk(0, 1);
  h = varargin{1};
  type = varargin{2};

  if (ischar(type))
    type = {type};
  elseif (~iscellstr(type))
    p = [];
  end

  do_once = true;
  if (nargin == 3)
    toplevel = varargin{3};
    if (ischar(toplevel) && strcmpi(toplevel, 'toplevel'))
      do_once = false;
    else
      error('Nelson:ancestor:toplevelExpectedAsThird', '''toplevel'' expected as third argument.');
    end
  end

  mustReturnEmpty = isempty(h) || ~isgraphics(h);
  p = [];
  if ~mustReturnEmpty
    p = cell(numel(h), 1);
    H = cell(size(h));
    for i = 1:size(h, 1)
      for j = 1:size(h, 2)
        H{i, j} = h(i, j);
      end
    end
    h = H;
    for nh = 1:numel(h)
      while (true)
        if (isempty(h{nh}))
          break;
        end
        if (any(strcmpi(get(h{nh}, 'Type'), type)))
          p{nh} = h{nh};
          if do_once
            break;
          end
        end
        h{nh} = get(h{nh}, 'Parent');
      end
    end
    if (nh == 1)
      p = p{1};
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = animatedline(varargin)
  nargoutchk(0, 1);
  inputArguments = convertStringToCharArgs(varargin);
  [parent, inputArguments] = parseParent(inputArguments);
  [x, y, z, propertiesList, hasInitialPoints] = parseAnimatedLineArguments(inputArguments);
  validatePropertyPairs(propertiesList);
  h = __animatedline__('Parent', parent, propertiesList{:});
  if hasInitialPoints
    addpoints(h, x, y, z);
  end
  if nargout > 0
    varargout{1} = h;
  end
end
%=============================================================================
function [parent, args] = parseParent(args)
  if ~isempty(args) && isscalar(args{1}) && (isgraphics(args{1}, 'axes') || isgraphics(args{1}, 'hggroup'))
    parent = args{1};
    args = args(2:end);
  else
    parent = gca();
  end
end
%=============================================================================
function [x, y, z, propertiesList, hasInitialPoints] = parseAnimatedLineArguments(args)
  x = [];
  y = [];
  z = [];
  hasInitialPoints = false;
  numericCount = 0;
  while numericCount < numel(args) && isnumeric(args{numericCount + 1})
    numericCount = numericCount + 1;
  end
  if numericCount == 0
    propertiesList = args;
    return
  end
  if numericCount ~= 2 && numericCount ~= 3
    error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
  end
  x = args{1};
  y = args{2};
  if numericCount == 3
    z = args{3};
  else
    z = zeros(size(x));
  end
  propertiesList = args(numericCount + 1:end);
  hasInitialPoints = true;
end
%=============================================================================
function validatePropertyPairs(propertiesList)
  if rem(numel(propertiesList), 2) ~= 0
    error('Nelson:graphics:nameValuePair', 'Name-value arguments must be paired.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = annotation(varargin)
  narginchk(1, 10000);
  nargoutchk(0, 1);

  args = convertStringToCharArgs(varargin);
  [parent, args] = parseAnnotationParent(args);
  if isempty(args) || ~ischar(args{1})
    error('Nelson:annotation:invalidAnnotationType', 'Annotation type must be a string.');
  end

  kind = lower(args{1});
  args = args(2:end);
  if isLineAnnotation(kind)
    [constructorArgs, args] = parseLineAnnotationArgs(args);
  elseif isShapeAnnotation(kind)
    [constructorArgs, args, explicitPosition] = parseShapeAnnotationArgs(args);
    if strcmp(kind, 'textbox') && explicitPosition
      constructorArgs = [constructorArgs, {'FitBoxToText', 'off'}];
    end
  else
    error('Nelson:annotation:unsupportedType', 'Unsupported annotation type.');
  end

  if rem(length(args), 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  h = __annotation__(kind, parent, constructorArgs{:}, args{:});
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [parent, args] = parseAnnotationParent(args)
  parent = gcf();
  if isempty(args)
    return
  end
  first = args{1};
  if isscalar(first) && isgraphics(first)
    if isgraphics(first, 'figure')
      parent = first;
      args = args(2:end);
    else
      error('Nelson:annotation:invalidAnnotationParent', 'Annotation parent must be a figure.');
    end
  end
end
%=============================================================================
function tf = isLineAnnotation(kind)
  tf = any(strcmp(kind, {'line', 'arrow', 'doublearrow', 'textarrow'}));
end
%=============================================================================
function tf = isShapeAnnotation(kind)
  tf = any(strcmp(kind, {'rectangle', 'ellipse', 'textbox'}));
end
%=============================================================================
function [constructorArgs, args] = parseLineAnnotationArgs(args)
  x = [0.3 0.4];
  y = [0.3 0.4];
  if length(args) >= 2 && isnumeric(args{1}) && isnumeric(args{2})
    x = validateTwoElementVector(args{1}, 'X');
    y = validateTwoElementVector(args{2}, 'Y');
    args = args(3:end);
  elseif ~isempty(args) && ~ischar(args{1})
    error('Nelson:annotation:invalidLineAnnotationCoordinates', 'Line annotation coordinates must be numeric two-element vectors.');
  end
  constructorArgs = {'X', x, 'Y', y};
end
%=============================================================================
function [constructorArgs, args, explicitPosition] = parseShapeAnnotationArgs(args)
  position = [0.3 0.3 0.1 0.1];
  explicitPosition = false;
  if ~isempty(args) && isnumeric(args{1})
    position = validateFourElementVector(args{1}, 'Position');
    args = args(2:end);
    explicitPosition = true;
  elseif ~isempty(args) && ~ischar(args{1})
    error('Nelson:annotation:invalidShapeAnnotationPosition', 'Shape annotation position must be a numeric four-element vector.');
  end
  constructorArgs = {'Position', position};
end
%=============================================================================
function value = validateTwoElementVector(value, name)
  if ~isnumeric(value) || numel(value) ~= 2
    error('Nelson:annotation:mustBeTwoElementVector', '%s must be a two-element numeric vector.', name);
  end
  value = double(reshape(value, 1, 2));
end
%=============================================================================
function value = validateFourElementVector(value, name)
  if ~isnumeric(value) || numel(value) ~= 4
    error('Nelson:annotation:mustBeFourElementVector', '%s must be a four-element numeric vector.', name);
  end
  value = double(reshape(value, 1, 4));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = area(varargin)
  % area(Y)
  % area(X, Y)
  % area(..., basevalue)
  % area(..., Name, Value)
  % area(ax, ...)
  % a = area(...)

  narginchk(1, 1000);
  nargoutchk(0, 1);

  inputArguments = convertStringToCharArgs(varargin);
  [parent, inputArguments] = parseParent(inputArguments);
  ax = areaAxes(parent);
  nextPlot = '';
  if ~isempty(ax) && isscalar(ax) && isgraphics(ax, 'axes')
    nextPlot = ax.NextPlot;
  end
  [XData, YData, baseValue, propertiesList] = parseAreaArguments(inputArguments);
  [XData, xIsDate] = datetimeToSerial(XData);
  [YData, yIsDate] = datetimeToSerial(YData);
  h = areaPlot(parent, XData, YData, baseValue, propertiesList);
  fixAreaAxesLimits(parent, XData);
  if ~isempty(ax) && any(strcmp(nextPlot, {'replace', 'replaceall'}))
    ax.Box = 'on';
  end
  if xIsDate
    applyDatetimeAxis(parent, 'x');
  end
  if yIsDate
    applyDatetimeAxis(parent, 'y');
  end

  if nargout > 0
    varargout{1} = h;
  else
    varargout = {};
  end
end
%=============================================================================
function fixAreaAxesLimits(parent, XData)
  ax = areaAxes(parent);
  if isempty(ax) || ~strcmp(ax.XLimMode, 'auto')
    return
  end
  xLimits = [min(XData(:)), max(XData(:))];
  if all(isfinite(xLimits)) && xLimits(2) > xLimits(1)
    ax.XLim = xLimits;
  end
end
%=============================================================================
function ax = areaAxes(parent)
  if isgraphics(parent, 'axes')
    ax = parent;
  else
    ax = ancestor(parent, 'axes');
  end
end
%=============================================================================
function [parent, inputArguments] = parseParent(inputArguments)
  if ~isempty(inputArguments) && isscalar(inputArguments{1}) ...
      && (isgraphics(inputArguments{1}, 'axes') || isgraphics(inputArguments{1}, 'hggroup'))
    parent = inputArguments{1}(1);
    inputArguments = inputArguments(2:end);
    parent = newplotTarget(parent);
  else
    [parent, inputArguments] = graphicsExtractParentProperty(inputArguments);
    parent = newplotTarget(parent);
  end
end
%=============================================================================
function [XData, YData, baseValue, propertiesList] = parseAreaArguments(inputArguments)
  firstProperty = findFirstAreaProperty(inputArguments);
  propertiesList = inputArguments(firstProperty:end);
  dataArguments = inputArguments(1:firstProperty - 1);
  baseValue = 0;
  if ~isempty(dataArguments) && isnumeric(dataArguments{end}) && isscalar(dataArguments{end}) ...
      && length(dataArguments) > 1
    baseValue = dataArguments{end};
    dataArguments = dataArguments(1:end - 1);
  end
  if length(dataArguments) == 1
    YData = dataArguments{1};
    if isvector(YData)
      YData = YData(:);
    end
    XData = (1:size(YData, 1)).';
  elseif length(dataArguments) == 2
    XData = dataArguments{1};
    YData = dataArguments{2};
  elseif isempty(dataArguments)
    error('Nelson:notEnoughInputs', 'Not enough input arguments.');
  else
    error('Nelson:tooManyInputs', 'Too many input arguments.');
  end
  if isvector(YData)
    YData = YData(:);
  end
  if isvector(XData)
    XData = XData(:);
  end
  if size(XData, 2) == 1 && size(YData, 2) > 1
    XData = repmat(XData, 1, size(YData, 2));
  end
  if ~isequal(size(XData), size(YData))
    error('Nelson:dimagree:sizeDataMismatch', 'Size of data mismatch.');
  end
  if mod(length(propertiesList), 2) ~= 0
    error('Nelson:wrongNumberOfInputs', 'Wrong number of input arguments.');
  end
end
%=============================================================================
function index = findFirstAreaProperty(inputArguments)
  index = length(inputArguments) + 1;
  for k = 1:length(inputArguments)
    if isAreaPropertyName(inputArguments{k})
      index = k;
      return
    end
  end
end
%=============================================================================
function h = areaPlot(parent, XData, YData, baseValue, propertiesList)
  lower = baseValue * ones(size(YData, 1), 1);
  h = gobjects(1, size(YData, 2));
  for k = 1:size(YData, 2)
    upper = lower + YData(:, k);
    X = XData(:, k);
    vertices = [X, upper, ones(size(X)); flipud(X), flipud(lower), ones(size(X))];
    faces = 1:size(vertices, 1);
    color = getColorAndUpdateIndex(parent);
    % Default edge is the dark-gray axes foreground (33/255), matching the
    % reference and bar/surf -- not pure black.
    args = {'Parent', parent, 'XData', X, 'YData', YData(:, k), ...
      'Faces', faces, 'Vertices', vertices, 'FaceColor', color, ...
      'EdgeColor', [0.129411764705882, 0.129411764705882, 0.129411764705882], ...
      'BaseValue', baseValue};
    args = [args, propertiesList];
    h(k) = __area__(args{:});
    lower = upper;
  end
end
%=============================================================================
function tf = isAreaPropertyName(value)
  tf = ischar(value) && isValidGraphicsProperty('area', value);
end
%=============================================================================
ï»¿%=============================================================================
