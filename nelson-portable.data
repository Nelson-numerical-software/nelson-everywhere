% LICENCE_BLOCK_END
%=============================================================================
function [R, tieadj] = tiedrank(X, varargin)
  narginchk(1, 3);
  nargoutchk(0, 2);
  if ~(isnumeric(X) && isreal(X) && ~issparse(X))
    error('Nelson:statistics:xMustBeRealArray', '%s must be a real numeric array.', 'X');
  end
  [kendall, bidirectional] = parseOptionsLocal(varargin);
  [R, tieadj] = tiedrankArrayLocal(double(X), kendall, bidirectional, isvector(X), size(X));
end
%=============================================================================
function [kendall, bidirectional] = parseOptionsLocal(args)
  kendall = false;
  bidirectional = false;
  if length(args) >= 1
    kendall = parseLogicalScalarLocal(args{1}, 'KENDALL');
  end
  if length(args) >= 2
    bidirectional = parseLogicalScalarLocal(args{2}, 'BIDIRECTIONAL');
  end
end
%=============================================================================
function value = parseLogicalScalarLocal(value, name)
  if ~((isnumeric(value) || islogical(value)) && isreal(value) && isscalar(value) ...
      && (value == 0 || value == 1))
    error('Nelson:validators:mustBeLogicalScalar', '%s must be a logical scalar.', name);
  end
  value = logical(value);
end
%=============================================================================
function [R, tieadj] = tiedrankArrayLocal(X, kendall, bidirectional, isVectorInput, originalSize)
  if isVectorInput
    [ranks, tieadj] = tiedrankVectorLocal(X(:), kendall, bidirectional);
    R = reshape(ranks, originalSize);
    return
  end
  sz = originalSize;
  rows = sz(1);
  cols = prod(sz(2:end));
  X = reshape(X, rows, cols);
  R = NaN(rows, cols);
  if kendall
    tieadj = zeros(3, cols);
  else
    tieadj = zeros(1, cols);
  end
  for k = 1:cols
    [R(:, k), tieadj(:, k)] = tiedrankVectorLocal(X(:, k), kendall, bidirectional);
  end
  R = reshape(R, sz);
  if length(sz) > 2
    if kendall
      tieadj = reshape(tieadj, [3 sz(2:end)]);
    else
      tieadj = reshape(tieadj, [1 sz(2:end)]);
    end
  end
end
%=============================================================================
function [ranks, tieadj] = tiedrankVectorLocal(values, kendall, bidirectional)
  ranks = NaN(size(values));
  keep = ~isnan(values);
  if ~any(keep)
    tieadj = tieAdjustmentLocal([], kendall);
    return
  end
  validValues = values(keep);
  [sortedValues, order] = sort(validValues(:));
  n = length(sortedValues);
  localRanks = zeros(n, 1);
  if n == 1
    starts = 1;
  else
    starts = [1; find(diff(sortedValues) ~= 0) + 1];
  end
  stops = [starts(2:end) - 1; n];
  tieLengths = stops - starts + 1;
  for k = 1:length(starts)
    rows = starts(k):stops(k);
    if bidirectional
      baseRanks = min(rows, n - rows + 1);
      localRanks(order(rows)) = mean(baseRanks);
    else
      localRanks(order(rows)) = (starts(k) + stops(k)) / 2;
    end
  end
  ranks(keep) = localRanks;
  tieadj = tieAdjustmentLocal(tieLengths(tieLengths > 1), kendall);
end
%=============================================================================
function tieadj = tieAdjustmentLocal(tieLengths, kendall)
  if isempty(tieLengths)
    if kendall
      tieadj = zeros(3, 1);
    else
      tieadj = 0;
    end
    return
  end
  t = double(tieLengths(:));
  if kendall
    tieadj = [sum(t .* (t - 1) / 2); ...
              sum(t .* (t - 1) .* (t - 2)); ...
              sum(t .* (t - 1) .* (2 * t + 5))];
  else
    tieadj = sum(t .^ 3 - t) / 2;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function m = trimmean(x, percent, varargin)
  narginchk(2, 4);
  nargoutchk(0, 1);
  if ~(isnumeric(x) && isreal(x) && ~issparse(x))
    error('Nelson:statistics:xMustBeRealArray', '%s must be a real numeric array.', 'X');
  end
  percent = parsePercentLocal(percent);
  if isempty(x)
    m = cast(NaN, class(x));
    return
  end
  [flag, dims, allValues, returnInput] = parseInputsLocal(x, varargin);
  if returnInput
    m = x;
  elseif allValues
    m = trimVectorLocal(double(x(:)), percent, flag);
  else
    m = trimAlongDimensionsLocal(double(x), percent, flag, dims);
  end
  if isa(x, 'single') && ~isa(m, 'single')
    m = single(m);
  end
end
%=============================================================================
function percent = parsePercentLocal(value)
  if ~(isnumeric(value) && isreal(value) && isscalar(value)) ...
      || ~isfinite(value) || value < 0 || value > 100
    error('Nelson:statistics:PERCENTScalarBetween0100', 'PERCENT must be a scalar between 0 and 100.');
  end
  percent = double(value);
end
%=============================================================================
function [flag, dims, allValues, returnInput] = parseInputsLocal(x, args)
  flag = 'round';
  dims = firstNonsingletonLocal(size(x));
  allValues = false;
  returnInput = false;
  hasDimension = false;
  hasFlag = false;
  for index = 1:length(args)
    value = args{index};
    if isTextScalarLocal(value) && isTrimFlagLocal(char(value))
      if hasFlag
        error('Nelson:statistics:invalidTrimmingFlag', 'Invalid trimming flag.');
      end
      flag = lower(char(value));
      hasFlag = true;
    else
      if hasDimension
        error('Nelson:wrongNumberOfInputs', 'Wrong number of input arguments.');
      end
      [dims, allValues, returnInput] = parseDimensionLocal(value, size(x));
      hasDimension = true;
    end
  end
end
%=============================================================================
function [dims, allValues, returnInput] = parseDimensionLocal(value, sz)
  allValues = false;
  returnInput = false;
  if isTextScalarLocal(value)
    text = lower(char(value));
    if strcmp(text, 'all')
      dims = [];
      allValues = true;
      return
    end
    error('Nelson:statistics:dimensionPositiveIntegerScalarVector', 'Dimension must be a positive integer scalar, vector, or ''all''.');
  end
  if ~(isnumeric(value) && isreal(value) && isvector(value) && ~isempty(value) ...
      && all(value == fix(value)) && all(value >= 1))
    error('Nelson:statistics:dimensionPositiveIntegerScalarVector', 'Dimension must be a positive integer scalar, vector, or ''all''.');
  end
  dims = unique(double(value(:).'), 'stable');
  rank = max(2, length(sz));
  if isscalar(dims) && (dims > rank || dimensionLengthLocal(sz, dims) == 1)
    returnInput = true;
  elseif all(dims > rank)
    returnInput = true;
  else
    dims = dims(dims <= rank);
  end
end
%=============================================================================
function m = trimAlongDimensionsLocal(x, percent, flag, dims)
  originalRank = max(2, length(size(x)));
  sz = size(x);
  nd = max([length(sz), max(dims)]);
  sz(end + 1:nd) = 1;
  keepDims = setdiff(1:nd, dims, 'stable');
  perm = [dims, keepDims];
  xp = permute(reshape(x, sz), perm);
  psize = size(xp);
  psize(end + 1:nd) = 1;
  n = prod(psize(1:length(dims)));
  cols = prod(psize(length(dims) + 1:end));
  xr = reshape(xp, n, cols);
  values = NaN(1, cols);
  for k = 1:cols
    values(k) = trimVectorLocal(xr(:, k), percent, flag);
  end
  outSize = sz;
  outSize(dims) = 1;
  outSize = outSize(1:originalRank);
  permutedOutSize = [ones(1, length(dims)), psize(length(dims) + 1:end)];
  m = ipermute(reshape(values, permutedOutSize), perm);
  m = reshape(m, outSize);
end
%=============================================================================
function value = trimVectorLocal(values, percent, flag)
  values = sort(values(~isnan(values)));
  n = length(values);
  if n == 0
    value = NaN;
    return
  end
  k = n * percent / 200;
  if strcmp(flag, 'weighted')
    value = weightedTrimLocal(values, k);
  else
    trimCount = trimCountLocal(k, flag);
    if n - 2 * trimCount <= 0
      value = NaN;
    else
      value = mean(values((trimCount + 1):(n - trimCount)));
    end
  end
end
%=============================================================================
function count = trimCountLocal(k, flag)
  if strcmp(flag, 'floor')
    count = floor(k);
  else
    count = ceil(k - 0.5);
    count = max(count, 0);
  end
end
%=============================================================================
function value = weightedTrimLocal(values, k)
  n = length(values);
  i = floor(k);
  f = k - i;
  denominator = n - 2 * k;
  if denominator <= 0
    value = NaN;
    return
  end
  first = i + 1;
  last = n - i;
  if f == 0
    value = mean(values(first:last));
  else
    value = (sum(values((first + 1):(last - 1))) + (1 - f) * (values(first) + values(last))) ...
        / denominator;
  end
end
%=============================================================================
function tf = isTrimFlagLocal(text)
  text = lower(text);
  tf = strcmp(text, 'round') || strcmp(text, 'floor') || strcmp(text, 'weighted');
end
%=============================================================================
function value = dimensionLengthLocal(sz, dim)
  if dim <= length(sz)
    value = sz(dim);
  else
    value = 1;
  end
end
%=============================================================================
function dim = firstNonsingletonLocal(sz)
  dim = 1;
  for k = 1:length(sz)
    if sz(k) ~= 1
      dim = k;
      return
    end
  end
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function D = x2fx(X, modelspec, varargin)
  narginchk(2, 4);
  nargoutchk(0, 1);

  if ~isnumeric(X) || ndims(X) ~= 2
    error('Nelson:statistics:xNumericMatrix', '%s must be a numeric matrix.', 'X');
  end
  terms = modelTerms(size(X, 2), modelspec);
  D = ones(size(X, 1), 1);
  for t = 1:size(terms, 1)
    col = ones(size(X, 1), 1);
    for j = 1:size(X, 2)
      if terms(t, j) ~= 0
        col = col .* (X(:, j) .^ terms(t, j));
      end
    end
    D = [D col];
  end
end
%=============================================================================
function terms = modelTerms(p, modelspec)
  if ischar(modelspec) || isStringScalar(modelspec)
    text = lower(char(modelspec));
    switch text
      case {'constant', 'const'}
        terms = zeros(0, p);
      case 'linear'
        terms = eye(p);
      case {'interaction', 'interactions'}
        terms = [eye(p); pairTerms(p)];
      case {'quadratic', 'purequadratic'}
        terms = [eye(p); 2 * eye(p)];
      otherwise
        error('Nelson:statistics:invalidModelSpecification', 'Invalid model specification.');
    end
  elseif isnumeric(modelspec)
    if isscalar(modelspec)
      degree = positiveInteger(modelspec, sprintf(_('%s must be a positive integer scalar.'), 'Model degree'));
      terms = degreeTerms(p, degree);
    else
      if size(modelspec, 2) ~= p
        error('Nelson:statistics:modelMatrixOneColumnFactor', 'Model matrix must have one column per %s.', 'factor');
      end
      terms = modelspec;
    end
  else
    error('Nelson:statistics:invalidModelSpecification', 'Invalid model specification.');
  end
end
%=============================================================================
function terms = degreeTerms(p, degree)
  terms = [];
  for total = 1:degree
    terms = [terms; compositions(p, total)];
  end
end
%=============================================================================
function terms = compositions(p, total)
  if p == 1
    terms = total;
    return
  end
  terms = [];
  for v = 0:total
    rest = compositions(p - 1, total - v);
    terms = [terms; [v * ones(size(rest, 1), 1) rest]];
  end
end
%=============================================================================
function terms = pairTerms(p)
  terms = [];
  for i = 1:p
    for j = i + 1:p
      row = zeros(1, p);
      row(i) = 1;
      row(j) = 1;
      terms = [terms; row];
    end
  end
end
%=============================================================================
function value = positiveInteger(value, message)
  if ~isscalar(value) || value <= 0 || floor(value) ~= value
    error('Nelson:statistics:mustBePositiveInteger', message);
  end
end
