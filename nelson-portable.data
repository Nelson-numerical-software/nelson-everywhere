%=============================================================================
asserts.isequal(nargin('isnh5file'), 1);
asserts.isequal(nargout('isnh5file'), 1);
%=============================================================================
nh5_filename = [modulepath('hdf5', 'tests'), '/', 'h5save_schema_1.nh5'];
asserts.istrue(isnh5file(nh5_filename));
%=============================================================================
nh5_filename_ko = [modulepath('hdf5', 'tests'), '/', 'h5save_schema_X.nh5'];
asserts.isfalse(isnh5file(nh5_filename_ko));
%=============================================================================
nh5_filename = [modulepath('hdf5', 'tests'), '/', 'test_isnh5file_header.nh5'];
[tf, version, header] = isnh5file(nh5_filename);
asserts.isequal(tf, true);
asserts.isequal(version{1}, '-v1');
asserts.isequal(header{1}, 'Nelson 1.0 NH5-file on Sun Mar 31 17:28:07 2019');
%=============================================================================
nh5_filename_ko = [modulepath('hdf5', 'tests'), '/', 'h5save_schema_X.nh5'];
[tf, version, header] = isnh5file(nh5_filename_ko);
asserts.isequal(tf, false);
asserts.isequal(version{1}, '');
asserts.isequal(header{1}, '');
