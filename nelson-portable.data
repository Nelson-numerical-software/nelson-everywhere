function unsetenv(env_name)
  narginchk(1, 1);
  nargoutchk(0, 0);
  if ~(ischar(env_name) || (isStringScalar(env_name)))
    error('Nelson:unsetenv:invalidInputType', 'Wrong type for argument #%d: %s expected.', 1, 'string');
  end
  setenv(char(env_name));
end
