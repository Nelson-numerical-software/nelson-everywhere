% LICENCE_BLOCK_END
%=============================================================================
function varargout = size(obj, varargin)
  outputCount = max(nargout, 1);
  [varargout{1:outputCount}] = timeseriesSizeValue(obj.Data_, outputCount, varargin{:});
end
