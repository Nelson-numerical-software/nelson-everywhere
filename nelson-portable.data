function jobs = progressive_empty_jobs()
  jobs = struct('executables', {{}}, 'process_arguments', {{}}, ...
    'timeouts', [], 'kind', {{}}, 'index', [], 'metadata', {{}}, ...
    'job_id', {{}}, 'schedule_order', [], 'weight', [], 'reusable', [], ...
    'payload', {{}}, 'launcher', {{}}, 'result_file', {{}}, 'attempt', []);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function idx = progressive_event_index(event)
  idx = event.index;
  while iscell(idx) || isstruct(idx)
    if isempty(idx)
      idx = 0;
      return
    end
    if iscell(idx)
      idx = idx{1};
    elseif isfield(idx, 'index')
      idx = idx(1).index;
    else
      idx = 0;
      return
    end
  end
  if isempty(idx)
    idx = 0;
  elseif length(idx) > 1
    idx = idx(1);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function [updatedState, stopped] = progressive_flush_ready(currentState, ...
    initialIndex, nbTotalTests, fmtStart, stoponfail)
  updatedState = currentState;
  stopped = false;
  ready = updatedState.cursor <= length(updatedState.results);
  while ready && updatedState.completed(updatedState.cursor)
    testCase = updatedState.results{updatedState.cursor};
    displayIndex = initialIndex + updatedState.cursor - 1;
    display_progressive_case(testCase, displayIndex, nbTotalTests, fmtStart);
    updatedState.cursor = updatedState.cursor + 1;
    if stoponfail && strcmp(testCase.status, 'Fail')
      stopped = true;
      return
    end
    ready = updatedState.cursor <= length(updatedState.results);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function state = progressive_initial_state(testCases)
  caseCount = length(testCases);
  state.cases = testCases;
  state.results = cell(1, caseCount);
  state.completed = false(1, caseCount);
  state.fallback = false(1, caseCount);
  state.fallback_attempt = false(1, caseCount);
  state.failures = cell(1, caseCount);
  state.cursor = 1;
  state.pids = [];
  for k = 1:caseCount
    if testCases(k).skip
      state.results{k} = testCases(k);
      state.completed(k) = true;
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function testCases = progressive_mark_metrics(testCases, state, nbWorkers)
  if isempty(testCases)
    return
  end
  testCases(1).worker_pool_native_jobs = length(state.pids);
  testCases(1).worker_pool_requested_workers = nbWorkers;
  testCases(1).worker_pool_inline_jobs = 0;
  testCases(1).worker_pool_script_jobs = any([testCases.worker_pool_used]);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function updatedState = progressive_record_pid(currentState, event)
  updatedState = currentState;
  if event.pid > 0 && ~any(updatedState.pids == event.pid)
    updatedState.pids = [updatedState.pids, event.pid];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function selected = progressive_reusable_indices(testCases, requested, attempt)
  if attempt ~= 1
    selected = [];
    return
  end
  reusable = false(1, length(requested));
  for k = 1:length(requested)
    idx = requested(k);
    reusable(k) = ~testCases(idx).skip && can_pool_test_case(testCases(idx));
  end
  selected = requested(reusable);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function [updatedState, stopped] = progressive_run_jobs(currentState, jobs, ...
    nbWorkers, allowFallback, initialIndex, nbTotalTests, fmtStart, stoponfail)
  updatedState = currentState;
  stopped = false;
  if isempty(jobs.index)
    [updatedState, stopped] = progressive_flush_ready(updatedState, initialIndex, ...
      nbTotalTests, fmtStart, stoponfail);
    return
  end
  handle = __nelson_unittest_process_supervisor_start__(jobs, nbWorkers);
  try
    done = false;
    while ~done && ~stopped
      polledEvents = __nelson_unittest_process_supervisor_poll__(handle, 20);
      if ~isempty(polledEvents)
        tests_manager_trace('events', ...
          ['poll events=', int2str(length(polledEvents))]);
      end
      [updatedState, done] = progressive_consume_events(...
        updatedState, polledEvents, allowFallback);
      [updatedState, stopped] = progressive_flush_ready(updatedState, ...
        initialIndex, nbTotalTests, fmtStart, stoponfail);
    end
  catch ex
    __nelson_unittest_process_supervisor_stop__(handle);
    rethrow(ex);
  end
  __nelson_unittest_process_supervisor_stop__(handle);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function [jobs, testCases, worker] = progressive_test_jobs(...
    testCases, indices, attempt, progressLabel)
  if nargin < 4
    progressLabel = '';
  end
  jobs = progressive_empty_jobs();
  worker = worker_pool_empty_worker();
  requestedIndices = indices(:)';
  progress = progress_indicator_start(progressLabel, length(requestedIndices), true);
  tests_manager_trace('jobs', ['build attempt=', int2str(attempt), ...
    ' indices=', mat2str(requestedIndices)]);
  reusable = progressive_reusable_indices(testCases, requestedIndices, attempt);
  if ~isempty(reusable)
    worker = progressive_create_reusable_worker(testCases(reusable(1)));
  end
  configuredIndices = [];
  configuredCases = [];
  count = 0;
  try
    for k = requestedIndices
      count = count + 1;
      tests_manager_trace('jobs', ['visit index=', mat2str(k), ...
        ' skip=', mat2str(testCases(k).skip)]);
      if ~testCases(k).skip
        tests_manager_trace('jobs', ['configure index=', mat2str(k)]);
        testCase = testCases(k);
        useWorker = attempt == 1 && can_pool_test_case(testCase);
        tests_manager_trace('jobs', ['reuse index=', mat2str(k), ...
          ' value=', mat2str(useWorker)]);
        if useWorker
          tests_manager_trace('jobs', 'reusable branch');
          executable = worker.executable;
          processArguments = worker.process_arguments;
          payload = testCase.filename;
          kind = progressive_case_kind(testCase);
          launcher = 'cli';
        else
          tests_manager_trace('jobs', 'direct branch');
          testCase = configure_test_case_launchers(testCase);
          configuredIndices = [configuredIndices, k];
          configuredCases = [configuredCases; testCase];
          executable = testCase.executable;
          processArguments = testCase.process_arguments;
          payload = '';
          kind = progressive_case_kind(testCase);
          launcher = progressive_case_launcher(testCase);
        end
        jobs = progressive_append_job(jobs, testCase, k, attempt, ...
          executable, processArguments, payload, kind, launcher, useWorker);
        tests_manager_trace('jobs', ['append index=', int2str(k), ...
          ' kind=', kind, ' launcher=', launcher]);
      end
      progress = progress_indicator_update(progress, count);
    end
  catch ex
    progress_indicator_finish(progress, count);
    rethrow(ex);
  end
  progress_indicator_finish(progress);
  if ~isempty(configuredIndices)
    testCases(configuredIndices) = configuredCases;
  end
  tests_manager_trace('jobs', ['ready count=', int2str(length(jobs.index))]);
end
