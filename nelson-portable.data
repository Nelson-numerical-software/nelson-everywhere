%=============================================================================
function props = eventtablePropertiesView(raw, vars)
  % Properties as shown: the event variables first, then the timetable
  % properties without Events.
  props = eventtablePruneVariables(vars, raw.VariableNames);
  names = fieldnames(raw);
  for k = 1:length(names)
    if ~strcmp(names{k}, 'Events')
      props.(names{k}) = raw.(names{k});
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function vars = eventtablePruneVariables(vars, variableNames)
  % An event variable removed or renamed is unset.
  fields = fieldnames(vars);
  for k = 1:length(fields)
    name = vars.(fields{k});
    if ~isempty(name) && ~any(strcmp(name, variableNames))
      vars.(fields{k}) = [];
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function name = eventtableResolveVariable(field, value, data, variableNames, rowTimes)
  % Name of the event variable designated by value (a name or an index),
  % [] when value is [].
  if isnumeric(value) && isempty(value)
    name = [];
    return
  end
  if isstring(value) && isscalar(value)
    value = char(value);
  end
  if isnumeric(value) && isscalar(value) && value == fix(value) && value >= 1
    if value > length(variableNames)
      error('Nelson:eventtable:varIndexOutOfRange', 'Variable index exceeds table dimensions.');
    end
    name = variableNames{value};
  elseif ischar(value) && isrow(value)
    name = value;
  else
    error('Nelson:eventtable:invalidVarName', 'A table variable name subscript must be a character vector, string array, or cell array of character vectors, with each name in the subscript containing one or more characters.');
  end
  if ~any(strcmp(name, variableNames))
    error('Nelson:eventtable:unrecognizedVariable', sprintf('Unrecognized table variable name ''%s''.', name));
  end
  eventtableCheckVariableType(field, data.(name), rowTimes);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [raw, requested] = eventtableSplitProperties(value, raw)
  % Splits an assigned Properties value into the timetable properties raw
  % (the current ones updated in place, so that their order is kept) and
  % the requested event variables (a missing field keeps its value).
  if ~isstruct(value) || ~isscalar(value)
    error('Nelson:table:invalidPropertiesAssignment', _('Properties must be a scalar structure.'));
  end
  requested = struct();
  fields = fieldnames(eventtableNoVariables());
  names = fieldnames(value);
  for k = 1:length(names)
    if any(strcmp(names{k}, fields))
      requested.(names{k}) = value.(names{k});
    else
      raw.(names{k}) = value.(names{k});
    end
  end
end
