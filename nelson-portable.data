function lines = report_htmlOverview(cases)
  lines = {
    '<section class="overview-grid" aria-label="Report overview">'
    '<div class="overview-panel">'
  };
  lines = [lines(:); report_htmlSlowest(cases)];
  lines = [lines; {'</div>'; '<div class="overview-panel">'}];
  lines = [lines; report_htmlModuleSummary(cases)];
  lines = [lines; {'</div>'; '</section>'}];
  lines = lines(:);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function lines = report_htmlPreBlock(title, value)
  if isempty(value)
    lines = cell(0, 1);
    return
  end
  lines = {['<section><h2>', report_htmlEscape(title), '</h2><pre>', ...
    report_htmlEscape(value), '</pre></section>']};
  lines = lines(:);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
function cases = report_htmlRawCases(results)
  cases = struct([]);
  if ~isfield(results, 'raw') || ~isfield(results.raw, 'tests_list')
    return
  end
  suites = results.raw.tests_list;
  for suite = suites(:)'
    if isfield(suite, 'test_cases_list')
      currentCases = suite.test_cases_list;
      for testCase = currentCases(:)'
        cases = [cases; testCase];
      end
    end
  end
end
