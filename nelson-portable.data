function tf = leapyear(year)
  mustBeNumeric(year, 1)
  mustBeReal(year, 1)
  year = floor(year);
  tf = ((mod(year, 4) == 0 & mod(year, 100) ~= 0) | mod(year, 400) == 0);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
