B = [0.232; 0.0203; 0];
C = [0 0 1];
D = 1;
Ts = 1.2;
sys1 = ss(A, B, C, D, Ts);
sys2 = ss(A, B, C, D);

P = 2;
Q = P * C' * C;
R = 2;
[K1, S1, e1] = lqr(sys1, Q, R);

K1_REF = [-0.4606 -10.4369 0];
e1_REF = [-0.2101 + 0.5186i; -0.2101 - 0.5186i; 0.0000 + 0.0000i];

