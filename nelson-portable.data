[numerator, denominator] = padecoef(T, N);
asserts.isapprox(numerator, [1.0000 -10.0000 45.0000 -105.0000 105.0000], 1e-3);
asserts.isapprox(denominator, [1.0000 10.0000 45.0000 105.0000 105.0000], 1e-3);
%=============================================================================
