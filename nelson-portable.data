% LICENCE_BLOCK_END
%=============================================================================
function y = signalBesseli0(x)
  y = zeros(size(x));
  term = ones(size(x));
  k = 0;
  while max(abs(term(:))) > eps()
    y = y + term;
    k = k + 1;
    term = term .* ((x ./ 2) .^ 2) ./ (k ^ 2);
    if k > 60
      break;
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
