function R = uplus(A)
  R = table.applyUnary(A, @uplus, 'uplus');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function custom = variableCustomPropertiesSubset(st, order)
  % The custom properties of the table struct st, the per-variable ones set
  % (one element per variable) indexed by the variable indices order.
  custom = st.Properties.CustomProperties;
  if ~isfield(st, 'VariableCustomProperties') || ~isstruct(custom)
    return
  end
  nVars = length(st.Properties.VariableNames);
  names = st.VariableCustomProperties;
  for k = 1:length(names)
    if isfield(custom, names{k}) && numel(custom.(names{k})) == nVars
      custom.(names{k}) = custom.(names{k})(order);
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [data, props] = applyVariableProperties(obj, data, oldNames, props)
  % Validates the per-variable metadata of a Properties struct against the
  % variables named oldNames, stores it as row cells and renames the data
  % fields by position.
  props = rowVariableProperties(props);
  n = length(oldNames);
  names = checkedVariableNames(obj, props.VariableNames);
  renamed = ~isequal(names(:), oldNames(:));
  if renamed || ~iscellstr(names)
    validateNames(obj, names, _('Variable names must be nonempty and distinct.'));
  end
  if length(names) ~= n
    error('Nelson:table:invalidVariableNames', _('VariableNames must have one name per variable.'));
  end
  checkPerVariableLength(props, n, 'VariableDescriptions');
  checkPerVariableLength(props, n, 'VariableUnits');
  checkPerVariableLength(props, n, 'VariableContinuity');
  if renamed
    newData = struct();
    for k = 1:n
      newData.(names{k}) = data.(oldNames{k});
    end
    data = newData;
  end
  props.VariableNames = names;
end
%=============================================================================
function props = rowVariableProperties(props)
  % Per-variable metadata is stored as a row cell, whatever the orientation
  % given; string arrays become cells of character vectors.
  fields = {'VariableNames', 'VariableDescriptions', 'VariableUnits', 'VariableContinuity'};
  for k = 1:length(fields)
    if isfield(props, fields{k})
      v = props.(fields{k});
      if isstring(v)
        props.(fields{k}) = reshape(cellstr(v), 1, []);
      elseif iscell(v) && size(v, 1) > 1
        props.(fields{k}) = reshape(v, 1, []);
      end
    end
  end
end
%=============================================================================
function checkPerVariableLength(props, n, name)
  if isfield(props, name) && ~isempty(props.(name)) && numel(props.(name)) ~= n
    error('Nelson:table:invalidVariableProperty', _('%s must have one element per variable.'), name);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function checkDimensionVariableNames(obj, props)
  % A dimension name cannot also be a variable name.
  for name = props.DimensionNames
    if any(strcmp(props.VariableNames, name{1}))
      if istimetable(obj)
        id = 'Nelson:timetable:duplicateDimensionVariableNames';
      else
        id = 'Nelson:table:duplicateDimensionVariableNames';
      end
      error(id, _('Duplicate dimension and variable name: ''%s''.'), name{1});
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function value = checkPropertiesAssignment(obj, current, value)
  % Checks the shape of a value assigned to Properties: a scalar structure
  % whose fields are known properties. Missing fields keep their current
  % value.
  if ~isstruct(value) || ~isscalar(value)
    error('Nelson:table:invalidPropertiesAssignment', _('Properties must be a scalar structure.'));
  end
  names = fieldnames(value);
  if isequal(names, fieldnames(current))
    return
  end
  known = knownPropertyNames(obj);
  merged = current;
  for k = 1:length(names)
    if ~isfield(current, names{k}) && ~any(strcmp(names{k}, known))
      error('Nelson:table:unknownProperty', _('Unknown table property: %s.'), names{k});
    end
    merged.(names{k}) = value.(names{k});
  end
  if isfield(value, 'RowNames') && ~isempty(value.RowNames)
    merged.RowNames = checkedRowNames(obj, value.RowNames);
  end
  if isfield(value, 'DimensionNames')
    merged.DimensionNames = checkedDimensionNames(obj, value.DimensionNames);
  end
  value = merged;
end
%=============================================================================
function names = knownPropertyNames(obj)
  % Natively built tables carry only some of these fields.
  names = {'DimensionNames', 'Description', 'UserData', 'VariableNames', 'VariableTypes', ...
    'VariableDescriptions', 'VariableUnits', 'VariableContinuity', 'CustomProperties'};
  if istimetable(obj)
    names = [names, {'RowTimes', 'StartTime', 'SampleRate', 'TimeStep', 'Events'}];
  else
    names = [names, {'RowNames'}];
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function checkReservedVariableNames(obj, names)
  % Names reserved by the table interface cannot name a variable.
  for name = {'Properties', 'RowNames', 'VariableNames', ':'}
    if any(strcmp(names, name{1}))
      if istimetable(obj)
        id = 'Nelson:timetable:reservedVariableNameConflict';
      else
        id = 'Nelson:table:reservedVariableNameConflict';
      end
      error(id, _('Table variable name conflicts with reserved name ''%s''.'), name{1});
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function value = checkVariableCustomProperties(obj, value, current, names)
  % A per-variable custom property (names) assigned in the Properties struct
  % value holds one element per variable, stored as a row, or is 0x0.
  nVars = length(value.VariableNames);
  for k = 1:length(names)
    name = names{k};
    if ~isfield(value.CustomProperties, name) ...
        || (isfield(current.CustomProperties, name) && isequal(value.CustomProperties.(name), current.CustomProperties.(name)))
      continue
    end
    propertyValue = value.CustomProperties.(name);
    if isequal(size(propertyValue), [0 0])
      continue
    end
    if ~isvector(propertyValue) || numel(propertyValue) ~= nVars
      error('Nelson:table:IncorrectNumberOfVarCustomProps', _('The custom property ''%s'' must be a vector with one element for each variable in the table or must be a 0x0 empty (e.g. [], {}).'), name);
    end
    value.CustomProperties.(name) = reshape(propertyValue, 1, []);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function names = checkedDimensionNames(obj, names)
  % Dimension names must be two distinct nonempty names given as a string
  % array or a cell array of character vectors; they are returned as a row
  % cell.
  if isstring(names)
    names = cellstr(names);
  end
  if ~iscellstr(names) || any(cellfun('isempty', names(:)))
    error('Nelson:table:invalidDimensionNames', _('The DimensionNames property must be a string array or a cell array, with each name containing one or more characters.'));
  end
  if numel(names) ~= 2
    error('Nelson:table:invalidDimensionNamesCount', _('The DimensionNames property must contain one name for each dimension in the table.'));
  end
  if strcmp(names{1}, names{2})
    error('Nelson:table:duplicateDimensionNames', _('Duplicate table dimension name: ''%s''.'), names{1});
  end
  names = names(:)';
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function names = checkedRowNames(obj, names)
  % Row names must be a string array or a cell array of nonempty character
  % vectors; they are returned as a column cell.
  if isstring(names)
    names = cellstr(names);
  end
  if ~iscellstr(names) || any(cellfun('isempty', names(:)))
    error('Nelson:table:invalidRowNames', _('The RowNames property must be a string array or a cell array, with each name containing one or more characters.'));
  end
  if isempty(names)
    names = {};
  else
    names = names(:);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function names = checkedVariableNames(obj, names)
  % Variable names given as a whole must be a string array or a cell array
  % of character vectors; they are returned as a row cell.
  if ~iscell(names) && ~isstring(names)
    error('Nelson:table:invalidVariableNames', _('To assign multiple variable names, specify nonempty names in a string array or a cell array of character vectors.'));
  end
  names = toCellstrRow(obj, names);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function display(obj, varargin)
  % Shared by table, timetable and eventtable: the header names the class,
  % after the size unless the table is 1x1, and flags a table without rows
  % or without variables as empty.
  if nargin == 2
    name = varargin{1};
  else
    name = inputname(1);
  end
  currentFormat = format();
  isLoose = strcmp(currentFormat.LineSpacing, 'loose');
  if ~isempty(name)
    if isLoose
      fprintf('\n');
    end
    builtin('disp', [name, ' =']);
  end
  if isLoose
    fprintf('\n');
  end
  nRows = height(obj);
  nVars = width(obj);
  if nRows == 0 || nVars == 0
    header = sprintf('  %d%s%d empty %s', nRows, char(215), nVars, class(obj));
  elseif nRows == 1 && nVars == 1
    header = ['  ', class(obj)];
  else
    header = sprintf('  %d%s%d %s', nRows, char(215), nVars, class(obj));
  end
  header = [header, eventsText(obj)];
  builtin('disp', header);
  if isLoose
    fprintf('\n');
  end
  displayPreamble(obj, isLoose);
  disp(obj);
end
%=============================================================================
function text = eventsText(obj)
  % A timetable with a nonempty event table names its number of events.
  text = '';
  if ~strcmp(class(obj), 'timetable')
    return
  end
  props = subsref(obj, struct('type', '.', 'subs', 'Properties'));
  if ~isa(props.Events, 'eventtable')
    return
  end
  n = height(props.Events);
  if n == 1
    text = ' with 1 event';
  elseif n > 1
    text = sprintf(' with %d events', n);
  end
end
