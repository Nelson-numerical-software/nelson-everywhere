% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [x, y, z, V, vertices, patchHandle, negate] = parseIsonormalsInputs(args)
  [args, negate] = parseIsonormalsOption(args);
  patchHandle = [];
  if numel(args) == 2
    V = validateIsosurfaceVolume(args{1});
    [x, y, z] = defaultIsonormalsGrid(V);
    [vertices, patchHandle] = parseIsonormalsTarget(args{2});
  elseif numel(args) == 5
    V = validateIsosurfaceVolume(args{4});
    [x, y, z] = validateIsosurfaceGrid(args{1}, args{2}, args{3}, V);
    [vertices, patchHandle] = parseIsonormalsTarget(args{5});
  elseif numel(args) < 2
    error('Nelson:notEnoughInputs', 'Not enough input arguments.');
  elseif numel(args) > 5
    error('Nelson:tooManyInputs', 'Too many input arguments.');
  else
    error('Nelson:wrongNumberOfInputs', 'Wrong number of input arguments.');
  end
  validateIsonormalsVertices(vertices);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [args, negate] = parseIsonormalsOption(args)
  negate = false;
  if isempty(args) || ~ischar(args{end})
    return
  end
  if strcmpi(args{end}, 'negate')
    negate = true;
    args(end) = [];
  else
    error('Nelson:parseIsonormalsOption:invalidIsonormalsOption', 'Invalid isonormals option.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [vertices, patchHandle] = parseIsonormalsTarget(value)
  patchHandle = [];
  if isscalar(value) && isgraphics(value, 'patch')
    patchHandle = value;
    vertices = value.Vertices;
  else
    vertices = value;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [x, y, z, V, isovalue, colors, noshare, verbose] = parseIsosurfaceInputs(args)
  [args, noshare, verbose] = parseIsosurfaceOptions(args);
  if numel(args) <= 3
    [x, y, z, V, isovalue, colors] = parseDefaultIsosurfaceData(args);
    return
  end
  if numel(args) >= 4 && numel(args) <= 6
    [x, y, z, V, isovalue, colors] = parseExplicitIsosurfaceData(args);
    return
  end
  error('Nelson:tooManyInputs', 'Too many input arguments.');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [args, noshare, verbose] = parseIsosurfaceOptions(args)
  noshare = false;
  verbose = false;
  optionIndex = 0;
  while optionIndex < 2
    optionIndex = optionIndex + 1;
    if isempty(args) || ~ischar(args{end})
      return
    end
    [isNoshare, isVerbose] = parseOptionValue(args{end});
    noshare = noshare || isNoshare;
    verbose = verbose || isVerbose;
    args(end) = [];
  end
end
%=============================================================================
function [noshare, verbose] = parseOptionValue(option)
  noshare = false;
  verbose = false;
  switch lower(option)
    case 'noshare'
      noshare = true;
    case 'verbose'
      verbose = true;
    otherwise
      error('Nelson:parseIsosurfaceOptions:invalidIsosurfaceOption', 'Invalid isosurface option.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [isovalue, colors] = parseLevelOrColors(value, V)
  colors = [];
  if isnumeric(value) && isreal(value) && isequal(size(value), size(V)) && ~isscalar(value)
    isovalue = [];
    colors = validateIsosurfaceColors(value, V);
  else
    isovalue = validateIsosurfaceLevel(value);
  end
end
%=============================================================================
