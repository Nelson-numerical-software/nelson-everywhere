%=============================================================================
function varargout = plot3(varargin)
  inputArguments = convertStringToCharArgs(varargin);
  nbInputArguments = nargin;

  if (nbInputArguments >= 2)
    if (isscalar(inputArguments{1}) && (isgraphics(inputArguments{1}, 'axes') || isgraphics(inputArguments{1}, 'hggroup')))
      go = newplotTarget(inputArguments{1}(1));
      inputArguments(1) = [];
      nbInputArguments = nbInputArguments - 1;
    else
      go = newplotTarget(graphicsParentProperty(inputArguments));
    end
  end
  if isgraphics(go, 'hggroup')
    ax = ancestor(go, 'axes');
  else
    ax = go;
  end
  propertyIndex = 0;
  if (nbInputArguments > 2)
    propertyIndex = nbInputArguments - 1;
    bContinue = true;
    while ((propertyIndex >= 1) && bContinue)
      bContinue = ischar(inputArguments{propertyIndex}) && isValidGraphicsProperty('line', inputArguments{propertyIndex});
      if bContinue
        propertyIndex = propertyIndex - 2;
      end
    end
    propertyIndex = propertyIndex + 2;
  end
  propertiesList = {};

  if ((propertyIndex > 0) && (propertyIndex < nbInputArguments))
    propertiesList = inputArguments(propertyIndex:end);
    inputArguments(propertyIndex:end) = [];
  end

  h = [];
  while (~isempty(inputArguments))
    cs = '';
    ms = '';
    ps = '';
    if (length(inputArguments) < 3)
      error('Nelson:notEnoughInputs', 'Not enough input arguments.');
    end;
    r = true;
    if (length(inputArguments) > 3)
      [ps, cs, ms, msg] = colstyle(inputArguments{4}, '', false);
      r = isempty(msg);
    end
    if (length(inputArguments) == 3 || (length(inputArguments) > 3) && ~r)
      h = [h; plot_XYZ(inputArguments{1}, inputArguments{2}, inputArguments{3}, go, propertiesList)];
      inputArguments(1:3) = [];
    elseif ((length(inputArguments) >= 4) && r)
      h = [h; plot_XYZ(inputArguments{1}, inputArguments{2}, inputArguments{3}, go, completeProperties(cs, ms, ps, propertiesList))];
      inputArguments(1:4) = [];
    end;
  end
  if ~ishold(ax)
    view(ax, 3);
  end
  if isempty(find(strcmp(propertiesList, 'Visible')))
    h.Visible = 'on';
  end
  if (nargout > 0)
    varargout{1} = h;
  end
end
%=============================================================================
function q = completeProperties(cs, ms, ps, p)
  if isempty(ps)
    ps = 'none';
  end
  if (strcmp(cs, ''))
    q = {'Marker', ms, 'LineStyle', ps, p{:}};
  else
    q = {'Color', cs, 'Marker', ms, 'LineStyle', ps, p{:}};
  end
end
%=============================================================================
function h = plot_XYZ(X, Y, Z, go, lineProperties)
  h = [];
  if ((isvector(X) || isvector(Y) || isvector(Z)) && (~isvector(X) || ~isvector(Y) || ~isvector(Z)))
    rows = max([size(X, 1), size(Y, 1), size(Z, 1)]);
    cols = max([size(X, 2), size(Y, 2), size(Z, 2)]);
    X = resizeMatrix(X, rows, cols);
    Y = resizeMatrix(Y, rows, cols);
    Z = resizeMatrix(Z, rows, cols);
  end
  if (isvector(X))
    X = X(:);
  end;
  if (isvector(Y))
    Y = Y(:);
  end;
  if (isvector(Z))
    Z = Z(:);
  end;
  for i = 1:size(Z, 2)
    h = [h; plotVector(go, X(:, i), Y(:, i), Z(:, i), lineProperties)];
  end
end
%=============================================================================
function x = resizeMatrix(a, rows, cols)
  if (length(a) == rows)
    x = repmat(a(:), [1, cols]);
  elseif (length(a) == cols)
    x = repmat(a(:)', [rows, 1]);
  else
    error('Nelson:plot3:invalidInputArguments', 'Wrong size for input arguments: vectors with same size expected.');
  end
end
%=============================================================================
function hl = plotVector(go, x, y, z, lineProperties)
  if isgraphics(go, 'hggroup')
    ax = ancestor(go, 'axes');
  else
    ax = go;
  end
  lineStyle = getLineStyleAndUpdateIndex(ax);
  color = getColorAndUpdateIndex(ax);
  if (~any(strcmp(lineProperties, 'LineStyle')))
    lineProperties = [lineProperties, {'LineStyle', lineStyle}];
  end
  hl = __line__('Parent', go, 'XData', x, 'YData', y, 'ZData', z, 'Color', color, 'Visible', 'off', lineProperties{:});
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = plotmatrix(varargin)
  narginchk(1, 4);
  nargoutchk(0, 5);
  args = convertStringToCharArgs(varargin);
  [parentAx, x, y, sameData, markerSpec] = parsePlotMatrixInputs(args);
  [nbRows, xCols] = size(x);
  [yRows, yCols] = size(y);
  if nbRows ~= yRows
    error('Nelson:dimagree:xYNumberRows', 'X and Y must have the same number of rows.');
  end
  h = gobjects(yCols, xCols);
  ax = gobjects(yCols, xCols);
  histHandles = gobjects(1, min(xCols, yCols));
  histAxes = gobjects(1, min(xCols, yCols));
  if ~isempty(parentAx)
    newplot(parentAx);
  end
  parentFigure = plotMatrixFigure(parentAx);
  for row = 1:yCols
    for col = 1:xCols
      ax(row, col) = axes('Parent', parentFigure, ...
        'Position', plotMatrixAxesPosition(row, col, yCols, xCols));
      h(row, col) = plot(ax(row, col), x(:, col), y(:, row), markerSpec, 'LineStyle', 'none');
      applyPlotMatrixAxes(ax(row, col), row, col, yCols, xCols);
    end
  end
  if sameData
    [histHandles, histAxes] = drawDiagonalHistograms(ax, x);
  else
    histHandles = gobjects(0);
    histAxes = gobjects(0);
  end
  applyPlotMatrixVariableScales(ax, histAxes, x, y);
  if isempty(parentAx)
    bigax = axes('Position', [0.08 0.08 0.86 0.86], 'Visible', 'off');
  else
    bigax = parentAx;
    bigax.Visible = 'off';
  end
  bigax.Tag = 'PlotMatrixBigAx';
  state = struct();
  state.ChartType = 'plotmatrix';
  state.XData = x;
  state.YData = y;
  state.SameData = sameData;
  state.Axes = ax;
  state.DataHandles = h;
  state.HistogramHandles = histHandles;
  state.HistogramAxes = histAxes;
  bigax.UserData = state;
  outputs = {h, ax, bigax, histHandles, histAxes};
  for k = 1:nargout
    varargout{k} = outputs{k};
  end
end
%=============================================================================
function fig = plotMatrixFigure(parentAx)
  if isempty(parentAx)
    fig = gcf();
  else
    fig = ancestor(parentAx, 'figure');
  end
end
%=============================================================================
function position = plotMatrixAxesPosition(row, col, nbRows, nbCols)
  left = 0.135166666666667;
  right = 0.095;
  bottom = 0.115433333333333;
  top = 0.075;
  horizontalGap = 0.00516666666666667;
  verticalGap = 0.00543333333333333;
  width = (1 - left - right - (nbCols - 1) * horizontalGap) / nbCols;
  height = (1 - bottom - top - (nbRows - 1) * verticalGap) / nbRows;
  x = left + (col - 1) * (width + horizontalGap);
  y = 1 - top - row * height - (row - 1) * verticalGap;
  position = [x y width height];
end
%=============================================================================
function applyPlotMatrixVariableScales(ax, histAxes, x, y)
  xScales = plotMatrixScales(x);
  yScales = plotMatrixScales(y);
  [nbRows, nbCols] = size(ax);
  for row = 1:nbRows
    for col = 1:nbCols
      ax(row, col).XLim = xScales(col).Limits;
      ax(row, col).XTick = xScales(col).Ticks;
      ax(row, col).YLim = yScales(row).Limits;
      ax(row, col).YTick = yScales(row).Ticks;
    end
  end
  n = min(numel(histAxes), numel(xScales));
  for k = 1:n
    histAxes(k).XLim = xScales(k).Limits;
  end
end
%=============================================================================
function scales = plotMatrixScales(values)
  n = size(values, 2);
  scales = repmat(struct('Limits', [0 1], 'Ticks', []), 1, n);
  for k = 1:n
    [limits, ticks] = plotMatrixColumnScale(values(:, k));
    scales(k).Limits = limits;
    scales(k).Ticks = ticks;
  end
end
%=============================================================================
function [limits, ticks] = plotMatrixColumnScale(values)
  values = values(isfinite(values));
  if isempty(values)
    limits = [0 1];
    ticks = [];
    return
  end
  values = values(:).';
  low = min(values);
  high = max(values);
  if low == high
    limits = [low - 0.5, high + 0.5];
    ticks = low;
    return
  end
  if all(abs(values - round(values)) < 1e-12)
    uniqueValues = unique(values);
    if numel(uniqueValues) > 1 && all(abs(diff(uniqueValues) - 1) < 1e-12)
      ticks = low:high;
      limits = [low - 0.6, high + 0.6];
      return
    end
  end
  step = plotMatrixNiceStep((high - low) / 5);
  first = floor(low / step) * step;
  last = ceil(high / step) * step;
  ticks = first:step:last;
  limits = [first - 0.75 * step, last + 0.75 * step];
end
%=============================================================================
function step = plotMatrixNiceStep(value)
  value = abs(value);
  if value <= 0 || ~isfinite(value)
    step = 1;
    return
  end
  scale = 10 ^ floor(log10(value));
  normalized = value / scale;
  if normalized <= 1
    nice = 1;
  elseif normalized <= 2
    nice = 2;
  elseif normalized <= 5
    nice = 5;
  else
    nice = 10;
  end
  step = nice * scale;
end
%=============================================================================
function [parentAx, x, y, sameData, markerSpec] = parsePlotMatrixInputs(args)
  sameData = true;
  markerSpec = '.';
  parentAx = [];
  if ~isempty(args) && isscalar(args{1}) && isgraphics(args{1}, 'axes')
    parentAx = args{1};
    args = args(2:end);
  end
  if isempty(args) || ~isnumeric(args{1})
    error('Nelson:plotmatrix:numericMatrixExpected', '%s must be a numeric matrix.', 'Value');
  end
  x = double(args{1});
  y = x;
  args = args(2:end);
  if ~isempty(args) && isnumeric(args{1})
    y = double(args{1});
    sameData = false;
    args = args(2:end);
  end
  if ~isempty(args)
    if numel(args) == 1 && (ischar(args{1}) || isStringScalar(args{1}))
      markerSpec = char(args{1});
    else
      error('Nelson:graphics:unsupportedProperty', 'Unsupported "%s" option.', 'plotmatrix');
    end
  end
  if ~ismatrix(x) || ~ismatrix(y)
    error('Nelson:plotmatrix:invalidXAndY', 'X and Y must be matrices.');
  end
end
%=============================================================================
function [histHandles, histAxes] = drawDiagonalHistograms(ax, x)
  n = min(size(ax, 1), size(ax, 2));
  histHandles = gobjects(1, n);
  histAxes = gobjects(1, n);
  for k = 1:n
    pos = ax(k, k).Position;
    histAxes(k) = axes('Position', pos, 'Visible', 'on', 'Tag', 'PlotMatrixHistAx');
    histHandles(k) = histogram(histAxes(k), x(:, k));
    histAxes(k).XTick = [];
    histAxes(k).YTick = [];
    histAxes(k).XGrid = 'off';
    histAxes(k).YGrid = 'off';
  end
end
%=============================================================================
function applyPlotMatrixAxes(ax, row, col, nbRows, nbCols)
  ax.Tag = 'PlotMatrixScatterAx';
  if row < nbRows
    ax.XTickLabel = {};
  end
  if col > 1
    ax.YTickLabel = {};
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = polaraxes(varargin)
  nargoutchk(0, 1);
  inputArguments = convertStringToCharArgs(varargin);
  ax = __polaraxes__(inputArguments{:});
  [fig, previousDrawLater] = polarBeginDrawLater(ax);
  try
    ax = polarInitializeAxes(ax);
    polarEndDrawLater(fig, previousDrawLater);
  catch exception
    polarEndDrawLater(fig, previousDrawLater);
    error(exception.message);
  end
  if nargout == 1
    varargout{1} = ax;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = polarbubblechart(varargin)
  narginchk(3, 1000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  if ~isempty(args) && ~(istable(args{1}) || istimetable(args{1})) ...
      && isscalar(args{1}) && isgraphics(args{1}) ...
      && isgraphics(args{1}, 'axes') && ~isgraphics(args{1}, 'polaraxes')
    error('Nelson:graphics:invalidParentInput', 'Parent input must be a polaraxes object.');
  end
  [ax, args] = polarParseTargetAxes(args);
  ax = ensurePolarAxes(ax);
  if ~isempty(args) && (istable(args{1}) || istimetable(args{1}))
    [theta, radius, bubbleSize, colorData, args, tableArgs] = parseTableBubbleData(args);
  else
    tableArgs = {};
    [theta, radius, bubbleSize, colorData, args] = parseNumericBubbleData(args);
  end
  [chartArgs, rendererArgs] = parseBubbleOptions(args);
  [orientation, nSeries] = getSeriesOrientation(theta, radius, bubbleSize);
  [fig, previousDrawLater] = polarBeginDrawLater(ax);
  try
    ax = polarPrepareDataAxes(ax);
    h = createPolarBubbleSeries(ax, theta, radius, bubbleSize, colorData, orientation, nSeries, chartArgs, tableArgs);
    polarAppendDataHandles(ax, h);
    polarEndDrawLater(fig, previousDrawLater);
  catch exception
    polarEndDrawLater(fig, previousDrawLater);
    error(exception.message);
  end
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function h = createPolarBubbleSeries(ax, theta, radius, bubbleSize, colorData, orientation, nSeries, chartArgs, tableArgs)
  if nSeries == 1
    tk = graphicsSelectSeriesData(theta, orientation, 1, 'row');
    rk = graphicsSelectSeriesData(radius, orientation, 1, 'row');
    sk = graphicsSelectSeriesData(bubbleSize, orientation, 1, 'row');
    ck = graphicsSelectColorSeriesData(colorData, orientation, 1, nSeries, numel(tk), 'row');
    args = [chartArgs, graphicsSelectTableSeriesArgs(tableArgs, 1, nSeries)];
    h = createPolarBubbleObject(ax, tk, rk, sk, ck, args);
    state = struct();
    state.ChartType = 'polarbubblechart';
    state.BubbleSizeData = sk;
    state.Renderer = h;
    h.UserData = state;
    return
  end
  handles = cell(1, nSeries);
  for k = 1:nSeries
    tk = graphicsSelectSeriesData(theta, orientation, k, 'row');
    rk = graphicsSelectSeriesData(radius, orientation, k, 'row');
    sk = graphicsSelectSeriesData(bubbleSize, orientation, k, 'row');
    ck = graphicsSelectColorSeriesData(colorData, orientation, k, nSeries, numel(tk), 'row');
    args = [chartArgs, graphicsSelectTableSeriesArgs(tableArgs, k, nSeries)];
    hk = createPolarBubbleObject(ax, tk, rk, sk, ck, args);
    state = struct();
    state.ChartType = 'polarbubblechart';
    state.BubbleSizeData = sk;
    state.Renderer = hk;
    hk.UserData = state;
    handles{k} = hk;
  end
  h = [handles{:}];
end
%=============================================================================
function ax = ensurePolarAxes(ax)
  if isgraphics(ax, 'polaraxes')
    return
  end
  ax = polarInitializeAxes(ax, false);
end
%=============================================================================
function [theta, radius, bubbleSize, colorData, args] = parseNumericBubbleData(args)
  if numel(args) < 3 || ~isnumeric(args{1}) || ~isnumeric(args{2}) || ~isnumeric(args{3})
    error('Nelson:polarbubblechart:numericThetaRadiusExpected', 'Numeric theta, radius, and bubble size data expected.');
  end
  theta = args{1};
  radius = args{2};
  bubbleSize = args{3};
  args = args(4:end);
  colorData = [];
  if ~isempty(args) && (isnumeric(args{1}) || isColorText(args{1}))
    colorData = normalizeColorData(args{1});
    args = args(2:end);
  end
end
%=============================================================================
function h = createPolarBubbleObject(ax, theta, radius, bubbleSize, colorData, chartArgs)
  if ~isempty(colorData)
    chartArgs = [chartArgs, {'CData', colorData}];
  end
  h = __bubblechart__('Parent', ax, 'XData', [], 'YData', [], ...
    'ThetaData', theta, 'RData', radius, 'SizeData', bubbleSize, chartArgs{:});
end
%=============================================================================
function [chartArgs, rendererArgs] = parseBubbleOptions(args)
  chartArgs = {};
  rendererArgs = {};
  if rem(length(args), 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  for k = 1:2:length(args)
    name = char(args{k});
    value = args{k + 1};
    switch lower(name)
      case 'markeredgecolor'
        chartArgs = [chartArgs, {'MarkerEdgeColor', value}];
        rendererArgs = [rendererArgs, {'MarkerEdgeColor', value}];
      case 'markerfacecolor'
        chartArgs = [chartArgs, {'MarkerFaceColor', value}];
        rendererArgs = [rendererArgs, {'MarkerFaceColor', value}];
      case 'markeredgealpha'
        chartArgs = [chartArgs, {'MarkerEdgeAlpha', value}];
      case 'markerfacealpha'
        chartArgs = [chartArgs, {'MarkerFaceAlpha', value}];
      case 'linewidth'
        chartArgs = [chartArgs, {'LineWidth', value}];
        rendererArgs = [rendererArgs, {'LineWidth', value}];
      case {'displayname', 'visible', 'tag', 'userdata', 'handlevisibility'}
        chartArgs = [chartArgs, {name, value}];
      case 'sourcetable'
        chartArgs = [chartArgs, {'SourceTable', value}];
      case 'thetavariable'
        chartArgs = [chartArgs, {'ThetaVariable', value}];
      case 'rvariable'
        chartArgs = [chartArgs, {'RVariable', value}];
      case 'sizevariable'
        chartArgs = [chartArgs, {'SizeVariable', value}];
      case 'colorvariable'
        chartArgs = [chartArgs, {'ColorVariable', value}];
      otherwise
        error('Nelson:graphics:unsupportedProperty', 'Unsupported "%s" option.', 'polarbubblechart');
    end
  end
end
%=============================================================================
function tf = isColorText(value)
  tf = (ischar(value) || isStringScalar(value)) ...
    && (any(strcmpi(char(value), getColorShortNameList())) || any(strcmpi(char(value), getColorNameList())));
end
%=============================================================================
function colorData = normalizeColorData(value)
  if ischar(value) || isStringScalar(value)
    colorData = validatecolor(value);
  else
    colorData = value;
  end
end
%=============================================================================
function [theta, radius, bubbleSize, colorData, args, tableArgs] = parseTableBubbleData(args)
  tbl = args{1};
  if numel(args) < 4
    error('Nelson:graphics:tableVariableExpected', 'Table variable arguments expected.');
  end
  thetaNames = graphicsTableVariableNames(tbl, args{2});
  radiusNames = graphicsTableVariableNames(tbl, args{3});
  sizeNames = graphicsTableVariableNames(tbl, args{4});
  args = args(5:end);
  colorNames = {};
  if ~isempty(args) && ~isPolarBubblePropertyName(args{1})
    colorNames = graphicsTableVariableNames(tbl, args{1});
    args = args(2:end);
  end
  nSeries = max([numel(thetaNames), numel(radiusNames), numel(sizeNames), max(1, numel(colorNames))]);
  validateTableVariableCounts(thetaNames, radiusNames, sizeNames, colorNames, nSeries);
  [theta, radius, bubbleSize, colorData, tableArgs] ...
    = tableBubbleSeries(tbl, thetaNames, radiusNames, sizeNames, colorNames, nSeries);
end
%=============================================================================
function validateTableVariableCounts(thetaNames, radiusNames, sizeNames, colorNames, nSeries)
  counts = [numel(thetaNames), numel(radiusNames), numel(sizeNames)];
  if ~isempty(colorNames)
    counts(end + 1) = numel(colorNames);
  end
  if any(counts ~= 1 & counts ~= nSeries)
    error('Nelson:dimagree:tableVariableCountsMatch', 'Table variable counts must match.');
  end
end
%=============================================================================
function [theta, radius, bubbleSize, colorData, tableArgs] ...
    = tableBubbleSeries(tbl, thetaNames, radiusNames, sizeNames, colorNames, nSeries)
  theta = [];
  radius = [];
  bubbleSize = [];
  colorData = [];
  tableArgs = cell(1, nSeries);
  for k = 1:nSeries
    thetaName = graphicsSelectName(thetaNames, k);
    radiusName = graphicsSelectName(radiusNames, k);
    sizeName = graphicsSelectName(sizeNames, k);
    theta = graphicsAppendColumn(theta, graphicsNumericColumn(tbl.(thetaName), thetaName));
    radius = graphicsAppendColumn(radius, graphicsNumericColumn(tbl.(radiusName), radiusName));
    bubbleSize = graphicsAppendColumn(bubbleSize, graphicsNumericColumn(tbl.(sizeName), sizeName));
    oneArgs = {'SourceTable', tbl, 'ThetaVariable', thetaName, 'RVariable', radiusName, ...
      'SizeVariable', sizeName};
    if ~isempty(colorNames)
      colorName = graphicsSelectName(colorNames, k);
      colorData = graphicsAppendColumn(colorData, graphicsNumericColumn(tbl.(colorName), colorName));
      oneArgs(end + 1:end + 2) = {'ColorVariable', colorName};
    end
    if nSeries > 1
      oneArgs(end + 1:end + 2) = {'DisplayName', radiusName};
    end
    tableArgs{k} = oneArgs;
  end
end
%=============================================================================
function [orientation, nSeries] = getSeriesOrientation(theta, radius, bubbleSize)
  if isvector(theta) && isvector(radius) && isscalar(bubbleSize)
    orientation = 'points';
    nSeries = numel(theta);
    return
  end
  if isvector(theta) && isvector(radius)
    orientation = 'single';
    nSeries = 1;
    return
  end
  if isvector(theta) && ~isvector(radius)
    rows = size(radius, 1);
    cols = size(radius, 2);
    if numel(theta) == rows && (isscalar(bubbleSize) || (isvector(bubbleSize) && numel(bubbleSize) == rows))
      orientation = 'columns';
      nSeries = cols;
      return
    end
  end
  if ~isvector(theta) && isvector(radius)
    rows = size(theta, 1);
    cols = size(theta, 2);
    if numel(radius) == rows && (isscalar(bubbleSize) || (isvector(bubbleSize) && numel(bubbleSize) == rows))
      orientation = 'columns';
      nSeries = cols;
      return
    end
  end
  if isvector(bubbleSize) && numel(bubbleSize) == numel(theta) && isvector(radius)
    orientation = 'single';
    nSeries = 1;
    return
  end
  rows = size(theta, 1);
  cols = size(theta, 2);
  if isequal(size(bubbleSize), size(theta)) || (isvector(bubbleSize) && numel(bubbleSize) == rows)
    orientation = 'columns';
    nSeries = cols;
  elseif isrow(bubbleSize) && numel(bubbleSize) == cols && rows > 1
    orientation = 'rows';
    nSeries = rows;
  else
    error('Nelson:polarbubblechart:invalidSizeData', 'Size data must match theta and radius data.');
  end
end
%=============================================================================
function tf = isPolarBubblePropertyName(value)
  if ~(ischar(value) || isStringScalar(value))
    tf = false;
    return
  end
  names = {'ColorVariable', 'DisplayName', 'HandleVisibility', 'MarkerEdgeColor', ...
    'MarkerFaceColor', 'MarkerEdgeAlpha', 'MarkerFaceAlpha', 'LineWidth', ...
    'RVariable', 'SizeVariable', 'SourceTable', 'Tag', 'ThetaVariable', ...
    'UserData', 'Visible'};
  tf = any(strcmpi(char(value), names));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = polarhistogram(varargin)
  narginchk(1, 1000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [ax, args] = polarParseTargetAxes(args);
  if isempty(args) || ~isnumeric(args{1})
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Angle data');
  end
  theta = double(args{1}(:));
  args = args(2:end);
  opts = parsePolarHistogramOptions(args);
  if isempty(opts.BinEdges) && ~isempty(opts.NumBins)
    opts.BinEdges = polarNumBinsEdges(theta, opts.NumBins);
  end
  [fig, previousDrawLater] = polarBeginDrawLater(ax);
  try
    ax = polarPrepareDataAxes(ax);
    h = createPolarHistogramObject(ax, theta, opts);
    counts = h.Values;
    edges = h.BinEdges;
    patches = drawPolarHistogramPatches(ax, counts, edges, opts);
    limitHandle = __line__('Parent', ax, 'XData', [], 'YData', [], ...
      'ThetaData', edges(1:end - 1)', 'RData', counts(:), ...
      'Visible', 'off', 'HandleVisibility', 'off');
    polarAppendDataHandles(ax, limitHandle);
    state = polarHistogramState(theta, counts, edges, patches, limitHandle, opts);
    h.UserData = state;
    if ~isempty(patches)
      patches(1).UserData = state;
    end
    polarEndDrawLater(fig, previousDrawLater);
  catch exception
    polarEndDrawLater(fig, previousDrawLater);
    error(exception.message);
  end
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function opts = parsePolarHistogramOptions(args)
  defaultEdgeColor = graphicsDefaultEdgeColor();
  opts = struct('NumBins', [], 'BinEdges', [], 'Normalization', 'count', ...
    'FaceColor', 'auto', 'EdgeColor', defaultEdgeColor, 'FaceAlpha', 0.6);
  if ~isempty(args) && isnumeric(args{1})
    if isscalar(args{1})
      opts.NumBins = validateNumBins(args{1});
    else
      opts.BinEdges = validateEdges(args{1});
    end
    args = args(2:end);
  end
  if rem(length(args), 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  for k = 1:2:length(args)
    name = lower(char(args{k}));
    value = args{k + 1};
    switch name
      case 'numbins'
        opts.NumBins = validateNumBins(value);
      case 'binedges'
        opts.BinEdges = validateEdges(value);
      case 'normalization'
        opts.Normalization = validateNormalization(value);
      case 'facecolor'
        opts.FaceColor = value;
      case 'edgecolor'
        opts.EdgeColor = value;
      case 'facealpha'
        opts.FaceAlpha = validateAlpha(value);
      otherwise
        error('Nelson:graphics:unsupportedProperty', 'Unsupported "%s" option.', 'polarhistogram');
    end
  end
end
%=============================================================================
function edges = polarNumBinsEdges(theta, numBins)
  theta = theta(isfinite(theta));
  if isempty(theta)
    edges = linspace(0, 2 * pi, numBins + 1);
    return
  end
  quantum = pi / 4;
  firstEdge = floor(min(theta) / quantum) * quantum;
  lastEdge = ceil(max(theta) / quantum) * quantum;
  if firstEdge == lastEdge
    lastEdge = firstEdge + quantum;
  end
  edges = linspace(firstEdge, lastEdge, numBins + 1);
end
%=============================================================================
function patches = drawPolarHistogramPatches(parent, counts, edges, opts)
  patches = gobjects(1, numel(counts));
  faceColor = polarHistogramPatchFaceColor(parent, opts.FaceColor);
  for k = 1:numel(counts)
    theta = linspace(edges(k), edges(k + 1), 12);
    radius = counts(k) * ones(size(theta));
    x = [0, radius .* cos(theta), 0];
    y = [0, radius .* sin(theta), 0];
    patches(k) = __patch__('Parent', parent, 'XData', x, 'YData', y, ...
      'FaceColor', faceColor, 'EdgeColor', opts.EdgeColor, ...
      'FaceAlpha', opts.FaceAlpha, 'FaceLighting', 'none', ...
      'EdgeLighting', 'none');
  end
end
%=============================================================================
function color = polarHistogramPatchFaceColor(parent, value)
  if ischar(value) && strcmpi(value, 'auto')
    color = parent.ColorOrder(1, :);
    return
  end
  color = value;
end
%=============================================================================
function h = createPolarHistogramObject(parent, theta, opts)
  args = {'Parent', parent, 'Data', theta, 'Normalization', opts.Normalization, ...
    'FaceColor', opts.FaceColor, 'EdgeColor', opts.EdgeColor, 'FaceAlpha', opts.FaceAlpha};
  if ~isempty(opts.BinEdges)
    args = [args, {'BinEdges', opts.BinEdges}];
  elseif ~isempty(opts.NumBins)
    args = [args, {'NumBins', opts.NumBins}];
  end
  h = __histogram__(args{:});
end
%=============================================================================
function state = polarHistogramState(theta, counts, edges, patches, limitHandle, opts)
  state = struct();
  state.ChartType = 'polarhistogram';
  state.Data = theta;
  state.Values = counts;
  state.BinEdges = edges;
  state.Patches = patches;
  state.LimitHandle = limitHandle;
  state.Options = opts;
end
%=============================================================================
function value = validateNumBins(value)
  if ~isnumeric(value) || ~isscalar(value) || value < 1
    error('Nelson:graphics:mustBePositiveScalar', '%s must be a positive scalar.', 'NumBins');
  end
  value = floor(double(value));
end
%=============================================================================
function edges = validateEdges(value)
  if ~isnumeric(value) || numel(value) < 2 || any(diff(value(:)) <= 0)
    error('Nelson:polarhistogram:invalidBinEdges', 'BinEdges must be a strictly increasing numeric vector.');
  end
  edges = double(value(:)');
end
%=============================================================================
function value = validateNormalization(value)
  value = lower(char(value));
  if ~(strcmp(value, 'count') || strcmp(value, 'probability'))
    error('Nelson:polarhistogram:invalidNormalization', 'Normalization must be ''count'' or ''probability''.');
  end
end
%=============================================================================
function value = validateAlpha(value)
  if ~isnumeric(value) || ~isscalar(value) || value < 0 || value > 1
    error('Nelson:polarhistogram:invalidFaceAlpha', 'FaceAlpha must be between 0 and 1.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = polarplot(varargin)
  narginchk(1, 10000);
  nargoutchk(0, 1);
  inputArguments = convertStringToCharArgs(varargin);
  [ax, inputArguments] = parsePolarAxes(inputArguments);
  [fig, previousDrawLater] = polarBeginDrawLater(ax);
  try
    ax = preparePolarAxes(ax);
    [inputArguments, propertiesList] = splitLineProperties(inputArguments);
    h = gobjects(0, 1);
    showTableLegend = false;
    while ~isempty(inputArguments)
      lineSpec = '';
      if isPolarTableSyntax(inputArguments)
        [theta, radius, lineSpec, thetaVariables, radiusVariables, sourceTable, consumed] = ...
          parsePolarTableArguments(inputArguments);
        tableHandles = plotThetaRadius(ax, theta, radius, lineSpec, propertiesList);
        setPolarTableMetadata(tableHandles, sourceTable, thetaVariables, radiusVariables);
        showTableLegend = showTableLegend || numel(tableHandles) > 1;
        h = [h; tableHandles];
        inputArguments(1:consumed) = [];
      elseif length(inputArguments) == 1
        h = [h; plotRadiusOrComplex(ax, inputArguments{1}, lineSpec, propertiesList)];
        inputArguments(1) = [];
      else
        if ischar(inputArguments{2})
          [ps, cs, ms, msg] = colstyle(inputArguments{2}, 'plot', false);
        else
          msg = 'Invalid LineSpec string.';
        end
        if ischar(inputArguments{2}) && isempty(msg)
          h = [h; plotRadiusOrComplex(ax, inputArguments{1}, inputArguments{2}, propertiesList)];
          inputArguments(1:2) = [];
        elseif length(inputArguments) >= 3 && ischar(inputArguments{3})
          [ps, cs, ms, msg] = colstyle(inputArguments{3}, 'plot', false);
          if isempty(msg)
            lineSpec = inputArguments{3};
            h = [h; plotThetaRadius(ax, inputArguments{1}, inputArguments{2}, lineSpec, propertiesList)];
            inputArguments(1:3) = [];
          else
            h = [h; plotThetaRadius(ax, inputArguments{1}, inputArguments{2}, lineSpec, propertiesList)];
            inputArguments(1:2) = [];
          end
        else
          h = [h; plotThetaRadius(ax, inputArguments{1}, inputArguments{2}, lineSpec, propertiesList)];
          inputArguments(1:2) = [];
        end
      end
    end
    state = polarGetState(ax, false);
    state.DataHandles = [state.DataHandles; h(:)];
    polarSetState(ax, state);
    polarRefresh(ax, state, false);
    if showTableLegend
      legend(ax);
    end
    polarEndDrawLater(fig, previousDrawLater);
  catch exception
    polarEndDrawLater(fig, previousDrawLater);
    error(exception.message);
  end
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [ax, args] = parsePolarAxes(args)
  if ~isempty(args) && isscalar(args{1}) && (isgraphics(args{1}, 'axes') || isgraphics(args{1}, 'polaraxes'))
    ax = args{1};
    args(1) = [];
    return
  end
  gr = groot();
  if ~isempty(gr.CurrentFigure)
    ax = gca();
    return
  end
  ax = polaraxes();
end
%=============================================================================
function ax = preparePolarAxes(ax)
  if ~polarIsAxes(ax)
    ax = polarInitializeAxes(ax, false);
  end
  nextPlot = ax.NextPlot;
  state = polarGetState(ax, false);
  if ~strcmp(nextPlot, 'add') && isempty(state.DataHandles) ...
      && numel(allchild(ax)) == numel(state.GridHandles)
    return
  end
  newplot(ax);
  ax = polarInitializeAxes(ax, false);
  if ~strcmp(nextPlot, 'add')
    state = polarGetState(ax, false);
    state.GridHandles = gobjects(0, 1);
    state.DataHandles = gobjects(0, 1);
    polarSetState(ax, state);
  end
end
%=============================================================================
function [args, propertiesList] = splitLineProperties(args)
  nbInputArguments = length(args);
  propertyIndex = 0;
  if nbInputArguments > 2
    propertyIndex = nbInputArguments - 1;
    keepGoing = true;
    while propertyIndex >= 1 && keepGoing
      keepGoing = ischar(args{propertyIndex}) && isValidGraphicsProperty('line', args{propertyIndex});
      if keepGoing
        propertyIndex = propertyIndex - 2;
      end
    end
    propertyIndex = propertyIndex + 2;
  end
  propertiesList = {};
  if propertyIndex > 0 && propertyIndex < nbInputArguments
    propertiesList = args(propertyIndex:end);
    args(propertyIndex:end) = [];
  end
end
%=============================================================================
function handles = plotRadiusOrComplex(ax, values, lineSpec, propertiesList)
  if ~isnumeric(values)
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Value');
  end
  if isreal(values)
    radius = values;
    theta = defaultThetaForRadius(radius);
  else
    theta = angle(values);
    radius = abs(values);
  end
  handles = plotThetaRadius(ax, theta, radius, lineSpec, propertiesList);
end
%=============================================================================
function theta = defaultThetaForRadius(radius)
  if isvector(radius)
    n = numel(radius);
    if n <= 1
      theta = zeros(size(radius));
    else
      theta = linspace(0, 2 * pi, n);
      if size(radius, 2) == 1
        theta = theta';
      end
    end
  else
    n = size(radius, 1);
    theta = linspace(0, 2 * pi, n)';
  end
end
%=============================================================================
function handles = plotThetaRadius(ax, theta, radius, lineSpec, propertiesList)
  if ~(isnumeric(theta) && isnumeric(radius))
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Value');
  end
  [theta, radius] = matchPolarMatrices(theta, radius);
  if isvector(theta)
    theta = theta(:);
  end
  if isvector(radius)
    radius = radius(:);
  end
  handles = gobjects(0, 1);
  for k = 1:size(radius, 2)
    handles(end + 1, 1) = createPolarLine(ax, theta(:, k), radius(:, k), lineSpec, propertiesList);
  end
end
%=============================================================================
function h = createPolarLine(ax, theta, radius, lineSpec, propertiesList)
  lineProperties = propertiesFromLineSpec(lineSpec, propertiesList);
  color = getColorAndUpdateIndex(ax);
  lineStyle = getLineStyleAndUpdateIndex(ax);
  if ~any(strcmp(lineProperties, 'LineStyle'))
    lineProperties = [lineProperties, {'LineStyle', lineStyle}];
  end
  if ~any(strcmp(lineProperties, 'Visible'))
    lineProperties = [lineProperties, {'Visible', 'on'}];
  end
  h = __line__('Parent', ax, 'XData', [], 'YData', [], ...
    'ThetaData', theta, 'RData', radius, 'Color', color, ...
    lineProperties{:});
end
%=============================================================================
function properties = propertiesFromLineSpec(lineSpec, propertiesList)
  if isempty(lineSpec)
    properties = propertiesList;
    return
  end
  [ps, cs, ms, msg] = colstyle(lineSpec, 'plot', false);
  if ~isempty(msg)
    error('Nelson:polarplot:invalidLineSpec', msg);
  end
  if isempty(ps)
    ps = 'none';
  end
  if strcmp(cs, '')
    properties = {'Marker', ms, 'LineStyle', ps, propertiesList{:}};
  else
    properties = {'Color', cs, 'Marker', ms, 'LineStyle', ps, propertiesList{:}};
  end
end
%=============================================================================
function tf = isPolarTableSyntax(args)
  tf = length(args) >= 3 && (istable(args{1}) || istimetable(args{1})) ...
    && isTableVariableSelector(args{2}) && isTableVariableSelector(args{3});
end
%=============================================================================
function tf = isTableVariableSelector(value)
  tf = ischar(value) || iscellstr(value) || isstring(value);
  tf = tf && ~isempty(value);
end
%=============================================================================
function [theta, radius, lineSpec, thetaVariables, radiusVariables, sourceTable, consumed] = ...
    parsePolarTableArguments(args)
  sourceTable = args{1};
  thetaVariables = normalizeTableVariableNames(args{2});
  radiusVariables = normalizeTableVariableNames(args{3});
  theta = tableVariablesData(sourceTable, thetaVariables);
  radius = tableVariablesData(sourceTable, radiusVariables);
  lineSpec = '';
  consumed = 3;
  if length(args) >= 4 && ischar(args{4})
    [ps, cs, ms, msg] = colstyle(args{4}, 'plot', false);
    if isempty(msg)
      lineSpec = args{4};
      consumed = 4;
    end
  end
end
%=============================================================================
function names = normalizeTableVariableNames(names)
  if ischar(names)
    names = {names};
    return
  end
  if isstring(names)
    names = cellstr(names(:)');
    return
  end
  if ~iscellstr(names)
    error('Nelson:graphics:invalidVariableNames', 'Variable names must be character vectors or strings.');
  end
  names = names(:)';
end
%=============================================================================
function values = tableVariablesData(tbl, variableNames)
  values = [];
  for k = 1:length(variableNames)
    value = tableVariableData(tbl, variableNames{k});
    if isvector(value)
      value = value(:);
    end
    if isempty(values)
      values = value;
    elseif size(values, 1) == size(value, 1)
      values = [values, value];
    else
      error('Nelson:graphics:invalidTableVariables', 'Table variables must have compatible row counts.');
    end
  end
end
%=============================================================================
function value = tableVariableData(tbl, variableName)
  validateTableVariableName(variableName, tbl.Properties.VariableNames);
  value = tbl.(variableName);
  if ~(isnumeric(value) || islogical(value))
    error('Nelson:graphics:numericTableVariableExpected', 'Numeric table variable expected.');
  end
  value = double(value);
end
%=============================================================================
function validateTableVariableName(name, variableNames)
  if ~any(strcmp(name, variableNames))
    error('Nelson:graphics:unrecognizedTableVariable', 'Unrecognized table variable.');
  end
end
%=============================================================================
function setPolarTableMetadata(handles, sourceTable, thetaVariables, radiusVariables)
  for k = 1:numel(handles)
    thetaVariable = tableVariableForHandle(thetaVariables, k);
    radiusVariable = tableVariableForHandle(radiusVariables, k);
    if isprop(handles(k), 'SourceTable')
      handles(k).SourceTable = sourceTable;
    end
    if isprop(handles(k), 'ThetaVariable')
      handles(k).ThetaVariable = thetaVariable;
    end
    if isprop(handles(k), 'RVariable')
      handles(k).RVariable = radiusVariable;
    end
    if isprop(handles(k), 'DisplayName') && isempty(handles(k).DisplayName)
      handles(k).DisplayName = radiusVariable;
    end
  end
end
%=============================================================================
function name = tableVariableForHandle(names, index)
  if length(names) == 1
    name = names{1};
  else
    name = names{min(index, length(names))};
  end
end
%=============================================================================
function [a, b] = matchPolarMatrices(a, b)
  if isvector(a) && ~isvector(b)
    if length(a) == size(b, 1)
      a = repmat(a(:), [1, size(b, 2)]);
      return
    elseif length(a) == size(b, 2)
      b = b';
      a = repmat(a(:)', [size(b, 2), 1])';
      return
    else
      error('Nelson:dimagree:dimensionsDoNotMatch', 'Dimensions do not match.');
    end
  end
  if ~isvector(a) && isvector(b)
    if length(b) == size(a, 1)
      b = repmat(b(:), [1, size(a, 2)]);
    elseif length(b) == size(a, 2)
      a = a';
      b = repmat(b(:)', [size(a, 2), 1])';
    else
      error('Nelson:dimagree:dimensionsDoNotMatch', 'Dimensions do not match.');
    end
  end
  if ~isequal(size(a), size(b))
    error('Nelson:dimagree:dimensionsDoNotMatch', 'Dimensions do not match.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = polarscatter(varargin)
  narginchk(2, 1000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  if ~isempty(args) && ~(istable(args{1}) || istimetable(args{1})) ...
      && isscalar(args{1}) && isgraphics(args{1}, 'axes') && ~isgraphics(args{1}, 'polaraxes')
    error('Nelson:graphics:invalidParentInput', 'Parent input must be a polaraxes object.');
  end
  [ax, args] = polarParseTargetAxes(args);
  if ~isempty(args) && (istable(args{1}) || istimetable(args{1}))
    [theta, radius, args, tableArgs] = parseTableScatterData(args);
  else
    tableArgs = {};
    [theta, radius, args] = parseNumericScatterData(args);
  end
  [opts, chartProps, rendererProps] = parsePolarScatterOptions(args);
  [orientation, nSeries] = getSeriesOrientation(theta, radius);
  if nSeries > 1
    h = createPolarScatterSeries(ax, theta, radius, orientation, nSeries, opts, chartProps, tableArgs);
    if nargout == 1
      varargout{1} = h;
    end
    return
  end
  theta = graphicsSelectSeriesData(theta, orientation, 1, 'column');
  radius = graphicsSelectSeriesData(radius, orientation, 1, 'column');
  chartProps = [chartProps, graphicsSelectTableSeriesArgs(tableArgs, 1, nSeries)];
  [fig, previousDrawLater] = polarBeginDrawLater(ax);
  try
    ax = polarPrepareDataAxes(ax);
    if isempty(opts.Color)
      opts.Color = getColorAndUpdateIndex(ax);
    end
    renderer = createPolarMarkerLine(ax, theta, radius, opts, rendererProps);
    h = createPolarScatterObject(ax, theta, radius, opts, chartProps);
    state = h.UserData;
    state.ChartType = 'polarscatter';
    state.Renderer = renderer;
    h.UserData = state;
    polarAppendDataHandles(ax, renderer);
    polarEndDrawLater(fig, previousDrawLater);
  catch exception
    polarEndDrawLater(fig, previousDrawLater);
    error(exception.message);
  end
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [theta, radius, args] = parseNumericScatterData(args)
  if numel(args) < 2 || ~isnumeric(args{1}) || ~isnumeric(args{2})
    error('Nelson:polarscatter:numericThetaAndExpected', 'Numeric theta and radius data expected.');
  end
  theta = double(args{1});
  radius = double(args{2});
  if numel(theta) ~= numel(radius)
    error('Nelson:dimagree:valueValueNumberElements', '%s and %s must have the same number of elements.', 'Theta', 'radius');
  end
  theta = theta(:);
  radius = radius(:);
  args = args(3:end);
end
%=============================================================================
function [opts, chartProps, rendererProps] = parsePolarScatterOptions(args)
  opts = struct('SizeData', 36, 'Color', [], 'Marker', 'o', 'Filled', false);
  if ~isempty(args) && isnumeric(args{1})
    opts.SizeData = args{1};
    args = args(2:end);
  end
  if ~isempty(args) && (isnumeric(args{1}) || isColorText(args{1}))
    opts.Color = args{1};
    args = args(2:end);
  end
  [args, opts.Filled] = extractFilled(args);
  [args, markerFound, marker] = extractMarker(args);
  if markerFound
    opts.Marker = marker;
  end
  [chartProps, rendererProps] = parseNameValues(args);
end
%=============================================================================
function h = createPolarScatterSeries(ax, theta, radius, orientation, nSeries, opts, chartProps, tableArgs)
  handles = cell(1, nSeries);
  for k = 1:nSeries
    tk = graphicsSelectSeriesData(theta, orientation, k, 'column');
    rk = graphicsSelectSeriesData(radius, orientation, k, 'column');
    args = [chartProps, graphicsSelectTableSeriesArgs(tableArgs, k, nSeries)];
    handles{k} = createPolarScatterObject(ax, tk, rk, opts, args);
  end
  h = [handles{:}];
end
%=============================================================================
function h = createPolarMarkerLine(ax, theta, radius, opts, lineProps)
  color = opts.Color;
  if ischar(color) || isStringScalar(color)
    color = validatecolor(color);
  end
  % Per-point colour data (a vector of scalars, or an Nx3 matrix) maps through
  % the colormap to one colour per marker, exactly like a numeric C in scatter.
  color = resolvePolarPointColors(ax, color, numel(theta));
  markerSizes = markerSizeFromSizeData(opts.SizeData, numel(theta));
  perPointColor = isnumeric(color) && ismatrix(color) && size(color, 2) == 3 ...
    && size(color, 1) == numel(theta) && numel(theta) > 1;
  if isscalar(markerSizes) && ~perPointColor
    properties = {'LineStyle', 'none', 'Marker', opts.Marker, ...
      'MarkerSize', markerSizes, 'Color', color, 'MarkerEdgeColor', color};
    if opts.Filled
      properties = [properties, {'MarkerFaceColor', color, 'MarkerEdgeColor', 'none'}];
    end
    h = __line__('Parent', ax, 'XData', [], 'YData', [], ...
      'ThetaData', theta, 'RData', radius, properties{:}, lineProps{:});
  else
    h = [];
    theta = theta(:);
    radius = radius(:);
    if isscalar(markerSizes)
      markerSizes = repmat(markerSizes, 1, numel(theta));
    end
    for k = 1:numel(theta)
      pointColor = colorAtPoint(color, k);
      properties = {'LineStyle', 'none', 'Marker', opts.Marker, ...
        'MarkerSize', markerSizes(k), 'Color', pointColor, 'MarkerEdgeColor', pointColor};
      if opts.Filled
        properties = [properties, {'MarkerFaceColor', pointColor, 'MarkerEdgeColor', 'none'}];
      end
      h = [h, __line__('Parent', ax, 'XData', [], 'YData', [], ...
        'ThetaData', theta(k), 'RData', radius(k), properties{:}, lineProps{:})];
    end
  end
  state = struct('ChartType', 'polarscatter', 'SizeData', opts.SizeData);
  for k = 1:numel(h)
    h(k).UserData = state;
  end
end
%=============================================================================
function h = createPolarScatterObject(ax, theta, radius, opts, chartProps)
  color = opts.Color;
  if ischar(color) || isStringScalar(color)
    color = validatecolor(color);
  end
  properties = {'Parent', ax, 'XData', [], 'YData', [], ...
    'ThetaData', theta, 'RData', radius, 'SizeData', opts.SizeData, ...
    'CData', color, 'Marker', opts.Marker};
  if opts.Filled
    properties = [properties, {'MarkerFaceColor', 'flat', 'MarkerEdgeColor', 'none'}];
  end
  h = __scatter__(properties{:}, chartProps{:});
  state = struct('ChartType', 'polarscatter', 'SizeData', opts.SizeData);
  h.UserData = state;
end
%=============================================================================
function markerSize = markerSizeFromSizeData(sizeData, n)
  if isempty(sizeData)
    sizeData = 36;
  end
  if ~isnumeric(sizeData) || any(sizeData(:) <= 0)
    error('Nelson:validators:mustBePositive', '%s must be positive.', 'Size data');
  end
  markerSize = sqrt(double(sizeData(:).'));
  if isscalar(markerSize)
    return
  end
  if numel(markerSize) ~= n
    markerSize = markerSize(1);
  end
end
%=============================================================================
function rgb = resolvePolarPointColors(ax, color, n)
  rgb = color;
  if isempty(color) || ischar(color) || isStringScalar(color) || ~isnumeric(color)
    return
  end
  if ismatrix(color) && size(color, 2) == 3 && size(color, 1) == n
    return
  end
  if isvector(color) && numel(color) == n && n > 1
    cd = double(color(:));
    cmap = polarColormap(ax);
    lo = min(cd);
    hi = max(cd);
    if ~(hi > lo)
      hi = lo + 1;
    end
    m = size(cmap, 1);
    idx = round((cd - lo) / (hi - lo) * (m - 1)) + 1;
    idx = min(max(idx, 1), m);
    rgb = cmap(idx, :);
  end
end
function cmap = polarColormap(ax)
  cmap = parula(256);
  fig = ancestor(ax, 'figure');
  if ~isempty(fig)
    try
      cmap = get(fig, 'Colormap');
    catch
    end
  end
  if isempty(cmap) || size(cmap, 2) ~= 3
    cmap = parula(256);
  end
end
function color = colorAtPoint(colorData, k)
  color = colorData;
  if isnumeric(colorData) && ismatrix(colorData) && size(colorData, 2) == 3 ...
      && size(colorData, 1) >= k
    color = colorData(k, :);
  end
end
%=============================================================================
function tf = isColorText(value)
  tf = (ischar(value) || isStringScalar(value)) ...
    && (any(strcmpi(char(value), getColorShortNameList())) || any(strcmpi(char(value), getColorNameList())));
end
%=============================================================================
function [args, found] = extractFilled(args)
  found = false;
  for k = numel(args):-1:1
    if (ischar(args{k}) || isStringScalar(args{k})) && strcmpi(char(args{k}), 'filled')
      found = true;
      args(k) = [];
    end
  end
end
%=============================================================================
function [args, found, marker] = extractMarker(args)
  found = false;
  marker = 'o';
  markers = getMarkerNameList();
  for k = numel(args):-1:1
    if (ischar(args{k}) || isStringScalar(args{k})) && any(strcmpi(char(args{k}), markers))
      found = true;
      marker = char(args{k});
      args(k) = [];
      if k > 1 && (ischar(args{k - 1}) || isStringScalar(args{k - 1})) && strcmpi(char(args{k - 1}), 'Marker')
        args(k - 1) = [];
      end
      return
    end
  end
end
%=============================================================================
function [chartProps, rendererProps] = parseNameValues(args)
  if rem(length(args), 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  chartProps = {};
  rendererProps = {};
  for k = 1:2:length(args)
    name = char(args{k});
    value = args{k + 1};
    switch lower(name)
      case 'marker'
        chartProps = [chartProps, {'Marker', char(value)}];
        rendererProps = [rendererProps, {'Marker', char(value)}];
      case 'markeredgecolor'
        chartProps = [chartProps, {'MarkerEdgeColor', value}];
        rendererProps = [rendererProps, {'MarkerEdgeColor', value}];
      case 'markerfacecolor'
        chartProps = [chartProps, {'MarkerFaceColor', value}];
        rendererProps = [rendererProps, {'MarkerFaceColor', value}];
      case 'markeredgealpha'
        chartProps = [chartProps, {'MarkerEdgeAlpha', value}];
      case 'markerfacealpha'
        chartProps = [chartProps, {'MarkerFaceAlpha', value}];
      case 'linewidth'
        chartProps = [chartProps, {'LineWidth', value}];
        rendererProps = [rendererProps, {'LineWidth', value}];
      case {'displayname', 'visible', 'tag', 'userdata', 'handlevisibility'}
        chartProps = [chartProps, {name, value}];
      case 'sourcetable'
        chartProps = [chartProps, {'SourceTable', value}];
      case 'thetavariable'
        chartProps = [chartProps, {'ThetaVariable', value}];
      case 'rvariable'
        chartProps = [chartProps, {'RVariable', value}];
      otherwise
        error('Nelson:graphics:unsupportedProperty', 'Unsupported "%s" option.', 'polarscatter');
    end
  end
end
%=============================================================================
function [theta, radius, args, tableArgs] = parseTableScatterData(args)
  tbl = args{1};
  if numel(args) < 3
    error('Nelson:graphics:tableVariableExpected', 'Table variable arguments expected.');
  end
  thetaNames = graphicsTableVariableNames(tbl, args{2});
  radiusNames = graphicsTableVariableNames(tbl, args{3});
  args = args(4:end);
  nSeries = max(numel(thetaNames), numel(radiusNames));
  validateTableVariableCounts(thetaNames, radiusNames, nSeries);
  [theta, radius, tableArgs] = tableScatterSeries(tbl, thetaNames, radiusNames, nSeries);
end
%=============================================================================
function validateTableVariableCounts(thetaNames, radiusNames, nSeries)
  counts = [numel(thetaNames), numel(radiusNames)];
  if any(counts ~= 1 & counts ~= nSeries)
    error('Nelson:dimagree:tableVariableCountsMatch', 'Table variable counts must match.');
  end
end
%=============================================================================
function [theta, radius, tableArgs] = tableScatterSeries(tbl, thetaNames, radiusNames, nSeries)
  theta = [];
  radius = [];
  tableArgs = cell(1, nSeries);
  for k = 1:nSeries
    thetaName = graphicsSelectName(thetaNames, k);
    radiusName = graphicsSelectName(radiusNames, k);
    theta = graphicsAppendColumn(theta, graphicsNumericColumn(tbl.(thetaName), thetaName));
    radius = graphicsAppendColumn(radius, graphicsNumericColumn(tbl.(radiusName), radiusName));
    oneArgs = {'SourceTable', tbl, 'ThetaVariable', thetaName, 'RVariable', radiusName};
    if nSeries > 1
      oneArgs(end + 1:end + 2) = {'DisplayName', radiusName};
    end
    tableArgs{k} = oneArgs;
  end
end
%=============================================================================
function [orientation, nSeries] = getSeriesOrientation(theta, radius)
  if isvector(theta) && isvector(radius)
    orientation = 'single';
    nSeries = 1;
    return
  end
  if isvector(theta) && ~isvector(radius)
    if numel(theta) == size(radius, 1)
      orientation = 'columns';
      nSeries = size(radius, 2);
      return
    end
  end
  if ~isvector(theta) && isvector(radius)
    if numel(radius) == size(theta, 1)
      orientation = 'columns';
      nSeries = size(theta, 2);
      return
    end
  end
  if isequal(size(theta), size(radius))
    orientation = 'columns';
    nSeries = size(theta, 2);
    return
  end
  error('Nelson:dimagree:valueValueNumberElements', '%s and %s must have the same number of elements.', 'Theta', 'radius');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function print(varargin)
  nargoutchk(0, 0);

  fig = [];
  filename = '';
  device = '';
  resolution = '';

  for k = 1:nargin
    arg = varargin{k};
    if isStringScalar(arg) || (ischar(arg) && isrow(arg)) || isempty(arg)
      txt = localScalarText(arg);
      if startsWith(txt, '-d')
        device = lower(txt);
      elseif startsWith(txt, '-r')
        resolution = lower(txt);
      elseif startsWith(txt, '-')
        % other switches (e.g. '-loose', '-noui') are accepted and ignored.
      else
        filename = txt;
      end
    elseif isgraphics(arg, 'figure')
      fig = arg;
    elseif isnumeric(arg) && isscalar(arg) && isgraphics(arg, 'figure')
      fig = arg;
    else
      error('Nelson:print:invalidArgument', 'Unsupported argument for print.');
    end
  end

  if isempty(fig)
    fig = gcf();
  end
  if ~isgraphics(fig, 'figure')
    error('Nelson:print:expectedFigure', 'Expected figure graphics object.');
  end
  if isempty(filename)
    error('Nelson:print:filenameExpected', 'A filename is required to print to a file.');
  end

  % '-r<dpi>' is accepted for compatibility; the export resolution follows the
  % figure size and is not resampled.
  if ~isempty(resolution)
    dpi = resolution(3:end);
    if ~isempty(dpi) && isnan(str2double(dpi))
      error('Nelson:print:invalidResolution', 'Invalid resolution: %s', resolution);
    end
  end

  if isempty(device)
    saveas(fig, filename);
  else
    format = localDeviceToFormat(device);
    saveas(fig, filename, format);
  end
end
%=============================================================================
function txt = localScalarText(value)
  if isStringScalar(value)
    txt = char(value);
  elseif ischar(value)
    txt = value;
  else
    txt = '';
  end
end
%=============================================================================
function format = localDeviceToFormat(device)
  token = device(3:end);
  switch token
    case 'png'
      format = 'png';
    case {'jpeg', 'jpg'}
      format = 'jpg';
    case 'pdf'
      format = 'pdf';
    case 'svg'
      format = 'svg';
    case {'tiff', 'tiffn', 'tif'}
      format = 'tif';
    case {'bmp', 'bmpmono'}
      format = 'bmp';
    case 'gif'
      format = 'gif';
    case 'webp'
      format = 'webp';
    case 'pcx'
      format = 'pcx';
    case 'tga'
      format = 'tga';
    case {'pbm', 'pgm', 'ppm', 'pnm'}
      format = token;
    otherwise
      error('Nelson:print:unsupportedDevice', 'Unsupported device option: %s', device);
  end
end
