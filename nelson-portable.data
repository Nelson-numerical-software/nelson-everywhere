% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = nanstd(x, varargin)
  narginchk(1, 3);
  nargoutchk(0, 1);
  [flag, args] = parseNanstdInputsLocal(varargin);
  y = __nan_statistics__(x, 'std', flag, args{:});
end
%=============================================================================
function [flag, args] = parseNanstdInputsLocal(args)
  flag = 0;
  if isempty(args)
    return
  end
  flag = args{1};
  if isempty(flag)
    flag = 0;
  end
  if ~(isnumeric(flag) && isreal(flag) && isscalar(flag) && (flag == 0 || flag == 1))
    error('Nelson:statistics:invalidFlag', '%s must be 0 or 1.', 'Flag');
  end
  args = args(2:end);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = nansum(x, varargin)
  narginchk(1, inf);
  nargoutchk(0, 1);
  if nargin == 2 && isnumeric(varargin{1}) && ~isscalar(varargin{1})
    % Vector of dimensions: reduce along each one (sum is associative).
    x(isnan(x)) = 0;
    y = x;
    for d = unique(double(varargin{1}(:).'))
      y = sum(y, d);
    end
    return
  end
  y = sum(x, varargin{:}, 'omitnan');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = nanvar(x, varargin)
  narginchk(1, 3);
  nargoutchk(0, 1);
  [weights, args] = parseNanvarInputsLocal(varargin);
  y = __nan_statistics__(x, 'var', weights, args{:});
end
%=============================================================================
function [weights, args] = parseNanvarInputsLocal(args)
  weights = 0;
  if isempty(args)
    return
  end
  weights = args{1};
  if isempty(weights)
    weights = 0;
  end
  if ~(isnumeric(weights) && isreal(weights) && (isscalar(weights) || isvector(weights)))
    error('Nelson:statistics:weightsScalarVector', 'Weights must be a scalar or vector.');
  end
  if isscalar(weights) && ~(weights == 0 || weights == 1)
    error('Nelson:statistics:weights01NonnegativeVector', 'Weights must be 0, 1, or a nonnegative vector.');
  end
  if ~isscalar(weights) && any(weights < 0)
    error('Nelson:statistics:weights01NonnegativeVector', 'Weights must be 0, 1, or a nonnegative vector.');
  end
  args = args(2:end);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [W, H, D] = nnmf(A, k, varargin)
  narginchk(2, Inf);
  nargoutchk(0, 3);
  preserveSingle = isa(A, 'single');
  [A, k, opts] = parseInputsLocal(A, k, convertStringToCharArgs(varargin));
  [W, H, D] = factorizeLocal(A, k, opts);
  [W, H] = normalizeFactorsLocal(W, H);
  D = rmsResidualLocal(A, W, H);
  if preserveSingle
    W = single(W);
    H = single(H);
    D = single(D);
  end
end
%=============================================================================
function [A, k, opts] = parseInputsLocal(A, k, args)
  if ~(isnumeric(A) && isreal(A) && ~issparse(A) && ndims(A) == 2)
    error('Nelson:statistics:realNumericMatrix', '%s must be a real numeric matrix.', 'A');
  end
  A = double(A);
  if isempty(A) || any(~isfinite(A(:))) || any(A(:) < 0)
    error('Nelson:statistics:mustBeFiniteNonnegative', '%s must contain finite nonnegative values.', 'A');
  end
  if ~(isnumeric(k) && isreal(k) && isscalar(k) && isfinite(k) ...
      && floor(k) == k && k > 0)
    error('Nelson:statistics:kPositiveIntegerScalar', '%s must be a positive integer scalar.', 'k');
  end
  k = double(k);
  opts = defaultOptionsLocal();
  opts = parseNameValuesLocal(opts, args);
  opts.W0 = validateInitialLocal(opts.W0, [size(A, 1), k], 'W0');
  opts.H0 = validateInitialLocal(opts.H0, [k, size(A, 2)], 'H0');
  opts.Replicates = parseReplicatesLocal(opts.Replicates);
  opts.Options = parseOptionsLocal(opts.Options, opts.Algorithm);
end
%=============================================================================
function opts = defaultOptionsLocal()
  opts = struct('Algorithm', 'als', 'W0', [], 'H0', [], ...
    'Options', [], 'Replicates', 1);
end
%=============================================================================
function opts = parseNameValuesLocal(opts, args)
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  for i = 1:2:length(args)
    if ~isTextScalarLocal(args{i})
      error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Name');
    end
    name = lower(char(args{i}));
    switch name
      case 'algorithm'
        opts.Algorithm = parseAlgorithmLocal(args{i + 1});
      case 'w0'
        opts.W0 = args{i + 1};
      case 'h0'
        opts.H0 = args{i + 1};
      case 'options'
        opts.Options = args{i + 1};
      case 'replicates'
        opts.Replicates = args{i + 1};
      otherwise
        error('Nelson:statistics:unknownOption', 'Unknown option.');
    end
  end
end
%=============================================================================
function value = parseAlgorithmLocal(value)
  if ~isTextScalarLocal(value)
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Algorithm');
  end
  value = lower(char(value));
  choices = {'als', 'mult'};
  matches = choices(strncmp(choices, value, length(value)));
  if isempty(matches)
    error('Nelson:statistics:invalidAlgorithmValue', 'Invalid %s value.', 'Algorithm');
  end
  if length(matches) > 1
    error('Nelson:statistics:ambiguousValue', 'Ambiguous %s value.', 'Algorithm');
  end
  value = matches{1};
end
%=============================================================================
function X0 = validateInitialLocal(X0, expectedSize, name)
  if isempty(X0)
    return
  end
  if ~(isnumeric(X0) && isreal(X0) && ~issparse(X0) && ndims(X0) == 2)
    error('Nelson:statistics:realNumericMatrix', '%s must be a real numeric matrix.', name);
  end
  X0 = double(X0);
  if ~isequal(size(X0), expectedSize)
    error('Nelson:statistics:sizeMismatch', '%s has incompatible size.', name);
  end
  if any(~isfinite(X0(:))) || any(X0(:) < 0)
    error('Nelson:statistics:mustBeFiniteNonnegative', '%s must contain finite nonnegative values.', name);
  end
end
%=============================================================================
function replicates = parseReplicatesLocal(replicates)
  if ~(isnumeric(replicates) && isreal(replicates) && isscalar(replicates) ...
      && isfinite(replicates) && floor(replicates) == replicates && replicates > 0)
    error('Nelson:statistics:replicatesPositiveIntegerScalar', '%s must be a positive integer scalar.', 'Replicates');
  end
  replicates = double(replicates);
end
%=============================================================================
function options = parseOptionsLocal(options, algorithm)
  if isempty(options)
    options = statset();
  elseif ~(isstruct(options) && isscalar(options))
    error('Nelson:statistics:invalidOptions', '%s must be a scalar structure.', 'Options');
  end
  displayValue = statget(options, 'Display', 'off');
  if ~isTextScalarLocal(displayValue)
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Options Display');
  end
  options.Display = lower(char(displayValue));
  defaultMaxIter = 50;
  if strcmp(algorithm, 'mult')
    defaultMaxIter = 100;
  end
  options.MaxIter = statget(options, 'MaxIter', defaultMaxIter);
  options.TolFun = statget(options, 'TolFun', 1e-4);
  options.TolX = statget(options, 'TolX', 1e-4);
  if ~any(strcmp(options.Display, {'off', 'final', 'iter'}))
    error('Nelson:statistics:optionsDisplayInvalidValue', '%s has an invalid value.', 'Options Display');
  end
  if ~isPositiveIntegerLocal(options.MaxIter)
    error('Nelson:statistics:optionsMaxIterPositiveIntegerScalar', '%s must be a positive integer scalar.', 'Options MaxIter');
  end
  if ~isNonnegativeScalarLocal(options.TolFun) || ~isNonnegativeScalarLocal(options.TolX)
    error('Nelson:statistics:optionsTolerancesNonnegativeScalarValues', 'Options tolerances must be %s scalar values.', 'nonnegative');
  end
end
%=============================================================================
function [bestW, bestH, bestD] = factorizeLocal(A, k, opts)
  bestD = Inf;
  bestW = [];
  bestH = [];
  for rep = 1:opts.Replicates
    [W, H] = startFactorsLocal(A, k, opts, rep);
    [W, H, D, iterations, step] = iterateLocal(A, W, H, opts);
    if D < bestD
      bestD = D;
      bestW = W;
      bestH = H;
    end
    displayProgressLocal(opts.Options.Display, 'final', rep, iterations, D, step);
  end
end
%=============================================================================
function [W, H] = startFactorsLocal(A, k, opts, rep)
  useInitial = rep == 1 && (~isempty(opts.W0) || ~isempty(opts.H0));
  if useInitial && ~isempty(opts.W0)
    W = opts.W0;
  else
    W = max(rand(size(A, 1), k), eps);
  end
  if useInitial && ~isempty(opts.H0)
    H = opts.H0;
  else
    H = max(rand(k, size(A, 2)), eps);
  end
end
%=============================================================================
function [W, H, D, iterations, step] = iterateLocal(A, W, H, opts)
  D = rmsResidualLocal(A, W, H);
  step = Inf;
  for iterations = 1:opts.Options.MaxIter
    oldW = W;
    oldH = H;
    if strcmp(opts.Algorithm, 'mult')
      [W, H] = multStepLocal(A, W, H);
    else
      [W, H] = alsStepLocal(A, W, H);
    end
    Dnew = rmsResidualLocal(A, W, H);
    step = factorStepLocal(W, H, oldW, oldH);
    displayProgressLocal(opts.Options.Display, 'iter', 1, iterations, Dnew, step);
    if abs(D - Dnew) <= opts.Options.TolFun * max(1, D) || step <= opts.Options.TolX
      D = Dnew;
      break
    end
    D = Dnew;
  end
end
%=============================================================================
function [W, H] = multStepLocal(A, W, H)
  tiny = sqrt(realmin);
  H = H .* ((W' * A) ./ max(W' * W * H, tiny));
  W = W .* ((A * H') ./ max(W * (H * H'), tiny));
  W = max(W, tiny);
  H = max(H, tiny);
end
%=============================================================================
function [W, H] = alsStepLocal(A, W, H)
  tiny = sqrt(realmin);
  H = max((W' * W + tiny * eye(size(W, 2))) \ (W' * A), 0);
  W = max((A * H') / (H * H' + tiny * eye(size(H, 1))), 0);
  W = max(W, tiny);
  H = max(H, tiny);
end
%=============================================================================
function step = factorStepLocal(W, H, oldW, oldH)
  numerator = norm(W - oldW, 'fro') + norm(H - oldH, 'fro');
  denominator = max(1, norm(oldW, 'fro') + norm(oldH, 'fro'));
  step = numerator / denominator;
end
%=============================================================================
function D = rmsResidualLocal(A, W, H)
  D = norm(A - W * H, 'fro') / sqrt(numel(A));
end
%=============================================================================
function [W, H] = normalizeFactorsLocal(W, H)
  scale = sqrt(sum(H .^ 2, 2));
  scale(scale <= 0) = 1;
  W = W .* repmat(scale(:)', size(W, 1), 1);
  H = H ./ repmat(scale(:), 1, size(H, 2));
  columnLength = sqrt(sum(W .^ 2, 1));
  [~, order] = sort(columnLength, 'descend');
  W = W(:, order);
  H = H(order, :);
end
%=============================================================================
function displayProgressLocal(displayValue, stage, rep, iterations, D, step)
  if strcmp(displayValue, 'iter') && strcmp(stage, 'iter')
    disp([int2str(iterations), ' iterations, rms resid = ', num2str(D), ...
      ' |delta x| = ', num2str(step)]);
  elseif strcmp(displayValue, 'final') && strcmp(stage, 'final')
    disp(['rep ', int2str(rep), ', ', int2str(iterations), ...
      ' iterations, Final root mean square residual = ', num2str(D)]);
  end
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || isStringScalar(value);
end
%=============================================================================
function tf = isPositiveIntegerLocal(value)
  tf = isnumeric(value) && isreal(value) && isscalar(value) ...
    && isfinite(value) && floor(value) == value && value > 0;
end
%=============================================================================
function tf = isNonnegativeScalarLocal(value)
  tf = isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) && value >= 0;
end
%=============================================================================

%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = normpdf(varargin)
  % Normal probability density function
  narginchk(1, 3);
  nargoutchk(0, 1);

  x = varargin{1};
  mu = 0;
  sigma = 1;

  if nargin > 1
    mu = varargin{2};
  end
  if nargin > 2
    sigma = varargin{3};
  end
  sigma(sigma <= 0) = NaN;
  try
    z = (x - mu) ./ sigma;
    varargout{1} = exp(-0.5 * z .^ 2) ./ (sqrt(2 * pi) .* sigma);
  catch
    error('Nelson:dimagree:sizeMismatchInputArguments', 'Size mismatch on input arguments')
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [rho, pval] = partialcorr(x, varargin)
  narginchk(1, Inf);
  nargoutchk(0, 2);
  [y, z, mode, opts] = parseInputsLocal(x, convertStringToCharArgs(varargin));
  [x, y, z] = validateInputsLocal(x, y, z);
  if strcmp(opts.Type, 'spearman')
    x = rankColumnsLocal(x);
    y = rankColumnsLocal(y);
    z = rankColumnsLocal(z);
  end
  if strcmp(opts.Rows, 'complete')
    [x, y, z] = completeRowsLocal(x, y, z);
  end
  switch mode
    case 'self'
      [rho, n, controls] = partialSelfLocal(x, opts.Rows);
    case 'controlled'
      [rho, n, controls] = partialMatrixLocal(x, x, z, opts.Rows);
    otherwise
      [rho, n, controls] = partialMatrixLocal(x, y, z, opts.Rows);
  end
  pval = pvalueLocal(rho, n, controls, opts.Tail);
end
%=============================================================================
function [y, z, mode, opts] = parseInputsLocal(x, args)
  opts = struct('Type', 'pearson', 'Rows', 'all', 'Tail', 'both');
  y = [];
  z = [];
  mode = 'self';
  dataArgs = {};
  while ~isempty(args) && ~isTextScalarLocal(args{1}) && length(dataArgs) < 2
    dataArgs{end + 1} = args{1};
    args = args(2:end);
  end
  if length(dataArgs) == 1
    z = dataArgs{1};
    mode = 'controlled';
  elseif length(dataArgs) == 2
    y = dataArgs{1};
    z = dataArgs{2};
    mode = 'cross';
  end
  if isempty(y)
    y = x;
  end
  if isempty(z)
    z = zeros(size(x, 1), 0);
  end
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  for k = 1:2:length(args)
    if ~isTextScalarLocal(args{k})
      error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Name');
    end
    name = lower(char(args{k}));
    switch name
      case 'type'
        opts.Type = parseChoiceLocal(args{k + 1}, {'pearson', 'spearman'}, 'TYPE');
      case 'rows'
        opts.Rows = parseChoiceLocal(args{k + 1}, {'all', 'complete', 'pairwise'}, 'ROWS');
      case 'tail'
        opts.Tail = parseChoiceLocal(args{k + 1}, {'both', 'right', 'left'}, 'TAIL');
      otherwise
        error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
    end
  end
end
%=============================================================================
function [x, y, z] = validateInputsLocal(x, y, z)
  if ~(isnumeric(x) && isreal(x) && ~issparse(x) && ismatrix(x))
    error('Nelson:statistics:xRealNumericMatrix', '%s must be a real numeric matrix.', 'X');
  end
  if ~(isnumeric(y) && isreal(y) && ~issparse(y) && ismatrix(y))
    error('Nelson:statistics:yRealNumericMatrix', '%s must be a real numeric matrix.', 'Y');
  end
  if ~(isnumeric(z) && isreal(z) && ~issparse(z) && ismatrix(z))
    error('Nelson:statistics:zRealNumericMatrix', '%s must be a real numeric matrix.', 'Z');
  end
  if size(x, 1) ~= size(y, 1) || size(x, 1) ~= size(z, 1)
    error('Nelson:statistics:xYZSameNumber', '%s must have the same number of rows.', 'X, Y, and Z');
  end
  x = double(x);
  y = double(y);
  z = double(z);
end
%=============================================================================
function [x, y, z] = completeRowsLocal(x, y, z)
  keep = all(~isnan(x), 2) & all(~isnan(y), 2) & all(~isnan(z), 2);
  x = x(keep, :);
  y = y(keep, :);
  z = z(keep, :);
end
%=============================================================================
function R = rankColumnsLocal(X)
  R = NaN(size(X));
  for k = 1:size(X, 2)
    R(:, k) = tiedrank(X(:, k));
  end
end
%=============================================================================
function [rho, n, controls] = partialSelfLocal(x, rowsMode)
  p = size(x, 2);
  rho = eye(p);
  n = zeros(p, p);
  controls = zeros(p, p);
  for i = 1:p
    for j = i + 1:p
      controlColumns = setdiff(1:p, [i j], 'stable');
      [r, count, k] = partialPairLocal(x(:, i), x(:, j), x(:, controlColumns), rowsMode);
      rho(i, j) = r;
      rho(j, i) = r;
      n(i, j) = count;
      n(j, i) = count;
      controls(i, j) = k;
      controls(j, i) = k;
    end
    n(i, i) = size(x, 1);
    controls(i, i) = max(0, p - 1);
  end
end
%=============================================================================
function [rho, n, controls] = partialMatrixLocal(x, y, z, rowsMode)
  px = size(x, 2);
  py = size(y, 2);
  rho = NaN(px, py);
  n = zeros(px, py);
  controls = size(z, 2) * ones(px, py);
  for i = 1:px
    for j = 1:py
      [rho(i, j), n(i, j), controls(i, j)] = partialPairLocal(x(:, i), y(:, j), z, rowsMode);
    end
  end
end
%=============================================================================
function [r, n, k] = partialPairLocal(x, y, z, rowsMode)
  keep = rowsToUseLocal(x, y, z, rowsMode);
  x = x(keep);
  y = y(keep);
  z = z(keep, :);
  n = length(x);
  k = size(z, 2);
  if n <= k + 1 || any(isnan(x)) || any(isnan(y)) || any(isnan(z(:)))
    r = NaN;
    return
  end
  rx = residualLocal(x, z);
  ry = residualLocal(y, z);
  r = corr(rx, ry);
  r = clampCorrelationLocal(r);
end
%=============================================================================
function keep = rowsToUseLocal(x, y, z, rowsMode)
  switch rowsMode
    case 'all'
      keep = true(size(x));
    otherwise
      keep = ~isnan(x) & ~isnan(y) & all(~isnan(z), 2);
  end
end
%=============================================================================
function r = residualLocal(x, z)
  if isempty(z)
    r = x;
    return
  end
  design = [ones(size(z, 1), 1), z];
  r = x - design * (design \ x);
end
%=============================================================================
function r = clampCorrelationLocal(r)
  tol = 10 * eps;
  if r > 1 && r <= 1 + tol
    r = 1;
  elseif r < -1 && r >= -1 - tol
    r = -1;
  end
end
%=============================================================================
function p = pvalueLocal(r, n, controls, tail)
  p = NaN(size(r));
  df = n - controls - 2;
  valid = ~isnan(r) & df > 0 & abs(r) < 1;
  t = r(valid) .* sqrt(df(valid) ./ max(1 - r(valid) .^ 2, 0));
  p(valid) = tailProbabilityFromTLocal(t, df(valid), tail);
  perfect = ~isnan(r) & df > 0 & abs(r) == 1;
  if any(perfect(:))
    p(perfect) = perfectCorrelationPValueLocal(r(perfect), tail);
  end
end
%=============================================================================
function p = tailProbabilityFromTLocal(t, v, tail)
  switch tail
    case 'right'
      p = 1 - tcdf(t, v);
    case 'left'
      p = tcdf(t, v);
    otherwise
      p = 2 * min(tcdf(t, v), 1 - tcdf(t, v));
  end
end
%=============================================================================
function p = perfectCorrelationPValueLocal(r, tail)
  p = zeros(size(r));
  switch tail
    case 'right'
      p(r < 0) = 1;
    case 'left'
      p(r > 0) = 1;
  end
end
%=============================================================================
function value = parseChoiceLocal(value, choices, name)
  if ~isTextScalarLocal(value)
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', name);
  end
  text = lower(char(value));
  matches = choices(startsWith(choices, text));
  if length(matches) ~= 1
    error('Nelson:statistics:invalidValue:valueHasUnsupportedValue', '%s has an unsupported value.', name);
  end
  value = matches{1};
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [rho, pval] = partialcorri(y, x, varargin)
  narginchk(2, Inf);
  nargoutchk(0, 2);
  [z, args] = parseInputsLocal(y, x, convertStringToCharArgs(varargin));
  [y, x, z] = validateInputsLocal(y, x, z);
  rho = NaN(size(y, 2), size(x, 2));
  pval = NaN(size(y, 2), size(x, 2));
  for k = 1:size(x, 2)
    controls = [x(:, setdiff(1:size(x, 2), k, 'stable')), z];
    [rk, pk] = partialcorr(y, x(:, k), controls, args{:});
    rho(:, k) = rk;
    pval(:, k) = pk;
  end
end
%=============================================================================
function [z, args] = parseInputsLocal(y, x, args)
  z = zeros(size(y, 1), 0);
  if ~isempty(args) && ~isTextScalarLocal(args{1})
    z = args{1};
    args = args(2:end);
  end
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  for k = 1:2:length(args)
    if ~isTextScalarLocal(args{k})
      error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Name');
    end
    name = lower(char(args{k}));
    switch name
      case {'type', 'rows', 'tail'}
      otherwise
        error('Nelson:statistics:unknownNameValue', 'Invalid name-value argument name.');
    end
  end
end
%=============================================================================
function [y, x, z] = validateInputsLocal(y, x, z)
  if ~(isnumeric(y) && isreal(y) && ismatrix(y) && ~issparse(y))
    error('Nelson:statistics:yRealNumericMatrix', '%s must be a real numeric matrix.', 'Y');
  end
  if ~(isnumeric(x) && isreal(x) && ismatrix(x) && ~issparse(x))
    error('Nelson:statistics:xRealNumericMatrix', '%s must be a real numeric matrix.', 'X');
  end
  if ~(isnumeric(z) && isreal(z) && ismatrix(z) && ~issparse(z))
    error('Nelson:statistics:zRealNumericMatrix', '%s must be a real numeric matrix.', 'Z');
  end
  if size(y, 1) ~= size(x, 1) || size(y, 1) ~= size(z, 1)
    error('Nelson:statistics:xYZSameNumber', '%s must have the same number of rows.', 'Y, X, and Z');
  end
  y = double(y);
  x = double(x);
  z = double(z);
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [coeff, score, latent, tsquared, explained, mu] = pca(X, varargin)
  narginchk(1, Inf);
  nargoutchk(0, 6);
  X = validateDataLocal(X);
  opts = parseOptionsLocal(convertStringToCharArgs(varargin), size(X, 2));
  [workX, rowMask, mu, rowWeights] = prepareRowsLocal(X, opts);
  [workX, variableScale] = applyVariableWeightsLocal(workX, opts);
  if strcmp(opts.Algorithm, 'eig') || strcmp(opts.Rows, 'pairwise')
    [coeff, latent] = pcaEigLocal(workX, opts.Centered, opts.Rows);
  else
    [coeff, latent] = pcaSvdLocal(workX, opts.Centered, rowWeights, opts.Economy);
  end
  coeff = coeff ./ repmat(variableScale(:), 1, size(coeff, 2));
  coeff = normalizeColumnsLocal(coeff);
  coeff = orientColumnsLocal(coeff);
  [coeff, latent] = selectComponentsLocal(coeff, latent, opts.NumComponents);
  score = scoreLocal(X, coeff, mu, rowMask, opts.Centered);
  tsquared = tsquaredLocal(score, latent);
  explained = explainedLocal(latent);
end
%=============================================================================
function X = validateDataLocal(X)
  if ~(isnumeric(X) && isreal(X) && ~issparse(X) && ndims(X) == 2)
    error('Nelson:statistics:xRealNumericMatrix', '%s must be a real numeric matrix.', 'X');
  end
  X = double(X);
  if isempty(X) || size(X, 2) == 0
    error('Nelson:statistics:xLeastOneVariable', 'X must have at least one variable.');
  end
end
%=============================================================================
function opts = parseOptionsLocal(args, nvars)
  opts = struct('Algorithm', 'svd', 'Centered', true, 'Economy', true, ...
    'NumComponents', [], 'Rows', 'complete', 'Weights', [], ...
    'VariableWeights', []);
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  for k = 1:2:length(args)
    name = lower(char(args{k}));
    value = args{k + 1};
    switch name
      case 'algorithm'
        opts.Algorithm = parseChoiceLocal(value, {'svd', 'eig', 'als'}, 'Algorithm');
      case 'centered'
        opts.Centered = parseLogicalScalarLocal(value, 'Centered');
      case 'economy'
        opts.Economy = parseLogicalScalarLocal(value, 'Economy');
      case 'numcomponents'
        opts.NumComponents = parseNumComponentsLocal(value, nvars);
      case 'rows'
        opts.Rows = parseChoiceLocal(value, {'complete', 'all', 'pairwise'}, 'Rows');
      case 'weights'
        opts.Weights = parseWeightsLocal(value);
      case 'variableweights'
        opts.VariableWeights = value;
      otherwise
        error('Nelson:statistics:unknownOption', 'Unknown option.');
    end
  end
  if strcmp(opts.Algorithm, 'als')
    error('Nelson:statistics:unsupportedAlgorithm', 'Unsupported %s.', 'algorithm');
  end
end
%=============================================================================
function value = parseChoiceLocal(value, choices, name)
  if ~(ischar(value) || (isstring(value) && isscalar(value)))
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', name);
  end
  value = lower(char(value));
  if ~any(strcmp(value, choices))
    error('Nelson:statistics:invalidValue:valueHasUnsupportedValue', '%s has an unsupported value.', name);
  end
end
%=============================================================================
function value = parseLogicalScalarLocal(value, name)
  if islogical(value) && isscalar(value)
    value = value ~= 0;
  elseif isnumeric(value) && isscalar(value) && (value == 0 || value == 1)
    value = value ~= 0;
  else
    error('Nelson:validators:mustBeLogicalScalar', '%s must be a logical scalar.', name);
  end
end
%=============================================================================
function value = parseNumComponentsLocal(value, nvars)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) ...
      && value >= 0 && floor(value) == value && value <= nvars)
    error('Nelson:statistics:numComponentsIntegerScalarBetween0', 'NumComponents must be an integer scalar between 0 and the number of variables.');
  end
  value = double(value);
end
%=============================================================================
function weights = parseWeightsLocal(value)
  if ~(isnumeric(value) && isreal(value) && isvector(value) && ~isempty(value))
    error('Nelson:statistics:weightsRealNumericVector', '%s must be a real numeric vector.', 'Weights');
  end
  weights = double(value(:));
  if any(~isfinite(weights)) || any(weights < 0) || sum(weights) <= 0
    error('Nelson:statistics:weightsContainNonnegativeFiniteValues:valueContainNonnegativeFiniteValuesPositive', '%s must contain nonnegative finite values with positive sum.', 'Weights');
  end
end
%=============================================================================
function [workX, rowMask, mu, rowWeights] = prepareRowsLocal(X, opts)
  rowMask = true(size(X, 1), 1);
  if strcmp(opts.Rows, 'all') && any(isnan(X(:)))
    error('Nelson:statistics:rawDataContainsNaNWhile', 'Raw data contains NaN while Rows is all.');
  elseif strcmp(opts.Rows, 'complete')
    rowMask = ~any(isnan(X), 2);
  elseif strcmp(opts.Rows, 'pairwise')
    if ~isempty(opts.Weights)
      error('Nelson:statistics:weightsSupportedPairwiseRows', 'Weights are not supported with pairwise rows.');
    end
    rowMask = ~any(isnan(X), 2);
    workX = X;
    mu = meanOmitNaNLocal(X, opts.Centered);
    rowWeights = [];
    return
  end
  workX = X(rowMask, :);
  if isempty(workX)
    error('Nelson:statistics:xContainLeastOneComplete', 'X must contain at least one complete row.');
  end
  rowWeights = [];
  if ~isempty(opts.Weights)
    if length(opts.Weights) ~= size(X, 1)
      error('Nelson:statistics:weightsOneValueObservation', '%s must have one value per observation.', 'Weights');
    end
    rowWeights = opts.Weights(rowMask);
  end
  mu = meanLocal(workX, rowWeights, opts.Centered);
  if opts.Centered
    workX = workX - mu;
  end
end
%=============================================================================
function mu = meanOmitNaNLocal(X, centered)
  if ~centered
    mu = zeros(1, size(X, 2));
    return
  end
  mu = zeros(1, size(X, 2));
  for k = 1:size(X, 2)
    column = X(:, k);
    column = column(isfinite(column));
    if isempty(column)
      error('Nelson:statistics:variableContainLeastOneFinite', '%s must contain at least one finite value.', 'Each variable');
    end
    mu(k) = mean(column);
  end
end
%=============================================================================
function mu = meanLocal(X, weights, centered)
  if ~centered
    mu = zeros(1, size(X, 2));
  elseif isempty(weights)
    mu = mean(X, 1);
  else
    weights = weights(:) / sum(weights);
    mu = weights' * X;
  end
end
%=============================================================================
function [X, scale] = applyVariableWeightsLocal(X, opts)
  scale = ones(1, size(X, 2));
  value = opts.VariableWeights;
  if isempty(value)
    return
  end
  if ischar(value) || (isstring(value) && isscalar(value))
    if ~strcmpi(char(value), 'variance')
      error('Nelson:statistics:unsupportedVariableWeights', 'Unsupported %s.', 'variable weights');
    end
    scale = std(X, 0, 1);
  else
    if ~(isnumeric(value) && isreal(value) && isvector(value) && length(value) == size(X, 2))
      error('Nelson:statistics:variableWeightsMatchNumberVariables', 'VariableWeights must match the number of variables.');
    end
    scale = 1 ./ sqrt(double(value(:))');
  end
  scale(~isfinite(scale) | scale <= 0) = 1;
  X = X ./ repmat(scale, size(X, 1), 1);
end
%=============================================================================
function [coeff, latent] = pcaSvdLocal(X, centered, weights, economy)
  if ~isempty(weights)
    X = X .* sqrt(weights(:) / mean(weights));
  end
  if size(X, 2) > size(X, 1) || ~economy
    [coeff, latent] = pcaEigLocal(X, centered, 'complete');
    if economy
      [coeff, latent] = truncateEconomyLocal(coeff, latent, size(X, 1), centered, economy);
    end
    return
  end
  if economy
    [~, S, coeff] = svd(X, 'econ');
  else
    [~, S, coeff] = svd(X);
  end
  s = diag(S);
  denom = max(size(X, 1) - double(centered), 1);
  latent = (s .^ 2) / denom;
  [coeff, latent] = truncateEconomyLocal(coeff, latent, size(X, 1), centered, economy);
end
%=============================================================================
function [coeff, latent] = truncateEconomyLocal(coeff, latent, nobs, centered, economy)
  if ~economy
    if length(latent) < size(coeff, 2)
      latent = [latent; zeros(size(coeff, 2) - length(latent), 1)];
    end
    return
  end
  ncomp = min(size(coeff, 2), max(nobs - double(centered), 0));
  coeff = coeff(:, 1:ncomp);
  latent = latent(1:ncomp);
end
%=============================================================================
function [coeff, latent] = pcaEigLocal(X, centered, rowsMode)
  if strcmp(rowsMode, 'pairwise')
    C = pairwiseCovLocal(X, centered);
  else
    denom = max(size(X, 1) - double(centered), 1);
    C = (X' * X) / denom;
  end
  [V, D] = eig((C + C') / 2);
  latent = real(diag(D));
  [latent, order] = sort(latent, 'descend');
  coeff = real(V(:, order));
  latent(latent < 0 & latent > -sqrt(eps)) = 0;
end
%=============================================================================
function C = pairwiseCovLocal(X, centered)
  nvars = size(X, 2);
  C = zeros(nvars, nvars);
  for i = 1:nvars
    for j = i:nvars
      keep = isfinite(X(:, i)) & isfinite(X(:, j));
      xi = X(keep, i);
      xj = X(keep, j);
      if centered
        xi = xi - mean(xi);
        xj = xj - mean(xj);
      end
      denom = max(length(xi) - double(centered), 1);
      C(i, j) = (xi' * xj) / denom;
      C(j, i) = C(i, j);
    end
  end
end
%=============================================================================
function coeff = normalizeColumnsLocal(coeff)
  for k = 1:size(coeff, 2)
    n = norm(coeff(:, k));
    if n > 0
      coeff(:, k) = coeff(:, k) / n;
    end
  end
end
%=============================================================================
function coeff = orientColumnsLocal(coeff)
  for k = 1:size(coeff, 2)
    [~, idx] = max(abs(coeff(:, k)));
    if coeff(idx, k) < 0
      coeff(:, k) = -coeff(:, k);
    end
  end
end
%=============================================================================
function [coeff, latent] = selectComponentsLocal(coeff, latent, numComponents)
  if isempty(numComponents)
    return
  end
  coeff = coeff(:, 1:numComponents);
  latent = latent(1:numComponents);
end
%=============================================================================
function score = scoreLocal(X, coeff, mu, rowMask, centered)
  score = NaN(size(X, 1), size(coeff, 2));
  complete = rowMask;
  Xwork = X(complete, :);
  if centered
    Xwork = Xwork - mu;
  end
  score(complete, :) = Xwork * coeff;
end
%=============================================================================
function tsquared = tsquaredLocal(score, latent)
  tsquared = NaN(size(score, 1), 1);
  if isempty(latent)
    tsquared(:) = 0;
    return
  end
  usable = latent(:)' > eps(max(latent));
  if ~any(usable)
    tsquared(~any(isnan(score), 2)) = 0;
    return
  end
  usableLatent = latent(usable)';
  for k = 1:size(score, 1)
    row = score(k, usable);
    if ~any(isnan(row))
      tsquared(k) = sum((row .^ 2) ./ usableLatent);
    end
  end
end
%=============================================================================
function explained = explainedLocal(latent)
  total = sum(latent);
  if total > 0
    explained = 100 * latent(:) / total;
  else
    explained = zeros(size(latent(:)));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [coeff, latent, explained] = pcacov(V)
  narginchk(1, 1);
  nargoutchk(0, 3);
  preserveSingle = isa(V, 'single');
  V = validateCovarianceLocal(V);
  if isempty(V)
    coeff = zeros(0, 0);
    latent = zeros(0, 1);
    explained = zeros(0, 1);
    return
  end
  [coeff, latent] = decomposeLocal(V);
  explained = explainedLocal(latent);
  if preserveSingle
    coeff = single(coeff);
    latent = single(latent);
    explained = single(explained);
  end
end
%=============================================================================
function V = validateCovarianceLocal(V)
  if ~(isnumeric(V) && isreal(V) && ~issparse(V) && ndims(V) == 2)
    error('Nelson:statistics:vRealNumericMatrix', '%s must be a real numeric matrix.', 'V');
  end
  if size(V, 1) ~= size(V, 2)
    error('Nelson:statistics:vSquareMatrix', '%s must be a square matrix.', 'V');
  end
  V = double(V);
  if any(~isfinite(V(:)))
    error('Nelson:statistics:vContainFiniteValues', '%s must contain finite values.', 'V');
  end
  if isempty(V)
    return
  end
  tolerance = 100 * eps(max(1, max(abs(V(:)))));
  if any(any(abs(V - V') > tolerance))
    error('Nelson:statistics:vSymmetric', '%s must be symmetric.', 'V');
  end
  V = (V + V') / 2;
end
%=============================================================================
function [coeff, latent] = decomposeLocal(V)
  [coeff, D] = eig(V);
  latent = real(diag(D));
  [latent, order] = sort(latent, 'descend');
  coeff = real(coeff(:, order));
  tolerance = 100 * eps(max(1, max(abs(latent))));
  if any(latent < -tolerance)
    error('Nelson:statistics:vPositiveSemidefinite', 'V must be positive semidefinite.');
  end
  latent(latent < 0) = 0;
  coeff = orientColumnsLocal(coeff);
end
%=============================================================================
function coeff = orientColumnsLocal(coeff)
  for k = 1:size(coeff, 2)
    [~, idx] = max(abs(coeff(:, k)));
    if coeff(idx, k) < 0
      coeff(:, k) = -coeff(:, k);
    end
  end
end
%=============================================================================
function explained = explainedLocal(latent)
  total = sum(latent);
  if total > 0
    explained = 100 * latent(:) / total;
  else
    explained = zeros(size(latent(:)));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [residuals, reconstructed] = pcares(X, NumComponents)
  narginchk(2, 2);
  nargoutchk(0, 2);
  preserveSingle = isa(X, 'single');
  X = validateDataLocal(X);
  NumComponents = validateNumComponentsLocal(NumComponents, size(X, 2));
  if NumComponents == 0
    mu = mean(X, 1);
    reconstructed = repmat(mu, size(X, 1), 1);
  else
    [coeff, score, ~, ~, ~, mu] = pca(X, 'NumComponents', NumComponents);
    reconstructed = score * coeff' + repmat(mu, size(X, 1), 1);
  end
  residuals = X - reconstructed;
  if preserveSingle
    residuals = single(residuals);
    reconstructed = single(reconstructed);
  end
end
%=============================================================================
function X = validateDataLocal(X)
  if ~(isnumeric(X) && isreal(X) && ~issparse(X) && ndims(X) == 2)
    error('Nelson:statistics:xRealNumericMatrix', '%s must be a real numeric matrix.', 'X');
  end
  if isempty(X) || size(X, 2) == 0
    error('Nelson:statistics:xLeastOneVariable', 'X must have at least one variable.');
  end
  X = double(X);
  if any(isnan(X(:)))
    error('Nelson:statistics:xContainNaNValues', 'X must not contain NaN values.');
  end
end
%=============================================================================
function value = validateNumComponentsLocal(value, nvars)
  if ~(isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) ...
      && value >= 0 && floor(value) == value && value <= nvars)
    error('Nelson:statistics:numComponentsIntegerScalarBetween0', 'NumComponents must be an integer scalar between 0 and the number of variables.');
  end
  value = double(value);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [coeff, score, pcvar, mu, v, S] = ppca(Y, K, varargin)
  narginchk(2, Inf);
  nargoutchk(0, 6);
  preserveSingle = isa(Y, 'single');
  [Y, K, opts] = parseInputsLocal(Y, K, convertStringToCharArgs(varargin));
  [coeff, score, pcvar, mu, v, S] = fitLocal(Y, K, opts);
  if preserveSingle
    coeff = single(coeff);
    score = single(score);
    pcvar = single(pcvar);
    mu = single(mu);
    v = single(v);
    S.W = single(S.W);
    S.Xexp = single(S.Xexp);
    S.Recon = single(S.Recon);
    S.v = single(S.v);
    S.RMSResid = single(S.RMSResid);
    S.nloglk = single(S.nloglk);
  end
end
%=============================================================================
function [Y, K, opts] = parseInputsLocal(Y, K, args)
  if ~(isnumeric(Y) && isreal(Y) && ~issparse(Y) && ndims(Y) == 2)
    error('Nelson:statistics:yRealNumericMatrix', '%s must be a real numeric matrix.', 'Y');
  end
  Y = double(Y);
  if isempty(Y) || size(Y, 1) < 2 || size(Y, 2) < 2
    error('Nelson:statistics:yContainLeastTwoObservations', 'Y must contain at least two observations and two variables.');
  end
  if any(isinf(Y(:)))
    error('Nelson:statistics:yContainInfValues', '%s must not contain Inf values.', 'Y');
  end
  maxK = min(size(Y, 1), size(Y, 2)) - 1;
  if ~(isnumeric(K) && isreal(K) && isscalar(K) && isfinite(K) ...
      && floor(K) == K && K > 0)
    error('Nelson:statistics:kPositiveIntegerScalar', '%s must be a positive integer scalar.', 'K');
  end
  K = min(double(K), maxK);
  if K < 1
    error('Nelson:statistics:kSmallerMaximumPossibleRank', 'K must be smaller than the maximum possible rank.');
  end
  opts = defaultOptionsLocal();
  opts = parseNameValuesLocal(opts, args);
  opts.W0 = validateW0Local(opts.W0, size(Y, 2), K);
  opts.v0 = validateV0Local(opts.v0);
  opts.Options = parseOptionsLocal(opts.Options);
end
%=============================================================================
function opts = defaultOptionsLocal()
  opts = struct('W0', [], 'v0', [], 'Options', []);
end
%=============================================================================
function opts = parseNameValuesLocal(opts, args)
  if rem(length(args), 2) ~= 0
    error('Nelson:statistics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  for k = 1:2:length(args)
    if ~isTextScalarLocal(args{k})
      error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Name');
    end
    name = lower(char(args{k}));
    switch name
      case 'w0'
        opts.W0 = args{k + 1};
      case 'v0'
        opts.v0 = args{k + 1};
      case 'options'
        opts.Options = args{k + 1};
      otherwise
        error('Nelson:statistics:unknownOption', 'Unknown option.');
    end
  end
end
%=============================================================================
function W0 = validateW0Local(W0, nvars, K)
  if isempty(W0)
    return
  end
  if ~(isnumeric(W0) && isreal(W0) && ~issparse(W0) && ndims(W0) == 2)
    error('Nelson:statistics:W0RealNumericMatrix', '%s must be a real numeric matrix.', 'W0');
  end
  W0 = double(W0);
  if size(W0, 1) ~= nvars || size(W0, 2) < K
    error('Nelson:statistics:W0IncompatibleSize', '%s has incompatible size.', 'W0');
  end
  if any(~isfinite(W0(:)))
    error('Nelson:statistics:W0ContainFiniteValues', '%s must contain finite values.', 'W0');
  end
  W0 = W0(:, 1:K);
end
%=============================================================================
function v0 = validateV0Local(v0)
  if isempty(v0)
    return
  end
  if ~(isnumeric(v0) && isreal(v0) && isscalar(v0) && isfinite(v0) && v0 > 0)
    error('Nelson:statistics:v0PositiveScalar', '%s must be a positive scalar.', 'v0');
  end
  v0 = double(v0);
end
%=============================================================================
function options = parseOptionsLocal(options)
  if isempty(options)
    options = statset();
  elseif ~(isstruct(options) && isscalar(options))
    error('Nelson:statistics:invalidOptions', '%s must be a scalar structure.', 'Options');
  end
  displayValue = statget(options, 'Display', 'off');
  if ~isTextScalarLocal(displayValue)
    error('Nelson:validators:mustBeTextScalar', '%s must be a character vector or string scalar.', 'Options Display');
  end
  options.Display = lower(char(displayValue));
  options.MaxIter = statget(options, 'MaxIter', 1000);
  options.TolFun = statget(options, 'TolFun', 1e-6);
  options.TolX = statget(options, 'TolX', 1e-6);
  if ~any(strcmp(options.Display, {'off', 'final', 'iter'}))
    error('Nelson:statistics:optionsDisplayInvalidValue', '%s has an invalid value.', 'Options Display');
  end
  if ~isPositiveIntegerLocal(options.MaxIter)
    error('Nelson:statistics:optionsMaxIterPositiveIntegerScalar', '%s must be a positive integer scalar.', 'Options MaxIter');
  end
  if ~isPositiveScalarLocal(options.TolFun) || ~isPositiveScalarLocal(options.TolX)
    error('Nelson:statistics:optionsTolerancesPositiveScalarValues', 'Options tolerances must be %s scalar values.', 'positive');
  end
end
%=============================================================================
function [coeff, score, pcvar, mu, v, S] = fitLocal(Y, K, opts)
  missing = isnan(Y);
  mu = meanOmitNaNLocal(Y);
  Xfilled = initialFilledLocal(Y, mu, missing, opts.W0);
  previousCost = Inf;
  step = Inf;
  for iter = 1:opts.Options.MaxIter
    [coeff, score, pcvar] = pcaComponentsLocal(Xfilled, K);
    recon = score * coeff' + repmat(mean(Xfilled, 1), size(Y, 1), 1);
    Xnew = Xfilled;
    if any(missing(:))
      Xnew(missing) = recon(missing);
    end
    cost = observedRMSLocal(Y, recon, missing);
    step = max(abs(Xnew(:) - Xfilled(:))) / max(1, max(abs(Xfilled(:))));
    displayProgressLocal(opts.Options.Display, 'iter', iter, cost, step);
    Xfilled = Xnew;
    if abs(previousCost - cost) <= opts.Options.TolFun * max(1, previousCost) ...
        || step <= opts.Options.TolX
      previousCost = cost;
      break
    end
    previousCost = cost;
  end
  [coeff, score, pcvar, mu] = finalComponentsLocal(Xfilled, Y, K);
  recon = score * coeff' + repmat(mu, size(Y, 1), 1);
  v = residualVarianceLocal(Y, recon, missing, opts.v0);
  S = convergenceStructLocal(coeff, score, pcvar, recon, v, previousCost, iter);
  displayProgressLocal(opts.Options.Display, 'final', iter, previousCost, step);
end
%=============================================================================
function mu = meanOmitNaNLocal(Y)
  mu = zeros(1, size(Y, 2));
  for j = 1:size(Y, 2)
    values = Y(~isnan(Y(:, j)), j);
    if isempty(values)
      error('Nelson:statistics:variableContainLeastOneObserved', 'Each variable must contain at least one observed value.');
    end
    mu(j) = mean(values);
  end
end
%=============================================================================
function Xfilled = initialFilledLocal(Y, mu, missing, W0)
  Xfilled = Y;
  if ~any(missing(:))
    return
  end
  Xfilled(missing) = 0;
  for j = 1:size(Y, 2)
    if any(missing(:, j))
      Xfilled(missing(:, j), j) = mu(j);
    end
  end
  if ~isempty(W0)
    [U, ~, ~] = svd(W0, 'econ');
    coeff = U(:, 1:size(W0, 2));
    score = (Xfilled - repmat(mu, size(Y, 1), 1)) * coeff;
    startRecon = score * coeff' + repmat(mu, size(Y, 1), 1);
    if any(missing(:))
      Xfilled(missing) = startRecon(missing);
    end
  end
end
%=============================================================================
function [coeff, score, pcvar, mu] = finalComponentsLocal(Xfilled, Y, K)
  mu = mean(Xfilled, 1);
  mu = mu(:)';
  [coeff, score, pcvar] = pcaComponentsLocal(Xfilled, K);
end
%=============================================================================
function [coeff, score, pcvar] = pcaComponentsLocal(X, K)
  [coeffAll, ~, pcvarAll] = pca(X);
  nvars = size(X, 2);
  available = min(K, size(coeffAll, 2));
  coeff = zeros(nvars, K);
  pcvar = zeros(K, 1);
  if available > 0
    coeff(:, 1:available) = coeffAll(:, 1:available);
    pcvar(1:available) = pcvarAll(1:available);
  end
  if available < K
    coeff = completeBasisLocal(coeff, available);
  end
  score = (X - repmat(mean(X, 1), size(X, 1), 1)) * coeff;
end
%=============================================================================
function coeff = completeBasisLocal(coeff, available)
  nvars = size(coeff, 1);
  for col = available + 1:size(coeff, 2)
    v = zeros(nvars, 1);
    v(min(col, nvars)) = 1;
    for previous = 1:col - 1
      v = v - coeff(:, previous) * (coeff(:, previous)' * v);
    end
    vnorm = norm(v);
    if vnorm <= eps
      v = zeros(nvars, 1);
      v(1) = 1;
      vnorm = 1;
    end
    coeff(:, col) = v / vnorm;
  end
end
%=============================================================================
function rmsValue = observedRMSLocal(Y, recon, missing)
  observed = ~missing;
  if any(observed(:))
    residual = Y(observed) - recon(observed);
    rmsValue = sqrt(mean(residual .^ 2));
  else
    rmsValue = NaN;
  end
end
%=============================================================================
function v = residualVarianceLocal(Y, recon, missing, v0)
  observed = ~missing;
  residual = Y(observed) - recon(observed);
  if isempty(residual)
    v = v0;
  else
    v = mean(residual .^ 2);
    if ~isempty(v0)
      v = max(v, v0 * eps);
    end
  end
  v = max(v, eps);
end
%=============================================================================
function S = convergenceStructLocal(coeff, score, pcvar, recon, v, rmsResid, iter)
  W = coeff * diag(sqrt(max(pcvar(:) - v, 0)));
  nloglk = 0.5 * numel(recon) * (log(2 * pi * max(v, realmin)) + 1);
  S = struct('W', W, 'Xexp', score, 'Recon', recon, 'v', v, ...
    'NumIter', iter, 'RMSResid', rmsResid, 'nloglk', nloglk);
end
%=============================================================================
function displayProgressLocal(displayValue, stage, iter, cost, step)
  if strcmp(displayValue, 'iter') && strcmp(stage, 'iter')
    disp([int2str(iter), ' iterations, rms resid = ', num2str(cost), ...
      ' |delta x| = ', num2str(step)]);
  elseif strcmp(displayValue, 'final') && strcmp(stage, 'final')
    disp([int2str(iter), ' iterations, Final rms residual = ', num2str(cost)]);
  end
end
%=============================================================================
function tf = isTextScalarLocal(value)
  tf = ischar(value) || isStringScalar(value);
end
%=============================================================================
function tf = isPositiveIntegerLocal(value)
  tf = isnumeric(value) && isreal(value) && isscalar(value) ...
    && isfinite(value) && floor(value) == value && value > 0;
end
%=============================================================================
function tf = isPositiveScalarLocal(value)
  tf = isnumeric(value) && isreal(value) && isscalar(value) && isfinite(value) && value > 0;
end
