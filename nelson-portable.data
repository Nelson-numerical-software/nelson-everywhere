% LICENCE_BLOCK_END
%=============================================================================
function value = odeValidateOnOff(value, name)
  if isempty(value)
    value = [];
    return
  end
  if isstring(value)
    value = char(value);
  end
  if ~ischar(value) || ~(strcmpi(value, 'on') || strcmpi(value, 'off'))
    error('Nelson:ode_solvers:invalidValue:valueOff', '%s must be ''on'' or ''off''.', name);
  end
  if strcmpi(value, 'on')
    value = 'on';
  else
    value = 'off';
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function value = odeValidatePositiveIntegerOrEmpty(value, name)
  if isempty(value)
    return
  end
  if ~isnumeric(value) || ~isscalar(value) || ~isfinite(value) || value <= 0 ...
      || value ~= fix(value)
    error('Nelson:ode_solvers:mustBeIntegerScalar', '%s must be an integer scalar.', name);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function value = odeValidatePositiveScalarOrEmpty(value, name)
  if isempty(value)
    return
  end
  if ~isnumeric(value) || ~isscalar(value) || ~isfinite(value) || value <= 0
    error('Nelson:validators:mustBePositive', '%s must be positive.', name);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
