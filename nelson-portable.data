%=============================================================================
function gray = rgb2gray(rgb)
  narginchk(1, 1);
  nargoutchk(0, 1);
  if ip_is_colormap(rgb)
    if isempty(rgb)
      error('Nelson:validators:mustBeNonempty', '%s must be nonempty.', 'Colormap');
    end
    if ~isa(rgb, 'double')
      error('Nelson:image_processing:colormapDoubleMatrixValuesRange', 'Colormap must be a double matrix with values in the range [0, 1].');
    end
    grayd = 0.298936021293776 * rgb(:, 1) + 0.587043074451121 * rgb(:, 2) + 0.114020904255103 * rgb(:, 3);
    grayd = ip_clip_unit_result(grayd);
    gray = [grayd grayd grayd];
    return;
  end
  if ~ip_is_rgb_image(rgb)
    error('Nelson:image_processing:rgbImageMNArray', '%s must be an M-by-N-by-3 array.', 'RGB image');
  end
  if isa(rgb, 'logical')
    error('Nelson:image_processing:rgbImageNumericNonLogical', '%s must be numeric and non-logical.', 'RGB image');
  end
  d = ip_to_unit_double(rgb);
  grayd = 0.298936021293776 * d(:, :, 1) + 0.587043074451121 * d(:, :, 2) + 0.114020904255103 * d(:, :, 3);
  grayd = ip_clip_unit_result(grayd);
  switch class(rgb)
    case 'uint8'
      gray = uint8(round(ip_clip01(grayd) * 255));
    case 'uint16'
      gray = uint16(round(ip_clip01(grayd) * 65535));
    case 'uint32'
      gray = uint32(round(ip_clip01(grayd) * 4294967295));
    case 'uint64'
      gray = uint64(round(ip_clip01(grayd) * 18446744073709551615));
    case 'int8'
      gray = int8(round(ip_clip01(grayd) * 255 - 128));
    case 'int16'
      gray = int16(round(ip_clip01(grayd) * 65535 - 32768));
    case 'int32'
      gray = int32(round(ip_clip01(grayd) * 4294967295 - 2147483648));
    case 'int64'
      gray = int64(round(ip_clip01(grayd) * 18446744073709551615 - 9223372036854775808));
    case 'single'
      gray = single(grayd);
    otherwise
      gray = grayd;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function hsv = rgb2hsv(rgb)
  narginchk(1, 1);
  nargoutchk(0, 1);
  isMap = ip_is_colormap(rgb);
  if isMap
    if isempty(rgb)
      error('Nelson:validators:mustBeNonempty', '%s must be nonempty.', 'Colormap');
    end
    if ~isa(rgb, 'double') || any(rgb(:) < 0) || any(rgb(:) > 1)
      error('Nelson:image_processing:colormapDoubleMatrixValuesRange', 'Colormap must be a double matrix with values in the range [0, 1].');
    end
    rgbMap = reshape(rgb, size(rgb, 1), 1, 3);
    hsvMap = rgb2hsv(rgbMap);
    hsv = reshape(hsvMap, size(rgb, 1), 3);
    return;
  end
  if ~ip_is_rgb_image(rgb)
    error('Nelson:image_processing:rgbImageMNArray', '%s must be an M-by-N-by-3 array.', 'RGB image');
  end
  if ~(isa(rgb, 'double') || isa(rgb, 'single') || isa(rgb, 'uint8') || isa(rgb, 'uint16'))
    error('Nelson:image_processing:rgbImageDoubleSingleUint8Uint16', 'RGB image must be double, single, uint8, or uint16.');
  end
  if ~isreal(rgb)
    error('Nelson:validators:mustBeReal', '%s must be real.', 'RGB image');
  end
  outIsSingle = isa(rgb, 'single');
  if isempty(rgb)
    hsv = zeros(size(rgb));
    if outIsSingle
      hsv = single(hsv);
    end
    return;
  end
  rgb = ip_to_unit_double(rgb);
  r = rgb(:, :, 1);
  g = rgb(:, :, 2);
  b = rgb(:, :, 3);
  v = max(rgb, [], 3);
  v = v(:, :, 1);
  mn = min(rgb, [], 3);
  mn = mn(:, :, 1);
  d = v - mn;
  safeD = d + (d == 0);
  safeV = v + (v == 0);
  hr = mod((g - b) ./ safeD, 6) / 6;
  hg = ((b - r) ./ safeD + 2) / 6;
  hb = ((r - g) ./ safeD + 4) / 6;
  useR = v == r;
  useG = (v ~= r) & (v == g);
  useB = (v ~= r) & (v ~= g) & (v == b);
  h = (d ~= 0) .* (useR .* hr + useG .* hg + useB .* hb);
  s = d ./ safeV;
  hsv = zeros(size(rgb, 1), size(rgb, 2), 3);
  hsv(:, :, 1) = h;
  hsv(:, :, 2) = s;
  hsv(:, :, 3) = v;
  if outIsSingle
    hsv = single(hsv);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [X, map] = rgb2ind(RGB, arg, dither_option)
  narginchk(2, 3);
  nargoutchk(0, 2);
  if ~ip_is_rgb_image(RGB)
    error('Nelson:image_processing:rgbImageMNArray', '%s must be an M-by-N-by-3 array.', 'RGB');
  end
  doDither = true;
  if nargin == 3
    mustBeTextScalar(dither_option, 3);
    dither_option = convertStringsToChars(dither_option);
    switch lower(dither_option)
      case 'dither'
        doDither = true;
      case 'nodither'
        doDither = false;
      otherwise
        error('Nelson:rgb2ind:invalidDither', 'DITHER_OPTION must be ''dither'' or ''nodither''.');
    end
  end
  [rows, cols, ~] = size(RGB);
  if isempty(RGB)
    map = [0 0 0];
    X = zeros(rows, cols, 'uint8');
    return;
  end
  I = ip_to_unit_double(RGB);
  I = min(max(I, 0), 1);
  paletteGiven = false;
  if isscalar(arg) && (isnumeric(arg) || islogical(arg))
    a = double(arg);
    if ~isfinite(a)
      error('Nelson:rgb2ind:invalidN', 'N must be an integer >= 1 or a tolerance in the interval (0, 1).');
    end
    if a >= 1 && a == floor(a)
      mode = 'minvar';
      ncolors = a;
    elseif a > 0 && a < 1
      mode = 'uniform';
      tol = a;
    else
      error('Nelson:rgb2ind:invalidN', 'N must be an integer >= 1 or a tolerance in the interval (0, 1).');
    end
  elseif ip_is_colormap(arg)
    paletteGiven = true;
    map = min(max(double(arg), 0), 1);
  else
    error('Nelson:rgb2ind:invalidArg', 'Second argument must be a scalar number of colors, a scalar tolerance, or an M-by-3 colormap.');
  end
  P = reshape(I, rows * cols, 3);
  if ~paletteGiven
    switch mode
      case 'minvar'
        map = ip_median_cut_map(P, ncolors);
      case 'uniform'
        map = ip_uniform_map(P, tol);
    end
  end
  if doDither
    idx = ip_dither_assign(I, map);
  else
    idx = reshape(ip_nearest_assign(P, map), rows, cols);
  end
  if size(map, 1) <= 256
    X = uint8(idx);
  else
    X = uint16(idx);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function ycbcr = rgb2ycbcr(rgb)
  narginchk(1, 1);
  nargoutchk(0, 1);
  isMap = ip_is_colormap(rgb);
  if isMap
    if ~isa(rgb, 'double') || any(rgb(:) < 0) || any(rgb(:) > 1)
      error('Nelson:image_processing:colormapDoubleMatrixValuesRange', 'Colormap must be a double matrix with values in the range [0, 1].');
    end
    rgbMap = reshape(rgb, size(rgb, 1), 1, 3);
    ycbcrMap = rgb2ycbcr(rgbMap);
    ycbcr = reshape(ycbcrMap, size(rgb, 1), 3);
    return;
  end
  if ~ip_is_rgb_image(rgb)
    error('Nelson:image_processing:rgbImageMNArray', '%s must be an M-by-N-by-3 array.', 'RGB image');
  end
  d = ip_clip01(ip_to_unit_double(rgb));
  r = d(:, :, 1); g = d(:, :, 2); b = d(:, :, 3);
  y = 16 / 255 + (65.481 * r + 128.553 * g + 24.966 * b) / 255;
  cb = 128 / 255 + (-37.797 * r - 74.203 * g + 112.0 * b) / 255;
  cr = 128 / 255 + (112.0 * r - 93.786 * g - 18.214 * b) / 255;
  out = cat(3, y, cb, cr);
  switch class(rgb)
    case 'uint8'
      ycbcr = uint8(round(ip_clip01(out) * 255));
    case 'uint16'
      ycbcr = uint16(round(ip_clip01(out) * 65535));
    case 'single'
      ycbcr = single(out);
    otherwise
      ycbcr = out;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function tf = sizesMatch(ref, img)
  narginchk(2, 2);
  nargoutchk(0, 1);
  [dim, ref] = ip_spatial_ref_dimension(ref);
  if isnumeric(img) || islogical(img) || ischar(img) || iscell(img) || isstruct(img)
    imageSize = size(img);
  else
    error('Nelson:image_processing:imageArray', 'Image must be an array.');
  end
  if numel(imageSize) < dim
    tf = false;
    return
  end
  tf = isequal(double(imageSize(1:dim)), ref.ImageSize);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function se = strel(varargin)
  narginchk(1, 3);
  nargoutchk(0, 1);
  if ~(ischar(varargin{1}) || isstring(varargin{1}))
    nhood = ip_nhood(varargin{1});
    se = struct('type', 'arbitrary', 'nhood', nhood);
    return;
  end
  shape = lower(convertStringsToChars(varargin{1}));
  switch shape
    case 'arbitrary'
      if nargin ~= 2
        error('Nelson:image_processing:arbitraryStructuringElementRequiresNeighborhood', '%s structuring element requires %s.', 'Arbitrary', 'a neighborhood');
      end
      nhood = ip_nhood(varargin{2});
    case 'square'
      if nargin ~= 2
        error('Nelson:image_processing:squareStructuringElementRequiresSize', '%s structuring element requires %s.', 'Square', 'a size');
      end
      n = varargin{2};
      if ~isscalar(n) || ~isfinite(double(n)) || n < 1 || n ~= floor(n)
        error('Nelson:image_processing:squareSizePositiveIntegerScalar', '%s must be a positive integer scalar.', 'Square size');
      end
      nhood = true(n, n);
    case 'rectangle'
      if nargin ~= 2
        error('Nelson:image_processing:rectangleStructuringElementRequiresSizeVector', '%s structuring element requires %s.', 'Rectangle', 'a size vector');
      end
      sz = varargin{2};
      if numel(sz) ~= 2 || any(~isfinite(double(sz(:)))) || any(sz(:) < 1) ...
          || any(sz(:) ~= floor(sz(:)))
        error('Nelson:image_processing:rectangleSizeContainPositiveIntegers', '%s size must contain positive integers.', 'Rectangle');
      end
      nhood = true(sz(1), sz(2));
    case 'cube'
      if nargin ~= 2
        error('Nelson:image_processing:cubeStructuringElementRequiresSize', '%s structuring element requires %s.', 'Cube', 'a size');
      end
      n = varargin{2};
      if ~isscalar(n) || ~isfinite(double(n)) || n < 1 || n ~= floor(n)
        error('Nelson:image_processing:cubeSizePositiveIntegerScalar', '%s must be a positive integer scalar.', 'Cube size');
      end
      nhood = true(n, n, n);
    case 'cuboid'
      if nargin ~= 2
        error('Nelson:image_processing:cuboidStructuringElementRequiresSizeVector', '%s structuring element requires %s.', 'Cuboid', 'a size vector');
      end
      sz = varargin{2};
      if numel(sz) ~= 3 || any(~isfinite(double(sz(:)))) || any(sz(:) < 1) ...
          || any(sz(:) ~= floor(sz(:)))
        error('Nelson:image_processing:cuboidSizeContainPositiveIntegers', '%s size must contain positive integers.', 'Cuboid');
      end
      nhood = true(sz(1), sz(2), sz(3));
    case 'sphere'
      if nargin ~= 2
        error('Nelson:image_processing:sphereStructuringElementRequiresRadius', '%s structuring element requires %s.', 'Sphere', 'a radius');
      end
      r = varargin{2};
      if ~isscalar(r) || ~isfinite(double(r)) || r < 0 || r ~= floor(r)
        error('Nelson:image_processing:sphereRadiusNonnegativeIntegerScalar', '%s must be a nonnegative integer scalar.', 'Sphere radius');
      end
      [x, y, z] = meshgrid(-r:r, -r:r, -r:r);
      nhood = (x .^ 2 + y .^ 2 + z .^ 2) <= r ^ 2;
    case 'line'
      if nargin < 2 || nargin > 3
        error('Nelson:image_processing:lineStructuringElementRequiresLengthOptional', '%s structuring element requires %s.', 'Line', 'a length and optional angle');
      end
      len = varargin{2};
      if nargin >= 3
        angle = varargin{3};
      else
        angle = 0;
      end
      len = double(len);
      if ~isscalar(len) || ~isfinite(len) || len < 1 || len ~= floor(len)
        error('Nelson:image_processing:lineLengthPositiveIntegerScalar', '%s must be a positive integer scalar.', 'Line length');
      end
      if ~isscalar(angle) || ~isfinite(double(angle))
        error('Nelson:image_processing:lineAngleFiniteScalar', 'Line angle must be a finite scalar.');
      end
      angle = double(angle) * pi / 180;
      radius = (len - 1) / 2;
      x = round(linspace(-radius * cos(angle), radius * cos(angle), len));
      y = round(linspace(-radius * sin(angle), radius * sin(angle), len));
      rows = max(y) - min(y) + 1;
      cols = max(x) - min(x) + 1;
      nhood = false(rows, cols);
      idx = sub2ind(size(nhood), y - min(y) + 1, x - min(x) + 1);
      nhood(idx) = true;
    case 'disk'
      if nargin < 2 || nargin > 3
        error('Nelson:image_processing:diskStructuringElementRequiresRadiusOptional', '%s structuring element requires %s.', 'Disk', 'a radius and optional decomposition count');
      end
      r = varargin{2};
      if ~isscalar(r) || ~isfinite(double(r)) || r < 0 || r ~= floor(r)
        error('Nelson:image_processing:diskRadiusNonnegativeIntegerScalar', '%s must be a nonnegative integer scalar.', 'Disk radius');
      end
      if nargin >= 3 && ~isempty(varargin{3})
        n = varargin{3};
        if ~isscalar(n) || ~isfinite(double(n)) || n ~= floor(n) ...
            || ~(n == 0 || n == 4 || n == 6 || n == 8)
          error('Nelson:image_processing:diskDecompositionCount', 'Disk decomposition count must be 0, 4, 6, or 8.');
        end
      end
      [x, y] = meshgrid(-r:r, -r:r);
      nhood = (x .^ 2 + y .^ 2) <= r ^ 2;
    case 'diamond'
      if nargin ~= 2
        error('Nelson:image_processing:diamondStructuringElementRequiresRadius', '%s structuring element requires %s.', 'Diamond', 'a radius');
      end
      r = varargin{2};
      if ~isscalar(r) || ~isfinite(double(r)) || r < 0 || r ~= floor(r)
        error('Nelson:image_processing:diamondRadiusNonnegativeIntegerScalar', '%s must be a nonnegative integer scalar.', 'Diamond radius');
      end
      [x, y] = meshgrid(-r:r, -r:r);
      nhood = (abs(x) + abs(y)) <= r;
    case 'octagon'
      if nargin ~= 2
        error('Nelson:image_processing:octagonStructuringElementRequiresRadius', '%s structuring element requires %s.', 'Octagon', 'a radius');
      end
      r = varargin{2};
      if ~isscalar(r) || ~isfinite(double(r)) || r < 0 || r ~= floor(r) || mod(r, 3) ~= 0
        error('Nelson:image_processing:octagonRadiusNonnegativeMultiple', 'Octagon radius must be a nonnegative multiple of 3.');
      end
      [x, y] = meshgrid(-r:r, -r:r);
      nhood = (abs(x) <= r) & (abs(y) <= r) & (abs(x) + abs(y) <= r + r / 3);
    otherwise
      error('Nelson:image_processing:unsupportedStructuringElementShape', 'Unsupported "%s" option.', 'structuring element shape');
  end
  se = struct('type', shape, 'nhood', logical(nhood));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function limits = stretchlim(varargin)
  narginchk(1, 2);
  nargoutchk(0, 1);
  ip_assert_full_image(varargin{1}, true);
  img = ip_clip01(ip_to_unit_double(varargin{1}));
  if nargin == 2
    tol = double(varargin{2});
  else
    tol = [0.01 0.99];
  end
  if numel(tol) == 1
    tol = [tol 1 - tol];
  end
  if numel(tol) ~= 2 || any(tol < 0) || any(tol > 1)
    error('Nelson:image_processing:toleranceScalarElementVectorRange', 'Tolerance must be a scalar or a 2-element vector in the range [0, 1].');
  end
  if length(size(img)) == 3
    channels = size(img, 3);
  else
    channels = 1;
  end
  limits = zeros(2, channels);
  if tol(1) >= tol(2)
    limits(2, :) = 1;
    return;
  end
  for c = 1:channels
    if channels == 1
      vals = sort(img(:));
    else
      plane = img(:, :, c);
      vals = sort(plane(:));
    end
    n = numel(vals);
    lo = max(1, min(n, floor(tol(1) * n) + 1));
    hi = max(1, min(n, ceil(tol(2) * n)));
    limits(:, c) = [vals(lo); vals(hi)];
  end
end
