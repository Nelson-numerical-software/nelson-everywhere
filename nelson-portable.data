%=============================================================================
function TT = timeseries2timetable(varargin)
  % Each timeseries becomes one variable, named after the timeseries (or
  % Data), made unique; all inputs must share the same time vector. A
  % single input may be a timeseries array, taken in column order.
  narginchk(1, Inf);
  tsList = timeseriesList(varargin);
  data = cell(1, length(tsList));
  names = cell(1, length(tsList));
  for k = 1:length(tsList)
    ts = tsList{k};
    if k > 1 && ~sameTimeVector(tsList{1}, ts)
      error('Nelson:table:timeseriesTimeMismatch', _('All inputs must have the same time vector, TimeInfo Units, and TimeInfo StartDate. Separately convert each timeseries to a timetable, and then use the SYNCHRONIZE function to combine the timetables.'));
    end
    data{k} = dataWithSamplesInRows(ts);
    names{k} = ts.Name;
    if isempty(names{k})
      names{k} = 'Data';
    end
  end
  names = nelson.lang.makeUniqueStrings(names);
  TT = timetable(data{:}, 'RowTimes', makeRowTimes(tsList{1}), 'VariableNames', names);
end
%=============================================================================
function tsList = timeseriesList(args)
  % timeseries overloads numel and () indexing on its samples, so the
  % elements of an array are reached through the builtins.
  for k = 1:length(args)
    if ~istimeseries(args{k})
      error('Nelson:table:invalidType:inputATimeseriesObject', 'Input must be a timeseries object.');
    end
  end
  if length(args) > 1
    for k = 1:length(args)
      if ~isscalar(args{k})
        error('Nelson:table:timeseriesNonscalarInput', _('If multiple inputs are given to timeseries2timetable, they all must be scalar timeseries objects.'));
      end
    end
    tsList = args;
    return
  end
  n = builtin('numel', args{1});
  if n == 0
    error('Nelson:table:emptyTimeseriesArray', _('timeseries array input must be non-empty.'));
  end
  tsList = cell(1, n);
  for k = 1:n
    tsList{k} = builtin('subsref', args{1}, substruct('()', {k}));
  end
end
%=============================================================================
function tf = sameTimeVector(a, b)
  tf = isequal(a.Time(:), b.Time(:)) && strcmp(a.TimeInfo.Units, b.TimeInfo.Units) ...
    && isequal(a.TimeInfo.StartDate, b.TimeInfo.StartDate);
end
%=============================================================================
function data = dataWithSamplesInRows(ts)
  data = ts.Data;
  if isvector(data)
    data = data(:);
  elseif ~ts.IsTimeFirst
    order = [ndims(data), 1:ndims(data) - 1];
    data = permute(data, order);
  end
end
%=============================================================================
function rowTimes = makeRowTimes(ts)
  time = ts.Time(:);
  if ~isempty(ts.TimeInfo.StartDate)
    serial = datenum(ts.TimeInfo.StartDate) + time .* unitDays(ts.TimeInfo.Units);
    rowTimes = datetime(serial, 'ConvertFrom', 'datenum');
  else
    rowTimes = seconds(time .* unitSeconds(ts.TimeInfo.Units));
  end
end
%=============================================================================
function scale = unitSeconds(units)
  switch lower(units)
    case {'second', 'seconds', 'sec', 'secs'}
      scale = 1;
    case {'minute', 'minutes', 'min', 'mins'}
      scale = 60;
    case {'hour', 'hours', 'hr', 'hrs'}
      scale = 3600;
    case {'day', 'days'}
      scale = 86400;
    otherwise
      scale = 1;
  end
end
%=============================================================================
function scale = unitDays(units)
  scale = unitSeconds(units) ./ 86400;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function T = timetable2table(TT, varargin)
  narginchk(1, Inf);
  if ~istimetable(TT)
    error('Nelson:table:invalidType:valueATimetable', '%s must be a timetable.', 'TT');
  end
  opts = parseOptions(varargin{:});
  st = struct(TT);
  T = table.fromStruct(st.Table);
  if opts.ConvertRowTimes
    rowTimesName = st.Properties.DimensionNames{1};
    if isempty(rowTimesName)
      rowTimesName = 'Time';
    end
    rowTimesName = uniqueNameLocal(rowTimesName, st.Table.Properties.VariableNames);
    T = table(st.Properties.RowTimes, 'VariableNames', {rowTimesName});
    T = [T, table.fromStruct(st.Table)];
  end
end
%=============================================================================
function opts = parseOptions(varargin)
  opts.ConvertRowTimes = true;
  k = 1;
  while k <= nargin
    name = varargin{k};
    if isstring(name)
      name = char(name);
    end
    if ~ischar(name) || k == nargin
      error('Nelson:table:nameValuePair', 'Name-value argument expected.');
    end
    switch lower(name)
      case 'convertrowtimes'
        opts.ConvertRowTimes = logical(varargin{k + 1});
      otherwise
        error('Nelson:table:unsupportedOption', 'Unsupported "%s" option.', 'timetable2table');
    end
    k = k + 2;
  end
end
%=============================================================================
function name = uniqueNameLocal(name, existing)
  if ~any(strcmp(existing, name))
    return
  end
  base = name;
  k = 1;
  while any(strcmp(existing, name))
    name = [base, '_', int2str(k)];
    k = k + 1;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function U = unstack(T, dataVar, indicatorVar, varargin)
  narginchk(3, Inf);
  mustBeA(T, 'table', 1);
  st = struct(T);
  names = st.Properties.VariableNames;
  dataIdx = resolveVariablesLocal(names, dataVar);
  indicatorIdx = resolveVariablesLocal(names, indicatorVar);
  if length(dataIdx) ~= 1 || length(indicatorIdx) ~= 1
    error('Nelson:table:invalidSyntax:oneDataVariableOneIndicatorVariable', 'One data variable and one indicator variable expected.');
  end
  dataName = names{dataIdx};
  indicatorName = names{indicatorIdx};
  groupingVars = setdiffIndicesLocal(1:width(T), [dataIdx, indicatorIdx]);
  k = 1;
  while k <= length(varargin)
    option = char(varargin{k});
    switch lower(option)
      case 'groupingvariables'
        groupingVars = resolveVariablesLocal(names, varargin{k + 1});
      otherwise
        error('Nelson:table:unknownOption', 'Unknown option.');
    end
    k = k + 2;
  end
  indicators = T.(indicatorName);
  if isstring(indicators)
    indicatorNames = cellstr(indicators);
  elseif iscellstr(indicators)
    indicatorNames = indicators(:);
  else
    error('Nelson:table:invalidType:indicatorVariableContainText', 'Indicator variable must contain text.');
  end
  newNames = makeUniqueNamesLocal(uniqueStableLocal(indicatorNames)');
  groupKeys = rowKeysLocal(st, height(T), groupingVars);
  uniqueGroups = uniqueStableLocal(groupKeys);
  rows = cell(length(uniqueGroups), 1);
  for g = 1:length(uniqueGroups)
    sourceRows = find(strcmp(groupKeys, uniqueGroups{g}));
    row = T(sourceRows(1), names(groupingVars));
    for n = 1:length(newNames)
      match = sourceRows(strcmp(indicatorNames(sourceRows), newNames{n}));
      if isempty(match)
        row.(newNames{n}) = defaultValueLocal(st.data.(dataName), 1);
      else
        row.(newNames{n}) = columnRowsLocal(st.data.(dataName), match(1));
      end
    end
    rows{g} = row;
  end
  U = rows{1};
  for g = 2:length(rows)
    U = [U; rows{g}];
  end
end
%=============================================================================
function idx = resolveVariablesLocal(names, vars)
  if isempty(vars) || (ischar(vars) && strcmp(vars, ':'))
    idx = 1:length(names);
  elseif islogical(vars)
    idx = find(vars);
  elseif isnumeric(vars)
    idx = vars;
  else
    if isstring(vars)
      vars = cellstr(vars);
    elseif ischar(vars)
      vars = {vars};
    end
    idx = zeros(1, length(vars));
    for k = 1:length(vars)
      found = find(strcmp(names, vars{k}), 1);
      if isempty(found)
        error('Nelson:table:unrecognizedVariable', 'Unrecognized table variable name.');
      end
      idx(k) = found;
    end
  end
end
%=============================================================================
function idx = setdiffIndicesLocal(allIdx, removeIdx)
  idx = [];
  for k = allIdx(:)'
    if ~any(removeIdx == k)
      idx(end + 1) = k;
    end
  end
end
%=============================================================================
function keys = rowKeysLocal(st, nRows, vars)
  keys = cell(nRows, 1);
  for r = 1:nRows
    key = '';
    for j = 1:length(vars)
      name = st.Properties.VariableNames{vars(j)};
      key = [key, '#', int2str(j), '=', valueKeyLocal(columnRowsLocal(st.data.(name), r)), ';'];
    end
    keys{r} = key;
  end
end
%=============================================================================
function key = valueKeyLocal(value)
  if ischar(value)
    key = ['char:', value];
  elseif isstring(value)
    key = ['string:', char(value)];
  elseif iscell(value)
    if isempty(value)
      key = 'cell:[]';
    else
      key = ['cell:', valueKeyLocal(value{1})];
    end
  elseif isnumeric(value) || islogical(value)
    key = [class(value), ':', mat2str(value)];
  else
    key = class(value);
  end
end
%=============================================================================
function value = columnRowsLocal(value, rows)
  if isvector(value)
    value = value(rows, :);
  else
    idx = repmat({':'}, 1, ndims(value) - 1);
    value = value(rows, idx{:});
  end
end
%=============================================================================
function values = uniqueStableLocal(valuesIn)
  values = {};
  for k = 1:length(valuesIn)
    if isempty(find(strcmp(values, valuesIn{k}), 1))
      values{end + 1} = valuesIn{k};
    end
  end
  values = values(:);
end
%=============================================================================
function names = makeUniqueNamesLocal(names)
  if ischar(names)
    names = {names};
  elseif isstring(names)
    names = cellstr(names);
  end
  names = names(:)';
  used = {};
  for k = 1:length(names)
    base = names{k};
    candidate = base;
    suffix = 1;
    while any(strcmp(used, candidate))
      candidate = [base, '_', num2str(suffix)];
      suffix = suffix + 1;
    end
    names{k} = candidate;
    used{end + 1} = candidate;
  end
end
%=============================================================================
function value = defaultValueLocal(sample, nRows)
  sz = size(sample);
  sz(1) = nRows;
  if isnumeric(sample)
    if isfloat(sample)
      value = NaN(sz);
      value = cast(value, class(sample));
    else
      value = zeros(sz, class(sample));
    end
  elseif islogical(sample)
    value = false(sz);
  elseif isstring(sample)
    value = strings(sz);
  elseif iscell(sample)
    value = cell(sz);
  else
    value = cell(nRows, 1);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function R = varfun(fun, T, varargin)
  narginchk(2, Inf);
  isTimetable = isa(T, 'timetable');
  if ~(isa(T, 'table') || isTimetable)
    error('Nelson:table:invalidType:valueOneTheseTypesTableTimetable', 'Value must have one of these types: ''table'', ''timetable''.');
  end
  vars = 1:width(T);
  outputFormat = 'table';
  groupVars = [];
  st = struct(T);
  names = st.Properties.VariableNames;
  k = 1;
  while k <= length(varargin)
    option = char(varargin{k});
    switch lower(option)
      case 'inputvariables'
        vars = tableResolveVariables(names, varargin{k + 1}, st.Properties.VariableTypes, st.data);
      case 'outputformat'
        outputFormat = lower(char(varargin{k + 1}));
      case 'groupingvariables'
        groupVars = varargin{k + 1};
      otherwise
        error('Nelson:table:unknownOption', 'Unknown option.');
    end
    k = k + 2;
  end
  if ~isempty(groupVars)
    R = varfunGroupedLocal(fun, T, names, st, vars, groupVars);
    return
  end
  values = cell(1, length(vars));
  outNames = cell(1, length(vars));
  for j = 1:length(vars)
    name = names{vars(j)};
    values{j} = fun(T.(name));
    outNames{j} = [func2str(fun), '_', name];
  end
  switch outputFormat
    case 'table'
      if isTimetable
        rowTimes = T.Properties.RowTimes;
        R = timetable(rowTimes(1), values{:}, ...
          'VariableNames', tableMakeUniqueNames(outNames));
      else
        R = table(values{:}, 'VariableNames', tableMakeUniqueNames(outNames));
      end
    case 'uniform'
      R = [values{:}];
    case 'cell'
      R = values;
    otherwise
      error('Nelson:table:unsupportedOutputFormat', 'Unsupported "%s" option.', 'OutputFormat');
  end
end
%=============================================================================
function R = varfunGroupedLocal(fun, T, names, st, vars, groupVars)
  gIdx = tableResolveVariables(names, groupVars, st.Properties.VariableTypes, st.data);
  dataIdx = vars(~ismember(vars, gIdx));
  gcols = cell(1, numel(gIdx));
  for j = 1:numel(gIdx)
    gcols{j} = T.(names{gIdx(j)});
  end
  G = findgroups(gcols{:});
  Gv = G(:);
  finite = Gv(~isnan(Gv));
  if isempty(finite)
    ng = 0;
  else
    ng = max(finite);
  end
  firstRows = zeros(ng, 1);
  groupCount = zeros(ng, 1);
  for g = 1:ng
    firstRows(g) = find(Gv == g, 1);
    groupCount(g) = sum(Gv == g);
  end
  outCols = {};
  outNames = {};
  for j = 1:numel(gIdx)
    col = T.(names{gIdx(j)});
    outCols{end + 1} = col(firstRows, :); %#ok<AGROW>
    outNames{end + 1} = names{gIdx(j)}; %#ok<AGROW>
  end
  outCols{end + 1} = groupCount;
  outNames{end + 1} = 'GroupCount';
  for j = 1:numel(dataIdx)
    name = names{dataIdx(j)};
    outCols{end + 1} = splitapply(fun, T.(name), G); %#ok<AGROW>
    outNames{end + 1} = [func2str(fun), '_', name]; %#ok<AGROW>
  end
  R = table(outCols{:}, 'VariableNames', tableMakeUniqueNames(outNames));
end
