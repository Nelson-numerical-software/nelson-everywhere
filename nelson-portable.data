% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = colororder(varargin)
  narginchk(0, 2);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [ax, args] = parseAxis(args);
  if isempty(args)
    varargout{1} = ax.ColorOrder;
    return
  end
  colors = colorOrderValue(args{1});
  ax.ColorOrder = colors;
  ax.ColorOrderIndex = 1;
  updateAutomaticBarColors(ax, colors);
  if nargout == 1
    error('Nelson:graphics:invalidOutputArgument', 'Invalid output argument.');
  end
end
%=============================================================================
function [ax, args] = parseAxis(args)
  if ~isempty(args) && isscalar(args{1}) && isgraphics(args{1}, 'axes')
    ax = args{1};
    args = args(2:end);
  else
    ax = gca();
  end
end
%=============================================================================
function colors = colorOrderValue(value)
  if ischar(value) || isStringScalar(value)
    colors = namedColorOrder(char(value));
  elseif isnumeric(value) && isreal(value) && size(value, 2) == 3
    colors = double(value);
  else
    error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
  end
end
%=============================================================================
function colors = namedColorOrder(name)
  switch lower(name)
    case {'default', 'gem'}
      colors = [0.066 0.443 0.745; 0.866 0.329 0; 0.929 0.694 0.125; ...
        0.521 0.086 0.819; 0.231 0.666 0.196; 0.184 0.745 0.937; ...
        0.819 0.015 0.545];
    case 'glow'
      colors = [0.149 0.549 0.866; 0.96 0.466 0.16; 1 0.909 0.392; ...
        0.752 0.36 0.984; 0.286 0.858 0.25; 0.423 0.956 1; ...
        0.949 0.403 0.772];
    case 'sail'
      colors = [0.062 0.258 0.501; 0.329 0.713 1; 1 0.27 0.227; ...
        0.564 0.149 0.133; 0.066 0.443 0.745];
    case 'reef'
      colors = [0.866 0.329 0; 0.329 0.713 1; 0.066 0.443 0.745; ...
        0.996 0.564 0.262; 0.454 0.921 0.854; 0 0.639 0.639];
    case 'meadow'
      colors = [0.007 0.345 0.054; 0.227 0.784 0.192; 1 0.839 0.039; ...
        0.96 0.466 0.16; 0.752 0.298 0.043; 0.98 0.541 0.831; ...
        0.49 0.662 1];
    case 'dye'
      colors = [0.717 0.192 0.172; 0.231 0.666 0.196; 0.368 0.133 0.588; ...
        0.066 0.443 0.745; 0.866 0.329 0; 0.007 0.47 0.501; ...
        0.913 0.317 0.721];
    case 'earth'
      colors = [0.062 0.258 0.501; 0.717 0.192 0.172; 0.611 0.466 0.125; ...
        0.007 0.345 0.054; 0.862 0.6 0.423; 0.372 0.105 0.031; ...
        1 0.819 0.619];
    otherwise
      error('Nelson:colororder:unknownColorOrder', 'Unknown color order.');
  end
end
%=============================================================================
function updateAutomaticBarColors(ax, colors)
  bars = findobj(ax, 'Type', 'bar');
  for k = 1:numel(bars)
    if strcmp(bars(k).FaceColorMode, 'auto')
      index = bars(k).SeriesIndex;
      if isnumeric(index) && isscalar(index)
        row = mod(double(index) - 1, size(colors, 1)) + 1;
        bars(k).FaceColor = colors(row, :);
        bars(k).FaceColorMode = 'auto';
      end
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [linespec, colorspec, markerspec, msg] = colstyle(varargin)
  narginchk(1, 3);
  nargoutchk(0, 4);
  style = varargin{1};
  emptyAsNone = false;
  raiseError = true;
  if nargin == 2
    if ~(ischar(varargin{2}) || isStringScalar(varargin{2}))
      error('Nelson:colstyle:plotArgumentExpected', '"plot" argument expected.');
    end
    option = convertStringsToChars(varargin{2});

    if strcmp('plot', option) || strcmp('', option)
      emptyAsNone = strcmp('plot', option);
    else
      error('Nelson:colstyle:plotArgumentExpected', '"plot" argument expected.');
    end
  elseif nargin == 3
    raiseError = varargin{3};
  end
  if ~ischar(style) && ~isStringScalar(style)
    if raiseError
      error('Nelson:colstyle:requiresAStringScalar', 'Requires a string scalar or a character vector argument.');
    else
      colorspec = '';
      markerspec = '';
      linespec = '';
      msg.message = 'Invalid LineSpec string.';
      msg.Identifier = 'Nelson:colstyle:InvalidLinespec';
      return
    end
  end
  style = convertStringsToChars(style);
  giveup = 0;
  colorspec = '';
  markerspec = '';
  linespec = '';
  msg = [];
  if isempty(style)
    return;
  end
  orig_t = style;
  while (~giveup && length(style) > 0)
    giveup = 1;
    if (matchit(getColorShortName(style), getColorShortNameList()))
      [colorspec, style] = parseit(getColorShortName(style), getColorShortNameList());
      giveup = 0;
    end;
    if (matchit(style, getMarkerNameList()))
      [markerspec, style] = parseit(style, getMarkerNameList());
      giveup = 0;
    end
    if (matchit(style, styleset()))
      [linespec, style] = parseit(style, styleset());
      giveup = 0;
    end
  end
  if (strcmp(markerspec, '') && strcmp(linespec, ''))
    linespec = '-';
  end
  if giveup
    colorspec = '';
    markerspec = '';
    linespec = '';
    msg.message = 'Invalid LineSpec string.';
    msg.Identifier = 'Nelson:colstyle:InvalidLinespec';
    return
  end
  if isempty(linespec)
    if emptyAsNone
      linespec = 'none';
    else
      linespec = '';
    end
  end
end
%=============================================================================
function b = matchit(t, dictionary)
  b = any(stcmp(dictionary, t));
end
%=============================================================================
function [b, t] = parseit(t, dictionary)
  n = stcmp(dictionary, t);
  b = dictionary{min(find(n))};
  t(1:length(b)) = [];
end
%=============================================================================
function c = styleset()
  c = {'--', ':', '-.', '-'};
end
%=============================================================================
function b = stcmp(source, pattern)
  b = zeros(size(source), 'logical');
  for i = 1:numel(source)
    b(i) = strncmp(source{i}, pattern, length(source{i}));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function comet(varargin)
  narginchk(1, 4);
  nargoutchk(0, 0);
  args = convertStringToCharArgs(varargin);
  [ax, args] = parseCometParent(args);
  [x, y, p] = parseCometData(args);
  cometAnimate(ax, x, y, [], p);
end
%=============================================================================
function [ax, args] = parseCometParent(args)
  if ~isempty(args) && isscalar(args{1}) && isgraphics(args{1}, 'axes')
    ax = args{1};
    args = args(2:end);
  else
    ax = [];
  end
end
%=============================================================================
function [x, y, p] = parseCometData(args)
  p = 0.1;
  if numel(args) == 1
    y = args{1};
    x = 1:numel(y);
  elseif numel(args) == 2
    x = args{1};
    y = args{2};
  elseif numel(args) == 3
    x = args{1};
    y = args{2};
    p = args{3};
  else
    error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
  end
  if ~isnumeric(x) || ~isnumeric(y) || ~isvector(x) || ~isvector(y) || numel(x) ~= numel(y) || isempty(x)
    error('Nelson:comet:invalidXAndY', 'X and Y must be nonempty numeric vectors with the same number of elements.');
  end
  if ~isnumeric(p) || ~isscalar(p) || ~isfinite(p) || p < 0 || p >= 1
    error('Nelson:comet:invalidP', 'P must be a scalar value in the interval [0, 1).');
  end
  x = x(:).';
  y = y(:).';
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function comet3(varargin)
  narginchk(1, 5);
  nargoutchk(0, 0);
  args = convertStringToCharArgs(varargin);
  [ax, args] = parseComet3Parent(args);
  [x, y, z, p] = parseComet3Data(args);
  cometAnimate(ax, x, y, z, p);
end
%=============================================================================
function [ax, args] = parseComet3Parent(args)
  if ~isempty(args) && isscalar(args{1}) && isgraphics(args{1}, 'axes')
    ax = args{1};
    args = args(2:end);
  else
    ax = [];
  end
end
%=============================================================================
function [x, y, z, p] = parseComet3Data(args)
  p = 0.1;
  if numel(args) == 1
    z = args{1};
    x = 1:numel(z);
    y = 1:numel(z);
  elseif numel(args) == 3
    x = args{1};
    y = args{2};
    z = args{3};
  elseif numel(args) == 4
    x = args{1};
    y = args{2};
    z = args{3};
    p = args{4};
  else
    error('Nelson:graphics:invalidInputArguments', 'Invalid input arguments.');
  end
  if ~isnumeric(x) || ~isnumeric(y) || ~isnumeric(z) || ~isvector(x) || ...
      ~ isvector(y) || ~isvector(z) || numel(x) ~= numel(y) || ...
      numel(x) ~= numel(z) || isempty(x)
    error('Nelson:comet3:invalidXYAnd', 'X, Y, and Z must be nonempty numeric vectors with the same number of elements.');
  end
  if ~isnumeric(p) || ~isscalar(p) || ~isfinite(p) || p < 0 || p >= 1
    error('Nelson:comet:invalidP', 'P must be a scalar value in the interval [0, 1).');
  end
  x = x(:).';
  y = y(:).';
  z = z(:).';
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = compass(varargin)
  narginchk(1, 1000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [parent, args] = graphicsParseParent(args);
  [u, v, lineSpec, colorSpec, markerSpec, propertiesList] = parseCompassArgs(args);
  % Each vector is drawn as a single arrow (shaft plus a two-segment head)
  % from the origin, scaled by the complex value it represents.
  arrow = [0; 1; 0.8 + 0.08i; 1; 0.8 - 0.08i];
  z = u + v .* 1i;
  a = arrow * z;
  if isempty(parent)
    ax = newplot();
  else
    ax = newplot(parent);
  end
  holdState = ishold(ax);
  maxr = max(abs(z));
  if isempty(maxr) || ~isfinite(maxr) || maxr <= 0
    maxr = 1;
  end
  if ~holdState
    hold(ax, 'on');
    drawCompassGrid(ax, maxr);
  end
  h = plot(ax, real(a), imag(a), lineSpec, propertiesList{:});
  if ~holdState
    set(ax, 'DataAspectRatio', [1 1 1]);
    axis(ax, 'off');
    hold(ax, 'off');
  end
  if isempty(colorSpec) && ~hasPropertyName(propertiesList, 'Color')
    colorOrder = get(ax, 'ColorOrder');
    if ~isempty(colorOrder)
      for k = 1:numel(h)
        h(k).Color = colorOrder(1, :);
      end
    end
  end
  if isempty(markerSpec) && ~hasPropertyName(propertiesList, 'Marker')
    for k = 1:numel(h)
      h(k).Marker = 'none';
    end
  end
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [u, v, lineSpec, colorSpec, markerSpec, propertiesList] = parseCompassArgs(args)
  if isempty(args)
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Value');
  end
  if numel(args) >= 2 && isnumeric(args{2})
    u = args{1};
    v = args{2};
    args = args(3:end);
  else
    if ~isnumeric(args{1})
      error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Value');
    end
    z = args{1};
    u = real(z);
    v = imag(z);
    args = args(2:end);
  end
  if numel(u) ~= numel(v)
    error('Nelson:dimagree:valueValueNumberElements', '%s and %s must have the same number of elements.', 'U', 'V');
  end
  if ~(isnumeric(u) && isnumeric(v))
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Value');
  end
  u = double(u(:).');
  v = double(v(:).');
  [lineSpec, colorSpec, markerSpec, propertiesList] = parseCompassLineSpec(args);
end
%=============================================================================
function [lineSpec, colorSpec, markerSpec, propertiesList] = parseCompassLineSpec(args)
  lineSpec = '-';
  colorSpec = '';
  markerSpec = '';
  if ~isempty(args) && (ischar(args{1}) || isStringScalar(args{1}))
    [~, colorSpec, markerSpec, msg] = colstyle(args{1}, 'plot', false);
    if isempty(msg)
      lineSpec = args{1};
      args = args(2:end);
    else
      colorSpec = '';
      markerSpec = '';
    end
  end
  if mod(numel(args), 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  propertiesList = args;
end
%=============================================================================
function drawCompassGrid(ax, dataMaxRadius)
  gridColor = [0.85 0.85 0.85];
  % Let the axes auto-scale a spanning segment to pick the radial tick step,
  % then reproduce the reference's radial grid layout from it.
  probe = line(ax, 'XData', [-dataMaxRadius dataMaxRadius NaN 0 0], ...
    'YData', [0 0 NaN -dataMaxRadius dataMaxRadius], ...
    'Color', gridColor, 'HandleVisibility', 'off');
  yLimits = get(ax, 'YLim');
  yTicks = get(ax, 'YTick');
  delete(probe);
  radiusMin = 0;
  radiusMax = yLimits(2);
  radiusTicks = max(yTicks);
  if radiusTicks > 5
    if rem(radiusTicks, 2) == 0
      radiusTicks = radiusTicks / 2;
    elseif rem(radiusTicks, 3) == 0
      radiusTicks = radiusTicks / 3;
    end
  end
  if ~isfinite(radiusTicks) || radiusTicks <= 0
    radiusTicks = 1;
  end
  if ~isfinite(radiusMax) || radiusMax <= 0
    radiusMax = dataMaxRadius;
  end
  % Unit circle, with the four axis-crossing points forced exactly onto the axes.
  th = 0:pi / 50:2 * pi;
  xUnit = cos(th);
  yUnit = sin(th);
  crossings = 1:(numel(th) - 1) / 4:numel(th);
  xUnit(crossings(2:2:4)) = 0;
  yUnit(crossings(1:2:5)) = 0;
  radiusStep = (radiusMax - radiusMin) / radiusTicks;
  for radius = (radiusMin + radiusStep):radiusStep:radiusMax
    line(ax, 'XData', xUnit * radius, 'YData', yUnit * radius, ...
      'LineStyle', '-', 'Color', gridColor, 'LineWidth', 1, 'HandleVisibility', 'off');
    text(ax, 0, radius + radiusStep / 20, ['  ' num2str(radius)], ...
      'VerticalAlignment', 'bottom', 'HandleVisibility', 'off');
  end
  % Radial spokes every 30 degrees, drawn as full diameters.
  spokeAngles = (1:6) * 2 * pi / 12;
  cosAngles = cos(spokeAngles);
  sinAngles = sin(spokeAngles);
  for k = 1:numel(spokeAngles)
    line(ax, 'XData', [-cosAngles(k) cosAngles(k)] * radiusMax, ...
      'YData', [-sinAngles(k) sinAngles(k)] * radiusMax, ...
      'LineStyle', '-', 'Color', gridColor, 'LineWidth', 1, 'HandleVisibility', 'off');
  end
  % Degree annotations around the outer rim.
  labelRadius = 1.1 * radiusMax;
  for k = 1:numel(spokeAngles)
    text(ax, labelRadius * cosAngles(k), labelRadius * sinAngles(k), int2str(k * 30), ...
      'HorizontalAlignment', 'center', 'HandleVisibility', 'off');
    if k == numel(spokeAngles)
      oppositeLabel = int2str(0);
    else
      oppositeLabel = int2str(180 + k * 30);
    end
    text(ax, -labelRadius * cosAngles(k), -labelRadius * sinAngles(k), oppositeLabel, ...
      'HorizontalAlignment', 'center', 'HandleVisibility', 'off');
  end
  view(ax, 2);
  axis(ax, radiusMax * [-1 1 -1.15 1.15]);
  xTicks = ceil(-radiusMax):floor(radiusMax);
  if ~isempty(xTicks)
    ax.XTick = xTicks;
  end
end
%=============================================================================
function tf = hasPropertyName(propertiesList, name)
  tf = false;
  for k = 1:2:numel(propertiesList)
    propertyName = propertiesList{k};
    if (ischar(propertyName) || isStringScalar(propertyName)) && strcmpi(propertyName, name)
      tf = true;
      return
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = compassplot(varargin)
  narginchk(1, 1000);
  nargoutchk(0, 1);
  args = convertStringToCharArgs(varargin);
  [ax, args] = parseCompassParent(args);
  [theta, radius, source, args] = parseCompassData(args);
  props = parseCompassProperties(args);
  [fig, previousDrawLater] = polarBeginDrawLater(ax);
  try
    ax = polarPrepareDataAxes(ax);
    [h, allHandles] = drawCompassVectors(ax, theta, radius, source, props);
    polarAppendDataHandles(ax, allHandles);
    polarEndDrawLater(fig, previousDrawLater);
  catch exception
    polarEndDrawLater(fig, previousDrawLater);
    error(exception.message);
  end
  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [ax, args] = parseCompassParent(args)
  if ~isempty(args) && isscalar(args{1}) && isgraphics(args{1})
    if ~isgraphics(args{1}, 'polaraxes')
      error('Nelson:graphics:invalidParentInput', 'Parent input must be a polaraxes object.');
    end
    ax = args{1};
    args = args(2:end);
    if isempty(args)
      error('Nelson:validators:mustBeVector', '%s must be a vector.', 'Value');
    end
    return
  end
  [ax, args] = polarParseTargetAxes(args);
end
%=============================================================================
function [theta, radius, source, args] = parseCompassData(args)
  source = struct('Table', [], 'ThetaVariable', [], 'RVariable', []);
  if isempty(args)
    error('Nelson:validators:mustBeVector', '%s must be a vector.', 'Value');
  end
  if (istable(args{1}) || istimetable(args{1})) && numel(args) >= 3
    [theta, radius, source] = parseCompassTableData(args);
    [theta, radius] = matchCompassData(theta, radius);
    args = args(4:end);
  elseif istable(args{1}) || istimetable(args{1})
    error('Nelson:validators:mustBeVector', '%s must be a vector.', 'Value');
  elseif isnumeric(args{1}) && (numel(args) == 1 || isCompassPropertyName(args{2}))
    z = args{1};
    theta = angle(z);
    radius = abs(z);
    args = args(2:end);
  elseif numel(args) >= 2 && isnumeric(args{1}) && isnumeric(args{2})
    theta = args{1};
    radius = args{2};
    [theta, radius] = matchCompassData(theta, radius);
    args = args(3:end);
  else
    error('Nelson:compassplot:numericVectorDataExpected', '%s must be a numeric vector.', 'Value');
  end
  if ~(isnumeric(theta) && isnumeric(radius)) || ~isreal(theta) || ~isreal(radius)
    error('Nelson:compassplot:numericRealVectorExpected', 'Numeric real vector data expected.');
  end
end
%=============================================================================
function [theta, radius, source] = parseCompassTableData(args)
  tbl = args{1};
  thetaNames = graphicsTableVariableNames(tbl, args{2});
  radiusNames = graphicsTableVariableNames(tbl, args{3});
  nSeries = max(numel(thetaNames), numel(radiusNames));
  validateTableVariableCounts(thetaNames, radiusNames, nSeries);
  [theta, radius, thetaVars, radiusVars] = compassTableSeries(tbl, thetaNames, radiusNames, nSeries);
  source = struct('Table', tbl, 'ThetaVariable', {thetaVars}, 'RVariable', {radiusVars});
end
%=============================================================================
function validateTableVariableCounts(thetaNames, radiusNames, nSeries)
  counts = [numel(thetaNames), numel(radiusNames)];
  if any(counts ~= 1 & counts ~= nSeries)
    error('Nelson:dimagree:tableVariableCountsMatch', 'Table variable counts must match.');
  end
end
%=============================================================================
function [theta, radius, thetaVars, radiusVars] = compassTableSeries(tbl, thetaNames, radiusNames, nSeries)
  theta = [];
  radius = [];
  thetaVars = cell(1, nSeries);
  radiusVars = cell(1, nSeries);
  for k = 1:nSeries
    thetaName = selectName(thetaNames, k);
    radiusName = selectName(radiusNames, k);
    theta = appendColumn(theta, numericColumn(tbl.(thetaName), thetaName));
    radius = appendColumn(radius, numericColumn(tbl.(radiusName), radiusName));
    thetaVars{k} = thetaName;
    radiusVars{k} = radiusName;
  end
end
%=============================================================================
function [theta, radius] = matchCompassData(theta, radius)
  if isvector(theta) && isvector(radius)
    if numel(theta) ~= numel(radius)
      error('Nelson:dimagree:valueValueNumberElements', '%s and %s must have the same number of elements.', 'Theta', 'R');
    end
    theta = theta(:);
    radius = radius(:);
    return
  end
  if isvector(theta) && ismatrix(radius)
    theta = expandCompassVector(theta, size(radius));
    return
  end
  if ismatrix(theta) && isvector(radius)
    radius = expandCompassVector(radius, size(theta));
    return
  end
  if ~isequal(size(theta), size(radius))
    error('Nelson:dimagree:thetaRCompatibleSizes', 'Theta and R must have compatible sizes.');
  end
end
%=============================================================================
function data = appendColumn(data, value)
  value = value(:);
  if isempty(data)
    data = value;
  else
    data = [data, value];
  end
end
%=============================================================================
function value = numericColumn(value, name)
  if ~isnumeric(value)
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', name);
  end
  value = value(:);
end
%=============================================================================
function name = selectName(names, k)
  if numel(names) == 1
    name = names{1};
  else
    name = names{k};
  end
end
%=============================================================================
function values = expandCompassVector(values, targetSize)
  n = numel(values);
  if n == targetSize(1)
    values = repmat(values(:), 1, targetSize(2));
  elseif n == targetSize(2)
    values = repmat(values(:).', targetSize(1), 1);
  else
    error('Nelson:dimagree:thetaRCompatibleSizes', 'Theta and R must have compatible sizes.');
  end
end
%=============================================================================
function props = parseCompassProperties(args)
  props = {};
  if isempty(args)
    return
  end
  if numel(args) == 1 && (ischar(args{1}) || isStringScalar(args{1}))
    props = {'Color', validatecolor(args{1})};
    return
  end
  if rem(length(args), 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  for k = 1:2:length(args)
    name = char(args{k});
    value = args{k + 1};
    switch lower(name)
      case {'color', 'linewidth', 'linestyle', 'displayname', 'visible', 'tag', 'userdata', ...
          'thetadatasource', 'rdatasource'}
        props = [props, {name, value}];
      otherwise
        error('Nelson:graphics:unsupportedProperty', 'Unsupported "%s" option.', 'compassplot');
    end
  end
end
%=============================================================================
function tf = isCompassPropertyName(value)
  tf = false;
  if ~(ischar(value) || isStringScalar(value))
    return
  end
  names = {'Color', 'LineWidth', 'LineStyle', 'DisplayName', 'Visible', 'Tag', 'UserData', ...
    'ThetaDataSource', 'RDataSource'};
  tf = any(strcmpi(char(value), names));
end
%=============================================================================
function [mainHandles, allHandles] = drawCompassVectors(ax, theta, radius, source, props)
  if isvector(theta)
    theta = theta(:);
    radius = radius(:);
  end
  mainHandles = gobjects(size(theta, 2), 1);
  allHandles = gobjects(0, 1);
  for k = 1:size(theta, 2)
    color = getColorAndUpdateIndex(ax);
    vectorProps = [{'Color', color}, props];
    sourceProps = {};
    if ~isempty(source.Table)
      sourceProps = {'SourceTable', source.Table, 'ThetaVariable', selectSourceName(source.ThetaVariable, k), ...
        'RVariable', selectSourceName(source.RVariable, k)};
    end
    mainHandles(k) = __compassplot__('Parent', ax, 'XData', [], 'YData', [], ...
      'ThetaData', theta(:, k), 'RData', radius(:, k), sourceProps{:}, vectorProps{:});
    allHandles = [allHandles; mainHandles(k)];
  end
end
%=============================================================================
function name = selectSourceName(names, k)
  if iscell(names)
    name = selectName(names, k);
  else
    name = names;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2026-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = coneplot(varargin)
  narginchk(6, 1000);
  nargoutchk(0, 1);

  args = convertStringToCharArgs(varargin);
  [parent, args] = graphicsParseParent(args);

  ax = graphicsAddTargetAxes(parent);
  if isempty(parent)
    container = ax;
  else
    container = parent;
  end

  [field, tail] = parseConeplotArgs(args);
  [options, propertyPairs] = parseConeplotTail(tail, field.referenceSize);
  field = resolveConeplotVectors(field, options);
  colorData = resolveConeplotColors(field, options);
  coneScale = coneplotAutoscale(field, options);

  if options.useQuiver
    if options.scaleSpecified
      quiverScale = options.scale;
    else
      quiverScale = 0;
    end
    if isempty(parent)
      h = quiver3(ax, field.x, field.y, field.z, field.u, field.v, field.w, ...
        quiverScale, propertyPairs{:});
    else
      h = quiver3(parent, field.x, field.y, field.z, field.u, field.v, field.w, ...
        quiverScale, propertyPairs{:});
    end
  else
    h = renderConeplotPatch(field.x, field.y, field.z, field.u, field.v, field.w, ...
      colorData, coneScale, container, propertyPairs);
  end

  view(ax, 3);
  grid(ax, 'on');
  h.UserData = struct('ChartType', 'coneplot', 'XData', field.x, 'YData', field.y, 'ZData', field.z);

  if nargout == 1
    varargout{1} = h;
  end
end
%=============================================================================
function [field, tail] = parseConeplotArgs(args)
  firstText = find(cellfun('isclass', args, 'char'), 1);
  if isempty(firstText)
    dataCount = numel(args);
    if dataCount < 6
      error('Nelson:notEnoughInputs', 'Not enough input arguments.');
    end
    if dataCount > 6 && dataCount < 9
      error('Nelson:wrongNumberOfInputs', 'Wrong number of input arguments.');
    end
    if dataCount > 9
      dataCount = 9;
    else
      dataCount = min(dataCount, 9);
    end
    dataArgs = args(1:dataCount);
    tail = args(dataCount + 1:end);
  else
    dataCount = firstText - 1;
    if dataCount < 6
      error('Nelson:notEnoughInputs', 'Not enough input arguments.');
    end
    if dataCount > 9
      error('Nelson:tooManyInputs', 'Too many input arguments.');
    end
    if dataCount ~= 6 && dataCount ~= 9
      error('Nelson:wrongNumberOfInputs', 'Wrong number of input arguments.');
    end
    dataArgs = args(1:dataCount);
    tail = args(firstText:end);
  end

  switch dataCount
    case 6
      field.x = dataArgs{1};
      field.y = dataArgs{2};
      field.z = dataArgs{3};
      field.u = dataArgs{4};
      field.v = dataArgs{5};
      field.w = dataArgs{6};
      field.interpEnabled = false;
      field.interpX = [];
      field.interpY = [];
      field.interpZ = [];
      field.interpU = [];
      field.interpV = [];
      field.interpW = [];
      field.referenceSize = size(field.u);
    case 9
      field.interpX = dataArgs{1};
      field.interpY = dataArgs{2};
      field.interpZ = dataArgs{3};
      field.interpU = dataArgs{4};
      field.interpV = dataArgs{5};
      field.interpW = dataArgs{6};
      [field.interpX, field.interpY, field.interpZ] = ...
        volumeGridVectors(field.interpX, field.interpY, field.interpZ, field.interpU);
      field.x = dataArgs{7};
      field.y = dataArgs{8};
      field.z = dataArgs{9};
      field.interpEnabled = true;
      field.u = field.interpU;
      field.v = field.interpV;
      field.w = field.interpW;
      field.referenceSize = size(field.interpU);
  end

  if field.interpEnabled
    validateConeplotData(field.interpX, field.interpY, field.interpZ, ...
      field.interpU, field.interpV, field.interpW);
    if ~isempty(field.x) && ~(isequal(size(field.x), size(field.y)) ...
        && isequal(size(field.x), size(field.z)))
      error('Nelson:wrongNumberOfInputs', 'Wrong number of input arguments.');
    end
  else
    validateConeplotData(field.x, field.y, field.z, field.u, field.v, field.w);
  end

  if ~(isequal(size(field.u), size(field.v)) && isequal(size(field.u), size(field.w)))
    error('Nelson:dimagree:vectorComponentSizesMatch', 'Vector component sizes must match.');
  end

end
%=============================================================================
function [options, propertyPairs] = parseConeplotTail(tail, referenceSize)
  options.scale = 1;
  options.scaleSpecified = false;
  options.method = 'linear';
  options.interpolate = true;
  options.color = [];
  options.useQuiver = false;

  k = 1;
  while k <= numel(tail)
    current = tail{k};
    if isTextScalar(current)
      key = lower(current);
      switch key
        case 'quiver'
          options.useQuiver = true;
          k = k + 1;
        case 'nointerp'
          options.interpolate = false;
          k = k + 1;
        case {'linear', 'cubic', 'nearest'}
          options.method = key;
          k = k + 1;
        otherwise
          break
      end
    elseif isscalar(current)
      options.scale = double(current);
      options.scaleSpecified = true;
      k = k + 1;
      continue
    elseif isNumericColor(current, referenceSize)
      options.color = current;
      k = k + 1;
    else
      break
    end
  end

  if mod(numel(tail) - k + 1, 2) ~= 0
    error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
  end
  propertyPairs = tail(k:end);
  if options.useQuiver
    return
  end
  for k = 1:2:length(propertyPairs)
    if ~isTextScalar(propertyPairs{k}) || ...
        ~ isValidGraphicsProperty('patch', propertyPairs{k})
      error('Nelson:graphics:nameValueArgumentsExpected', 'Name-value arguments expected.');
    end
  end
end
%=============================================================================
function field = resolveConeplotVectors(field, options)
  if ~field.interpEnabled
    return
  end
  if ~options.interpolate
    if ~isequal(size(field.u), size(field.x))
      error('Nelson:wrongNumberOfInputs', 'Wrong number of input arguments.');
    end
    return
  end
  field.u = interp3(field.interpX, field.interpY, field.interpZ, field.interpU, ...
    field.x, field.y, field.z, options.method, 0);
  field.v = interp3(field.interpX, field.interpY, field.interpZ, field.interpV, ...
    field.x, field.y, field.z, options.method, 0);
  field.w = interp3(field.interpX, field.interpY, field.interpZ, field.interpW, ...
    field.x, field.y, field.z, options.method, 0);
end
%=============================================================================
function colorData = resolveConeplotColors(field, options)
  colorData = [];
  if isempty(options.color)
    return
  end
  if field.interpEnabled && options.interpolate
    colorData = interp3(field.interpX, field.interpY, field.interpZ, options.color, ...
      field.x, field.y, field.z, options.method, NaN);
  else
    colorData = options.color;
  end
end
%=============================================================================
function h = renderConeplotPatch(x, y, z, u, v, w, colorData, coneScale, container, propertyPairs)
  [x, y, z, u, v, w, colorData] = vectorizeConeplotData(x, y, z, u, v, w, colorData);
  if isempty(x) || all(u == 0 & v == 0 & w == 0)
    h = patch('Parent', container, 'Faces', zeros(0, 3), 'Vertices', zeros(0, 3), propertyPairs{:});
    return
  end

  lengths = sqrt(u .^ 2 + v .^ 2 + w .^ 2);
  valid = isfinite(lengths) & (lengths > 0);
  if ~any(valid)
    h = patch('Parent', container, 'Faces', zeros(0, 3), 'Vertices', zeros(0, 3), propertyPairs{:});
    return
  end
  x = x(valid);
  y = y(valid);
  z = z(valid);
  u = u(valid);
  v = v(valid);
  w = w(valid);
  lengths = lengths(valid);
  if ~isempty(colorData)
    colorData = colorData(valid);
    if numel(colorData) ~= numel(u)
      error('Nelson:wrongNumberOfInputs', 'Wrong number of input arguments.');
    end
  end

  [templateVertices, templateFaces] = coneTemplateMesh();
  [nbCones, vertexCount, faceCount] = computeConeSizes(x, templateVertices, templateFaces);
  if nbCones == 0
    h = patch('Parent', container, 'Faces', zeros(0, 3), 'Vertices', zeros(0, 3), propertyPairs{:});
    return
  end

  vertices = zeros(nbCones * vertexCount, 3);
  faces = zeros(nbCones * faceCount, 3);
  if ~isempty(colorData)
    colorPerVertex = zeros(nbCones * vertexCount, 1);
  else
    colorPerVertex = [];
  end

  coneWidth = 0.333;
  for k = 1:nbCones
    direction = [u(k), v(k), w(k)] / lengths(k);
    localHeight = lengths(k) * coneScale;
    radius = 0.5 * coneWidth * localHeight;
    localVertices = templateVertices;
    localVertices(:, 1) = localVertices(:, 1) * radius;
    localVertices(:, 2) = localVertices(:, 2) * radius;
    localVertices(:, 3) = localVertices(:, 3) * localHeight;
    localVertices = (rotationToZAxis(direction) * localVertices')' + [x(k), y(k), z(k)];

    vertexOffset = (k - 1) * vertexCount;
    faceOffset = (k - 1) * faceCount;
    vertices(vertexOffset + (1:vertexCount), :) = localVertices;
    faces(faceOffset + (1:faceCount), :) = templateFaces + vertexOffset;
    if ~isempty(colorPerVertex)
      colorPerVertex(vertexOffset + (1:vertexCount)) = colorData(k);
    end
  end

  patchArgs = {'Parent', container, 'Faces', faces, 'Vertices', vertices};
  if ~isempty(colorPerVertex)
    if ~hasProperty(propertyPairs, 'CData') && ~hasProperty(propertyPairs, 'FaceVertexCData') ...
        && ~hasProperty(propertyPairs, 'FaceColor')
      patchArgs = [patchArgs, {'FaceColor', 'interp', 'FaceVertexCData', colorPerVertex}];
    end
  end
  patchArgs = [patchArgs, propertyPairs];
  h = patch(patchArgs{:});
end
%=============================================================================
function [x, y, z, u, v, w, colorData] = vectorizeConeplotData(x, y, z, u, v, w, colorData)
  if ~(isnumeric(x) && isnumeric(y) && isnumeric(z) && isnumeric(u) && isnumeric(v) && isnumeric(w))
    error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Value');
  end
  x = x(:);
  y = y(:);
  z = z(:);
  u = u(:);
  v = v(:);
  w = w(:);
  if ~isempty(colorData)
    colorData = colorData(:);
  end
end
%=============================================================================
function [nbCones, vertexCount, faceCount] = computeConeSizes(x, templateVertices, templateFaces)
  nbCones = numel(x);
  vertexCount = size(templateVertices, 1);
  faceCount = size(templateFaces, 1);
end
%=============================================================================
function [templateVertices, templateFaces] = coneTemplateMesh()
  n = 12;
  theta = linspace(0, 2 * pi, n + 1);
  circleX = cos(theta(1:n))';
  circleY = sin(theta(1:n))';
  circleZ = zeros(n, 1);
  tip = [0, 0, 1];
  center = [0, 0, 0];
  templateVertices = [circleX, circleY, circleZ; center; tip];
  templateFaces = zeros(2 * n, 3);
  for k = 1:n
    k2 = k + 1;
    if k2 > n
      k2 = 1;
    end
    templateFaces(k, :) = [n + 2, k, k2];
    templateFaces(k + n, :) = [n + 1, k2, k];
  end
end
%=============================================================================
function R = rotationToZAxis(direction)
  epsilon = 1.0e-12;
  if abs(direction(3) - 1) < epsilon
    R = eye(3);
    return
  end
  if abs(direction(3) + 1) < epsilon
    R = [-1, 0, 0; 0, -1, 0; 0, 0, 1];
    return
  end
  axis = cross([0 0 1], direction);
  s = norm(axis);
  if s < epsilon
    R = eye(3);
    return
  end
  axis = axis / s;
  c = direction(3);
  K = [0, -axis(3), axis(2); axis(3), 0, -axis(1); -axis(2), axis(1), 0];
  R = eye(3) + K + (K * K) * (1 - c) / (s ^ 2);
end
%=============================================================================
function coneScale = coneplotAutoscale(field, options)
  scaleArg = options.scale;
  if scaleArg == 0
    coneScale = 1;
    return
  end
  if field.interpEnabled && options.interpolate
    gridX = field.interpX;
    gridY = field.interpY;
    gridZ = field.interpZ;
    fieldU = field.interpU;
    fieldV = field.interpV;
    fieldW = field.interpW;
  else
    gridX = field.x;
    gridY = field.y;
    gridZ = field.z;
    fieldU = field.u;
    fieldV = field.v;
    fieldW = field.w;
  end
  sz = size(fieldU);
  nbRows = sz(1);
  if numel(sz) >= 2
    nbCols = sz(2);
  else
    nbCols = 1;
  end
  if numel(sz) >= 3
    nbPages = sz(3);
  else
    nbPages = 1;
  end
  if isempty(gridX)
    dx = nbCols - 1;
    dy = nbRows - 1;
    dz = nbPages - 1;
  else
    dx = max(gridX(:)) - min(gridX(:));
    dy = max(gridY(:)) - min(gridY(:));
    dz = max(gridZ(:)) - min(gridZ(:));
  end
  delx = dx / nbCols;
  dely = dy / nbRows;
  delz = dz / nbPages;
  del = sqrt(delx .^ 2 + dely .^ 2 + delz .^ 2);
  coneScale = scaleArg;
  if del ~= 0
    lengths = sqrt((fieldU(:) / del) .^ 2 + (fieldV(:) / del) .^ 2 + (fieldW(:) / del) .^ 2);
    maxLength = max(lengths(isfinite(lengths)));
    if isempty(maxLength) || maxLength == 0
      coneScale = 0;
    else
      coneScale = scaleArg / maxLength;
    end
  end
end
%=============================================================================
function validateConeplotData(x, y, z, u, v, w)
  values = {x, y, z, u, v, w};
  for k = 1:numel(values)
    if ~isnumeric(values{k})
      error('Nelson:validators:mustBeNumeric', '%s must be numeric.', 'Value');
    end
  end
  if ~(isequal(size(u), size(v)) && isequal(size(u), size(w)))
    error('Nelson:dimagree:vectorComponentSizesMatch', 'Vector component sizes must match.');
  end
  validateConeplotCoordinateSize(x, size(u), 'X');
  validateConeplotCoordinateSize(y, size(u), 'Y');
  validateConeplotCoordinateSize(z, size(u), 'Z');
end
%=============================================================================
function validateConeplotCoordinateSize(value, targetSize, axisName)
  if isscalar(value) || isequal(size(value), targetSize)
    return
  end
  if isvector(value) && (numel(value) == targetSize(1) || ...
      numel(value) == targetSize(2) || numel(value) == prod(targetSize))
    return
  end
  error('Nelson:graphics:componentDataSizeMismatch', '%s must match vector component size.', axisName);
end
%=============================================================================
function tf = isNumericColor(value, referenceSize)
  tf = false;
  if ~isnumeric(value)
    return
  end
  if isscalar(value)
    return
  end
  if isequal(size(value), referenceSize)
    tf = true;
    return
  end
  if numel(value) == prod(referenceSize)
    tf = true;
  end
end
%=============================================================================
function has = hasProperty(propertyPairs, name)
  has = false;
  if isempty(propertyPairs)
    return
  end
  for k = 1:2:length(propertyPairs)
    if isTextScalar(propertyPairs{k}) && strcmpi(propertyPairs{k}, name)
      has = true;
      return
    end
  end
end
%=============================================================================
function tf = isTextScalar(value)
  tf = ischar(value) || isStringScalar(value);
end
