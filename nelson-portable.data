% LICENCE_BLOCK_END
%=============================================================================
function args = jsonTableArgs(nameValues)
  % Parses the JSON name-value arguments of readtable, readtimetable and
  % detectImportOptions. Import options properties are validated by
  % JSONImportOptions; TableNodeName, TextType and FileType are handled here.
  if mod(numel(nameValues), 2) ~= 0
    error('Nelson:spreadsheet:nameValueNotPaired', 'Name-value arguments must be paired.');
  end
  args.TableNodeName = '';
  args.TextType = 'string';
  args.Set = {};
  optionArgs = {};
  supported = {'FileType', 'TableNodeName', 'TextType', 'ParsingMode', 'VariableSelectors', ...
    'TableSelector', 'RowNamesSelector', 'VariableUnitsSelector', 'VariableDescriptionsSelector', ...
    'RepeatedNodeRule', 'AllowComments', 'AllowInfAndNaN', 'AllowTrailingCommas', ...
    'MissingRule', 'ImportErrorRule', 'VariableNamingRule'};
  for k = 1:2:numel(nameValues)
    name = nameValues{k};
    if ~((ischar(name) && isrow(name)) || (isstring(name) && isscalar(name)))
      error('Nelson:spreadsheet:invalidParameterName', 'Invalid parameter name. The parameter name must be a nonempty string or character array.');
    end
    match = strcmpi(supported, char(name));
    if ~any(match)
      error('Nelson:spreadsheet:propertyNotSupported', 'Property name not supported.');
    end
    name = supported{match};
    value = nameValues{k + 1};
    switch name
      case 'FileType'
        if ~strcmpi(value, 'json')
          error('Nelson:spreadsheet:fileTypeNotSupported', 'FileType not supported.');
        end
      case 'TableNodeName'
        args.TableNodeName = char(value);
      case 'TextType'
        args.TextType = lower(char(value));
        if ~any(strcmp(args.TextType, {'char', 'string'}))
          error('Nelson:spreadsheet:textTypeNotSupported', 'TextType not supported.');
        end
      otherwise
        optionArgs = [optionArgs, {name, value}];
        args.Set{end + 1} = name;
    end
  end
  args.Options = nelson.io.json.JSONImportOptions(optionArgs{:});
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function cache = jsonTableCache(root, rootIsArray, selector, columns)
  % Rows of the table node selected by 'selector': the decoded rows
  % (Rows, Keys, see jsonTableRows) or, when 'columns' is not empty, the
  % columns decoded by __jsondecode_columns__ (Columnar).
  % Columns and Vectors receive the variables extracted by jsonTableDetect.
  cache.Columnar = columns;
  cache.Rows = [];
  cache.Keys = {};
  cache.Columns = {};
  cache.Vectors = {};
  if ~isempty(columns)
    cache.Count = numel(columns.Columns{1});
    return
  end
  [node, found] = jsonPointerGet(root, selector);
  if ~found
    error('Nelson:spreadsheet:jsonPointerNotFound', 'JSON Pointer not found: %s', selector);
  end
  [cache.Rows, cache.Keys] = jsonTableRows(node, isempty(selector) && rootIsArray);
  cache.Count = numel(cache.Rows);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [values, vector] = jsonTableColumn(cache, pointer)
  % Extracts, for each row of the table node (cache, see jsonTableCache),
  % the decoded value selected by a JSON Pointer relative to the row.
  % Absent nodes are returned as [] (n x 1 cell).
  % When every selected value is one number or one logical, 'vector' holds
  % them (n x 1) and 'values' is empty: no per-row cell is built.
  % Text only columns decoded by __jsondecode_columns__ are string arrays.
  rows = cache.Rows;
  keys = cache.Keys;
  n = cache.Count;
  vector = [];
  if strcmp(pointer, 'Keys')
    if isempty(keys)
      values = cellstr(string((0:n - 1)'));
    else
      values = keys(:);
    end
    return
  end
  tokens = jsonPointerTokens(pointer);
  if ~isempty(cache.Columnar)
    [values, vector] = fromColumns(cache.Columnar, tokens{1}, n);
  elseif isempty(tokens)
    if iscell(rows)
      values = rows;
    else
      values = num2cell(rows);
    end
  elseif isstruct(rows)
    [values, vector] = fromStructArray(rows, tokens);
  else
    values = fromCellRows(rows, tokens);
  end
end
%=============================================================================
function [values, vector] = fromColumns(columnar, key, n)
  % one top-level key (see jsonTableColumnar)
  values = {};
  vector = [];
  index = find(strcmp(columnar.Names, jsonFieldName(columnar.Names, key)), 1);
  if isempty(index)
    values = cell(n, 1);
  elseif isnumeric(columnar.Columns{index}) || islogical(columnar.Columns{index})
    vector = columnar.Columns{index};
  else
    values = columnar.Columns{index};
  end
end
%=============================================================================
function [values, vector] = fromStructArray(rows, tokens)
  vector = [];
  name = jsonFieldName(rows, tokens{1});
  if isempty(name)
    values = cell(numel(rows), 1);
    return
  end
  if isscalar(tokens)
    [vector, ok] = jsonFastVector(rows, name);
    if ok
      values = {};
      return
    end
  end
  values = {rows.(name)}';
  if isscalar(tokens)
    return
  end
  isObject = cellfun('isclass', values, 'struct') & cellfun('prodofsize', values) == 1;
  if all(isObject)
    try
      [values, vector] = fromStructArray(vertcat(values{:}), tokens(2:end));
      return
    catch
    end
  end
  values = fromCellRows(values, tokens(2:end));
end
%=============================================================================
function values = fromCellRows(rows, tokens)
  values = cell(numel(rows), 1);
  for k = 1:numel(rows)
    values{k} = jsonPointerGet(rows{k}, tokens);
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function location = jsonTableColumnar(opts, tableNodeName, selectorSet)
  % Arguments of __jsondecode_columns__ locating the table node as
  % jsonTableDetect does (TableSelector when 'selectorSet', else
  % TableNodeName, else the automatic search), or {} when the table cannot
  % be read from decoded columns: metadata selector, variables or row names
  % not selected by top-level keys, TableSelector not a JSON Pointer.
  location = {};
  if ~isempty(opts.VariableUnitsSelector) || ~isempty(opts.VariableDescriptionsSelector) ...
      || ~(isempty(opts.RowNamesSelector) || isTopLevel(opts.RowNamesSelector))
    return
  end
  selectors = opts.VariableSelectors;
  for k = 1:numel(selectors)
    if ~isTopLevel(selectors{k})
      return
    end
  end
  selector = char(opts.TableSelector);
  if selectorSet && isempty(selector)
    location = {'root'};
  elseif selectorSet
    if selector(1) == '/'
      location = {'pointer', jsonPointerTokens(selector)};
    end
  elseif ~isempty(tableNodeName)
    location = {'name', tableNodeName};
  else
    location = {'auto'};
  end
end
%=============================================================================
function tf = isTopLevel(pointer)
  pointer = char(pointer);
  tf = strcmp(pointer, 'Keys') || (numel(pointer) > 1 && pointer(1) == '/' && ~any(pointer(2:end) == '/'));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [column, missing, bad] = jsonTableConvert(values, vector, type, repeatedRule)
  % Converts decoded JSON values (n x 1 cell) into a table variable of the
  % requested type. JSON arrays (repeated nodes) become matrix columns
  % ('addcol'), keep their first element ('ignore') or raise an error.
  % missing: absent or null nodes; bad: values that cannot be converted.
  % 'vector' (n x 1 numbers or logicals, values empty) is the fast path.
  if isempty(values) && ~isempty(vector)
    if any(strcmp(type, {'double', 'single', 'int8', 'int16', 'int32', 'int64', ...
        'uint8', 'uint16', 'uint32', 'uint64', 'logical'}))
      [column, missing, bad] = fromVector(vector, type);
      return
    end
    values = num2cell(vector);
  end
  if isstring(values)
    % text only column (no null, no absent node)
    missing = false(size(values));
    bad = missing;
    switch type
      case {'string', 'datetime', 'duration'}
        column = values;
        return
      case 'char'
        column = cellstr(values);
        return
      case 'categorical'
        column = categorical(values);
        return
    end
    values = cellstr(values);
  end
  n = numel(values);
  counts = cellfun('prodofsize', values);
  isDouble = cellfun('isclass', values, 'double');
  isLogical = cellfun('isclass', values, 'logical');
  isText = cellfun('isclass', values, 'char');
  isCellText = cellfun('isclass', values, 'cell');
  missing = isDouble & counts == 0;
  isText = isText & ~missing;
  counts(isText) = 1;
  if strcmp(repeatedRule, 'error') && any(counts > 1)
    error('Nelson:spreadsheet:jsonRepeatedNode', 'Repeated JSON nodes found (RepeatedNodeRule is ''error'').');
  end
  width = max([1; counts(:)]);
  if strcmp(repeatedRule, 'ignore')
    width = 1;
  end
  switch type
    case {'double', 'single', 'int8', 'int16', 'int32', 'int64', 'uint8', 'uint16', 'uint32', 'uint64'}
      [column, bad] = toNumeric(values, isDouble | isLogical, isText, counts, width);
      if ~strcmp(type, 'double')
        column = cast(column, type);
      end
    case 'logical'
      [column, bad] = toNumeric(values, isDouble | isLogical, false(n, 1), counts, width);
      bad = bad | any(~isnan(column) & column ~= 0 & column ~= 1, 2);
      column(isnan(column)) = 0;
      column = logical(column);
    case {'string', 'char', 'categorical', 'datetime', 'duration'}
      [column, bad] = toText(values, isText, isCellText, isDouble | isLogical, width);
      if strcmp(type, 'char')
        column(ismissing(column)) = "";
        column = cellstr(column);
      elseif strcmp(type, 'categorical')
        column = categorical(column);
      end
    otherwise
      column = values;
      bad = false(n, 1);
  end
end
%=============================================================================
function [column, missing, bad] = fromVector(vector, type)
  missing = false(size(vector));
  bad = false(size(vector));
  if strcmp(type, 'logical')
    bad = vector ~= 0 & vector ~= 1;
    column = logical(vector ~= 0);
  else
    column = cast(vector, type);
  end
end
%=============================================================================
function [column, bad] = toNumeric(values, isNumber, isText, counts, width)
  n = numel(values);
  column = NaN(n, width);
  bad = ~isNumber & ~isText & counts > 0;
  scalarRows = isNumber & counts == 1;
  if any(scalarRows)
    column(scalarRows, 1) = double([values{scalarRows}]');
  end
  if any(isText)
    parsed = str2double(values(isText));
    textRows = find(isText);
    column(textRows, 1) = parsed;
    bad(textRows(isnan(parsed) & ~strcmpi(values(isText), 'NaN'))) = true;
  end
  multiple = find(isNumber & counts > 1)';
  for k = multiple
    row = values{k};
    row = double(row(:)');
    m = min(numel(row), width);
    column(k, 1:m) = row(1:m);
  end
end
%=============================================================================
function [column, bad] = toText(values, isText, isCellText, isNumber, width)
  n = numel(values);
  column = repmat(string(missing), n, width);
  bad = false(n, 1);
  if all(isText)
    column(:, 1) = string(values);
    return
  elseif any(isText)
    column(isText, 1) = string(values(isText));
  end
  numbers = find(isNumber & cellfun('prodofsize', values) == 1)';
  for k = numbers
    column(k, 1) = string(values{k});
  end
  cells = find(isCellText)';
  for k = cells
    entries = values{k};
    entries = entries(:)';
    entries = entries(1:min(numel(entries), width));
    if iscellstr(entries)
      column(k, 1:numel(entries)) = string(entries);
    else
      bad(k) = true;
    end
  end
  bad = bad | (~isText & ~isCellText & ~isNumber & cellfun('prodofsize', values) > 0);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [root, rootIsArray, columns] = jsonTableDecode(filename, flags, location)
  % Reads a JSON file and decodes it with jsondecode.
  % flags: AllowComments, AllowInfAndNaN, AllowTrailingCommas (lenient extensions).
  % With a table 'location' (see jsonTableColumnar), a table node made of
  % flat objects is decoded straight into columns (Names, Columns and the
  % Selector of the node, see __jsondecode_columns__) and root is not
  % built; otherwise 'columns' is empty.
  if ~isfile(filename)
    error('Nelson:spreadsheet:fileNotFound', 'File not found: %s', filename);
  end
  columns = [];
  if ~isempty(location)
    [ok, names, values, selector] = __jsondecode_columns__(filename, location{:});
    if ok
      % strict JSON: the lenient extensions below have nothing to change
      root = [];
      rootIsArray = false;
      columns = struct('Names', {names}, 'Columns', {values}, 'Selector', selector);
      return
    end
  end
  txt = fileread(filename, 'char', 'native', 'UTF-8');
  stringPattern = '"(?:[^"\x5c]|\x5c.)*"';
  txt = handleComments(txt, stringPattern, flags.AllowComments);
  txt = handleTrailingCommas(txt, stringPattern, flags.AllowTrailingCommas);
  txt = handleInfAndNaN(txt, stringPattern, flags.AllowInfAndNaN);
  first = regexp(txt, '\S', 'match', 'once');
  rootIsArray = strcmp(first, '[');
  root = jsondecode(txt);
end
%=============================================================================
function txt = handleComments(txt, stringPattern, allowed)
  if isempty(strfind(txt, '//')) && isempty(strfind(txt, '/*'))
    return
  end
  stripped = regexprep(txt, ['(', stringPattern, ')|//[^\n]*|/\*.*?\*/'], '$1');
  if isequal(stripped, txt)
    return
  end
  if ~allowed
    error('Nelson:spreadsheet:jsonCommentsNotAllowed', 'Comments are not allowed in the JSON file (AllowComments is false).');
  end
  txt = stripped;
end
%=============================================================================
function txt = handleTrailingCommas(txt, stringPattern, allowed)
  if isempty(regexp(txt, ',\s*[\]}]', 'once'))
    return
  end
  fixed = regexprep(txt, ['(', stringPattern, ')|,(\s*[\]}])'], '$1$2');
  if isequal(fixed, txt)
    return
  end
  if ~allowed
    error('Nelson:spreadsheet:jsonTrailingCommasNotAllowed', 'Trailing commas are not allowed in the JSON file (AllowTrailingCommas is false).');
  end
  txt = fixed;
end
%=============================================================================
function txt = handleInfAndNaN(txt, stringPattern, allowed)
  if isempty(regexp(txt, '(NaN|Inf)', 'once'))
    return
  end
  [outside, inside] = regexp(txt, stringPattern, 'split', 'match');
  found = ~cellfun('isempty', regexp(outside, '[\[:,]\s*[-+]?(NaN|Inf)', 'once'));
  if ~any(found)
    return
  end
  if ~allowed
    error('Nelson:spreadsheet:jsonInfAndNaNNotAllowed', 'Inf and NaN values are not allowed in the JSON file (AllowInfAndNaN is false).');
  end
  if isempty(strfind(txt, 'Infinity'))
    return
  end
  outside = regexprep(outside, 'Infinity', 'Inf');
  parts = [outside; [inside, {''}]];
  txt = [parts{:}];
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [opts, cache] = jsonTableDetect(root, rootIsArray, args, columns)
  % Detects the JSON table layout: table node, variables (JSON Pointers),
  % names and types. Returns a JSONImportOptions object and the decoded
  % rows and columns (cache) so that a following read does not redo them.
  % 'columns': see jsonTableDecode.
  opts = args.Options;
  if any(strcmp(args.Set, 'TableSelector'))
    selector = opts.TableSelector;
  elseif ~isempty(columns)
    selector = columns.Selector;
  elseif ~isempty(args.TableNodeName)
    selector = findNode(root, '', args.TableNodeName, true);
    if isempty(selector)
      error('Nelson:spreadsheet:jsonKeyNotFound', 'JSON key not found: %s', args.TableNodeName);
    end
  elseif rootIsArray
    selector = '';
  else
    selector = findNode(root, '', '', false);
  end
  cache = jsonTableCache(root, rootIsArray, selector, columns);
  if any(strcmp(args.Set, 'VariableSelectors'))
    selectors = opts.VariableSelectors;
  else
    selectors = jsonTableLeaves(cache);
    selectors = selectors(~strcmp(selectors, opts.RowNamesSelector));
  end
  cache.Columns = cell(1, numel(selectors));
  cache.Vectors = cell(1, numel(selectors));
  types = cell(1, numel(selectors));
  for k = 1:numel(selectors)
    [cache.Columns{k}, cache.Vectors{k}] = jsonTableColumn(cache, selectors{k});
    types{k} = detectType(cache.Columns{k}, cache.Vectors{k}, args.TextType);
  end
  names = variableNames(selectors, opts.VariableNamingRule);
  opts.VariableSelectors = selectors;
  opts.VariableNames = names;
  opts.VariableTypes = types;
  opts.SelectedVariableNames = names;
  opts.TableSelector = selector;
end
%=============================================================================
function pointer = findNode(value, prefix, key, byName)
  % Depth-first search of the first array of objects (or of the key 'key').
  pointer = '';
  if ~isstruct(value) || ~isscalar(value)
    return
  end
  if byName && ~isempty(jsonFieldName(value, key))
    pointer = [prefix, '/', jsonFieldName(value, key)];
    return
  end
  names = fieldnames(value);
  for k = 1:numel(names)
    child = value.(names{k});
    childPointer = [prefix, '/', names{k}];
    if ~byName && isArrayOfObjects(child)
      pointer = childPointer;
      return
    end
    pointer = findNode(child, childPointer, key, byName);
    if ~isempty(pointer)
      return
    end
  end
end
%=============================================================================
function tf = isArrayOfObjects(value)
  tf = (isstruct(value) && ~isscalar(value)) || ...
    (iscell(value) && ~isempty(value) && all(cellfun('isclass', value, 'struct')));
end
%=============================================================================
function type = detectType(values, vector, textType)
  if islogical(vector) && ~isempty(vector)
    type = 'logical';
    return
  end
  if ~isempty(vector)
    type = 'double';
    return
  end
  if isstring(values)
    type = textType;
    return
  end
  counts = cellfun('prodofsize', values);
  isDouble = cellfun('isclass', values, 'double');
  present = ~(isDouble & counts == 0);
  if ~any(present)
    type = 'double';
  elseif all(isDouble(present) | cellfun('isclass', values(present), 'logical'))
    if all(cellfun('isclass', values(present), 'logical'))
      type = 'logical';
    else
      type = 'double';
    end
  elseif all(cellfun('isclass', values(present), 'char') | cellfun('isclass', values(present), 'cell'))
    type = textType;
  else
    type = 'cell';
  end
end
%=============================================================================
function names = variableNames(selectors, namingRule)
  names = cell(1, numel(selectors));
  for k = 1:numel(selectors)
    if strcmp(selectors{k}, 'Keys')
      names{k} = 'Keys';
      continue
    end
    tokens = jsonPointerTokens(selectors{k});
    if isempty(tokens)
      names{k} = sprintf('Var%d', k);
    else
      names{k} = tokens{end};
    end
  end
  if strcmp(namingRule, 'modify')
    names = regexprep(names, '[^a-zA-Z_0-9]', '_');
  end
  for k = 2:numel(names)
    base = names{k};
    suffix = 0;
    while any(strcmp(names(1:k - 1), names{k}))
      suffix = suffix + 1;
      names{k} = sprintf('%s_%d', base, suffix);
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function pointers = jsonTableLeaves(cache)
  % Detects the table variables as JSON Pointers to the leaf nodes of the
  % row objects (cache, see jsonTableCache). Nested objects are flattened,
  % keys keep their first appearance order. Rows that are not objects give
  % a single variable.
  if ~isempty(cache.Columnar)
    pointers = strcat('/', escapeKey(cache.Columnar.Names));
    return
  end
  rows = cache.Rows;
  if isstruct(rows)
    pointers = structLeaves(rows, '');
  elseif iscell(rows) && any(cellfun('isclass', rows, 'struct'))
    pointers = cellLeaves(rows, '');
  else
    pointers = {''};
  end
end
%=============================================================================
function pointers = structLeaves(rows, prefix)
  pointers = {};
  names = fieldnames(rows);
  for k = 1:numel(names)
    pointer = [prefix, '/', escapeKey(names{k})];
    [~, isVector] = jsonFastVector(rows, names{k});
    if isVector
      pointers = [pointers, {pointer}];
    else
      pointers = [pointers, valueLeaves({rows.(names{k})}', pointer)];
    end
  end
end
%=============================================================================
function pointers = cellLeaves(rows, prefix)
  names = {};
  for k = 1:numel(rows)
    if isstruct(rows{k}) && isscalar(rows{k})
      rowNames = fieldnames(rows{k});
      names = [names; rowNames(~ismember(rowNames, names))];
    end
  end
  pointers = {};
  for k = 1:numel(names)
    values = cell(numel(rows), 1);
    for r = 1:numel(rows)
      if isstruct(rows{r}) && isscalar(rows{r}) && isfield(rows{r}, names{k})
        values{r} = rows{r}.(names{k});
      end
    end
    pointers = [pointers, valueLeaves(values, [prefix, '/', escapeKey(names{k})])];
  end
end
%=============================================================================
function pointers = valueLeaves(values, pointer)
  isObject = cellfun('isclass', values, 'struct') & cellfun('prodofsize', values) == 1;
  isNull = cellfun('isclass', values, 'double') & cellfun('isempty', values);
  if ~any(isObject) || ~all(isObject | isNull)
    pointers = {pointer};
    return
  end
  if all(isObject)
    try
      pointers = structLeaves(vertcat(values{:}), pointer);
      return
    catch
    end
  end
  pointers = cellLeaves(values(isObject), pointer);
end
%=============================================================================
function key = escapeKey(key)
  key = strrep(strrep(key, '~', '~0'), '/', '~1');
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function T = jsonTableRead(root, opts, cache)
  % Builds the table described by a JSONImportOptions object from the
  % decoded JSON document and the rows of its table node (cache, see
  % jsonTableCache) with the columns already extracted by jsonTableDetect.
  [selectors, names, types, selectedNames] = resolveVariables(opts, cache);
  selected = find(ismember(names, selectedNames));
  n = cache.Count;
  columns = cell(1, numel(selected));
  missingRows = false(n, 1);
  keep = true(1, numel(selected));
  for k = 1:numel(selected)
    index = selected(k);
    if index <= numel(cache.Columns)
      values = cache.Columns{index};
      vector = cache.Vectors{index};
    else
      [values, vector] = jsonTableColumn(cache, selectors{index});
    end
    [columns{k}, missing, bad] = jsonTableConvert(values, vector, types{index}, opts.RepeatedNodeRule);
    [missingRows, keepMissing] = applyRule(opts.MissingRule, missing, missingRows, names{index}, 'missing');
    [missingRows, keepValid] = applyRule(opts.ImportErrorRule, bad, missingRows, names{index}, 'conversion');
    keep(k) = keepMissing && keepValid;
  end
  rowNames = {};
  if ~isempty(opts.RowNamesSelector)
    [values, vector] = jsonTableColumn(cache, opts.RowNamesSelector);
    [rowNames, missing] = jsonTableConvert(values, vector, 'char', 'ignore');
    missingRows = missingRows | missing;
  end
  columns = columns(keep);
  selected = selected(keep);
  if any(missingRows)
    for k = 1:numel(columns)
      columns{k} = columns{k}(~missingRows, :);
    end
    if ~isempty(rowNames)
      rowNames = rowNames(~missingRows);
    end
  end
  args = {'VariableNames', names(selected)};
  if ~isempty(rowNames)
    args = [args, {'RowNames', rowNames}];
  end
  T = table(columns{:}, args{:});
  T = setMetadata(T, root, opts.VariableUnitsSelector, 'VariableUnits', names(selected));
  T = setMetadata(T, root, opts.VariableDescriptionsSelector, 'VariableDescriptions', names(selected));
end
%=============================================================================
function [selectors, names, types, selectedNames] = resolveVariables(opts, cache)
  selectors = opts.VariableSelectors;
  names = opts.VariableNames;
  types = opts.VariableTypes;
  selectedNames = opts.SelectedVariableNames;
  if ~isempty(selectors)
    return
  end
  % No selectors: the leaf nodes are read, with the option names and types
  % when their count matches, otherwise Var1, Var2, ... as text.
  selectors = jsonTableLeaves(cache);
  if numel(selectors) ~= numel(names)
    names = cellstr(string('Var') + string(1:numel(selectors)));
    types = repmat({'char'}, 1, numel(selectors));
    selectedNames = names;
  end
end
%=============================================================================
function [omitRows, keep] = applyRule(rule, mask, omitRows, name, kind)
  keep = true;
  if ~any(mask)
    return
  end
  switch rule
    case 'error'
      error('Nelson:spreadsheet:jsonImportRule', 'Unable to import variable ''%s'': %s value found.', name, kind);
    case 'omitrow'
      omitRows = omitRows | mask;
    case 'omitvar'
      keep = false;
  end
end
%=============================================================================
function T = setMetadata(T, root, selector, property, names)
  if isempty(selector)
    return
  end
  [value, found] = jsonPointerGet(root, selector);
  if ~found
    return
  end
  metadata = repmat({''}, 1, numel(names));
  if isstruct(value) && isscalar(value)
    for k = 1:numel(names)
      field = jsonFieldName(value, names{k});
      if ~isempty(field) && ischar(value.(field))
        metadata{k} = value.(field);
      end
    end
  elseif iscellstr(value) && numel(value) == numel(names)
    metadata = value(:)';
  else
    return
  end
  T.Properties.(property) = metadata;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [rows, keys] = jsonTableRows(node, isArrayNode)
  % Normalizes the decoded table node into rows:
  %  - array of objects: struct array (same keys) or cell of structs (n x 1)
  %  - object whose values are all objects: one row per key (keys returned)
  %  - other object: a single row
  %  - array of scalars: one value per row
  keys = {};
  if isstruct(node)
    if isscalar(node) && ~isArrayNode && isKeyedObject(node)
      keys = fieldnames(node);
      rows = toStructRows(struct2cell(node));
      return
    end
    rows = asColumn(node);
    return
  end
  if iscell(node)
    rows = asColumn(node);
    isObject = cellfun('isclass', rows, 'struct') & cellfun('prodofsize', rows) == 1;
    if all(isObject)
      rows = toStructRows(rows);
    end
    return
  end
  if isempty(node) && ~isArrayNode
    error('Nelson:spreadsheet:jsonTableNotFound', 'No tabular data found in the JSON file.');
  end
  rows = asColumn(node);
end
%=============================================================================
function value = asColumn(value)
  if ~iscolumn(value)
    value = value(:);
  end
end
%=============================================================================
function tf = isKeyedObject(node)
  values = struct2cell(node);
  tf = ~isempty(values) && all(cellfun('isclass', values, 'struct')) ...
    && all(cellfun('prodofsize', values) == 1);
end
%=============================================================================
function rows = toStructRows(rows)
  % Concatenates objects sharing the same keys into a struct array.
  try
    rows = vertcat(rows{:});
  catch
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function column = jsonTableWriteColumn(value, preserveInfAndNaN)
  % Prepares a table variable for the JSON writer: real numeric and logical
  % arrays are kept, text-like values become string arrays (missing, NaT and
  % <undefined> give null), datetime and duration use their display format,
  % other values are encoded row by row as raw JSON text (cell array).
  if (isnumeric(value) && isreal(value) && ~issparse(value)) || islogical(value)
    column = full(value);
  elseif ischar(value)
    column = string(cellstr(value));
  elseif iscellstr(value) || isstring(value) || iscategorical(value)
    column = string(value);
  elseif isdatetime(value)
    column = timeText(value, isnat(value));
  elseif isduration(value)
    column = timeText(value, isnan(value));
  else
    column = encodeRows(value, preserveInfAndNaN);
  end
end
%=============================================================================
function column = timeText(value, isMissing)
  column = repmat(string(missing), size(value));
  if any(~isMissing(:))
    column(~isMissing) = string(value(~isMissing));
  end
end
%=============================================================================
function column = encodeRows(value, preserveInfAndNaN)
  n = size(value, 1);
  column = cell(n, 1);
  for k = 1:n
    if iscell(value) && size(value, 2) == 1
      element = value{k};
    else
      element = value(k, :);
    end
    if isempty(element) && isnumeric(element)
      column{k} = 'null';
    else
      column{k} = jsonencode(element, 'ConvertInfAndNaN', ~preserveInfAndNaN);
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = readvars(varargin)
  narginchk(1, inf);
  T = readtable(varargin{:});
  nvars = numel(T.Properties.VariableNames);
  n = nargout;
  if (n == 0)
    n = 1;
  end
  if (n > nvars)
    error('Nelson:tooManyOutputs', 'Too many output arguments.');
  end
  varargout = cell(1, n);
  for k = 1:n
    varargout{k} = T{:, k};
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = writecell(varargin)
  nargoutchk(0, 0);
  M = varargin{1};
  mustBeA(M, 'cell', 1);
  if (nargin < 2)
    name = inputname(1);
    filename = getDefaultFilename(inputname(1));
  else
    filename = varargin{2};
    mustBeTextScalar(filename, 2);
    filename = convertStringsToChars(filename);
  end

  if (nargin > 2 && mod(nargin - 2, 2) ~= 0)
    error('Nelson:spreadsheet:incorrectNumberArguments2', 'Incorrect number of arguments.');
  end

  checkRestrictedOptions(varargin);
  if (nargin > 2)
    args = varargin(3:end);
  else
    args = {};
  end
  writeData(M, filename, args);
  varargout = {};
end
%=============================================================================
function checkRestrictedOptions(varargin)
  for i = 3:2:nargin
    if strcmp('WriteVariableNames', convertStringsToChars(varargin{i}))
      error('Nelson:spreadsheet:writeVariableNamesNotAllowed', '%s not allowed.', 'WriteVariableNames');
    end
    if strcmp('WriteRowNames', convertStringsToChars(varargin{i}))
      error('Nelson:spreadsheet:writeRowNamesNotAllowed', '%s not allowed.', 'WriteRowNames');
    end
  end
end
%=============================================================================
function writeData(M, filename, args)
  nbColumns = size(M, 2);
  columns = cell(1, nbColumns);
  variableNames = cell(1, nbColumns);
  for k = 1:nbColumns
    columns{k} = M(:, k);
    variableNames{k} = ['Var', int2str(k)];
  end
  T = table(columns{:}, 'VariableNames', variableNames);
  writetable(T, filename, args{:}, 'WriteVariableNames', false, 'WriteRowNames', false);
end
%=============================================================================
function filename = getDefaultFilename(name)
  if isempty(name)
    filename = "cell.txt";
  else
    filename = name + ".txt";
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = writematrix(varargin)
  nargoutchk(0, 0);
  M = varargin{1};
  if ischar(M)
    M = string(M);
  end
  if (nargin < 2)
    name = inputname(1);
    filename = getDefaultFilename(inputname(1));
  else
    filename = varargin{2};
    mustBeTextScalar(filename, 2);
    filename = convertStringsToChars(filename);
  end

  is_text = strcmp(fileparts(filename, 'extension'), '.txt') || strcmp(fileparts(filename, 'extension'), '.csv') || strcmp(fileparts(filename, 'extension'), '.dat');
  if (nargin < 3 && (isnumeric(M) || islogical(M)) && is_text)
    % dlmwrite is faster than convert to table and write
    if ispc()
      eol = 'pc';
    else
      eol = 'unix';
    end
    dlmwrite(filename, M, ',', 0, 0, eol, '%.15g');
    return;
  end

  if (nargin > 3 && mod(nargin - 2, 2) ~= 0)
    error('Nelson:spreadsheet:incorrectNumberArguments2', 'Incorrect number of arguments.');
  end

  checkRestrictedOptions(varargin);
  if (nargin > 2)
    args = varargin(3:end);
  else
    args = {};
  end
  writeData(M, filename, args);
  varargout = {};
end
%=============================================================================
function checkRestrictedOptions(varargin)
  for i = 3:2:nargin
    if strcmp('WriteVariableNames', convertStringsToChars(varargin{i}))
      error('Nelson:spreadsheet:writeVariableNamesNotAllowed', '%s not allowed.', 'WriteVariableNames');
    end
    if strcmp('WriteRowNames', convertStringsToChars(varargin{i}))
      error('Nelson:spreadsheet:writeRowNamesNotAllowed', '%s not allowed.', 'WriteRowNames');
    end
  end
end
%=============================================================================
function writeData(M, filename, args)
  T = table(M);
  writetable(T, filename, args{:}, 'WriteVariableNames', false, 'WriteRowNames', false);
end
%=============================================================================
function filename = getDefaultFilename(name)
  if isempty(name)
    filename = "matrix.txt";
  else
    filename = name + ".txt";
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
