function y = cummax(x, varargin)
  % y = cummax(x)
  % y = cummax(x, dim)
  % y = cummax(___, direction)  with 'forward' (default) | 'reverse'
  % y = cummax(___, nanflag)    with 'omitnan' (default) | 'includenan'
  narginchk(1, 4);
  [dim, reverse, includeNaN] = parseCumulativeOptionsLocal(size(x), varargin{:});
  y = cumulativeLocal(x, dim, @max, reverse, includeNaN);
end
%=============================================================================
function [dim, reverse, includeNaN] = parseCumulativeOptionsLocal(szx, varargin)
  dim = firstNonsingletonLocal(szx);
  reverse = false;
  includeNaN = false;
  for k = 1:length(varargin)
    arg = varargin{k};
    if isstring(arg) && isscalar(arg)
      arg = char(arg);
    end
    if isnumeric(arg) && isscalar(arg)
      dim = arg;
    elseif ischar(arg) && strcmpi(arg, 'reverse')
      reverse = true;
    elseif ischar(arg) && strcmpi(arg, 'forward')
      reverse = false;
    elseif ischar(arg) && strcmpi(arg, 'omitnan')
      includeNaN = false;
    elseif ischar(arg) && strcmpi(arg, 'includenan')
      includeNaN = true;
    else
      error('Nelson:data_analysis:unsupportedOption', 'Unsupported option.');
    end
  end
end
%=============================================================================
function y = cumulativeLocal(x, dim, fun, reverse, includeNaN)
  y = x;
  n = size(x, dim);
  if reverse
    order = n - 1:-1:1;
    step = 1;
  else
    order = 2:n;
    step = -1;
  end
  checkNaN = includeNaN && isfloat(x);
  for k = order
    current = subscriptLocal(dim, k, ndims(x));
    previous = subscriptLocal(dim, k + step, ndims(x));
    combined = fun(y(previous{:}), x(current{:}));
    if checkNaN
      nanMask = isnan(y(previous{:})) | isnan(x(current{:}));
      combined(nanMask) = NaN;
    end
    y(current{:}) = combined;
  end
end
%=============================================================================
function sub = subscriptLocal(dim, k, nDims)
  sub = repmat({':'}, 1, nDims);
  sub{dim} = k;
end
%=============================================================================
function dim = firstNonsingletonLocal(sz)
  dim = 1;
  for k = 1:length(sz)
    if sz(k) ~= 1
      dim = k;
      return
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = cummin(x, varargin)
  % y = cummin(x)
  % y = cummin(x, dim)
  % y = cummin(___, direction)  with 'forward' (default) | 'reverse'
  % y = cummin(___, nanflag)    with 'omitnan' (default) | 'includenan'
  narginchk(1, 4);
  [dim, reverse, includeNaN] = parseCumulativeOptionsLocal(size(x), varargin{:});
  y = cumulativeLocal(x, dim, @min, reverse, includeNaN);
end
%=============================================================================
function [dim, reverse, includeNaN] = parseCumulativeOptionsLocal(szx, varargin)
  dim = firstNonsingletonLocal(szx);
  reverse = false;
  includeNaN = false;
  for k = 1:length(varargin)
    arg = varargin{k};
    if isstring(arg) && isscalar(arg)
      arg = char(arg);
    end
    if isnumeric(arg) && isscalar(arg)
      dim = arg;
    elseif ischar(arg) && strcmpi(arg, 'reverse')
      reverse = true;
    elseif ischar(arg) && strcmpi(arg, 'forward')
      reverse = false;
    elseif ischar(arg) && strcmpi(arg, 'omitnan')
      includeNaN = false;
    elseif ischar(arg) && strcmpi(arg, 'includenan')
      includeNaN = true;
    else
      error('Nelson:data_analysis:unsupportedOption', 'Unsupported option.');
    end
  end
end
%=============================================================================
function y = cumulativeLocal(x, dim, fun, reverse, includeNaN)
  y = x;
  n = size(x, dim);
  if reverse
    order = n - 1:-1:1;
    step = 1;
  else
    order = 2:n;
    step = -1;
  end
  checkNaN = includeNaN && isfloat(x);
  for k = order
    current = subscriptLocal(dim, k, ndims(x));
    previous = subscriptLocal(dim, k + step, ndims(x));
    combined = fun(y(previous{:}), x(current{:}));
    if checkNaN
      nanMask = isnan(y(previous{:})) | isnan(x(current{:}));
      combined(nanMask) = NaN;
    end
    y(current{:}) = combined;
  end
end
%=============================================================================
function sub = subscriptLocal(dim, k, nDims)
  sub = repmat({':'}, 1, nDims);
  sub{dim} = k;
end
%=============================================================================
function dim = firstNonsingletonLocal(sz)
  dim = 1;
  for k = 1:length(sz)
    if sz(k) ~= 1
      dim = k;
      return
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function y = detrend(x, o, bp)
  narginchk(1, 3);
  if nargin < 2 || isempty(o)
    o = 1;
  end
  if ischar(o) || (isstring(o) && isscalar(o))
    switch lower(char(o))
      case 'constant'
        o = 0;
      case 'linear'
        o = 1;
      otherwise
        error('Nelson:data_analysis:trendTypeConstantLinear', 'Trend type must be ''constant'' or ''linear''.');
    end
  end
  if nargin < 3
    bp = [];
  end
  isRowVector = (ndims(x) == 2) && (size(x, 1) == 1);
  if isRowVector
    x = x(:);
  end
  N = size(x, 1);
  if o == 0
    y = x - mean(x, 1);
  else
    breaks = unique([0; double(bp(:)); N - 1]);
    lastSegment = length(breaks) - 1;
    a = [zeros(N, lastSegment, class(x)), ones(N, 1, class(x))];
    for kb = 1:lastSegment
      segmentLength = N - breaks(kb);
      a((1:segmentLength) + breaks(kb), kb) = (1:segmentLength)' / segmentLength;
    end
    y = x - a * (a \ x);
  end
  if isRowVector
    y = y.';
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = discretize(X, edges, varargin)
  narginchk(2, 6);
  nargoutchk(0, 2);
  if ~isempty(varargin) && isstruct(varargin{end}) && isscalar(varargin{end})
    varargin = [varargin(1:end - 1), namedargs2cell(varargin{end})];
  end
  if isdatetime(X) && localIsTextScalar(edges)
    varargout{1} = localDatetimeUnitDiscretize(X, char(edges), varargin{:});
    return
  end
  if isduration(X) && localIsTextScalar(edges)
    varargout{1} = localDurationUnitDiscretize(X, char(edges), varargin{:});
    return
  end
  if ~isnumeric(X) || ~isnumeric(edges) || ~isvector(edges)
    error('Nelson:data_analysis:numericInputDataNumericEdge', 'Numeric input data and a numeric edge vector are expected.');
  end
  edges = double(edges(:).');
  if isscalar(edges)
    % A scalar second argument is a requested number of bins. Reuse the
    % histcounts bin picker so discretize(X, N) and histcounts(X, N) agree on
    % the automatically chosen edges.
    nbins = edges;
    if ~isfinite(nbins) || nbins < 1 || nbins ~= fix(nbins)
      error('Nelson:data_analysis:numberBinsPositiveInteger', '%s must be a positive integer scalar.', 'Number of bins');
    end
    [~, edges] = histcounts(double(X), nbins);
    edges = double(edges(:).');
  end
  if length(edges) < 2 || any(diff(edges) <= 0)
    error('Nelson:data_analysis:edgesStrictlyIncreasingVector', 'Edges must be a strictly increasing vector.');
  end
  [outputMode, outputValues, includedEdge] = localParseOptions(varargin, false);
  nBins = length(edges) - 1;
  bin = localDiscretizeBins(double(X), edges, includedEdge);
  if strcmp(outputMode, 'indices')
    Y = bin;
  elseif strcmp(outputMode, 'categorical')
    values = localValues(outputValues, nBins);
    Y = localCategoricalBins(bin, values);
  else
    values = localValues(outputValues, nBins);
    Y = localValueBins(bin, values);
  end
  varargout{1} = Y;
  if nargout > 1
    varargout{2} = edges;
  end
end
%=============================================================================
function Y = localDatetimeUnitDiscretize(X, unit, varargin)
  if ~strcmpi(unit, 'month')
    error('Nelson:data_analysis:unsupportedDatetimeDiscretizeUnit', 'Unsupported "%s" option.', char(unit));
  end
  [outputMode, outputValues] = localParseOptions(varargin, true);
  monthIndex = year(X) .* 12 + month(X);
  valid = ~isnat(X);
  bin = NaN(size(X));
  if any(valid(:))
    firstMonth = min(monthIndex(valid));
    lastMonth = max(monthIndex(valid));
    bin(valid) = monthIndex(valid) - firstMonth + 1;
    labels = localMonthLabels(firstMonth:lastMonth);
  else
    labels = {};
  end
  if strcmp(outputMode, 'indices')
    Y = bin;
    return
  end
  if isempty(outputValues)
    values = labels;
  else
    values = localValues(outputValues, length(labels));
  end
  if strcmp(outputMode, 'categorical')
    Y = localCategoricalBins(bin, values);
  else
    Y = localValueBins(bin, values);
  end
end
%=============================================================================
function Y = localDurationUnitDiscretize(X, unit, varargin)
  if ~strcmpi(unit, 'hour')
    error('Nelson:data_analysis:unsupportedDurationDiscretizeUnit', 'Unsupported "%s" option.', char(unit));
  end
  [outputMode, outputValues, includedEdge] = localParseOptions(varargin, true);
  unitSeconds = 3600;
  XSeconds = seconds(X);
  valid = ~isnan(XSeconds);
  bin = NaN(size(XSeconds));
  if any(valid(:))
    firstEdge = floor(min(XSeconds(valid)) / unitSeconds) * unitSeconds;
    lastEdge = ceil(max(XSeconds(valid)) / unitSeconds) * unitSeconds;
    if firstEdge == lastEdge
      lastEdge = firstEdge + unitSeconds;
    end
    edges = firstEdge:unitSeconds:lastEdge;
    bin = localDiscretizeBins(XSeconds, edges, includedEdge);
    labels = localDurationLabels(edges, outputValues, includedEdge);
  else
    labels = {};
  end
  if strcmp(outputMode, 'indices')
    Y = bin;
    return
  end
  if isempty(outputValues) || localIsTextScalar(outputValues)
    values = labels;
  else
    values = localValues(outputValues, length(labels));
  end
  if strcmp(outputMode, 'categorical')
    Y = localCategoricalBins(bin, values);
  else
    Y = localValueBins(bin, values);
  end
end
%=============================================================================
function labels = localDurationLabels(edges, formatValue, includedEdge)
  if isempty(formatValue)
    formatValue = 'hh:mm:ss';
  else
    formatValue = char(formatValue);
  end
  nBins = length(edges) - 1;
  labels = cell(nBins, 1);
  for k = 1:nBins
    if strcmpi(includedEdge, 'right')
      leftBracket = '(';
      rightBracket = ']';
      if k == 1
        leftBracket = '[';
      end
    else
      leftBracket = '[';
      rightBracket = ')';
      if k == nBins
        rightBracket = ']';
      end
    end
    labels{k} = sprintf('%s%s, %s%s', leftBracket, ...
      localFormatDurationEdge(edges(k), formatValue), ...
      localFormatDurationEdge(edges(k + 1), formatValue), rightBracket);
  end
end
%=============================================================================
function text = localFormatDurationEdge(value, formatValue)
  if strcmpi(formatValue, 'm')
    text = sprintf('%g min', value / 60);
  elseif strcmpi(formatValue, 'hh:mm:ss')
    signText = '';
    if value < 0
      signText = '-';
    end
    value = abs(value);
    hoursValue = floor(value / 3600);
    minutesValue = floor((value - hoursValue * 3600) / 60);
    secondsValue = round(value - hoursValue * 3600 - minutesValue * 60);
    text = sprintf('%s%02d:%02d:%02d', signText, hoursValue, minutesValue, secondsValue);
  else
    error('Nelson:data_analysis:unsupportedDurationLabelFormat', 'Unsupported duration label format.');
  end
end
%=============================================================================
function labels = localMonthLabels(monthIndexes)
  shortNames = {'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', ...
    'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'};
  labels = cell(length(monthIndexes), 1);
  for k = 1:length(monthIndexes)
    yearValue = floor((monthIndexes(k) - 1) / 12);
    monthValue = monthIndexes(k) - yearValue * 12;
    labels{k} = sprintf('%s-%04d', shortNames{monthValue}, yearValue);
  end
end
%=============================================================================
function [outputMode, outputValues, includedEdge] = localParseOptions(varargin, allowAutoCategorical)
  outputMode = 'indices';
  outputValues = [];
  includedEdge = 'left';
  k = 1;
  while k <= length(varargin)
    arg = varargin{k};
    if (ischar(arg) || (isstring(arg) && isscalar(arg))) && strcmpi(char(arg), 'categorical')
      outputMode = 'categorical';
      if k < length(varargin) && ~localIsOptionName(varargin{k + 1})
        outputValues = varargin{k + 1};
        k = k + 2;
      elseif allowAutoCategorical
        k = k + 1;
      else
        error('Nelson:data_analysis:categoryNamesExpected', 'Category names are expected.');
      end
    elseif (ischar(arg) || (isstring(arg) && isscalar(arg))) && strcmpi(char(arg), 'IncludedEdge')
      if k == length(varargin)
        error('Nelson:data_analysis:includedEdgeValueExpected', 'IncludedEdge value is expected.');
      end
      includedEdge = char(varargin{k + 1});
      k = k + 2;
    elseif isempty(outputValues)
      outputMode = 'values';
      outputValues = arg;
      k = k + 1;
    else
      error('Nelson:data_analysis:invalidDiscretizeInputArguments', 'Invalid discretize input arguments.');
    end
  end
  if ~strcmpi(includedEdge, 'left') && ~strcmpi(includedEdge, 'right')
    error('Nelson:data_analysis:includedEdgeLeftRight', 'IncludedEdge must be left or right.');
  end
end
%=============================================================================
function tf = localIsOptionName(value)
  tf = localIsTextScalar(value) && strcmpi(char(value), 'IncludedEdge');
end
%=============================================================================
function tf = localIsTextScalar(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
%=============================================================================
function bin = localDiscretizeBins(X, edges, includedEdge)
  bin = NaN(size(X));
  nBins = length(edges) - 1;
  for k = 1:numel(X)
    x = X(k);
    if isnan(x)
      continue
    end
    for b = 1:nBins
      if strcmpi(includedEdge, 'left')
        inBin = (x >= edges(b) && x < edges(b + 1)) ...
          || (b == nBins && x == edges(b + 1));
      else
        inBin = (x > edges(b) && x <= edges(b + 1)) ...
          || (b == 1 && x == edges(b));
      end
      if inBin
        bin(k) = b;
        break
      end
    end
  end
end
%=============================================================================
function values = localValues(inputValues, nBins)
  if isempty(inputValues)
    values = cellstr(string(1:nBins));
  elseif isstring(inputValues)
    values = cellstr(inputValues(:));
  elseif iscellstr(inputValues)
    values = inputValues(:);
  elseif isnumeric(inputValues)
    if numel(inputValues) ~= nBins
      error('Nelson:data_analysis:numberValuesMatchNumberBins', 'Number of values must match the number of bins.');
    end
    values = inputValues(:);
    return
  else
    error('Nelson:data_analysis:unsupportedDiscretizeOutputValues', 'Unsupported discretize output values.');
  end
  if length(values) ~= nBins
    error('Nelson:data_analysis:numberValuesMatchNumberBins', 'Number of values must match the number of bins.');
  end
end
%=============================================================================
function Y = localCategoricalBins(bin, values)
  labels = repmat({''}, size(bin));
  for k = 1:numel(bin)
    if ~isnan(bin(k))
      labels{k} = values{bin(k)};
    end
  end
  Y = categorical(labels, values, values, 'Protected', true);
end
%=============================================================================
function Y = localValueBins(bin, values)
  if isnumeric(values)
    Y = NaN(size(bin));
    for k = 1:numel(bin)
      if ~isnan(bin(k))
        Y(k) = values(bin(k));
      end
    end
  else
    Y = repmat({''}, size(bin));
    for k = 1:numel(bin)
      if ~isnan(bin(k))
        Y{k} = values{bin(k)};
      end
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [B, FB] = fillmissing(A, method, varargin)
  narginchk(2, Inf);
  opts = parseFillmissingInputs(method, varargin);
  if istable(A) || istimetable(A)
    [B, FB] = fillTable(A, opts);
  else
    [B, FB] = fillArray(A, opts);
  end
  if nargout < 2
    clear FB;
  end
end
%=============================================================================
function opts = parseFillmissingInputs(method, args)
  opts = struct();
  opts.Method = checkFillMethod(method);
  opts.Value = [];
  opts.ValueProvided = false;
  opts.MissingLocations = [];
  opts.EndValues = 'extrap';
  opts.SamplePoints = [];
  opts.MaxGap = [];
  opts.DataVariables = [];
  opts.ReplaceValues = true;
  opts.Dim = [];
  opts.Distance = 'euclidean';
  isConstant = strcmp(opts.Method, 'constant');
  isKnn = strcmp(opts.Method, 'knn');
  takesValue = isConstant || isKnn || isa(opts.Method, 'function_handle') || any(strcmp(opts.Method, {'movmean', 'movmedian'}));
  % The fill value of 'constant' may itself be text; the window of the
  % moving and function handle methods and k of 'knn' are numeric.
  if takesValue && ~isempty(args) && (isConstant || ~isText(args{1}))
    opts.Value = args{1};
    opts.ValueProvided = true;
    args(1) = [];
  end
  if isKnn
    if ~opts.ValueProvided
      opts.Value = 1;
    end
    k = opts.Value;
    if ~(isnumeric(k) && isscalar(k) && isreal(k) && k >= 1 && fix(k) == k)
      error('Nelson:data_analysis:knnInvalidK', '''k'' value must be a real, positive integer.');
    end
  elseif takesValue && ~opts.ValueProvided
    if isConstant
      error('Nelson:data_analysis:fillValueExpected', 'Fill value expected.');
    end
    error('Nelson:data_analysis:windowSizeExpected', '%s expected.', 'Window size');
  end
  if ~isempty(args) && ~isText(args{1})
    opts.Dim = args{1};
    args(1) = [];
    if ~(isnumeric(opts.Dim) && isscalar(opts.Dim) && isreal(opts.Dim) && opts.Dim >= 1 && fix(opts.Dim) == opts.Dim)
      error('Nelson:data_analysis:dimensionArgumentPositiveIntegerScalar', '%s must be a positive integer scalar.', 'Dimension argument');
    end
  end
  provided = {};
  k = 1;
  while k <= length(args)
    name = args{k};
    if isstring(name)
      name = char(name);
    end
    if ~ischar(name)
      error('Nelson:data_analysis:nameValueArgumentExpected', 'Name-value argument expected.');
    end
    if k == length(args)
      error('Nelson:data_analysis:nameValueArgumentFollowedValue', 'Name-value argument must be followed by a value.');
    end
    provided{end + 1} = lower(name);
    switch lower(name)
      case 'missinglocations'
        opts.MissingLocations = args{k + 1};
      case 'endvalues'
        opts.EndValues = args{k + 1};
        if isstring(opts.EndValues)
          opts.EndValues = char(opts.EndValues);
        end
      case 'samplepoints'
        opts.SamplePoints = args{k + 1};
      case 'maxgap'
        opts.MaxGap = args{k + 1};
      case 'datavariables'
        opts.DataVariables = args{k + 1};
      case 'replacevalues'
        opts.ReplaceValues = logical(args{k + 1});
      case 'distance'
        opts.Distance = checkKnnDistance(args{k + 1});
      otherwise
        error('Nelson:data_analysis:unknownOption', 'Unknown option.');
    end
    k = k + 2;
  end
  checkKnnOptions(isKnn, provided);
end
%=============================================================================
function distance = checkKnnDistance(distance)
  if isa(distance, 'function_handle')
    return
  end
  if isText(distance)
    distance = lower(char(distance));
  end
  if ~(ischar(distance) && any(strcmp(distance, {'euclidean', 'seuclidean'})))
    error('Nelson:data_analysis:knnInvalidDistance', '''Distance'' value must be ''euclidean'', ''seuclidean'', or a function handle.');
  end
end
%=============================================================================
function checkKnnOptions(isKnn, provided)
  if ~isKnn
    if any(strcmp(provided, 'distance'))
      error('Nelson:data_analysis:distanceOnlyForKnn', 'The ''Distance'' argument is supported only for the ''knn'' method.');
    end
    return
  end
  names = {'endvalues', 'maxgap', 'samplepoints'};
  labels = {'EndValues', 'MaxGap', 'SamplePoints'};
  for k = 1:length(names)
    if any(strcmp(provided, names{k}))
      error('Nelson:data_analysis:knnUnsupportedArgument', 'The %s argument is not supported for the ''knn'' method.', labels{k});
    end
  end
end
%=============================================================================
function method = checkFillMethod(method)
  if isa(method, 'function_handle')
    return
  end
  if ~isText(method)
    error('Nelson:data_analysis:unsupportedFillMethod', 'Unsupported "%s" option.', 'method');
  end
  method = lower(char(method));
  supported = {'constant', 'previous', 'next', 'nearest', 'linear', 'spline', 'pchip', 'makima', 'movmean', 'movmedian', 'mean', 'median', 'mode', 'knn'};
  if ~any(strcmp(method, supported))
    error('Nelson:data_analysis:unsupportedFillMethod', 'Unsupported "%s" option.', method);
  end
end
%=============================================================================
function tf = isText(value)
  tf = ischar(value) || (isstring(value) && isscalar(value));
end
%=============================================================================
function [B, FB] = fillTable(A, opts)
  B = A;
  if ~isempty(opts.Dim)
    error('Nelson:data_analysis:fillmissingDimensionTable', 'Dimension parameter not supported when first argument is a table or timetable.');
  end
  if istimetable(A)
    % The row times are the sample points of a timetable.
    if ~isempty(opts.SamplePoints)
      error('Nelson:data_analysis:fillmissingSamplePointsTimetable', '''SamplePoints'' parameter not supported when first argument is a timetable.');
    end
    opts.SamplePoints = A.Properties.RowTimes;
  end
  if ~isempty(opts.MissingLocations) && ~istable(opts.MissingLocations) && ~(islogical(opts.MissingLocations) && isequal(size(opts.MissingLocations), [height(A), width(A)]))
    missingLocationsError();
  end
  variableNames = A.Properties.VariableNames;
  if isempty(opts.DataVariables)
    dataVars = 1:width(A);
  else
    stA = struct(A);
    dataVars = tableResolveVariables(stA.Properties.VariableNames, opts.DataVariables, stA.Properties.VariableTypes, stA.data);
  end
  % Table variables are filled along their rows.
  varOpts = opts;
  varOpts.Dim = 1;
  nVars = length(dataVars);
  % A vector of fill values or end values holds one value per data variable.
  checkSliceValues(opts, nVars);
  if strcmp(opts.Method, 'knn')
    [filledValues, filledMasks] = fillTableKnn(A, varOpts, variableNames(dataVars), dataVars);
  else
    filledValues = cell(1, nVars);
    filledMasks = cell(1, nVars);
    for position = 1:nVars
      name = variableNames{dataVars(position)};
      varOpts.MissingLocations = variableMissingLocations(opts.MissingLocations, name, dataVars(position));
      varOpts.Value = valueForVariable(opts.Value, position);
      varOpts.EndValues = valueForVariable(opts.EndValues, position);
      [filledValues{position}, filledMasks{position}] = fillArray(A.(name), varOpts);
    end
  end
  % TF has one column per variable of B, true where a row of the variable was filled.
  if opts.ReplaceValues
    FB = false(height(A), width(A));
  else
    FB = false(height(A), width(A) + nVars);
  end
  for position = 1:nVars
    name = variableNames{dataVars(position)};
    if opts.ReplaceValues
      B.(name) = filledValues{position};
      FB(:, dataVars(position)) = any(filledMasks{position}, 2);
    else
      B.([name, '_filled']) = filledValues{position};
      FB(:, width(A) + position) = any(filledMasks{position}, 2);
    end
  end
end
%=============================================================================
function locations = variableMissingLocations(missingLocations, name, v)
  locations = [];
  if isempty(missingLocations)
    return
  end
  if istable(missingLocations)
    locations = missingLocations.(name);
  else
    locations = missingLocations(:, v);
  end
end
%=============================================================================
function [filledValues, filledMasks] = fillTableKnn(A, opts, names, dataVars)
  % 'knn' compares whole rows: the data variables are filled together as the columns of one matrix.
  nVars = length(names);
  values = cell(1, nVars);
  locations = cell(1, nVars);
  for position = 1:nVars
    values{position} = A.(names{position});
    if size(values{position}, 2) ~= 1
      error('Nelson:data_analysis:knnMultiColumnVariable', 'Table variables with multiple columns are not supported for the ''knn'' method.');
    end
    checkKnnInput(values{position}, opts.Distance);
    locations{position} = variableMissingLocations(opts.MissingLocations, names{position}, dataVars(position));
  end
  opts.MissingLocations = [locations{:}];
  [filled, mask] = fillArray([values{:}], opts);
  filledValues = cell(1, nVars);
  filledMasks = cell(1, nVars);
  for position = 1:nVars
    filledValues{position} = cast(filled(:, position), class(values{position}));
    filledMasks{position} = mask(:, position);
  end
end
%=============================================================================
function value = valueForVariable(values, position)
  % Fill or end value of the data variable at position (vectors and cells hold one per variable).
  value = values;
  if iscell(values) && ~isscalar(values)
    value = values{position};
  elseif iscell(values)
    value = values{1};
  elseif (isnumeric(values) || islogical(values)) && ~isscalar(values) && ~isempty(values)
    value = values(position);
  end
end
%=============================================================================
function checkSliceValues(opts, slices)
  % The fill constant and numeric end values are a scalar or one value per slice.
  if strcmp(opts.Method, 'constant') && ~(ischar(opts.Value) || isscalar(opts.Value) || (isvector(opts.Value) && numel(opts.Value) == slices))
    error('Nelson:data_analysis:fillmissingConstantSize', 'Fill constant must be a scalar or a %d-element vector.', slices);
  end
  if ~ischar(opts.EndValues) && ~(isscalar(opts.EndValues) || (isvector(opts.EndValues) && numel(opts.EndValues) == slices))
    error('Nelson:data_analysis:fillmissingEndValuesSize', '''EndValues'' value must be a scalar or a %d-element vector.', slices);
  end
end
%=============================================================================
function missingLocationsError()
  error('Nelson:data_analysis:fillmissingInvalidMissingLocations', '''MissingLocations'' value must be a logical array of the same size as the first argument.');
end
%=============================================================================
function [B, FB] = fillArray(A, opts)
  % Every method works on the columns of X: the slices of A along dim.
  B = A;
  if isempty(opts.MissingLocations)
    M = ismissing(A);
  else
    M = opts.MissingLocations;
    if ~(islogical(M) && isequal(size(M), size(A)))
      missingLocationsError();
    end
    if (isinteger(A) || islogical(A)) && any(strcmp(opts.Method, {'linear', 'spline', 'pchip', 'makima', 'movmean', 'movmedian'}))
      error('Nelson:data_analysis:fillmissingIntegerMissingLocations', 'Fill method must be ''constant'', ''previous'', ''next'', ''nearest'', ''knn'', or a function handle when using ''MissingLocations'' with integer or logical inputs.');
    end
  end
  sz = size(A);
  dim = opts.Dim;
  if isempty(dim)
    dim = find(sz ~= 1, 1);
    if isempty(dim)
      dim = 1;
    end
  end
  sz(end + 1:dim) = 1;
  n = sz(dim);
  opts = checkSliceOptions(opts, n, prod(sz([1:dim - 1, dim + 1:end])));
  isExtrap = ischar(opts.EndValues) && strcmpi(opts.EndValues, 'extrap');
  if strcmp(opts.Method, 'constant') && isExtrap && isempty(opts.MaxGap) && isscalar(opts.Value) && ~iscell(A)
    % A scalar fill value does not depend on the slice.
    B(M) = opts.Value;
    FB = reshape(M & ~ismissing(opts.Value), size(A));
    return
  end
  if strcmp(opts.Method, 'knn')
    checkKnnInput(A, opts.Distance);
  end
  FB = false(size(A));
  if ~any(M(:))
    return
  end
  checkMethodType(A, opts.Method);
  % Moving dim first is a plain reshape when the dimensions before it are singleton.
  perm = [dim, 1:dim - 1, dim + 1:length(sz)];
  mustPermute = any(sz(1:dim - 1) ~= 1);
  if mustPermute
    X = reshape(permute(A, perm), n, []);
    M = reshape(permute(M, perm), n, []);
  else
    X = reshape(A, n, []);
    M = reshape(M, n, []);
  end
  if isExtrap && isempty(opts.MaxGap) && any(strcmp(opts.Method, {'mean', 'median', 'mode'}))
    [X, filled] = fillSliceStatistic(X, M, opts.Method);
  else
    [X, filled] = fillMissingEntries(X, M, opts, isExtrap);
  end
  if mustPermute
    B = ipermute(reshape(X, sz(perm)), perm);
    FB = ipermute(reshape(filled, sz(perm)), perm);
  else
    B = reshape(X, size(A));
    FB = reshape(filled, size(A));
  end
end
%=============================================================================
function opts = checkSliceOptions(opts, n, slices)
  % Validates the options depending on the n entries of each slice and on
  % the number of slices; sample points, MaxGap and windows become numeric
  % (seconds for datetime and duration values). SampleValues keeps the
  % sample points as given, for the function handle method.
  checkSliceValues(opts, slices);
  isFunction = isa(opts.Method, 'function_handle');
  hasWindow = isFunction || any(strcmp(opts.Method, {'movmean', 'movmedian'}));
  window = [];
  if hasWindow
    window = opts.Value;
  end
  opts.SampleValues = opts.SamplePoints(:);
  if ~hasWindow && isempty(opts.SamplePoints) && isempty(opts.MaxGap)
    return
  end
  [opts.SamplePoints, opts.MaxGap, window] = fillmissingSamplePoints(opts.SamplePoints, n, opts.MaxGap, window, isFunction);
  if ~hasWindow
    return
  end
  finite = isnumeric(window) && isreal(window) && all(isfinite(window));
  if isFunction
    if ~(finite && ((isscalar(window) && window > 0) || (numel(window) == 2 && all(window >= 0) && any(window > 0))))
      error('Nelson:data_analysis:fillmissingInvalidGapWindow', 'Window length must be a finite positive scalar or 2-element vector of finite nonnegative scalars.');
    end
  elseif ~(finite && ((isscalar(window) && window > 0) || (numel(window) == 2 && all(window >= 0))))
    error('Nelson:data_analysis:windowPositiveScalarTwoElement', 'Window must be a positive scalar or a two-element vector.');
  end
  opts.Value = window;
end
%=============================================================================
function [X, filled] = fillMissingEntries(X, M, opts, isExtrap)
  % Generic path: a value is proposed for each missing entry, then EndValues and MaxGap apply.
  n = size(X, 1);
  % Sample points are only built for the methods measuring distances.
  usesX = ~isempty(opts.MaxGap) || ~any(strcmp(opts.Method, {'constant', 'previous', 'next', 'mean', 'median', 'mode', 'movmean', 'movmedian', 'knn'}));
  if ~isempty(opts.SamplePoints)
    x = double(opts.SamplePoints(:));
  elseif usesX
    x = (1:n)';
  else
    x = [];
  end
  withNeighbors = ~isExtrap || ~isempty(opts.MaxGap) || any(strcmp(opts.Method, {'previous', 'next', 'nearest', 'linear'}));
  loc = missingEntries(M, withNeighbors);
  [Fm, fm] = fillValues(X, M, x, loc, opts);
  if ~isExtrap
    [Fm, fm] = applyEndValues(X, Fm, fm, loc, opts.EndValues);
  end
  if ~isempty(opts.MaxGap)
    fm = fm & ~gapTooLarge(x, loc, opts.MaxGap);
  end
  idx = loc.miss(fm);
  X(idx) = Fm(fm);
  % An entry filled with a missing value does not count as filled.
  filled = false(size(M));
  filled(idx) = ~ismissing(X(idx));
end
%=============================================================================
function [X, filled] = fillSliceStatistic(X, M, method)
  % Default path of the statistic methods: one value per slice, assigned through the mask.
  stat = sliceStatistic(X, M, method);
  if isscalar(stat)
    filled = M & ~isnan(stat);
    X(filled) = stat;
  else
    F = repmat(stat, size(X, 1), 1);
    filled = M & ~isnan(F);
    X(filled) = F(filled);
  end
end
%=============================================================================
function checkKnnInput(A, distance)
  if ndims(A) > 2
    error('Nelson:data_analysis:knnMatrixExpected', 'First argument must be a matrix or a table for the ''knn'' method.');
  end
  if isa(distance, 'function_handle')
    return
  end
  if ~isfloat(A)
    error('Nelson:data_analysis:knnFloatExpected', 'The ''euclidean'' and ''seuclidean'' distance metrics support only double and single data.');
  end
  if ~isreal(A)
    error('Nelson:data_analysis:knnRealExpected', 'First argument must be real when using the ''euclidean'' and ''seuclidean'' distance metrics.');
  end
end
%=============================================================================
function checkMethodType(A, method)
  numericOnly = {'knn', 'linear', 'spline', 'pchip', 'makima', 'movmean', 'movmedian', 'mean', 'median', 'mode'};
  if ischar(method) && any(strcmp(method, numericOnly)) && ~(isnumeric(A) || islogical(A))
    error('Nelson:data_analysis:unsupportedFillMethod', 'Unsupported "%s" option.', method);
  end
end
%=============================================================================
function loc = missingEntries(M, withNeighbors)
  % Linear index, row and column of the missing entries of M (column-major).
  % With neighbors: p lists the nonmissing entries, gpos(k) counts those
  % before missing entry k, and the nonmissing entries of its column are
  % p(lo(k) + 1:hi(k)).
  n = size(M, 1);
  loc.n = n;
  loc.miss = find(M(:));
  if size(M, 2) == 1
    loc.col = ones(size(loc.miss));
    loc.row = loc.miss;
  else
    loc.col = floor((loc.miss - 1) / n) + 1;
    loc.row = loc.miss - (loc.col - 1) * n;
  end
  if withNeighbors
    known = ~M(:);
    loc.p = find(known);
    g = cumsum(double(known));
    loc.gpos = g(loc.miss);
    counts = sum(~M, 1);
    stops = cumsum(counts);
    loc.hi = reshape(stops(loc.col), [], 1);
    loc.lo = loc.hi - reshape(counts(loc.col), [], 1);
  end
end
%=============================================================================
function idx = knownIndex(loc, pos, valid)
  % Linear index of the nonmissing entry p(pos) where valid, the missing entry itself elsewhere.
  idx = loc.miss;
  idx(valid) = loc.p(pos(valid));
end
%=============================================================================
function r = rowOf(loc, idx)
  r = idx - (loc.col - 1) * loc.n;
end
%=============================================================================
function [Fm, fm] = fillValues(X, M, x, loc, opts)
  % Fm(k) is the value proposed for the missing entry loc.miss(k), used where fm(k).
  method = opts.Method;
  if isa(method, 'function_handle')
    t = opts.SampleValues;
    if isempty(t)
      t = x;
    end
    [Fm, fm] = fillFunction(X, x, t, loc, method, opts.Value);
    return
  end
  switch method
    case 'constant'
      [Fm, fm] = fillConstant(X, loc, opts.Value);
    case 'previous'
      fm = loc.gpos > loc.lo;
      Fm = reshape(X(knownIndex(loc, loc.gpos, fm)), [], 1);
    case 'next'
      fm = loc.gpos < loc.hi;
      Fm = reshape(X(knownIndex(loc, loc.gpos + 1, fm)), [], 1);
    case 'nearest'
      [Fm, fm] = fillNearest(X, x, loc);
    case 'linear'
      [Fm, fm] = fillLinear(X, x, loc);
    case {'spline', 'pchip', 'makima'}
      [Fm, fm] = fillInterp(X, M, x, loc, method);
    case 'knn'
      [Fm, fm] = fillmissingKnn(X, M, loc, opts.Value, opts.Distance);
    case {'movmean', 'movmedian'}
      [Fm, fm] = fillMoving(X, M, x, loc, method, opts.Value, opts.SamplePoints);
    otherwise
      [Fm, fm] = fillStatistic(X, M, loc, method);
  end
end
%=============================================================================
function [Fm, fm] = fillConstant(X, loc, value)
  count = length(loc.miss);
  fm = true(count, 1);
  if iscell(X)
    if ~isText(value)
      error('Nelson:data_analysis:invalidFillConstantTypeTable', 'Invalid fill constant type for table variable.');
    end
    Fm = repmat({char(value)}, count, 1);
  elseif isscalar(value) || ischar(value)
    if isstring(X)
      value = string(value);
    end
    Fm = repmat(value, count, 1);
  else
    % One fill value per slice.
    Fm = reshape(value(loc.col), [], 1);
  end
end
%=============================================================================
function [Fm, fm] = fillNearest(X, x, loc)
  % Ties go to the next nonmissing entry.
  hasPrevious = loc.gpos > loc.lo;
  hasNext = loc.gpos < loc.hi;
  previous = knownIndex(loc, loc.gpos, hasPrevious);
  next = knownIndex(loc, loc.gpos + 1, hasNext);
  xq = x(loc.row);
  usePrevious = hasPrevious & (~hasNext | (xq - x(rowOf(loc, previous))) < (x(rowOf(loc, next)) - xq));
  next(usePrevious) = previous(usePrevious);
  Fm = reshape(X(next), [], 1);
  fm = hasPrevious | hasNext;
end
%=============================================================================
function [Fm, fm] = fillLinear(X, x, loc)
  % Interpolation between the surrounding nonmissing entries, linear
  % extrapolation from the first or last two of them at the ends.
  fm = loc.hi - loc.lo >= 2;
  a = loc.gpos;
  leading = loc.gpos == loc.lo;
  trailing = loc.gpos == loc.hi;
  a(leading) = a(leading) + 1;
  a(trailing) = a(trailing) - 1;
  ia = knownIndex(loc, a, fm);
  ib = knownIndex(loc, a + 1, fm);
  va = reshape(double(X(ia)), [], 1);
  vb = reshape(double(X(ib)), [], 1);
  xa = x(rowOf(loc, ia));
  xb = x(rowOf(loc, ib));
  Fm = va + (vb - va) .* (x(loc.row) - xa) ./ (xb - xa);
end
%=============================================================================
function [Fm, fm] = fillInterp(X, M, x, loc, method)
  count = length(loc.miss);
  Fm = NaN(count, 1);
  fm = false(count, 1);
  [starts, stops] = runBounds([true; diff(loc.col) ~= 0]);
  for s = 1:length(starts)
    r = starts(s):stops(s);
    c = loc.col(starts(s));
    k = find(~M(:, c));
    if length(k) < 2
      continue
    end
    Fm(r) = interp1(x(k), double(X(k, c)), x(loc.row(r)), method, 'extrap');
    fm(r) = true;
  end
end
%=============================================================================
function [starts, stops] = runBounds(breaks)
  starts = find(breaks);
  stops = [starts(2:end) - 1; length(breaks)];
end
%=============================================================================
function [Fm, fm] = fillMoving(X, M, x, loc, method, window, samplePoints)
  % Statistic of the nonmissing entries in the window centered on each missing entry.
  if isempty(samplePoints)
    V = double(X);
    V(M) = NaN;
    if strcmp(method, 'movmean')
      Y = movmean(V, window, 1, 'omitnan');
    else
      Y = movmedian(V, window, 1, 'omitnan');
    end
    Fm = reshape(Y(loc.miss), [], 1);
    fm = ~isnan(Fm);
    return
  end
  % A scalar window w spans [t - w/2, t + w/2), a window [b a] spans [t - b, t + a].
  [before, after] = windowSides(window);
  count = length(loc.miss);
  Fm = NaN(count, 1);
  for k = 1:count
    t = x(loc.row(k));
    if isscalar(window)
      inWindow = x >= t - before & x < t + after;
    else
      inWindow = x >= t - before & x <= t + after;
    end
    values = double(X(inWindow & ~M(:, loc.col(k)), loc.col(k)));
    if ~isempty(values)
      if strcmp(method, 'movmean')
        Fm(k) = mean(values);
      else
        Fm(k) = median(values);
      end
    end
  end
  fm = ~isnan(Fm);
end
%=============================================================================
function [before, after] = windowSides(window)
  if isscalar(window)
    before = window / 2;
    after = before;
  else
    before = window(1);
    after = window(2);
  end
end
%=============================================================================
function [Fm, fm] = fillFunction(X, x, t, loc, fun, window)
  % fun(xs, ts, tq) fills each gap from the entries of the window
  % [t1 - b, t2 + a] around the gap [t1, t2], the gap excluded (possibly
  % none). x: numeric sample points, t: the sample points as given.
  [before, after] = windowSides(window);
  count = length(loc.miss);
  Fm = NaN(count, 1);
  fm = false(count, 1);
  [starts, stops] = runBounds([true; diff(loc.miss) ~= 1 | diff(loc.col) ~= 0]);
  for s = 1:length(starts)
    r = starts(s):stops(s);
    rows = loc.row(r);
    c = loc.col(starts(s));
    sampleIdx = find(x >= x(rows(1)) - before & x <= x(rows(end)) + after);
    sampleIdx = sampleIdx(sampleIdx < rows(1) | sampleIdx > rows(end));
    values = fun(double(X(sampleIdx, c)), t(sampleIdx), t(rows));
    if ~(isscalar(values) || numel(values) == length(rows))
      error('Nelson:data_analysis:fillmissingFunctionOutputSize', 'Output of function handle must have length 1 or must have the length of the missing value gap.');
    end
    Fm(r) = values(:);
    fm(r) = true;
  end
end
%=============================================================================
function [Fm, fm] = fillStatistic(X, M, loc, method)
  stat = sliceStatistic(X, M, method);
  Fm = reshape(stat(loc.col), [], 1);
  fm = ~isnan(Fm);
end
%=============================================================================
function stat = sliceStatistic(X, M, method)
  % Mean, median or mode of the nonmissing values of each slice (column of X).
  if isfloat(X)
    values = X;
  else
    values = double(X);
  end
  values(M) = NaN;
  stat = columnStatistic(values, method);
end
%=============================================================================
function stat = columnStatistic(values, method)
  % values: n x cols with NaN for missing entries. Returns 1 x cols (NaN when a column is all missing).
  [n, cols] = size(values);
  known = ~isnan(values);
  count = sum(known, 1);
  offsets = (0:cols - 1) * n;
  switch method
    case 'mean'
      values(~known) = 0;
      stat = sum(values, 1) ./ count;
    case 'median'
      sorted = sort(values, 1);
      lo = max(floor((count + 1) / 2), 1);
      hi = max(ceil((count + 1) / 2), 1);
      stat = (sorted(lo + offsets) + sorted(hi + offsets)) / 2;
      stat(count == 0) = NaN;
    case 'mode'
      sorted = sort(values, 1);
      valid = ~isnan(sorted);
      starts = valid & [true(1, cols); diff(sorted, 1, 1) ~= 0];
      p = find(starts);
      e = [p(2:end) - 1; numel(sorted)];
      cumulated = cumsum(valid(:));
      runLength = zeros(n, cols);
      runLength(p) = cumulated(e) - cumulated(p) + 1;
      [frequency, idx] = max(runLength, [], 1);
      stat = sorted(idx + offsets);
      stat(frequency == 0) = NaN;
  end
end
%=============================================================================
function [Fm, fm] = applyEndValues(X, Fm, fm, loc, endValues)
  % Leading and trailing missing entries of each slice follow EndValues instead of the fill method.
  leading = loc.gpos == loc.lo;
  trailing = loc.gpos == loc.hi;
  if ischar(endValues)
    method = lower(endValues);
    if ~any(strcmp(method, {'none', 'previous', 'next', 'nearest'}))
      error('Nelson:data_analysis:unsupportedEndValuesMethod', 'Unsupported EndValues method.');
    end
    fm(leading | trailing) = false;
    if any(strcmp(method, {'next', 'nearest'}))
      k = leading & loc.hi > loc.lo;
      Fm(k) = X(loc.p(loc.gpos(k) + 1));
      fm(k) = true;
    end
    if any(strcmp(method, {'previous', 'nearest'}))
      k = trailing & loc.gpos > loc.lo;
      Fm(k) = X(loc.p(loc.gpos(k)));
      fm(k) = true;
    end
  else
    ends = leading | trailing;
    if isscalar(endValues)
      Fm(ends) = endValues;
    else
      Fm(ends) = endValues(loc.col(ends));
    end
    fm(ends) = true;
  end
end
%=============================================================================
function tooLarge = gapTooLarge(x, loc, maxGap)
  % Gap size: distance between the nonmissing values around a gap, or to the first/last sample point for end gaps.
  hasPrevious = loc.gpos > loc.lo;
  hasNext = loc.gpos < loc.hi;
  xl = x(rowOf(loc, knownIndex(loc, loc.gpos, hasPrevious)));
  xr = x(rowOf(loc, knownIndex(loc, loc.gpos + 1, hasNext)));
  xl(~hasPrevious) = x(1);
  xr(~hasNext) = x(end);
  tooLarge = (xr - xl) > maxGap;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [G, varargout] = findgroups(varargin)
  narginchk(1, inf);
  nargoutchk(0, nargin + 1);
  varargout = {};
  nv = nargin;
  sz = size(varargin{1});
  n = numel(varargin{1});
  missingMask = false(n, 1);
  idxCols = zeros(n, nv);
  for j = 1:nv
    xj = varargin{j}(:);
    if numel(xj) ~= n
      error('Nelson:data_analysis:allGroupingVariablesSameNumber', 'All grouping variables must have the same number of rows.');
    end
    missingMask = missingMask | ismissing(xj);
    [~, ~, ic] = unique(xj);
    idxCols(:, j) = ic;
  end
  [~, ~, groupOfRow] = unique(idxCols, 'rows');
  G = double(groupOfRow);
  G(missingMask) = NaN;
  valid = ~isnan(G);
  validGroups = unique(G(valid));
  if isempty(validGroups)
    G = reshape(G, sz);
  else
    remap = zeros(max(validGroups), 1);
    remap(validGroups) = 1:numel(validGroups);
    G(valid) = remap(G(valid));
    G = reshape(G, sz);
  end
  if nargout > 1
    Gv = G(:);
    if isempty(validGroups)
      ngroups = 0;
    else
      ngroups = numel(validGroups);
    end
    firstRows = zeros(ngroups, 1);
    for g = 1:ngroups
      firstRows(g) = find(Gv == g, 1);
    end
    for j = 1:nv
      xj = varargin{j}(:);
      varargout{j} = xj(firstRows);
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = groupcounts(T, varargin)
  narginchk(1, Inf);
  if istable(T)
    nargoutchk(0, 1);
    if isempty(varargin)
      error('Nelson:data_analysis:groupingVariablesExpected', 'Grouping variables expected.');
    end
    groupVars = varargin{1};
    args = varargin(2:end);
    varargout{1} = groupcountsTable(T, groupVars, args);
  else
    [counts, groups, percent] = groupcountsArray(T, varargin);
    varargout{1} = counts;
    if nargout > 1
      varargout{2} = groups;
    end
    if nargout > 2
      varargout{3} = percent;
    end
  end
end
%=============================================================================
function G = groupcountsTable(T, groupVars, args)
  opts = parseGroupcountsOptions(args);
  if opts.GroupBinsProvided
    error('Nelson:data_analysis:groupBinsSupportedTableGroupcounts', 'Group bins are not supported for table groupcounts.');
  end
  st = struct(T);
  idx = tableResolveVariables(st.Properties.VariableNames, groupVars, st.Properties.VariableTypes, st.data);
  if isempty(idx)
    counts = height(T);
    percent = 100;
    G = table(counts, percent, 'VariableNames', {'GroupCount', 'Percent'});
    return
  end
  names = st.Properties.VariableNames;
  keys = tableRowKeys(st, height(T), idx);
  missingRows = any(ismissing(T(:, names(idx))), 2);
  if ~opts.IncludeMissingGroups
    keep = ~missingRows;
    keys = keys(keep);
    sourceRows = find(keep);
  else
    sourceRows = (1:height(T))';
  end
  [uniqueKeys, ia] = tableUniqueStable(keys);
  rows = sourceRows(ia);
  counts = zeros(length(uniqueKeys), 1);
  for k = 1:length(uniqueKeys)
    counts(k) = sum(strcmp(keys, uniqueKeys{k}));
  end
  total = sum(counts);
  if total == 0
    percent = counts;
  else
    percent = counts * 100 / total;
  end
  G = T(rows, names(idx));
  G.GroupCount = counts;
  G.Percent = percent;
end
%=============================================================================
function [counts, groups, percent] = groupcountsArray(X, args)
  opts = parseGroupcountsOptions(args);
  if opts.GroupBinsProvided
    error('Nelson:data_analysis:groupBinsSupported', 'Group bins are not supported.');
  end
  if iscell(X)
    n = numel(X{1});
    keys = cell(n, 1);
    for r = 1:n
      parts = cell(1, length(X));
      for c = 1:length(X)
        parts{c} = tableValueKey(X{c}(r));
      end
      keys{r} = strjoin(parts, '|');
    end
    groupSource = X;
  else
    n = size(X, 1);
    keys = cell(n, 1);
    for r = 1:n
      keys{r} = tableValueKey(X(r, :));
    end
    groupSource = X;
  end
  [uniqueKeys, ia] = tableUniqueStable(keys);
  counts = zeros(length(uniqueKeys), 1);
  for k = 1:length(uniqueKeys)
    counts(k) = sum(strcmp(keys, uniqueKeys{k}));
  end
  total = sum(counts);
  if total == 0
    percent = counts;
  else
    percent = counts * 100 / total;
  end
  if iscell(groupSource)
    groups = cell(1, length(groupSource));
    for c = 1:length(groupSource)
      groups{c} = groupSource{c}(ia);
    end
  else
    groups = groupSource(ia, :);
  end
end
%=============================================================================
function opts = parseGroupcountsOptions(args)
  opts = struct();
  opts.IncludeMissingGroups = true;
  opts.IncludeEmptyGroups = false;
  opts.IncludedEdge = 'left';
  opts.GroupBinsProvided = false;
  if ~isempty(args)
    first = args{1};
    if ~(ischar(first) || (isstring(first) && isscalar(first)))
      opts.GroupBinsProvided = true;
      args(1) = [];
    end
  end
  k = 1;
  while k <= length(args)
    name = args{k};
    if isstring(name)
      name = char(name);
    end
    if k == length(args)
      error('Nelson:data_analysis:nameValueArgumentFollowedValue', 'Name-value argument must be followed by a value.');
    end
    switch lower(name)
      case 'includemissinggroups'
        opts.IncludeMissingGroups = logical(args{k + 1});
      case 'includeemptygroups'
        opts.IncludeEmptyGroups = logical(args{k + 1});
      case 'includededge'
        opts.IncludedEdge = char(args{k + 1});
      otherwise
        error('Nelson:data_analysis:unknownOption', 'Unknown option.');
    end
    k = k + 2;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function G = groupsummary(T, groupVars, method, dataVars)
  narginchk(2, 4);
  if isa(T, 'timetable')
    % Grouping is by a data variable, so drop the row times and summarize
    % the data variables as a table (matching the reference).
    T = timetable2table(T, 'ConvertRowTimes', false);
  end
  mustBeA(T, 'table', 1);
  if nargin < 3 || isempty(method)
    method = 'count';
  end
  st = struct(T);
  names = st.Properties.VariableNames;
  if nargin < 4
    dataVars = setdiffIndicesLocal(1:width(T), tableResolveVariables(names, groupVars, st.Properties.VariableTypes, st.data));
  else
    dataVars = tableResolveVariables(names, dataVars, st.Properties.VariableTypes, st.data);
  end
  groupIdx = tableResolveVariables(names, groupVars, st.Properties.VariableTypes, st.data);
  keys = tableRowKeys(st, height(T), groupIdx);
  uniqueKeys = tableUniqueStable(keys);
  rows = zeros(length(uniqueKeys), 1);
  groupCounts = zeros(length(uniqueKeys), 1);
  values = cell(1, length(dataVars));
  outNames = cell(1, length(dataVars));
  for g = 1:length(uniqueKeys)
    found = find(strcmp(keys, uniqueKeys{g}));
    rows(g) = found(1);
    groupCounts(g) = length(found);
    for j = 1:length(dataVars)
      column = T.(names{dataVars(j)});
      data = tableColumnRows(column, found);
      values{j} = appendGroupValue(values{j}, applyGroupMethod(data, method));
      outNames{j} = [char(method), '_', names{dataVars(j)}];
    end
  end
  G = T(rows, names(groupIdx));
  G.GroupCount = groupCounts;
  for j = 1:length(values)
    G.(outNames{j}) = values{j};
  end
end
%=============================================================================
function idx = setdiffIndicesLocal(allIdx, removeIdx)
  idx = [];
  for k = allIdx(:)'
    if ~any(removeIdx == k)
      idx(end + 1) = k;
    end
  end
end
%=============================================================================
function value = applyGroupMethod(data, method)
  if isa(method, 'function_handle')
    value = method(data);
    return
  end
  switch lower(char(method))
    case 'count'
      value = size(data, 1);
    case 'sum'
      value = sum(data);
    case 'mean'
      value = mean(data);
    case 'min'
      value = min(data);
    case 'max'
      value = max(data);
    otherwise
      error('Nelson:data_analysis:unsupportedSummaryMethod', 'Unsupported "%s" option.', char(method));
  end
end
%=============================================================================
function values = appendGroupValue(values, value)
  if isempty(values)
    values = value;
  else
    values = [values; value];
  end
end
