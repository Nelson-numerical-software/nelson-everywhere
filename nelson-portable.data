% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [bw, thresh] = ip_edge_canny(img, thresh, sigma)
  ip_validate_edge_threshold(thresh, true);
  thresh = double(thresh);
  sigma = ip_validate_edge_sigma(sigma, sqrt(2));
  filterSize = 2 * ceil(3 * sigma) + 1;
  smooth = imfilter(img, fspecial('gaussian', [filterSize filterSize], sigma), 'replicate');
  gx = imfilter(smooth, fspecial('sobel')', 'replicate');
  gy = imfilter(smooth, fspecial('sobel'), 'replicate');
  mag = sqrt(gx .^ 2 + gy .^ 2);
  nms = ip_edge_nonmax(mag, atan2(gy, gx));
  if isempty(thresh)
    positive = nms(nms > 0);
    if isempty(positive)
      thresh = [0 0];
      bw = false(size(img));
      return
    end
    high = graythresh(positive);
    low = 0.4 * high;
    thresh = [low high];
  elseif isscalar(thresh)
    thresh = [0.4 * thresh thresh];
  else
    thresh = reshape(thresh, 1, 2);
  end
  nonzero = nms > 0;
  strong = nonzero & nms >= thresh(2);
  weak = nonzero & nms >= thresh(1);
  bw = ip_edge_hysteresis(strong, weak);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function bw = ip_edge_hysteresis(strong, weak)
  strong = logical(strong);
  weak = logical(weak) | strong;
  bw = false(size(strong));
  if ~any(strong(:)) || ~any(weak(:))
    return
  end
  cc = bwconncomp(weak, 8);
  strong = strong(:);
  for k = 1:cc.NumObjects
    idx = cc.PixelIdxList{k};
    if any(strong(idx))
      bw(idx) = true;
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [bw, thresh] = ip_edge_log(img, thresh, sigma)
  ip_validate_edge_threshold(thresh, false);
  thresh = double(thresh);
  sigma = ip_validate_edge_sigma(sigma, 2);
  filterSize = 2 * ceil(3 * sigma) + 1;
  response = imfilter(img, fspecial('log', [filterSize filterSize], sigma), 'replicate');
  if isempty(thresh)
    thresh = 0.75 * mean(abs(response(:)));
  end
  bw = false(size(img));
  for dy = -1:1
    for dx = -1:1
      if dy == 0 && dx == 0
        continue
      end
      shifted = padarray(response, [1 1], 'replicate');
      shifted = shifted(2 + dy:end - 1 + dy, 2 + dx:end - 1 + dx);
      crossing = (response > 0 & shifted < 0) | (response < 0 & shifted > 0);
      touchingZero = response == 0 & shifted ~= 0;
      bw = bw | ((crossing | touchingZero) & abs(response - shifted) > thresh);
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function nms = ip_edge_nonmax(mag, angle)
  nms = zeros(size(mag));
  height = size(mag, 1);
  width = size(mag, 2);
  if height < 3 || width < 3
    return
  end
  ux = cos(angle);
  uy = sin(angle);
  for y = 2:height - 1
    for x = 2:width - 1
      forwardY = y + uy(y, x);
      forwardX = x + ux(y, x);
      backwardY = y - uy(y, x);
      backwardX = x - ux(y, x);
      y1 = min(max(floor(forwardY), 1), height - 1);
      x1 = min(max(floor(forwardX), 1), width - 1);
      dy = forwardY - y1;
      dx = forwardX - x1;
      before = (1 - dy) * ((1 - dx) * mag(y1, x1) + dx * mag(y1, x1 + 1)) ...
        + dy * ((1 - dx) * mag(y1 + 1, x1) + dx * mag(y1 + 1, x1 + 1));
      y1 = min(max(floor(backwardY), 1), height - 1);
      x1 = min(max(floor(backwardX), 1), width - 1);
      dy = backwardY - y1;
      dx = backwardX - x1;
      after = (1 - dy) * ((1 - dx) * mag(y1, x1) + dx * mag(y1, x1 + 1)) ...
        + dy * ((1 - dx) * mag(y1 + 1, x1) + dx * mag(y1 + 1, x1 + 1));
      if mag(y, x) >= before && mag(y, x) >= after
        nms(y, x) = mag(y, x);
      end
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function T = ip_estimate_registration_tform(moving, fixed, transformType, metricType, options)
  if strcmp(transformType, 'translation')
    T = ip_translation_registration(moving, fixed, options);
    return
  end
  span = min(max(abs(options.AngleSearch), 0), 45);
  step = max(1, ceil(span / 6));
  angles = -span:step:span;
  if strcmp(transformType, 'affine')
    [T, angle, scaleX, scaleY, shear] = ip_registration_affine_search(...
      moving, fixed, angles, options, metricType);
    fineAngles = (angle - step):max(step / 4, 1):(angle + step);
    fineX = unique([scaleX - options.ScaleSearch / 2, scaleX, ...
      scaleX + options.ScaleSearch / 2]);
    fineY = unique([scaleY - options.ScaleSearch / 2, scaleY, ...
      scaleY + options.ScaleSearch / 2]);
    fineShear = unique([shear - options.ShearSearch / 2, shear, ...
      shear + options.ShearSearch / 2]);
    Tfine = ip_registration_affine_search(moving, fixed, fineAngles, ...
      options, metricType, fineX, fineY, fineShear);
    if ip_registration_score(moving, fixed, Tfine, metricType, options.Interpolation) ...
        > ip_registration_score(moving, fixed, T, metricType, options.Interpolation)
      T = Tfine;
    end
    return
  end
  scales = 1;
  if strcmp(transformType, 'similarity')
    scales = unique([1 - options.ScaleSearch, 1, 1 + options.ScaleSearch]);
  end
  [T, bestAngle, bestScale] = ip_registration_search(moving, fixed, angles, scales, metricType, options);
  fineAngles = (bestAngle - step):max(step / 4, 1):(bestAngle + step);
  if numel(scales) == 1
    fineScales = bestScale;
  else
    fineScales = unique([bestScale - options.ScaleSearch / 2, bestScale, ...
      bestScale + options.ScaleSearch / 2]);
  end
  Tfine = ip_registration_search(moving, fixed, fineAngles, fineScales, metricType, options);
  if ip_registration_score(moving, fixed, Tfine, metricType, options.Interpolation) ...
      > ip_registration_score(moving, fixed, T, metricType, options.Interpolation)
    T = Tfine;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
