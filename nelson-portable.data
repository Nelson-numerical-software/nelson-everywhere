outputs1 = 1;
inputs2 = 1;
sys = series(sys1, sys2, outputs1, inputs2);

A_REF = [0 1 0 0; -9 -36 1 0; 0 0 0 1; 0 0 -1 -6];
B_REF = [0; 0; 0; 1];
C_REF = [1 0 0 0];
D_REF = 0;
sys_REF = ss(A_REF, B_REF, C_REF, D_REF);

asserts.isequal(sys, sys_REF);
