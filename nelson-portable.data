% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [bw, thresh] = edge(varargin)
  narginchk(1, 4);
  nargoutchk(0, 2);
  ip_assert_full_image(varargin{1}, true);
  img = im2gray(varargin{1});
  if nargin >= 2
    if ~(ischar(varargin{2}) || isStringScalar(varargin{2}))
      error('Nelson:image_processing:edgeDetectionMethodString', '%s must be a string.', 'Edge detection method');
    end
    method = lower(convertStringsToChars(varargin{2}));
  else
    method = 'sobel';
  end
  sigma = [];
  if nargin >= 3 && ~isempty(varargin{3})
    thresh = varargin{3};
  else
    thresh = [];
  end
  if nargin >= 4
    sigma = varargin{4};
  end
  d = ip_to_unit_double(img);
  direction = 'both';
  switch method
    case 'sobel'
      direction = ip_validate_edge_direction(sigma);
      hx = fspecial('sobel')';
      hy = fspecial('sobel');
    case 'prewitt'
      direction = ip_validate_edge_direction(sigma);
      hx = fspecial('prewitt')';
      hy = fspecial('prewitt');
    case 'roberts'
      direction = ip_validate_edge_direction(sigma);
      hx = zeros(2, 2);
      hx(1, 1) = 1;
      hx(2, 2) = -1;
      hy = zeros(2, 2);
      hy(1, 2) = 1;
      hy(2, 1) = -1;
    case 'log'
      [bw, thresh] = ip_edge_log(d, thresh, sigma);
      return
    case 'canny'
      [bw, thresh] = ip_edge_canny(d, thresh, sigma);
      return
    otherwise
      error('Nelson:image_processing:unsupportedEdgeDetectionMethod', 'Unsupported "%s" option.', 'edge detection method');
  end
  ip_validate_edge_threshold(thresh, false);
  gx = imfilter(d, hx, 'replicate');
  gy = imfilter(d, hy, 'replicate');
  if strcmp(direction, 'horizontal')
    if strcmp(method, 'roberts')
      mag = abs(gx);
    else
      mag = abs(gy);
    end
  elseif strcmp(direction, 'vertical')
    if strcmp(method, 'roberts')
      mag = abs(gy);
    else
      mag = abs(gx);
    end
  else
    mag = sqrt(gx .^ 2 + gy .^ 2);
  end
  if isempty(thresh)
    thresh = graythresh(mag);
  end
  bw = mag > thresh;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function tform = fitgeotrans(movingPoints, fixedPoints, transformType)
  narginchk(3, 3);
  nargoutchk(0, 1);
  movingPoints = ip_validate_control_points(movingPoints, 'Moving points');
  fixedPoints = ip_validate_control_points(fixedPoints, 'Fixed points');
  if ~isequal(size(movingPoints), size(fixedPoints))
    error('Nelson:image_processing:movingFixedPointsSameSize', '%s must have the same size.', 'Moving and fixed points');
  end
  if ~(ischar(transformType) || isstring(transformType))
    error('Nelson:image_processing:transformationTypeString', '%s must be a string.', 'Transformation type');
  end
  transformType = lower(convertStringsToChars(transformType));
  switch transformType
    case 'affine'
      T = ip_fit_affine_transform(movingPoints, fixedPoints);
      tform = affine2d(T);
    case 'projective'
      T = ip_fit_projective_transform(movingPoints, fixedPoints);
      tform = projective2d(T);
    otherwise
      error('Nelson:image_processing:unsupportedGeometricTransformationType', 'Unsupported "%s" option.', 'geometric transformation type');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function h = fspecial(varargin)
  narginchk(1, 3);
  nargoutchk(0, 1);
  type = lower(convertStringsToChars(varargin{1}));
  if nargin >= 2 && (strcmp(type, 'average') || strcmp(type, 'gaussian') || strcmp(type, 'log'))
    siz = varargin{2};
  else
    siz = [3 3];
  end
  if numel(siz) == 1
    siz = [siz siz];
  end
  if ~isnumeric(siz) || ~isreal(siz) || numel(siz) ~= 2 || any(~isfinite(double(siz(:)))) ...
      || any(siz(:) < 1) || any(siz(:) ~= floor(siz(:)))
    error('Nelson:image_processing:filterSizeContainPositiveIntegers', '%s size must contain positive integers.', 'Filter');
  end
  siz = double(siz);
  switch type
    case 'average'
      h = ones(siz(1), siz(2));
      h = h / sum(h(:));
    case 'disk'
      if nargin >= 2
        radius = varargin{2};
      else
        radius = 5;
      end
      if ~isnumeric(radius) || ~isreal(radius) || ~isscalar(radius) || ~isfinite(double(radius)) ...
          || radius < 0
        error('Nelson:image_processing:diskRadiusNonnegativeFiniteScalar', '%s must be a nonnegative finite scalar.', 'Disk radius');
      end
      radius = double(radius);
      gridRadius = ceil(radius);
      [x, y] = meshgrid(-gridRadius:gridRadius, -gridRadius:gridRadius);
      h = double((x .^ 2 + y .^ 2) <= radius ^ 2);
      h = h / sum(h(:));
    case 'gaussian'
      if nargin >= 3
        sigma = varargin{3};
      else
        sigma = 0.5;
      end
      if ~isnumeric(sigma) || ~isreal(sigma) || ~isscalar(sigma) || ~isfinite(double(sigma)) || sigma <= 0
        error('Nelson:image_processing:sigmaPositiveFiniteScalar', '%s must be a positive finite scalar.', 'Sigma');
      end
      sigma = double(sigma);
      cy = (siz(1) + 1) / 2; cx = (siz(2) + 1) / 2;
      h = zeros(siz(1), siz(2));
      for y = 1:siz(1)
        for x = 1:siz(2)
          h(y, x) = exp(-((y - cy) ^ 2 + (x - cx) ^ 2) / (2 * sigma ^ 2));
        end
      end
      h = h / sum(h(:));
    case 'sobel'
      row1 = [1 2 1];
      row2 = [0 0 0];
      row3 = -row1;
      h = [row1; row2; row3];
    case 'prewitt'
      row1 = [1 1 1];
      row2 = [0 0 0];
      row3 = -row1;
      h = [row1; row2; row3];
    case 'laplacian'
      alpha = 0.2;
      if nargin >= 2
        alpha = varargin{2};
      end
      if ~isnumeric(alpha) || ~isreal(alpha) || ~isscalar(alpha) || ~isfinite(double(alpha)) ...
          || alpha < 0 || alpha > 1
        error('Nelson:image_processing:alphaFiniteScalarRange', '%s must be a finite scalar in the range [%s].', 'Alpha', '0, 1');
      end
      alpha = double(alpha);
      h = zeros(3, 3);
      h(1, 1) = alpha;
      h(1, 2) = 1 - alpha;
      h(1, 3) = alpha;
      h(2, 1) = 1 - alpha;
      h(2, 2) = -4;
      h(2, 3) = 1 - alpha;
      h(3, 1) = alpha;
      h(3, 2) = 1 - alpha;
      h(3, 3) = alpha;
      h = h / (alpha + 1);
    case 'log'
      if nargin < 3
        sigma = 0.5;
      else
        sigma = varargin{3};
      end
      if ~isnumeric(sigma) || ~isreal(sigma) || ~isscalar(sigma) || ~isfinite(double(sigma)) || sigma <= 0
        error('Nelson:image_processing:sigmaPositiveFiniteScalar', '%s must be a positive finite scalar.', 'Sigma');
      end
      sigma = double(sigma);
      g = fspecial('gaussian', siz, sigma);
      [gy, gx] = gradient(g);
      [gyy, ~] = gradient(gy);
      [~, gxx] = gradient(gx);
      h = gxx + gyy;
      h = h - sum(h(:)) / numel(h);
    otherwise
      error('Nelson:image_processing:unsupportedFilterType', 'Unsupported "%s" option.', 'filter type');
  end
end
