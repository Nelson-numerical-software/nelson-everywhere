% LICENCE_BLOCK_END
%=============================================================================
function value = odeValidateSundialsPreconditioner(value)
  value = odeValidateSundialsChoice(value, 'Preconditioner', ...
    {'auto', 'none', 'jacobi', 'banded', 'ilu0'});
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
