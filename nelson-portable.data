  c{end + 1} = entry('ElastoBacklash', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'backlash', {{'a', 'a'}, {'b', 'b'}}, {{'c', 'c', 1, 'N.m/rad'}, {'b', 'play', 0, 'rad'}}, '', '', ...
    'Rotational backlash: elastic torque with a dead zone of total play b.');
  c{end + 1} = entry('RotSpringDamper', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'spring', {{'a', 'a'}, {'b', 'b'}}, {{'c', 'c', 1, 'N.m/rad'}, {'d', 'd', 1, 'N.m.s/rad'}}, '', '', ...
    'Parallel rotational spring and damper: tau = c (phi_a - phi_b) + d (w_a - w_b).');
  c{end + 1} = entry('RotBrake', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'brake', {{'flange', 'node'}}, {{'w_eps', 'vEps', 0.001, 'rad/s'}}, 'f', '', ...
    'Signal-actuated rotational brake to ground: the input sets the peak braking torque.');
  c{end + 1} = entry('BearingFriction', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'friction', {{'flange', 'node'}}, {{'tau_c', 'Fc', 1, 'N.m'}, {'w_eps', 'vEps', 0.001, 'rad/s'}}, '', '', ...
    'Regularised bearing friction (event-free): tau = -tau_c tanh(w / w_eps).');
  c{end + 1} = entry('LinearSpeedDependentTorque', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'linearSpeedForce', {{'flange', 'node'}}, {{'d', 'd', 1, 'N.m.s/rad'}}, '', '', ...
    'Speed-proportional resistance to ground: tau = -d w.');
  c{end + 1} = entry('QuadraticSpeedDependentTorque', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'quadraticSpeedForce', {{'flange', 'node'}}, {{'d', 'd', 1, 'N.m.s2/rad2'}}, '', '', ...
    'Quadratic (drag) resistance to ground: tau = -d w |w|.');
  c{end + 1} = entry('Freewheel', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'freewheel', {{'a', 'a'}, {'b', 'b'}}, {{'d', 'd', 100, 'N.m.s/rad'}, {'w_eps', 'vEps', 0.001, 'rad/s'}}, '', '', ...
    'One-way clutch: couples flange a to b only while a overruns b (freewheels otherwise).');
  c{end + 1} = entry('Clutch', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'clutch', {{'a', 'a'}, {'b', 'b'}}, {{'tau_max', 'Fc', 1, 'N.m'}, {'w_eps', 'vEps', 0.001, 'rad/s'}}, '', '', ...
    'Rotational clutch (event-free stick-slip): tau = tau_max tanh((w_a - w_b) / w_eps) reduces the slip toward a common speed.');
  c{end + 1} = entry('RotFixed', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'fixed', {{'flange', 'node'}}, {{'phi0', 's0', 0, 'rad'}}, '', '', ...
    'Flange fixed at a prescribed angle phi0.');
  c{end + 1} = entry('IdealGear', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'gear', {{'a', 'a'}, {'b', 'b'}}, {{'ratio', 'ratio', 1, '1'}}, '', '', ...
    'Ideal gear phi_a = ratio phi_b (structural node merge, inertia folded).');
  % Rod / Lever map to the same structural gear merge (ratio 1 / arm ratio).
  c{end + 1} = entry('Rod', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'gear', {{'a', 'a'}, {'b', 'b'}}, {{'ratio', 'ratio', 1, '1'}}, '', '', ...
    'Rigid massless rod: s_a = s_b (structural merge; ratio defaults to 1).');
  c{end + 1} = entry('Lever', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'gear', {{'a', 'a'}, {'b', 'b'}}, {{'ratio', 'ratio', 1, '1'}}, '', '', ...
    'Lever (small-angle): s_a = ratio s_b, the arm ratio (structural merge).');
  c{end + 1} = entry('Pulley', 'Translational', 'translational', 'mechanicalTranslationalIsland', ...
    'gear', {{'a', 'a'}, {'b', 'b'}}, {{'ratio', 'ratio', 1, '1'}}, '', '', ...
    'Ideal pulley: s_a = ratio s_b (structural merge; ratio = radius ratio).');
  c{end + 1} = entry('Torque', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'force', {{'flange', 'node'}}, {}, 'F', '', ...
    'External torque on a flange, driven by the input signal.');
  c{end + 1} = entry('Torque2', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'force2', {{'a', 'a'}, {'b', 'b'}}, {}, 'F', '', ...
    'Equal and opposite torque between two flanges: +tau on a, -tau on b (signal-driven).');
  c{end + 1} = entry('ConstantTorque', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'force', {{'flange', 'node'}}, {{'tau', 'F', 0, 'N.m'}}, '', '', ...
    'Constant torque on a flange.');
  c{end + 1} = entry('SineTorque', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'force', {{'flange', 'node'}}, ...
    {{'Amplitude', 'Amplitude', 1, 'N.m'}, {'Frequency', 'Frequency', 1, 'Hz'}, {'Phase', 'Phase', 0, 'rad'}}, ...
    '', '', 'Sine torque on a flange: tau = Amplitude sin(2 pi Frequency t + Phase).');
  c{end + 1} = entry('RampTorque', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'force', {{'flange', 'node'}}, ...
    {{'Slope', 'slope', 1, 'N.m/s'}, {'StartTime', 'start', 0, 's'}}, ...
    '', '', 'Ramp torque on a flange: tau = Slope (t - StartTime) for t >= StartTime, else 0.');
  c{end + 1} = entry('ExpSineTorque', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'force', {{'flange', 'node'}}, ...
    {{'Amplitude', 'Amplitude', 1, 'N.m'}, {'Frequency', 'Frequency', 2, 'Hz'}, ...
     {'Damping', 'Damping', 0.5, '1/s'}, {'Phase', 'Phase', 0, 'rad'}}, ...
    '', '', 'Exponentially damped sine torque on a flange.');
  c{end + 1} = entry('TrapezoidTorque', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'force', {{'flange', 'node'}}, ...
    {{'Amplitude', 'Amplitude', 1, 'N.m'}, {'Rising', 'Rising', 0.2, 's'}, {'Width', 'Width', 0.3, 's'}, ...
     {'Falling', 'Falling', 0.2, 's'}, {'Period', 'Period', 1, 's'}}, ...
    '', '', 'Trapezoidal torque on a flange (continuous ramp-up / hold / ramp-down).');
  c{end + 1} = entry('RotAccelerate', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'accelerate', {{'flange', 'node'}}, {{'phi0', 's0', 0, 'rad'}, {'w0', 'v0', 0, 'rad/s'}}, 'a', '', ...
    'Prescribed motion: the flange angular acceleration follows the input signal.');
  c{end + 1} = entry('RotSpeed', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'prescribedSpeed', {{'flange', 'node'}}, {{'phi0', 's0', 0, 'rad'}}, 'w', '', ...
    'Prescribed motion: the flange angular velocity follows the input signal.');
  c{end + 1} = entry('ConstantRotSpeed', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'prescribedSpeed', {{'flange', 'node'}}, {{'w', 'v', 1, 'rad/s'}, {'phi0', 's0', 0, 'rad'}}, '', '', ...
    'Prescribed motion: the flange rotates at a constant angular velocity w.');
  c{end + 1} = entry('AngleSensor', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'positionSensor', {{'flange', 'node'}}, {}, '', 'angle', ...
    'Measures the absolute angle of a flange.');
  c{end + 1} = entry('RotSpeedSensor', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'speedSensor', {{'flange', 'node'}}, {}, '', 'speed', ...
    'Measures the absolute angular velocity of a flange.');
  c{end + 1} = entry('RelAngleSensor', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'relPositionSensor', {{'a', 'a'}, {'b', 'b'}}, {}, '', 'angle', ...
    'Measures the relative angle phi_a - phi_b between two flanges.');
  c{end + 1} = entry('RelRotSpeedSensor', 'Rotational', 'rotational', 'mechanicalTranslationalIsland', ...
    'relSpeedSensor', {{'a', 'a'}, {'b', 'b'}}, {}, '', 'speed', ...
    'Measures the relative angular velocity w_a - w_b between two flanges.');

  catalog = [c{:}];
end
%=============================================================================
function e = entry(name, group, domain, island, kind, pins, params, signalIn, signalOut, desc)
  e = struct('name', name, 'group', group, 'domain', domain, 'island', island, ...
    'kind', kind, 'pins', {pins}, 'params', {params}, 'signalIn', signalIn, ...
    'signalOut', signalOut, 'desc', desc);
end
