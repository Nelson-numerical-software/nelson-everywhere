% LICENCE_BLOCK_END
%=============================================================================
function map = abyss(varargin)
  narginchk(0, 1);
  if nargin < 1
    R = groot();
    f = R.CurrentFigure;
    if isempty(f)
      m = size(R.DefaultFigureColormap, 1);
    else
      m = size(f.Colormap, 1);
    end
  else
    m = varargin{1};
  end

  firstColor = [0.1490, 0.5490, 0.8667];
  vector = linspace(0.25, 1, m)';
  map = firstColor .* vector;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = autumn(varargin)
  narginchk(0, 1);
  nargoutchk(0, 1);
  narginchk(0, 1);
  if nargin < 1
    R = groot();
    f = R.CurrentFigure;
    if isempty(f)
      n = size(R.DefaultFigureColormap, 1);
    else
      n = size(f.Colormap, 1);
    end
  else
    n = varargin{1};
  end

  if (n == 1)
    varargout{1} = [1, 0, 0];
  else
    if (n <= 0)
      varargout{1} = zeros(0, 3);
    else
      r = (0:n - 1)' / max(n - 1, 1);
      varargout{1} = [ones(n, 1), r, zeros(n, 1)];
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function map = bone(varargin)
  narginchk(0, 1);
  if nargin < 1
    R = groot();
    f = R.CurrentFigure;
    if isempty(f)
      m = size(R.DefaultFigureColormap, 1);
    else
      m = size(f.Colormap, 1);
    end
  else
    m = varargin{1};
  end

  map = (7 * gray(m) + fliplr(hot(m))) / 8;
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function map = colorcube(varargin)
  narginchk(0, 1);
  m = requestedColorCount(varargin{:});
  if m < 8
    map = gray(m);
    return
  end
  redGreenSteps = fix(m ^ (1 / 3) + eps);
  extraColors = m - redGreenSteps ^ 3;
  if extraColors == 0 && redGreenSteps > 2
    blueSteps = redGreenSteps - 1;
  else
    blueSteps = redGreenSteps;
  end
  map = colorCubeGrid(redGreenSteps, blueSteps);
  map = removeRepeatedAndDarkEdges(map);
  map = [map; primaryAndGrayRamps(m - size(map, 1) - 1)];
end
%=============================================================================
function map = colorCubeGrid(redGreenSteps, blueSteps)
  rgValues = linspace(0, 1, redGreenSteps);
  bValues = linspace(0, 1, blueSteps);
  %#ok<NLS0004>
  [red, green, blue] = meshgrid(rgValues, rgValues, bValues);
  map = [red(:), green(:), blue(:)];
end
%=============================================================================
function map = removeRepeatedAndDarkEdges(map)
  movement = sum(abs(diff(map.').'), 2);
  map = map(movement ~= 0, :);
  pairSums = [sum(map(:, [1 2]), 2), sum(map(:, [2 3]), 2), sum(map(:, [1 3]), 2)];
  map = map(min(pairSums, [], 2) ~= 0, :);
end
%=============================================================================
function map = primaryAndGrayRamps(remainingColors)
  primarySteps = floor(remainingColors / 4);
  graySteps = remainingColors - 3 * primarySteps;
  primaryRamp = linspace(1 / primarySteps, 1, primarySteps).';
  zeroRamp = zeros(primarySteps, 1);
  grayRamp = linspace(1 / graySteps, 1, graySteps).';
  map = [primaryRamp, zeroRamp, zeroRamp;
    zeroRamp, primaryRamp, zeroRamp;
    zeroRamp, zeroRamp, primaryRamp;
    0, 0, 0;
    grayRamp, grayRamp, grayRamp];
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function map = cool(varargin)
  narginchk(0, 1);
  if nargin < 1
    R = groot();
    f = R.CurrentFigure;
    if isempty(f)
      m = size(R.DefaultFigureColormap, 1);
    else
      m = size(f.Colormap, 1);
    end
  else
    m = varargin{1};
  end
  r = (0:m - 1)' / max(m - 1, 1);
  map = [r, (1 - r), ones(m, 1)];
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = copper(varargin)
  nargoutchk(0, 1);
  narginchk(0, 1);
  if nargin < 1
    R = groot();
    f = R.CurrentFigure;
    if isempty(f)
      m = size(R.DefaultFigureColormap, 1);
    else
      m = size(f.Colormap, 1);
    end
  else
    m = varargin{1};
  end
  varargout{1} = min(1, gray(m) * diag([1.2500 0.7812 0.4975]));
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function varargout = flag(varargin)
  narginchk(0, 1);
  nargoutchk(0, 1);
  colorCount = requestedColorCount(varargin{:});
  pattern = [1 0 0;
             1 1 1;
             0 0 1;
             0 0 0];
  rowIndex = rem(0:colorCount - 1, size(pattern, 1)) + 1;
  varargout{1} = pattern(rowIndex, :);
end
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
