% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [tf, loc] = tableIsmemberKeys(keysA, keysB)
  tf = false(length(keysA), 1);
  loc = zeros(length(keysA), 1);
  for k = 1:length(keysA)
    found = find(strcmp(keysB, keysA{k}), 1);
    if ~isempty(found)
      tf(k) = true;
      loc(k) = found;
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function names = tableMakeUniqueNames(names)
  names = tableMakeValidName(names);
  used = {};
  for k = 1:length(names)
    base = names{k};
    candidate = base;
    suffix = 1;
    while any(strcmp(used, candidate))
      candidate = [base, '_', num2str(suffix)];
      suffix = suffix + 1;
    end
    names{k} = candidate;
    used{end + 1} = candidate;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function names = tableMakeValidName(names)
  if ischar(names)
    names = {names};
  elseif isstring(names)
    names = cellstr(names);
  end
  names = names(:)';
  for k = 1:length(names)
    name = names{k};
    if isempty(name)
      name = ['Var', num2str(k)];
    end
    name = regexprep(name, '[^a-zA-Z0-9_]', '_');
    if isempty(regexp(name(1), '[a-zA-Z]', 'once'))
      name = ['Var', name];
    end
    names{k} = name;
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function C = tableMergeSetRows(A, B, ia, ib, partCodes, codesC)
  % Rows A(ia, :) then B(ib, :), put in the row order of the numeric result
  % codesC (sorted or stable) that has the same rows as partCodes.
  [~, order] = ismember(codesC, partCodes, 'rows');
  C = [A(ia, :); B(ib, :)];
  C = C(order, :);
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function units = tableNormalizedUnits(props)
  % The VariableUnits of props as one char unit per variable ('' if unset).
  units = repmat({''}, 1, length(props.VariableNames));
  if ~isfield(props, 'VariableUnits') || isempty(props.VariableUnits)
    return
  end
  raw = props.VariableUnits;
  if isstring(raw)
    raw = cellstr(raw);
  end
  for k = 1:min(length(raw), length(units))
    value = raw{k};
    if isstring(value)
      value = char(value);
    end
    if isempty(value)
      units{k} = '';
    else
      units{k} = char(value);
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function s = tableNumberedDot(variableNames, s, isAssignment)
  % T.(n): a number as dynamic field name is the variable number n. An
  % assignment may create the variable that follows the last one (Var<n>).
  subs = s(1).subs;
  if ~strcmp(s(1).type, '.') || ischar(subs) || isstring(subs)
    return
  end
  if ~isnumeric(subs)
    error('Nelson:table:illegalVarSubscript', _('A table variable name must be a string scalar or a character vector.'));
  end
  if ~isscalar(subs) || ~isreal(subs) || subs < 1 || subs ~= fix(subs)
    error('Nelson:table:illegalVarIndex', _('A variable index must be a real positive integer.'));
  end
  if subs <= length(variableNames)
    s(1).subs = variableNames{subs};
  elseif isAssignment
    names = tableNumberedNewVariables(variableNames, double(subs));
    s(1).subs = names{1};
  else
    error('Nelson:table:varIndexOutOfRange', _('Variable index exceeds table dimensions.'));
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function names = tableNumberedNewVariables(variableNames, sub)
  % T{rows, n} = value or T(rows, n) = value with variable numbers past the
  % width: the numbers become names. The new variables must follow the last
  % one without a gap; each gets the default name Var<n>, made unique.
  width = length(variableNames);
  sub = sub(:)';
  newNumbers = unique(sub(sub > width));
  if ~isequal(newNumbers, width + 1:width + length(newNumbers))
    error('Nelson:table:discontiguousVars', _('Cannot create a table variable with a discontiguous index.'));
  end
  used = variableNames;
  newNames = cell(1, length(newNumbers));
  for k = 1:length(newNumbers)
    base = sprintf('Var%d', newNumbers(k));
    candidate = base;
    suffix = 1;
    while any(strcmp(used, candidate))
      candidate = sprintf('%s_%d', base, suffix);
      suffix = suffix + 1;
    end
    newNames{k} = candidate;
    used{end + 1} = candidate;
  end
  names = cell(1, length(sub));
  for k = 1:length(sub)
    if sub(k) <= width
      names{k} = variableNames{sub(k)};
    else
      names{k} = newNames{sub(k) - width};
    end
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function value = tableParenAssignedValue(value, rows, varSub, variableNames)
  % T(rows, vars) = value: returns value as a table with one row per indexed
  % row and one variable per indexed variable. A cell array is converted, a
  % 1x1 table (or cell) is expanded like a scalar. Any other array is sized
  % like a table (rows, then columns) and refused.
  nVars = tableSubscriptCount(varSub, variableNames);
  if iscell(value)
    value = cell2table(value);
  elseif ~istable(value)
    isScalarValue = isscalar(value); % not inlined: an if on isscalar(object) ignores its overload
    if ~isScalarValue
      checkSize(size(value, 1), size(value, 2), numel(rows), nVars);
    end
    error('Nelson:table:invalidRHS', 'Right hand side of an assignment into a table must be another table or a cell array.');
  end
  if height(value) == 1 && width(value) == 1 && nVars > 0
    data = value.(value.Properties.VariableNames{1});
    trailing = repmat({':'}, 1, ndims(data) - 1);
    column = data(ones(numel(rows), 1), trailing{:}); % indexing: any class
    columns = repmat({column}, 1, nVars);
    value = table(columns{:});
  end
  checkSize(height(value), width(value), numel(rows), nVars);
end
%=============================================================================
function checkSize(valueRows, valueVars, nRows, nVars)
  if valueRows ~= nRows
    error('Nelson:table:RowDimensionMismatch', 'To assign to or create a variable in a table, the number of rows must match the height of the table.');
  end
  if valueVars ~= nVars
    error('Nelson:table:VarDimensionMismatch', 'The number of table variables in an assignment must match.');
  end
end
%=============================================================================
%=============================================================================
% Copyright (c) 2016-present Allan CORNET (Nelson)
%=============================================================================
% This file is part of Nelson.
%=============================================================================
% LICENCE_BLOCK_BEGIN
% SPDX-License-Identifier: LGPL-3.0-or-later
% LICENCE_BLOCK_END
%=============================================================================
function [st, rows] = tableParenNewVariables(st, names, rows, nRows, valueSt, rowSub)
  % T(rows, names) = tableValue: the names that are not variables yet are
  % appended, typed after the variables of tableValue, in order. The caller
  % then assigns the selected rows.
  isNew = ~ismember(names, st.Properties.VariableNames);
  if ~any(isNew)
    return
  end
  sourceNames = valueSt.Properties.VariableNames;
  samples = cell(1, length(names));
  for k = find(isNew)
    samples{k} = valueSt.data.(sourceNames{k});
  end
  [st, rows] = tableAppendVariables(st, names, isNew, rows, nRows, samples, rowSub);
end
